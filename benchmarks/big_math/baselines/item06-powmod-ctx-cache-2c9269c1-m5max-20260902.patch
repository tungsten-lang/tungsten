+/* ---- powmod Montgomery-context cache ----------------------------------
+ * Repeated modexp against one modulus (RSA/DH ladders, Miller–Rabin
+ * batteries, the powmod bench cells) re-derived R² mod n, μ, n' and the
+ * k-limb Newton inverse on EVERY call, malloc'd a fresh window arena and
+ * reduced the base through the boxed remainder.  Two MRU entries per
+ * thread retain the finished context and a grow-only ladder arena, keyed
+ * by the modulus VALUE (limb count + FNV-1a, confirmed by a limb compare).
+ *
+ * Admission is on first sight: building the context IS the setup the
+ * uncached call already paid, so retaining it costs only the O(k) key
+ * hash and modulus copy — unlike the division reciprocal cache, whose
+ * reciprocal is extra work on top of one division and so warms over
+ * BN_DIV_RECIP_WARMUP_SIGHTINGS.  Widths above BN_POWM_CTX_CACHE_MAX_LIMBS
+ * stay uncached (bounding retained memory to well under 1 MB per entry);
+ * their ladders dwarf the setup anyway.  BN_POWM_CTX_CACHE=0 restores the
+ * per-call build, boxed base reduction and malloc'd arena for A/B builds. */
+#ifndef BN_POWM_CTX_CACHE
+#define BN_POWM_CTX_CACHE 1
+#endif
+#ifndef BN_POWM_CTX_CACHE_MAX_LIMBS
+#define BN_POWM_CTX_CACHE_MAX_LIMBS 2048
+#endif
+typedef struct {
+    WPrimeModCtx ctx;        /* ctx.modulus boxes modb */
+    WBigint *modb;           /* owned |m| copy: the key and the ctx modulus */
+    uint64_t hash;           /* FNV-1a of the modulus limbs */
+    int32_t k;               /* modulus limbs; 0 = empty entry */
+    uint64_t np1;            /* high limb of −n⁻¹ mod B² (k ≥ 3 Montgomery) */
+    uint64_t *mip;           /* Newton k-limb inverse (mullo REDC widths) */
+    uint64_t *arena;         /* ladder arena: window table, x, pinned copies */
+    size_t arena_cap;        /* limbs; grows to the largest window seen */
+} WPowmCtxCache;
+
+/* High limb of −n⁻¹ mod B² by one Newton lift of the B-inverse (n odd). */
+static inline uint64_t w_powm_np1(const uint64_t *nl) {
+    uint64_t i0 = w_mont_ninv(nl[0]);
+    __uint128_t ni = (__uint128_t)nl[0] * i0;
+    uint64_t e2 = (uint64_t)(ni >> 64) + nl[1] * i0;
+    return ~(0ULL - i0 * e2);
+}
+
+#if BN_POWM_CTX_CACHE
+static __thread WPowmCtxCache bn_powm_ctx_caches[2];
+static __thread int bn_powm_ctx_cache_mru;
+
+static void bn_powm_ctx_cache_drop(WPowmCtxCache *c) {
+    if (!c->k) return;
+    w_prime_modctx_fini(&c->ctx);
+    bigint_backing_free(c->modb);
+    free(c->mip);
+    c->modb = NULL;
+    c->mip = NULL;
+    c->k = 0;
+}
+
+static void bn_powm_ctx_cache_release_thread(void) {
+    for (int i = 0; i < 2; i++) {
+        bn_powm_ctx_cache_drop(&bn_powm_ctx_caches[i]);
+        free(bn_powm_ctx_caches[i].arena);
+        memset(&bn_powm_ctx_caches[i], 0, sizeof(bn_powm_ctx_caches[i]));
+    }
+    bn_powm_ctx_cache_mru = 0;
+}
+
+/* The context for the modulus magnitude ml[0..k): the MRU entry on a hit
+ * (probed first, then the other), else the other entry rebuilt — empty
+ * first, otherwise LRU eviction, never the most recent modulus.  NULL
+ * above the retained-width cap. */
+static WPowmCtxCache *bn_powm_ctx_cache_get(const uint64_t *ml, int32_t k,
+                                            int32_t mont_cap) {
+    if (k > BN_POWM_CTX_CACHE_MAX_LIMBS) return NULL;
+    uint64_t h = 0xcbf29ce484222325ULL;
+    for (int32_t i = 0; i < k; i++) {
+        h ^= ml[i];
+        h *= 0x100000001b3ULL;
+    }
+    WPowmCtxCache *c = &bn_powm_ctx_caches[bn_powm_ctx_cache_mru];
+    if (c->k == k && c->hash == h &&
+        memcmp(c->modb->limbs, ml, (size_t)k * sizeof(uint64_t)) == 0)
+        return c;
+    WPowmCtxCache *o = &bn_powm_ctx_caches[bn_powm_ctx_cache_mru ^ 1];
+    if (o->k == k && o->hash == h &&
+        memcmp(o->modb->limbs, ml, (size_t)k * sizeof(uint64_t)) == 0) {
+        bn_powm_ctx_cache_mru ^= 1;
+        return o;
+    }
+    if (c->k) {                        /* MRU occupied: fill/evict the other */
+        c = o;
+        bn_powm_ctx_cache_mru ^= 1;
+    }
+    bn_powm_ctx_cache_drop(c);         /* the arena survives: grow-only */
+    c->modb = bigint_alloc(k);
+    memcpy(c->modb->limbs, ml, (size_t)k * sizeof(uint64_t));
+    c->modb->size = k;
+    w_prime_modctx_init_cap(&c->ctx, bigint_box(c->modb), mont_cap);
+    c->hash = h;
+    c->k = k;
+    c->np1 = 0;
+    if (c->ctx.mont && k >= 3) {
+        c->np1 = w_powm_np1(c->modb->limbs);
+        if (k >= W_POWM_REDC_MULLO_MIN && (k & 1) == 0) {
+            c->mip = (uint64_t *)malloc((size_t)k * sizeof(uint64_t));
+            /* 3k limbs of scratch out of the ctx's 12k+16 work limbs */
+            w_mont_ninv_k(c->mip, c->modb->limbs, k, c->ctx.nprime,
+                          c->ctx.work);
+        }
+    }
+    return c;
+}
+
+/* x[0..k) = base mod |m| as a zero-padded plain row, folded to [0, |m|)
+ * for negative bases; returns the trimmed length (0: base ≡ 0).  Bases
+ * below B^(2k) reduce in place through the ctx's Barrett μ — no boxed
+ * remainder minted, boxed and released per call; wider ones take the
+ * general remainder through one pooled buffer. */
+static int32_t w_powm_reduce_base_into(uint64_t *x, WPrimeModCtx *ctx,
+                                       const uint64_t *bl, int32_t babs,
+                                       int bneg) {
+    int32_t k = ctx->limbs;
+    uint64_t sm; int32_t lmod;
+    const uint64_t *nl = integer_limbs(ctx->modulus, &sm, &lmod);
+    int32_t rl;
+    if (k == 1) {
+        uint64_t n = nl[0];
+        x[0] = babs == 1 ? (bl[0] < n ? bl[0] : bl[0] % n)
+             : babs      ? mag_mod_single(bl, babs, n)
+                         : 0;
+        rl = x[0] != 0;
+    } else if (babs < k || (babs == k && mag_cmp(bl, k, nl, k) < 0)) {
+        for (int32_t j = 0; j < babs; j++) x[j] = bl[j];
+        rl = babs;
+        while (rl > 0 && x[rl - 1] == 0) rl--;
+    } else if (babs <= 2 * k) {
+        rl = w_prime_modctx_reduce_into(x, ctx, bl, babs);
+    } else {
+        WBigint *r;
+        mag_divmod(bl, babs, nl, k, NULL, &r);
+        rl = r->size;
+        for (int32_t j = 0; j < rl; j++) x[j] = r->limbs[j];
+        bigint_release(r);
+    }
+    for (int32_t j = rl; j < k; j++) x[j] = 0;
+    if (rl == 0 || !bneg) return rl;
+    uint64_t borrow = 0;                          /* |m| − r, r ∈ (0, |m|) */
+    for (int32_t j = 0; j < k; j++) {
+        uint64_t nv = nl[j], rv = x[j];
+        uint64_t t = nv - rv, b1 = nv < rv;
+        uint64_t d = t - borrow, b2 = t < borrow;
+        x[j] = d;
+        borrow = b1 | b2;
+    }
+    rl = k;
+    while (rl > 0 && x[rl - 1] == 0) rl--;
+    return rl;
+}
+#else
+static void bn_powm_ctx_cache_release_thread(void) {}
+#endif
