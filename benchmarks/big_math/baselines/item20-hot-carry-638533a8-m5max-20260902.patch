+/*
+ * ---- Register-carried hot handoff (immutable-churn lane protocol) ----
+ *
+ * The one-previous-result-live churn (result r_i is computed while r_{i-1}
+ * is still live; r_{i-1} is released at the END of iteration i; op i+1
+ * takes that buffer) round-trips every buffer through the thread-local hot
+ * slot: the release stores the packed word into bigint_pool_state.hot_word
+ * and the very next take loads it back — two TLS loads, two stores and a
+ * store->load forward per op that GMP's twin lane (two alternating
+ * destinations in registers) never pays.  The *_carry entries below let a
+ * caller that owns the whole protocol keep that packed word in a REGISTER
+ * instead: bigint_release_if_live_carry RETURNS the word the hot slot would
+ * have received, and bigint_alloc_raw_hot_from consumes it.  The pool is
+ * only touched when the carried buffer cannot serve the next request, and
+ * then exactly as the displace arm of bigint_release_if_live would have
+ * (bigint_hot_park_carried), so the recycler's state after the protocol
+ * ends equals what the slot round trip would have left.
+ *
+ * Contract: a carried word is an owned, live-header (BN_BIGINT_HOT_LIVE_
+ * HEADER) buffer that is NOT in the pool.  The owner must either hand it to
+ * a *_from take or park it — never drop it (leak) or release it twice (the
+ * hot slot's pointer guard cannot see a register).  Same-thread only, like
+ * the pool itself.
+ */
+#if BN_BIGINT_HOT_SLOT && BN_BIGINT_POWER2_CAP
+/* Park a carried word into the hot slot exactly as the swap-form displace
+ * arm of bigint_release_if_live does: unconditional store, displaced
+ * occupant rescued to its size-class bucket, self-displacement swallowed. */
+static inline __attribute__((always_inline))
+void bigint_hot_park_carried(uint64_t carried) {
+    if (carried == 0) return;
+    WBigintPool *pool = &bigint_pool_state;
+    uint64_t displaced = pool->hot_word;
+    pool->hot_word = carried;
+    if (__builtin_expect(displaced != 0, 0)) {
+        WBigint *prev = bigint_hot_ptr(displaced);
+        if (__builtin_expect(prev != bigint_hot_ptr(carried), 1))
+            bigint_release_cold(prev);
+    }
+}
+#else
+static inline void bigint_hot_park_carried(uint64_t carried) {
+    (void)carried;
+}
+#endif
+
+/* bigint_release_if_live with the hot-slot store replaced by a return: the
+ * live/alias checks, the fused header read and the cap <= pool-max rule
+ * are the same instruction shape as the original (kept as a verbatim copy
+ * rather than a shared helper so the tuned original's codegen is
+ * untouched).  Returns the packed word the buffer WOULD have been parked
+ * under, or 0 when the release took any other arm (not live, alias
+ * swallowed, over-cap backing free, cold bucket) — those arms behave
+ * exactly as today. */
+static inline __attribute__((always_inline))
+uint64_t bigint_release_if_live_carry(WBigint *b) {
+#if BN_BIGINT_RELEASE_INLINE_HANDOFF && BN_BIGINT_HOT_SLOT && \
+    BN_BIGINT_POWER2_CAP
+#if BN_BIGINT_RELEASE_FUSED_HEADER
+    uint64_t head01[2];
+    memcpy(head01, b, sizeof head01);   /* one ldp; no aliasing violation */
+    __asm__("" : "+r"(head01[0]));      /* keep the wide load (see original) */
+    if (__builtin_expect((uint16_t)head01[0] != (uint16_t)W_TYPE_BIGINT, 0)) {
+        if ((uint8_t)head01[0] != W_TYPE_BIGINT) return 0;
+        uint8_t sh = *(volatile uint8_t *)&b->shared;
+        if (sh != 255) b->shared = (uint8_t)(sh - 1);
+        return 0;
+    }
+    uint32_t cap = (uint32_t)head01[1];  /* fused from the header read */
+#elif defined(__LITTLE_ENDIAN__) || (defined(__BYTE_ORDER__) && \
+    __BYTE_ORDER__ == __ORDER_LITTLE_ENDIAN__)
+    uint16_t head;
+    memcpy(&head, b, sizeof head);      /* one ldrh; no aliasing violation */
+    if (__builtin_expect(head != (uint16_t)W_TYPE_BIGINT, 0)) {
+        if (b->type != W_TYPE_BIGINT) return 0;
+        if (b->shared != 255) b->shared--;
+        return 0;
+    }
+    uint32_t cap = b->cap;
+#else
+    if (__builtin_expect(b->type != W_TYPE_BIGINT, 0)) return 0;
+    if (__builtin_expect(b->shared != 0, 0)) {
+        if (b->shared != 255) b->shared--;
+        return 0;
+    }
+    uint32_t cap = b->cap;
+#endif
+#if BN_BIGINT_RELEASE_DISPLACE
+    /* The displace arm parks unconditionally; here that park IS the return
+     * value, and there is nothing to displace because the caller owns the
+     * word until it hands it to a *_from take or bigint_hot_park_carried. */
+    if (__builtin_expect(cap <= BN_BIGINT_POOL_MAX_CAP, 1)) {
+#if !BN_BIGINT_HOT_LIVE_HEADER
+        b->type = 0;
+#endif
+        return bigint_hot_encode(b, cap);
+    }
+#else
+    if (__builtin_expect(cap <= BN_BIGINT_POOL_MAX_CAP, 1)) {
+        WBigintPool *pool = &bigint_pool_state;
+        if (__builtin_expect(pool->hot_word == 0, 1)) {
+#if !BN_BIGINT_HOT_LIVE_HEADER
+            b->type = 0;
+#endif
+            return bigint_hot_encode(b, cap);
+        }
+    }
+#endif
+    bigint_release(b);
+    return 0;
+#else
+    bigint_release_if_live(b);
+    return 0;
+#endif
+}
+
