+/* Register-carried variants of the two word entries above for a caller
+ * running the one-previous-result-live churn protocol (see the comment on
+ * bigint_release_if_live_carry).  Identical shape and decode order to
+ * bigint_add_ui_any / bigint_sub_ui_any — word == 0 identity, the
+ * positive-bigint tag test, n = size, n >= 2 streamed kernel — with the
+ * allocation step swapped for bigint_alloc_raw_hot_from(carried, n).
+ * Every path that does not consume `carried` parks it first, exactly as
+ * the displace arm would, so the leaf/generic paths run against the same
+ * pool state they see today and no buffer can leak. */
+static inline __attribute__((always_inline))
+WValue bigint_add_ui_any_carry(WValue a, uint64_t word, uint64_t carried) {
+    if (word == 0) {
+        bigint_hot_park_carried(carried);
+        if (w_is_bigint(a)) w_bigint_mark_shared(w_as_bigint(a));
+        return a;
+    }
+#if BN_WORD_UI_POSITIVE_FAST
+    if ((a >> 47) == (W_TAG_BIGINT >> 47)) {
+        WBigint *ba = w_as_bigint(a);
+        int32_t n = ba->size;
+        if (n >= 2) {
+            WBigint *r = bigint_alloc_raw_hot_from(carried, n);
+            return bigint_add_word_into(ba->limbs, n, 0, word, r);
+        }
+#if BN_ADD_UI_POSITIVE_11_AFTER
+        if (n == 1) {
+            bigint_hot_park_carried(carried);
+            return bigint_add_one_limb_magnitudes(
+                ba->limbs[0], 0, word, 0);
+        }
+#endif
+    }
+#endif
+    bigint_hot_park_carried(carried);
+    uint64_t scratch;
+    int32_t alen;
+    const uint64_t *al = integer_limbs(a, &scratch, &alen);
+    int negative = alen < 0;
+    int32_t n = negative ? -alen : alen;
+    if (n == 0) return bigint_from_u64(word);
+    if (n == 1)
+        return bigint_add_one_limb_magnitudes(
+            al[0], negative, word, 0);
+    return bigint_addsub_word(al, n, negative, word, 0);
+}
