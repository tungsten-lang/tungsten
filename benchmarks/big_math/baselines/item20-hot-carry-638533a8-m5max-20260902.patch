+/*
+ * bigint_alloc_raw_hot for a caller carrying the hot word in a register
+ * (see bigint_release_if_live_carry).  The fit test is the same single
+ * unsigned compare on the decoded capacity as bigint_alloc_raw_hot (an
+ * empty word decodes as capacity 0 and rejects everything).  On a hit the
+ * carried buffer is returned with the header treatment of a hot-slot hit
+ * and the pool is not touched at all; on a miss the carried word is parked
+ * exactly as the displace arm would have parked it and the ordinary
+ * hot-slot take runs, so the miss path sees the same pool state it sees
+ * today.
+ */
+static inline __attribute__((always_inline))
+WBigint *bigint_alloc_raw_hot_from(uint64_t carried, int32_t cap) {
+#if BN_BIGINT_RECYCLE && BN_BIGINT_HOT_SLOT && BN_BIGINT_POWER2_CAP
+    uint64_t requested = (uint64_t)(uint32_t)cap;
+    uint64_t hot_cap = bigint_hot_capacity(carried);
+    if (__builtin_expect(hot_cap - requested < requested, 1)) {
+        WBigint *hot = bigint_hot_ptr(carried);
+#if !BN_BIGINT_HOT_LIVE_HEADER
+        hot->type = W_TYPE_BIGINT;
+#endif
+        /* Raw callers publish their final signed size after filling limbs. */
+        return hot;
+    }
+    bigint_hot_park_carried(carried);
+#else
+    (void)carried;
+#endif
+    return bigint_alloc_raw_hot(cap);
+}
