# End-to-end compiled BigInt-literal materialization benchmark.
#
# Each timed loop evaluates the same source literal on every iteration and
# keeps only the last value.  The checksum is outside the timed region, so the
# measured work is literal materialization plus the language's normal value
# replacement/lifetime handling.  Sizes are expressed in 64-bit limbs.

-> bench_1(n)
  last = 0 ## big
  i = 0 ## i64
  t0 = clock()
  while i < n
    last = 0x8000000000000000
    i = i + 1
  t1 = clock()
  check = last % 1000000007
  << "literal\t1\t" + n.to_s() + "\t" + ((t1 - t0) * ~1000000000.0 / n.to_f()).to_s() + "\t" + check.to_s()

