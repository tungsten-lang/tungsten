#!/usr/bin/env bash
exec "$(dirname "$0")/tungsten" run "$0" "$@"
# Tungsten Benchmark Suite
# Rewrite of bin/bench (bash) in Tungsten

root = capture("cd \"[__DIR__]/..\" && pwd").strip
benchdir = root + "/benchmarks"
tungsten = root + "/bin/tungsten"

runs_env = env("RUNS")
runs = 3
if runs_env
  runs = runs_env.to_i()

BOLD  = "\e[1m"
DIM   = "\e[2m"
RESET = "\e[0m"
GREEN = "\e[32m"
RED   = "\e[31m"
CYAN  = "\e[36m"
WHITE = "\e[97m"

all_langs = ["tungsten", "c", "rust", "zig", "odin", "go", "crystal", "ruby", "python"]
names     = {"c": "C", "rust": "Rust", "zig": "Zig", "odin": "Odin", "go": "Go", "crystal": "Crystal", "ruby": "Ruby", "python": "Python", "tungsten": "Tungsten"}
exts      = {"c": "c", "rust": "rs", "zig": "zig", "odin": "odin", "go": "go", "crystal": "cr", "ruby": "rb", "python": "py", "tungsten": "w"}
cmds      = {"c": "clang", "rust": "rustc", "zig": "zig", "odin": "odin", "go": "go", "crystal": "crystal", "ruby": "ruby", "python": "python3"}
suffixes  = {"c": "_c", "rust": "_rs", "zig": "_zig", "odin": "_odin", "go": "_go", "crystal": "_cr", "tungsten": "_w"}

lang_avail = {}
bin_avail  = {}

-> display_name(lang)
  names[lang]

-> lang_ext(lang)
  exts[lang]

-> has_lang(lang)
  lang_avail[lang] == true

# A benchmark only includes a language if its source file is present —
# not every benchmark provides every language (e.g. polysum has rs/zig/
# odin, pipeline does not). Guards the compile/verify/run loops so a
# missing source is silently skipped instead of erroring.
-> has_source(dir, bench, lang)
  file?(dir + "/" + bench + "." + exts[lang])

# A compiled language only runs if its binary was actually produced. A
# failed compile (e.g. a source that doesn't match the installed toolchain
# version) must be SKIPPED in verify/timing, NOT run as a missing binary
# and clocked at 0s — otherwise a broken benchmark looks instantaneous.
# Test -s (non-empty), not just -x: a failed `zig build-exe -femit-bin`
# leaves a 0-byte executable STUB that -x would accept (and running an
# empty file is instant → a bogus "0.002s"). Ruby/Python run from source.
-> has_binary(dir, bench, lang)
  if lang == "ruby" || lang == "python"
    return true
  bin = dir + "/" + bench + suffixes[lang]
  if bin_avail.has_key?(bin)
    return bin_avail[bin]
  if !file?(bin)
    bin_avail[bin] = false
    return false
  ok = capture("test -s \"" + bin + "\" -a -x \"" + bin + "\" && echo yes").strip() == "yes"
  bin_avail[bin] = ok
  ok

# Languages to skip for a specific benchmark, even when installed and a
# source exists. polysum's interpreters are ~1000x slower than its compiled
# languages, so at the N where C/Rust/… reach ~1-2s they would run for
# minutes — drop them from the suite (the source files stay for standalone
# runs / correctness reference).
bench_skip = {"polysum": ["ruby", "python"]}

-> skip_lang?(bench, lang)
  list = bench_skip[bench]
  return false if list == nil
  list.include?(lang)

# Languages whose output for a benchmark wraps mod 2^64 BY DESIGN.
# polysum's true sums exceed 2^64 (deg-20 is ~170 digits), which fixed-width
# languages cannot represent — their sources compute mod 2^64 on purpose as
# native-loop speed references. Verify them as their own group (they must
# still agree with each other mod 2^64) instead of against the exact
# (BigInt) languages, which they could never match.
bench_mod64 = {"polysum": ["c", "rust", "zig", "odin", "go"]}

-> mod64_lang?(bench, lang)
  list = bench_mod64[bench]
  return false if list == nil
  list.include?(lang)

# Extra runtime args per benchmark. polysum's per-element work (5 high-degree
# polynomials) is ~50x heavier than the other loops, so the interpreters
# would run for minutes at the source default — pass a smaller N/REPS here.
bench_args = {"polysum": "100000000 10"}

-> run_args_for(bench)
  if bench_args.has_key?(bench)
    return " " + bench_args[bench]
  ""

# Format seconds to 3 decimals. Float#round(n) ignores its precision arg
# (rounds to an integer), so sub-second times would all print as "0s" —
# slice and right-pad the decimal string instead.
-> fmt_secs(t)
  s = "" + t.to_s()
  dot = s.index(".")
  if dot == nil
    return s + ".000s"
  whole = s.slice(0, dot)
  frac = s.slice(dot + 1, s.size() - dot - 1)
  if frac.size() > 3
    frac = frac.slice(0, 3)
  while frac.size() < 3
    frac = frac + "0"
  whole + "." + frac + "s"

-> run_cmd(lang, dir, bench)
  extra = run_args_for(bench)
  case lang
  when "ruby"
    return "ruby --yjit '" + dir + "/" + bench + ".rb'" + extra
  when "python"
    return "python3 '" + dir + "/" + bench + ".py'" + extra
  else
    "'" + dir + "/" + bench + suffixes[lang] + "'" + extra

-> compile_cmd(lang, dir, bench)
  case lang
  when "c"
    return "clang -O3 -march=native -flto -DNDEBUG \"[dir]/[bench].c\" -o \"[dir]/[bench]_c\""
  when "rust"
    return "rustc -O \"[dir]/[bench].rs\" -o \"[dir]/[bench]_rs\" 2>/dev/null"
  when "zig"
    return "zig build-exe -OReleaseFast -lc \"[dir]/[bench].zig\" -femit-bin=\"[dir]/[bench]_zig\" 2>/dev/null"
  when "odin"
    return "odin build \"[dir]/[bench].odin\" -file -o:speed -out:\"[dir]/[bench]_odin\" 2>/dev/null"
  when "go"
    return "go build -o \"[dir]/[bench]_go\" \"[dir]/[bench].go\""
  when "crystal"
    return "crystal build --release -o \"[dir]/[bench]_cr\" \"[dir]/[bench].cr\" 2>/dev/null"
  when "tungsten"
    return "\"[tungsten]\" compile --release --native \"[dir]/[bench].w\" -o \"[dir]/[bench]_w\" >/dev/null 2>&1"

only = env("ONLY")
langs = all_langs

if only
  selected = only.downcase.split(",")
  langs = []
  selected.each -> (s)
    s = s.strip

    s = "tungsten" if s == "w"

    if all_langs.include?(s)
      langs.push(s)
    else
      << "Unknown platform: [s] (available: [all_langs.join(" ")])"
      exit(1)

lang_avail["tungsten"] = file?(tungsten)
probe_parts = []
langs.each -> (l)
  if l != "tungsten"
    probe_parts.push("command -v [cmds[l]] >/dev/null 2>&1 && echo [l]")
if probe_parts.size() > 0
  capture(probe_parts.join("; ")).split("\n").each -> (line)
    found = line.strip()
    lang_avail[found] = true if found != ""

active_langs = langs.select -> (l) has_lang(l)

all_benchmarks = ["fib", "primes", "ackermann", "sum", "collatz", "gcd", "nested_loops", "pipeline", "polysum"]
labels = {"fib": "fib(42)", "primes": "primes(120M)", "ackermann": "ackermann(3,12)", "sum": "sum(3.5B)", "collatz": "collatz(5M)", "gcd": "gcd(22M)", "nested_loops": "nested_loops(1B)", "pipeline": "pipeline(100M)", "polysum": "polysum(deg 1-20)"}

# bin/tungsten run exposes only user arguments to Tungsten code.
script_args = argv()
benchmarks = all_benchmarks

if script_args.size > 0
  name = script_args[0]
  if !all_benchmarks.include?(name)
    << "Unknown benchmark: [name] (available: [all_benchmarks.join(" ")])"
    exit(1)
  benchmarks = [name]

-> get_label(bench)
  labels[bench]

-> best_time(cmd, n)
  best = -1.0
  i = 0
  while i < n
    t1 = clock()
    ok = system("exec " + cmd + " > /dev/null 2>&1")
    if ok == false
      return nil
    t2 = clock()
    elapsed = t2 - t1

    if best < 0.0
      best = elapsed
    elsif elapsed < best
      best = elapsed
    i = i + 1
  best

<< "[BOLD]Tungsten Benchmark Suite[RESET]"
<< ""

print("Languages: ")
langs.each -> (lang)
  name = display_name(lang)
  if has_lang(lang)
    print("[GREEN][name][RESET] ")
  else
    print("[DIM][name] (not found)[RESET] ")
<< ""
<< ""

<< "[BOLD]Compiling...[RESET]"

compile_jobs = []
benchmarks.each -> (bench)
  dir = benchdir + "/" + bench
  active_langs.each -> (lang)
    if has_source(dir, bench, lang) && !skip_lang?(bench, lang)
      cmd = compile_cmd(lang, dir, bench)
      if cmd
        ext = lang_ext(lang)
        << "  [DIM][bench].[ext][RESET]"
        bin = dir + "/" + bench + suffixes[lang]
        compile_jobs.push("(rm -f " + bin + "; " + cmd + ") &")

if compile_jobs.size() > 0
  batch = []
  compile_jobs.each -> (job)
    batch.push(job)
    if batch.size() >= 12
      batch.push("wait")
      system(batch.join(" "))
      batch = []
  if batch.size() > 0
    batch.push("wait")
    system(batch.join(" "))

<< ""

<< "[BOLD]Verifying outputs match...[RESET]"
verify_ok = true
verify_dir = capture("mktemp -d /tmp/tungsten-bench.XXXXXX").strip()

verify_jobs = []
benchmarks.each -> (bench)
  dir = benchdir + "/" + bench
  active_langs.each -> (lang)
    if lang != "ruby" && has_source(dir, bench, lang) && !skip_lang?(bench, lang) && has_binary(dir, bench, lang)
      cmd = run_cmd(lang, dir, bench)
      out_file = verify_dir + "/" + bench + "_" + lang + ".out"
      verify_jobs.push("(exec " + cmd + " > " + out_file + " 2>/dev/null) &")

if verify_jobs.size() > 0
  batch = []
  verify_jobs.each -> (job)
    batch.push(job)
    if batch.size() >= 12
      batch.push("wait")
      system(batch.join(" "))
      batch = []
  if batch.size() > 0
    batch.push("wait")
    system(batch.join(" "))

bench_i = 0
while bench_i < benchmarks.size()
  bench = benchmarks[bench_i]
  label = get_label(bench)
  dir = benchdir + "/" + bench
  expected = ""
  expected_name = ""
  wrapped = ""
  wrapped_name = ""
  mismatch = ""

  lang_i = 0
  while lang_i < active_langs.size()
    lang = active_langs[lang_i]
    if has_source(dir, bench, lang) && !skip_lang?(bench, lang) && has_binary(dir, bench, lang)
      if lang != "ruby"
        out_file = verify_dir + "/" + bench + "_" + lang + ".out"
        output = file?(out_file) ? read_file(out_file).strip().split("\n").join("  ") : ""

        if output == ""
          name = display_name(lang)
          mismatch = name + " produced no output"
        elsif mod64_lang?(bench, lang)
          if wrapped == ""
            wrapped = output
            wrapped_name = display_name(lang)
          elsif output != wrapped
            name = display_name(lang)
            mismatch = name + " (got: " + output + ", " + wrapped_name + " expected: " + wrapped + ")"
        elsif expected == ""
          expected = output
          expected_name = display_name(lang)
        elsif output != expected
          name = display_name(lang)
          mismatch = name + " (got: " + output + ", " + expected_name + " expected: " + expected + ")"
    lang_i = lang_i + 1

  if mismatch != ""
    << "  [RED]MISMATCH[RESET] [label]: [mismatch]"
    verify_ok = false
  else
    shown = expected
    if shown == ""
      shown = wrapped
    note = ""
    if expected != "" && wrapped != ""
      note = " [DIM](fixed-64 langs agree mod 2^64)[RESET]"
    << "  [GREEN]OK[RESET] [label] = [shown][note]"
  bench_i = bench_i + 1

if verify_dir != ""
  system("rm -rf " + verify_dir)

<< ""

if verify_ok == false
  << "[RED]WARNING: Some outputs don't match![RESET]"
  << ""
  exit(1)

<< "[BOLD]Running benchmarks ([runs] runs each, best time)...[RESET]"
<< ""

results = {}

benchmarks.each -> (bench)
  label = get_label(bench)
  dir = benchdir + "/" + bench
  print("  [CYAN][label][RESET] ")
  bench_results = {}

  active_langs.each -> (lang)
    if has_source(dir, bench, lang) && !skip_lang?(bench, lang) && has_binary(dir, bench, lang)
      cmd = run_cmd(lang, dir, bench)
      t = best_time(cmd, runs)
      bench_results[lang] = t
      print(".")

  results[bench] = bench_results
  << ""

<< ""

col1_w = 20
col_w = 12
empty_cell = "—" + " " * (col_w - 1)

header = BOLD + "Benchmark".ljust(col1_w)
lang_i = 0
while lang_i < active_langs.size()
  lang = active_langs[lang_i]
  header = header + display_name(lang).ljust(col_w)
  lang_i = lang_i + 1
header = header + RESET
<< header

sep_len = col1_w + active_langs.size() * col_w
<< "─" * sep_len

bench_i = 0
while bench_i < benchmarks.size()
  bench = benchmarks[bench_i]
  label = get_label(bench)
  bench_results = results[bench]

  best_t = -1.0
  lang_i = 0
  while lang_i < active_langs.size()
    lang = active_langs[lang_i]
    t = bench_results[lang]
    if t
      if best_t < 0.0
        best_t = t
      elsif t < best_t
        best_t = t
    lang_i = lang_i + 1

  row = label.ljust(col1_w)
  lang_i = 0
  while lang_i < active_langs.size()
    lang = active_langs[lang_i]
    t = bench_results[lang]
    if t
      time_str = fmt_secs(t)
      if t == best_t
        row += BOLD + time_str.ljust(col_w) + RESET
      else
        row += time_str.ljust(col_w)
    else
      row += empty_cell
    lang_i = lang_i + 1

  << row
  bench_i = bench_i + 1

<< ""

<< "[DIM]Cleaning up compiled binaries...[RESET]"
rm_targets = []
benchmarks.each -> (bench)
  dir = benchdir + "/" + bench
  ["c", "go", "cr", "w", "rs", "zig", "odin"].each -> (s)
    rm_targets.push("\"[dir]/[bench]_[s]\"")
if rm_targets.size() > 0
  system("rm -f " + rm_targets.join(" "))

<< "[GREEN]Done![RESET]"
