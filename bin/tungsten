#!/bin/bash
TUNGSTEN_POLYGLOT=1 <<2
# ──────────────────────────────────────────────────────────────────────────
# bin/tungsten is a POLYGLOT — one file, two programs.
#
#   bash bin/tungsten ARGS...       line 2 is a no-op assignment whose
#                                   heredoc (its delimiter is the bare 2
#                                   on a line of its own, below) makes bash
#                                   skip this whole Tungsten half; the
#                                   dispatcher after it is plain bash.
#                                   Kernel exec via the shebang takes the
#                                   same path.
#
#   tungsten bin/tungsten ARGS...   to Tungsten, line 2 is the constant
#                                   assignment TUNGSTEN_POLYGLOT = 1 shl 2.
#                                   This trampoline re-runs the bash half
#                                   on this same file, forwarding argv; the
#                                   bash half never reaches the parser — it
#                                   is swallowed as the (unused) heredoc
#                                   string opened just before that bare-2
#                                   line.
#
# Rules for editing this half: it sits inside a bash heredoc whose delimiter
# cannot be quoted (quoted forms are not valid Tungsten), so bash performs
# expansions on the text. Keep it free of dollar signs and backticks, and
# never add a line consisting of only the digit 2.
# ──────────────────────────────────────────────────────────────────────────

-> sh_quote(s)
  "'" + s.gsub("'", "'\\''") + "'"

cmd = "bash " + sh_quote(__DIR__ + "/tungsten")
args = argv()
i = 0
while i < args.size
  cmd = cmd + " " + sh_quote(args[i])
  i = i + 1
# system() reports only success/failure, so this path collapses exit codes
# to 0/1 (Process.spawn is not available in the interpreters).
if system(cmd)
  exit(0)
exit(1)

bash_half = <<~TUNGSTEN_POLYGLOT_BASH
2

# Resolve symlinks so ROOT is the real install dir even when invoked via a
# symlink on PATH (the installer links this script into ~/.local/bin).
SELF="$0"
while [ -L "$SELF" ]; do
  LINK="$(readlink "$SELF")"
  case "$LINK" in
    /*) SELF="$LINK" ;;
    *)  SELF="$(dirname "$SELF")/$LINK" ;;
  esac
done
ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
COMPILER="$ROOT/bin/tungsten-compiler"
# Worktrees do not inherit the gitignored compiler. The post-checkout hook
# usually plants a symlink; this is the same link for checkouts that never
# ran the hook (existing worktrees, --no-checkout, hooksPath unset).
if [ ! -x "$COMPILER" ] && [ -f "$ROOT/.githooks/link-host-compiler.sh" ]; then
  bash "$ROOT/.githooks/link-host-compiler.sh" "$ROOT" >/dev/null 2>&1 || true
fi
RUBY_CLI="$ROOT/bin/tungsten.rb"
CUSTOM_RUBY="$ROOT/src/patched/ruby/ruby"

. "$ROOT/bin/commands/config.sh"
tungsten_load_build_config

# User package storage is distinct from this source checkout's bundled bits.
# Internal tool builds pass $ROOT/bits explicitly; ordinary package lookup and
# `bit install` use the stable per-user defaults unless the caller overrides
# them.
export TUNGSTEN_HOME="${TUNGSTEN_HOME:-${HOME:-$ROOT}/.tungsten}"
export BIT_HOME="${BIT_HOME:-$TUNGSTEN_HOME/bits}"

# Single-source the version from the repo-root VERSION file, so children (the
# compiled CLI, the REPL banner) read it from the environment instead of
# re-hardcoding it.
export TUNGSTEN_VERSION="$(cat "$ROOT/VERSION" 2>/dev/null || echo dev)"

# Anchor stdlib resolution to the install root, not the caller's cwd. Without
# this, `tungsten /tmp/foo.w` from outside the repo fails to autoload any
# pure-Tungsten core class (JSON, Matrix, Hypercomplex, …) because
# find_core_root only walks the source file's ancestry and cwd for
# core/tungsten.w — neither of which exists next to an arbitrary user file.
# C-builtin methods (String#upcase, Array#sort) survive since they live in the
# runtime, which masked this for simple programs. See loader.w:find_core_root.
export TUNGSTEN_ROOT="$ROOT"

# Prefer custom ruby, fall back to system ruby
if [ -x "$CUSTOM_RUBY" ]; then
  RUBY="$CUSTOM_RUBY"
else
  RUBY=ruby
fi

# Commands handled by the Ruby CLI (not yet ported to the compiled binary).
# `start` lives here on purpose: it's the first-run welcome, and it must work on
# a fresh clone that has no compiler yet, so it takes the Ruby-dispatch path.
#
# Interactive REPL: public entry is `tungsten console` (and `bin/wit`).
# There is no `tungsten --repl` / `tungsten repl`.
case "$1" in
  console)
    shift
    if [ -x "$COMPILER" ]; then
      exec "$COMPILER" --repl "$@"
    fi
    echo "tungsten console: no self-hosted compiler at $COMPILER" >&2
    echo "run bin/tungsten bootstrap, then retry" >&2
    exit 1
    ;;
  # doctor + bootstrap are pure bash — work on a fresh clone with no compiler.
  doctor)
    shift
    exec bash "$ROOT/bin/commands/doctor.sh" "$@"
    ;;
  bootstrap)
    shift
    exec bash "$ROOT/bin/commands/bootstrap.sh" "$@"
    ;;
  release)
    shift
    exec bash "$ROOT/bin/commands/release.sh" "$@"
    ;;
  # cleanup: force a build-cache sweep now (the same GC that build/bootstrap
  # and `run` kick daily). Prunes stale incremental slots, run-cache binaries,
  # and eval sources older than TUNGSTEN_CACHE_MAX_AGE_DAYS (default 7).
  cleanup)
    shift
    exec env TUNGSTEN_CACHE_GC_FORCE=1 bash "$ROOT/bin/commands/cache_gc.sh" "$@"
    ;;
  wasm)
    shift
    exec python3 "$ROOT/scripts/wasm.py" "$@"
    ;;
  notes)
    shift
    exec bash "$ROOT/bin/commands/notes.sh" "$@"
    ;;
  gpu-check)
    shift
    exec python3 "$ROOT/scripts/gpu-check.py" "$@"
    ;;
  gpu-bench)
    shift
    exec bash "$ROOT/bin/commands/gpu-bench.sh" "$@"
    ;;
  debug)
    shift
    exec bash "$ROOT/bin/commands/debug.sh" "$@"
    ;;
  # media: verify/probe masters and write sync tests (bin/commands/media.w,
  # core/media). Media is compiled-only, so it runs through the compiler.
  media)
    shift
    if [ ! -x "$COMPILER" ]; then
      echo "tungsten media: build the compiler first — bin/tungsten build" >&2
      exit 1
    fi
    exec "$COMPILER" run "$ROOT/bin/commands/media.w" -- "$@"
    ;;
  # build: the Tungsten orchestrator (bin/commands/build.w), compiled on
  # demand like tungsten.wc. Needs an existing compiler — a fresh clone
  # bootstraps first. --ruby/--spinel remain developer options inside it.
  # fmt/forge/flame/bit/ai/symbolicate are handled by bin/tungsten.wc.
  build)
    shift
    if [ ! -x "$COMPILER" ]; then
      echo "tungsten build: no compiler at bin/tungsten-compiler — run bin/tungsten bootstrap first" >&2
      exit 1
    fi
    BUILD_W="$ROOT/bin/commands/build.w"
    BUILD_BIN="$ROOT/bin/commands/build"
    if [ ! -x "$BUILD_BIN" ] || [ "$BUILD_W" -nt "$BUILD_BIN" ] || [ "$COMPILER" -nt "$BUILD_BIN" ]; then
      BIT_HOME="$ROOT/bits" TUNGSTEN_ROOT="$ROOT" \
        "$COMPILER" compile "$BUILD_W" --out "$BUILD_BIN" --no-lto >/dev/null 2>&1 || {
        echo "tungsten build: failed to compile bin/commands/build.w" >&2
        exit 1
      }
      case "$(uname -s)" in
        Darwin) codesign --force -s - "$BUILD_BIN" >/dev/null 2>&1 || true ;;
      esac
    fi
    exec "$BUILD_BIN" "$@"
    ;;
  install)
    shift
    if [ ! -x "$COMPILER" ]; then
      echo "tungsten install: no compiler at bin/tungsten-compiler — run bin/tungsten build --install first" >&2
      exit 1
    fi
    BUILD_W="$ROOT/bin/commands/build.w"
    BUILD_BIN="$ROOT/bin/commands/build"
    if [ ! -x "$BUILD_BIN" ] || [ "$BUILD_W" -nt "$BUILD_BIN" ] || [ "$COMPILER" -nt "$BUILD_BIN" ]; then
      BIT_HOME="$ROOT/bits" TUNGSTEN_ROOT="$ROOT" \
        "$COMPILER" compile "$BUILD_W" --out "$BUILD_BIN" --no-lto >/dev/null 2>&1 || {
        echo "tungsten install: failed to compile bin/commands/build.w" >&2
        exit 1
      }
      case "$(uname -s)" in
        Darwin) codesign --force -s - "$BUILD_BIN" >/dev/null 2>&1 || true ;;
      esac
    fi
    exec "$BUILD_BIN" --install-only "$@"
    ;;
  # bench: Tungsten primitive-op velocity baseline (bin/commands/bench.w).
  # `--suite` switches to the cross-language algorithm suite (bench-suite.w).
  # Options are translated to env vars because `tungsten run` consumes leading
  # --flags itself; names pass through as positional args.
  bench)
    shift
    if [ "${1:-}" = "bignum" ]; then
      shift
      exec python3 "$ROOT/bin/commands/bench-bignum.py" "$@"
    fi
    if [ ! -x "$COMPILER" ]; then
      echo "tungsten bench: build the compiler first — bin/tungsten build" >&2
      exit 1
    fi
    bench_cmd="$ROOT/bin/commands/bench.w"
    bench_args=()
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --suite)     bench_cmd="$ROOT/bin/commands/bench-suite.w" ;;
        --linalg)    bench_cmd="$ROOT/bin/commands/bench-suite.w"; bench_args+=("linalg_matmul") ;;
        --list)      export BENCH_LIST=1 ;;
        --baseline)  export BENCH_BASELINE=1 ;;
        --compare)   export BENCH_COMPARE=1 ;;
        --gate)      export BENCH_GATE=1 ;;
        --only)      shift; [ "$#" -gt 0 ] && export BENCH_ONLY="$1" ;;
        --only=*)    export BENCH_ONLY="${1#--only=}" ;;
        --runs)      shift; [ "$#" -gt 0 ] && export BENCH_RUNS="$1" ;;
        --runs=*)    export BENCH_RUNS="${1#--runs=}" ;;
        -h|--help)
          echo "Usage: tungsten bench [primitive...] [--compare] [--baseline] [--runs N] [--list]"
          echo "       tungsten bench --suite [benchmark...] [--only LANGS] [--runs N] [--list]"
          echo "       tungsten bench --linalg [--only LANGS] [--runs N]"
          echo "       tungsten bench bignum [--quick] [--all] [--json]"
          echo
          echo "  Default: Tungsten primitive-op velocity baseline (ops/sec). Each op is"
          echo "  auto-calibrated to ~1s after a 3s warmup. If bench_baseline.txt exists,"
          echo "  prints a before/after/Δ table (green = faster now, red = slower)."
          echo
          echo "  primitive...   names to run (default: all; see --list)"
          echo "  --compare      also time C / Rust / Go / Zig / Odin / Python peers where fair"
          echo "  --baseline     write bench_baseline.txt (the before/after reference)"
          echo "  --gate         exit non-zero if any primitive is below its regression floor"
          echo "  --runs N       best-of-N per op (default 1; each run is ~1s)"
          echo "  --list         list the primitives and exit"
          echo
          echo "  --suite        run the cross-language ALGORITHM suite instead"
          echo "                 (Tungsten vs C/Rust/Go/Crystal/Ruby/Python/Julia)"
          echo "  --linalg       512×512 f32 GEMM head-to-head (Tensor/CBLAS/NumPy/Julia;"
          echo "                 naive Rust/Go). Same suite harness."
          echo "  --only LANGS   (suite) comma list, e.g. w,c,rust,go"
          echo
          echo "  bignum         compare boxed immutable integer operations across Tungsten,"
          echo "                 GMP, Python, Rust, and Odin; test buffer-capacity policies"
          exit 0 ;;
        *)           bench_args+=("$1") ;;
      esac
      shift
    done
    exec "$COMPILER" run "$bench_cmd" "${bench_args[@]}"
    ;;
  autotune)
    shift
    # The wrapper owns option parsing and passes normalized flags through the
    # environment, matching the other source-backed subcommands above.
    export AUTOTUNE_WRAPPER=1
    if [ ! -x "$COMPILER" ]; then
      echo "tungsten autotune: build the compiler first — bin/tungsten build" >&2
      exit 1
    fi
    autotune_cmd="$ROOT/bin/commands/autotune.w"
    autotune_args=()
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --quick)      export AUTOTUNE_QUICK=1 ;;
        --deep)       export AUTOTUNE_DEEP=1 ;;
        --slots)      export AUTOTUNE_SLOTS=1 ;;
        --capacity)   export AUTOTUNE_CAPACITY=1 ;;
        --thresholds) export AUTOTUNE_THRESHOLDS=1 ;;
        --addmul-rows) export AUTOTUNE_ADDMUL_ROWS=1 ;;
        --emit-cflags) export AUTOTUNE_EMIT_CFLAGS=1 ;;
        --json)       export AUTOTUNE_JSON=1 ;;
        -h|--help)
          echo "Usage: tungsten autotune [--quick] [--deep] [--slots] [--capacity] [--thresholds] [--addmul-rows] [--emit-cflags] [--json]"
          echo
          echo "  Sweep runtime & memory parameters to discover optimal settings"
          echo "  for the local host machine, CPU architecture, and cache hierarchy."
          echo
          echo "  --quick         run fast calibration sweeps (~30k requests per trial)"
          echo "  --deep          run thorough multi-pass sweeps (~500k requests, 5 runs)"
          echo "  --slots         sweep thread-local parked buffer capacity (1..8 slots/bucket)"
          echo "  --capacity      sweep result-buffer capacity quanta and power-of-two boundaries"
          echo "  --thresholds    sweep arithmetic kernel crossover thresholds"
          echo "  --addmul-rows   sweep multiply-accumulate row width (BN_ADDMUL_ROWS, rebuilds harness)"
          echo "  --emit-cflags   print recommended -D compiler flags for optimal build"
          echo "  --json          output machine-readable results as JSON"
          exit 0 ;;
        *)            autotune_args+=("$1") ;;
      esac
      shift
    done
    exec "$COMPILER" run "$autotune_cmd" "${autotune_args[@]}"
    ;;
esac

# --fast-math / --no-fast-math: compile-time choice for `if FAST_MATH`
# branches in .w source. Translated to `-D FAST_MATH=true|false`, which
# the compiler turns into a build-time constant. The .w `if FAST_MATH`
# check constant-folds during lowering — no runtime branch, no global.
#
# -D NAME=VALUE flags are accumulated into TUNGSTEN_DEFINES (semicolon-
# separated) and stripped from argv before the Ruby CLI sees them
# (its OptionParser rejects -D).
filtered_args=()
defines=""
i=0
args_arr=("$@")
n_args=${#args_arr[@]}
while [ "$i" -lt "$n_args" ]; do
  arg="${args_arr[$i]}"
  case "$arg" in
    --fast-math)
      # Matches the universal `-ffast-math` meaning, three effects:
      #   1. Fast floating-point semantics (math_mode = :fast) — forwarded as
      #      `--fast`, which the Ruby driver (compile.rb) strips and hands to
      #      `tungsten-compiler compile`.
      #   2. The `FAST_MATH` build-time constant, so `if FAST_MATH` source
      #      branches constant-fold to the fast path.
      #   3. Pass -ffast-math to the backend clang so LLVM's loop vectorizer
      #      can auto-SIMD float reductions/maps (FP add isn't associative, so
      #      the vectorizer is gated on this) — see fast_math_on below.
      defines="${defines:+${defines};}FAST_MATH=true"
      fast_math_on=1
      filtered_args+=("--fast")
      ;;
    --fast|-fast)
      # Same fast-FP intent as --fast-math; also enable clang auto-vectorization.
      fast_math_on=1
      filtered_args+=("$arg")
      ;;
    --no-fast-math)
      defines="${defines:+${defines};}FAST_MATH=false"
      ;;
    -D)
      i=$((i + 1))
      if [ "$i" -lt "$n_args" ]; then
        d="${args_arr[$i]}"
        case "$d" in *=*) : ;; *) d="${d}=true" ;; esac
        defines="${defines:+${defines};}${d}"
      fi
      ;;
    -D*)
      d="${arg#-D}"
      case "$d" in *=*) : ;; *) d="${d}=true" ;; esac
      defines="${defines:+${defines};}${d}"
      ;;
    *)
      filtered_args+=("$arg")
      ;;
  esac
  i=$((i + 1))
done
set -- "${filtered_args[@]}"

if [ -n "$defines" ]; then
  if [ -n "$TUNGSTEN_DEFINES" ]; then
    export TUNGSTEN_DEFINES="${TUNGSTEN_DEFINES};${defines}"
  else
    export TUNGSTEN_DEFINES="$defines"
  fi
fi

# Fast-math build: hand the backend clang -ffast-math so LLVM auto-vectorizes
# clean scalar float loops (reductions/maps over typed f64[]/f32[] arrays) into
# NEON/AVX/SVE for the target -march. Only defaults it — an explicit
# TUNGSTEN_CLANG_OPT from the user wins. Off by default (fast-math changes FP
# semantics: reassociation, no nnan/ninf); -fast is the opt-in.
if [ -n "$fast_math_on" ] && [ -z "$TUNGSTEN_CLANG_OPT" ]; then
  export TUNGSTEN_CLANG_OPT="-O3 -ffast-math"
fi


# Walk up from a path looking for a Bitfile. Echoes the bit dir on stdout
# (or empty if none found). The bit dir is the first ancestor that contains
# a Bitfile.
find_bitfile_dir() {
  local d
  d=$(cd "$(dirname "$1")" 2>/dev/null && pwd)
  while [ -n "$d" ] && [ "$d" != "/" ]; do
    if [ -f "$d/Bitfile" ]; then
      echo "$d"
      return
    fi
    d=$(dirname "$d")
  done
}

# Parse a Bitfile's `includes [...]` line and emit colon-separated absolute
# paths for the includes (resolved relative to the Bitfile's dir).
bitfile_includes() {
  local bit_dir="$1"
  local bf="$bit_dir/Bitfile"
  [ -f "$bf" ] || return
  # Match `includes ["foo", "bar"]` (single-line form). Multi-line could be
  # added later if any bit needs it.
  grep -E '^[[:space:]]*includes[[:space:]]+\[' "$bf" 2>/dev/null \
    | sed -E 's/.*\[(.*)\].*/\1/' \
    | tr ',' '\n' \
    | sed -E 's/^[[:space:]]*"([^"]*)".*/\1/' \
    | while IFS= read -r inc; do
        [ -n "$inc" ] && printf '%s:' "$bit_dir/$inc"
      done
}

# Parse `Tungsten[:name] = "bit"` service binding lines from a Bitfile
# and emit them as "name=bit,name2=bit2,..." for TUNGSTEN_SERVICE_BINDINGS.
# Missing Bitfile or no bindings → empty output.
bitfile_service_bindings() {
  local bit_dir="$1"
  local bf="$bit_dir/Bitfile"
  [ -f "$bf" ] || return
  grep -E '^[[:space:]]*Tungsten\[:[a-z_]+\][[:space:]]*=[[:space:]]*"[^"]+"' "$bf" 2>/dev/null \
    | sed -E 's/^[[:space:]]*Tungsten\[:([a-z_]+)\][[:space:]]*=[[:space:]]*"([^"]+)".*/\1=\2/' \
    | tr '\n' ',' \
    | sed 's/,$//'
}

# Parse a Bitfile's `requires [...]` line and emit the bit names
# one per line. Same single-line form as `includes [...]`.
bitfile_requires() {
  local bit_dir="$1"
  local bf="$bit_dir/Bitfile"
  [ -f "$bf" ] || return
  grep -E '^[[:space:]]*requires[[:space:]]+\[' "$bf" 2>/dev/null \
    | sed -E 's/.*\[(.*)\].*/\1/' \
    | tr ',' '\n' \
    | sed -E 's/^[[:space:]]*"([^"]*)".*/\1/'
}

# Walk the requires graph from a starting bit dir, emitting colon-
# separated include paths for every transitively reached bit. BFS
# with a visited set to prevent infinite loops on cycles.
# Arg 1: starting bit dir (the project or bit whose Bitfile we're in).
# Arg 2: repo root (where bits/<name> lives).
walk_requires_includes() {
  local start_dir="$1"
  local repo_root="$2"
  local visited=""
  local queue="$start_dir"
  local emitted=""

  while [ -n "$queue" ]; do
    local current="${queue%% *}"
    queue="${queue#* }"
    [ "$queue" = "$current" ] && queue=""

    case ",$visited," in
      *,"$current",*) continue ;;
    esac
    visited="${visited},${current}"

    # Emit this Bitfile's own includes
    local cur_incs
    cur_incs=$(bitfile_includes "$current")
    if [ -n "$cur_incs" ]; then
      emitted="${emitted}${cur_incs}"
    fi

    # Enqueue each required bit's dir
    while IFS= read -r req; do
      [ -z "$req" ] && continue
      local req_dir="$repo_root/bits/$req"
      if [ ! -d "$req_dir" ]; then
        echo "bin/tungsten: requires '$req' not found under $repo_root/bits/" >&2
        return 1
      fi
      queue="${queue} ${req_dir}"
    done < <(bitfile_requires "$current")
  done

  printf '%s' "$emitted"
}

# Look up the Bitfile of the first existing file argument (before `--`) and:
#   1. Add its `includes` (and transitive `requires` includes) to
#      TUNGSTEN_C_INCLUDES so the link step picks up bit C files automatically.
#   2. Parse any `Tungsten[:svc] = "bit"` service bindings and export them as
#      TUNGSTEN_SERVICE_BINDINGS so the loader routes bare `use` calls.
resolve_bitfile_env() {
  local skip_next=0
  local arg bit_dir bit_incs bit_bindings
  for arg in "$@"; do
    if [ "$skip_next" -eq 1 ]; then
      skip_next=0
      continue
    fi
    case "$arg" in
      --) break ;;
      -o|--out|-e|--eval|--cpu|--target|--sysroot|--intern|--runtime|-j|--jobs|-I|--include|-F|--field|--explain|--dump-cache)
        skip_next=1
        ;;
      -*|--*) ;;
      *)
        if [ -f "$arg" ]; then
          bit_dir=$(find_bitfile_dir "$arg")
          if [ -n "$bit_dir" ]; then
            bit_incs=$(walk_requires_includes "$bit_dir" "$ROOT") || exit $?
            if [ -n "$bit_incs" ]; then
              if [ -n "$TUNGSTEN_C_INCLUDES" ]; then
                export TUNGSTEN_C_INCLUDES="${bit_incs}${TUNGSTEN_C_INCLUDES}"
              else
                export TUNGSTEN_C_INCLUDES="${bit_incs%:}"
              fi
            fi
            bit_bindings=$(bitfile_service_bindings "$bit_dir")
            if [ -n "$bit_bindings" ] && [ -z "$TUNGSTEN_SERVICE_BINDINGS" ]; then
              export TUNGSTEN_SERVICE_BINDINGS="$bit_bindings"
            fi
          fi
          break
        fi
        ;;
    esac
  done
}

# "compile" goes directly to the compiled binary's built-in compiler.
if [ "$1" = "compile" ]; then
  resolve_bitfile_env "${@:2}"
  # Default output path: `tungsten compile file.w` writes the binary `file`
  # (the source with its .w stripped), unless the user passed -o/--out. If that
  # path already exists, warn and confirm before clobbering it — and refuse
  # outright in a non-interactive shell (no TTY to answer the prompt). The
  # compiler's own default (file.wc) is left untouched for the build system.
  compile_out_args=()
  _has_out=""
  _src=""
  for arg in "${@:2}"; do
    case "$arg" in
      -o|--out|-o=*|--out=*) _has_out=1 ;;
      -*) ;;
      *.w) [ -z "$_src" ] && [ -f "$arg" ] && _src="$arg" ;;
    esac
  done
  if [ -z "$_has_out" ] && [ -n "$_src" ]; then
    _out="${_src%.w}"
    if [ -e "$_out" ]; then
      if [ -t 0 ] && [ -t 2 ]; then
        printf "'%s' already exists. Overwrite? [y/N] " "$_out" >&2
        read -r _ans
        case "$_ans" in
          y|Y|yes|YES|Yes) ;;
          *) echo "Aborted — no output written." >&2; exit 1 ;;
        esac
      else
        echo "tungsten compile: '$_out' already exists; pass -o <path> or remove it." >&2
        exit 1
      fi
    fi
    compile_out_args=(-o "$_out")
  fi
  if [ -x "$COMPILER" ]; then
    exec "$COMPILER" "$@" "${compile_out_args[@]}"
  else
    exec "$RUBY" "$RUBY_CLI" "$@" "${compile_out_args[@]}"
  fi
fi

# "run file.w" compiles through WIRE and runs (or interprets with --interpret).
# `--ruby` forces the Ruby tree-walker instead; and it's also the fallback when
# no compiler is built yet.
if [ "$1" = "run" ]; then
  shift  # remove "run"
  ruby_mode=false
  run_args=()
  for arg in "$@"; do
    if [ "$arg" = "--ruby" ]; then
      ruby_mode=true
    else
      run_args+=("$arg")
    fi
  done
  if [ "$ruby_mode" = false ] && [ -x "$COMPILER" ]; then
    resolve_bitfile_env "${run_args[@]}"
    exec "$COMPILER" run "${run_args[@]}"
  else
    exec "$RUBY" "$RUBY_CLI" --ruby "${run_args[@]}"
  fi
fi

# --interpret: run through the Tungsten tree-walking interpreter when built,
# falling back to the Ruby interpreter only with --ruby or when unbootstrapped.
if [ "$1" = "--interpret" ]; then
  ruby_mode=false
  for arg in "$@"; do
    [ "$arg" = "--" ] && break
    [ "$arg" = "--ruby" ] && ruby_mode=true
  done
  if [ "$ruby_mode" = false ] && [ -x "$COMPILER" ]; then
    resolve_bitfile_env "${@:2}"
    exec "$COMPILER" run "$@"
  else
    shift
    exec "$RUBY" "$RUBY_CLI" --ruby "$@"
  fi
fi

# Developer / internal REPL modes (--jit/--hot). Public REPL is `wit` or
# `tungsten console` — not `tungsten --repl`.
case "$1" in
  --jit|--hot)
    if [ -x "$COMPILER" ]; then
      exec "$COMPILER" "$@"
    else
      exec "$RUBY" "$RUBY_CLI" "$@"
    fi
    ;;
  --repl|--wit)
    echo "tungsten: use \`bin/wit\` or \`bin/tungsten console\` for the REPL" >&2
    exit 2
    ;;
esac

# Leading-flag invocations (`-e`, `-c`, `-o`, `--ll`, `--ast`, `--lex`,
# `--clear-cache`, `--version`, etc.). Never boot the Ruby CLI unless `--ruby`
# was explicitly requested or no compiled compiler exists yet.
case "$1" in
  -h|--help|-\?)
    : # fall through to the compiled-CLI block (renders doc/TUNGSTEN.md via Argon)
    ;;
  --version)
    echo "tungsten $TUNGSTEN_VERSION"
    exit 0
    ;;
  --copyright)
    printf 'tungsten - Copyright (c) 2013–2026 Erik Peterson.\nTungsten is freely available under the MIT License.\n'
    exit 0
    ;;
  --clear-cache)
    cache_dir="${TUNGSTEN_CACHE_DIR:-$ROOT/build/cache}"
    count=0
    if [ -d "$cache_dir" ]; then
      for f in "$cache_dir"/*.memo "$cache_dir"/irbin-*; do
        if [ -f "$f" ]; then
          rm -f "$f"
          count=$((count + 1))
        fi
      done
    fi
    if [ "$count" -eq 1 ]; then
      echo "Cleared 1 cache file"
    else
      echo "Cleared $count cache files"
    fi
    exit 0
    ;;
  --explain)
    shift
    set -- explain "$@"
    ;;
  -P|--profile)
    shift
    set -- flame "$@"
    ;;
  -*)
    if [ "$#" -eq 1 ] && [ "$1" = "-v" ]; then
      echo "tungsten $TUNGSTEN_VERSION"
      exit 0
    fi
    _ruby_flag=""
    _has_ll=""
    _has_emit_ll=""
    _has_out=""
    _compile_mode=""
    _interactive=""
    _has_eval=""
    _skip=0
    for _arg in "$@"; do
      if [ "$_skip" -eq 1 ]; then
        _skip=0
        continue
      fi
      case "$_arg" in
        --) break ;;
        --ruby) _ruby_flag=1 ;;
        --dump-cache) _ruby_flag=1 ;;
        --ll) _has_ll=1 ;;
        --emit-ll) _has_emit_ll=1; _compile_mode=1 ;;
        -o|--out) _has_out=1; _compile_mode=1; _skip=1 ;;
        -o=*|--out=*) _has_out=1; _compile_mode=1 ;;
        -e|--eval) _has_eval=1; _skip=1 ;;
        --eval=*) _has_eval=1 ;;
        -i|--interactive) _interactive=1 ;;
        -c|--check|--ast|--parse|--canonical-ast|--lex|--tags|--wire|--emit-wire|--optimizations|--optimizations-json|--perf-inspect|--perf-inspect-json)
          _compile_mode=1
          ;;
        --cpu|--target|--sysroot|--intern|--runtime|-j|--jobs)
          _skip=1
          ;;
      esac
    done
    if [ -n "$_ruby_flag" ] || [ ! -x "$COMPILER" ]; then
      exec "$RUBY" "$RUBY_CLI" "$@"
    fi
    resolve_bitfile_env "$@"
    if [ -n "$_has_ll" ] && [ -z "$_has_out" ] && [ -z "$_has_emit_ll" ]; then
      _tmp_ll="$(mktemp "${TMPDIR:-/tmp}/tungsten-ll.XXXXXX.ll")"
      if TUNGSTEN_LL_PATH="$_tmp_ll" "$COMPILER" compile --emit-ll "$@"; then
        cat "$_tmp_ll"
        rm -f "$_tmp_ll"
        exit 0
      else
        _rc=$?
        rm -f "$_tmp_ll"
        exit "$_rc"
      fi
    fi
    if [ -n "$_interactive" ] && [ -z "$_has_eval" ]; then
      exec "$COMPILER" --repl
    fi
    if [ -n "$_compile_mode" ]; then
      exec "$COMPILER" "$@"
    fi
    exec "$COMPILER" run "$@"
    ;;
esac

if [ -f "$1" ]; then
  # Bare `tungsten file.w ...` runs through the compiled compiler (same path
  # as `tungsten run file.w`). Falls back to the Ruby tree-walker only when
  # `--ruby` is passed or no compiler exists.
  _ruby_flag=""
  for _arg in "$@"; do
    [ "$_arg" = "--" ] && break
    [ "$_arg" = "--ruby" ] && _ruby_flag=1
  done
  if [ -z "$_ruby_flag" ] && [ -x "$COMPILER" ]; then
    resolve_bitfile_env "$@"
    exec "$COMPILER" run "$@"
  else
    exec "$RUBY" "$RUBY_CLI" --ruby "$@"
  fi
fi

if [ -x "$COMPILER" ]; then
  # The compiled compiler BUILDS the Tungsten-written CLI (bin/tungsten.wc)
  # but does not exec it — so `tungsten file.w` used to print "Built …" and
  # exit without running anything. Build if stale, then run the CLI with the
  # user's args. BIT_HOME is required so `use argon` resolves under bits/.
  WC="$ROOT/bin/tungsten.wc"
  # Staleness must also track the COMPILER, not just bin/tungsten.w. The CLI
  # embeds the interpreter (compiler/lib/interpreter.w) and the rest of the
  # compiler library, so an interpreter fix left this cache serving the old
  # behavior indefinitely — `tungsten -e` kept reporting a bug that was
  # already fixed, with a rebuild appearing to do nothing. Any such change
  # rebuilds $COMPILER, so comparing against it captures the dependency
  # transitively for one stat call.
  if [ ! -x "$WC" ] || [ "$ROOT/bin/tungsten.w" -nt "$WC" ] || [ "$COMPILER" -nt "$WC" ]; then
    # A CLI that fails to compile must SAY so: this fallback ran silently
    # for five weeks while bin/tungsten.w did not lex, and every `tungsten`
    # invocation was the Ruby CLI without anyone noticing.
    WC_LOG="${TMPDIR:-/tmp}/tungsten-cli-build.log"
    if ! BIT_HOME="$ROOT/bits" \
        "$COMPILER" compile "$ROOT/bin/tungsten.w" --out "$WC" --no-lto >"$WC_LOG" 2>&1; then
      echo "tungsten: bin/tungsten.w failed to compile; running the Ruby CLI instead (see $WC_LOG)" >&2
      sed -n '/error/{p;q;}' "$WC_LOG" >&2
      exec "$RUBY" "$RUBY_CLI" "$@"
    fi
    # Ad-hoc codesign on macOS so a freshly linked CLI is launchable.
    if [ "$(uname -s)" = "Darwin" ]; then
      codesign --force -s - "$WC" >/dev/null 2>&1 || true
    fi
  fi
  exec "$WC" "$@"
else
  # Fresh clone: doctor/bootstrap are already handled above. start without a
  # compiler gets a tiny pure-shell welcome (no Ruby).
  case "$1" in
    start|"")
      echo "The Tungsten Programming Language"
      echo
      echo "  Next: bin/tungsten bootstrap  # build the compiler (full self-host + bits)"
      echo "  Docs: doc/getting-started/"
      exit 0
      ;;
    --version|-v)
      echo "tungsten $(cat "$ROOT/VERSION" 2>/dev/null || echo dev)"
      exit 0
      ;;
  esac
  exec "$RUBY" "$RUBY_CLI" "$@"
fi
TUNGSTEN_POLYGLOT_BASH
