#!/bin/bash
# bin/wit — W Interactive Tungsten (REPL)
#
# Canonical playground entry point. Equivalent to: tungsten console

# Resolve symlinks so ROOT is the real install dir even when invoked via PATH.
SELF="$0"
while [ -L "$SELF" ]; do
  LINK="$(readlink "$SELF")"
  case "$LINK" in
    /*) SELF="$LINK" ;;
    *)  SELF="$(dirname "$SELF")/$LINK" ;;
  esac
done
ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
COMPILER="$ROOT/bin/tungsten-compiler"

export TUNGSTEN_VERSION="$(cat "$ROOT/VERSION" 2>/dev/null || echo dev)"
export TUNGSTEN_ROOT="$ROOT"

if [ ! -x "$COMPILER" ]; then
  echo "wit: no self-hosted compiler at $COMPILER" >&2
  echo "run bin/tungsten bootstrap, then retry" >&2
  exit 1
fi

# The public REPL is always compiler/lib/repl.w embedded in the self-hosted
# compiler. A cold checkout bootstraps first; it never substitutes the Ruby
# tree walker and silently changes interactive semantics.
exec "$COMPILER" --repl "$@"
