tungsten "tungsten-0.0.1"

name        "tungsten-metaflip"
version     "0.2.0"
summary     "Exact-gated adaptive search with GF(2) tensor fleets"
description "Domain-neutral exact-gated adaptive search plus Pure-Tungsten CPU and Metal fleets for matrix-multiplication tensor decompositions over GF(2)."
license     "MIT OR Apache-2.0 WITH LLVM-exception"
authors     ["Erik Peterson"]

