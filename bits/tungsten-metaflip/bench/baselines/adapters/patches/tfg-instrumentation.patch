+// metabench instrumentation (see bench/baselines/adapters/README.md), single-threaded runs only: global flip / attempt counters,
+// a TFGTRACE line on stderr for every new global best rank, and stop at --target-rank inside the round.
+// The search itself is unchanged.
+struct MbState {
+    long long flips = 0;
+    long long attempts = 0;
+    long long expands = 0;
+    int best = 1 << 30;
+    int stop = 0;
+    bool stopped = false;
+};
+inline MbState mb;
+inline double mbCpu() {
+    struct rusage ru;
+    getrusage(RUSAGE_SELF, &ru);
+    return double(ru.ru_utime.tv_sec + ru.ru_stime.tv_sec) + 1e-6 * double(ru.ru_utime.tv_usec + ru.ru_stime.tv_usec);
+}
