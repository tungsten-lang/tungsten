  # `width` values for palm target (x, y, z), trilinear in the grid.
  -> .at(tab, width, x, y, z)
    g = grid
    fx = cell(x, g[0], g[1], g[2])
    fy = cell(y, g[3], g[4], g[5])
    fz = cell(z, g[6], g[7], g[8])
    ny = g[5]
    nz = g[8]
    out = (0...width).map ->(i) ~0.0
    c = 0
    while c < 8
      ix = fx[0]
      wx = ~1.0 - fx[1]
      if c % 2 == 1
        ix = fx[0] + 1
        wx = fx[1]
      iy = fy[0]
      wy = ~1.0 - fy[1]
      if (c / 2) % 2 == 1
        iy = fy[0] + 1
        wy = fy[1]
      iz = fz[0]
      wz = ~1.0 - fz[1]
      if c / 4 == 1
        iz = fz[0] + 1
        wz = fz[1]
      w = wx * wy * wz
      base = ((ix * ny + iy) * nz + iz) * width
      k = 0
      while k < width
        out[k] += w * tab[base + k]
        k += 1
      c += 1
    out

  # [lower index, fraction] of v in a grid of n points over [lo, hi], clamped.
  -> .cell(v, lo, hi, n)
    u = (v - lo) / (hi - lo) * (n - 1)
    return [0, ~0.0] if u <= ~0.0
    return [n - 2, ~1.0] if u >= n - 1
    i = 0
    while i + 1 < n - 1 && i + 1 <= u
      i += 1
    [i, u - i]
