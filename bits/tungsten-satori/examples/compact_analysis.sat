import realx

+ log_growth (u p : ℝ) (hu : 0 ≤ u) (hp : 1024*u ≤ p) :
    log (2+1024*u) ≤ log (2+p)
  auto

-> decay (a x : ℝ) : ℝ := exp (0-a*x)
+ decay_order (a x y : ℝ) (ha : 0 ≤ a) (h : x ≤ y) : decay a y ≤ decay a x
  auto

+ log_square (x y : ℝ) (hx : 0 ≤ x) (h : x ≤ y) : log (1+x*x) ≤ log (1+y*y)
  auto

+ nested_order (x y : ℝ) (h : x ≤ y) : log (exp x) ≤ log (exp y)
  auto

+ root_order (x y : ℝ) (hx : 0 ≤ x) (h : x ≤ y) : sqrt x ≤ sqrt y
  auto

+ root_bound (x y : ℝ) (hx : 0 ≤ x) (hy : 0 ≤ y) (h : x < y*y) : sqrt x < y
  auto

+ squared_bound (x y : ℝ) (hx : 0 ≤ x) (hy : 0 ≤ y) (h : sqrt x < y) : x < y*y
  auto
