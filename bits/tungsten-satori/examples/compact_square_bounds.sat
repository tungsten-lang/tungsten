import arith

+ weighted_bound (a y s : ℚ) (ha : 0 ≤ a) (hy : 0 ≤ y) (hs : 0 ≤ s) (h : y*y ≤ s*s) : a*y ≤ a*s
  auto

+ two_weighted_bounds (a b y z s t : ℚ) (ha : 0 ≤ a) (hb : 0 ≤ b) (hy : 0 ≤ y) (hz : 0 ≤ z)
    (hs : 0 ≤ s) (ht : 0 ≤ t) (hys : y*y ≤ s*s) (hzt : z*z ≤ t*t) : a*y+b*z ≤ a*s+b*t
  auto

+ coupling_five (X P1 P2 Y a s : ℚ) (ha : 0 ≤ a) (hs : 0 ≤ s) (hY0 : 0 ≤ Y)
    (hX : X = P1+P2) (h1 : P1 ≤ 4*a*s) (h2 : P2 ≤ a*Y) (hY : 4*(Y*Y) ≤ X) (hX4 : X ≤ 4*(s*s)) : X ≤ 5*a*s
  auto
