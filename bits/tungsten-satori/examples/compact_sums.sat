-- Compact finite-sum patterns from growth, mixing and simplicial-complex proofs.
import arith

-> shifted (d : ℕ → ℝ) (a i : ℕ) : ℝ := d (a + i)
-> scaled (e : ℕ → ℝ) (s : ℝ) (i : ℕ) : ℝ := s * e i

+ sum_split (d : ℕ → ℝ) (a b : ℕ) : sum_below (a + b) d = sum_below a d + sum_below b (shifted d a)
  auto

+ sum_scaled (e : ℕ → ℝ) (s : ℝ) (n : ℕ) : sum_below n (scaled e s) = s * sum_below n e
  auto

+ sum_nonneg_all (g : ℕ → ℝ) (n : ℕ) (h : ∀ i : ℕ, 0 ≤ g i) : 0 ≤ sum_below n g
  auto

+ sum_lo (g : ℕ → ℝ) (lo : ℝ) (nn : ℕ) (h : ∀ i < nn, lo ≤ g i) (n : ℕ) : n ≤ nn → (n : ℝ) * lo ≤ sum_below n g
  auto

+ sum_hi (g : ℕ → ℝ) (hi : ℝ) (nn : ℕ) (h : ∀ i < nn, g i ≤ hi) (n : ℕ) : n ≤ nn → sum_below n g ≤ (n : ℝ) * hi
  auto

+ sum_mono (d : ℕ → ℝ) (a b : ℕ) (h : ∀ i : ℕ, 0 ≤ d i) (hab : a ≤ b) : sum_below a d ≤ sum_below b d
  auto

+ first_term (f : ℕ → ℝ) (n : ℕ) : (∑ i < n+1, f i) = f 0 + (∑ i < n, f (i+1))
  auto

+ selected_term (f : ℕ → ℝ) (n j : ℕ) (h : j < n) :
    (∑ i < n, f i*(if i=j then 1 else 0)) = f j
  auto

+ excluded_term (f : ℕ → ℝ) (n j : ℕ) (h : n ≤ j) :
    (∑ i < n, f i*(if i=j then 1 else 0)) = 0
  auto

+ selected_entry (f : ℕ → ℕ → ℝ) (n m j k : ℕ) (hj : j < n) (hk : k < m) :
    (∑ i < n, (∑ l < m, f i l*(if l=k then 1 else 0))*(if i=j then 1 else 0)) = f j k
  auto

+ selected_offset (f : ℕ → ℝ) (n j : ℕ) (v : ℝ) (hj : j < n) (h : f j+3 = v+2) :
    (∑ i < n, f i*(if i=j then 1 else 0))+1 = v
  auto

+ selected_pair (f : ℕ → ℝ) (n a b : ℕ) (ha : a < n) (hb : b < n) :
    (∑ i < n, f i*((if i=a then 1 else 0)+(if i=b then 1 else 0))) = f a+f b
  auto

+ selected_difference (f : ℕ → ℝ) (n a b : ℕ) (ha : a < n) (hb : b < n) :
    (∑ i < n, f i*((if i=a then 1 else 0)-(if i=b then 1 else 0))) = f a-f b
  auto

+ uniform_total (f : ℕ → ℝ) (n : ℕ) (c : ℝ) (h : ∀ i < n, f i=c) :
    (∑ i < n, f i) = (n : ℝ)*c
  auto

+ count_ones (f : ℕ → ℝ) (n : ℕ) (h : ∀ i < n, f i=1) : (∑ i < n, f i) = (n : ℝ)
  auto

+ cumulative (f s : ℕ → α) (base : s 0=0) (step : ∀ i, s (i+1)=s i+f i) (n : ℕ) :
    s n = ∑ i < n, f i
  auto

+ increments (f : ℕ → ℝ) (n : ℕ) : (∑ i < n, f (i+1)-f i) = f n-f 0
  auto

+ recover_endpoint (f : ℕ → ℝ) (n : ℕ) : (∑ i < n, f (i+1)-f i)+f 0 = f n
  auto

-> running_total (f : ℕ → α) : ℕ → α
  | 0 => 0
  | n + 1 => running_total f n + f n

+ custom_increments (f : ℕ → ℝ) (n : ℕ) : running_total (fun i => f (i+1)-f i) n = f n-f 0
  auto

+ custom_constant (f : ℕ → ℝ) (n : ℕ) (c : ℝ) (h : ∀ i < n, f i=c) : running_total f n = (n : ℝ)*c
  auto
