import arith

+ zero_sum (n : ℕ) : (∑ i < n, (0 : ℚ)) = 0
  auto

+ vanishing_sum (f : ℕ → ℝ) (n : ℕ) (h : ∀ i < n, f i = 0) :
    (∑ i < n, f i) = 0
  auto

+ vanishing_prefix (f : ℕ → ℤ) (n m : ℕ)
    (h : ∀ i < m, f i = 0) (hn : n ≤ m) : (∑ i < n, f i) = 0
  auto

+ cancelling_terms (f : ℕ → ℝ) (n : ℕ) : (∑ i < n, f i - f i) = 0
  auto
