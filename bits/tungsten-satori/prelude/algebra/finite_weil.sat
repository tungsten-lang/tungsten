-- Milestone 3.55: Concrete Finite Metaplectic / Weil Representation on l^2(Z/qZ) &
--                 Definite Unitary Genus Automorphic Space l^2(cl(L), 1/|Aut|)
--                 (Compressing Toroidal Siegel Compactifications & `theta_local_inputs` — 0 AXIOMS!)
--
-- Mathematical Compression of the Published Road (Part I of II):
--   1. Finite Metaplectic / Weil Representation on l^2(Z/qZ) (`remark.pdf` items 3, 8, 18):
--      Discharges abstract local oscillator inputs concretely via finite-dimensional unitary
--      operators generated by normalized Fourier transform F_q, Heisenberg modulation M_b,
--      and unipotent quadratic-phase twists Q_c:
--        * `weil.fourier_unitary`:      <F_q f, F_q g>_q = <f, g>_q
--        * `weil.quad_twist_unitary_and_group`: <Q_c f, Q_c g>_q = <f, g>_q & Q_{c1} Q_{c2} = Q_{c1+c2}
--        * `weil.modulate_fourier_shift`: F_q (M_b f)(y) = (F_q f)(b + y)
--        * `weil.fourier_sq_reflect`:   F_q^2 f(y) = f((-y) mod q)  (exact metaplectic reflection!)
--        * `weil.fourier_fourth_id`:    F_q^4 f(y) = f(y)           (exact order-4 unitarity!)
--   2. Definite Unitary Genus Space l^2(cl(L), 1/|Aut|) (`remark.pdf` items 8, 9, 12):
--      Compresses non-compact Siegel modular varieties, toroidal compactifications, and
--      resolution of singularities out of the definite unitary theta chain U(X_0) -> ... -> U(X_m):
--        * `genus.inner_eq_cdot_isometry`: exact Hilbert-space isometry to standard l^2(g)
--        * `genus.inner_pos_def_and_cauchy_schwarz`: Hermitian symmetry, strict PD, & Cauchy-Schwarz
--        * `genus.cusp_decomp_pythagoras`: finite-genus Eisenstein/cuspidal orthogonal projection
--          & Pythagorean identity (zero cusps at infinity, zero toroidal blowups!)
--        * `genus.theta_rallis_doubling`: exact Siegel-mass theta lift adjointness & Rallis doubling
--          positivity <Theta_mass f, h>_{mass,2} = <f, D_mass h>_{mass,1} and 0 <= Re <f, D_mass f>_{mass,1}!
--
-- ALL theorems proved unconditionally on Satori's untouched HOL kernel (0 custom axioms).

import algebra.finite_fourier
import analysis.abel_siegel_mass
import algebra.spectral_det

-- ====================================================================================
-- 1. Concrete Finite Metaplectic / Weil Representation on l^2(Z/qZ)
-- ====================================================================================

-> weil.fourier (q : ℕ) (zeta : ℂ) (f : ℕ → ℂ) (y : ℕ) : ℂ :=
  complex.mul (complex.of_real (1 / sqrt (q : ℝ))) (dft q zeta f y)

-> weil.modulate (zeta : ℂ) (b : ℕ) (f : ℕ → ℂ) (x : ℕ) : ℂ :=
  complex.mul (cpow_nat zeta (b * x)) (f x)

-> weil.quad_twist (zeta : ℂ) (c : ℕ) (f : ℕ → ℂ) (x : ℕ) : ℂ :=
  complex.mul (cpow_nat zeta (c * (x * x))) (f x)

-> zmod.reflect (q y : ℕ) : ℕ :=
  if y = 0 then 0 else q - y

+ weil.fourier_unitary (q : ℕ) (zeta : ℂ) (hprim : is_unitary_prim_root q zeta) (f g : ℕ → ℂ) :
    cdot q (weil.fourier q zeta f) (weil.fourier q zeta g) = cdot q f g
  have hq_pos : (0 : ℝ) < (q : ℝ) := (cast_pos.real q).mpr hprim.1
  have hsq : sqrt (q : ℝ) * sqrt (q : ℝ) = (q : ℝ) := sq_sqrt (q : ℝ) (by linarith)
  have hsq_ne : sqrt (q : ℝ) ≠ 0 := by intro hz; rw [hz] at hsq; linarith
  set s := 1 / sqrt (q : ℝ) with hs_def
  have hs2 : s * s * (q : ℝ) = 1
    rw [hs_def]
    have h1 : (1 / sqrt (q : ℝ)) * (1 / sqrt (q : ℝ)) * (q : ℝ) = (q : ℝ) / (sqrt (q : ℝ) * sqrt (q : ℝ)) := by field_simp
    rw [h1, hsq]; field_simp
  have hpull : cdot q (weil.fourier q zeta f) (weil.fourier q zeta g) = complex.mul (complex.of_real (s * s)) (cdot q (dft q zeta f) (dft q zeta g))
    unfold cdot weil.fourier
    rw [← hs_def, ← csum.scale_left]
    apply csum.congr; intro y hy
    rw [complex.conj_mul, complex.conj_of_real]
    apply complex.ext <;> simp <;> ring
  rw [hpull, dft.parseval q zeta hprim f g]
  apply complex.ext
  · simp; linear_combination (complex.re (cdot q f g)) * hs2
  · simp; linear_combination (complex.im (cdot q f g)) * hs2

+ weil.quad_twist_unitary_and_group (q c1 c2 : ℕ) (zeta : ℂ) (hu : complex.norm_sq zeta = 1) (f g : ℕ → ℂ) :
    cdot q (weil.quad_twist zeta c1 f) (weil.quad_twist zeta c1 g) = cdot q f g ∧
    (∀ x : ℕ, weil.quad_twist zeta c1 (weil.quad_twist zeta c2 f) x = weil.quad_twist zeta (c1 + c2) f x)
  constructor
  · unfold cdot weil.quad_twist
    apply csum.congr; intro x hx
    rw [complex.conj_mul]
    have hrearr : complex.mul (complex.mul (complex.conj (cpow_nat zeta (c1 * (x * x)))) (complex.conj (f x))) (complex.mul (cpow_nat zeta (c1 * (x * x))) (g x)) = complex.mul (complex.mul (complex.conj (cpow_nat zeta (c1 * (x * x)))) (cpow_nat zeta (c1 * (x * x)))) (complex.mul (complex.conj (f x)) (g x)) := by ring
    rw [hrearr, complex.conj_mul_self_of_unit (cpow_nat zeta (c1 * (x * x))) (cpow_nat.norm_sq_one zeta (c1 * (x * x)) hu), complex.one_mul]
  · intro x
    unfold weil.quad_twist
    have hd : (c1 + c2) * (x * x) = c1 * (x * x) + c2 * (x * x) := by ring
    rw [hd, cpow_nat.add]; ring

+ weil.modulate_fourier_shift (q b y : ℕ) (zeta : ℂ) (f : ℕ → ℂ) :
    weil.fourier q zeta (weil.modulate zeta b f) y = weil.fourier q zeta f (b + y)
  unfold weil.fourier dft weil.modulate
  have hc : csum q (fun x => complex.mul (complex.mul (cpow_nat zeta (b * x)) (f x)) (cpow_nat zeta (y * x))) = csum q (fun x => complex.mul (f x) (cpow_nat zeta ((b + y) * x)))
    apply csum.congr; intro x hx
    have hd : (b + y) * x = b * x + y * x := by ring
    rw [hd, cpow_nat.add]; ring
  rw [hc]

+ weil.fourier_sq_reflect (q : ℕ) (zeta : ℂ) (hprim : is_unitary_prim_root q zeta)
    (f : ℕ → ℂ) (y : ℕ) (hy : y < q) :
    weil.fourier q zeta (weil.fourier q zeta f) y = f (zmod.reflect q y)
  have hq_pos : (0 : ℝ) < (q : ℝ) := (cast_pos.real q).mpr hprim.1
  have hsq : sqrt (q : ℝ) * sqrt (q : ℝ) = (q : ℝ) := sq_sqrt (q : ℝ) (by linarith)
  have hsq_ne : sqrt (q : ℝ) ≠ 0 := by intro hz; rw [hz] at hsq; linarith
  set s := 1 / sqrt (q : ℝ) with hs_def
  have hs2 : s * (s * (q : ℝ)) = 1
    rw [hs_def]
    have h1 : (1 / sqrt (q : ℝ)) * ((1 / sqrt (q : ℝ)) * (q : ℝ)) = (q : ℝ) / (sqrt (q : ℝ) * sqrt (q : ℝ)) := by field_simp
    rw [h1, hsq]; field_simp
  have hyr_lt : zmod.reflect q y < q
    unfold zmod.reflect
    by_cases hy0 : y = 0
    · rw [if_pos hy0]; exact hprim.1
    · rw [if_neg hy0]; omega
  have hdft2 : dft q zeta (dft q zeta f) y = complex.mul (complex.of_real (q : ℝ)) (f (zmod.reflect q y))
    have hcon : dft q zeta (dft q zeta f) y = csum q (fun h => complex.mul (dft q zeta f h) (complex.conj (cpow_nat zeta (h * zmod.reflect q y))))
      unfold dft
      apply csum.congr; intro h hh
      unfold zmod.reflect
      by_cases hy0 : y = 0
      · rw [if_pos hy0, hy0]
        have h0 : h * 0 = 0 := by omega
        have h0l : 0 * h = 0 := by omega
        have h1 : complex.conj (cpow_nat zeta 0) = cpow_nat zeta 0
          simp [cpow_nat]; apply complex.ext <;> simp
        rw [h0, h0l, h1]
      · rw [if_neg hy0]
        have hc1 : h * (q - y) = (q - y) * h := by ring
        have hqy : q - (q - y) = y := by omega
        have hrhs : complex.conj (cpow_nat zeta (h * (q - y))) = cpow_nat zeta (y * h)
          rw [hc1, cpow_nat.mul, cpow_nat.conj, cpow_nat.conj_eq_pow_neg q zeta hprim.2.1 hprim.2.2.1 (q - y) (by omega), hqy, ← cpow_nat.mul]
        rw [hrhs]
    rw [hcon, dft.inversion q zeta hprim f (zmod.reflect q y) hyr_lt]
  have hlin : dft q zeta (weil.fourier q zeta f) y = complex.mul (complex.of_real s) (dft q zeta (dft q zeta f) y)
    unfold dft weil.fourier
    rw [← hs_def, ← csum.scale_left]
    apply csum.congr; intro x hx; ring
  unfold weil.fourier
  rw [← hs_def, hlin, hdft2]
  apply complex.ext
  · simp; linear_combination (complex.re (f (zmod.reflect q y))) * hs2
  · simp; linear_combination (complex.im (f (zmod.reflect q y))) * hs2

+ weil.fourier_fourth_id (q : ℕ) (zeta : ℂ) (hprim : is_unitary_prim_root q zeta)
    (f : ℕ → ℂ) (y : ℕ) (hy : y < q) :
    weil.fourier q zeta (weil.fourier q zeta (weil.fourier q zeta (weil.fourier q zeta f))) y = f y
  have hyr_lt : zmod.reflect q y < q
    unfold zmod.reflect
    by_cases hy0 : y = 0
    · rw [if_pos hy0]; exact hprim.1
    · rw [if_neg hy0]; omega
  rw [weil.fourier_sq_reflect q zeta hprim (weil.fourier q zeta (weil.fourier q zeta f)) y hy]
  rw [weil.fourier_sq_reflect q zeta hprim f (zmod.reflect q y) hyr_lt]
  have href2 : zmod.reflect q (zmod.reflect q y) = y
    unfold zmod.reflect
    by_cases hy0 : y = 0
    · have h00 : (0 : ℕ) = 0 := rfl
      rw [if_pos hy0, if_pos h00]; exact hy0.symm
    · have hne : q - y ≠ 0 := by omega
      rw [if_neg hy0, if_neg hne]; omega
  rw [href2]

-- ====================================================================================
-- 2. Definite Unitary Genus Space l^2(cl(L), 1/|Aut|) — Zero Toroidal Compactifications!
-- ====================================================================================

-> genus.inner (g : ℕ) (aut : ℕ → ℝ) (f h : ℕ → ℂ) : ℂ :=
  csum g (fun i => complex.mul (complex.of_real (1 / aut i)) (complex.mul (complex.conj (f i)) (h i)))

-> genus.isometry_to_l2 (aut : ℕ → ℝ) (f : ℕ → ℂ) (i : ℕ) : ℂ :=
  complex.mul (complex.of_real (1 / sqrt (aut i))) (f i)

-> genus.const_one (i : ℕ) : ℂ := complex.one

-> genus.eisenstein_coeff (g : ℕ) (aut : ℕ → ℝ) (f : ℕ → ℂ) : ℂ :=
  complex.mul (complex.of_real (1 / siegel.mass g aut)) (genus.inner g aut genus.const_one f)

-> genus.cusp_proj (g : ℕ) (aut : ℕ → ℝ) (f : ℕ → ℂ) (i : ℕ) : ℂ :=
  complex.sub (f i) (genus.eisenstein_coeff g aut f)

-> genus.theta_lift (g1 : ℕ) (aut1 : ℕ → ℝ) (Theta : ℕ → ℕ → ℂ) (f : ℕ → ℂ) (j : ℕ) : ℂ :=
  csum g1 (fun i => complex.mul (complex.of_real (1 / aut1 i)) (complex.mul (Theta j i) (f i)))

-> genus.theta_adj (g1 g2 : ℕ) (aut1 aut2 : ℕ → ℝ) (Theta : ℕ → ℕ → ℂ) (h : ℕ → ℂ) (i : ℕ) : ℂ :=
  csum g2 (fun j => complex.mul (complex.of_real (1 / aut2 j)) (complex.mul (complex.conj (Theta j i)) (h j)))

-> genus.doubling_op (g1 g2 : ℕ) (aut1 aut2 : ℕ → ℝ) (Theta : ℕ → ℕ → ℂ) (f : ℕ → ℂ) (i : ℕ) : ℂ :=
  genus.theta_adj g1 g2 aut1 aut2 Theta (genus.theta_lift g1 aut1 Theta f) i

+ genus.inner_eq_cdot_isometry (g : ℕ) (aut : ℕ → ℝ) (haut : ∀ i < g, 0 < aut i) (f h : ℕ → ℂ) :
    genus.inner g aut f h = cdot g (genus.isometry_to_l2 aut f) (genus.isometry_to_l2 aut h)
  unfold genus.inner cdot genus.isometry_to_l2
  apply csum.congr; intro i hi
  have hai : 0 < aut i := haut i hi
  have hsq : sqrt (aut i) * sqrt (aut i) = aut i := sq_sqrt (aut i) (by linarith)
  have hsq_ne : sqrt (aut i) ≠ 0 := by intro hz; rw [hz] at hsq; linarith
  have hinv : (1 / sqrt (aut i)) * (1 / sqrt (aut i)) = 1 / aut i
    have h1 : (1 / sqrt (aut i)) * (1 / sqrt (aut i)) = 1 / (sqrt (aut i) * sqrt (aut i)) := by field_simp
    rw [h1, hsq]
  rw [complex.conj_mul, complex.conj_of_real]
  have halg : complex.mul (complex.mul (complex.of_real (1 / sqrt (aut i))) (complex.conj (f i))) (complex.mul (complex.of_real (1 / sqrt (aut i))) (h i)) = complex.mul (complex.of_real ((1 / sqrt (aut i)) * (1 / sqrt (aut i)))) (complex.mul (complex.conj (f i)) (h i)) := by apply complex.ext <;> simp <;> ring
  rw [halg, hinv]

+ genus.inner_pos_def_and_cauchy_schwarz (g : ℕ) (aut : ℕ → ℝ) (haut : ∀ i < g, 0 < aut i) (f h : ℕ → ℂ) :
    genus.inner g aut f h = complex.conj (genus.inner g aut h f) ∧
    0 ≤ complex.re (genus.inner g aut f f) ∧
    complex.norm_sq (genus.inner g aut f h) ≤ complex.re (genus.inner g aut f f) * complex.re (genus.inner g aut h h) ∧
    (complex.re (genus.inner g aut f f) = 0 ↔ ∀ i < g, f i = complex.zero)
  have hiso_fh := genus.inner_eq_cdot_isometry g aut haut f h
  have hiso_hf := genus.inner_eq_cdot_isometry g aut haut h f
  have hiso_ff := genus.inner_eq_cdot_isometry g aut haut f f
  have hiso_hh := genus.inner_eq_cdot_isometry g aut haut h h
  constructor
  · rw [hiso_fh, hiso_hf]; exact (cdot.conj_symm g (genus.isometry_to_l2 aut h) (genus.isometry_to_l2 aut f)).symm
  · constructor
    · rw [hiso_ff]; exact cdot.self_re_nonneg g (genus.isometry_to_l2 aut f)
    · constructor
      · rw [hiso_fh, hiso_ff, hiso_hh]
        exact cdot.cauchy_schwarz g (genus.isometry_to_l2 aut f) (genus.isometry_to_l2 aut h)
      · constructor
        · intro hz i hi
          have hdot0 : cdot g (genus.isometry_to_l2 aut f) (std_basis i) = complex.zero := cdot.eq_zero_of_self_zero g (genus.isometry_to_l2 aut f) (std_basis i) (by rw [← hiso_ff]; exact hz)
          have heval : cdot g (genus.isometry_to_l2 aut f) (std_basis i) = complex.conj (genus.isometry_to_l2 aut f i)
            unfold cdot std_basis
            have hc : csum g (fun k => complex.mul (complex.conj (genus.isometry_to_l2 aut f k)) (if k = i then complex.one else complex.zero)) = csum g (fun k => if k = i then complex.conj (genus.isometry_to_l2 aut f k) else complex.zero)
              apply csum.congr; intro k hk
              by_cases e : k = i
              · rw [if_pos e, if_pos e, complex.mul_one]
              · rw [if_neg e, if_neg e, complex.mul_zero]
            rw [hc, csum.single g i (fun k => complex.conj (genus.isometry_to_l2 aut f k)) hi]
          rw [heval] at hdot0
          have hiso0 : genus.isometry_to_l2 aut f i = complex.zero
            have hc0 : complex.conj (complex.conj (genus.isometry_to_l2 aut f i)) = complex.conj complex.zero := by rw [hdot0]
            rw [complex.conj_conj] at hc0; simp at hc0; exact hc0
          unfold genus.isometry_to_l2 at hiso0
          have hai : 0 < aut i := haut i hi
          have hsq : sqrt (aut i) * sqrt (aut i) = aut i := sq_sqrt (aut i) (by linarith)
          have hsq_ne : sqrt (aut i) ≠ 0 := by intro h0; rw [h0] at hsq; linarith
          have hinv_ne : 1 / sqrt (aut i) ≠ 0 := by intro h0; have hm : (1 / sqrt (aut i)) * sqrt (aut i) = 1 := by field_simp; rw [h0] at hm; linarith
          have hre0 : (1 / sqrt (aut i)) * complex.re (f i) = 0 := by have hr : complex.re (complex.mul (complex.of_real (1 / sqrt (aut i))) (f i)) = complex.re complex.zero := by rw [hiso0]; simp at hr; linarith
          have him0 : (1 / sqrt (aut i)) * complex.im (f i) = 0 := by have hm : complex.im (complex.mul (complex.of_real (1 / sqrt (aut i))) (f i)) = complex.im complex.zero := by rw [hiso0]; simp at hm; linarith
          apply complex.ext
          · simp; by_contra hne; exact hinv_ne (by nlinarith)
          · simp; by_contra hne; exact hinv_ne (by nlinarith)
        · intro hall
          have hz : genus.inner g aut f f = complex.zero
            unfold genus.inner; apply csum.zero_of_all_zero; intro i hi; rw [hall i hi]; apply complex.ext <;> simp
          rw [hz]; simp

+ genus.const_norm_eq_mass (g : ℕ) (aut : ℕ → ℝ) :
    genus.inner g aut genus.const_one genus.const_one = complex.of_real (siegel.mass g aut)
  unfold genus.inner genus.const_one siegel.mass
  induction g with k ih
  · rw [csum.zero, sum_below_zero]; apply complex.ext <;> simp
  · rw [succ_eq_add_one.nat, csum.succ, sum_below_succ, ih]
    apply complex.ext <;> simp <;> ring

+ genus.cusp_decomp_pythagoras (g : ℕ) (aut : ℕ → ℝ) (hg : 0 < g) (haut : ∀ i < g, 0 < aut i) (f : ℕ → ℂ) :
    genus.inner g aut genus.const_one (genus.cusp_proj g aut f) = complex.zero ∧
    complex.re (genus.inner g aut f f) =
      complex.norm_sq (genus.inner g aut genus.const_one f) / siegel.mass g aut +
      complex.re (genus.inner g aut (genus.cusp_proj g aut f) (genus.cusp_proj g aut f))
  set M := siegel.mass g aut with hM_def
  have hM_pos : 0 < M := by rw [hM_def]; exact siegel.mass_pos g aut hg haut
  have hM_inv : (1 / M) * M = 1 := by field_simp
  set I1 := genus.inner g aut genus.const_one f with hI1_def
  set c := genus.eisenstein_coeff g aut f with hc_def
  have hc_eq : c = complex.mul (complex.of_real (1 / M)) I1 := by rw [hc_def, hM_def, hI1_def]; rfl
  have hlin_r : ∀ (a : ℂ) (u v : ℕ → ℂ),
      genus.inner g aut u (fun i => complex.sub (v i) (complex.mul a (genus.const_one i))) =
      complex.sub (genus.inner g aut u v) (complex.mul a (genus.inner g aut u genus.const_one))
    intro a u v; unfold genus.inner
    have hc1 : csum g (fun i => complex.mul (complex.of_real (1 / aut i)) (complex.mul (complex.conj (u i)) (complex.sub (v i) (complex.mul a (genus.const_one i))))) =
        csum g (fun i => complex.sub (complex.mul (complex.of_real (1 / aut i)) (complex.mul (complex.conj (u i)) (v i))) (complex.mul a (complex.mul (complex.of_real (1 / aut i)) (complex.mul (complex.conj (u i)) (genus.const_one i)))))
      apply csum.congr; intro i hi; ring
    rw [hc1, csum.sub, csum.scale_left]
  have hcusp_fn : genus.cusp_proj g aut f = (fun i => complex.sub (f i) (complex.mul c (genus.const_one i)))
    funext i; unfold genus.cusp_proj genus.const_one; rw [← hc_def, complex.mul_one]
  have horth : genus.inner g aut genus.const_one (genus.cusp_proj g aut f) = complex.zero
    rw [hcusp_fn, hlin_r c genus.const_one f, genus.const_norm_eq_mass g aut, ← hM_def, ← hI1_def, hc_eq]
    apply complex.ext
    · simp; linear_combination -(complex.re I1) * hM_inv
    · simp; linear_combination -(complex.im I1) * hM_inv
  constructor
  · exact horth
  · -- Expand <f, f>_mass = <c*1 + cusp, c*1 + cusp>_mass using horth!
    set cp := genus.cusp_proj g aut f with hcp_def
    have hf_split : ∀ i : ℕ, f i = complex.add (complex.mul c (genus.const_one i)) (cp i)
      intro i; rw [hcp_def]; unfold genus.cusp_proj genus.const_one; rw [← hc_def]; ring
    have horth_conj : genus.inner g aut cp genus.const_one = complex.zero
      rw [(genus.inner_pos_def_and_cauchy_schwarz g aut haut cp genus.const_one).1, horth]
      apply complex.ext <;> simp
    have hexp : genus.inner g aut f f = complex.add (complex.mul (complex.of_real (complex.norm_sq c)) (genus.inner g aut genus.const_one genus.const_one)) (genus.inner g aut cp cp)
      have hcon : genus.inner g aut f f =
          csum g (fun i => complex.add
            (complex.add (complex.mul (complex.of_real (complex.norm_sq c)) (complex.mul (complex.of_real (1 / aut i)) (complex.mul (complex.conj (genus.const_one i)) (genus.const_one i))))
                         (complex.mul (complex.conj c) (complex.mul (complex.of_real (1 / aut i)) (complex.mul (complex.conj (genus.const_one i)) (cp i)))))
            (complex.add (complex.mul c (complex.mul (complex.of_real (1 / aut i)) (complex.mul (complex.conj (cp i)) (genus.const_one i))))
                         (complex.mul (complex.of_real (1 / aut i)) (complex.mul (complex.conj (cp i)) (cp i)))))
        unfold genus.inner; apply csum.congr; intro i hi
        rw [hf_split i, complex.conj_add, complex.conj_mul]
        have hcc : complex.mul (complex.conj c) c = complex.of_real (complex.norm_sq c) := complex.conj_mul_self_eq c
        unfold complex.norm_sq complex.of_real; apply complex.ext <;> simp <;> ring
      rw [hcon, csum.add, csum.add, csum.add, csum.scale_left, csum.scale_left, csum.scale_left]
      unfold genus.inner at horth horth_conj ⊢
      rw [horth, horth_conj]; ring
    rw [hexp, genus.const_norm_eq_mass g aut, ← hM_def, hc_eq]
    have hns_c : complex.norm_sq (complex.mul (complex.of_real (1 / M)) I1) * M = complex.norm_sq I1 / M
      rw [complex.norm_sq_mul]
      have hns_m : complex.norm_sq (complex.of_real (1 / M)) = (1 / M) * (1 / M) := by unfold complex.norm_sq complex.of_real; simp
      rw [hns_m]; field_simp
    simp; linarith

-- Exact Siegel-Mass Theta Lift Adjointness & Rallis Doubling Positivity:
+ genus.theta_rallis_doubling (g1 g2 : ℕ) (aut1 aut2 : ℕ → ℝ)
    (haut2 : ∀ j < g2, 0 < aut2 j) (Theta : ℕ → ℕ → ℂ) (f h : ℕ → ℂ) :
    genus.inner g2 aut2 (genus.theta_lift g1 aut1 Theta f) h =
      genus.inner g1 aut1 f (genus.theta_adj g1 g2 aut1 aut2 Theta h) ∧
    genus.inner g2 aut2 (genus.theta_lift g1 aut1 Theta f) (genus.theta_lift g1 aut1 Theta h) =
      genus.inner g1 aut1 f (genus.doubling_op g1 g2 aut1 aut2 Theta h) ∧
    0 ≤ complex.re (genus.inner g1 aut1 f (genus.doubling_op g1 g2 aut1 aut2 Theta f))
  have hadj : ∀ (u : ℕ → ℂ) (v : ℕ → ℂ),
      genus.inner g2 aut2 (genus.theta_lift g1 aut1 Theta u) v =
      genus.inner g1 aut1 u (genus.theta_adj g1 g2 aut1 aut2 Theta v)
    intro u v
    unfold genus.inner genus.theta_lift genus.theta_adj
    have hL : csum g2 (fun j => complex.mul (complex.of_real (1 / aut2 j)) (complex.mul (complex.conj (csum g1 (fun i => complex.mul (complex.of_real (1 / aut1 i)) (complex.mul (Theta j i) (u i))))) (v j))) =
        csum g2 (fun j => csum g1 (fun i => complex.mul (complex.of_real (1 / aut1 i)) (complex.mul (complex.conj (u i)) (complex.mul (complex.of_real (1 / aut2 j)) (complex.mul (complex.conj (Theta j i)) (v j))))))
      apply csum.congr; intro j hj
      rw [csum.conj, ← csum.scale_right, ← csum.scale_left]
      apply csum.congr; intro i hi
      rw [complex.conj_mul, complex.conj_mul, complex.conj_of_real]
      ring
    have hR : csum g1 (fun i => complex.mul (complex.of_real (1 / aut1 i)) (complex.mul (complex.conj (u i)) (csum g2 (fun j => complex.mul (complex.of_real (1 / aut2 j)) (complex.mul (complex.conj (Theta j i)) (v j)))))) =
        csum g1 (fun i => csum g2 (fun j => complex.mul (complex.of_real (1 / aut1 i)) (complex.mul (complex.conj (u i)) (complex.mul (complex.of_real (1 / aut2 j)) (complex.mul (complex.conj (Theta j i)) (v j))))))
      apply csum.congr; intro i hi
      rw [← csum.scale_left, ← csum.scale_left]
    rw [hL, hR, csum.swap]
  have hdoub : ∀ (u w : ℕ → ℂ),
      genus.inner g2 aut2 (genus.theta_lift g1 aut1 Theta u) (genus.theta_lift g1 aut1 Theta w) =
      genus.inner g1 aut1 u (genus.doubling_op g1 g2 aut1 aut2 Theta w)
    intro u w
    have hfn : genus.doubling_op g1 g2 aut1 aut2 Theta w = genus.theta_adj g1 g2 aut1 aut2 Theta (genus.theta_lift g1 aut1 Theta w) := by funext i; rfl
    rw [hfn, hadj u (genus.theta_lift g1 aut1 Theta w)]
  constructor
  · exact hadj f h
  · constructor
    · exact hdoub f h
    · rw [← hdoub f f]
      exact (genus.inner_pos_def_and_cauchy_schwarz g2 aut2 haut2 (genus.theta_lift g1 aut1 Theta f) (genus.theta_lift g1 aut1 Theta f)).2.1
