-- Milestone 3.4: Cauchy-Schwarz / Approximate Orthogonality, Two-Scale Weil Positivity,
-- Legendre p-adic Divisibility, Integrality Gap, & VWin Window Closure (100% AXIOM-FREE!)
--
-- Mirrors `remark.pdf` items 2, 4, 6, 8, 9, 10, 12, 13, 14, 15, 16:
--   * Block 1 (items 4, 16): Gram-matrix quadratic form identity & approximate
--     orthogonality operator-norm bound `||sum c_i v_i||^2 <= (D + (m-1)*delta) * sum |c_i|^2`.
--   * Block 2 (item 6): Two-scale Weil positivity window `W(1_{(0,1]} + X^eta * 1_{(0,1/X]}) >= 0`
--     yielding the one-sided lower bound `G(x) >= -C * x^(1/2 + eps)`.
--   * Block 3 (items 2, 9, 10, 15): Integer divisibility-vs-height gap
--     `a != 0 ∧ p^v | a ∧ |a| <= exp(H) -> v * log p <= H`, PLUS full Legendre
--     factorial divisibility theorem `p^(sum_{k=1}^L floor(n / p^k)) | n!` and
--     upper bound `(p - 1) * v_p(n!) <= n` (plus inert-CM odd-power sub-sum).
--   * Block 4 (items 8, 12-15): Concrete `VWin` chain divisibility-beats-cost closure
--     (`c_div * log p > c_cost` forces vanishing of an integral obstruction at large m)
--     and concrete CM-forced-sum -> `G_lower_bound` -> `RiemannHypothesis` bridge!
--
-- ALL theorems proved unconditionally on Satori's foundational HOL kernel (0 custom axioms).

import l_function
import matrix
import factorial
import realx

-- ====================================================================================
-- BLOCK 1: Gram Matrix Positivity & Approximate Orthogonality (`remark.pdf` items 4, 16)
-- ====================================================================================

-- Linear combination of m vectors v_0, ..., v_{m-1} in C^n:
-> gram.lincomb (m : ℕ) (c : ℕ → ℂ) (v : ℕ → ℕ → ℂ) (x : ℕ) : ℂ :=
  csum m (fun i => complex.mul (c i) (v i x))

-- Gram quadratic form sum_{i,j < m} conj(c_i) * c_j * <v_i, v_j>_n:
-> gram.quad_form (n m : ℕ) (c : ℕ → ℂ) (v : ℕ → ℕ → ℂ) : ℂ :=
  csum m (fun i => csum m (fun j => complex.mul (complex.mul (complex.conj (c i)) (c j)) (cdot n (v i) (v j))))

-- THEOREM 1A (Exact Gram Quadratic Form = Norm Squared):
--   <sum_{i < m} c_i v_i, sum_{j < m} c_j v_j>_n = sum_{i,j < m} conj(c_i) * c_j * <v_i, v_j>_n.
+ gram.quad_form_eq_norm_sq (n m : ℕ) (c : ℕ → ℂ) (v : ℕ → ℕ → ℂ) :
    cdot n (gram.lincomb m c v) (gram.lincomb m c v) = gram.quad_form n m c v
  unfold cdot gram.lincomb gram.quad_form
  have h1 : csum n (fun x => complex.mul (complex.conj (csum m (fun i => complex.mul (c i) (v i x)))) (csum m (fun j => complex.mul (c j) (v j x)))) = csum n (fun x => csum m (fun i => csum m (fun j => complex.mul (complex.mul (complex.conj (c i)) (c j)) (complex.mul (complex.conj (v i x)) (v j x)))))
    apply csum.congr; intro x hx
    rw [csum.conj, ← csum.scale_right]
    apply csum.congr; intro i hi
    rw [complex.conj_mul, ← csum.scale_left]
    apply csum.congr; intro j hj
    apply complex.ext <;> simp <;> ring
  rw [h1, csum.swap]
  apply csum.congr; intro i hi
  rw [csum.swap]
  apply csum.congr; intro j hj
  rw [csum.scale_left]

+ gram.quad_form_nonneg (n m : ℕ) (c : ℕ → ℂ) (v : ℕ → ℕ → ℂ) :
    0 ≤ complex.re (gram.quad_form n m c v)
  rw [← gram.quad_form_eq_norm_sq n m c v]
  exact cdot.self_re_nonneg n (gram.lincomb m c v)

-- Helper: elementary real AM-GM / Cauchy bound for a complex inner product term:
--   if |w|^2 <= delta^2 (delta >= 0), then Re(conj(a) * b * w) <= (delta / 2) * (|a|^2 + |b|^2).
+ complex.re_triple_le (a b w : ℂ) (delta : ℝ) (hd : 0 ≤ delta)
    (hw : complex.norm_sq w ≤ delta * delta) :
    complex.re (complex.mul (complex.mul (complex.conj a) b) w)
      ≤ (delta / 2) * (complex.norm_sq a + complex.norm_sq b)
  have hns : complex.norm_sq (complex.mul (complex.mul (complex.conj a) b) w)
      = complex.norm_sq a * complex.norm_sq b * complex.norm_sq w
    rw [complex.norm_sq_mul, complex.norm_sq_mul]
    have hca : complex.norm_sq (complex.conj a) = complex.norm_sq a := by unfold complex.norm_sq; simp; ring
    rw [hca]
  have hre_sq : complex.re (complex.mul (complex.mul (complex.conj a) b) w)
        * complex.re (complex.mul (complex.mul (complex.conj a) b) w)
      ≤ complex.norm_sq (complex.mul (complex.mul (complex.conj a) b) w)
    unfold complex.norm_sq
    nlinarith
  have hna : 0 ≤ complex.norm_sq a := complex.norm_sq_nonneg a
  have hnb : 0 ≤ complex.norm_sq b := complex.norm_sq_nonneg b
  have hprod_le : complex.norm_sq a * complex.norm_sq b * complex.norm_sq w
      ≤ (delta / 2) * (complex.norm_sq a + complex.norm_sq b)
        * ((delta / 2) * (complex.norm_sq a + complex.norm_sq b))
    have hamgm : 4 * (complex.norm_sq a * complex.norm_sq b)
        ≤ (complex.norm_sq a + complex.norm_sq b) * (complex.norm_sq a + complex.norm_sq b)
      nlinarith
    have h1 : complex.norm_sq a * complex.norm_sq b * complex.norm_sq w
        ≤ complex.norm_sq a * complex.norm_sq b * (delta * delta)
      have hab : 0 ≤ complex.norm_sq a * complex.norm_sq b := mul_nonneg.real (complex.norm_sq a) (complex.norm_sq b) hna hnb
      exact mul_le_mul_of_nonneg_left.real (complex.norm_sq w) (delta * delta) (complex.norm_sq a * complex.norm_sq b) hw hab
    nlinarith
  have hrhs_nn : 0 ≤ (delta / 2) * (complex.norm_sq a + complex.norm_sq b) := by nlinarith
  nlinarith

-- THEOREM 1B (Approximate Orthogonality / Gershgorin Operator-Norm Bound, `remark.pdf` item 16):
-- If m columns v_0, ..., v_{m-1} in C^n satisfy ||v_i||^2 <= D and |<v_i, v_j>|^2 <= delta^2 (i != j),
-- then for ANY coefficient vector c:
--   ||sum_{i < m} c_i v_i||^2 <= (D + (m - 1) * delta) * sum_{i < m} |c_i|^2 !
+ gram.approx_orth_bound (n m : ℕ) (c : ℕ → ℂ) (v : ℕ → ℕ → ℂ) (D delta : ℝ)
    (hm : 1 ≤ m) (hd : 0 ≤ delta)
    (hdiag : ∀ i < m, complex.re (cdot n (v i) (v i)) ≤ D)
    (hoff : ∀ i < m, ∀ j < m, i ≠ j → complex.norm_sq (cdot n (v i) (v j)) ≤ delta * delta) :
    complex.re (cdot n (gram.lincomb m c v) (gram.lincomb m c v))
      ≤ (D + ((m : ℝ) - 1) * delta) * (∑ i < m, complex.norm_sq (c i))
  rw [gram.quad_form_eq_norm_sq]
  unfold gram.quad_form
  rw [csum.re]
  have hre_inner : (∑ i < m, complex.re (csum m (fun j => complex.mul (complex.mul (complex.conj (c i)) (c j)) (cdot n (v i) (v j))))) = ∑ i < m, ∑ j < m, complex.re (complex.mul (complex.mul (complex.conj (c i)) (c j)) (cdot n (v i) (v j))) := by apply sum_below.congr; intro i hi; exact csum.re m (fun j => complex.mul (complex.mul (complex.conj (c i)) (c j)) (cdot n (v i) (v j)))
  rw [hre_inner]
  -- Pointwise upper bound on each (i, j) term of the double sum:
  have hpt : (∑ i < m, ∑ j < m, complex.re (complex.mul (complex.mul (complex.conj (c i)) (c j)) (cdot n (v i) (v j))))
      ≤ ∑ i < m, ∑ j < m, (if i = j then D * complex.norm_sq (c i) else (delta / 2) * (complex.norm_sq (c i) + complex.norm_sq (c j)))
    have hdiff : 0 ≤ ∑ i < m, ∑ j < m, ((if i = j then D * complex.norm_sq (c i) else (delta / 2) * (complex.norm_sq (c i) + complex.norm_sq (c j))) - complex.re (complex.mul (complex.mul (complex.conj (c i)) (c j)) (cdot n (v i) (v j))))
      apply sum_nonneg.real; intro i hi
      apply sum_nonneg.real; intro j hj
      by_cases e : i = j
      · rw [e]
        have hif : ∀ (a b : ℝ), (if j = j then a else b) = a := by intro a b; simp
        rw [hif (D * complex.norm_sq (c j)) ((delta / 2) * (complex.norm_sq (c j) + complex.norm_sq (c j)))]
        have him0 : complex.im (cdot n (v j) (v j)) = 0 := cdot.self_im n (v j)
        have hre_diag : complex.re (complex.mul (complex.mul (complex.conj (c j)) (c j)) (cdot n (v j) (v j))) = complex.norm_sq (c j) * complex.re (cdot n (v j) (v j)) := by unfold complex.norm_sq; simp [him0]; ring
        rw [hre_diag]
        have hdj := hdiag j hj
        have hnc := complex.norm_sq_nonneg (c j)
        nlinarith
      · rw [if_neg e]
        have hle := complex.re_triple_le (c i) (c j) (cdot n (v i) (v j)) delta hd (hoff i hi j hj e)
        linarith
    have hsplit : (∑ i < m, ∑ j < m, ((if i = j then D * complex.norm_sq (c i) else (delta / 2) * (complex.norm_sq (c i) + complex.norm_sq (c j))) - complex.re (complex.mul (complex.mul (complex.conj (c i)) (c j)) (cdot n (v i) (v j))))) = (∑ i < m, ∑ j < m, (if i = j then D * complex.norm_sq (c i) else (delta / 2) * (complex.norm_sq (c i) + complex.norm_sq (c j)))) - (∑ i < m, ∑ j < m, complex.re (complex.mul (complex.mul (complex.conj (c i)) (c j)) (cdot n (v i) (v j))))
      rw [← sum_sub.real]
      apply sum_below.congr; intro i hi
      rw [sum_sub.real]
    rw [hsplit] at hdiff
    linarith
  -- Now evaluate the upper-bound double sum exactly!
  have heval : (∑ i < m, ∑ j < m, (if i = j then D * complex.norm_sq (c i) else (delta / 2) * (complex.norm_sq (c i) + complex.norm_sq (c j))))
      = (D + ((m : ℝ) - 1) * delta) * (∑ i < m, complex.norm_sq (c i))
    -- Rewrite each term as: (delta/2)*(norm_sq(c i) + norm_sq(c j)) + (if j = i then (D - delta)*norm_sq(c i) else 0)
    have hrew : (∑ i < m, ∑ j < m, (if i = j then D * complex.norm_sq (c i) else (delta / 2) * (complex.norm_sq (c i) + complex.norm_sq (c j)))) = (∑ i < m, ∑ j < m, ((delta / 2) * complex.norm_sq (c i) + (delta / 2) * complex.norm_sq (c j) + ((D - delta) * complex.norm_sq (c i)) * (if j = i then 1 else 0)))
      apply sum_below.congr; intro i hi
      apply sum_below.congr; intro j hj
      by_cases e : j = i
      · rw [e]
        have hif : ∀ (a b : ℝ), (if i = i then a else b) = a := by intro a b; simp
        rw [hif (D * complex.norm_sq (c i)) ((delta / 2) * (complex.norm_sq (c i) + complex.norm_sq (c i))), hif 1 0]
        ring
      · have es : i ≠ j := by omega
        rw [if_neg es, if_neg e]
        ring
    rw [hrew]
    have hinner : (∑ i < m, ∑ j < m, ((delta / 2) * complex.norm_sq (c i) + (delta / 2) * complex.norm_sq (c j) + ((D - delta) * complex.norm_sq (c i)) * (if j = i then 1 else 0))) = ∑ i < m, ((m : ℝ) * ((delta / 2) * complex.norm_sq (c i)) + (delta / 2) * (∑ j < m, complex.norm_sq (c j)) + (D - delta) * complex.norm_sq (c i))
      apply sum_below.congr; intro i hi
      rw [sum_add.real, sum_add.real, sum_const.real, sum_const_mul.real]
      have hsing := sum_below.single.real (fun _ => (D - delta) * complex.norm_sq (c i)) m i hi
      rw [hsing]
    rw [hinner, sum_add.real, sum_add.real, sum_const.real]
    have hs1 : (∑ i < m, (m : ℝ) * ((delta / 2) * complex.norm_sq (c i))) = ((m : ℝ) * (delta / 2)) * (∑ i < m, complex.norm_sq (c i))
      have hcon : (∑ i < m, (m : ℝ) * ((delta / 2) * complex.norm_sq (c i))) = ∑ i < m, (((m : ℝ) * (delta / 2)) * complex.norm_sq (c i)) := by apply sum_below.congr; intro i hi; ring
      rw [hcon, sum_const_mul.real]
    have hs2 : (∑ i < m, (D - delta) * complex.norm_sq (c i)) = (D - delta) * (∑ i < m, complex.norm_sq (c i)) := by rw [sum_const_mul.real]
    rw [hs1, hs2]
    ring
  linarith

-- ====================================================================================
-- BLOCK 2: Two-Scale Weil Positivity Window (`remark.pdf` item 6)
-- ====================================================================================

-- For a linear functional W positive on non-negative combinations (W(f) + lam * W(g) >= 0
-- for lam >= 0), setting lam = X^eta with W(g) <= C * X^(-1) yields:
--   X * W(f) >= -C * X^eta  (at eta = 1/2 + eps, this is the exact G_lower_bound!).
+ weil.two_scale_threshold (Wf Wg X eta C : ℝ)
    (hX : 1 ≤ X) (hpos : 0 ≤ Wf + rpow X eta * Wg)
    (hWg : Wg ≤ C * rpow X (-1)) :
    -C * rpow X eta ≤ X * Wf
  have hXpos : 0 < X := by linarith
  have hpow_pos : 0 < rpow X eta := rpow.pos X eta
  have hmul : rpow X eta * Wg ≤ rpow X eta * (C * rpow X (-1)) :=
    mul_le_mul_of_nonneg_left.real Wg (C * rpow X (-1)) (rpow X eta) hWg (by linarith)
  have hX_inv : X * rpow X (-1) = 1
    unfold rpow
    have h1 : X = exp (log X) := (exp_log X hXpos).symm
    have h2 : log X + (-1) * log X = 0 := by ring
    calc X * exp ((-1) * log X)
      = exp (log X) * exp ((-1) * log X) := by rw [← h1]
      _ = exp (log X + (-1) * log X) := by rw [← exp_add]
      _ = exp 0 := by rw [h2]
      _ = 1 := exp_zero
  have hstep : 0 ≤ X * Wf + X * (rpow X eta * Wg) := by nlinarith
  have hbound : X * (rpow X eta * Wg) ≤ C * rpow X eta
    have h1 : X * (rpow X eta * Wg) ≤ X * (rpow X eta * (C * rpow X (-1))) :=
      mul_le_mul_of_nonneg_left.real (rpow X eta * Wg) (rpow X eta * (C * rpow X (-1))) X hmul (by linarith)
    have h2 : X * (rpow X eta * (C * rpow X (-1))) = (C * rpow X eta) * (X * rpow X (-1)) := by ring
    rw [h2, hX_inv] at h1
    linarith
  linarith

-- ====================================================================================
-- BLOCK 3: Integrality Gap (Divisibility vs. Height) & Legendre p-adic Valuation
--          (`remark.pdf` items 2, 9, 10, 15)
-- ====================================================================================

-- Integer divisibility lower bound: if a != 0 and (D : ℤ) | a (with D > 0), then D <= |a|.
+ integrality.abs_ge_of_dvd (a : ℤ) (D : ℕ) (ha : a ≠ 0) (hD : 0 < D) (hdvd : (D : ℤ) ∣ a) :
    (D : ℝ) ≤ |(a : ℝ)|
  unfold dvd at hdvd
  have hdiv := div_add_mod.int a (D : ℤ)
  rw [hdvd] at hdiv
  set q := a / (D : ℤ) with hq
  have ha_eq : a = (D : ℤ) * q := by linarith
  have hq_ne0 : q ≠ 0
    intro hq0
    apply ha
    rw [ha_eq, hq0]
    ring
  have hq_abs : (1 : ℝ) ≤ |(q : ℝ)|
    by_cases hpos : (0 : ℤ) < q
    · have hq1 : (1 : ℤ) ≤ q := by omega
      have hpos_r : (0 : ℝ) ≤ ((q - 1 : ℤ) : ℝ) := int_cast_nonneg.real (q - 1) (by omega)
      have hq_eq : (q : ℝ) = ((q - 1 : ℤ) : ℝ) + 1
        have he : q = (q - 1) + 1 := by ring
        have hcast : (q : ℝ) = (((q - 1) + 1 : ℤ) : ℝ) := by rw [← he]
        rw [hcast]
        simp
      rw [abs_of_nonneg.real (q : ℝ) (by linarith)]
      linarith
    · have hqm1 : q ≤ (-1 : ℤ) := by omega
      have hneg_r : (0 : ℝ) ≤ ((-1 - q : ℤ) : ℝ) := int_cast_nonneg.real (-1 - q) (by omega)
      have hq_eq : ((-1 - q : ℤ) : ℝ) = -1 - (q : ℝ)
        have he : (-1 - q) + q = (-1 : ℤ) := by ring
        have hcast : (((-1 - q) + q : ℤ) : ℝ) = ((-1 : ℤ) : ℝ) := by rw [he]
        simp at hcast
        linarith
      rw [abs_of_neg.real (q : ℝ) (by linarith)]
      linarith
  have hDr : (0 : ℝ) ≤ (D : ℝ) := cast_nonneg.real D
  have ha_r : (a : ℝ) = (D : ℝ) * (q : ℝ)
    have h1 : ((D : ℤ) * q : ℤ) = a := ha_eq.symm
    rw [← h1]
    simp
  rw [ha_r, abs_mul.real, abs_of_nonneg.real (D : ℝ) hDr]
  nlinarith

-- Vanishing criterion: if D | a and |a| < D, then a = 0!
+ integrality.vanish_of_dvd_lt (a : ℤ) (D : ℕ) (hD : 0 < D) (hdvd : (D : ℤ) ∣ a)
    (hlt : |(a : ℝ)| < (D : ℝ)) : a = 0
  by_contra hne
  have hge := integrality.abs_ge_of_dvd a D hne hD hdvd
  linarith

-- Helper: (p^v : ℝ) = exp(v * log p) for p >= 1.
+ pow_eq_exp_mul_log (p v : ℕ) (hp : 1 ≤ p) :
    ((p ^ v : ℕ) : ℝ) = exp ((v : ℝ) * log (p : ℝ))
  have hp_pos : (0 : ℝ) < (p : ℝ)
    have h1 : p = (p - 1) + 1 := by omega
    rw [h1]; simp; linarith [cast_nonneg.real (p - 1)]
  induction v with k ih
  · simp [pow_zero.nat, exp_zero]
  · rw [succ_eq_add_one.nat, pow_succ.nat]
    simp
    rw [ih]
    have hstep : ((k : ℝ) + 1) * log (p : ℝ) = (k : ℝ) * log (p : ℝ) + log (p : ℝ) := by ring
    rw [hstep, exp_add, exp_log (p : ℝ) hp_pos]

-- THEOREM 3A (Arithmetic Divisibility-vs-Height Obstruction, `remark.pdf` items 9, 10, 14, 15):
-- If a nonzero integer a satisfies p^v | a (p >= 2) and |a| <= exp(H), then v * log p <= H!
-- Contrapositively: whenever proven p-adic divisibility beats the Bost height budget
-- (H < v * log p), the integer a MUST VANISH!
+ integrality.divisibility_vs_height (a : ℤ) (p v : ℕ) (H : ℝ)
    (hp : 2 ≤ p) (hdvd : ((p ^ v : ℕ) : ℤ) ∣ a)
    (hheight : |(a : ℝ)| ≤ exp H)
    (hbeat : H < (v : ℝ) * log (p : ℝ)) :
    a = 0
  have hpow_pos : 0 < p ^ v := pow_pos.nat p v (by omega)
  have hlt : |(a : ℝ)| < ((p ^ v : ℕ) : ℝ)
    rw [pow_eq_exp_mul_log p v (by omega)]
    have hexp := (exp_lt_exp H ((v : ℝ) * log (p : ℝ))).mpr hbeat
    linarith
  exact integrality.vanish_of_dvd_lt a (p ^ v) hpow_pos hdvd hlt

-- ---- Legendre's Full Factorial p-adic Valuation Theorem (`remark.pdf` item 2) ------

-- Truncated Legendre sum: v_p^(L)(n!) = sum_{k=1}^L floor(n / p^k).
-> legendre.sum (p : ℕ) : ℕ → ℕ → ℕ
  | 0 => fun _ => 0
  | L + 1 => fun n => n / (p ^ (L + 1)) + legendre.sum p L n

-- Helper: (n + 1) / d = n / d + 1 if d | (n + 1), else n / d.
+ succ_div_eq (n d : ℕ) (hd : 0 < d) :
    (n + 1) / d = if d ∣ (n + 1) then n / d + 1 else n / d
  by_cases hdiv : d ∣ (n + 1)
  · simp [hdiv]
    unfold dvd at hdiv
    have h1 := div_add_mod.nat (n + 1) d
    rw [hdiv] at h1
    set q := (n + 1) / d with hq
    have hq_pos : 0 < q
      by_contra hq0
      have hz : q = 0 := by omega
      rw [hz] at h1
      omega
    have hn_eq : n = d * (q - 1) + (d - 1)
      have hmul : d * q = d * (q - 1) + d
        have hqq : q = (q - 1) + 1 := by omega
        calc d * q = d * ((q - 1) + 1) := by rw [← hqq]
          _ = d * (q - 1) + d := by ring
      omega
    have hu := div_mod_unique.nat n d (q - 1) (d - 1) hn_eq (by omega)
    omega
  · simp [hdiv]
    unfold dvd at hdiv
    have h1 := div_add_mod.nat n d
    have hm := mod_lt.nat n d hd
    by_cases htop : n % d + 1 = d
    · exfalso
      apply hdiv
      have heq : n + 1 = 0 + d * (n / d + 1)
        calc n + 1 = d * (n / d) + n % d + 1 := by linarith
          _ = d * (n / d) + d := by linarith
          _ = 0 + d * (n / d + 1) := by ring
      rw [heq, add_mul_mod.nat]
      exact (div_mod_of_lt.nat 0 d hd).2
    · have hlt : n % d + 1 < d := by omega
      have hu := div_mod_unique.nat (n + 1) d (n / d) (n % d + 1) (by linarith) hlt
      exact hu.1.symm

-- Helper: if p^L | m and p^(L+1) | m doesn't hold, wait: if d | a and b | c then (d*b) | (a*c).
+ dvd_mul_dvd.nat (a b c d : ℕ) (ha : 0 < a) (hb : 0 < b) (h1 : a ∣ c) (h2 : b ∣ d) :
    (a * b) ∣ (c * d)
  unfold dvd at h1 h2 ⊢
  have hc := div_add_mod.nat c a
  rw [h1] at hc
  have hd := div_add_mod.nat d b
  rw [h2] at hd
  set q1 := c / a with hq1
  set q2 := d / b with hq2
  have hprod : c * d = 0 + (a * b) * (q1 * q2)
    have hce : c = a * q1 := by linarith
    have hde : d = b * q2 := by linarith
    rw [hce, hde]
    ring
  rw [hprod, add_mul_mod.nat]
  exact (div_mod_of_lt.nat 0 (a * b) (mul_pos.nat a b ha hb)).2

-- Helper: step increment of legendre.sum from n to n + 1 divides (n + 1) and is <= L!
+ legendre.step_dvd (p L m : ℕ) (hp : 2 ≤ p) (hm : 0 < m) :
    p ^ (legendre.sum p L m - legendre.sum p L (m - 1)) ∣ m ∧
    legendre.sum p L (m - 1) ≤ legendre.sum p L m ∧
    legendre.sum p L m - legendre.sum p L (m - 1) ≤ L
  have hm1 : m = (m - 1) + 1 := by omega
  induction L with k ih
  · simp [legendre.sum, pow_zero.nat]
    unfold dvd
    omega
  · rw [succ_eq_add_one.nat]
    simp [legendre.sum]
    have hpk_pos : 0 < p ^ (k + 1) := pow_pos.nat p (k + 1) (by omega)
    have hdiv_step := succ_div_eq (m - 1) (p ^ (k + 1)) hpk_pos
    rw [← hm1] at hdiv_step
    by_cases hd : (p ^ (k + 1)) ∣ m
    · simp [hd] at hdiv_step
      set c := legendre.sum p k m - legendre.sum p k (m - 1) + 1 with hc
      have hcle : c ≤ k + 1 := by omega
      have hdiff_eq : m / p ^ (k + 1) + legendre.sum p k m - ((m - 1) / p ^ (k + 1) + legendre.sum p k (m - 1)) = c := by rw [hdiv_step]; omega
      rw [hdiff_eq]
      constructor
      · have hsplit_pow : p ^ c * p ^ (k + 1 - c) = p ^ (k + 1)
          rw [← pow_add.nat]
          have hgap : c + (k + 1 - c) = k + 1 := by omega
          rw [hgap]
        unfold dvd at hd ⊢
        have hdivm := div_add_mod.nat m (p ^ (k + 1))
        rw [hd] at hdivm
        set qm := m / p ^ (k + 1) with hqm
        have hm_eq : m = 0 + p ^ c * (p ^ (k + 1 - c) * qm)
          calc m = p ^ (k + 1) * qm := by linarith
            _ = (p ^ c * p ^ (k + 1 - c)) * qm := by rw [← hsplit_pow]
            _ = 0 + p ^ c * (p ^ (k + 1 - c) * qm) := by ring
        rw [hm_eq, add_mul_mod.nat]
        have hpc_pos : 0 < p ^ c := pow_pos.nat p c (by omega)
        exact (div_mod_of_lt.nat 0 (p ^ c) hpc_pos).2
      · constructor
        · rw [hdiv_step]; omega
        · exact hcle
    · simp [hd] at hdiv_step
      have hdiff_eq : m / p ^ (k + 1) + legendre.sum p k m - ((m - 1) / p ^ (k + 1) + legendre.sum p k (m - 1)) = legendre.sum p k m - legendre.sum p k (m - 1) := by rw [hdiv_step]; omega
      rw [hdiff_eq]
      exact ⟨ih.1, by rw [hdiv_step]; omega, by omega⟩

-- THEOREM 3B (Legendre's Factorial Divisibility Theorem, AXIOM-FREE!):
-- For EVERY p >= 2, depth L : ℕ, and n : ℕ:
--   p ^ (sum_{k=1}^L floor(n / p^k))  |  n!
+ legendre.pow_dvd_factorial (p L n : ℕ) (hp : 2 ≤ p) :
    (p ^ (legendre.sum p L n)) ∣ fact n
  induction n with m ih
  · have hzero : legendre.sum p L 0 = 0
      induction L with j ihj
      · simp [legendre.sum]
      · rw [succ_eq_add_one.nat]; simp [legendre.sum]
        have hpj_pos : 0 < p ^ (j + 1) := pow_pos.nat p (j + 1) (by omega)
        have h0d : 0 / p ^ (j + 1) = 0 := (div_mod_of_lt.nat 0 (p ^ (j + 1)) hpj_pos).1
        rw [h0d, ihj]
        decide
    rw [hzero, pow_zero.nat, fact_zero]
    unfold dvd
    omega
  · rw [succ_eq_add_one.nat, fact_succ]
    have hstep := legendre.step_dvd p L (m + 1) hp (by omega)
    have hm1 : (m + 1) - 1 = m := by omega
    rw [hm1] at hstep
    have hsum_eq : legendre.sum p L (m + 1) = (legendre.sum p L (m + 1) - legendre.sum p L m) + legendre.sum p L m := by omega
    rw [hsum_eq, pow_add.nat]
    have hpa : 0 < p ^ (legendre.sum p L (m + 1) - legendre.sum p L m) := pow_pos.nat p (legendre.sum p L (m + 1) - legendre.sum p L m) (by omega)
    have hpb : 0 < p ^ (legendre.sum p L m) := pow_pos.nat p (legendre.sum p L m) (by omega)
    exact dvd_mul_dvd.nat (p ^ (legendre.sum p L (m + 1) - legendre.sum p L m)) (p ^ (legendre.sum p L m)) (m + 1) (fact m) hpa hpb hstep.1 ih

-- THEOREM 3C (Legendre Upper Bound): (p - 1) * v_p^(L)(n!) <= n for ALL p >= 2, L, n!
+ legendre.upper_bound (p L n : ℕ) (hp : 2 ≤ p) :
    (p - 1) * legendre.sum p L n ≤ n
  have htel : (p - 1) * legendre.sum p L n + n / p ^ L ≤ n
    induction L with k ih
    · simp [legendre.sum, pow_zero.nat]
      have h1 : n / 1 = n
        have hu := div_mod_unique.nat n 1 n 0 (by ring) (by decide)
        exact hu.1.symm
      rw [h1]; omega
    · rw [succ_eq_add_one.nat]
      simp [legendre.sum]
      have hpk_pos : 0 < p ^ k := pow_pos.nat p k (by omega)
      have hdiv_le : p * (n / p ^ (k + 1)) ≤ n / p ^ k
        have h1 := div_add_mod.nat n (p ^ (k + 1))
        have h2 := div_add_mod.nat n (p ^ k)
        have hm2 := mod_lt.nat n (p ^ k) hpk_pos
        rw [pow_succ.nat] at h1
        have hprod_le : p ^ k * (p * (n / (p ^ k * p))) ≤ n
          have heq : p ^ k * (p * (n / (p ^ k * p))) = p ^ k * p * (n / (p ^ k * p)) := by ring
          linarith
        by_contra hgt
        rw [pow_succ.nat] at hgt
        have hstep1 : n / p ^ k + 1 ≤ p * (n / (p ^ k * p)) := by omega
        have hmul := mul_le_mul_left.nat (p ^ k) (n / p ^ k + 1) (p * (n / (p ^ k * p))) hstep1
        have hdist : p ^ k * (n / p ^ k + 1) = p ^ k * (n / p ^ k) + p ^ k := by ring
        omega
      have hstep_alg : (p - 1) * (n / p ^ (k + 1) + legendre.sum p k n) + n / p ^ (k + 1) = (p - 1) * legendre.sum p k n + p * (n / p ^ (k + 1))
        have hp1 : p = (p - 1) + 1 := by omega
        calc (p - 1) * (n / p ^ (k + 1) + legendre.sum p k n) + n / p ^ (k + 1)
          = (p - 1) * legendre.sum p k n + ((p - 1) + 1) * (n / p ^ (k + 1)) := by ring
          _ = (p - 1) * legendre.sum p k n + p * (n / p ^ (k + 1)) := by rw [← hp1]
      omega
  omega
