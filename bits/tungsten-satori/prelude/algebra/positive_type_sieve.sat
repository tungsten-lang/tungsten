-- AXIOM AUDIT: ZERO CUSTOM AXIOMS!
-- ====================================================================================

#axioms pos_type.fixer_energy_identity
#axioms pos_type.pair_char_sum_le
#axioms pos_type.card_mul_sum_singular_le
#axioms pos_type.group_factorization_pigeonhole
#axioms pos_type.energy_add_le
#axioms pos_type.weighted_cauchy_schwarz_sq
#axioms pos_type.schur_test_op_norm
