-- Chevalley's extension theorem inside ℂ: every non-archimedean absolute value on a subfield
-- `K ⊆ ℂ` is dominated by a valuation ring `B` of ℂ, i.e. `B ∩ K = {v ≤ 1}` and for every
-- nonzero `x` either `x ∈ B` or `1/x ∈ B`.
--
-- Proved on Satori's HOL kernel (0 custom axioms).

import algebra.valuation_subring

-- ====================================================================================
-- SECTION 1: VALUED SUBFIELDS OF ℂ
-- ====================================================================================

-> csubfield (K : ℂ → Prop) : Prop :=
  csubring K ∧ ∀ a : ℂ, K a → a ≠ complex.zero → K (complex.inv a)

-- A non-archimedean absolute value on the subfield `K` (values off `K` are irrelevant).
-> cnonarch_abs (K : ℂ → Prop) (v : ℂ → ℝ) : Prop :=
  v complex.zero = 0 ∧ v complex.one = 1 ∧ (∀ a : ℂ, K a → a ≠ complex.zero → 0 < v a) ∧
  (∀ a b : ℂ, K a → K b → v (complex.mul a b) = v a * v b) ∧
  (∀ a b : ℂ, K a → K b → v (complex.add a b) ≤ max (v a) (v b))

+ cnonarch_abs.nonneg (K : ℂ → Prop) (v : ℂ → ℝ) (hv : cnonarch_abs K v) (a : ℂ) (ha : K a) : 0 ≤ v a
  by_cases h0 : a = complex.zero
  · rw [h0, hv.1]; linarith
  · have h := hv.2.2.1 a ha h0; linarith

+ cnonarch_abs.ne_zero_of_pos (K : ℂ → Prop) (v : ℂ → ℝ) (hv : cnonarch_abs K v) (a : ℂ)
    (h : 0 < v a) : a ≠ complex.zero
  intro h0; rw [h0, hv.1] at h; linarith

+ cnonarch_abs.inv (K : ℂ → Prop) (v : ℂ → ℝ) (hK : csubfield K) (hv : cnonarch_abs K v) (a : ℂ)
    (ha : K a) (h0 : a ≠ complex.zero) : v (complex.inv a) = 1 / v a
  have hm := hv.2.2.2.1 a (complex.inv a) ha (hK.2 a ha h0)
  rw [complex.mul_inv_cancel a h0, hv.2.1] at hm
  exact eq_one_div_of_mul_eq_one.real (v a) (v (complex.inv a)) hm.symm

+ cnonarch_abs.add_le_one (K : ℂ → Prop) (v : ℂ → ℝ) (hv : cnonarch_abs K v) (a b : ℂ)
    (ha : K a) (hb : K b) (hva : v a ≤ 1) (hvb : v b ≤ 1) : v (complex.add a b) ≤ 1
  have h := hv.2.2.2.2 a b ha hb
  have hmax := max_le.real (v a) (v b) 1 hva hvb
  linarith

+ cnonarch_abs.neg_one (K : ℂ → Prop) (v : ℂ → ℝ) (hK : csubfield K) (hv : cnonarch_abs K v) :
    v (complex.neg complex.one) = 1
  have hk : K (complex.neg complex.one) := hK.1.2.2.2.1 complex.one hK.1.2.1
  have hm := hv.2.2.2.1 (complex.neg complex.one) (complex.neg complex.one) hk hk
  have he : complex.mul (complex.neg complex.one) (complex.neg complex.one) = complex.one := by apply complex.ext <;> simp
  rw [he, hv.2.1] at hm
  have hnn := cnonarch_abs.nonneg K v hv (complex.neg complex.one) hk
  nlinarith

+ cnonarch_abs.neg (K : ℂ → Prop) (v : ℂ → ℝ) (hK : csubfield K) (hv : cnonarch_abs K v) (a : ℂ)
    (ha : K a) : v (complex.neg a) = v a
  have hk : K (complex.neg complex.one) := hK.1.2.2.2.1 complex.one hK.1.2.1
  have he : complex.neg a = complex.mul (complex.neg complex.one) a := by rw [complex.mul_neg_l, complex.one_mul]
  rw [he, hv.2.2.2.1 (complex.neg complex.one) a hk ha, cnonarch_abs.neg_one K v hK hv, one_mul.real]

-- ====================================================================================
-- SECTION 2: DOMINATING SUBRINGS AND THEIR IDEAL `m_K B`
-- ====================================================================================

-- `B` is a subring of ℂ with `B ∩ K = {v ≤ 1}`.
-> cdominates (K : ℂ → Prop) (v : ℂ → ℝ) (B : ℂ → Prop) : Prop :=
  csubring B ∧ (∀ c : ℂ, K c → v c ≤ 1 → B c) ∧ (∀ c : ℂ, K c → B c → v c ≤ 1)

-- The ideal of `B` generated by `{m ∈ K : v m < 1}`; every element is a single product `m b`.
-> cval_ideal (K : ℂ → Prop) (v : ℂ → ℝ) (B : ℂ → Prop) (z : ℂ) : Prop :=
  ∃ (m b : ℂ), K m ∧ v m < 1 ∧ B b ∧ z = complex.mul m b

+ cval_ideal.sub_ring (K : ℂ → Prop) (v : ℂ → ℝ) (B : ℂ → Prop) (hD : cdominates K v B) (z : ℂ)
    (hz : cval_ideal K v B z) : B z
  obtain ⟨m, b, hm, hvm, hb, e⟩ := hz
  rw [e]; exact hD.1.2.2.2.2 m b (hD.2.1 m hm (by linarith)) hb

+ cval_ideal.zero (K : ℂ → Prop) (v : ℂ → ℝ) (B : ℂ → Prop) (hK : csubfield K)
    (hv : cnonarch_abs K v) (hD : cdominates K v B) : cval_ideal K v B complex.zero
  use complex.zero, complex.zero
  exact ⟨hK.1.1, by rw [hv.1]; linarith, hD.1.1, by rw [complex.zero_mul]⟩

+ cval_ideal.scale (K : ℂ → Prop) (v : ℂ → ℝ) (B : ℂ → Prop) (hD : cdominates K v B) (b' z : ℂ)
    (hb' : B b') (hz : cval_ideal K v B z) : cval_ideal K v B (complex.mul b' z)
  obtain ⟨m, b, hm, hvm, hb, e⟩ := hz
  use m, complex.mul b' b
  have he : complex.mul b' (complex.mul m b) = complex.mul m (complex.mul b' b) := by apply complex.ext <;> simp <;> ring
  exact ⟨hm, hvm, hD.1.2.2.2.2 b' b hb' hb, by rw [e, he]⟩

+ cval_ideal.add_aux (K : ℂ → Prop) (v : ℂ → ℝ) (B : ℂ → Prop) (hK : csubfield K)
    (hv : cnonarch_abs K v) (hD : cdominates K v B) (m1 b1 m2 b2 : ℂ)
    (hm1 : K m1) (hm2 : K m2) (hb1 : B b1) (hb2 : B b2)
    (hcmp : v m1 ≤ v m2) (hv2 : v m2 < 1) (h20 : m2 ≠ complex.zero) :
    cval_ideal K v B (complex.add (complex.mul m1 b1) (complex.mul m2 b2))
  have hpos : 0 < v m2 := hv.2.2.1 m2 hm2 h20
  have hqK : K (complex.mul m1 (complex.inv m2)) := hK.1.2.2.2.2 m1 (complex.inv m2) hm1 (hK.2 m2 hm2 h20)
  have hqv : v (complex.mul m1 (complex.inv m2)) ≤ 1
    rw [hv.2.2.2.1 m1 (complex.inv m2) hm1 (hK.2 m2 hm2 h20), cnonarch_abs.inv K v hK hv m2 hm2 h20, ← div_def.real]
    exact (div_le_one.real (v m1) (v m2) hpos).mpr hcmp
  have hqB : B (complex.mul m1 (complex.inv m2)) := hD.2.1 (complex.mul m1 (complex.inv m2)) hqK hqv
  use m2, complex.add (complex.mul (complex.mul m1 (complex.inv m2)) b1) b2
  have hid : complex.mul m2 (complex.add (complex.mul (complex.mul m1 (complex.inv m2)) b1) b2) = complex.add (complex.mul (complex.mul m2 (complex.inv m2)) (complex.mul m1 b1)) (complex.mul m2 b2)
    apply complex.ext <;> simp <;> ring
  have he : complex.add (complex.mul m1 b1) (complex.mul m2 b2) = complex.mul m2 (complex.add (complex.mul (complex.mul m1 (complex.inv m2)) b1) b2)
    rw [hid, complex.mul_inv_cancel m2 h20, complex.one_mul]
  exact ⟨hm2, hv2, hD.1.2.2.1 (complex.mul (complex.mul m1 (complex.inv m2)) b1) b2 (hD.1.2.2.2.2 (complex.mul m1 (complex.inv m2)) b1 hqB hb1) hb2, he⟩

+ cval_ideal.add (K : ℂ → Prop) (v : ℂ → ℝ) (B : ℂ → Prop) (hK : csubfield K)
    (hv : cnonarch_abs K v) (hD : cdominates K v B) (z1 z2 : ℂ)
    (h1 : cval_ideal K v B z1) (h2 : cval_ideal K v B z2) : cval_ideal K v B (complex.add z1 z2)
  obtain ⟨m1, b1, hm1, hv1, hb1, e1⟩ := h1
  obtain ⟨m2, b2, hm2, hv2, hb2, e2⟩ := h2
  rw [e1, e2]
  by_cases hcmp : v m1 ≤ v m2
  · by_cases h20 : m2 = complex.zero
    · have hv20 : v m2 = 0 := by rw [h20, hv.1]
      have h10 : m1 = complex.zero
        by_contra hne
        have hp := hv.2.2.1 m1 hm1 hne; linarith
      rw [h10, h20, complex.zero_mul, complex.zero_mul, complex.add_zero]
      exact cval_ideal.zero K v B hK hv hD
    · exact cval_ideal.add_aux K v B hK hv hD m1 b1 m2 b2 hm1 hm2 hb1 hb2 hcmp hv2 h20
  · have h10 : m1 ≠ complex.zero
      apply cnonarch_abs.ne_zero_of_pos K v hv m1
      have hnn := cnonarch_abs.nonneg K v hv m2 hm2; linarith
    rw [complex.add_comm]
    exact cval_ideal.add_aux K v B hK hv hD m2 b2 m1 b1 hm2 hm1 hb2 hb1 (by linarith) hv1 h10

+ cval_ideal.submodule (K : ℂ → Prop) (v : ℂ → ℝ) (B : ℂ → Prop) (hK : csubfield K)
    (hv : cnonarch_abs K v) (hD : cdominates K v B) : csubmodule B (cval_ideal K v B) :=
  ⟨cval_ideal.zero K v B hK hv hD, cval_ideal.add K v B hK hv hD, cval_ideal.scale K v B hD⟩

+ cval_ideal.one_not_mem (K : ℂ → Prop) (v : ℂ → ℝ) (B : ℂ → Prop) (hK : csubfield K)
    (hv : cnonarch_abs K v) (hD : cdominates K v B) : ¬ cval_ideal K v B complex.one
  intro h
  obtain ⟨m, b, hm, hvm, hb, e⟩ := h
  have hm0 : m ≠ complex.zero
    intro h0; rw [h0, complex.zero_mul] at e; exact complex.one_ne_zero e
  have hbe : b = complex.inv m
    have h1 : complex.mul (complex.inv m) complex.one = complex.mul (complex.inv m) (complex.mul m b) := by rw [← e]
    rw [complex.mul_one, ← complex.mul_assoc, complex.inv_mul_cancel m hm0, complex.one_mul] at h1
    exact h1.symm
  have hbK : K b := by rw [hbe]; exact hK.2 m hm hm0
  have hvb := hD.2.2 b hbK hb
  rw [hbe, cnonarch_abs.inv K v hK hv m hm hm0] at hvb
  have hpos := hv.2.2.1 m hm hm0
  have h1le := (div_le_one.real 1 (v m) hpos).mp hvb
  linarith

+ cval_ideal.of_inv_mul (K : ℂ → Prop) (v : ℂ → ℝ) (B : ℂ → Prop) (hK : csubfield K)
    (hv : cnonarch_abs K v) (c b : ℂ) (hc : K c) (hvc : 1 < v c) (hb : B b) :
    cval_ideal K v B (complex.mul (complex.inv c) b)
  have hc0 : c ≠ complex.zero := cnonarch_abs.ne_zero_of_pos K v hv c (by linarith)
  have hlt := one_div_lt_one_div_of_lt.real 1 (v c) (by linarith) hvc
  have h11 : (1 : ℝ) / 1 = 1 := by norm_num
  rw [h11] at hlt
  use complex.inv c, b
  exact ⟨hK.2 c hc hc0, by rw [cnonarch_abs.inv K v hK hv c hc hc0]; exact hlt, hb, by rfl⟩

-- ====================================================================================
-- SECTION 3: MAXIMAL DOMINATING SUBRINGS ARE LOCAL
-- ====================================================================================

+ csubring.cpow_mem (B : ℂ → Prop) (hB : csubring B) (a : ℂ) (ha : B a) (n : ℕ) : B (cpow_nat a n)
  induction n with r ihr
  · rw [cpow_nat.zero_def]; exact hB.2.1
  · rw [succ_eq_add_one.nat, cpow_nat.succ_def]; exact hB.2.2.2.2 (cpow_nat a r) a ihr ha

+ csubring.csum_mem (B : ℂ → Prop) (hB : csubring B) (n : ℕ) (f : ℕ → ℂ) (hf : ∀ i < n, B (f i)) :
    B (csum n f)
  induction n with hf r ihr hf
  · rw [csum.zero]; exact hB.1
  · rw [succ_eq_add_one.nat] at hf ⊢
    rw [csum.succ]
    exact hB.2.2.1 (csum r f) (f r) (ihr (by intro i hi; exact hf i (by omega))) (hf r (by omega))

+ csubring.sub_mem (B : ℂ → Prop) (hB : csubring B) (a b : ℂ) (ha : B a) (hb : B b) : B (complex.sub a b)
  rw [complex.sub_eq_add_neg]; exact hB.2.2.1 a (complex.neg b) ha (hB.2.2.2.1 b hb)

-- Clearing denominators in `B[1/s]`: some `s^n c` lies in `B`.
+ cadjoin.clear_inv (B : ℂ → Prop) (hB : csubring B) (s : ℂ) (hs : B s) (hs0 : s ≠ complex.zero)
    (c : ℂ) (hc : cadjoin B (complex.inv s) c) : ∃ n : ℕ, B (complex.mul (cpow_nat s n) c)
  obtain ⟨n, hsp⟩ := hc
  obtain ⟨cf, hcf, e⟩ := hsp
  use n
  rw [e]; unfold cpoly_eval
  rw [← csum.scale_left n (cpow_nat s n) (fun i => complex.mul (cf i) (cpow_nat (complex.inv s) i))]
  apply csubring.csum_mem B hB n
  intro i hi
  have hinv := cpow_nat.mul_pow_inv s (complex.inv s) (complex.mul_inv_cancel s hs0) i n (by omega)
  have he : complex.mul (cpow_nat s n) (complex.mul (cf i) (cpow_nat (complex.inv s) i)) = complex.mul (cf i) (complex.mul (cpow_nat s n) (cpow_nat (complex.inv s) i))
    apply complex.ext <;> simp <;> ring
  rw [he, hinv]
  exact hB.2.2.2.2 (cf i) (cpow_nat s (n - i)) (hcf i hi) (csubring.cpow_mem B hB s hs (n - i))

-- `(1 - w)^n = 1 - w'` with `w'` again in the ideal.
+ cval_ideal.one_sub_pow (K : ℂ → Prop) (v : ℂ → ℝ) (B : ℂ → Prop) (hK : csubfield K)
    (hv : cnonarch_abs K v) (hD : cdominates K v B) (w : ℂ) (hw : cval_ideal K v B w) (n : ℕ) :
    ∃ w' : ℂ, cval_ideal K v B w' ∧ cpow_nat (complex.sub complex.one w) n = complex.sub complex.one w'
  induction n with r ihr
  · use complex.zero; constructor
    · exact cval_ideal.zero K v B hK hv hD
    · rw [cpow_nat.zero_def]; apply complex.ext <;> simp
  · obtain ⟨w2, hw2, e2⟩ := ihr
    rw [succ_eq_add_one.nat, cpow_nat.succ_def, e2]
    have hB1 : B (complex.sub complex.one w2) := csubring.sub_mem B hD.1 complex.one w2 hD.1.2.1 (cval_ideal.sub_ring K v B hD w2 hw2)
    use complex.add w2 (complex.mul (complex.sub complex.one w2) w); constructor
    · exact cval_ideal.add K v B hK hv hD w2 (complex.mul (complex.sub complex.one w2) w) hw2 (cval_ideal.scale K v B hD (complex.sub complex.one w2) w hB1 hw)
    · apply complex.ext <;> simp <;> ring

-> cset_le (B1 B2 : ℂ → Prop) : Prop := ∀ z : ℂ, B1 z → B2 z

+ cset_le.apply (B1 B2 : ℂ → Prop) (h : cset_le B1 B2) (z : ℂ) (hz : B1 z) : B2 z
  unfold cset_le at h; exact h z hz

-- In a maximal dominating subring every `1 - w`, `w ∈ m_K B`, is a unit.
+ cdominates.unit_one_sub (K : ℂ → Prop) (v : ℂ → ℝ) (B : ℂ → Prop) (hK : csubfield K)
    (hv : cnonarch_abs K v) (hD : cdominates K v B)
    (hmax : ∀ B' : ℂ → Prop, cdominates K v B' → cset_le B B' → B' = B) :
    cunits_one_sub B (cval_ideal K v B)
  unfold cunits_one_sub
  intro w hw
  have hwB : B w := cval_ideal.sub_ring K v B hD w hw
  have hsB : B (complex.sub complex.one w) := csubring.sub_mem B hD.1 complex.one w hD.1.2.1 hwB
  have hs0 : complex.sub complex.one w ≠ complex.zero
    intro h0
    have hw1 : w = complex.one
      have hre : complex.re (complex.sub complex.one w) = complex.re complex.zero := by rw [h0]
      have him : complex.im (complex.sub complex.one w) = complex.im complex.zero := by rw [h0]
      simp at hre him
      apply complex.ext <;> simp <;> linarith
    rw [hw1] at hw
    exact cval_ideal.one_not_mem K v B hK hv hD hw
  have hD' : cdominates K v (cadjoin B (complex.inv (complex.sub complex.one w)))
    have h2 : ∀ c : ℂ, K c → v c ≤ 1 → cadjoin B (complex.inv (complex.sub complex.one w)) c
      intro c hc hvc; exact cadjoin.of_mem B hD.1 (complex.inv (complex.sub complex.one w)) c (hD.2.1 c hc hvc)
    have h3 : ∀ c : ℂ, K c → cadjoin B (complex.inv (complex.sub complex.one w)) c → v c ≤ 1
      intro c hc hcB
      by_contra hgt
      have hvc : 1 < v c := by linarith
      have hc0 : c ≠ complex.zero := cnonarch_abs.ne_zero_of_pos K v hv c (by linarith)
      obtain ⟨n, hn⟩ := cadjoin.clear_inv B hD.1 (complex.sub complex.one w) hsB hs0 c hcB
      have hI1 := cval_ideal.of_inv_mul K v B hK hv c (complex.mul (cpow_nat (complex.sub complex.one w) n) c) hc hvc hn
      have hid : complex.mul (complex.inv c) (complex.mul (cpow_nat (complex.sub complex.one w) n) c) = complex.mul (complex.mul (complex.inv c) c) (cpow_nat (complex.sub complex.one w) n)
        apply complex.ext <;> simp <;> ring
      rw [hid, complex.inv_mul_cancel c hc0, complex.one_mul] at hI1
      obtain ⟨w2, hw2, epow⟩ := cval_ideal.one_sub_pow K v B hK hv hD w hw n
      rw [epow] at hI1
      have hone := cval_ideal.add K v B hK hv hD (complex.sub complex.one w2) w2 hI1 hw2
      have he1 : complex.add (complex.sub complex.one w2) w2 = complex.one := by apply complex.ext <;> simp <;> ring
      rw [he1] at hone
      exact cval_ideal.one_not_mem K v B hK hv hD hone
    exact ⟨cadjoin.subring B hD.1 (complex.inv (complex.sub complex.one w)), h2, h3⟩
  have hle : cset_le B (cadjoin B (complex.inv (complex.sub complex.one w)))
    unfold cset_le; intro z hz; exact cadjoin.of_mem B hD.1 (complex.inv (complex.sub complex.one w)) z hz
  have heq := hmax (cadjoin B (complex.inv (complex.sub complex.one w))) hD' hle
  have hgen := cadjoin.gen B hD.1 (complex.inv (complex.sub complex.one w))
  rw [heq] at hgen
  exact ⟨complex.inv (complex.sub complex.one w), hgen, complex.inv_mul_cancel (complex.sub complex.one w) hs0⟩

-- ====================================================================================
-- SECTION 4: EXISTENCE OF A MAXIMAL DOMINATING SUBRING (ZORN)
-- ====================================================================================

-> cval_ring (K : ℂ → Prop) (v : ℂ → ℝ) (c : ℂ) : Prop := K c ∧ v c ≤ 1

-> cset_union (C : (ℂ → Prop) → Prop) (z : ℂ) : Prop := ∃ B : ℂ → Prop, C B ∧ B z

+ cval_ring.dominates (K : ℂ → Prop) (v : ℂ → ℝ) (hK : csubfield K) (hv : cnonarch_abs K v) :
    cdominates K v (cval_ring K v)
  have hsub : csubring (cval_ring K v)
    have h0 : cval_ring K v complex.zero := ⟨hK.1.1, by rw [hv.1]; linarith⟩
    have h1 : cval_ring K v complex.one := ⟨hK.1.2.1, by rw [hv.2.1]; linarith⟩
    have hadd : ∀ a b : ℂ, cval_ring K v a → cval_ring K v b → cval_ring K v (complex.add a b)
      intro a b ha hb
      exact ⟨hK.1.2.2.1 a b ha.1 hb.1, cnonarch_abs.add_le_one K v hv a b ha.1 hb.1 ha.2 hb.2⟩
    have hneg : ∀ a : ℂ, cval_ring K v a → cval_ring K v (complex.neg a)
      intro a ha
      exact ⟨hK.1.2.2.2.1 a ha.1, by rw [cnonarch_abs.neg K v hK hv a ha.1]; exact ha.2⟩
    have hmul : ∀ a b : ℂ, cval_ring K v a → cval_ring K v b → cval_ring K v (complex.mul a b)
      intro a b ha hb
      have hna := cnonarch_abs.nonneg K v hv a ha.1
      have hnb := cnonarch_abs.nonneg K v hv b hb.1
      have hle : v (complex.mul a b) ≤ 1
        rw [hv.2.2.2.1 a b ha.1 hb.1]; nlinarith [ha.2, hb.2]
      exact ⟨hK.1.2.2.2.2 a b ha.1 hb.1, hle⟩
    exact ⟨h0, h1, hadd, hneg, hmul⟩
  have h2 : ∀ c : ℂ, K c → v c ≤ 1 → cval_ring K v c := by intro c hc hvc; exact ⟨hc, hvc⟩
  have h3 : ∀ c : ℂ, K c → cval_ring K v c → v c ≤ 1 := by intro c _ hcv; exact hcv.2
  exact ⟨hsub, h2, h3⟩

+ cset_union.dominates (K : ℂ → Prop) (v : ℂ → ℝ) (C : (ℂ → Prop) → Prop)
    (hne : ∃ B0 : ℂ → Prop, C B0) (hC : ∀ B : ℂ → Prop, C B → cdominates K v B)
    (hchain : sernau.bw_is_chain cset_le C) : cdominates K v (cset_union C)
  obtain ⟨B0, hB0⟩ := hne
  have hD0 := hC B0 hB0
  unfold sernau.bw_is_chain at hchain
  have hpair : ∀ a b : ℂ, cset_union C a → cset_union C b → ∃ B : ℂ → Prop, C B ∧ B a ∧ B b
    intro a b ha hb
    obtain ⟨B1, hB1, ha1⟩ := ha
    obtain ⟨B2, hB2, hb2⟩ := hb
    obtain h12 | h21 := hchain B1 B2 hB1 hB2
    · exact ⟨B2, hB2, cset_le.apply B1 B2 h12 a ha1, hb2⟩
    · exact ⟨B1, hB1, ha1, cset_le.apply B2 B1 h21 b hb2⟩
  have hsub : csubring (cset_union C)
    have h0 : cset_union C complex.zero := ⟨B0, hB0, hD0.1.1⟩
    have h1 : cset_union C complex.one := ⟨B0, hB0, hD0.1.2.1⟩
    have hadd : ∀ a b : ℂ, cset_union C a → cset_union C b → cset_union C (complex.add a b)
      intro a b ha hb
      obtain ⟨B, hB, haB, hbB⟩ := hpair a b ha hb
      exact ⟨B, hB, (hC B hB).1.2.2.1 a b haB hbB⟩
    have hneg : ∀ a : ℂ, cset_union C a → cset_union C (complex.neg a)
      intro a ha
      obtain ⟨B, hB, haB⟩ := ha
      exact ⟨B, hB, (hC B hB).1.2.2.2.1 a haB⟩
    have hmul : ∀ a b : ℂ, cset_union C a → cset_union C b → cset_union C (complex.mul a b)
      intro a b ha hb
      obtain ⟨B, hB, haB, hbB⟩ := hpair a b ha hb
      exact ⟨B, hB, (hC B hB).1.2.2.2.2 a b haB hbB⟩
    exact ⟨h0, h1, hadd, hneg, hmul⟩
  have h2 : ∀ c : ℂ, K c → v c ≤ 1 → cset_union C c := by intro c hc hvc; exact ⟨B0, hB0, hD0.2.1 c hc hvc⟩
  have h3 : ∀ c : ℂ, K c → cset_union C c → v c ≤ 1
    intro c hc hcu
    obtain ⟨B, hB, hcB⟩ := hcu
    exact (hC B hB).2.2 c hc hcB
  exact ⟨hsub, h2, h3⟩

+ cset_le.antisymm (B1 B2 : ℂ → Prop) (h12 : cset_le B1 B2) (h21 : cset_le B2 B1) : B1 = B2
  funext z
  constructor
  · intro hz; exact cset_le.apply B1 B2 h12 z hz
  · intro hz; exact cset_le.apply B2 B1 h21 z hz

+ chevalley.exists_maximal_dominating (K : ℂ → Prop) (v : ℂ → ℝ) (hK : csubfield K)
    (hv : cnonarch_abs K v) :
    ∃ B : ℂ → Prop, cdominates K v B ∧ ∀ B' : ℂ → Prop, cdominates K v B' → cset_le B B' → B' = B
  have hbot_le : ∀ B : ℂ → Prop, cdominates K v B → cset_le (cval_ring K v) B
    intro B hD; unfold cset_le; intro z hz; exact hD.2.1 z hz.1 hz.2
  have hrefl : ∀ B : ℂ → Prop, cdominates K v B → cset_le B B
    intro B _; unfold cset_le; intro z hz; exact hz
  have htrans : ∀ B1 B2 B3 : ℂ → Prop, cdominates K v B1 → cdominates K v B2 → cdominates K v B3 → cset_le B1 B2 → cset_le B2 B3 → cset_le B1 B3
    intro B1 B2 B3 _ _ _ h12 h23; unfold cset_le; intro z hz; exact cset_le.apply B2 B3 h23 z (cset_le.apply B1 B2 h12 z hz)
  have hanti : ∀ B1 B2 : ℂ → Prop, cdominates K v B1 → cdominates K v B2 → cset_le B1 B2 → cset_le B2 B1 → B1 = B2
    intro B1 B2 _ _ h12 h21; exact cset_le.antisymm B1 B2 h12 h21
  have hlub : ∀ C : (ℂ → Prop) → Prop, (∃ B0 : ℂ → Prop, C B0) → (∀ B : ℂ → Prop, C B → cdominates K v B) → sernau.bw_is_chain cset_le C → cdominates K v (cset_union C) ∧ (∀ B : ℂ → Prop, C B → cset_le B (cset_union C)) ∧ (∀ B' : ℂ → Prop, cdominates K v B' → (∀ B : ℂ → Prop, C B → cset_le B B') → cset_le (cset_union C) B')
    intro C hne hC hchain
    have hup : ∀ B : ℂ → Prop, C B → cset_le B (cset_union C)
      intro B hB; unfold cset_le; intro z hz; exact ⟨B, hB, hz⟩
    have hleast : ∀ B' : ℂ → Prop, cdominates K v B' → (∀ B : ℂ → Prop, C B → cset_le B B') → cset_le (cset_union C) B'
      intro B' _ hall; unfold cset_le; intro z hz
      obtain ⟨B, hB, hzB⟩ := hz
      exact cset_le.apply B B' (hall B hB) z hzB
    exact ⟨cset_union.dominates K v C hne hC hchain, hup, hleast⟩
  exact zorn.exists_maximal (cdominates K v) cset_le (cval_ring K v) cset_union (cval_ring.dominates K v hK hv) hbot_le hrefl htrans hanti hlub

-- ====================================================================================
-- SECTION 5: CHEVALLEY'S EXTENSION THEOREM
-- ====================================================================================

-- Outside a maximal dominating `B`, the element `t` makes `1` an `m_K B`-combination of powers of `t`.
+ chevalley.span_one_of_not_mem (K : ℂ → Prop) (v : ℂ → ℝ) (B : ℂ → Prop) (hK : csubfield K)
    (hv : cnonarch_abs K v) (hD : cdominates K v B)
    (hmax : ∀ B' : ℂ → Prop, cdominates K v B' → cset_le B B' → B' = B)
    (t : ℂ) (ht : ¬ B t) : ∃ n : ℕ, cspan_pow (cval_ideal K v B) n t complex.one
  by_cases hP3 : ∀ c : ℂ, K c → cadjoin B t c → v c ≤ 1
  · exfalso
    have h2 : ∀ c : ℂ, K c → v c ≤ 1 → cadjoin B t c
      intro c hc hvc; exact cadjoin.of_mem B hD.1 t c (hD.2.1 c hc hvc)
    have hD' : cdominates K v (cadjoin B t) := ⟨cadjoin.subring B hD.1 t, h2, hP3⟩
    have hle : cset_le B (cadjoin B t)
      unfold cset_le; intro z hz; exact cadjoin.of_mem B hD.1 t z hz
    have heq := hmax (cadjoin B t) hD' hle
    have hgen := cadjoin.gen B hD.1 t
    rw [heq] at hgen
    exact ht hgen
  · have hex : ∃ c : ℂ, K c ∧ cadjoin B t c ∧ 1 < v c
      by_contra hne
      apply hP3; intro c hc hcB
      by_contra hgt
      apply hne; exact ⟨c, hc, hcB, by linarith⟩
    obtain ⟨c, hc, hcB, hvc⟩ := hex
    obtain ⟨n, hsp⟩ := hcB
    obtain ⟨cf, hcf, e⟩ := hsp
    have hc0 : c ≠ complex.zero := cnonarch_abs.ne_zero_of_pos K v hv c (by linarith)
    use n
    use (fun i => complex.mul (complex.inv c) (cf i)); constructor
    · intro i hi; exact cval_ideal.of_inv_mul K v B hK hv c (cf i) hc hvc (hcf i hi)
    · unfold cpoly_eval; unfold cpoly_eval at e
      have h1 : csum n (fun i => complex.mul (complex.mul (complex.inv c) (cf i)) (cpow_nat t i)) = complex.mul (complex.inv c) (csum n (fun i => complex.mul (cf i) (cpow_nat t i)))
        rw [← csum.scale_left n (complex.inv c) (fun i => complex.mul (cf i) (cpow_nat t i))]
        apply csum.congr; intro i _; rw [complex.mul_assoc]
      rw [h1, ← e, complex.inv_mul_cancel c hc0]

-- Chevalley: a non-archimedean absolute value `v` on a subfield `K ⊆ ℂ` is dominated by a
-- valuation ring `B` of ℂ: `B ∩ K = {v ≤ 1}`, and `x ∈ B` or `1/x ∈ B` for every `x ≠ 0`.
+ chevalley.exists_valuation_ring (K : ℂ → Prop) (v : ℂ → ℝ) (hK : csubfield K)
    (hv : cnonarch_abs K v) :
    ∃ B : ℂ → Prop, cdominates K v B ∧ ∀ x : ℂ, x ≠ complex.zero → B x ∨ B (complex.inv x)
  obtain ⟨B, hD, hmax⟩ := chevalley.exists_maximal_dominating K v hK hv
  use B; constructor; exact hD
  intro x hx0
  by_contra hno
  have hnx : ¬ B x := by intro h; apply hno; left; exact h
  have hny : ¬ B (complex.inv x) := by intro h; apply hno; right; exact h
  obtain ⟨n, hn⟩ := chevalley.span_one_of_not_mem K v B hK hv hD hmax x hnx
  obtain ⟨m, hm⟩ := chevalley.span_one_of_not_mem K v B hK hv hD hmax (complex.inv x) hny
  have hrefl : n + m = n + m := by rfl
  exact cspan_pow.not_both B (cval_ideal K v B) hD.1 (cval_ideal.submodule K v B hK hv hD) (cval_ideal.sub_ring K v B hD) (cdominates.unit_one_sub K v B hK hv hD hmax) (n + m) n m x (complex.inv x) hrefl (complex.mul_inv_cancel x hx0) hn hm

#axioms cval_ideal.submodule
#axioms cval_ideal.one_not_mem
#axioms cdominates.unit_one_sub
#axioms chevalley.exists_maximal_dominating
#axioms chevalley.exists_valuation_ring
