+ run.ratio_bound.int (next : β → α → β) (cost opt : β → α → ℤ) (phi : β → ℤ) (c : ℤ) (P : β → Prop) (Q : α → Prop)
    (step : ∀ s, P s → ∀ x, Q x → P (next s x) ∧ cost s x + phi (next s x) - phi s ≤ c * opt s x)
    (nonneg : ∀ s, P s → 0 ≤ phi s) (xs : list α) (s : β) (hs : P s) (hx : all Q xs) : run.total next cost xs s ≤ phi s + c * run.total next opt xs s
  have h := run.ratio.int next cost opt phi c P Q step xs s hs hx
  linarith [h.2, nonneg (run.final next xs s) h.1]

+ run.ratio_zero.rat (next : β → α → β) (cost opt : β → α → ℚ) (phi : β → ℚ) (c : ℚ) (P : β → Prop) (Q : α → Prop)
    (step : ∀ s, P s → ∀ x, Q x → P (next s x) ∧ cost s x + phi (next s x) - phi s ≤ c * opt s x)
    (nonneg : ∀ s, P s → 0 ≤ phi s) (xs : list α) (s : β) (hs : P s) (hx : all Q xs) (zero : phi s = 0) : run.total next cost xs s ≤ c * run.total next opt xs s
  have h := run.ratio_bound.rat next cost opt phi c P Q step nonneg xs s hs hx
  rw [zero] at h
  simp at h
  exact h

+ run.ratio_zero.real (next : β → α → β) (cost opt : β → α → ℝ) (phi : β → ℝ) (c : ℝ) (P : β → Prop) (Q : α → Prop)
    (step : ∀ s, P s → ∀ x, Q x → P (next s x) ∧ cost s x + phi (next s x) - phi s ≤ c * opt s x)
    (nonneg : ∀ s, P s → 0 ≤ phi s) (xs : list α) (s : β) (hs : P s) (hx : all Q xs) (zero : phi s = 0) : run.total next cost xs s ≤ c * run.total next opt xs s
  have h := run.ratio_bound.real next cost opt phi c P Q step nonneg xs s hs hx
  rw [zero] at h
  simp at h
  exact h

+ run.ratio_zero.int (next : β → α → β) (cost opt : β → α → ℤ) (phi : β → ℤ) (c : ℤ) (P : β → Prop) (Q : α → Prop)
    (step : ∀ s, P s → ∀ x, Q x → P (next s x) ∧ cost s x + phi (next s x) - phi s ≤ c * opt s x)
    (nonneg : ∀ s, P s → 0 ≤ phi s) (xs : list α) (s : β) (hs : P s) (hx : all Q xs) (zero : phi s = 0) : run.total next cost xs s ≤ c * run.total next opt xs s
  have h := run.ratio_bound.int next cost opt phi c P Q step nonneg xs s hs hx
  rw [zero] at h
  simp at h
  exact h
