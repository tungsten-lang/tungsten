+ run.total_scale.int (next : β → α → β) (cost : β → α → ℤ) (c : ℤ) (xs : list α) : ∀ s, run.total next (fun v x => c * cost v x) xs s = c * run.total next cost xs s
  induction xs with s x xs ih s
