+ run.ratio_bound.real (next : β → α → β) (cost opt : β → α → ℝ) (phi : β → ℝ) (c : ℝ) (P : β → Prop) (Q : α → Prop)
    (step : ∀ s, P s → ∀ x, Q x → P (next s x) ∧ cost s x + phi (next s x) - phi s ≤ c * opt s x)
