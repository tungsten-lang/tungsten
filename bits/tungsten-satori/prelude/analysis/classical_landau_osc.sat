  have hK0_ge2 : 2 ≤ K0 := by rw [hK0_def]; omega
  have hX0_ge1 : (1 : ℝ) ≤ (K0 : ℝ) := (cast_le.real 1 K0).mpr (by omega)
  have hX_le_X0 : X ≤ (K0 : ℝ)
    have hsp := nat_floor.spec X (by linarith)
    have h1 : ((nat_floor X + 1 : ℕ) : ℝ) ≤ (K0 : ℝ) := by rw [hK0_def]; exact (cast_le.real (nat_floor X + 1) (nat_floor X + 2)).mpr (by omega)
    linarith
  have hH_nn : ∀ x : ℝ, (K0 : ℝ) ≤ x → 0 ≤ classical_G chi x + c * rpow x (complex.re rho) := by intro x hx; exact hH_X x (by linarith)
  obtain ⟨sigma0, hsig0_ge, hsig0_le, hD_gt_sig0, hD_at_sig0⟩ := D_chi.exists_rightmost_real_zero chi hval (complex.re rho) (by linarith) hbeta_le1
  have habs := landau_shift.abscissa_eq_sigma0 chi hval c (complex.re rho) sigma0 K0 hK0_ge2 hc (by linarith) hsig0_ge hsig0_le hD_gt_sig0 hH_nn
  have hsig0_eq : sigma0 = complex.re rho := landau_shift.sigma0_eq_beta chi hval c (complex.re rho) sigma0 (K0 : ℝ) hX0_ge1 hc (by linarith) hsig0_ge hD_gt_sig0 hD_at_sig0 habs.1 habs.2
  rw [hsig0_eq] at hD_gt_sig0 habs
  obtain ⟨delta, hdel_pos, hcl1, hcl2, hcl3⟩ := landau_shift.pole_bounds chi hval rho c (K0 : ℝ) hX0_ge1 hc hbeta_half hD_rho hD_gt_sig0 habs.1 habs.2
  exact ⟨F_ana_shift chi c (complex.re rho) (K0 : ℝ), delta, hdel_pos, hcl1, hcl2, hcl3⟩
