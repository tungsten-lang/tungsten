  obtain ⟨m0, d0, M0, hm0_z, hd0, hM0, hdec0⟩ := single_reg.log_deriv_bound dchar.trivial_one dchar.trivial_one_valid z0 hz0
  have hZ_eq_fn : Z_reg = classical_L_reg dchar.trivial_one := by funext s; unfold Z_reg; simp
