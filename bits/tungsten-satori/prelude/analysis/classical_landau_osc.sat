  have hD_rho : D_chi chi rho = complex.zero := D_chi.eq_zero_of_l_fn_zero chi hval rho (by linarith) hnot1 hLz
  use 1 / (2 * complex.abs rho)
  constructor; exact one_div_pos.real (2 * complex.abs rho) (by linarith)
  intro c X hc hX1 hH_X
