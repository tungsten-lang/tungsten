-- Milestone 3.35: Unconditional Proof of Frontier #2 (`classical_landau_osc`, 0 CUSTOM AXIOMS!)
--
-- Retires BOTH `opaque classical_G` and `axiom classical_landau_osc` from `rh_skeleton.sat`
-- (reducing quarantined axioms from 2 -> 1, down from 14 -> 1!) on Satori's untouched HOL kernel:
--   1. Concrete `nat_floor`, `psi_chi_coeff`, `psi_chi_seq`, `classical_psi_chi`, `classical_G`,
--      general piecewise step-function Darboux/complex integrability (`step_mul.has_integral`),
--      and entire power-series analyticity of finite Mellin pieces (`finite_cpow_int.is_canalytic_at`).
--   2. Exact unit-interval Abel summation on Re(s) > 1 connecting the Mellin transform of
--      `classical_G chi` to `(1 / s) * Phi_chi(s) - 1 / (s - 1)` via M3.33
--      `classical_L.log_deriv_eq_vm_dseries_re_gt_one`.
--   3. Exact pole cancellation at s = 1 and denominator-cleared analytic representation
--      `D_chi`, `N_base`, `E_fin`, `F_ana`, `N_tot` analytic on ALL Re(s) > 0 (via M3.34
--      `classical_L_reg.is_canalytic_at_re_pos` + `is_canalytic_at.cderiv_at`).
--   4. Unconditional Pringsheim-Landau real-ray continuation (via M3.34 `reexpand` + `coeff_unique`
--      + `identity_segment` + M3.7 `landau.mellin_reexpansion_bound` + M3.13 `mellin.limit_abs_le_real`)
--      down to `sigma0 = max(beta, real zeros of D_chi in [beta, 1])`.
--   5. Uniform log-derivative pole contradiction (via M3.34 `log_deriv_decomp`) discharging
--      `sigma0 > beta` and handling `sigma0 = beta` for BOTH real (gamma = 0) and off-axis
--      (gamma != 0) zeros, feeding directly into M3.13 `concrete_landau_osc.of_mellin_system`!
--
-- ALL theorems proved unconditionally on Satori's untouched HOL kernel (0 custom axioms).

import integral_endpoints
import analysis.power_series

-- ====================================================================================
-- 1. FLOOR, CONCRETE `classical_G`, STEP-FUNCTION INTEGRABILITY & FINITE MELLIN ENTIRETY
-- ====================================================================================

+ nat_floor.exists (x : ℝ) (hx : 0 ≤ x) :
    ∃ n : ℕ, (n : ℝ) ≤ x ∧ x < ((n + 1 : ℕ) : ℝ)
  obtain ⟨K, hK⟩ := exists_nat_gt.real x
  have hgen : ∀ M : ℕ, x < (M : ℝ) → ∃ n : ℕ, (n : ℝ) ≤ x ∧ x < ((n + 1 : ℕ) : ℝ)
    intro M; induction M with h0 m ihm hm
    · simp at h0; linarith
    · rw [succ_eq_add_one.nat] at hm
      by_cases hlt : x < (m : ℝ)
      · exact ihm hlt
      · exact ⟨m, by linarith, hm⟩
  exact hgen K hK

-> nat_floor (x : ℝ) : ℕ :=
  if 0 ≤ x then choice (fun (n : ℕ) => (n : ℝ) ≤ x ∧ x < ((n + 1 : ℕ) : ℝ)) else 0

+ nat_floor.spec (x : ℝ) (hx : 0 ≤ x) :
    ((nat_floor x : ℕ) : ℝ) ≤ x ∧ x < ((nat_floor x + 1 : ℕ) : ℝ)
  unfold nat_floor
  rw [if_pos hx]
  exact choice.spec (fun (n : ℕ) => (n : ℝ) ≤ x ∧ x < ((n + 1 : ℕ) : ℝ)) (nat_floor.exists x hx)

+ nat_floor.eq_of_bounds (k : ℕ) (x : ℝ) (hlo : (k : ℝ) ≤ x) (hhi : x < ((k + 1 : ℕ) : ℝ)) :
    nat_floor x = k
  have hx : 0 ≤ x := by linarith [cast_nonneg.real k]
  have hsp := nat_floor.spec x hx
  have hlt1 : (nat_floor x : ℝ) < ((k + 1 : ℕ) : ℝ) := by linarith
  have hlt2 : (k : ℝ) < ((nat_floor x + 1 : ℕ) : ℝ) := by linarith
  have hn1 : nat_floor x < k + 1 := (cast_lt.real (nat_floor x) (k + 1)).mp hlt1
  have hn2 : k < nat_floor x + 1 := (cast_lt.real k (nat_floor x + 1)).mp hlt2
  omega

+ nat_floor.of_nat (k : ℕ) : nat_floor (k : ℝ) = k
  apply nat_floor.eq_of_bounds k (k : ℝ) (by linarith)
  exact (cast_lt.real k (k + 1)).mpr (by omega)

+ nat_floor.mono (a b : ℝ) (ha : 0 ≤ a) (hab : a ≤ b) : nat_floor a ≤ nat_floor b
  have hspa := nat_floor.spec a ha
  have hspb := nat_floor.spec b (by linarith)
  have hlt : (nat_floor a : ℝ) < ((nat_floor b + 1 : ℕ) : ℝ) := by linarith
  have hn : nat_floor a < nat_floor b + 1 := (cast_lt.real (nat_floor a) (nat_floor b + 1)).mp hlt
  omega

-- Non-negative arithmetic weight a_chi(n) = Lambda(n) (trivial chi) or Lambda(n) * (1 + Re(chi(n))) (non-trivial):
-> psi_chi_coeff (chi : DChar) (n : ℕ) : ℝ :=
  if dchar.is_trivial chi then von_mangoldt n else von_mangoldt n * (1 + complex.re (chi.val n))

-> psi_chi_seq (chi : DChar) (N : ℕ) : ℝ :=
  ∑ n < N + 1, psi_chi_coeff chi n

-> classical_psi_chi (chi : DChar) (x : ℝ) : ℝ :=
  psi_chi_seq chi (nat_floor x)

-> classical_G (chi : DChar) (x : ℝ) : ℝ :=
  classical_psi_chi chi x - x

+ psi_chi_coeff.zero (chi : DChar) : psi_chi_coeff chi 0 = 0
  unfold psi_chi_coeff
  by_cases ht : dchar.is_trivial chi
  · rw [if_pos ht, von_mangoldt.zero]
  · rw [if_neg ht, von_mangoldt.zero]; ring

+ psi_chi_coeff.nonneg (chi : DChar) (hval : dchar.valid chi) (n : ℕ) :
    0 ≤ psi_chi_coeff chi n
  unfold psi_chi_coeff
  by_cases ht : dchar.is_trivial chi
  · rw [if_pos ht]; exact von_mangoldt.nonneg n
  · rw [if_neg ht]
    have habs := dchar.abs_le_one chi hval n
    have hre := complex.re_abs_le (chi.val n)
    have hge : -1 ≤ complex.re (chi.val n) := by linarith [neg_le_abs.real (complex.re (chi.val n))]
    exact mul_nonneg.real (von_mangoldt n) (1 + complex.re (chi.val n)) (von_mangoldt.nonneg n) (by linarith)

+ psi_chi_coeff.le_two_log (chi : DChar) (hval : dchar.valid chi) (n : ℕ) (hn : 1 ≤ n) :
    psi_chi_coeff chi n ≤ 2 * log (n : ℝ)
  have hlog_nn : 0 ≤ log (n : ℝ) := log_nonneg (n : ℝ) ((cast_le.real 1 n).mpr hn)
  have hvm := von_mangoldt.le_log n hn
  unfold psi_chi_coeff
  by_cases ht : dchar.is_trivial chi
  · rw [if_pos ht]; linarith
  · rw [if_neg ht]
    have habs := dchar.abs_le_one chi hval n
    have hre := complex.re_abs_le (chi.val n)
    have hle1 : 1 + complex.re (chi.val n) ≤ 2 := by linarith [le_abs_self.real (complex.re (chi.val n))]
    have hm := mul_le_mul_of_nonneg_left.real (1 + complex.re (chi.val n)) 2 (von_mangoldt n) hle1 (von_mangoldt.nonneg n)
    linarith

+ psi_chi_coeff.complex_decomp (chi : DChar) (n : ℕ) :
    complex.of_real (psi_chi_coeff chi n) = if dchar.is_trivial chi then complex.smul (von_mangoldt n) (dchar.trivial_one.val n) else complex.add (complex.smul (von_mangoldt n) (dchar.trivial_one.val n)) (complex.smul (1 / 2) (complex.add (complex.smul (von_mangoldt n) (chi.val n)) (complex.smul (von_mangoldt n) ((dchar.inv chi).val n))))
  unfold psi_chi_coeff dchar.trivial_one dchar.inv
  by_cases ht : dchar.is_trivial chi
  · rw [if_pos ht, if_pos ht]; unfold complex.of_real; apply complex.ext <;> simp <;> ring
  · rw [if_neg ht, if_neg ht]; unfold complex.of_real; apply complex.ext <;> simp <;> ring

+ psi_chi_seq.zero (chi : DChar) : psi_chi_seq chi 0 = 0
  unfold psi_chi_seq
  have h01 : (1 : ℕ) = 0 + 1 := by omega
  rw [h01, sum_below_succ 0 (psi_chi_coeff chi), sum_below_zero, psi_chi_coeff.zero]; ring

+ psi_chi_seq.succ (chi : DChar) (N : ℕ) :
    psi_chi_seq chi (N + 1) = psi_chi_seq chi N + psi_chi_coeff chi (N + 1)
  unfold psi_chi_seq
  rw [sum_below_succ (N + 1) (psi_chi_coeff chi)]

+ psi_chi_seq.nonneg (chi : DChar) (hval : dchar.valid chi) (N : ℕ) :
    0 ≤ psi_chi_seq chi N
  induction N with k ihk
  · rw [psi_chi_seq.zero]; linarith
  · rw [succ_eq_add_one.nat, psi_chi_seq.succ]; linarith [psi_chi_coeff.nonneg chi hval (k + 1)]

+ psi_chi_seq.le_bound (chi : DChar) (hval : dchar.valid chi) (N : ℕ) :
    psi_chi_seq chi N ≤ 2 * (N : ℝ) * log ((N + 1 : ℕ) : ℝ)
  induction N with k ihk
  · rw [psi_chi_seq.zero]; simp
  · rw [succ_eq_add_one.nat, psi_chi_seq.succ]
    have hlog_mono : log ((k + 1 : ℕ) : ℝ) ≤ log ((k + 2 : ℕ) : ℝ) := by exact (log_le_log ((k + 1 : ℕ) : ℝ) ((k + 2 : ℕ) : ℝ) ((cast_pos.real (k + 1)).mpr (by omega)) ((cast_pos.real (k + 2)).mpr (by omega))).mpr ((cast_le.real (k + 1) (k + 2)).mpr (by omega))
    have h1 := mul_le_mul_of_nonneg_left.real (log ((k + 1 : ℕ) : ℝ)) (log ((k + 2 : ℕ) : ℝ)) (2 * (k : ℝ)) hlog_mono (by linarith [cast_nonneg.real k])
    have h2 := psi_chi_coeff.le_two_log chi hval (k + 1) (by omega)
    have hk12 : k + 1 + 1 = k + 2 := by omega
    rw [hk12, cast_add.real k 1]; simp; linarith

+ classical_G.upper_bound (chi : DChar) (hval : dchar.valid chi) (x : ℝ) (hx : 1 ≤ x) :
    classical_G chi x ≤ 2 * x * x
  unfold classical_G classical_psi_chi
  have hsp := nat_floor.spec x (by linarith)
  set N := nat_floor x with hN
  have hseq := psi_chi_seq.le_bound chi hval N
  have hN_le : (N : ℝ) ≤ x := hsp.1
  have hlog_le : log ((N + 1 : ℕ) : ℝ) ≤ ((N + 1 : ℕ) : ℝ)
    have h1 := exp_ge_one_add (log ((N + 1 : ℕ) : ℝ))
    rw [exp_log ((N + 1 : ℕ) : ℝ) ((cast_pos.real (N + 1)).mpr (by omega))] at h1
    linarith
  have hlog_le_x : log ((N + 1 : ℕ) : ℝ) ≤ x + 1 := by rw [cast_add.real N 1] at hlog_le; simp at hlog_le; linarith
  have hlog_nn : 0 ≤ log ((N + 1 : ℕ) : ℝ) := log_nonneg ((N + 1 : ℕ) : ℝ) ((cast_le.real 1 (N + 1)).mpr (by omega))
  have hm1 := mul_le_mul_of_nonneg_right.real (N : ℝ) x (log ((N + 1 : ℕ) : ℝ)) hN_le hlog_nn
  -- Tighter: log(u) <= u - 1! Since 1 + (log u) <= exp(log u) = u, log u <= u - 1!
  have hlog_sub : log ((N + 1 : ℕ) : ℝ) ≤ x
    have h1 := exp_ge_one_add (log ((N + 1 : ℕ) : ℝ))
    rw [exp_log ((N + 1 : ℕ) : ℝ) ((cast_pos.real (N + 1)).mpr (by omega))] at h1
    rw [cast_add.real N 1] at h1; simp at h1; linarith
  have hm3 := mul_le_mul_of_nonneg_left.real (log ((N + 1 : ℕ) : ℝ)) x (2 * x) hlog_sub (by linarith)
  linarith

-- Complex interior congruence (4-line wrapper around `darboux.congr_interior`):
+ c_has_integral.congr_interior (f g : ℝ → ℂ) (a b : ℝ) (I : ℂ)
    (hf : c_has_integral f a b I) (hagree : ∀ x, a < x → x < b → f x = g x) :
    c_has_integral g a b I
  unfold c_has_integral at hf ⊢
  constructor
  · exact darboux.congr_interior (fun x => complex.re (f x)) (fun x => complex.re (g x)) a b (complex.re I) hf.1 (by intro x h1 h2; rw [hagree x h1 h2])
  · exact darboux.congr_interior (fun x => complex.im (f x)) (fun x => complex.im (g x)) a b (complex.im I) hf.2 (by intro x h1 h2; rw [hagree x h1 h2])

-- General piecewise step-function Darboux integrability on ANY [a, b] (0 <= a <= b)!
+ step_mul.has_integral (c : ℕ → ℝ) (w : ℝ → ℝ) (a b : ℝ) (ha : 0 ≤ a) (hab : a ≤ b)
    (hw : ∀ t : ℝ, a ≤ t → t ≤ b → continuous_at w t) :
    ∃ I : ℝ, darboux.has_integral (fun x => c (nat_floor x) * w x) a b I
  have hgen : ∀ d : ℕ, ∀ a0 : ℝ, 0 ≤ a0 → a0 ≤ b → nat_floor b - nat_floor a0 = d →
      (∀ t : ℝ, a0 ≤ t → t ≤ b → continuous_at w t) →
      ∃ I : ℝ, darboux.has_integral (fun x => c (nat_floor x) * w x) a0 b I
    intro d; induction d with a0 ha0 ha0b hd0 hwa m ihm a0 ha0 ha0b hdm hwa
    · have hmono := nat_floor.mono a0 b ha0 ha0b
      have hfeq : nat_floor a0 = nat_floor b := by omega
      obtain ⟨Iw, hIw⟩ := darboux.continuous w a0 b ha0b hwa
      have hsc := darboux.scale w a0 b Iw (c (nat_floor a0)) hIw
      use c (nat_floor a0) * Iw
      apply darboux.congr_interior (fun x => c (nat_floor a0) * w x) (fun x => c (nat_floor x) * w x) a0 b (c (nat_floor a0) * Iw) hsc
      intro x hx1 hx2
      have hspa := nat_floor.spec a0 ha0
      have hspb := nat_floor.spec b (by linarith)
      have hfx : nat_floor x = nat_floor a0 := nat_floor.eq_of_bounds (nat_floor a0) x (by linarith) (by rw [hfeq]; linarith)
      rw [hfx]
    · rw [succ_eq_add_one.nat] at hdm
      set k := nat_floor a0 with hk
      set a1 := ((k + 1 : ℕ) : ℝ) with ha1
      have hspa := nat_floor.spec a0 ha0
      have hspb := nat_floor.spec b (by linarith)
      have hlt_kb : k + 1 ≤ nat_floor b := by omega
      have ha1_le_b : a1 ≤ b := by have h1 : ((k + 1 : ℕ) : ℝ) ≤ (nat_floor b : ℝ) := (cast_le.real (k + 1) (nat_floor b)).mpr hlt_kb; rw [ha1]; linarith
      obtain ⟨Iw1, hIw1⟩ := darboux.continuous w a0 a1 (by linarith) (by intro t h1 h2; exact hwa t h1 (by linarith))
      have hsc1 := darboux.scale w a0 a1 Iw1 (c k) hIw1
      have hI1 : darboux.has_integral (fun x => c (nat_floor x) * w x) a0 a1 (c k * Iw1)
        apply darboux.congr_interior (fun x => c k * w x) (fun x => c (nat_floor x) * w x) a0 a1 (c k * Iw1) hsc1
        intro x hx1 hx2
        have hfx : nat_floor x = k := nat_floor.eq_of_bounds k x (by rw [hk]; linarith) (by rw [ha1] at hx2; exact hx2)
        rw [hfx]
      have hfa1 : nat_floor a1 = k + 1 := by rw [ha1]; exact nat_floor.of_nat (k + 1)
      obtain ⟨I2, hI2⟩ := ihm a1 (by linarith) ha1_le_b (by rw [hfa1]; omega) (by intro t h1 h2; exact hwa t (by linarith) h2)
      use c k * Iw1 + I2
      exact darboux.adjacent (fun x => c (nat_floor x) * w x) a0 a1 b (c k * Iw1) I2 hI1 hI2
  exact hgen (nat_floor b - nat_floor a) a ha hab rfl hw

+ classical_G_mul.has_integral (chi : DChar) (w : ℝ → ℝ) (a b : ℝ) (ha : 0 ≤ a) (hab : a ≤ b)
    (hw : ∀ t : ℝ, a ≤ t → t ≤ b → continuous_at w t) :
    ∃ I : ℝ, darboux.has_integral (fun x => classical_G chi x * w x) a b I
  obtain ⟨I1, hI1⟩ := step_mul.has_integral (psi_chi_seq chi) w a b ha hab hw
  have hcw2 : ∀ t : ℝ, a ≤ t → t ≤ b → continuous_at (fun x => (-x) * w x) t := by intro t h1 h2; have hc := hw t h1 h2; continuity [hc]
  obtain ⟨I2, hI2⟩ := darboux.continuous (fun x => (-x) * w x) a b hab hcw2
  have hadd := darboux.add (fun x => psi_chi_seq chi (nat_floor x) * w x) (fun x => (-x) * w x) a b I1 I2 hI1 hI2
  have hfe : (fun x => psi_chi_seq chi (nat_floor x) * w x + (-x) * w x) = (fun x => classical_G chi x * w x) := by funext x; unfold classical_G classical_psi_chi; ring
  rw [hfe] at hadd
  exact ⟨I1 + I2, hadd⟩

+ classical_H_mul.has_integral (chi : DChar) (c beta : ℝ) (w : ℝ → ℝ) (a b : ℝ) (ha : 1 ≤ a) (hab : a ≤ b)
    (hw : ∀ t : ℝ, a ≤ t → t ≤ b → continuous_at w t) :
    ∃ I : ℝ, darboux.has_integral (fun x => (classical_G chi x + c * rpow x beta) * w x) a b I
  obtain ⟨I1, hI1⟩ := classical_G_mul.has_integral chi w a b (by linarith) hab hw
  have hcw2 : ∀ t : ℝ, a ≤ t → t ≤ b → continuous_at (fun x => (c * rpow x beta) * w x) t := by intro t h1 h2; have hc := hw t h1 h2; continuity [hc, ha, h1]
  obtain ⟨I2, hI2⟩ := darboux.continuous (fun x => (c * rpow x beta) * w x) a b hab hcw2
  have hadd := darboux.add (fun x => classical_G chi x * w x) (fun x => (c * rpow x beta) * w x) a b I1 I2 hI1 hI2
  have hfe : (fun x => classical_G chi x * w x + (c * rpow x beta) * w x) = (fun x => (classical_G chi x + c * rpow x beta) * w x) := by ring
  rw [hfe] at hadd
  exact ⟨I1 + I2, hadd⟩

-- Complex integrability of `of_real (H x) * w x` for continuous complex `w`:
+ classical_G_cmul.has_integral (chi : DChar) (w : ℝ → ℂ) (a b : ℝ) (ha : 0 ≤ a) (hab : a ≤ b)
    (hw : ∀ t : ℝ, a ≤ t → t ≤ b → continuous_at (fun x => complex.re (w x)) t ∧ continuous_at (fun x => complex.im (w x)) t) :
    c_has_integral (fun x => complex.mul (complex.of_real (classical_G chi x)) (w x)) a b (cint (fun x => complex.mul (complex.of_real (classical_G chi x)) (w x)) a b)
  obtain ⟨Ir, hIr⟩ := classical_G_mul.has_integral chi (fun x => complex.re (w x)) a b ha hab (by intro t h1 h2; exact (hw t h1 h2).1)
  obtain ⟨Ii, hIi⟩ := classical_G_mul.has_integral chi (fun x => complex.im (w x)) a b ha hab (by intro t h1 h2; exact (hw t h1 h2).2)
  have hI : c_has_integral (fun x => complex.mul (complex.of_real (classical_G chi x)) (w x)) a b (complex.mk Ir Ii)
    unfold c_has_integral
    have hre : (fun x => complex.re (complex.mul (complex.of_real (classical_G chi x)) (w x))) = (fun x => classical_G chi x * complex.re (w x)) := by funext x; unfold complex.of_real; simp; ring
    have him : (fun x => complex.im (complex.mul (complex.of_real (classical_G chi x)) (w x))) = (fun x => classical_G chi x * complex.im (w x)) := by funext x; unfold complex.of_real; simp
    have hmk_r : complex.re (complex.mk Ir Ii) = Ir := by simp
    have hmk_i : complex.im (complex.mk Ir Ii) = Ii := by simp
    rw [hre, him, hmk_r, hmk_i]; exact ⟨hIr, hIi⟩
  rw [cint.eq_of_has_integral (fun x => complex.mul (complex.of_real (classical_G chi x)) (w x)) a b (complex.mk Ir Ii) hI]
  exact hI

+ classical_H_cmul.has_integral (chi : DChar) (c beta : ℝ) (w : ℝ → ℂ) (a b : ℝ) (ha : 1 ≤ a) (hab : a ≤ b)
    (hw : ∀ t : ℝ, a ≤ t → t ≤ b → continuous_at (fun x => complex.re (w x)) t ∧ continuous_at (fun x => complex.im (w x)) t) :
    c_has_integral (fun x => complex.mul (complex.of_real (classical_G chi x + c * rpow x beta)) (w x)) a b (cint (fun x => complex.mul (complex.of_real (classical_G chi x + c * rpow x beta)) (w x)) a b)
  obtain ⟨Ir, hIr⟩ := classical_H_mul.has_integral chi c beta (fun x => complex.re (w x)) a b ha hab (by intro t h1 h2; exact (hw t h1 h2).1)
  obtain ⟨Ii, hIi⟩ := classical_H_mul.has_integral chi c beta (fun x => complex.im (w x)) a b ha hab (by intro t h1 h2; exact (hw t h1 h2).2)
  have hI : c_has_integral (fun x => complex.mul (complex.of_real (classical_G chi x + c * rpow x beta)) (w x)) a b (complex.mk Ir Ii)
    unfold c_has_integral
    have hre : (fun x => complex.re (complex.mul (complex.of_real (classical_G chi x + c * rpow x beta)) (w x))) = (fun x => (classical_G chi x + c * rpow x beta) * complex.re (w x)) := by funext x; unfold complex.of_real; simp; ring
    have him : (fun x => complex.im (complex.mul (complex.of_real (classical_G chi x + c * rpow x beta)) (w x))) = (fun x => (classical_G chi x + c * rpow x beta) * complex.im (w x)) := by funext x; unfold complex.of_real; simp
    have hmk_r : complex.re (complex.mk Ir Ii) = Ir := by simp
    have hmk_i : complex.im (complex.mk Ir Ii) = Ii := by simp
    rw [hre, him, hmk_r, hmk_i]; exact ⟨hIr, hIi⟩
  rw [cint.eq_of_has_integral (fun x => complex.mul (complex.of_real (classical_G chi x + c * rpow x beta)) (w x)) a b (complex.mk Ir Ii) hI]
  exact hI

-- Entire power-series analyticity of finite Mellin integral `int_1^X0 G(chi, x) * x^(-s - 1) dx` on ALL C!
+ finite_G_mellin.is_canalytic_at (chi : DChar) (hval : dchar.valid chi) (X0 : ℝ) (hX0 : 1 ≤ X0) (s0 : ℂ) :
    is_canalytic_at (fun s => cint (fun x => complex.mul (complex.of_real (classical_G chi x)) (cpow_real x (complex.neg (complex.add s complex.one)))) 1 X0) s0
  set F := (fun (s : ℂ) => cint (fun x => complex.mul (complex.of_real (classical_G chi x)) (cpow_real x (complex.neg (complex.add s complex.one)))) 1 X0) with hF
