    have hm2 := mul_le_mul_of_nonneg_right.real (1 / complex.abs z) (2 / complex.abs z0) M0 hinvz_le hM0
    have hm3 := mul_le_mul_of_nonneg_right.real (1 / complex.abs z) (2 / complex.abs z0) (1 / complex.abs z0) hinvz_le (by linarith [one_div_pos.real (complex.abs z0) hz0_pos])
