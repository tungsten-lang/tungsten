-- MASTER THEOREM: `classical_landau_osc : ConcreteLandauOsc classical_L classical_G` (0 CUSTOM AXIOMS!)
+ classical_landau_osc : ConcreteLandauOsc classical_L classical_G
  apply concrete_landau_osc.of_mellin_system classical_L classical_G
  intro chi hval rho hbeta_half hnot1 hLz
  have hbeta_le1 : complex.re rho ≤ 1
    by_contra hgt
    exact classical_L.l_fn_ne_zero_re_gt_one chi hval rho (by linarith) hLz
  have hrho_ne0 : rho ≠ complex.zero
    intro h0; have hr : complex.re rho = complex.re complex.zero := by rw [h0]
