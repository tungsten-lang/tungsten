      set L2v := classical_L_reg (dchar.inv chi) z with hL2v
      set L2p := cderiv_at (classical_L_reg (dchar.inv chi)) z with hL2p
      have hT1 : complex.mul (complex.neg (complex.mul (complex.add Zv Zp) (complex.mul L1v L2v))) (complex.mul (complex.inv z) (complex.mul (complex.inv Zv) (complex.mul (complex.inv L1v) (complex.inv L2v)))) = complex.mul (complex.inv z) (complex.sub (complex.neg (complex.mul Zp (complex.inv Zv))) complex.one)
        rw [cmul.neg_left, cmul.comm (complex.inv z), ← cmul.assoc, cmul.swap4 (complex.add Zv Zp) (complex.mul L1v L2v) (complex.inv Zv) (complex.mul (complex.inv L1v) (complex.inv L2v)), cmul.swap4 L1v L2v (complex.inv L1v) (complex.inv L2v)]
        rw [hc1, hc2, complex.one_mul, complex.mul_one, cmul.add_right, hcZ]
        have hgen1 : ∀ (u w : ℂ), complex.neg (complex.mul (complex.add complex.one u) w) = complex.mul w (complex.sub (complex.neg u) complex.one)
          intro u w; apply complex.ext <;> simp <;> ring
        exact hgen1 (complex.mul Zp (complex.inv Zv)) (complex.inv z)
      have hT2 : ∀ r : ℝ, complex.mul (complex.smul r (complex.mul Zv (complex.add (complex.mul L1p L2v) (complex.mul L1v L2p)))) (complex.mul (complex.inv z) (complex.mul (complex.inv Zv) (complex.mul (complex.inv L1v) (complex.inv L2v)))) = complex.mul (complex.inv z) (complex.smul r (complex.add (complex.mul L1p (complex.inv L1v)) (complex.mul L2p (complex.inv L2v))))
        intro r
        rw [cmul.smul_left, cmul.comm (complex.inv z), ← cmul.assoc, cmul.swap4 Zv (complex.add (complex.mul L1p L2v) (complex.mul L1v L2p)) (complex.inv Zv) (complex.mul (complex.inv L1v) (complex.inv L2v))]
        rw [hcZ, complex.one_mul, cmul.add_right]
        have hB1 : complex.mul (complex.mul L1p L2v) (complex.mul (complex.inv L1v) (complex.inv L2v)) = complex.mul L1p (complex.inv L1v)
          rw [cmul.swap4 L1p L2v (complex.inv L1v) (complex.inv L2v), hc2, complex.mul_one]
        have hB2 : complex.mul (complex.mul L1v L2p) (complex.mul (complex.inv L1v) (complex.inv L2v)) = complex.mul L2p (complex.inv L2v)
          rw [cmul.swap4 L1v L2p (complex.inv L1v) (complex.inv L2v), hc1, complex.one_mul]
        rw [hB1, hB2]
        have hgen2 : ∀ (u w : ℂ), complex.smul r (complex.mul u w) = complex.mul w (complex.smul r u)
          intro u w; apply complex.ext <;> simp <;> ring
        exact hgen2 (complex.add (complex.mul L1p (complex.inv L1v)) (complex.mul L2p (complex.inv L2v))) (complex.inv z)
      rw [hT1, hT2]
      have hgen3 : ∀ (r1 r2 : ℝ), r1 = r2 → ∀ (w a u v : ℂ), complex.sub (complex.mul w a) (complex.mul w (complex.smul r1 (complex.add u v))) = complex.mul w (complex.add a (complex.smul r2 (complex.add (complex.neg u) (complex.neg v))))
        intro r1 r2 hr w a u v; rw [hr]; apply complex.ext <;> simp <;> ring
      exact hgen3 (1/2) (1 / 2) (by decide) (complex.inv z) (complex.sub (complex.neg (complex.mul Zp (complex.inv Zv))) complex.one) (complex.mul L1p (complex.inv L1v)) (complex.mul L2p (complex.inv L2v))
    rw [hq_eq]; exact hdz.2

-- ====================================================================================
-- 4. PRINGSHEIM-LANDAU REAL-RAY ANALYTIC CONTINUATION OF NON-NEGATIVE MELLIN TRANSFORMS
-- ====================================================================================

-- Helper: continuous (log x)^k * rpow x (-s - 1) on x >= 1!
+ log_pow_cpow.continuous_re_im (k : ℕ) (s : ℂ) (t : ℝ) (ht : 1 ≤ t) :
    continuous_at (fun x => complex.re (complex.smul ((-log x) ^ k / ((fact k : ℕ) : ℝ)) (cpow_real x (complex.neg (complex.add s complex.one))))) t ∧
    continuous_at (fun x => complex.im (complex.smul ((-log x) ^ k / ((fact k : ℕ) : ℝ)) (cpow_real x (complex.neg (complex.add s complex.one))))) t
  have hcl : continuous_at (fun x => -log x) t
    have h := continuous_at.mul (fun _ => (-1 : ℝ)) log t (continuous_at.const (-1) t) (continuous_at.log t (by linarith))
    have hf : (fun x => (-1 : ℝ) * log x) = (fun x => -log x) := by funext x; ring
    rw [hf] at h; exact h
  have hcp : ∀ j : ℕ, continuous_at (fun x => (-log x) ^ j) t
    intro j; induction j with m ihm
    · have hf : (fun (x : ℝ) => (-log x) ^ 0) = (fun _ => (1 : ℝ)) := by funext x; rw [pow_zero.real]
      rw [hf]; exact continuous_at.const 1 t
    · rw [succ_eq_add_one.nat]
      have hf : (fun (x : ℝ) => (-log x) ^ (m + 1)) = (fun x => (-log x) ^ m * (-log x)) := by funext x; rw [pow_succ.real]
      rw [hf]; exact continuous_at.mul (fun x => (-log x) ^ m) (fun x => -log x) t ihm hcl
  have hsc : continuous_at (fun x => (-log x) ^ k / ((fact k : ℕ) : ℝ)) t
    have h := continuous_at.mul (fun x => (-log x) ^ k) (fun _ => 1 / ((fact k : ℕ) : ℝ)) t (hcp k) (continuous_at.const (1 / ((fact k : ℕ) : ℝ)) t)
    have hf : (fun x => (-log x) ^ k * (1 / ((fact k : ℕ) : ℝ))) = (fun x => (-log x) ^ k / ((fact k : ℕ) : ℝ)) := by funext x; rw [div_def.real ((-log x) ^ k) ((fact k : ℕ) : ℝ)]
    rw [hf] at h; exact h
  have hcw := cpow_real.continuous_re_im (complex.neg (complex.add s complex.one)) t (by linarith)
  constructor
  · have h := continuous_at.mul (fun x => (-log x) ^ k / ((fact k : ℕ) : ℝ)) (fun x => complex.re (cpow_real x (complex.neg (complex.add s complex.one)))) t hsc hcw.1
    have hf : (fun x => ((-log x) ^ k / ((fact k : ℕ) : ℝ)) * complex.re (cpow_real x (complex.neg (complex.add s complex.one)))) = (fun x => complex.re (complex.smul ((-log x) ^ k / ((fact k : ℕ) : ℝ)) (cpow_real x (complex.neg (complex.add s complex.one))))) := by funext x; simp
    rw [hf] at h; exact h
  · have h := continuous_at.mul (fun x => (-log x) ^ k / ((fact k : ℕ) : ℝ)) (fun x => complex.im (cpow_real x (complex.neg (complex.add s complex.one)))) t hsc hcw.2
    have hf : (fun x => ((-log x) ^ k / ((fact k : ℕ) : ℝ)) * complex.im (cpow_real x (complex.neg (complex.add s complex.one)))) = (fun x => complex.im (complex.smul ((-log x) ^ k / ((fact k : ℕ) : ℝ)) (cpow_real x (complex.neg (complex.add s complex.one))))) := by funext x; simp
    rw [hf] at h; exact h

+ log_pow_rpow.continuous (k : ℕ) (sigma t : ℝ) (ht : 1 ≤ t) :
    continuous_at (fun x => log x ^ k * rpow x (-sigma - 1)) t
  have hcl := continuous_at.log t (by linarith)
  have hcp : ∀ j : ℕ, continuous_at (fun x => log x ^ j) t
    intro j; induction j with m ihm
    · have hf : (fun (x : ℝ) => log x ^ 0) = (fun _ => (1 : ℝ)) := by funext x; rw [pow_zero.real]
      rw [hf]; exact continuous_at.const 1 t
    · rw [succ_eq_add_one.nat]
      have hf : (fun (x : ℝ) => log x ^ (m + 1)) = (fun x => log x ^ m * log x) := by funext x; rw [pow_succ.real]
      rw [hf]; exact continuous_at.mul (fun x => log x ^ m) log t ihm hcl
  have hrp : continuous_at (fun x => rpow x (-sigma - 1)) t
    unfold rpow
    exact continuous_at.exp_comp (fun x => (-sigma - 1) * log x) t (continuous_at.mul (fun _ => -sigma - 1) log t (continuous_at.const (-sigma - 1) t) hcl)
  exact continuous_at.mul (fun x => log x ^ k) (fun x => rpow x (-sigma - 1)) t (hcp k) hrp

-- Helper: improper complex integral convergence from domination by a bounded non-negative Mellin integral!
+ improper_H_cint.of_bound (chi : DChar) (c beta X0 sigma' BM Cf : ℝ) (f : ℝ → ℂ)
    (hX0 : 1 ≤ X0) (hBM : 0 ≤ BM) (hCf : 0 ≤ Cf)
    (hH : ∀ x : ℝ, X0 ≤ x → 0 ≤ classical_G chi x + c * rpow x beta)
    (hH_bd : ∀ B : ℝ, X0 ≤ B → ∃ I : ℝ, darboux.has_integral (fun x => (classical_G chi x + c * rpow x beta) * rpow x (-sigma' - 1)) X0 B I ∧ I ≤ BM)
    (hf_int : ∀ a b : ℝ, X0 ≤ a → a ≤ b → c_has_integral f a b (cint f a b))
    (hf_le : ∀ x : ℝ, X0 ≤ x → complex.abs (f x) ≤ Cf * ((classical_G chi x + c * rpow x beta) * rpow x (-sigma' - 1))) :
    ctends_to (fun (N : ℕ) => cint f X0 (X0 + (N : ℝ))) (clim (fun (N : ℕ) => cint f X0 (X0 + (N : ℝ)))) ∧
    complex.abs (clim (fun (N : ℕ) => cint f X0 (X0 + (N : ℝ)))) ≤ Cf * BM
  set H := (fun (x : ℝ) => classical_G chi x + c * rpow x beta) with hH_fn
  set blk := (fun (n : ℕ) => cint f (X0 + (n : ℝ)) (X0 + ((n + 1 : ℕ) : ℝ))) with hblk
  have hcsum_eq : ∀ N : ℕ, csum N blk = cint f X0 (X0 + (N : ℝ))
    intro N; induction N with m ihm
    · rw [csum.zero]; simp
      have h0 : c_has_integral f X0 X0 complex.zero
        unfold c_has_integral; simp
        exact ⟨darboux.point (fun x => complex.re (f x)) X0, darboux.point (fun x => complex.im (f x)) X0⟩
      exact (cint.eq_of_has_integral f X0 X0 complex.zero h0).symm
    · rw [succ_eq_add_one.nat, csum.succ, ihm, hblk]
      have h1 := hf_int X0 (X0 + (m : ℝ)) (by linarith) (by linarith [cast_nonneg.real m])
      have h2 := hf_int (X0 + (m : ℝ)) (X0 + ((m + 1 : ℕ) : ℝ)) (by linarith [cast_nonneg.real m]) (by rw [cast_add.real m 1]; simp; linarith)
      have hadj := c_has_integral.adjacent f X0 (X0 + (m : ℝ)) (X0 + ((m + 1 : ℕ) : ℝ)) (cint f X0 (X0 + (m : ℝ))) (cint f (X0 + (m : ℝ)) (X0 + ((m + 1 : ℕ) : ℝ))) h1 h2
      exact (cint.eq_of_has_integral f X0 (X0 + ((m + 1 : ℕ) : ℝ)) (complex.add (cint f X0 (X0 + (m : ℝ))) (cint f (X0 + (m : ℝ)) (X0 + ((m + 1 : ℕ) : ℝ)))) hadj).symm
  -- Real integral values I_n = int_X0^(X0 + n) H(x) x^(-sigma'-1) dx:
  have hI_ex : ∀ n : ℕ, ∃ I : ℝ, darboux.has_integral (fun x => H x * rpow x (-sigma' - 1)) X0 (X0 + (n : ℝ)) I ∧ I ≤ BM := by intro n; rw [hH_fn]; exact hH_bd (X0 + (n : ℝ)) (by linarith [cast_nonneg.real n])
  set Iseq := (fun (n : ℕ) => choice (fun (I : ℝ) => darboux.has_integral (fun x => H x * rpow x (-sigma' - 1)) X0 (X0 + (n : ℝ)) I ∧ I ≤ BM)) with hIseq
  have hI_sp : ∀ n : ℕ, darboux.has_integral (fun x => H x * rpow x (-sigma' - 1)) X0 (X0 + (n : ℝ)) (Iseq n) ∧ Iseq n ≤ BM := by intro n; rw [hIseq]; exact choice.spec (fun (I : ℝ) => darboux.has_integral (fun x => H x * rpow x (-sigma' - 1)) X0 (X0 + (n : ℝ)) I ∧ I ≤ BM) (hI_ex n)
  have hI0 : Iseq 0 = 0
    have h1 := (hI_sp 0).1; simp at h1
    exact darboux.unique (fun x => H x * rpow x (-sigma' - 1)) X0 X0 (Iseq 0) 0 h1 (darboux.point (fun x => H x * rpow x (-sigma' - 1)) X0)
  have hblk_bd : ∀ n : ℕ, complex.abs (blk n) ≤ Cf * (Iseq (n + 1) - Iseq n)
    intro n
    have ha : X0 + (n : ℝ) ≤ X0 + ((n + 1 : ℕ) : ℝ) := by rw [cast_add.real n 1]; simp; linarith
    have hIf := hf_int (X0 + (n : ℝ)) (X0 + ((n + 1 : ℕ) : ℝ)) (by linarith [cast_nonneg.real n]) ha
    have hcw : ∀ t : ℝ, X0 + (n : ℝ) ≤ t → t ≤ X0 + ((n + 1 : ℕ) : ℝ) → continuous_at (fun x => rpow x (-sigma' - 1)) t
      intro t h1 _; unfold rpow
      exact continuous_at.exp_comp (fun x => (-sigma' - 1) * log x) t (continuous_at.mul (fun _ => -sigma' - 1) log t (continuous_at.const (-sigma' - 1) t) (continuous_at.log t (by linarith [cast_nonneg.real n])))
    obtain ⟨J, hJ⟩ := classical_H_mul.has_integral chi c beta (fun x => rpow x (-sigma' - 1)) (X0 + (n : ℝ)) (X0 + ((n + 1 : ℕ) : ℝ)) (by linarith [cast_nonneg.real n]) ha hcw
    have hadj := darboux.adjacent (fun x => H x * rpow x (-sigma' - 1)) X0 (X0 + (n : ℝ)) (X0 + ((n + 1 : ℕ) : ℝ)) (Iseq n) J (hI_sp n).1 (by rw [hH_fn]; exact hJ)
    have hJ_eq : Iseq n + J = Iseq (n + 1) := darboux.unique (fun x => H x * rpow x (-sigma' - 1)) X0 (X0 + ((n + 1 : ℕ) : ℝ)) (Iseq n + J) (Iseq (n + 1)) hadj (hI_sp (n + 1)).1
    have hJ_val : J = Iseq (n + 1) - Iseq n := by linarith
    rw [hJ_val] at hJ
    have hsc := darboux.scale (fun x => H x * rpow x (-sigma' - 1)) (X0 + (n : ℝ)) (X0 + ((n + 1 : ℕ) : ℝ)) (Iseq (n + 1) - Iseq n) Cf (by rw [hH_fn]; exact hJ)
    have hblkn : blk n = cint f (X0 + (n : ℝ)) (X0 + ((n + 1 : ℕ) : ℝ)) := by rw [hblk]
    rw [hblkn]
    exact c_has_integral.abs_le_integral f (fun x => Cf * (H x * rpow x (-sigma' - 1))) (X0 + (n : ℝ)) (X0 + ((n + 1 : ℕ) : ℝ)) (Cf * (Iseq (n + 1) - Iseq n)) (cint f (X0 + (n : ℝ)) (X0 + ((n + 1 : ℕ) : ℝ))) ha hIf hsc (by intro x hx1 _; rw [hH_fn]; exact hf_le x (by linarith [cast_nonneg.real n]))
  have hsum_bd : ∀ N : ℕ, (∑ n < N, complex.abs (blk n)) ≤ Cf * BM
    intro N
    have htele : ∀ M : ℕ, (∑ n < M, complex.abs (blk n)) ≤ Cf * Iseq M
      intro M; induction M with m ihm
      · rw [sum_below_zero, hI0]; linarith
      · rw [succ_eq_add_one.nat, sum_below_succ]; linarith [hblk_bd m]
    have hm := mul_le_mul_of_nonneg_left.real (Iseq N) BM Cf (hI_sp N).2 hCf
    linarith [htele N]
  have habs_sum : summable (fun n => complex.abs (blk n))
    unfold summable
    apply monotone_seq.converges_of_upper_bound (partial_sum (fun n => complex.abs (blk n))) (Cf * BM)
    · unfold monotone_seq partial_sum; intro m n hmn
      have hstep : ∀ d : ℕ, (∑ i < m, complex.abs (blk i)) ≤ (∑ i < m + d, complex.abs (blk i))
        intro d; induction d with k ihk
        · have h0 : m + 0 = m := by omega
          rw [h0]; linarith
        · have hs : m + succ k = (m + k) + 1 := by omega
          rw [hs, sum_below_succ]; linarith [complex.abs_nonneg (blk (m + k))]
      have hnm : m + (n - m) = n := by omega
      rw [← hnm]; exact hstep (n - m)
    · unfold partial_sum; exact hsum_bd
  have hcs := csummable.of_abs_summable blk habs_sum
  unfold csummable cconverges at hcs
  obtain ⟨L, hL⟩ := hcs
  have hfe : (fun (N : ℕ) => csum N blk) = (fun (N : ℕ) => cint f X0 (X0 + (N : ℝ))) := by funext N; exact hcsum_eq N
  rw [hfe] at hL
  have hclim : clim (fun (N : ℕ) => cint f X0 (X0 + (N : ℝ))) = L := clim.eq_of_tends_to (fun (N : ℕ) => cint f X0 (X0 + (N : ℝ))) L hL
  rw [hclim]
  constructor; exact hL
  have hfin_abs : ∀ N : ℕ, complex.abs (cint f X0 (X0 + (N : ℝ))) ≤ Cf * BM := by intro N; rw [← hcsum_eq N]; linarith [csum.abs_le_sum N blk, hsum_bd N]
  have habs_l := ctends_to.abs (fun (N : ℕ) => cint f X0 (X0 + (N : ℝ))) L hL
  have hneg_l : tends_to (fun (N : ℕ) => -complex.abs (cint f X0 (X0 + (N : ℝ)))) (-complex.abs L)
    unfold tends_to at habs_l ⊢; intro e he; obtain ⟨N0, hN0⟩ := habs_l e he; use N0; intro N hN
    have hre : -complex.abs (cint f X0 (X0 + (N : ℝ))) - -complex.abs L = -(complex.abs (cint f X0 (X0 + (N : ℝ))) - complex.abs L) := by ring
    rw [hre, abs_neg_eq]; exact hN0 N hN
  have hge := tends_to.ge_of_ge (fun (N : ℕ) => -complex.abs (cint f X0 (X0 + (N : ℝ)))) (-complex.abs L) (-(Cf * BM)) hneg_l (by intro N; linarith [hfin_abs N])
  linarith

-> H_shift (chi : DChar) (c beta x : ℝ) : ℝ :=
  classical_G chi x + c * rpow x beta

-> M_shift (chi : DChar) (c beta X0 : ℝ) (s : ℂ) : ℂ :=
  clim (fun (N : ℕ) => cint (fun x => complex.mul (complex.of_real (H_shift chi c beta x)) (cpow_real x (complex.neg (complex.add s complex.one)))) X0 (X0 + (N : ℝ)))

-> M_shift_coeff (chi : DChar) (c beta X0 : ℝ) (s0 : ℂ) (k : ℕ) : ℂ :=
  clim (fun (N : ℕ) => cint (fun x => complex.mul (complex.of_real (H_shift chi c beta x)) (complex.smul ((-log x) ^ k / ((fact k : ℕ) : ℝ)) (cpow_real x (complex.neg (complex.add s0 complex.one))))) X0 (X0 + (N : ℝ)))

-- CORE MELLIN POWER-SERIES THEOREM (0 AXIOMS!):
-- If H(x) = G(chi, x) + c*x^beta >= 0 on [X0, infty) has bounded Mellin integral <= BM at sigma',
-- then at ANY s0 with Re(s0) > sigma', setting R = Re(s0) - sigma' > 0:
--   1. M(s) converges for ALL s with |s - s0| < R,
--   2. is_cpower_series_at M s0 a R,
--   3. If Im(s0) = 0, then for ALL B >= X0 and ALL k, M_k(B) / k! <= |a k| !
+ mellin_H.power_series_of_bound (chi : DChar) (c beta X0 sigma' BM : ℝ) (s0 : ℂ)
    (hX0 : 1 ≤ X0) (hBM : 0 ≤ BM) (hs0 : sigma' < complex.re s0)
    (hH : ∀ x : ℝ, X0 ≤ x → 0 ≤ classical_G chi x + c * rpow x beta)
    (hH_bd : ∀ B : ℝ, X0 ≤ B → ∃ I : ℝ, darboux.has_integral (fun x => (classical_G chi x + c * rpow x beta) * rpow x (-sigma' - 1)) X0 B I ∧ I ≤ BM) :
    (∀ s : ℂ, complex.abs (complex.sub s s0) < complex.re s0 - sigma' →
      ctends_to (fun (N : ℕ) => cint (fun x => complex.mul (complex.of_real (H_shift chi c beta x)) (cpow_real x (complex.neg (complex.add s complex.one)))) X0 (X0 + (N : ℝ))) (M_shift chi c beta X0 s)) ∧
    is_cpower_series_at (M_shift chi c beta X0) s0 (M_shift_coeff chi c beta X0 s0) (complex.re s0 - sigma') ∧
    (complex.im s0 = 0 → ∀ (B : ℝ) (k : ℕ) (Mk : ℝ), X0 ≤ B →
      darboux.has_integral (fun x => H_shift chi c beta x * log x ^ k * rpow x (-complex.re s0 - 1)) X0 B Mk →
      Mk / ((fact k : ℕ) : ℝ) ≤ complex.abs (M_shift_coeff chi c beta X0 s0 k))
  set H := H_shift chi c beta with hH_fn
  have hH_unfold : H = (fun (x : ℝ) => classical_G chi x + c * rpow x beta) := by funext x; rw [hH_fn]; unfold H_shift; trivial
  set R := complex.re s0 - sigma' with hR
  have hR_pos : 0 < R := by rw [hR]; linarith
  set M := M_shift chi c beta X0 with hM_fn
  set fk := (fun (k : ℕ) (x : ℝ) => complex.mul (complex.of_real (H x)) (complex.smul ((-log x) ^ k / ((fact k : ℕ) : ℝ)) (cpow_real x (complex.neg (complex.add s0 complex.one))))) with hfk
  set a := M_shift_coeff chi c beta X0 s0 with ha_fn
  have hpow_abs : ∀ (y : ℝ) (k : ℕ), |y ^ k| = |y| ^ k
    intro y k; induction k with m ihm
    · rw [pow_zero.real, pow_zero.real, abs_of_pos.real 1 (by decide)]
    · rw [succ_eq_add_one.nat, pow_succ.real, pow_succ.real, abs_mul.real, ihm]
  have hpow_mul : ∀ (x y : ℝ) (k : ℕ), (x * y) ^ k = x ^ k * y ^ k
    intro x y k; induction k with m ihm
    · rw [pow_zero.real, pow_zero.real, pow_zero.real]; ring
    · rw [succ_eq_add_one.nat, pow_succ.real, pow_succ.real, pow_succ.real, ihm]; ring
  have hH_of_abs : ∀ x : ℝ, X0 ≤ x → complex.abs (complex.of_real (H x)) = H x
    intro x hx
    have hsq : complex.abs (complex.of_real (H x)) * complex.abs (complex.of_real (H x)) = H x * H x := by rw [complex.abs_sq]; unfold complex.norm_sq complex.of_real; simp
    exact eq_of_sq_eq_nonneg (complex.abs (complex.of_real (H x))) (H x) (complex.abs_nonneg (complex.of_real (H x))) (by rw [hH_unfold]; exact hH x hx) hsq
  -- Step 1: Convergence of M(s) for all |s - s0| < R!
  have hM_conv : ∀ s : ℂ, complex.abs (complex.sub s s0) < R → ctends_to (fun (N : ℕ) => cint (fun x => complex.mul (complex.of_real (H x)) (cpow_real x (complex.neg (complex.add s complex.one)))) X0 (X0 + (N : ℝ))) (M s)
    intro s hs
    have hs_re : sigma' < complex.re s
      have h1 := complex.re_abs_le (complex.sub s s0); simp at h1
      rw [hR] at hs; linarith [neg_le_abs.real (complex.re s - complex.re s0)]
    have hfs_int : ∀ a0 b0 : ℝ, X0 ≤ a0 → a0 ≤ b0 → c_has_integral (fun x => complex.mul (complex.of_real (H x)) (cpow_real x (complex.neg (complex.add s complex.one)))) a0 b0 (cint (fun x => complex.mul (complex.of_real (H x)) (cpow_real x (complex.neg (complex.add s complex.one)))) a0 b0)
      intro a0 b0 ha0 hab; rw [hH_unfold]
      exact classical_H_cmul.has_integral chi c beta (fun x => cpow_real x (complex.neg (complex.add s complex.one))) a0 b0 (by linarith) hab (by intro t h1 _; exact cpow_real.continuous_re_im (complex.neg (complex.add s complex.one)) t (by linarith))
    have hfs_le : ∀ x : ℝ, X0 ≤ x → complex.abs (complex.mul (complex.of_real (H x)) (cpow_real x (complex.neg (complex.add s complex.one)))) ≤ 1 * ((classical_G chi x + c * rpow x beta) * rpow x (-sigma' - 1))
      intro x hx
      rw [complex.abs_mul, hH_of_abs x hx, cpow_real.abs_neg_add_one x s, hH_unfold]
      have hle_rp : rpow x (-complex.re s - 1) ≤ rpow x (-sigma' - 1) := by unfold rpow; exact (exp_le_exp ((-complex.re s - 1) * log x) ((-sigma' - 1) * log x)).mpr (mul_le_mul_of_nonneg_right.real (-complex.re s - 1) (-sigma' - 1) (log x) (by linarith) (log_nonneg x (by linarith)))
      have hm := mul_le_mul_of_nonneg_left.real (rpow x (-complex.re s - 1)) (rpow x (-sigma' - 1)) (classical_G chi x + c * rpow x beta) hle_rp (hH x hx)
      linarith
    have himp := improper_H_cint.of_bound chi c beta X0 sigma' BM 1 (fun x => complex.mul (complex.of_real (H x)) (cpow_real x (complex.neg (complex.add s complex.one)))) hX0 hBM (by decide) hH hH_bd hfs_int hfs_le
    have hMs : M s = clim (fun (N : ℕ) => cint (fun x => complex.mul (complex.of_real (H x)) (cpow_real x (complex.neg (complex.add s complex.one)))) X0 (X0 + (N : ℝ))) := by rw [hM_fn, hH_fn]; unfold M_shift; trivial
    rw [hMs]; exact himp.1
  -- Step 2: Convergence & majorant |a k| * R^k <= BM for all k!
  have ha_spec : ∀ k : ℕ, ctends_to (fun (N : ℕ) => cint (fk k) X0 (X0 + (N : ℝ))) (a k) ∧ complex.abs (a k) * R ^ k ≤ BM
    intro k
    have hRk_pos := rpow_nat_pos R hR_pos k
    have hfk_int : ∀ a0 b0 : ℝ, X0 ≤ a0 → a0 ≤ b0 → c_has_integral (fk k) a0 b0 (cint (fk k) a0 b0)
      intro a0 b0 ha0 hab; rw [hfk, hH_unfold]
      exact classical_H_cmul.has_integral chi c beta (fun x => complex.smul ((-log x) ^ k / ((fact k : ℕ) : ℝ)) (cpow_real x (complex.neg (complex.add s0 complex.one)))) a0 b0 (by linarith) hab (by intro t h1 _; exact log_pow_cpow.continuous_re_im k s0 t (by linarith))
    have hfk_le : ∀ x : ℝ, X0 ≤ x → complex.abs (fk k x) ≤ (1 / R ^ k) * ((classical_G chi x + c * rpow x beta) * rpow x (-sigma' - 1))
      intro x hx
      have hfkx : fk k x = complex.mul (complex.of_real (H x)) (complex.smul ((-log x) ^ k / ((fact k : ℕ) : ℝ)) (cpow_real x (complex.neg (complex.add s0 complex.one)))) := by rw [hfk]
      rw [hfkx, complex.abs_mul, hH_of_abs x hx, complex.abs_smul, cpow_real.abs_neg_add_one x s0]
      have hlu_nn : 0 ≤ log x := log_nonneg x (by linarith)
      have hRlog_nn : 0 ≤ R * log x := mul_nonneg.real R (log x) (by linarith) hlu_nn
      have hdiv_abs : |(-log x) ^ k / ((fact k : ℕ) : ℝ)| = log x ^ k / ((fact k : ℕ) : ℝ)
        rw [div_def.real ((-log x) ^ k) ((fact k : ℕ) : ℝ), abs_mul.real, hpow_abs (-log x) k, abs_neg_eq, abs_of_nonneg.real (log x) hlu_nn, abs_of_pos.real (1 / ((fact k : ℕ) : ℝ)) (one_div_pos.real ((fact k : ℕ) : ℝ) (fact_cast_pos k)), ← div_def.real (log x ^ k) ((fact k : ℕ) : ℝ)]
      rw [hdiv_abs]
      have hle_exp : (R * log x) ^ k / ((fact k : ℕ) : ℝ) ≤ exp (R * log x)
        have h1 := exp_taylor.le_exp (k + 1) (R * log x) hRlog_nn
        unfold exp_taylor at h1; rw [sum_below_succ] at h1
        have hnn := exp_taylor.nonneg k (R * log x) hRlog_nn
        unfold exp_taylor at hnn; linarith
      rw [hpow_mul R (log x) k] at hle_exp
      have hterm_le : log x ^ k / ((fact k : ℕ) : ℝ) ≤ (1 / R ^ k) * exp (R * log x)
        have h1 := mul_le_mul_of_nonneg_left.real (R ^ k * log x ^ k / ((fact k : ℕ) : ℝ)) (exp (R * log x)) (1 / R ^ k) hle_exp (by linarith [one_div_pos.real (R ^ k) hRk_pos])
        have hc := mul_inv_cancel.real (R ^ k) (by linarith)
        have hre : (1 / R ^ k) * (R ^ k * log x ^ k / ((fact k : ℕ) : ℝ)) = log x ^ k / ((fact k : ℕ) : ℝ)
          rw [div_def.real (R ^ k * log x ^ k) ((fact k : ℕ) : ℝ), div_def.real (log x ^ k) ((fact k : ℕ) : ℝ)]
          linear_combination (log x ^ k * (1 / ((fact k : ℕ) : ℝ))) * hc
        linarith
      have hcomb : exp (R * log x) * rpow x (-complex.re s0 - 1) = rpow x (-sigma' - 1)
        unfold rpow; rw [← exp_add]
        have he : R * log x + (-complex.re s0 - 1) * log x = (-sigma' - 1) * log x := by rw [hR]; ring
        rw [he]
      have hm1 := mul_le_mul_of_nonneg_right.real (log x ^ k / ((fact k : ℕ) : ℝ)) ((1 / R ^ k) * exp (R * log x)) (rpow x (-complex.re s0 - 1)) hterm_le (by linarith [rpow.pos x (-complex.re s0 - 1)])
      have hm2 := mul_le_mul_of_nonneg_left.real (log x ^ k / ((fact k : ℕ) : ℝ) * rpow x (-complex.re s0 - 1)) ((1 / R ^ k) * exp (R * log x) * rpow x (-complex.re s0 - 1)) (H x) hm1 (by rw [hH_unfold]; exact hH x hx)
      have hre2 : H x * ((1 / R ^ k) * exp (R * log x) * rpow x (-complex.re s0 - 1)) = (1 / R ^ k) * (H x * (exp (R * log x) * rpow x (-complex.re s0 - 1))) := by ring
      have hHx : H x = classical_G chi x + c * rpow x beta := by rw [hH_fn]; unfold H_shift; trivial
      rw [hre2, hcomb, hHx] at hm2; rw [hHx]; linarith
    have himp := improper_H_cint.of_bound chi c beta X0 sigma' BM (1 / R ^ k) (fk k) hX0 hBM (by linarith [one_div_pos.real (R ^ k) hRk_pos]) hH hH_bd hfk_int hfk_le
    have hak : a k = clim (fun (N : ℕ) => cint (fk k) X0 (X0 + (N : ℝ))) := by rw [ha_fn, hfk, hH_fn]; unfold M_shift_coeff; trivial
    rw [hak]
    constructor; exact himp.1
    have hm := mul_le_mul_of_nonneg_right.real (complex.abs (clim (fun (N : ℕ) => cint (fk k) X0 (X0 + (N : ℝ))))) ((1 / R ^ k) * BM) (R ^ k) himp.2 (by linarith)
    have hc := mul_inv_cancel.real (R ^ k) (by linarith)
    have hre : (1 / R ^ k) * BM * R ^ k = BM := by linear_combination BM * hc
    linarith
  -- Step 3: Power-series convergence on |s - s0| < R!
  have hps : is_cpower_series_at M s0 a R
    unfold is_cpower_series_at
    constructor; exact hR_pos
    constructor
    · use BM; constructor; exact hBM; intro k; exact (ha_spec k).2
    · intro s hs
      set w := complex.sub s s0 with hw
      set q := complex.abs w / R with hq
      have hq0 : 0 ≤ q := by rw [hq]; exact div_nonneg.real (complex.abs w) R (complex.abs_nonneg w) (by linarith)
      have hq1 : q < 1 := by rw [hq]; exact (div_lt_iff.real (complex.abs w) 1 R hR_pos).mpr (by linarith)
      set fs := (fun (x : ℝ) => complex.mul (complex.of_real (H x)) (cpow_real x (complex.neg (complex.add s complex.one)))) with hfs
      have hpt_rem : ∀ (K : ℕ) (x : ℝ), X0 ≤ x →
          complex.abs (complex.sub (fs x) (csum K (fun k => complex.mul (fk k x) (cpow_nat w k)))) ≤ q ^ K * (H x * rpow x (-sigma' - 1))
        intro K x hx
        set z := complex.smul (-log x) w with hz
        have hcp_eq : cpow_real x (complex.neg (complex.add s complex.one)) = complex.mul (cpow_real x (complex.neg (complex.add s0 complex.one))) (complex.exp z)
          unfold cpow_real; rw [← complex.exp_add, hz, hw]
          have harg : complex.add (complex.smul (log x) (complex.neg (complex.add s0 complex.one))) (complex.smul (-log x) (complex.sub s s0)) = complex.smul (log x) (complex.neg (complex.add s complex.one))
            apply complex.ext <;> simp <;> ring
          rw [harg]
        have hsum_tay : csum K (fun k => complex.mul (fk k x) (cpow_nat w k)) = complex.mul (complex.mul (complex.of_real (H x)) (cpow_real x (complex.neg (complex.add s0 complex.one)))) (cexp_taylor K z)
          unfold cexp_taylor; rw [← csum.scale_left]; apply csum.congr; intro k _
          have hfkx : fk k x = complex.mul (complex.of_real (H x)) (complex.smul ((-log x) ^ k / ((fact k : ℕ) : ℝ)) (cpow_real x (complex.neg (complex.add s0 complex.one)))) := by rw [hfk]
          rw [hfkx, hz, cpow_nat.real_smul (-log x) w k, div_def.real ((-log x) ^ k) ((fact k : ℕ) : ℝ), div_def.real 1 ((fact k : ℕ) : ℝ)]
          apply complex.ext <;> simp <;> ring
        have hfsx0 : fs x = complex.mul (complex.of_real (H x)) (cpow_real x (complex.neg (complex.add s complex.one))) := by rw [hfs]
        have hfsx : fs x = complex.mul (complex.of_real (H x)) (complex.mul (cpow_real x (complex.neg (complex.add s0 complex.one))) (complex.exp z)) := by rw [hfsx0, hcp_eq]
        rw [hsum_tay, hfsx]
        have hfac : complex.sub (complex.mul (complex.of_real (H x)) (complex.mul (cpow_real x (complex.neg (complex.add s0 complex.one))) (complex.exp z))) (complex.mul (complex.mul (complex.of_real (H x)) (cpow_real x (complex.neg (complex.add s0 complex.one)))) (cexp_taylor K z)) = complex.mul (complex.mul (complex.of_real (H x)) (cpow_real x (complex.neg (complex.add s0 complex.one)))) (complex.sub (complex.exp z) (cexp_taylor K z))
          apply complex.ext <;> simp <;> ring
        rw [hfac, complex.abs_mul, complex.abs_mul, hH_of_abs x hx, cpow_real.abs_neg_add_one x s0]
        have hlu_nn : 0 ≤ log x := log_nonneg x (by linarith)
        set y := R * log x with hy
        have hy_nn : 0 ≤ y := by rw [hy]; exact mul_nonneg.real R (log x) (by linarith) hlu_nn
        have habs_z : complex.abs z = q * y
          rw [hz, complex.abs_smul, abs_neg_eq, abs_of_nonneg.real (log x) hlu_nn, hq, hy]
          have hcR := mul_inv_cancel.real R (by linarith)
          rw [div_def.real (complex.abs w) R]
          linear_combination -(log x * complex.abs w) * hcR
        have hrem_z := cexp_taylor.rem_le_pow_exp K z q y hq0 (by linarith) hy_nn habs_z
        have hcomb : rpow x (-complex.re s0 - 1) * exp y = rpow x (-sigma' - 1)
          rw [hy]; unfold rpow; rw [← exp_add]
          have he : (-complex.re s0 - 1) * log x + R * log x = (-sigma' - 1) * log x := by rw [hR]; ring
          rw [he]
        have hwt_nn : 0 ≤ H x * rpow x (-complex.re s0 - 1) := mul_nonneg.real (H x) (rpow x (-complex.re s0 - 1)) (by rw [hH_unfold]; exact hH x hx) (by linarith [rpow.pos x (-complex.re s0 - 1)])
        have hm := mul_le_mul_of_nonneg_left.real (complex.abs (complex.sub (complex.exp z) (cexp_taylor K z))) (q ^ K * exp y) (H x * rpow x (-complex.re s0 - 1)) hrem_z hwt_nn
        have hre : H x * rpow x (-complex.re s0 - 1) * (q ^ K * exp y) = q ^ K * (H x * (rpow x (-complex.re s0 - 1) * exp y)) := by ring
        rw [hre, hcomb] at hm; exact hm
      -- Integrate hpt_rem on [X0, X0 + N] and pass N -> infty!
      have hK_err : ∀ K : ℕ, complex.abs (complex.sub (M s) (csum K (fun k => complex.mul (a k) (cpow_nat w k)))) ≤ BM * q ^ K
        intro K
        have hN_err : ∀ N : ℕ, complex.abs (complex.sub (cint fs X0 (X0 + (N : ℝ))) (csum K (fun k => complex.mul (cint (fk k) X0 (X0 + (N : ℝ))) (cpow_nat w k)))) ≤ BM * q ^ K
          intro N
          set B := X0 + (N : ℝ) with hB
          have hXB : X0 ≤ B := by rw [hB]; linarith [cast_nonneg.real N]
          have hIfs : c_has_integral fs X0 B (cint fs X0 B) := by rw [hfs, hH_unfold]; exact classical_H_cmul.has_integral chi c beta (fun x => cpow_real x (complex.neg (complex.add s complex.one))) X0 B hX0 hXB (by intro t h1 _; exact cpow_real.continuous_re_im (complex.neg (complex.add s complex.one)) t (by linarith))
          have hIsum : ∀ P : ℕ, c_has_integral (fun x => csum P (fun k => complex.mul (fk k x) (cpow_nat w k))) X0 B (csum P (fun k => complex.mul (cint (fk k) X0 B) (cpow_nat w k)))
            intro P; induction P with m ihm
            · have hf0 : (fun (x : ℝ) => csum 0 (fun k => complex.mul (fk k x) (cpow_nat w k))) = (fun _ => complex.zero) := by funext x; rw [csum.zero]
              rw [hf0, csum.zero]; unfold c_has_integral; simp
              have h0 := darboux.const X0 B 0 hXB
              have hz : 0 * (B - X0) = 0 := by ring
              rw [hz] at h0; exact h0
            · rw [succ_eq_add_one.nat, csum.succ]
              have hIm : c_has_integral (fk m) X0 B (cint (fk m) X0 B) := by rw [hfk, hH_unfold]; exact classical_H_cmul.has_integral chi c beta (fun x => complex.smul ((-log x) ^ m / ((fact m : ℕ) : ℝ)) (cpow_real x (complex.neg (complex.add s0 complex.one)))) X0 B hX0 hXB (by intro t h1 _; exact log_pow_cpow.continuous_re_im m s0 t (by linarith))
              have hsc := c_has_integral.scale_complex (fk m) X0 B (cpow_nat w m) (cint (fk m) X0 B) hIm
              have hsc_r : c_has_integral (fun x => complex.mul (fk m x) (cpow_nat w m)) X0 B (complex.mul (cint (fk m) X0 B) (cpow_nat w m))
                have hv : complex.mul (cpow_nat w m) (cint (fk m) X0 B) = complex.mul (cint (fk m) X0 B) (cpow_nat w m)
                  apply complex.ext <;> simp <;> ring
                rw [← hv]; apply c_has_integral.congr (fun x => complex.mul (cpow_nat w m) (fk m x)) (fun x => complex.mul (fk m x) (cpow_nat w m)) X0 B (complex.mul (cpow_nat w m) (cint (fk m) X0 B)) hsc
                intro x _ _; apply complex.ext <;> simp <;> ring
              have hadd := c_has_integral.add (fun x => csum m (fun k => complex.mul (fk k x) (cpow_nat w k))) (fun x => complex.mul (fk m x) (cpow_nat w m)) X0 B (csum m (fun k => complex.mul (cint (fk k) X0 B) (cpow_nat w k))) (complex.mul (cint (fk m) X0 B) (cpow_nat w m)) ihm hsc_r
              apply c_has_integral.congr (fun x => complex.add (csum m (fun k => complex.mul (fk k x) (cpow_nat w k))) (complex.mul (fk m x) (cpow_nat w m))) (fun x => csum (m + 1) (fun k => complex.mul (fk k x) (cpow_nat w k))) X0 B (complex.add (csum m (fun k => complex.mul (cint (fk k) X0 B) (cpow_nat w k))) (complex.mul (cint (fk m) X0 B) (cpow_nat w m))) hadd
              intro x _ _; rw [csum.succ]
          have hIdiff := c_has_integral.sub fs (fun x => csum K (fun k => complex.mul (fk k x) (cpow_nat w k))) X0 B (cint fs X0 B) (csum K (fun k => complex.mul (cint (fk k) X0 B) (cpow_nat w k))) hIfs (hIsum K)
          obtain ⟨IB, hIB, hIB_le⟩ := hH_bd B hXB
          have hmaj := darboux.scale (fun x => H x * rpow x (-sigma' - 1)) X0 B IB (q ^ K) (by rw [hH_unfold]; exact hIB)
          have hbd := c_has_integral.abs_le_integral (fun x => complex.sub (fs x) (csum K (fun k => complex.mul (fk k x) (cpow_nat w k)))) (fun x => q ^ K * (H x * rpow x (-sigma' - 1))) X0 B (q ^ K * IB) (complex.sub (cint fs X0 B) (csum K (fun k => complex.mul (cint (fk k) X0 B) (cpow_nat w k)))) hXB hIdiff hmaj (by intro x hx1 _; exact hpt_rem K x hx1)
          have hm := mul_le_mul_of_nonneg_left.real IB BM (q ^ K) hIB_le (pow_nonneg.real q hq0 K)
          linarith
        have hsum_lim : ∀ P : ℕ, ctends_to (fun (N : ℕ) => csum P (fun k => complex.mul (cint (fk k) X0 (X0 + (N : ℝ))) (cpow_nat w k))) (csum P (fun k => complex.mul (a k) (cpow_nat w k)))
          intro P; induction P with m ihm
          · have hf0 : (fun (N : ℕ) => csum 0 (fun k => complex.mul (cint (fk k) X0 (X0 + (N : ℝ))) (cpow_nat w k))) = (fun _ => complex.zero) := by funext N; rw [csum.zero]
            rw [hf0, csum.zero]; exact ctends_to.const complex.zero
          · rw [succ_eq_add_one.nat]
            have hm_l : ctends_to (fun (N : ℕ) => complex.mul (cint (fk m) X0 (X0 + (N : ℝ))) (cpow_nat w m)) (complex.mul (a m) (cpow_nat w m))
              have h1 := ctends_to.const_mul (cpow_nat w m) (fun (N : ℕ) => cint (fk m) X0 (X0 + (N : ℝ))) (a m) (ha_spec m).1
              have hf : (fun (N : ℕ) => complex.mul (cpow_nat w m) (cint (fk m) X0 (X0 + (N : ℝ)))) = (fun (N : ℕ) => complex.mul (cint (fk m) X0 (X0 + (N : ℝ))) (cpow_nat w m))
                funext N; apply complex.ext <;> simp <;> ring
              have hv : complex.mul (cpow_nat w m) (a m) = complex.mul (a m) (cpow_nat w m)
                apply complex.ext <;> simp <;> ring
              rw [hf, hv] at h1; exact h1
            have hadd := ctends_to.add (fun (N : ℕ) => csum m (fun k => complex.mul (cint (fk k) X0 (X0 + (N : ℝ))) (cpow_nat w k))) (fun (N : ℕ) => complex.mul (cint (fk m) X0 (X0 + (N : ℝ))) (cpow_nat w m)) (csum m (fun k => complex.mul (a k) (cpow_nat w k))) (complex.mul (a m) (cpow_nat w m)) ihm hm_l
            have hf : (fun (N : ℕ) => complex.add (csum m (fun k => complex.mul (cint (fk k) X0 (X0 + (N : ℝ))) (cpow_nat w k))) (complex.mul (cint (fk m) X0 (X0 + (N : ℝ))) (cpow_nat w m))) = (fun (N : ℕ) => csum (m + 1) (fun k => complex.mul (cint (fk k) X0 (X0 + (N : ℝ))) (cpow_nat w k))) := by funext N; rw [csum.succ]
            rw [hf, ← csum.succ m] at hadd; exact hadd
        have hM_l : ctends_to (fun (N : ℕ) => cint fs X0 (X0 + (N : ℝ))) (M s) := by rw [hfs]; exact hM_conv s (by rw [← hw]; exact hs)
        have hdiff_l := ctends_to.sub (fun (N : ℕ) => cint fs X0 (X0 + (N : ℝ))) (fun (N : ℕ) => csum K (fun k => complex.mul (cint (fk k) X0 (X0 + (N : ℝ))) (cpow_nat w k))) (M s) (csum K (fun k => complex.mul (a k) (cpow_nat w k))) hM_l (hsum_lim K)
        have habs_l := ctends_to.abs (fun (N : ℕ) => complex.sub (cint fs X0 (X0 + (N : ℝ))) (csum K (fun k => complex.mul (cint (fk k) X0 (X0 + (N : ℝ))) (cpow_nat w k)))) (complex.sub (M s) (csum K (fun k => complex.mul (a k) (cpow_nat w k)))) hdiff_l
        have hneg_l : tends_to (fun (N : ℕ) => -complex.abs (complex.sub (cint fs X0 (X0 + (N : ℝ))) (csum K (fun k => complex.mul (cint (fk k) X0 (X0 + (N : ℝ))) (cpow_nat w k))))) (-complex.abs (complex.sub (M s) (csum K (fun k => complex.mul (a k) (cpow_nat w k)))))
          unfold tends_to at habs_l ⊢; intro e he; obtain ⟨N0, hN0⟩ := habs_l e he; use N0; intro N hN
          have hre : -complex.abs (complex.sub (cint fs X0 (X0 + (N : ℝ))) (csum K (fun k => complex.mul (cint (fk k) X0 (X0 + (N : ℝ))) (cpow_nat w k)))) - -complex.abs (complex.sub (M s) (csum K (fun k => complex.mul (a k) (cpow_nat w k)))) = -(complex.abs (complex.sub (cint fs X0 (X0 + (N : ℝ))) (csum K (fun k => complex.mul (cint (fk k) X0 (X0 + (N : ℝ))) (cpow_nat w k)))) - complex.abs (complex.sub (M s) (csum K (fun k => complex.mul (a k) (cpow_nat w k))))) := by ring
          rw [hre, abs_neg_eq]; exact hN0 N hN
        have hge := tends_to.ge_of_ge (fun (N : ℕ) => -complex.abs (complex.sub (cint fs X0 (X0 + (N : ℝ))) (csum K (fun k => complex.mul (cint (fk k) X0 (X0 + (N : ℝ))) (cpow_nat w k))))) (-complex.abs (complex.sub (M s) (csum K (fun k => complex.mul (a k) (cpow_nat w k))))) (-(BM * q ^ K)) hneg_l (by intro N; linarith [hN_err N])
        linarith
      have hqlim := geom_pow_tends_to_zero q hq0 hq1
      set B0 := BM + 1 with hB0
      have hB0_pos : 0 < B0 := by rw [hB0]; linarith
      unfold ctends_to; unfold tends_to at hqlim
      intro e he
      obtain ⟨K0, hK0⟩ := hqlim (e / B0) (div_pos.real e B0 he hB0_pos)
      use K0; intro K hK
      rw [complex.abs_sub_comm]
      have h1 := hK0 K hK
      have hsub0 : q ^ K - 0 = q ^ K := by ring
      rw [hsub0, abs_of_nonneg.real (q ^ K) (pow_nonneg.real q hq0 K)] at h1
      have hlt : B0 * q ^ K < e := by linarith [(lt_div_iff.real (q ^ K) e B0 hB0_pos).mp h1]
      have hm := mul_le_mul_of_nonneg_right.real BM B0 (q ^ K) (by rw [hB0]; linarith) (pow_nonneg.real q hq0 K)
      linarith [hK_err K]
  -- Step 4: Moment comparison when Im(s0) = 0!
  have hmom_le : complex.im s0 = 0 → ∀ (B : ℝ) (k : ℕ) (Mk : ℝ), X0 ≤ B →
      darboux.has_integral (fun x => H x * log x ^ k * rpow x (-complex.re s0 - 1)) X0 B Mk →
      Mk / ((fact k : ℕ) : ℝ) ≤ complex.abs (a k)
    intro him0 B k Mk hXB hMk
    set m1 : ℝ := -1 with hm1
    have hfk_real : ∀ x : ℝ, X0 ≤ x → fk k x = complex.of_real ((m1 ^ k / ((fact k : ℕ) : ℝ)) * (H x * log x ^ k * rpow x (-complex.re s0 - 1)))
      intro x hx
      have hfkx : fk k x = complex.mul (complex.of_real (H x)) (complex.smul ((-log x) ^ k / ((fact k : ℕ) : ℝ)) (cpow_real x (complex.neg (complex.add s0 complex.one)))) := by rw [hfk]
      rw [hfkx]
      have hneg_pow : (-log x) ^ k = m1 ^ k * log x ^ k
        have h1 : -log x = m1 * log x := by rw [hm1]; ring
        rw [h1, hpow_mul m1 (log x) k]
      have hcp_real : cpow_real x (complex.neg (complex.add s0 complex.one)) = complex.of_real (rpow x (-complex.re s0 - 1))
        unfold cpow_real rpow complex.of_real
        apply complex.ext
        · simp [him0, cos_zero]
          have h1 : log x * (0 - (complex.re s0 + 1)) = (-complex.re s0 - 1) * log x := by ring
          rw [h1]
        · simp [him0, sin_zero]
      rw [hneg_pow, hcp_real]; unfold complex.of_real
      rw [div_def.real (m1 ^ k * log x ^ k) ((fact k : ℕ) : ℝ), div_def.real (m1 ^ k) ((fact k : ℕ) : ℝ)]
      apply complex.ext <;> simp <;> ring
    have hpow_m1_abs : |m1 ^ k| = 1
      rw [hpow_abs m1 k, hm1, abs_neg_eq, abs_of_pos.real 1 (by decide)]
      have h1p : ∀ m : ℕ, (1 : ℝ) ^ m = 1
        intro m; induction m with j ihj
        · rw [pow_zero.real]
        · rw [succ_eq_add_one.nat, pow_succ.real, ihj]; ring
      exact h1p k
    -- For every N with B <= X0 + N, Mk / k! <= |cint (fk k) X0 (X0 + N)|!
    obtain ⟨N0, hN0⟩ := exists_nat_gt.real (B - X0)
    have hge_N : ∀ N : ℕ, N0 ≤ N → Mk / ((fact k : ℕ) : ℝ) ≤ complex.abs (cint (fk k) X0 (X0 + (N : ℝ)))
      intro N hN
      have hBN : B ≤ X0 + (N : ℝ) := by have h1 : (N0 : ℝ) ≤ (N : ℝ) := (cast_le.real N0 N).mpr hN; linarith
      obtain ⟨J, hJ⟩ := classical_H_mul.has_integral chi c beta (fun x => log x ^ k * rpow x (-complex.re s0 - 1)) B (X0 + (N : ℝ)) (by linarith) hBN (by intro t h1 _; exact log_pow_rpow.continuous k (complex.re s0) t (by linarith))
      have hJ_nn : 0 ≤ J
        have hz := darboux.const B (X0 + (N : ℝ)) 0 hBN
        have h00 : 0 * (X0 + (N : ℝ) - B) = 0 := by ring
        rw [h00] at hz
        apply darboux.mono (fun _ => (0 : ℝ)) (fun x => H x * (log x ^ k * rpow x (-complex.re s0 - 1))) B (X0 + (N : ℝ)) 0 J hz (by rw [hH_unfold]; exact hJ)
        intro x hx1 _
        exact mul_nonneg.real (H x) (log x ^ k * rpow x (-complex.re s0 - 1)) (by rw [hH_unfold]; exact hH x (by linarith)) (mul_nonneg.real (log x ^ k) (rpow x (-complex.re s0 - 1)) (pow_nonneg.real (log x) (log_nonneg x (by linarith)) k) (by linarith [rpow.pos x (-complex.re s0 - 1)]))
      have hJ_re : darboux.has_integral (fun x => H x * log x ^ k * rpow x (-complex.re s0 - 1)) B (X0 + (N : ℝ)) J
        have hfe : (fun x => (classical_G chi x + c * rpow x beta) * (log x ^ k * rpow x (-complex.re s0 - 1))) = (fun x => H x * log x ^ k * rpow x (-complex.re s0 - 1)) := by funext x; rw [hH_unfold]; ring
        rw [hfe] at hJ; exact hJ
      have hMN := darboux.adjacent (fun x => H x * log x ^ k * rpow x (-complex.re s0 - 1)) X0 B (X0 + (N : ℝ)) Mk J hMk hJ_re
      have hMk_nn : 0 ≤ Mk
        have hz := darboux.const X0 B 0 hXB
        have h00 : 0 * (B - X0) = 0 := by ring
        rw [h00] at hz
        apply darboux.mono (fun _ => (0 : ℝ)) (fun x => H x * log x ^ k * rpow x (-complex.re s0 - 1)) X0 B 0 Mk hz hMk
        intro x hx1 _
        exact mul_nonneg.real (H x * log x ^ k) (rpow x (-complex.re s0 - 1)) (mul_nonneg.real (H x) (log x ^ k) (by rw [hH_unfold]; exact hH x hx1) (pow_nonneg.real (log x) (log_nonneg x (by linarith)) k)) (by linarith [rpow.pos x (-complex.re s0 - 1)])
      have hsc := darboux.scale (fun x => H x * log x ^ k * rpow x (-complex.re s0 - 1)) X0 (X0 + (N : ℝ)) (Mk + J) (m1 ^ k / ((fact k : ℕ) : ℝ)) hMN
      have hI_fk : c_has_integral (fk k) X0 (X0 + (N : ℝ)) (complex.of_real ((m1 ^ k / ((fact k : ℕ) : ℝ)) * (Mk + J)))
        apply c_has_integral.congr (fun x => complex.of_real ((m1 ^ k / ((fact k : ℕ) : ℝ)) * (H x * log x ^ k * rpow x (-complex.re s0 - 1)))) (fk k) X0 (X0 + (N : ℝ)) (complex.of_real ((m1 ^ k / ((fact k : ℕ) : ℝ)) * (Mk + J)))
        · unfold c_has_integral complex.of_real; simp
          constructor; exact hsc
          have hz := darboux.const X0 (X0 + (N : ℝ)) 0 (by linarith)
          have h00 : 0 * (X0 + (N : ℝ) - X0) = 0 := by ring
          rw [h00] at hz; exact hz
        · intro x hx1 _; exact (hfk_real x hx1).symm
      rw [cint.eq_of_has_integral (fk k) X0 (X0 + (N : ℝ)) (complex.of_real ((m1 ^ k / ((fact k : ℕ) : ℝ)) * (Mk + J))) hI_fk]
      have hof_abs : complex.abs (complex.of_real ((m1 ^ k / ((fact k : ℕ) : ℝ)) * (Mk + J))) = (Mk + J) / ((fact k : ℕ) : ℝ)
        have h1 : complex.abs (complex.of_real ((m1 ^ k / ((fact k : ℕ) : ℝ)) * (Mk + J))) = |(m1 ^ k / ((fact k : ℕ) : ℝ)) * (Mk + J)|
          have hsq : complex.abs (complex.of_real ((m1 ^ k / ((fact k : ℕ) : ℝ)) * (Mk + J))) * complex.abs (complex.of_real ((m1 ^ k / ((fact k : ℕ) : ℝ)) * (Mk + J))) = |(m1 ^ k / ((fact k : ℕ) : ℝ)) * (Mk + J)| * |(m1 ^ k / ((fact k : ℕ) : ℝ)) * (Mk + J)|
            rw [complex.abs_sq]; unfold complex.norm_sq complex.of_real; simp
            by_cases hsgn : 0 ≤ (m1 ^ k / ((fact k : ℕ) : ℝ)) * (Mk + J)
            · rw [abs_of_nonneg.real ((m1 ^ k / ((fact k : ℕ) : ℝ)) * (Mk + J)) hsgn]
            · rw [abs_of_neg.real ((m1 ^ k / ((fact k : ℕ) : ℝ)) * (Mk + J)) (by linarith)]; ring
          exact eq_of_sq_eq_nonneg (complex.abs (complex.of_real ((m1 ^ k / ((fact k : ℕ) : ℝ)) * (Mk + J)))) (|(m1 ^ k / ((fact k : ℕ) : ℝ)) * (Mk + J)|) (complex.abs_nonneg (complex.of_real ((m1 ^ k / ((fact k : ℕ) : ℝ)) * (Mk + J)))) (abs_nonneg.real ((m1 ^ k / ((fact k : ℕ) : ℝ)) * (Mk + J))) hsq
        rw [h1, abs_mul.real, div_def.real (m1 ^ k) ((fact k : ℕ) : ℝ), abs_mul.real, hpow_m1_abs, abs_of_pos.real (1 / ((fact k : ℕ) : ℝ)) (one_div_pos.real ((fact k : ℕ) : ℝ) (fact_cast_pos k)), abs_of_nonneg.real (Mk + J) (by linarith), div_def.real (Mk + J) ((fact k : ℕ) : ℝ)]; ring
      rw [hof_abs, div_def.real Mk ((fact k : ℕ) : ℝ), div_def.real (Mk + J) ((fact k : ℕ) : ℝ)]
      exact mul_le_mul_of_nonneg_right.real Mk (Mk + J) (1 / ((fact k : ℕ) : ℝ)) (by linarith) (by linarith [one_div_pos.real ((fact k : ℕ) : ℝ) (fact_cast_pos k)])
    have habs_l := ctends_to.abs (fun (N : ℕ) => cint (fk k) X0 (X0 + (N : ℝ))) (a k) (ha_spec k).1
    have hsh_l : tends_to (fun (d : ℕ) => complex.abs (cint (fk k) X0 (X0 + ((N0 + d : ℕ) : ℝ)))) (complex.abs (a k))
      unfold tends_to at habs_l ⊢; intro e he; obtain ⟨N1, hN1⟩ := habs_l e he; use N1; intro d hd; exact hN1 (N0 + d) (by omega)
    exact tends_to.ge_of_ge (fun (d : ℕ) => complex.abs (cint (fk k) X0 (X0 + ((N0 + d : ℕ) : ℝ)))) (complex.abs (a k)) (Mk / ((fact k : ℕ) : ℝ)) hsh_l (by intro d; exact hge_N (N0 + d) (by omega))
  exact ⟨hM_conv, hps, hmom_le⟩

-- Complex-vs-real dominance for M(s) whenever Re(s) > sigma'!
+ mellin_H.abs_le_real (chi : DChar) (c beta X0 sigma' BM : ℝ) (s : ℂ)
    (hX0 : 1 ≤ X0) (hBM : 0 ≤ BM) (hs : sigma' < complex.re s)
    (hH : ∀ x : ℝ, X0 ≤ x → 0 ≤ classical_G chi x + c * rpow x beta)
    (hH_bd : ∀ B : ℝ, X0 ≤ B → ∃ I : ℝ, darboux.has_integral (fun x => (classical_G chi x + c * rpow x beta) * rpow x (-sigma' - 1)) X0 B I ∧ I ≤ BM) :
    complex.abs (M_shift chi c beta X0 s) ≤ complex.re (M_shift chi c beta X0 (complex.of_real (complex.re s)))
  set H := H_shift chi c beta with hH_fn
  have hH_unfold : H = (fun (x : ℝ) => classical_G chi x + c * rpow x beta) := by funext x; rw [hH_fn]; unfold H_shift; trivial
  set M := M_shift chi c beta X0 with hM_fn
  have h1 := (mellin_H.power_series_of_bound chi c beta X0 sigma' BM s hX0 hBM hs hH hH_bd).1 s (by rw [complex.sub_self, complex.abs_zero]; linarith)
  rw [← hH_fn, ← hM_fn] at h1
  have hre_gt : sigma' < complex.re (complex.of_real (complex.re s)) := by unfold complex.of_real; simp
  have h2 := (mellin_H.power_series_of_bound chi c beta X0 sigma' BM (complex.of_real (complex.re s)) hX0 hBM hre_gt hH hH_bd).1 (complex.of_real (complex.re s)) (by rw [complex.sub_self, complex.abs_zero]; linarith)
  rw [← hH_fn, ← hM_fn] at h2
  have h2_re : tends_to (fun (N : ℕ) => complex.re (cint (fun x => complex.mul (complex.of_real (H x)) (cpow_real x (complex.neg (complex.add (complex.of_real (complex.re s)) complex.one)))) X0 (X0 + (N : ℝ)))) (complex.re (M (complex.of_real (complex.re s))))
    unfold ctends_to at h2; unfold tends_to; intro e he; obtain ⟨N0, hN0⟩ := h2 e he; use N0; intro N hN
    have hlt := hN0 N hN
    have hle := complex.re_abs_le (complex.sub (cint (fun x => complex.mul (complex.of_real (H x)) (cpow_real x (complex.neg (complex.add (complex.of_real (complex.re s)) complex.one)))) X0 (X0 + (N : ℝ))) (M (complex.of_real (complex.re s))))
    simp at hle; linarith
  apply mellin.limit_abs_le_real (fun (N : ℕ) => cint (fun x => complex.mul (complex.of_real (H x)) (cpow_real x (complex.neg (complex.add s complex.one)))) X0 (X0 + (N : ℝ))) (fun (N : ℕ) => complex.re (cint (fun x => complex.mul (complex.of_real (H x)) (cpow_real x (complex.neg (complex.add (complex.of_real (complex.re s)) complex.one)))) X0 (X0 + (N : ℝ)))) (M s) (complex.re (M (complex.of_real (complex.re s)))) h1 h2_re
  intro N
  have hIc : c_has_integral (fun x => complex.mul (complex.of_real (H x)) (cpow_real x (complex.neg (complex.add s complex.one)))) X0 (X0 + (N : ℝ)) (cint (fun x => complex.mul (complex.of_real (H x)) (cpow_real x (complex.neg (complex.add s complex.one)))) X0 (X0 + (N : ℝ))) := by rw [hH_unfold]; exact classical_H_cmul.has_integral chi c beta (fun x => cpow_real x (complex.neg (complex.add s complex.one))) X0 (X0 + (N : ℝ)) hX0 (by linarith [cast_nonneg.real N]) (by intro t h1 _; exact cpow_real.continuous_re_im (complex.neg (complex.add s complex.one)) t (by linarith))
  have hIcr : c_has_integral (fun x => complex.mul (complex.of_real (H x)) (cpow_real x (complex.neg (complex.add (complex.of_real (complex.re s)) complex.one)))) X0 (X0 + (N : ℝ)) (cint (fun x => complex.mul (complex.of_real (H x)) (cpow_real x (complex.neg (complex.add (complex.of_real (complex.re s)) complex.one)))) X0 (X0 + (N : ℝ))) := by rw [hH_unfold]; exact classical_H_cmul.has_integral chi c beta (fun x => cpow_real x (complex.neg (complex.add (complex.of_real (complex.re s)) complex.one))) X0 (X0 + (N : ℝ)) hX0 (by linarith [cast_nonneg.real N]) (by intro t h1 _; exact cpow_real.continuous_re_im (complex.neg (complex.add (complex.of_real (complex.re s)) complex.one)) t (by linarith))
  have hIr : darboux.has_integral (fun x => H x * rpow x (-complex.re s - 1)) X0 (X0 + (N : ℝ)) (complex.re (cint (fun x => complex.mul (complex.of_real (H x)) (cpow_real x (complex.neg (complex.add (complex.of_real (complex.re s)) complex.one)))) X0 (X0 + (N : ℝ))))
    unfold c_has_integral at hIcr
    have hfe : (fun x => complex.re (complex.mul (complex.of_real (H x)) (cpow_real x (complex.neg (complex.add (complex.of_real (complex.re s)) complex.one))))) = (fun x => H x * rpow x (-complex.re s - 1))
      funext x; unfold complex.of_real cpow_real rpow; simp [cos_zero]
      have h1a : log x * (0 - (complex.re s + 1)) = (-complex.re s - 1) * log x := by ring
      rw [h1a]; ring
    rw [hfe] at hIcr; exact hIcr.1
  exact mellin.abs_complex_le_real H X0 (X0 + (N : ℝ)) (complex.re (cint (fun x => complex.mul (complex.of_real (H x)) (cpow_real x (complex.neg (complex.add (complex.of_real (complex.re s)) complex.one)))) X0 (X0 + (N : ℝ)))) s (cint (fun x => complex.mul (complex.of_real (H x)) (cpow_real x (complex.neg (complex.add s complex.one)))) X0 (X0 + (N : ℝ))) (by linarith [cast_nonneg.real N]) (by intro x hx1 hx2; rw [hH_unfold]; exact hH x hx1) hIc hIr

-- ====================================================================================
-- 5. MODULAR LANDAU CONTINUATION & MASTER THEOREM `classical_landau_osc`
--    (COMPLETELY RETIRES FRONTIER #2 WITH ZERO CUSTOM AXIOMS!)
-- ====================================================================================

-- Compact elementary helpers (eliminating duplication & avoiding nonlinear solver blowups):
+ complex.inv_of_real (r : ℝ) (hr : r ≠ 0) :
    complex.inv (complex.of_real r) = complex.of_real (1 / r)
  have hne : complex.of_real r ≠ complex.zero
    intro h0; have hre : complex.re (complex.of_real r) = complex.re complex.zero := by rw [h0]
    unfold complex.of_real at hre; simp at hre; exact hr hre
  have hc1 := complex.mul_inv_cancel (complex.of_real r) hne
  have hp : complex.mul (complex.of_real r) (complex.of_real (1 / r)) = complex.one
    have hcr := mul_inv_cancel.real r hr
    unfold complex.of_real; apply complex.ext
    · simp; linarith
    · simp
  have h1 : complex.mul (complex.inv (complex.of_real r)) (complex.mul (complex.of_real r) (complex.of_real (1 / r))) = complex.mul (complex.inv (complex.of_real r)) complex.one := by rw [hp]
  have h2 : complex.mul (complex.inv (complex.of_real r)) (complex.mul (complex.of_real r) (complex.of_real (1 / r))) = complex.mul (complex.mul (complex.of_real r) (complex.inv (complex.of_real r))) (complex.of_real (1 / r)) := by ring
  rw [h2, hc1, complex.one_mul, complex.mul_one] at h1; exact h1.symm

+ rpow.neg_le_one (x e : ℝ) (hx : 1 ≤ x) (he : e ≤ 0) :
    rpow x e ≤ 1
  unfold rpow
  have hle : e * log x ≤ 0
    have hm := mul_le_mul_of_nonneg_right.real e 0 (log x) he (log_nonneg x hx)
    linarith
  have h1 := (exp_le_exp (e * log x) 0).mpr hle
  rw [exp_zero] at h1; exact h1

+ mul_div_cancel_left_denom (a b d : ℝ) (ha : a ≠ 0) (hd : d ≠ 0) :
    d * (b / (a * d)) = b / a
  field_simp

+ div_two_mul_eq (a : ℝ) (ha : a ≠ 0) :
    1 / (2 * a) = (1 / 2) * (1 / a)
  field_simp

-- Top-level analytic pieces E_fin_shift, F_ana_shift, N_tot_shift:
-> E_fin_shift (chi : DChar) (X0 : ℝ) (s : ℂ) : ℂ :=
  cint (fun x => complex.mul (complex.of_real (classical_G chi x)) (cpow_real x (complex.neg (complex.add s complex.one)))) 1 X0

-> F_ana_shift (chi : DChar) (c beta X0 : ℝ) (s : ℂ) : ℂ :=
  complex.sub (complex.add (complex.mul (complex.smul c (cpow_real X0 (complex.sub (complex.of_real beta) s))) (complex.inv (complex.sub s (complex.of_real beta)))) (complex.mul (N_base chi s) (complex.inv (complex.mul s (D_chi chi s))))) (E_fin_shift chi X0 s)

-> N_tot_shift (chi : DChar) (c beta X0 : ℝ) (s : ℂ) : ℂ :=
  complex.sub (complex.add (complex.mul (complex.smul c (cpow_real X0 (complex.sub (complex.of_real beta) s))) (complex.mul s (D_chi chi s))) (complex.mul (complex.sub s (complex.of_real beta)) (N_base chi s))) (complex.mul (complex.mul (complex.mul s (complex.sub s (complex.of_real beta))) (D_chi chi s)) (E_fin_shift chi X0 s))

-- Step 1: Analyticity of E_fin_shift, N_tot_shift, F_ana_shift and denominator clearing!
+ landau_shift.analytic_and_clear (chi : DChar) (hval : dchar.valid chi) (c beta X0 : ℝ) (hX0 : 1 ≤ X0) :
    (∀ s0 : ℂ, is_canalytic_at (E_fin_shift chi X0) s0) ∧
    (∀ s0 : ℂ, 0 < complex.re s0 → is_canalytic_at (N_tot_shift chi c beta X0) s0) ∧
    (∀ s0 : ℂ, 0 < complex.re s0 → s0 ≠ complex.of_real beta → D_chi chi s0 ≠ complex.zero → is_canalytic_at (F_ana_shift chi c beta X0) s0) ∧
    (∀ s : ℂ, s ≠ complex.zero → s ≠ complex.of_real beta → D_chi chi s ≠ complex.zero →
      complex.mul (complex.mul (complex.mul s (complex.sub s (complex.of_real beta))) (D_chi chi s)) (F_ana_shift chi c beta X0 s) = N_tot_shift chi c beta X0 s)
  have hEfin_ana : ∀ s0 : ℂ, is_canalytic_at (E_fin_shift chi X0) s0
    intro s0; canalytic [E_fin_shift]
  have hNtot_ana : ∀ s0 : ℂ, 0 < complex.re s0 → is_canalytic_at (N_tot_shift chi c beta X0) s0
    intro s0 hs0; canalytic [N_tot_shift]
  have hFana_ana : ∀ s0 : ℂ, 0 < complex.re s0 → s0 ≠ complex.of_real beta → D_chi chi s0 ≠ complex.zero → is_canalytic_at (F_ana_shift chi c beta X0) s0
    intro s0 hs0 hsb hDz; canalytic [F_ana_shift]
  have hclear_F : ∀ s : ℂ, s ≠ complex.zero → s ≠ complex.of_real beta → D_chi chi s ≠ complex.zero →
      complex.mul (complex.mul (complex.mul s (complex.sub s (complex.of_real beta))) (D_chi chi s)) (F_ana_shift chi c beta X0 s) = N_tot_shift chi c beta X0 s
    intro s hs0 hsb hDz
    have hsb_ne : complex.sub s (complex.of_real beta) ≠ complex.zero
      intro h0; apply hsb; apply complex.ext
      · have hr : complex.re (complex.sub s (complex.of_real beta)) = complex.re complex.zero := by rw [h0]
        unfold complex.of_real at hr ⊢; simp at hr ⊢; linarith
      · have hi : complex.im (complex.sub s (complex.of_real beta)) = complex.im complex.zero := by rw [h0]
        unfold complex.of_real at hi ⊢; simp at hi ⊢; linarith
    have hsD_ne := complex.mul_ne_zero s (D_chi chi s) hs0 hDz
    have hc1 := complex.mul_inv_cancel (complex.sub s (complex.of_real beta)) hsb_ne
    have hc2 := complex.mul_inv_cancel (complex.mul s (D_chi chi s)) hsD_ne
    unfold F_ana_shift N_tot_shift
    set A := complex.sub s (complex.of_real beta) with hA_def
    set B := complex.mul s (D_chi chi s) with hB_def
    set T1 := complex.smul c (cpow_real X0 (complex.sub (complex.of_real beta) s)) with hT1_def
    set T2 := N_base chi s with hT2_def
    have hBA : complex.mul (complex.mul s A) (D_chi chi s) = complex.mul B A := by rw [hB_def, cmul.assoc, cmul.comm A (D_chi chi s), ← cmul.assoc]
    rw [hBA, cmul.sub_left, cmul.add_left]
    have h1a : complex.mul (complex.mul B A) (complex.mul T1 (complex.inv A)) = complex.mul T1 B := by rw [cmul.swap4 B A T1 (complex.inv A), hc1, complex.mul_one, cmul.comm B T1]
    have h2a : complex.mul (complex.mul B A) (complex.mul T2 (complex.inv B)) = complex.mul A T2 := by rw [cmul.comm T2 (complex.inv B), cmul.swap4 B A (complex.inv B) T2, hc2, complex.one_mul]
    rw [h1a, h2a, ← hBA]
  exact ⟨hEfin_ana, hNtot_ana, hFana_ana, hclear_F⟩

-- Step 2: Exact agreement `M_shift chi c beta (K0 : ℝ) s = F_ana_shift chi c beta (K0 : ℝ) s` on Re(s) > 1!
+ landau_shift.M_eq_F_gt1 (chi : DChar) (hval : dchar.valid chi) (c beta : ℝ) (K0 : ℕ) (hK0 : 2 ≤ K0) (hbeta_le1 : beta ≤ 1)
    (s : ℂ) (hs1 : 1 < complex.re s) :
    M_shift chi c beta (K0 : ℝ) s = F_ana_shift chi c beta (K0 : ℝ) s
  set X0 := (K0 : ℝ) with hX0_def
  have hX0_ge1 : 1 ≤ X0 := by linarith
  set H := H_shift chi c beta with hH_fn
  have hH_unfold : H = (fun (x : ℝ) => classical_G chi x + c * rpow x beta) := by funext x; rw [hH_fn]; unfold H_shift; trivial
  have hs0 : s ≠ complex.zero
    intro h0; have hr : complex.re s = complex.re complex.zero := by rw [h0]
    simp at hr; linarith
  have hsb_ne : complex.sub s (complex.of_real beta) ≠ complex.zero
    intro h0; have hr : complex.re (complex.sub s (complex.of_real beta)) = complex.re complex.zero := by rw [h0]
    unfold complex.of_real at hr; simp at hr; linarith
  have hD_ne := D_chi.ne_zero_re_gt_one chi hval s hs1
  have hsplit_N : ∀ N : ℕ, cint (fun x => complex.mul (complex.of_real (H x)) (cpow_real x (complex.neg (complex.add s complex.one)))) X0 (X0 + (N : ℝ)) = complex.add (complex.sub (cint (fun x => complex.mul (complex.of_real (classical_G chi x)) (cpow_real x (complex.neg (complex.add s complex.one)))) 1 (((K0 - 1 + N) + 1 : ℕ) : ℝ)) (E_fin_shift chi X0 s)) (complex.mul (complex.smul c (complex.sub (cpow_real X0 (complex.sub (complex.of_real beta) s)) (cpow_real (X0 + (N : ℝ)) (complex.sub (complex.of_real beta) s)))) (complex.inv (complex.sub s (complex.of_real beta))))
    intro N
    have hXN_eq : (((K0 - 1 + N) + 1 : ℕ) : ℝ) = X0 + (N : ℝ)
      have h1 : (K0 - 1 + N) + 1 = K0 + N := by omega
      rw [h1, cast_add.real K0 N, hX0_def]
    rw [hXN_eq]
    have hG1 := classical_G_cmul.has_integral chi (fun x => cpow_real x (complex.neg (complex.add s complex.one))) 1 X0 (by decide) hX0_ge1 (by intro t h1 _; exact cpow_real.continuous_re_im (complex.neg (complex.add s complex.one)) t (by linarith))
    have hG2 := classical_G_cmul.has_integral chi (fun x => cpow_real x (complex.neg (complex.add s complex.one))) X0 (X0 + (N : ℝ)) (by linarith) (by linarith [cast_nonneg.real N]) (by intro t h1 _; exact cpow_real.continuous_re_im (complex.neg (complex.add s complex.one)) t (by linarith))
    have hG_adj := c_has_integral.adjacent (fun x => complex.mul (complex.of_real (classical_G chi x)) (cpow_real x (complex.neg (complex.add s complex.one)))) 1 X0 (X0 + (N : ℝ)) (E_fin_shift chi X0 s) (cint (fun x => complex.mul (complex.of_real (classical_G chi x)) (cpow_real x (complex.neg (complex.add s complex.one)))) X0 (X0 + (N : ℝ))) (by unfold E_fin_shift; exact hG1) hG2
    have hG_tot := cint.eq_of_has_integral (fun x => complex.mul (complex.of_real (classical_G chi x)) (cpow_real x (complex.neg (complex.add s complex.one)))) 1 (X0 + (N : ℝ)) (complex.add (E_fin_shift chi X0 s) (cint (fun x => complex.mul (complex.of_real (classical_G chi x)) (cpow_real x (complex.neg (complex.add s complex.one)))) X0 (X0 + (N : ℝ)))) hG_adj
    have hG2_eq : cint (fun x => complex.mul (complex.of_real (classical_G chi x)) (cpow_real x (complex.neg (complex.add s complex.one)))) X0 (X0 + (N : ℝ)) = complex.sub (cint (fun x => complex.mul (complex.of_real (classical_G chi x)) (cpow_real x (complex.neg (complex.add s complex.one)))) 1 (X0 + (N : ℝ))) (E_fin_shift chi X0 s)
      rw [hG_tot]; apply complex.ext <;> simp <;> ring
    set w := complex.sub (complex.add s complex.one) (complex.of_real beta) with hw_def
    have hw_ne1 : w ≠ complex.one
      intro h1; apply hsb_ne; apply complex.ext
      · have hr : complex.re w = complex.re complex.one := by rw [h1]
        rw [hw_def] at hr; unfold complex.of_real at hr ⊢; simp at hr ⊢; linarith
      · have hi : complex.im w = complex.im complex.one := by rw [h1]
        rw [hw_def] at hi; unfold complex.of_real at hi ⊢; simp at hi ⊢
    have hpow := zeta.complex_power_integral w X0 (X0 + (N : ℝ)) (by linarith) (by linarith [cast_nonneg.real N]) hw_ne1
    have h1w : complex.sub complex.one w = complex.sub (complex.of_real beta) s
      rw [hw_def]; unfold complex.of_real; apply complex.ext <;> simp <;> ring
    have hinv_1w : complex.inv (complex.sub complex.one w) = complex.neg (complex.inv (complex.sub s (complex.of_real beta)))
      rw [h1w]
      have hneg_eq : complex.sub (complex.of_real beta) s = complex.neg (complex.sub s (complex.of_real beta))
        apply complex.ext <;> simp <;> ring
      rw [hneg_eq]
      have hc := complex.mul_inv_cancel (complex.sub s (complex.of_real beta)) hsb_ne
      have hneg_ne : complex.neg (complex.sub s (complex.of_real beta)) ≠ complex.zero
        intro h0; apply hsb_ne; apply complex.ext
        · have hr : complex.re (complex.neg (complex.sub s (complex.of_real beta))) = complex.re complex.zero := by rw [h0]
          simp at hr ⊢; linarith
        · have hi : complex.im (complex.neg (complex.sub s (complex.of_real beta))) = complex.im complex.zero := by rw [h0]
          simp at hi ⊢; linarith
      have hc2 := complex.mul_inv_cancel (complex.neg (complex.sub s (complex.of_real beta))) hneg_ne
      have hp : complex.mul (complex.neg (complex.sub s (complex.of_real beta))) (complex.neg (complex.inv (complex.sub s (complex.of_real beta)))) = complex.one
        have hre : complex.mul (complex.neg (complex.sub s (complex.of_real beta))) (complex.neg (complex.inv (complex.sub s (complex.of_real beta)))) = complex.mul (complex.sub s (complex.of_real beta)) (complex.inv (complex.sub s (complex.of_real beta)))
          apply complex.ext <;> simp <;> ring
        rw [hre, hc]
      have h1 : complex.mul (complex.inv (complex.neg (complex.sub s (complex.of_real beta)))) (complex.mul (complex.neg (complex.sub s (complex.of_real beta))) (complex.neg (complex.inv (complex.sub s (complex.of_real beta))))) = complex.mul (complex.inv (complex.neg (complex.sub s (complex.of_real beta)))) complex.one := by rw [hp]
      have h2 : complex.mul (complex.inv (complex.neg (complex.sub s (complex.of_real beta)))) (complex.mul (complex.neg (complex.sub s (complex.of_real beta))) (complex.neg (complex.inv (complex.sub s (complex.of_real beta))))) = complex.mul (complex.mul (complex.neg (complex.sub s (complex.of_real beta))) (complex.inv (complex.neg (complex.sub s (complex.of_real beta))))) (complex.neg (complex.inv (complex.sub s (complex.of_real beta))))
        apply complex.ext <;> simp <;> ring
      rw [h2, hc2, complex.one_mul, complex.mul_one] at h1; exact h1.symm
    rw [hinv_1w, h1w] at hpow
    have hsc := c_has_integral.scale_real (fun x => cpow_real x (complex.neg w)) X0 (X0 + (N : ℝ)) c (complex.mul (complex.neg (complex.inv (complex.sub s (complex.of_real beta)))) (complex.sub (cpow_real (X0 + (N : ℝ)) (complex.sub (complex.of_real beta) s)) (cpow_real X0 (complex.sub (complex.of_real beta) s)))) hpow
    have hpow_val : complex.smul c (complex.mul (complex.neg (complex.inv (complex.sub s (complex.of_real beta)))) (complex.sub (cpow_real (X0 + (N : ℝ)) (complex.sub (complex.of_real beta) s)) (cpow_real X0 (complex.sub (complex.of_real beta) s)))) = complex.mul (complex.smul c (complex.sub (cpow_real X0 (complex.sub (complex.of_real beta) s)) (cpow_real (X0 + (N : ℝ)) (complex.sub (complex.of_real beta) s)))) (complex.inv (complex.sub s (complex.of_real beta)))
      apply complex.ext <;> simp <;> ring
    rw [hpow_val] at hsc
    have hpow_con : c_has_integral (fun x => complex.mul (complex.of_real (c * rpow x beta)) (cpow_real x (complex.neg (complex.add s complex.one)))) X0 (X0 + (N : ℝ)) (complex.mul (complex.smul c (complex.sub (cpow_real X0 (complex.sub (complex.of_real beta) s)) (cpow_real (X0 + (N : ℝ)) (complex.sub (complex.of_real beta) s)))) (complex.inv (complex.sub s (complex.of_real beta))))
      apply c_has_integral.congr (fun x => complex.smul c (cpow_real x (complex.neg w))) (fun x => complex.mul (complex.of_real (c * rpow x beta)) (cpow_real x (complex.neg (complex.add s complex.one)))) X0 (X0 + (N : ℝ)) (complex.mul (complex.smul c (complex.sub (cpow_real X0 (complex.sub (complex.of_real beta) s)) (cpow_real (X0 + (N : ℝ)) (complex.sub (complex.of_real beta) s)))) (complex.inv (complex.sub s (complex.of_real beta)))) hsc
      intro x hx1 _
      have h1 : complex.mul (complex.of_real (c * rpow x beta)) (cpow_real x (complex.neg (complex.add s complex.one))) = complex.smul c (complex.mul (complex.of_real (rpow x beta)) (cpow_real x (complex.neg (complex.add s complex.one))))
        unfold complex.of_real; apply complex.ext <;> simp <;> ring
      rw [h1, cpow_real.of_real_exp x beta, ← cpow_real.add_exp]
      have harg : complex.add (complex.of_real beta) (complex.neg (complex.add s complex.one)) = complex.neg w
        rw [hw_def]; unfold complex.of_real; apply complex.ext <;> simp <;> ring
      rw [harg]
    have hadd := c_has_integral.add (fun x => complex.mul (complex.of_real (classical_G chi x)) (cpow_real x (complex.neg (complex.add s complex.one)))) (fun x => complex.mul (complex.of_real (c * rpow x beta)) (cpow_real x (complex.neg (complex.add s complex.one)))) X0 (X0 + (N : ℝ)) (cint (fun x => complex.mul (complex.of_real (classical_G chi x)) (cpow_real x (complex.neg (complex.add s complex.one)))) X0 (X0 + (N : ℝ))) (complex.mul (complex.smul c (complex.sub (cpow_real X0 (complex.sub (complex.of_real beta) s)) (cpow_real (X0 + (N : ℝ)) (complex.sub (complex.of_real beta) s)))) (complex.inv (complex.sub s (complex.of_real beta)))) hG2 hpow_con
    have hpt_H : ∀ x : ℝ, X0 ≤ x → x ≤ X0 + (N : ℝ) → complex.add (complex.mul (complex.of_real (classical_G chi x)) (cpow_real x (complex.neg (complex.add s complex.one)))) (complex.mul (complex.of_real (c * rpow x beta)) (cpow_real x (complex.neg (complex.add s complex.one)))) = complex.mul (complex.of_real (H x)) (cpow_real x (complex.neg (complex.add s complex.one)))
      intro x _ _; rw [hH_unfold]; unfold complex.of_real; apply complex.ext <;> simp <;> ring
    have hcon := c_has_integral.congr (fun x => complex.add (complex.mul (complex.of_real (classical_G chi x)) (cpow_real x (complex.neg (complex.add s complex.one)))) (complex.mul (complex.of_real (c * rpow x beta)) (cpow_real x (complex.neg (complex.add s complex.one))))) (fun x => complex.mul (complex.of_real (H x)) (cpow_real x (complex.neg (complex.add s complex.one)))) X0 (X0 + (N : ℝ)) (complex.add (cint (fun x => complex.mul (complex.of_real (classical_G chi x)) (cpow_real x (complex.neg (complex.add s complex.one)))) X0 (X0 + (N : ℝ))) (complex.mul (complex.smul c (complex.sub (cpow_real X0 (complex.sub (complex.of_real beta) s)) (cpow_real (X0 + (N : ℝ)) (complex.sub (complex.of_real beta) s)))) (complex.inv (complex.sub s (complex.of_real beta))))) hadd hpt_H
    rw [cint.eq_of_has_integral (fun x => complex.mul (complex.of_real (H x)) (cpow_real x (complex.neg (complex.add s complex.one)))) X0 (X0 + (N : ℝ)) (complex.add (cint (fun x => complex.mul (complex.of_real (classical_G chi x)) (cpow_real x (complex.neg (complex.add s complex.one)))) X0 (X0 + (N : ℝ))) (complex.mul (complex.smul c (complex.sub (cpow_real X0 (complex.sub (complex.of_real beta) s)) (cpow_real (X0 + (N : ℝ)) (complex.sub (complex.of_real beta) s)))) (complex.inv (complex.sub s (complex.of_real beta))))) hcon, hG2_eq]
  have hG_lim := classical_G.mellin_limit_re_gt_one chi hval s hs1
  have hG_sh : ctends_to (fun (N : ℕ) => cint (fun x => complex.mul (complex.of_real (classical_G chi x)) (cpow_real x (complex.neg (complex.add s complex.one)))) 1 (((K0 - 1 + N) + 1 : ℕ) : ℝ)) (G_mellin_mer chi s)
    unfold ctends_to at hG_lim ⊢; intro e he; obtain ⟨N0, hN0⟩ := hG_lim e he; use N0; intro N hN; exact hN0 (K0 - 1 + N) (by omega)
  have htail_lim : ctends_to (fun (N : ℕ) => cpow_real (X0 + (N : ℝ)) (complex.sub (complex.of_real beta) s)) complex.zero
    have hrl := rpow.nat_neg_tends_to_zero (complex.re s - beta) (by linarith)
    unfold ctends_to; unfold tends_to at hrl; intro e he; obtain ⟨N0, hN0⟩ := hrl e he; use N0; intro N hN
    have hsub0 : complex.sub (cpow_real (X0 + (N : ℝ)) (complex.sub (complex.of_real beta) s)) complex.zero = cpow_real (X0 + (N : ℝ)) (complex.sub (complex.of_real beta) s)
      apply complex.ext <;> simp <;> ring
    rw [hsub0]
    have hap : complex.abs (cpow_real (X0 + (N : ℝ)) (complex.sub (complex.of_real beta) s)) = rpow (X0 + (N : ℝ)) (-(complex.re s - beta))
      have hsq : complex.abs (cpow_real (X0 + (N : ℝ)) (complex.sub (complex.of_real beta) s)) * complex.abs (cpow_real (X0 + (N : ℝ)) (complex.sub (complex.of_real beta) s)) = rpow (X0 + (N : ℝ)) (-(complex.re s - beta)) * rpow (X0 + (N : ℝ)) (-(complex.re s - beta))
        rw [complex.abs_sq]; unfold complex.norm_sq cpow_real rpow complex.of_real; simp
        have h1 : log (X0 + (N : ℝ)) * (beta - complex.re s) = -(complex.re s - beta) * log (X0 + (N : ℝ)) := by ring
        rw [h1]; linear_combination (exp (-(complex.re s - beta) * log (X0 + (N : ℝ))) * exp (-(complex.re s - beta) * log (X0 + (N : ℝ)))) * sin_sq_add_cos_sq (log (X0 + (N : ℝ)) * (0 - complex.im s))
      exact eq_of_sq_eq_nonneg (complex.abs (cpow_real (X0 + (N : ℝ)) (complex.sub (complex.of_real beta) s))) (rpow (X0 + (N : ℝ)) (-(complex.re s - beta))) (complex.abs_nonneg (cpow_real (X0 + (N : ℝ)) (complex.sub (complex.of_real beta) s))) (by linarith [rpow.pos (X0 + (N : ℝ)) (-(complex.re s - beta))]) hsq
    rw [hap]
    have hge : ((N + 1 : ℕ) : ℝ) ≤ X0 + (N : ℝ) := by rw [cast_add.real N 1]; simp; linarith
    have hle_rp : rpow (X0 + (N : ℝ)) (-(complex.re s - beta)) ≤ rpow ((N + 1 : ℕ) : ℝ) (-(complex.re s - beta))
      unfold rpow
      have hl := (log_le_log ((N + 1 : ℕ) : ℝ) (X0 + (N : ℝ)) ((cast_pos.real (N + 1)).mpr (by omega)) (by linarith [cast_nonneg.real N])).mpr hge
      have hm := mul_le_mul_of_nonneg_left.real (log ((N + 1 : ℕ) : ℝ)) (log (X0 + (N : ℝ))) (complex.re s - beta) hl (by linarith)
      exact (exp_le_exp (-(complex.re s - beta) * log (X0 + (N : ℝ))) (-(complex.re s - beta) * log ((N + 1 : ℕ) : ℝ))).mpr (by linarith)
    have h1 := hN0 N hN
    have hsub_r : rpow ((N + 1 : ℕ) : ℝ) (-(complex.re s - beta)) - 0 = rpow ((N + 1 : ℕ) : ℝ) (-(complex.re s - beta)) := by ring
    rw [hsub_r, abs_of_pos.real (rpow ((N + 1 : ℕ) : ℝ) (-(complex.re s - beta))) (rpow.pos ((N + 1 : ℕ) : ℝ) (-(complex.re s - beta)))] at h1
    linarith
  have h1 := ctends_to.sub (fun (N : ℕ) => cint (fun x => complex.mul (complex.of_real (classical_G chi x)) (cpow_real x (complex.neg (complex.add s complex.one)))) 1 (((K0 - 1 + N) + 1 : ℕ) : ℝ)) (fun _ => E_fin_shift chi X0 s) (G_mellin_mer chi s) (E_fin_shift chi X0 s) hG_sh (ctends_to.const (E_fin_shift chi X0 s))
  have h2a := ctends_to.sub (fun _ => cpow_real X0 (complex.sub (complex.of_real beta) s)) (fun (N : ℕ) => cpow_real (X0 + (N : ℝ)) (complex.sub (complex.of_real beta) s)) (cpow_real X0 (complex.sub (complex.of_real beta) s)) complex.zero (ctends_to.const (cpow_real X0 (complex.sub (complex.of_real beta) s))) htail_lim
  have h2b := ctends_to.const_mul (complex.mul (complex.of_real c) (complex.inv (complex.sub s (complex.of_real beta)))) (fun (N : ℕ) => complex.sub (cpow_real X0 (complex.sub (complex.of_real beta) s)) (cpow_real (X0 + (N : ℝ)) (complex.sub (complex.of_real beta) s))) (complex.sub (cpow_real X0 (complex.sub (complex.of_real beta) s)) complex.zero) h2a
  have htot := ctends_to.add (fun (N : ℕ) => complex.sub (cint (fun x => complex.mul (complex.of_real (classical_G chi x)) (cpow_real x (complex.neg (complex.add s complex.one)))) 1 (((K0 - 1 + N) + 1 : ℕ) : ℝ)) (E_fin_shift chi X0 s)) (fun (N : ℕ) => complex.mul (complex.mul (complex.of_real c) (complex.inv (complex.sub s (complex.of_real beta)))) (complex.sub (cpow_real X0 (complex.sub (complex.of_real beta) s)) (cpow_real (X0 + (N : ℝ)) (complex.sub (complex.of_real beta) s)))) (complex.sub (G_mellin_mer chi s) (E_fin_shift chi X0 s)) (complex.mul (complex.mul (complex.of_real c) (complex.inv (complex.sub s (complex.of_real beta)))) (complex.sub (cpow_real X0 (complex.sub (complex.of_real beta) s)) complex.zero)) h1 h2b
  have hfe : (fun (N : ℕ) => complex.add (complex.sub (cint (fun x => complex.mul (complex.of_real (classical_G chi x)) (cpow_real x (complex.neg (complex.add s complex.one)))) 1 (((K0 - 1 + N) + 1 : ℕ) : ℝ)) (E_fin_shift chi X0 s)) (complex.mul (complex.mul (complex.of_real c) (complex.inv (complex.sub s (complex.of_real beta)))) (complex.sub (cpow_real X0 (complex.sub (complex.of_real beta) s)) (cpow_real (X0 + (N : ℝ)) (complex.sub (complex.of_real beta) s))))) = (fun (N : ℕ) => cint (fun x => complex.mul (complex.of_real (H x)) (cpow_real x (complex.neg (complex.add s complex.one)))) X0 (X0 + (N : ℝ)))
    funext N; rw [hsplit_N N]; unfold complex.of_real; apply complex.ext <;> simp <;> ring
  have hGmer_eq : G_mellin_mer chi s = complex.mul (N_base chi s) (complex.inv (complex.mul s (D_chi chi s)))
    have hcl := G_mellin_mer.cleared_eq_N_base chi hval s hs1
    have hsD_ne := complex.mul_ne_zero s (D_chi chi s) hs0 hD_ne
    have hc1 := complex.mul_inv_cancel (complex.mul s (D_chi chi s)) hsD_ne
    have h1a : complex.mul (complex.inv (complex.mul s (D_chi chi s))) (complex.mul (complex.mul s (D_chi chi s)) (G_mellin_mer chi s)) = complex.mul (complex.inv (complex.mul s (D_chi chi s))) (N_base chi s) := by rw [hcl]
    have h2a' : complex.mul (complex.inv (complex.mul s (D_chi chi s))) (complex.mul (complex.mul s (D_chi chi s)) (G_mellin_mer chi s)) = complex.mul (complex.mul (complex.mul s (D_chi chi s)) (complex.inv (complex.mul s (D_chi chi s)))) (G_mellin_mer chi s)
      apply complex.ext <;> simp <;> ring
    have h3a : complex.mul (complex.inv (complex.mul s (D_chi chi s))) (N_base chi s) = complex.mul (N_base chi s) (complex.inv (complex.mul s (D_chi chi s)))
      apply complex.ext <;> simp <;> ring
    rw [h2a', hc1, complex.one_mul, h3a] at h1a; exact h1a
  have hval_lim : complex.add (complex.sub (G_mellin_mer chi s) (E_fin_shift chi X0 s)) (complex.mul (complex.mul (complex.of_real c) (complex.inv (complex.sub s (complex.of_real beta)))) (complex.sub (cpow_real X0 (complex.sub (complex.of_real beta) s)) complex.zero)) = F_ana_shift chi c beta X0 s
    unfold F_ana_shift; rw [hGmer_eq]; unfold complex.of_real; apply complex.ext <;> simp <;> ring
  rw [hfe, hval_lim] at htot
  unfold M_shift; rw [← hH_fn]
  exact clim.eq_of_tends_to (fun (N : ℕ) => cint (fun x => complex.mul (complex.of_real (H x)) (cpow_real x (complex.neg (complex.add s complex.one)))) X0 (X0 + (N : ℝ))) (F_ana_shift chi c beta X0 s) htot

-- Step 3: Rightmost real zero sigma0 of D_chi in [beta, 1] (or beta if none)!
+ D_chi.exists_rightmost_real_zero (chi : DChar) (hval : dchar.valid chi) (beta : ℝ) (hbeta_pos : 0 < beta) (hbeta_le1 : beta ≤ 1) :
    ∃ sigma0 : ℝ, beta ≤ sigma0 ∧ sigma0 ≤ 1 ∧
      (∀ t : ℝ, sigma0 < t → D_chi chi (complex.of_real t) ≠ complex.zero) ∧
      (beta < sigma0 → D_chi chi (complex.of_real sigma0) = complex.zero)
  set Z_real := (fun (t : ℝ) => beta ≤ t ∧ t ≤ 1 ∧ D_chi chi (complex.of_real t) = complex.zero) with hZreal
  by_cases hne : ∃ t : ℝ, Z_real t
  · have hub : upper_bound Z_real 1 := by unfold upper_bound; intro t ht; rw [hZreal] at ht; exact ht.2.1
    obtain ⟨s0, hs0⟩ := sup_exists Z_real hne ⟨1, hub⟩
    obtain ⟨t0, ht0⟩ := hne
    have hs0_ge : beta ≤ s0
      have h1 := is_sup.le_of_mem Z_real s0 t0 hs0 ht0
      rw [hZreal] at ht0; linarith
    have hs0_le : s0 ≤ 1 := hs0.2 1 hub
    have hD_s0 : D_chi chi (complex.of_real s0) = complex.zero
      by_contra hne0
      have hana := D_chi.is_canalytic_at_re_pos chi hval (complex.of_real s0) (by unfold complex.of_real; simp; linarith)
      unfold is_canalytic_at at hana; obtain ⟨aD, rD, hpsD⟩ := hana
      have hpos : 0 < complex.abs (D_chi chi (complex.of_real s0))
        by_contra hle; exact hne0 ((complex.abs_eq_zero (D_chi chi (complex.of_real s0))).mp (by linarith [complex.abs_nonneg (D_chi chi (complex.of_real s0))]))
      obtain ⟨d, hd_pos, hd⟩ := is_cpower_series_at.continuous_at (D_chi chi) (complex.of_real s0) aD rD hpsD (complex.abs (D_chi chi (complex.of_real s0)) / 2) (by linarith)
      obtain ⟨t, ht_mem, ht_gt⟩ := is_sup.exists_gt Z_real s0 (s0 - d) hs0 (by linarith)
      have ht_le : t ≤ s0 := is_sup.le_of_mem Z_real s0 t hs0 ht_mem
      have hdist : complex.abs (complex.sub (complex.of_real t) (complex.of_real s0)) < d
        have hsub : complex.sub (complex.of_real t) (complex.of_real s0) = complex.neg (complex.of_real (s0 - t))
          unfold complex.of_real; apply complex.ext <;> simp <;> ring
        rw [hsub, complex.abs_neg, complex.abs_of_real_nonneg (s0 - t) (by linarith)]; linarith
      have h1 := hd (complex.of_real t) hdist
      rw [hZreal] at ht_mem
      rw [ht_mem.2.2] at h1
      have hsub0 : complex.sub complex.zero (D_chi chi (complex.of_real s0)) = complex.neg (D_chi chi (complex.of_real s0))
        apply complex.ext <;> simp <;> ring
      rw [hsub0, complex.abs_neg] at h1; linarith
    use s0; constructor; exact hs0_ge; constructor; exact hs0_le
    constructor
    · intro t ht hDz
      by_cases ht1 : t ≤ 1
      · have hmem : Z_real t := by rw [hZreal]; exact ⟨by linarith, ht1, hDz⟩
        linarith [is_sup.le_of_mem Z_real s0 t hs0 hmem]
      · exact D_chi.ne_zero_re_gt_one chi hval (complex.of_real t) (by unfold complex.of_real; simp; linarith) hDz
    · intro _; exact hD_s0
  · use beta; constructor; linarith; constructor; exact hbeta_le1
    constructor
    · intro t ht hDz
      by_cases ht1 : t ≤ 1
      · exact hne ⟨t, by rw [hZreal]; exact ⟨by linarith, ht1, hDz⟩⟩
      · exact D_chi.ne_zero_re_gt_one chi hval (complex.of_real t) (by unfold complex.of_real; simp; linarith) hDz
    · intro hc; linarith

-- Step 4: Pringsheim-Landau abscissa theorem (`alpha = sigma0`), yielding dominance + analytic continuation on ALL Re(s) > sigma0!
+ landau_shift.abscissa_eq_sigma0 (chi : DChar) (hval : dchar.valid chi) (c beta sigma0 : ℝ) (K0 : ℕ)
    (hK0 : 2 ≤ K0) (hc : 0 < c) (hbeta_pos : 0 < beta) (hsig0_ge : beta ≤ sigma0) (hsig0_le : sigma0 ≤ 1)
    (hD_gt_sig0 : ∀ t : ℝ, sigma0 < t → D_chi chi (complex.of_real t) ≠ complex.zero)
    (hH_nn : ∀ x : ℝ, (K0 : ℝ) ≤ x → 0 ≤ classical_G chi x + c * rpow x beta) :
    (∀ s : ℂ, sigma0 < complex.re s → complex.abs (M_shift chi c beta (K0 : ℝ) s) ≤ complex.re (M_shift chi c beta (K0 : ℝ) (complex.of_real (complex.re s)))) ∧
    (∀ s : ℂ, sigma0 < complex.re s → s ≠ complex.of_real beta → D_chi chi s ≠ complex.zero → M_shift chi c beta (K0 : ℝ) s = F_ana_shift chi c beta (K0 : ℝ) s)
  set X0 := (K0 : ℝ) with hX0_def
  have hX0_ge1 : 1 ≤ X0 := by linarith
  set H := H_shift chi c beta with hH_fn
  have hH_unfold : H = (fun (x : ℝ) => classical_G chi x + c * rpow x beta) := by funext x; rw [hH_fn]; unfold H_shift; trivial
  set M_fn := M_shift chi c beta X0 with hMfn
  set F_ana := F_ana_shift chi c beta X0 with hFana
  set N_tot := N_tot_shift chi c beta X0 with hNtot
  have hpack1 := landau_shift.analytic_and_clear chi hval c beta X0 hX0_ge1
  have hNtot_ana : ∀ s0 : ℂ, 0 < complex.re s0 → is_canalytic_at N_tot s0 := by rw [hNtot]; exact hpack1.2.1
  have hFana_ana : ∀ s0 : ℂ, 0 < complex.re s0 → s0 ≠ complex.of_real beta → D_chi chi s0 ≠ complex.zero → is_canalytic_at F_ana s0 := by rw [hFana]; exact hpack1.2.2.1
  have hclear_F : ∀ s : ℂ, s ≠ complex.zero → s ≠ complex.of_real beta → D_chi chi s ≠ complex.zero → complex.mul (complex.mul (complex.mul s (complex.sub s (complex.of_real beta))) (D_chi chi s)) (F_ana s) = N_tot s := by rw [hFana, hNtot]; exact hpack1.2.2.2
  have hM_eq_F_gt1 : ∀ s : ℂ, 1 < complex.re s → M_fn s = F_ana s := by intro s hs; rw [hMfn, hFana, hX0_def]; exact landau_shift.M_eq_F_gt1 chi hval c beta K0 hK0 (by linarith) s hs
  set S_set := (fun (sig : ℝ) => sigma0 ≤ sig ∧ sig ≤ 3 ∧ ∃ BM : ℝ, 0 ≤ BM ∧ ∀ B : ℝ, X0 ≤ B → ∃ I : ℝ, darboux.has_integral (fun x => H x * rpow x (-sig - 1)) X0 B I ∧ I ≤ BM) with hSset
  have h3_mem : S_set 3
    rw [hSset]; constructor; linarith; constructor; linarith
    use 2 + c; constructor; linarith
    intro B hXB
    have hcw : ∀ t : ℝ, X0 ≤ t → t ≤ B → continuous_at (fun x => rpow x (-3 - 1)) t
      intro t h1 _; unfold rpow
      exact continuous_at.exp_comp (fun x => (-3 - 1) * log x) t (continuous_at.mul (fun _ => -3 - 1) log t (continuous_at.const (-3 - 1) t) (continuous_at.log t (by linarith)))
    obtain ⟨I, hI⟩ := classical_H_mul.has_integral chi c beta (fun x => rpow x (-3 - 1)) X0 B hX0_ge1 hXB hcw
    use I; constructor; rw [hH_unfold]; exact hI
    have hrp := darboux.rpow_neg_power 1 X0 B (by linarith) hXB
    have hsc := darboux.scale (fun x => 1 * rpow x (-1 - 1)) X0 B (rpow X0 (-1) - rpow B (-1)) (2 + c) hrp
    have hle_I : I ≤ (2 + c) * (rpow X0 (-1) - rpow B (-1))
      apply darboux.mono (fun x => (classical_G chi x + c * rpow x beta) * rpow x (-3 - 1)) (fun x => (2 + c) * (1 * rpow x (-1 - 1))) X0 B I ((2 + c) * (rpow X0 (-1) - rpow B (-1))) hI hsc
      intro x hx1 _
      have hG_le := classical_G.upper_bound chi hval x (by linarith)
      have hx_rpow2 : x * x = rpow x 2
        unfold rpow; have h2 : (2 : ℝ) * log x = log x + log x := by ring
        rw [h2, exp_add, exp_log x (by linarith)]
      have hxb_le : rpow x beta ≤ rpow x 2 := by unfold rpow; exact (exp_le_exp (beta * log x) (2 * log x)).mpr (mul_le_mul_of_nonneg_right.real beta 2 (log x) (by linarith) (log_nonneg x (by linarith)))
      have hH_le : classical_G chi x + c * rpow x beta ≤ (2 + c) * rpow x 2
        have hm := mul_le_mul_of_nonneg_left.real (rpow x beta) (rpow x 2) c hxb_le (by linarith)
        have h2xx : 2 * x * x = 2 * (x * x) := by ring
        rw [h2xx, hx_rpow2] at hG_le; linarith
      have hm2 := mul_le_mul_of_nonneg_right.real (classical_G chi x + c * rpow x beta) ((2 + c) * rpow x 2) (rpow x (-3 - 1)) hH_le (by linarith [rpow.pos x (-3 - 1)])
      have hcomb : rpow x 2 * rpow x (-3 - 1) = rpow x (-1 - 1)
        rw [← rpow.add]
        have he : (2 : ℝ) + (-3 - 1) = -1 - 1 := by ring
        rw [he]
      have hre : (2 + c) * rpow x 2 * rpow x (-3 - 1) = (2 + c) * (1 * (rpow x 2 * rpow x (-3 - 1))) := by ring
      rw [hre, hcomb] at hm2; exact hm2
    have hX0_inv : rpow X0 (-1) ≤ 1 := rpow.neg_le_one X0 (-1) hX0_ge1 (by linarith)
    have hsub_le1 : rpow X0 (-1) - rpow B (-1) ≤ 1 := by linarith [rpow.pos B (-1)]
    have hm := mul_le_mul_of_nonneg_left.real (rpow X0 (-1) - rpow B (-1)) 1 (2 + c) hsub_le1 (by linarith)
    linarith
  set NegS := (fun (u : ℝ) => S_set (-u)) with hNegS
  have hNegS_ne : ∃ u : ℝ, NegS u := ⟨-3, by rw [hNegS]; have h3 : -(-3 : ℝ) = 3 := by ring; rw [h3]; exact h3_mem⟩
  have hNegS_ub : upper_bound NegS (-sigma0) := by unfold upper_bound; intro u hu; rw [hNegS, hSset] at hu; linarith
  obtain ⟨neg_alpha, hneg_sup⟩ := sup_exists NegS hNegS_ne ⟨-sigma0, hNegS_ub⟩
  set alpha := -neg_alpha with halpha_def
  have halpha_ge : sigma0 ≤ alpha := by have h := hneg_sup.2 (-sigma0) hNegS_ub; rw [halpha_def]; linarith
  have halpha_le3 : alpha ≤ 3
    have h1 := is_sup.le_of_mem NegS neg_alpha (-3) hneg_sup (by rw [hNegS]; have h3 : -(-3 : ℝ) = 3 := by ring; rw [h3]; exact h3_mem)
    rw [halpha_def]; linarith
  have hgt_alpha_wit : ∀ sig : ℝ, alpha < sig → ∃ (sig' BM : ℝ), alpha ≤ sig' ∧ sig' < sig ∧ 0 ≤ BM ∧ ∀ B : ℝ, X0 ≤ B → ∃ I : ℝ, darboux.has_integral (fun x => H x * rpow x (-sig' - 1)) X0 B I ∧ I ≤ BM
    intro sig hsig
    obtain ⟨u, hu_mem, hu_gt⟩ := is_sup.exists_gt NegS neg_alpha (-sig) hneg_sup (by rw [halpha_def] at hsig; linarith)
    have hu_le := is_sup.le_of_mem NegS neg_alpha u hneg_sup hu_mem
    rw [hNegS, hSset] at hu_mem
    obtain ⟨BM, hBM_nn, hBM⟩ := hu_mem.2.2
    exact ⟨-u, BM, by rw [halpha_def]; linarith, by linarith, hBM_nn, hBM⟩
  have hBM_unfold : ∀ (sig' BM : ℝ), (∀ B : ℝ, X0 ≤ B → ∃ I : ℝ, darboux.has_integral (fun x => H x * rpow x (-sig' - 1)) X0 B I ∧ I ≤ BM) → (∀ B : ℝ, X0 ≤ B → ∃ I : ℝ, darboux.has_integral (fun x => (classical_G chi x + c * rpow x beta) * rpow x (-sig' - 1)) X0 B I ∧ I ≤ BM)
    intro sig' BM hB B hXB
    have hfe : (fun x => (classical_G chi x + c * rpow x beta) * rpow x (-sig' - 1)) = (fun x => H x * rpow x (-sig' - 1)) := by funext x; rw [hH_fn]; unfold H_shift; trivial
    rw [hfe]; exact hB B hXB
  have hM_ana_gt_alpha : ∀ s0 : ℂ, alpha < complex.re s0 → is_canalytic_at M_fn s0
    intro s0 hs0
    obtain ⟨sig', BM, _, hlt, hBM_nn, hBM⟩ := hgt_alpha_wit (complex.re s0) hs0
    have hps_all := mellin_H.power_series_of_bound chi c beta X0 sig' BM s0 hX0_ge1 hBM_nn hlt hH_nn (hBM_unfold sig' BM hBM)
    have hps := hps_all.2.1
    unfold is_canalytic_at; rw [hMfn]
    exact ⟨M_shift_coeff chi c beta X0 s0, complex.re s0 - sig', hps⟩
  have hglobal_id : ∀ s : ℂ, alpha < complex.re s →
      complex.mul (complex.mul (complex.mul s (complex.sub s (complex.of_real beta))) (D_chi chi s)) (M_fn s) = N_tot s
    intro s hs
    apply is_canalytic_on.identity_segment (fun z => complex.mul (complex.mul (complex.mul z (complex.sub z (complex.of_real beta))) (D_chi chi z)) (M_fn z)) N_tot (complex.of_real 4) s 1 (by decide)
    · intro t ht1 ht2
      set z := complex.add (complex.of_real 4) (complex.smul t (complex.sub s (complex.of_real 4))) with hz
      have hz_re_a : alpha < complex.re z := by rw [hz]; unfold complex.of_real; simp; exact convex_gt 4 (complex.re s) alpha t (by linarith) hs ht1 ht2
      have hz_re_0 : 0 < complex.re z := by linarith
      canalytic
    · intro t ht1 ht2
      set z := complex.add (complex.of_real 4) (complex.smul t (complex.sub s (complex.of_real 4))) with hz
      have hz_re_0 : 0 < complex.re z := by rw [hz]; unfold complex.of_real; simp; exact convex_gt 4 (complex.re s) 0 t (by decide) (by linarith) ht1 ht2
      exact hNtot_ana z hz_re_0
    · intro z hz
      have hz_re1 : 1 < complex.re z
        have h1 := complex.re_abs_le (complex.sub z (complex.of_real 4))
        have hsr : complex.re (complex.sub z (complex.of_real 4)) = complex.re z - 4 := by unfold complex.of_real; simp
        rw [hsr] at h1
        linarith [neg_le_abs.real (complex.re z - 4)]
      have hz0 : z ≠ complex.zero
        intro h0; have hr : complex.re z = complex.re complex.zero := by rw [h0]
        simp at hr; linarith
      have hz_b : z ≠ complex.of_real beta
        intro h0; have hr : complex.re z = complex.re (complex.of_real beta) := by rw [h0]
        unfold complex.of_real at hr; simp at hr; linarith
      rw [hM_eq_F_gt1 z hz_re1]
      exact hclear_F z hz0 hz_b (D_chi.ne_zero_re_gt_one chi hval z hz_re1)
  have hM_eq_F_gt_alpha : ∀ s : ℂ, alpha < complex.re s → s ≠ complex.of_real beta → D_chi chi s ≠ complex.zero → M_fn s = F_ana s
    intro s hs hsb hDz
    have hs0 : s ≠ complex.zero
      intro h0; have hr : complex.re s = complex.re complex.zero := by rw [h0]
      simp at hr; linarith
    have hsb_ne : complex.sub s (complex.of_real beta) ≠ complex.zero
      intro h0; apply hsb; apply complex.ext
      · have hr : complex.re (complex.sub s (complex.of_real beta)) = complex.re complex.zero := by rw [h0]
        unfold complex.of_real at hr ⊢; simp at hr ⊢; linarith
      · have hi : complex.im (complex.sub s (complex.of_real beta)) = complex.im complex.zero := by rw [h0]
        unfold complex.of_real at hi ⊢; simp at hi ⊢; linarith
    set P := complex.mul (complex.mul s (complex.sub s (complex.of_real beta))) (D_chi chi s) with hP
    have hP_ne : P ≠ complex.zero := by rw [hP]; exact complex.mul_ne_zero (complex.mul s (complex.sub s (complex.of_real beta))) (D_chi chi s) (complex.mul_ne_zero s (complex.sub s (complex.of_real beta)) hs0 hsb_ne) hDz
    have h1 := hglobal_id s hs
    have h2 := hclear_F s hs0 hsb hDz
    have heq : complex.mul P (M_fn s) = complex.mul P (F_ana s) := by rw [hP, h1, h2]
    have hcP := complex.mul_inv_cancel P hP_ne
    have h3 : complex.mul (complex.inv P) (complex.mul P (M_fn s)) = complex.mul (complex.inv P) (complex.mul P (F_ana s)) := by rw [heq]
    have hl : complex.mul (complex.inv P) (complex.mul P (M_fn s)) = complex.mul (complex.mul P (complex.inv P)) (M_fn s)
      apply complex.ext <;> simp <;> ring
    have hr : complex.mul (complex.inv P) (complex.mul P (F_ana s)) = complex.mul (complex.mul P (complex.inv P)) (F_ana s)
      apply complex.ext <;> simp <;> ring
    rw [hl, hr, hcP, complex.one_mul, complex.one_mul] at h3; exact h3
  have halpha_eq_sig0 : alpha = sigma0
    by_contra hne_a
    have hgt_a : sigma0 < alpha := by linarith
    have hD_alpha : D_chi chi (complex.of_real alpha) ≠ complex.zero := hD_gt_sig0 alpha hgt_a
    have halpha_ne_b : complex.of_real alpha ≠ complex.of_real beta
      intro h0; have hr : complex.re (complex.of_real alpha) = complex.re (complex.of_real beta) := by rw [h0]
      unfold complex.of_real at hr; simp at hr; linarith
    have hF_ana_a := hFana_ana (complex.of_real alpha) (by unfold complex.of_real; simp; linarith) halpha_ne_b hD_alpha
    unfold is_canalytic_at at hF_ana_a
    obtain ⟨aF, rF, hpsF⟩ := hF_ana_a
    set delta := min rF (alpha - sigma0) with hdel_def
    have hdel_pos : 0 < delta := by rw [hdel_def]; exact lt_min.real rF (alpha - sigma0) 0 hpsF.1 (by linarith)
    have hpsF_s := is_cpower_series_at.shrink F_ana (complex.of_real alpha) aF rF delta hpsF hdel_pos (by rw [hdel_def]; exact min_le_left.real rF (alpha - sigma0))
    set sigma1 := alpha + delta / 4 with hsig1
    set sigma2 := alpha - delta / 4 with hsig2
    set rho1 := (5 / 8) * delta with hrho1
    have hrho1_pos : 0 < rho1 := by rw [hrho1]; linarith
    have hdist_1 : complex.abs (complex.sub (complex.of_real sigma1) (complex.of_real alpha)) + rho1 < delta
      have hsub : complex.sub (complex.of_real sigma1) (complex.of_real alpha) = complex.of_real (delta / 4)
        rw [hsig1]; unfold complex.of_real; apply complex.ext <;> simp <;> ring
      rw [hsub, complex.abs_of_real_nonneg (delta / 4) (by linarith), hrho1]; linarith
    obtain ⟨b, hps_b⟩ := is_cpower_series_at.reexpand F_ana (complex.of_real alpha) (complex.of_real sigma1) aF delta rho1 hpsF_s hrho1_pos hdist_1
    obtain ⟨Mb, hMb_nn, hMb_maj⟩ := hps_b.2.1
    obtain ⟨sig', BM, hsig'_ge, hsig'_lt, hBM_nn, hBM⟩ := hgt_alpha_wit sigma1 (by rw [hsig1]; linarith)
    have hsig1_re : sig' < complex.re (complex.of_real sigma1) := by unfold complex.of_real; simp
    have hM_pack := mellin_H.power_series_of_bound chi c beta X0 sig' BM (complex.of_real sigma1) hX0_ge1 hBM_nn hsig1_re hH_nn (hBM_unfold sig' BM hBM)
    set aM := M_shift_coeff chi c beta X0 (complex.of_real sigma1) with haM
    have hps_M : is_cpower_series_at M_fn (complex.of_real sigma1) aM (complex.re (complex.of_real sigma1) - sig') := by rw [hMfn]; exact hM_pack.2.1
    have hD_sig1 : D_chi chi (complex.of_real sigma1) ≠ complex.zero := hD_gt_sig0 sigma1 (by rw [hsig1]; linarith)
    have hD_ana1 := D_chi.is_canalytic_at_re_pos chi hval (complex.of_real sigma1) (by unfold complex.of_real; simp; linarith)
    unfold is_canalytic_at at hD_ana1; obtain ⟨aD1, rD1, hpsD1⟩ := hD_ana1
    have hD1_pos : 0 < complex.abs (D_chi chi (complex.of_real sigma1))
      by_contra hle; exact hD_sig1 ((complex.abs_eq_zero (D_chi chi (complex.of_real sigma1))).mp (by linarith [complex.abs_nonneg (D_chi chi (complex.of_real sigma1))]))
    obtain ⟨dD, hdD_pos, hdD⟩ := is_cpower_series_at.continuous_at (D_chi chi) (complex.of_real sigma1) aD1 rD1 hpsD1 (complex.abs (D_chi chi (complex.of_real sigma1)) / 2) (by linarith)
    set r_eq := min (min (complex.re (complex.of_real sigma1) - sig') rho1) (min dD (delta / 8)) with hreq
    have hreq_pos : 0 < r_eq := by rw [hreq]; exact lt_min.real (min (complex.re (complex.of_real sigma1) - sig') rho1) (min dD (delta / 8)) 0 (lt_min.real (complex.re (complex.of_real sigma1) - sig') rho1 0 (by linarith) hrho1_pos) (lt_min.real dD (delta / 8) 0 hdD_pos (by linarith))
    have hps_Ms := is_cpower_series_at.shrink M_fn (complex.of_real sigma1) aM (complex.re (complex.of_real sigma1) - sig') r_eq hps_M hreq_pos (by rw [hreq]; linarith [min_le_left.real (min (complex.re (complex.of_real sigma1) - sig') rho1) (min dD (delta / 8)), min_le_left.real (complex.re (complex.of_real sigma1) - sig') rho1])
    have hps_bs := is_cpower_series_at.shrink F_ana (complex.of_real sigma1) b rho1 r_eq hps_b hreq_pos (by rw [hreq]; linarith [min_le_left.real (min (complex.re (complex.of_real sigma1) - sig') rho1) (min dD (delta / 8)), min_le_right.real (complex.re (complex.of_real sigma1) - sig') rho1])
    have hps_M_on_F : is_cpower_series_at F_ana (complex.of_real sigma1) aM r_eq
      apply is_cpower_series_at.congr M_fn F_ana (complex.of_real sigma1) aM r_eq hps_Ms
      intro z hz
      have hz_d8 : complex.abs (complex.sub z (complex.of_real sigma1)) < delta / 8 := by linarith [min_le_right.real (min (complex.re (complex.of_real sigma1) - sig') rho1) (min dD (delta / 8)), min_le_right.real dD (delta / 8)]
      have hz_dD : complex.abs (complex.sub z (complex.of_real sigma1)) < dD := by linarith [min_le_right.real (min (complex.re (complex.of_real sigma1) - sig') rho1) (min dD (delta / 8)), min_le_left.real dD (delta / 8)]
      have hz_re : alpha < complex.re z
        have h1 := complex.re_abs_le (complex.sub z (complex.of_real sigma1))
        have hsr : complex.re (complex.sub z (complex.of_real sigma1)) = complex.re z - sigma1 := by unfold complex.of_real; simp
        rw [hsr] at h1
        linarith [neg_le_abs.real (complex.re z - sigma1), hsig1]
      have hz_nb : z ≠ complex.of_real beta
        intro h0; have hr : complex.re z = complex.re (complex.of_real beta) := by rw [h0]
        unfold complex.of_real at hr; simp at hr; linarith
      have hDz_ne : D_chi chi z ≠ complex.zero
        intro h0; have h1 := hdD z hz_dD; rw [h0] at h1
        have hsub0 : complex.sub complex.zero (D_chi chi (complex.of_real sigma1)) = complex.neg (D_chi chi (complex.of_real sigma1))
          apply complex.ext <;> simp <;> ring
        rw [hsub0, complex.abs_neg] at h1; linarith
      exact hM_eq_F_gt_alpha z hz_re hz_nb hDz_ne
    have hcoeff_eq : ∀ k : ℕ, aM k = b k := is_cpower_series_at.coeff_unique F_ana (complex.of_real sigma1) aM b r_eq r_eq hps_M_on_F hps_bs
    set H0 := (fun (x : ℝ) => if X0 ≤ x then H x else 0) with hH0_fn
    have hsig2_mem : S_set sigma2
      rw [hSset]; constructor; rw [hsig2]; linarith [min_le_right.real rF (alpha - sigma0)]; constructor; rw [hsig2]; linarith
      use 5 * Mb; constructor; linarith
      intro B hXB
      have hcw2 : ∀ t : ℝ, X0 ≤ t → t ≤ B → continuous_at (fun x => rpow x (-sigma2 - 1)) t
        intro t h1 _; unfold rpow
        exact continuous_at.exp_comp (fun x => (-sigma2 - 1) * log x) t (continuous_at.mul (fun _ => -sigma2 - 1) log t (continuous_at.const (-sigma2 - 1) t) (continuous_at.log t (by linarith)))
      obtain ⟨I2, hI2⟩ := classical_H_mul.has_integral chi c beta (fun x => rpow x (-sigma2 - 1)) X0 B hX0_ge1 hXB hcw2
      use I2; constructor; rw [hH_unfold]; exact hI2
      have hglue : ∀ (w : ℝ → ℝ) (Iw : ℝ), darboux.has_integral (fun x => H x * w x) X0 B Iw → darboux.has_integral (fun x => H0 x * w x) 1 B Iw
        intro w Iw hIw
        have hleft : darboux.has_integral (fun x => H0 x * w x) 1 X0 0
          apply darboux.zero_interior (fun x => H0 x * w x) 1 X0 hX0_ge1
          intro x _ hx2; rw [hH0_fn]
          have hnot : ¬ (X0 ≤ x) := by linarith
          rw [if_neg hnot]; ring
        have hright : darboux.has_integral (fun x => H0 x * w x) X0 B Iw
          apply darboux.congr_interior (fun x => H x * w x) (fun x => H0 x * w x) X0 B Iw hIw
          intro x hx1 _; rw [hH0_fn]
          have hge : X0 ≤ x := by linarith
          rw [if_pos hge]
        have hadj := darboux.adjacent (fun x => H0 x * w x) 1 X0 B 0 Iw hleft hright
        have h0Iw : 0 + Iw = Iw := by ring
        rw [h0Iw] at hadj; exact hadj
      have hcw1 : ∀ t : ℝ, X0 ≤ t → t ≤ B → continuous_at (fun x => rpow x (-sigma1 - 1)) t
        intro t h1 _; unfold rpow
        exact continuous_at.exp_comp (fun x => (-sigma1 - 1) * log x) t (continuous_at.mul (fun _ => -sigma1 - 1) log t (continuous_at.const (-sigma1 - 1) t) (continuous_at.log t (by linarith)))
      obtain ⟨I1, hI1⟩ := classical_H_mul.has_integral chi c beta (fun x => rpow x (-sigma1 - 1)) X0 B hX0_ge1 hXB hcw1
      have hMk_ex : ∀ k : ℕ, ∃ Mk : ℝ, darboux.has_integral (fun x => H x * log x ^ k * rpow x (-sigma1 - 1)) X0 B Mk
        intro k
        obtain ⟨Mk, hMk⟩ := classical_H_mul.has_integral chi c beta (fun x => log x ^ k * rpow x (-sigma1 - 1)) X0 B hX0_ge1 hXB (by intro t h1 _; exact log_pow_rpow.continuous k sigma1 t (by linarith))
        have hfe : (fun x => (classical_G chi x + c * rpow x beta) * (log x ^ k * rpow x (-sigma1 - 1))) = (fun x => H x * log x ^ k * rpow x (-sigma1 - 1)) := by funext x; rw [hH_unfold]; ring
        rw [hfe] at hMk; exact ⟨Mk, hMk⟩
      set M_mom := (fun (k : ℕ) => choice (fun (Mk : ℝ) => darboux.has_integral (fun x => H x * log x ^ k * rpow x (-sigma1 - 1)) X0 B Mk)) with hMmom
      have hMmom_sp : ∀ k : ℕ, darboux.has_integral (fun x => H x * log x ^ k * rpow x (-sigma1 - 1)) X0 B (M_mom k)
        intro k; rw [hMmom]; exact choice.spec (fun (Mk : ℝ) => darboux.has_integral (fun x => H x * log x ^ k * rpow x (-sigma1 - 1)) X0 B Mk) (hMk_ex k)
      apply landau.mellin_reexpansion_bound H0 B sigma1 sigma2 I1 I2 (5 * Mb) M_mom (by linarith) (by rw [hsig1, hsig2]; linarith)
      · intro x _ _; rw [hH0_fn]
        by_cases hx : X0 ≤ x
        · rw [if_pos hx, hH_unfold]; exact hH_nn x hx
        · rw [if_neg hx]; linarith
      · exact hglue (fun x => rpow x (-sigma1 - 1)) I1 (by rw [hH_unfold]; exact hI1)
      · intro k
        have hmk_a : darboux.has_integral (fun x => H x * (log x ^ k * rpow x (-sigma1 - 1))) X0 B (M_mom k)
          have hfe : (fun x => H x * (log x ^ k * rpow x (-sigma1 - 1))) = (fun x => H x * log x ^ k * rpow x (-sigma1 - 1)) := by funext x; ring
          rw [hfe]; exact hMmom_sp k
        have h1 := hglue (fun x => log x ^ k * rpow x (-sigma1 - 1)) (M_mom k) hmk_a
        have hfe2 : (fun x => H0 x * (log x ^ k * rpow x (-sigma1 - 1))) = (fun x => H0 x * log x ^ k * rpow x (-sigma1 - 1)) := by funext x; ring
        rw [hfe2] at h1; exact h1
      · exact hglue (fun x => rpow x (-sigma2 - 1)) I2 (by rw [hH_unfold]; exact hI2)
      · intro K
        have hterm : ∀ k : ℕ, k < K → (((sigma1 - sigma2) ^ k) / ((fact k : ℕ) : ℝ)) * M_mom k ≤ Mb * (4 / 5) ^ k
          intro k _
          have hmom := hM_pack.2.2 (by unfold complex.of_real; simp) B k (M_mom k) hXB (by unfold complex.of_real; simp; rw [← hH_fn]; exact hMmom_sp k)
          rw [hcoeff_eq k] at hmom
          have hdiff : sigma1 - sigma2 = (4 / 5) * rho1 := by rw [hsig1, hsig2, hrho1]; linarith
          have hpow_mul : ∀ m : ℕ, ((4 / 5) * rho1) ^ m = (4 / 5) ^ m * rho1 ^ m
            intro m; induction m with j ihj
            · rw [pow_zero.real, pow_zero.real, pow_zero.real]; ring
            · rw [succ_eq_add_one.nat, pow_succ.real, pow_succ.real, pow_succ.real, ihj]; ring
          rw [hdiff]
          have hre1 : (((4 / 5) * rho1) ^ k / ((fact k : ℕ) : ℝ)) * M_mom k = (M_mom k / ((fact k : ℕ) : ℝ)) * ((4 / 5) * rho1) ^ k
            rw [div_def.real (((4 / 5) * rho1) ^ k) ((fact k : ℕ) : ℝ), div_def.real (M_mom k) ((fact k : ℕ) : ℝ)]; ring
          rw [hre1, hpow_mul k]
          have hm1 := mul_le_mul_of_nonneg_right.real (M_mom k / ((fact k : ℕ) : ℝ)) (complex.abs (b k)) ((4 / 5) ^ k * rho1 ^ k) hmom (mul_nonneg.real ((4 / 5) ^ k) (rho1 ^ k) (pow_nonneg.real (4 / 5) (by decide) k) (pow_nonneg.real rho1 (by linarith) k))
          have hm2 := mul_le_mul_of_nonneg_left.real (complex.abs (b k) * rho1 ^ k) Mb ((4 / 5) ^ k) (hMb_maj k) (pow_nonneg.real (4 / 5) (by decide) k)
          linarith
        have hsum := sum_le.real (fun k => (((sigma1 - sigma2) ^ k) / ((fact k : ℕ) : ℝ)) * M_mom k) (fun k => Mb * (4 / 5) ^ k) K hterm
        have hsc : ∀ P : ℕ, (∑ k < P, Mb * (4 / 5) ^ k) = Mb * (∑ k < P, (4 / 5) ^ k)
          intro P; induction P with p ihp
          · rw [sum_below_zero, sum_below_zero]; ring
          · rw [succ_eq_add_one.nat, sum_below_succ, sum_below_succ, ihp]; ring
        have hg := geom_sum_le_inv (4 / 5) (by decide) (by decide) K
        have hm := mul_le_mul_of_nonneg_left.real (∑ k < K, (4 / 5) ^ k) (1 / (1 - 4 / 5)) Mb hg hMb_nn
        have h5 : (1 : ℝ) / (1 - 4 / 5) = 5
          linarith
        rw [h5] at hm; linarith [hsc K]
    have hle_neg := is_sup.le_of_mem NegS neg_alpha (-sigma2) hneg_sup (by rw [hNegS]; have h1 : -(-sigma2) = sigma2 := by ring; rw [h1]; exact hsig2_mem)
    linarith [halpha_def, hsig2]
  constructor
  · intro s hs
    obtain ⟨sig', BM, _, hlt, hBM_nn, hBM⟩ := hgt_alpha_wit (complex.re s) (by rw [halpha_eq_sig0]; exact hs)
    rw [hMfn]
    exact mellin_H.abs_le_real chi c beta X0 sig' BM s hX0_ge1 hBM_nn hlt hH_nn (hBM_unfold sig' BM hBM)
  · intro s hs hsb hDz
    exact hM_eq_F_gt_alpha s (by rw [halpha_eq_sig0]; exact hs) hsb hDz

-- Step 5: Rule out sigma0 > beta by contradiction (Re F_ana(sigma0 + eps/2) < 0)!
+ landau_shift.sigma0_eq_beta (chi : DChar) (hval : dchar.valid chi) (c beta sigma0 X0 : ℝ)
    (hX0 : 1 ≤ X0) (hc : 0 < c) (hbeta_pos : 0 < beta) (hsig0_ge : beta ≤ sigma0)
    (hD_gt_sig0 : ∀ t : ℝ, sigma0 < t → D_chi chi (complex.of_real t) ≠ complex.zero)
    (hD_at_sig0 : beta < sigma0 → D_chi chi (complex.of_real sigma0) = complex.zero)
    (hdom : ∀ s : ℂ, sigma0 < complex.re s → complex.abs (M_shift chi c beta X0 s) ≤ complex.re (M_shift chi c beta X0 (complex.of_real (complex.re s))))
    (hMeqF : ∀ s : ℂ, sigma0 < complex.re s → s ≠ complex.of_real beta → D_chi chi s ≠ complex.zero → M_shift chi c beta X0 s = F_ana_shift chi c beta X0 s) :
    sigma0 = beta
  by_contra hne_sb
  have hgt_sb : beta < sigma0 := by linarith
  have hD_z := hD_at_sig0 hgt_sb
  obtain ⟨m_tot, del1, M1, _, hm_half, hdel1, hM1, hdec1⟩ := N_base_div_zD.pole_decomp chi hval (complex.of_real sigma0) (by unfold complex.of_real; simp; linarith)
  have hm_ge : 1 / 2 ≤ m_tot := hm_half hD_z
  have hE_ana := (landau_shift.analytic_and_clear chi hval c beta X0 hX0).1 (complex.of_real sigma0)
  unfold is_canalytic_at at hE_ana; obtain ⟨aE, rE, hpsE⟩ := hE_ana
  obtain ⟨dE, hdE_pos, hdE⟩ := is_cpower_series_at.continuous_at (E_fin_shift chi X0) (complex.of_real sigma0) aE rE hpsE 1 (by decide)
  set ME := complex.abs (E_fin_shift chi X0 (complex.of_real sigma0)) + 1 with hME
  set B_tot := c / (sigma0 - beta) + M1 + ME + 1 with hBtot
  have hBtot_pos : 0 < B_tot := by rw [hBtot, hME]; linarith [div_pos.real c (sigma0 - beta) hc (by linarith), complex.abs_nonneg (E_fin_shift chi X0 (complex.of_real sigma0))]
  have h4sB_pos : 0 < 4 * sigma0 * B_tot := mul_pos.real (4 * sigma0) B_tot (by linarith) hBtot_pos
  set eps := min (min del1 dE) (1 / (4 * sigma0 * B_tot)) with heps
  have heps_pos : 0 < eps := by rw [heps]; exact lt_min.real (min del1 dE) (1 / (4 * sigma0 * B_tot)) 0 (lt_min.real del1 dE 0 hdel1 hdE_pos) (one_div_pos.real (4 * sigma0 * B_tot) h4sB_pos)
  set sig := sigma0 + eps / 2 with hsig_def
  have hsig_gt : sigma0 < sig := by rw [hsig_def]; linarith
  have hsig_dist : complex.abs (complex.sub (complex.of_real sig) (complex.of_real sigma0)) = eps / 2
    have hsub : complex.sub (complex.of_real sig) (complex.of_real sigma0) = complex.of_real (eps / 2)
      rw [hsig_def]; unfold complex.of_real; apply complex.ext <;> simp <;> ring
    rw [hsub, complex.abs_of_real_nonneg (eps / 2) (by linarith)]
  have hsig_ne0 : complex.of_real sig ≠ complex.of_real sigma0
    intro h0; have hr : complex.re (complex.of_real sig) = complex.re (complex.of_real sigma0) := by rw [h0]
    unfold complex.of_real at hr; simp at hr; linarith
  have hsig_nb : complex.of_real sig ≠ complex.of_real beta
    intro h0; have hr : complex.re (complex.of_real sig) = complex.re (complex.of_real beta) := by rw [h0]
    unfold complex.of_real at hr; simp at hr; linarith
  have hM_nn : 0 ≤ complex.re (M_shift chi c beta X0 (complex.of_real sig))
    have hd := hdom (complex.of_real sig) (by unfold complex.of_real; simp)
    have hre_sig : complex.re (complex.of_real sig) = sig := by unfold complex.of_real; simp
    rw [hre_sig] at hd
    linarith [complex.abs_nonneg (M_shift chi c beta X0 (complex.of_real sig))]
  have hMF := hMeqF (complex.of_real sig) (by unfold complex.of_real; simp) hsig_nb (hD_gt_sig0 sig hsig_gt)
  rw [hMF] at hM_nn
  have hdec_all := hdec1 (complex.of_real sig) hsig_ne0 (by rw [hsig_dist]; linarith [min_le_left.real (min del1 dE) (1 / (4 * sigma0 * B_tot)), min_le_left.real del1 dE])
  have hdec := hdec_all.2.2
  have hE_b : complex.abs (E_fin_shift chi X0 (complex.of_real sig)) ≤ ME
    have h1 := hdE (complex.of_real sig) (by rw [hsig_dist]; linarith [min_le_left.real (min del1 dE) (1 / (4 * sigma0 * B_tot)), min_le_right.real del1 dE])
    have ht := complex.abs_sub_abs_le (E_fin_shift chi X0 (complex.of_real sig)) (E_fin_shift chi X0 (complex.of_real sigma0))
    rw [hME]; linarith
  have hre_E : -complex.re (E_fin_shift chi X0 (complex.of_real sig)) ≤ ME
    have h1 := complex.re_abs_le (E_fin_shift chi X0 (complex.of_real sig))
    linarith [neg_le_abs.real (complex.re (E_fin_shift chi X0 (complex.of_real sig)))]
  have hre_t1 : complex.re (complex.mul (complex.smul c (cpow_real X0 (complex.sub (complex.of_real beta) (complex.of_real sig)))) (complex.inv (complex.sub (complex.of_real sig) (complex.of_real beta)))) ≤ c / (sigma0 - beta)
    have hcp_r : cpow_real X0 (complex.sub (complex.of_real beta) (complex.of_real sig)) = complex.of_real (rpow X0 (beta - sig))
      unfold cpow_real rpow complex.of_real; apply complex.ext
      · simp [cos_zero]
        have h1 : log X0 * (beta - sig) = (beta - sig) * log X0 := by ring
        rw [h1]
      · simp [sin_zero]
    have hsub_r : complex.sub (complex.of_real sig) (complex.of_real beta) = complex.of_real (sig - beta)
      unfold complex.of_real; apply complex.ext <;> simp <;> ring
    rw [hcp_r, hsub_r, complex.inv_of_real (sig - beta) (by linarith)]
    unfold complex.of_real; simp
    have hrp_le1 : rpow X0 (beta - sig) ≤ 1 := rpow.neg_le_one X0 (beta - sig) hX0 (by linarith)
    have hinv_le : 1 / (sig - beta) ≤ 1 / (sigma0 - beta)
      have h1 := mul_le_mul_of_nonneg_left.real (sigma0 - beta) (sig - beta) (1 / (sig - beta)) (by linarith) (by linarith [one_div_pos.real (sig - beta) (by linarith)])
      have hc1 := mul_inv_cancel.real (sig - beta) (by linarith)
      exact (le_div_iff.real (1 / (sig - beta)) 1 (sigma0 - beta) (by linarith)).mpr (by linarith)
    have hm1 := mul_le_mul_of_nonneg_left.real (rpow X0 (beta - sig)) 1 c hrp_le1 (by linarith)
    have hm2 := mul_le_mul_of_nonneg_right.real (c * rpow X0 (beta - sig)) c (1 / (sig - beta)) (by linarith) (by linarith [one_div_pos.real (sig - beta) (by linarith)])
    have hm3 := mul_le_mul_of_nonneg_left.real (1 / (sig - beta)) (1 / (sigma0 - beta)) c hinv_le (by linarith)
    rw [div_def.real c (sigma0 - beta)]; linarith
  have hse_pos : 0 < sigma0 * (eps / 2) := mul_pos.real sigma0 (eps / 2) (by linarith) (by linarith)
  have hre_t2 : complex.re (complex.mul (N_base chi (complex.of_real sig)) (complex.inv (complex.mul (complex.of_real sig) (D_chi chi (complex.of_real sig))))) ≤ -(m_tot / (sigma0 * (eps / 2))) + M1
    have hpole_r : complex.neg (complex.mul (complex.of_real m_tot) (complex.inv (complex.mul (complex.of_real sigma0) (complex.sub (complex.of_real sig) (complex.of_real sigma0))))) = complex.of_real (-(m_tot / (sigma0 * (eps / 2))))
      have hprod : complex.mul (complex.of_real sigma0) (complex.sub (complex.of_real sig) (complex.of_real sigma0)) = complex.of_real (sigma0 * (eps / 2))
        rw [hsig_def]; unfold complex.of_real; apply complex.ext <;> simp <;> ring
      rw [hprod, complex.inv_of_real (sigma0 * (eps / 2)) (by linarith), div_def.real m_tot (sigma0 * (eps / 2))]
      unfold complex.of_real; apply complex.ext <;> simp <;> ring
    rw [hpole_r] at hdec
    have h1 := complex.re_abs_le (complex.sub (complex.mul (N_base chi (complex.of_real sig)) (complex.inv (complex.mul (complex.of_real sig) (D_chi chi (complex.of_real sig))))) (complex.of_real (-(m_tot / (sigma0 * (eps / 2))))))
    have hsr : ∀ (w : ℂ) (r : ℝ), complex.re (complex.sub w (complex.of_real r)) = complex.re w - r := by intro w r; unfold complex.of_real; simp
    rw [hsr] at h1
    linarith [le_abs_self.real (complex.re (complex.mul (N_base chi (complex.of_real sig)) (complex.inv (complex.mul (complex.of_real sig) (D_chi chi (complex.of_real sig))))) - -(m_tot / (sigma0 * (eps / 2))))]
  have hF_re : complex.re (F_ana_shift chi c beta X0 (complex.of_real sig)) ≤ B_tot - m_tot / (sigma0 * (eps / 2))
    have hre_sa : ∀ (a b d : ℂ), complex.re (complex.sub (complex.add a b) d) = complex.re a + complex.re b - complex.re d := by intro a b d; simp
    unfold F_ana_shift; rw [hre_sa, hBtot]; linarith
  have heps_le : eps ≤ 1 / (4 * sigma0 * B_tot) := by rw [heps]; exact min_le_right.real (min del1 dE) (1 / (4 * sigma0 * B_tot))
  have hprod_le : eps * (4 * sigma0 * B_tot) ≤ 1 := (le_div_iff.real eps 1 (4 * sigma0 * B_tot) h4sB_pos).mp heps_le
  have hmtot_gt : B_tot < m_tot / (sigma0 * (eps / 2)) := by exact (lt_div_iff.real B_tot m_tot (sigma0 * (eps / 2)) hse_pos).mpr (by linarith)
  linarith

-- Step 6: Pole & dominance bounds for F_ana_shift around rho = beta + i*gamma (Clauses 1, 2, 3)!
+ landau_shift.pole_bounds (chi : DChar) (hval : dchar.valid chi) (rho : ℂ) (c X0 : ℝ)
    (hX0 : 1 ≤ X0) (hc : 0 < c) (hbeta_half : 1 / 2 < complex.re rho)
    (hD_rho : D_chi chi rho = complex.zero)
    (hD_gt_beta : ∀ t : ℝ, complex.re rho < t → D_chi chi (complex.of_real t) ≠ complex.zero)
    (hdom : ∀ s : ℂ, complex.re rho < complex.re s → complex.abs (M_shift chi c (complex.re rho) X0 s) ≤ complex.re (M_shift chi c (complex.re rho) X0 (complex.of_real (complex.re s))))
    (hMeqF : ∀ s : ℂ, complex.re rho < complex.re s → s ≠ complex.of_real (complex.re rho) → D_chi chi s ≠ complex.zero → M_shift chi c (complex.re rho) X0 s = F_ana_shift chi c (complex.re rho) X0 s) :
    ∃ delta : ℝ, 0 < delta ∧
      (∀ sigma, complex.re rho < sigma → sigma < complex.re rho + delta → complex.abs (F_ana_shift chi c (complex.re rho) X0 (complex.mk sigma (complex.im rho))) ≤ complex.re (F_ana_shift chi c (complex.re rho) X0 (complex.of_real sigma))) ∧
      (complex.im rho = 0 → ∀ sigma, complex.re rho < sigma → sigma < complex.re rho + delta → (sigma - complex.re rho) * complex.re (F_ana_shift chi c (complex.re rho) X0 (complex.of_real sigma)) ≤ c - (3 / 4) * (1 / (2 * complex.abs rho))) ∧
      (complex.im rho ≠ 0 → ∀ sigma, complex.re rho < sigma → sigma < complex.re rho + delta → (3 / 4) * (1 / (2 * complex.abs rho)) ≤ (sigma - complex.re rho) * complex.abs (F_ana_shift chi c (complex.re rho) X0 (complex.mk sigma (complex.im rho))) ∧ (sigma - complex.re rho) * complex.re (F_ana_shift chi c (complex.re rho) X0 (complex.of_real sigma)) ≤ c + (1 / 8) * (1 / (2 * complex.abs rho)))
  set beta := complex.re rho with hbeta_def
  set gamma := complex.im rho with hgamma_def
  set F_ana := F_ana_shift chi c beta X0 with hFana
  have hrho_ne0 : rho ≠ complex.zero
    intro h0; have hr : complex.re rho = complex.re complex.zero := by rw [h0]
    simp at hr; linarith
  have hrho_abs_pos : 0 < complex.abs rho := by by_contra hle; exact hrho_ne0 ((complex.abs_eq_zero rho).mp (by linarith [complex.abs_nonneg rho]))
  set r0 := 1 / (2 * complex.abs rho) with hr0_def
  have hr0_pos : 0 < r0 := by rw [hr0_def]; exact one_div_pos.real (2 * complex.abs rho) (by linarith)
  obtain ⟨mb, del_b, Mb_ld, hmb_nn, hmb_z, hdel_b, hMb_ld, hdec_b⟩ := N_base_div_zD.pole_decomp chi hval (complex.of_real beta) (by unfold complex.of_real; simp; linarith)
  obtain ⟨mr, del_r, Mr_ld, hmr_nn, hmr_z, hdel_r, hMr_ld, hdec_r⟩ := N_base_div_zD.pole_decomp chi hval rho (by linarith)
  have hmr_ge : 1 / 2 ≤ mr := hmr_z hD_rho
  have hEfin_ana := (landau_shift.analytic_and_clear chi hval c beta X0 hX0).1
  have hEb_a := hEfin_ana (complex.of_real beta)
  unfold is_canalytic_at at hEb_a; obtain ⟨aEb, rEb, hpsEb⟩ := hEb_a
  obtain ⟨dEb, hdEb_pos, hdEb⟩ := is_cpower_series_at.continuous_at (E_fin_shift chi X0) (complex.of_real beta) aEb rEb hpsEb 1 (by decide)
  have hEr_a := hEfin_ana rho
  unfold is_canalytic_at at hEr_a; obtain ⟨aEr, rEr, hpsEr⟩ := hEr_a
  obtain ⟨dEr, hdEr_pos, hdEr⟩ := is_cpower_series_at.continuous_at (E_fin_shift chi X0) rho aEr rEr hpsEr 1 (by decide)
  set ME_b := complex.abs (E_fin_shift chi X0 (complex.of_real beta)) + 1 with hMEb
  set ME_r := complex.abs (E_fin_shift chi X0 rho) + 1 with hMEr
  set K_real := Mb_ld + ME_b + 1 with hKreal
