      exact (div_lt_iff.real B0 e ((N + 1 : ℕ) : ℝ) ((cast_pos.real (N + 1)).mpr (by omega))).mpr (by linarith)
    have hle_B0 : M0 * exp (2 * log X0) ≤ B0 := by rw [hB0]; linarith
    have hm2 := mul_le_mul_of_nonneg_right.real (M0 * exp (2 * log X0)) B0 (1 / ((N + 1 : ℕ) : ℝ)) hle_B0 (by linarith [one_div_pos.real ((N + 1 : ℕ) : ℝ) ((cast_pos.real (N + 1)).mpr (by omega))])
    rw [div_def.real (exp (2 * log X0)) ((N + 1 : ℕ) : ℝ)] at hm
    rw [div_def.real B0 ((N + 1 : ℕ) : ℝ)] at hlt_e
    linarith

-- ====================================================================================
-- 2. EXACT ABEL SUMMATION ON Re(s) > 1: MELLIN TRANSFORM OF `classical_G chi`
-- ====================================================================================

-- Exact finite Abel identity for psi_chi on [1, N + 1] (for ALL N >= 0 and ALL s != 0):
--   int_1^(N + 1) psi_chi(x) * x^(-s - 1) dx
--     = (1 / s) * sum_{n < N} of_real(psi_chi_coeff chi (n + 1)) * (n + 1)^(-s)
--       - (1 / s) * of_real(psi_chi_seq chi N) * (N + 1)^(-s)
+ classical_psi_chi.abel_finite (chi : DChar) (s : ℂ) (hs0 : s ≠ complex.zero) (N : ℕ) :
    c_has_integral (fun x => complex.mul (complex.of_real (classical_psi_chi chi x)) (cpow_real x (complex.neg (complex.add s complex.one)))) 1 ((N + 1 : ℕ) : ℝ) (complex.mul (complex.inv s) (complex.sub (csum N (fun n => complex.mul (complex.of_real (psi_chi_coeff chi (n + 1))) (cpow_real ((n + 1 : ℕ) : ℝ) (complex.neg s)))) (complex.mul (complex.of_real (psi_chi_seq chi N)) (cpow_real ((N + 1 : ℕ) : ℝ) (complex.neg s)))))
  induction N with m ihm
  · have h1 : ((0 + 1 : ℕ) : ℝ) = 1 := by simp
    rw [h1, csum.zero, psi_chi_seq.zero]
    have hv : complex.mul (complex.inv s) (complex.sub complex.zero (complex.mul (complex.of_real 0) (cpow_real 1 (complex.neg s)))) = complex.zero := by ring
    rw [hv]; unfold c_has_integral
    have hr0 : complex.re complex.zero = 0 := by simp
    have hi0 : complex.im complex.zero = 0 := by simp
    rw [hr0, hi0]
    constructor
    · exact darboux.point (fun x => complex.re (complex.mul (complex.of_real (classical_psi_chi chi x)) (cpow_real x (complex.neg (complex.add s complex.one))))) 1
    · exact darboux.point (fun x => complex.im (complex.mul (complex.of_real (classical_psi_chi chi x)) (cpow_real x (complex.neg (complex.add s complex.one))))) 1
  · rw [succ_eq_add_one.nat]
    have hstep_ne : complex.add s complex.one ≠ complex.one
      intro h1; apply hs0
      apply complex.ext
      · have hr : complex.re (complex.add s complex.one) = complex.re complex.one := by rw [h1]
        simp at hr ⊢; linarith
      · have hi : complex.im (complex.add s complex.one) = complex.im complex.one := by rw [h1]
        simp at hi ⊢
    have hpow := zeta.complex_power_integral (complex.add s complex.one) ((m + 1 : ℕ) : ℝ) ((m + 2 : ℕ) : ℝ) ((cast_pos.real (m + 1)).mpr (by omega)) ((cast_le.real (m + 1) (m + 2)).mpr (by omega)) hstep_ne
    have hsub1 : complex.sub complex.one (complex.add s complex.one) = complex.neg s := by ring
    rw [hsub1] at hpow
    have hinv_neg : complex.inv (complex.neg s) = complex.neg (complex.inv s)
      have hc := complex.mul_inv_cancel s hs0
      have hneg_ne : complex.neg s ≠ complex.zero
        intro h0; apply hs0; apply complex.ext
        · have hr : complex.re (complex.neg s) = complex.re complex.zero := by rw [h0]
          simp at hr ⊢; linarith
        · have hi : complex.im (complex.neg s) = complex.im complex.zero := by rw [h0]
          simp at hi ⊢; linarith
      have hc2 := complex.mul_inv_cancel (complex.neg s) hneg_ne
      have h1 : complex.mul (complex.neg s) (complex.neg (complex.inv s)) = complex.one
        have hre : complex.mul (complex.neg s) (complex.neg (complex.inv s)) = complex.mul s (complex.inv s)
          apply complex.ext <;> simp <;> ring
        rw [hre, hc]
      have h2 : complex.mul (complex.inv (complex.neg s)) (complex.mul (complex.neg s) (complex.neg (complex.inv s))) = complex.mul (complex.inv (complex.neg s)) complex.one := by rw [h1]
      have h3 : complex.mul (complex.inv (complex.neg s)) (complex.mul (complex.neg s) (complex.neg (complex.inv s))) = complex.mul (complex.mul (complex.neg s) (complex.inv (complex.neg s))) (complex.neg (complex.inv s))
        apply complex.ext <;> simp <;> ring
      rw [h3, hc2, complex.one_mul, complex.mul_one] at h2; exact h2.symm
    rw [hinv_neg] at hpow
    have hsc := c_has_integral.scale_complex (fun x => cpow_real x (complex.neg (complex.add s complex.one))) ((m + 1 : ℕ) : ℝ) ((m + 2 : ℕ) : ℝ) (complex.of_real (psi_chi_seq chi (m + 1))) (complex.mul (complex.neg (complex.inv s)) (complex.sub (cpow_real ((m + 2 : ℕ) : ℝ) (complex.neg s)) (cpow_real ((m + 1 : ℕ) : ℝ) (complex.neg s)))) hpow
    have hunit : c_has_integral (fun x => complex.mul (complex.of_real (classical_psi_chi chi x)) (cpow_real x (complex.neg (complex.add s complex.one)))) ((m + 1 : ℕ) : ℝ) ((m + 2 : ℕ) : ℝ) (complex.mul (complex.of_real (psi_chi_seq chi (m + 1))) (complex.mul (complex.neg (complex.inv s)) (complex.sub (cpow_real ((m + 2 : ℕ) : ℝ) (complex.neg s)) (cpow_real ((m + 1 : ℕ) : ℝ) (complex.neg s)))))
      apply c_has_integral.congr_interior (fun x => complex.mul (complex.of_real (psi_chi_seq chi (m + 1))) (cpow_real x (complex.neg (complex.add s complex.one)))) (fun x => complex.mul (complex.of_real (classical_psi_chi chi x)) (cpow_real x (complex.neg (complex.add s complex.one)))) ((m + 1 : ℕ) : ℝ) ((m + 2 : ℕ) : ℝ) (complex.mul (complex.of_real (psi_chi_seq chi (m + 1))) (complex.mul (complex.neg (complex.inv s)) (complex.sub (cpow_real ((m + 2 : ℕ) : ℝ) (complex.neg s)) (cpow_real ((m + 1 : ℕ) : ℝ) (complex.neg s))))) hsc
      intro x hx1 hx2
      unfold classical_psi_chi
      have hm2 : m + 1 + 1 = m + 2 := by omega
      have hfx : nat_floor x = m + 1 := nat_floor.eq_of_bounds (m + 1) x (by linarith) (by rw [hm2]; exact hx2)
      rw [hfx]
    have hadj := c_has_integral.adjacent (fun x => complex.mul (complex.of_real (classical_psi_chi chi x)) (cpow_real x (complex.neg (complex.add s complex.one)))) 1 ((m + 1 : ℕ) : ℝ) ((m + 2 : ℕ) : ℝ) (complex.mul (complex.inv s) (complex.sub (csum m (fun n => complex.mul (complex.of_real (psi_chi_coeff chi (n + 1))) (cpow_real ((n + 1 : ℕ) : ℝ) (complex.neg s)))) (complex.mul (complex.of_real (psi_chi_seq chi m)) (cpow_real ((m + 1 : ℕ) : ℝ) (complex.neg s))))) (complex.mul (complex.of_real (psi_chi_seq chi (m + 1))) (complex.mul (complex.neg (complex.inv s)) (complex.sub (cpow_real ((m + 2 : ℕ) : ℝ) (complex.neg s)) (cpow_real ((m + 1 : ℕ) : ℝ) (complex.neg s))))) ihm hunit
    have hm2 : m + 1 + 1 = m + 2 := by omega
    rw [hm2]
    have hval : complex.add (complex.mul (complex.inv s) (complex.sub (csum m (fun n => complex.mul (complex.of_real (psi_chi_coeff chi (n + 1))) (cpow_real ((n + 1 : ℕ) : ℝ) (complex.neg s)))) (complex.mul (complex.of_real (psi_chi_seq chi m)) (cpow_real ((m + 1 : ℕ) : ℝ) (complex.neg s))))) (complex.mul (complex.of_real (psi_chi_seq chi (m + 1))) (complex.mul (complex.neg (complex.inv s)) (complex.sub (cpow_real ((m + 2 : ℕ) : ℝ) (complex.neg s)) (cpow_real ((m + 1 : ℕ) : ℝ) (complex.neg s))))) = complex.mul (complex.inv s) (complex.sub (csum (m + 1) (fun n => complex.mul (complex.of_real (psi_chi_coeff chi (n + 1))) (cpow_real ((n + 1 : ℕ) : ℝ) (complex.neg s)))) (complex.mul (complex.of_real (psi_chi_seq chi (m + 1))) (cpow_real ((m + 2 : ℕ) : ℝ) (complex.neg s))))
      rw [csum.succ, psi_chi_seq.succ chi m]; unfold complex.of_real; apply complex.ext <;> simp <;> ring
    rw [hval] at hadj; exact hadj

-- Meromorphic base limit on Re(s) > 1:
-> Phi_chi (chi : DChar) (s : ℂ) : ℂ :=
  if dchar.is_trivial chi then
    vm_dseries dchar.trivial_one s
  else
    complex.add (vm_dseries dchar.trivial_one s) (complex.smul (1 / 2) (complex.add (vm_dseries chi s) (vm_dseries (dchar.inv chi) s)))

-> G_mellin_mer (chi : DChar) (s : ℂ) : ℂ :=
  complex.sub (complex.mul (complex.inv s) (Phi_chi chi s)) (complex.inv (complex.sub s complex.one))

+ classical_G.mellin_limit_re_gt_one (chi : DChar) (hval : dchar.valid chi) (s : ℂ) (hs : 1 < complex.re s) :
    ctends_to (fun (N : ℕ) => cint (fun x => complex.mul (complex.of_real (classical_G chi x)) (cpow_real x (complex.neg (complex.add s complex.one)))) 1 ((N + 1 : ℕ) : ℝ)) (G_mellin_mer chi s)
  have hs0 : s ≠ complex.zero
    intro h0; have hr : complex.re s = complex.re complex.zero := by rw [h0]
    simp at hr; linarith
  have hs1 : s ≠ complex.one
    intro h1; have hr : complex.re s = complex.re complex.one := by rw [h1]
    simp at hr; linarith
  -- Exact formula for cint G(x) x^(-s-1) on [1, N + 1]:
  have hfin : ∀ N : ℕ, cint (fun x => complex.mul (complex.of_real (classical_G chi x)) (cpow_real x (complex.neg (complex.add s complex.one)))) 1 ((N + 1 : ℕ) : ℝ) = complex.sub (complex.mul (complex.inv s) (complex.sub (csum N (fun n => complex.mul (complex.of_real (psi_chi_coeff chi (n + 1))) (cpow_real ((n + 1 : ℕ) : ℝ) (complex.neg s)))) (complex.mul (complex.of_real (psi_chi_seq chi N)) (cpow_real ((N + 1 : ℕ) : ℝ) (complex.neg s))))) (complex.mul (complex.inv (complex.sub s complex.one)) (complex.sub complex.one (cpow_real ((N + 1 : ℕ) : ℝ) (complex.sub complex.one s))))
    intro N
    have hpsi := classical_psi_chi.abel_finite chi s hs0 N
    have hlin := zeta.complex_power_integral s 1 ((N + 1 : ℕ) : ℝ) (by decide) ((cast_le.real 1 (N + 1)).mpr (by omega)) hs1
    have hcp1 : cpow_real 1 (complex.sub complex.one s) = complex.one
      unfold cpow_real; rw [log_one]
      have h0 : complex.smul 0 (complex.sub complex.one s) = complex.zero
        apply complex.ext <;> simp
      rw [h0]; apply complex.ext
      · simp [exp_zero, cos_zero]
      · simp [sin_zero]
    rw [hcp1, complex.inv_sub_swap s hs1] at hlin
    have hlin_val : complex.mul (complex.neg (complex.inv (complex.sub s complex.one))) (complex.sub (cpow_real ((N + 1 : ℕ) : ℝ) (complex.sub complex.one s)) complex.one) = complex.mul (complex.inv (complex.sub s complex.one)) (complex.sub complex.one (cpow_real ((N + 1 : ℕ) : ℝ) (complex.sub complex.one s)))
      apply complex.ext <;> simp <;> ring
    rw [hlin_val] at hlin
    have hlin_x : c_has_integral (fun x => complex.mul (complex.of_real x) (cpow_real x (complex.neg (complex.add s complex.one)))) 1 ((N + 1 : ℕ) : ℝ) (complex.mul (complex.inv (complex.sub s complex.one)) (complex.sub complex.one (cpow_real ((N + 1 : ℕ) : ℝ) (complex.sub complex.one s))))
      apply c_has_integral.congr (fun x => cpow_real x (complex.neg s)) (fun x => complex.mul (complex.of_real x) (cpow_real x (complex.neg (complex.add s complex.one)))) 1 ((N + 1 : ℕ) : ℝ) (complex.mul (complex.inv (complex.sub s complex.one)) (complex.sub complex.one (cpow_real ((N + 1 : ℕ) : ℝ) (complex.sub complex.one s)))) hlin
      intro x hx1 _
      have hx_cp : complex.of_real x = cpow_real x complex.one
        unfold cpow_real complex.of_real
        have h1 : complex.smul (log x) complex.one = complex.of_real (log x)
          unfold complex.of_real; apply complex.ext <;> simp <;> ring
        rw [h1]; unfold complex.of_real; apply complex.ext
        · simp [cos_zero, exp_log x (by linarith)]
        · simp [sin_zero]
      rw [hx_cp, ← cpow_real.add_exp]
      have harg : complex.add complex.one (complex.neg (complex.add s complex.one)) = complex.neg s
        apply complex.ext <;> simp <;> ring
      rw [harg]
    set V_G := complex.sub (complex.mul (complex.inv s) (complex.sub (csum N (fun n => complex.mul (complex.of_real (psi_chi_coeff chi (n + 1))) (cpow_real ((n + 1 : ℕ) : ℝ) (complex.neg s)))) (complex.mul (complex.of_real (psi_chi_seq chi N)) (cpow_real ((N + 1 : ℕ) : ℝ) (complex.neg s))))) (complex.mul (complex.inv (complex.sub s complex.one)) (complex.sub complex.one (cpow_real ((N + 1 : ℕ) : ℝ) (complex.sub complex.one s)))) with hVG
    have hsub := c_has_integral.sub (fun x => complex.mul (complex.of_real (classical_psi_chi chi x)) (cpow_real x (complex.neg (complex.add s complex.one)))) (fun x => complex.mul (complex.of_real x) (cpow_real x (complex.neg (complex.add s complex.one)))) 1 ((N + 1 : ℕ) : ℝ) (complex.mul (complex.inv s) (complex.sub (csum N (fun n => complex.mul (complex.of_real (psi_chi_coeff chi (n + 1))) (cpow_real ((n + 1 : ℕ) : ℝ) (complex.neg s)))) (complex.mul (complex.of_real (psi_chi_seq chi N)) (cpow_real ((N + 1 : ℕ) : ℝ) (complex.neg s))))) (complex.mul (complex.inv (complex.sub s complex.one)) (complex.sub complex.one (cpow_real ((N + 1 : ℕ) : ℝ) (complex.sub complex.one s)))) hpsi hlin_x
    have hpt_G : ∀ x : ℝ, 1 ≤ x → x ≤ ((N + 1 : ℕ) : ℝ) → complex.sub (complex.mul (complex.of_real (classical_psi_chi chi x)) (cpow_real x (complex.neg (complex.add s complex.one)))) (complex.mul (complex.of_real x) (cpow_real x (complex.neg (complex.add s complex.one)))) = complex.mul (complex.of_real (classical_G chi x)) (cpow_real x (complex.neg (complex.add s complex.one)))
      intro x _ _; unfold classical_G complex.of_real; apply complex.ext <;> simp <;> ring
    have hcon := c_has_integral.congr (fun x => complex.sub (complex.mul (complex.of_real (classical_psi_chi chi x)) (cpow_real x (complex.neg (complex.add s complex.one)))) (complex.mul (complex.of_real x) (cpow_real x (complex.neg (complex.add s complex.one))))) (fun x => complex.mul (complex.of_real (classical_G chi x)) (cpow_real x (complex.neg (complex.add s complex.one)))) 1 ((N + 1 : ℕ) : ℝ) V_G (by rw [hVG]; exact hsub) hpt_G
    exact cint.eq_of_has_integral (fun x => complex.mul (complex.of_real (classical_G chi x)) (cpow_real x (complex.neg (complex.add s complex.one)))) 1 ((N + 1 : ℕ) : ℝ) V_G hcon
  -- Step 1: csum N (a_chi(n+1) * (n+1)^(-s)) -> Phi_chi chi s!
  have hsum_lim : ctends_to (fun (N : ℕ) => csum N (fun n => complex.mul (complex.of_real (psi_chi_coeff chi (n + 1))) (cpow_real ((n + 1 : ℕ) : ℝ) (complex.neg s)))) (Phi_chi chi s)
    unfold Phi_chi
    by_cases ht : dchar.is_trivial chi
    · rw [if_pos ht]
      have hfe : (fun (N : ℕ) => csum N (fun n => complex.mul (complex.of_real (psi_chi_coeff chi (n + 1))) (cpow_real ((n + 1 : ℕ) : ℝ) (complex.neg s)))) = (fun (N : ℕ) => csum N (vm_dseries_term dchar.trivial_one s))
        funext N; apply csum.congr; intro n _
        rw [psi_chi_coeff.complex_decomp chi (n + 1), if_pos ht]; unfold vm_dseries_term; trivial
      rw [hfe]; exact vm_dseries.tends_to dchar.trivial_one dchar.trivial_one_valid s hs
    · rw [if_neg ht]
      have h0 := vm_dseries.tends_to dchar.trivial_one dchar.trivial_one_valid s hs
      have h1 := vm_dseries.tends_to chi hval s hs
      have h2 := vm_dseries.tends_to (dchar.inv chi) (dchar.inv_valid chi hval) s hs
      have h12 := ctends_to.add (fun N => csum N (vm_dseries_term chi s)) (fun N => csum N (vm_dseries_term (dchar.inv chi) s)) (vm_dseries chi s) (vm_dseries (dchar.inv chi) s) h1 h2
      have hhalf := ctends_to.const_mul (complex.of_real (1 / 2)) (fun N => complex.add (csum N (vm_dseries_term chi s)) (csum N (vm_dseries_term (dchar.inv chi) s))) (complex.add (vm_dseries chi s) (vm_dseries (dchar.inv chi) s)) h12
      have htot := ctends_to.add (fun N => csum N (vm_dseries_term dchar.trivial_one s)) (fun N => complex.mul (complex.of_real (1 / 2)) (complex.add (csum N (vm_dseries_term chi s)) (csum N (vm_dseries_term (dchar.inv chi) s)))) (vm_dseries dchar.trivial_one s) (complex.mul (complex.of_real (1 / 2)) (complex.add (vm_dseries chi s) (vm_dseries (dchar.inv chi) s))) h0 hhalf
      have hfe : (fun (N : ℕ) => complex.add (csum N (vm_dseries_term dchar.trivial_one s)) (complex.mul (complex.of_real (1 / 2)) (complex.add (csum N (vm_dseries_term chi s)) (csum N (vm_dseries_term (dchar.inv chi) s))))) = (fun (N : ℕ) => csum N (fun n => complex.mul (complex.of_real (psi_chi_coeff chi (n + 1))) (cpow_real ((n + 1 : ℕ) : ℝ) (complex.neg s))))
        funext N
        have hgen : ∀ M : ℕ, complex.add (csum M (vm_dseries_term dchar.trivial_one s)) (complex.mul (complex.of_real (1 / 2)) (complex.add (csum M (vm_dseries_term chi s)) (csum M (vm_dseries_term (dchar.inv chi) s)))) = csum M (fun n => complex.mul (complex.of_real (psi_chi_coeff chi (n + 1))) (cpow_real ((n + 1 : ℕ) : ℝ) (complex.neg s)))
          intro M; induction M with k ihk
          · rw [csum.zero, csum.zero, csum.zero, csum.zero]; unfold complex.of_real; apply complex.ext <;> simp
          · rw [succ_eq_add_one.nat, csum.succ, csum.succ, csum.succ, csum.succ, ← ihk, psi_chi_coeff.complex_decomp chi (k + 1), if_neg ht]
            unfold vm_dseries_term complex.of_real; apply complex.ext <;> simp <;> ring
        exact hgen N
      have hv : complex.add (vm_dseries dchar.trivial_one s) (complex.mul (complex.of_real (1 / 2)) (complex.add (vm_dseries chi s) (vm_dseries (dchar.inv chi) s))) = complex.add (vm_dseries dchar.trivial_one s) (complex.smul (1 / 2) (complex.add (vm_dseries chi s) (vm_dseries (dchar.inv chi) s)))
        unfold complex.of_real; apply complex.ext <;> simp <;> ring
      rw [hfe, hv] at htot; exact htot
  -- Step 2: psi_chi_seq chi N * (N + 1)^(-s) -> 0 as N -> infty!
  have hbd1 : ctends_to (fun (N : ℕ) => complex.mul (complex.of_real (psi_chi_seq chi N)) (cpow_real ((N + 1 : ℕ) : ℝ) (complex.neg s))) complex.zero
    set d := (complex.re s - 1) / 2 with hd
    have hd_pos : 0 < d := by rw [hd]; linarith
    have hlim_r := rpow.nat_neg_tends_to_zero d hd_pos
    set C0 := 2 / d + 1 with hC0
    have hC0_pos : 0 < C0 := by rw [hC0]; linarith [div_pos.real 2 d (by decide) hd_pos]
    unfold ctends_to; unfold tends_to at hlim_r
    intro e he
    obtain ⟨N0, hN0⟩ := hlim_r (e / C0) (div_pos.real e C0 he hC0_pos)
    use N0; intro N hN
    have hsub0 : complex.sub (complex.mul (complex.of_real (psi_chi_seq chi N)) (cpow_real ((N + 1 : ℕ) : ℝ) (complex.neg s))) complex.zero = complex.mul (complex.of_real (psi_chi_seq chi N)) (cpow_real ((N + 1 : ℕ) : ℝ) (complex.neg s))
      apply complex.ext <;> simp <;> ring
    rw [hsub0, complex.abs_mul]
    set u := ((N + 1 : ℕ) : ℝ) with hu
    have hu_ge1 : 1 ≤ u := by rw [hu]; exact (cast_le.real 1 (N + 1)).mpr (by omega)
    have hof : complex.abs (complex.of_real (psi_chi_seq chi N)) = psi_chi_seq chi N
      have hsq : complex.abs (complex.of_real (psi_chi_seq chi N)) * complex.abs (complex.of_real (psi_chi_seq chi N)) = psi_chi_seq chi N * psi_chi_seq chi N
        rw [complex.abs_sq]; unfold complex.norm_sq complex.of_real; simp
      exact eq_of_sq_eq_nonneg (complex.abs (complex.of_real (psi_chi_seq chi N))) (psi_chi_seq chi N) (complex.abs_nonneg (complex.of_real (psi_chi_seq chi N))) (psi_chi_seq.nonneg chi hval N) hsq
    have hap : complex.abs (cpow_real u (complex.neg s)) = rpow u (-complex.re s)
      have hsq : complex.abs (cpow_real u (complex.neg s)) * complex.abs (cpow_real u (complex.neg s)) = rpow u (-complex.re s) * rpow u (-complex.re s)
        rw [complex.abs_sq]; unfold complex.norm_sq cpow_real rpow; simp
        have h1 : log u * (0 - complex.re s) = -complex.re s * log u := by ring
        rw [h1]; linear_combination (exp (-complex.re s * log u) * exp (-complex.re s * log u)) * sin_sq_add_cos_sq (log u * (0 - complex.im s))
      exact eq_of_sq_eq_nonneg (complex.abs (cpow_real u (complex.neg s))) (rpow u (-complex.re s)) (complex.abs_nonneg (cpow_real u (complex.neg s))) (by linarith [rpow.pos u (-complex.re s)]) hsq
    rw [hof, hap]
    have hseq := psi_chi_seq.le_bound chi hval N
    rw [← hu] at hseq
    have hN_le_u : (N : ℝ) ≤ u := by rw [hu, cast_add.real N 1]; simp; linarith
    have hlog_u := log_le_rpow_div u d hu_ge1 hd_pos
    have hpsi_le : psi_chi_seq chi N ≤ (2 / d) * (u * rpow u d)
      have hm1 := mul_le_mul_of_nonneg_right.real (N : ℝ) u (log u) hN_le_u (log_nonneg u hu_ge1)
      have hm2 := mul_le_mul_of_nonneg_left.real (log u) ((1 / d) * rpow u d) (2 * u) hlog_u (by linarith)
      rw [div_def.real 1 d] at hm2; rw [div_def.real 2 d]; linarith
    have hu_rpow : u * rpow u d * rpow u (-complex.re s) = rpow u (-d)
      have hu1 : rpow u 1 = u := by unfold rpow; simp [exp_log u (by linarith)]
      have h1a : u * rpow u d = rpow u (1 + d) := by rw [rpow.add u 1 d, hu1]
      rw [h1a, ← rpow.add u (1 + d) (-complex.re s)]
      have he1 : 1 + d + -complex.re s = -d := by rw [hd]; ring
      rw [he1]
    have hm3 := mul_le_mul_of_nonneg_right.real (psi_chi_seq chi N) ((2 / d) * (u * rpow u d)) (rpow u (-complex.re s)) hpsi_le (by linarith [rpow.pos u (-complex.re s)])
    have hre3 : (2 / d) * (u * rpow u d) * rpow u (-complex.re s) = (2 / d) * rpow u (-d) := by rw [← hu_rpow]; ring
    have h1 := hN0 N hN
    have hsub_r : rpow u (-d) - 0 = rpow u (-d) := by ring
    rw [← hu, hsub_r, abs_of_pos.real (rpow u (-d)) (rpow.pos u (-d))] at h1
    have hlt_e : C0 * rpow u (-d) < e := by linarith [(lt_div_iff.real (rpow u (-d)) e C0 hC0_pos).mp h1]
    have hm4 := mul_le_mul_of_nonneg_right.real (2 / d) C0 (rpow u (-d)) (by rw [hC0]; linarith) (by linarith [rpow.pos u (-d)])
    linarith
  -- Step 3: (N + 1)^(1 - s) -> 0 as N -> infty!
  have hbd2 : ctends_to (fun (N : ℕ) => cpow_real ((N + 1 : ℕ) : ℝ) (complex.sub complex.one s)) complex.zero
    have hlim_r := rpow.nat_neg_tends_to_zero (complex.re s - 1) (by linarith)
    unfold ctends_to; unfold tends_to at hlim_r
    intro e he; obtain ⟨N0, hN0⟩ := hlim_r e he; use N0; intro N hN
    have hsub0 : complex.sub (cpow_real ((N + 1 : ℕ) : ℝ) (complex.sub complex.one s)) complex.zero = cpow_real ((N + 1 : ℕ) : ℝ) (complex.sub complex.one s)
      apply complex.ext <;> simp <;> ring
    rw [hsub0]
    set u := ((N + 1 : ℕ) : ℝ) with hu
    have hap : complex.abs (cpow_real u (complex.sub complex.one s)) = rpow u (-(complex.re s - 1))
      have hsq : complex.abs (cpow_real u (complex.sub complex.one s)) * complex.abs (cpow_real u (complex.sub complex.one s)) = rpow u (-(complex.re s - 1)) * rpow u (-(complex.re s - 1))
        rw [complex.abs_sq]; unfold complex.norm_sq cpow_real rpow; simp
        have h1 : log u * (1 - complex.re s) = -(complex.re s - 1) * log u := by ring
        rw [h1]; linear_combination (exp (-(complex.re s - 1) * log u) * exp (-(complex.re s - 1) * log u)) * sin_sq_add_cos_sq (log u * (0 - complex.im s))
      exact eq_of_sq_eq_nonneg (complex.abs (cpow_real u (complex.sub complex.one s))) (rpow u (-(complex.re s - 1))) (complex.abs_nonneg (cpow_real u (complex.sub complex.one s))) (by linarith [rpow.pos u (-(complex.re s - 1))]) hsq
    rw [hap]
    have h1 := hN0 N hN
    have hsub_r : rpow u (-(complex.re s - 1)) - 0 = rpow u (-(complex.re s - 1)) := by ring
    rw [← hu, hsub_r, abs_of_pos.real (rpow u (-(complex.re s - 1))) (rpow.pos u (-(complex.re s - 1)))] at h1
    exact h1
  -- Combine Steps 1, 2, 3:
  have h1a := ctends_to.sub (fun N => csum N (fun n => complex.mul (complex.of_real (psi_chi_coeff chi (n + 1))) (cpow_real ((n + 1 : ℕ) : ℝ) (complex.neg s)))) (fun N => complex.mul (complex.of_real (psi_chi_seq chi N)) (cpow_real ((N + 1 : ℕ) : ℝ) (complex.neg s))) (Phi_chi chi s) complex.zero hsum_lim hbd1
  have h1b := ctends_to.const_mul (complex.inv s) (fun N => complex.sub (csum N (fun n => complex.mul (complex.of_real (psi_chi_coeff chi (n + 1))) (cpow_real ((n + 1 : ℕ) : ℝ) (complex.neg s)))) (complex.mul (complex.of_real (psi_chi_seq chi N)) (cpow_real ((N + 1 : ℕ) : ℝ) (complex.neg s)))) (complex.sub (Phi_chi chi s) complex.zero) h1a
  have h2a := ctends_to.sub (fun _ => complex.one) (fun (N : ℕ) => cpow_real ((N + 1 : ℕ) : ℝ) (complex.sub complex.one s)) complex.one complex.zero (ctends_to.const complex.one) hbd2
  have h2b := ctends_to.const_mul (complex.inv (complex.sub s complex.one)) (fun (N : ℕ) => complex.sub complex.one (cpow_real ((N + 1 : ℕ) : ℝ) (complex.sub complex.one s))) (complex.sub complex.one complex.zero) h2a
  have htot := ctends_to.sub (fun (N : ℕ) => complex.mul (complex.inv s) (complex.sub (csum N (fun n => complex.mul (complex.of_real (psi_chi_coeff chi (n + 1))) (cpow_real ((n + 1 : ℕ) : ℝ) (complex.neg s)))) (complex.mul (complex.of_real (psi_chi_seq chi N)) (cpow_real ((N + 1 : ℕ) : ℝ) (complex.neg s))))) (fun (N : ℕ) => complex.mul (complex.inv (complex.sub s complex.one)) (complex.sub complex.one (cpow_real ((N + 1 : ℕ) : ℝ) (complex.sub complex.one s)))) (complex.mul (complex.inv s) (complex.sub (Phi_chi chi s) complex.zero)) (complex.mul (complex.inv (complex.sub s complex.one)) (complex.sub complex.one complex.zero)) h1b h2b
  have hfe : (fun (N : ℕ) => complex.sub (complex.mul (complex.inv s) (complex.sub (csum N (fun n => complex.mul (complex.of_real (psi_chi_coeff chi (n + 1))) (cpow_real ((n + 1 : ℕ) : ℝ) (complex.neg s)))) (complex.mul (complex.of_real (psi_chi_seq chi N)) (cpow_real ((N + 1 : ℕ) : ℝ) (complex.neg s))))) (complex.mul (complex.inv (complex.sub s complex.one)) (complex.sub complex.one (cpow_real ((N + 1 : ℕ) : ℝ) (complex.sub complex.one s))))) = (fun (N : ℕ) => cint (fun x => complex.mul (complex.of_real (classical_G chi x)) (cpow_real x (complex.neg (complex.add s complex.one)))) 1 ((N + 1 : ℕ) : ℝ)) := by funext N; exact (hfin N).symm
  have hv : complex.sub (complex.mul (complex.inv s) (complex.sub (Phi_chi chi s) complex.zero)) (complex.mul (complex.inv (complex.sub s complex.one)) (complex.sub complex.one complex.zero)) = G_mellin_mer chi s
    unfold G_mellin_mer; apply complex.ext <;> simp <;> ring
  rw [hfe, hv] at htot; exact htot

-- ====================================================================================
-- 3. POLE CANCELLATION AT s = 1 & ANALYTIC REPRESENTATION ON ALL Re(s) > 0
-- ====================================================================================

-- Fast degree-<=3 complex algebra lemmas (avoiding high-degree polynomial expansion in `ring`):
+ cmul.assoc (a b c : ℂ) : complex.mul (complex.mul a b) c = complex.mul a (complex.mul b c)
  ring

+ cmul.comm (a b : ℂ) : complex.mul a b = complex.mul b a
  ring

+ cmul.swap4 (a b c d : ℂ) : complex.mul (complex.mul a b) (complex.mul c d) = complex.mul (complex.mul a c) (complex.mul b d)
  rw [cmul.assoc, ← cmul.assoc b c d, cmul.comm b c, cmul.assoc c b d, ← cmul.assoc]

+ cmul.add_left (a b c : ℂ) : complex.mul a (complex.add b c) = complex.add (complex.mul a b) (complex.mul a c)
  ring

+ cmul.sub_left (a b c : ℂ) : complex.mul a (complex.sub b c) = complex.sub (complex.mul a b) (complex.mul a c)
  ring

+ cmul.add_right (a b c : ℂ) : complex.mul (complex.add a b) c = complex.add (complex.mul a c) (complex.mul b c)
  ring

+ cmul.sub_right (a b c : ℂ) : complex.mul (complex.sub a b) c = complex.sub (complex.mul a c) (complex.mul b c)
  ring

+ cmul.neg_left (a b : ℂ) : complex.mul (complex.neg a) b = complex.neg (complex.mul a b)
  ring

+ cmul.smul_left (r : ℝ) (a b : ℂ) : complex.mul (complex.smul r a) b = complex.smul r (complex.mul a b)
  ring

+ cmul.smul_right (r : ℝ) (a b : ℂ) : complex.mul a (complex.smul r b) = complex.smul r (complex.mul a b)
  ring

-- Product-rule derivative for `(s - 1) * f(s)`:
+ has_cderiv_at.mul_sub_one (f : ℂ → ℂ) (s0 V : ℂ) (hd : has_cderiv_at f s0 V) :
    has_cderiv_at (fun s => complex.mul (complex.sub s complex.one) (f s)) s0 (complex.add (f s0) (complex.mul (complex.sub s0 complex.one) V))
  unfold has_cderiv_at at hd ⊢
  intro e he
  set K1 := complex.abs (complex.sub s0 complex.one) + 2 with hK1
  have hK1_pos : 0 < K1 := by rw [hK1]; linarith [complex.abs_nonneg (complex.sub s0 complex.one)]
  set K2 := complex.abs V + 1 with hK2
  have hK2_pos : 0 < K2 := by rw [hK2]; linarith [complex.abs_nonneg V]
  obtain ⟨d1, hd1_pos, hd1⟩ := hd (e / (2 * K1)) (div_pos.real e (2 * K1) he (by linarith))
  set d := min (min d1 1) (e / (2 * K2)) with hd_def
  have hd_pos : 0 < d := by rw [hd_def]; exact lt_min.real (min d1 1) (e / (2 * K2)) 0 (lt_min.real d1 1 0 hd1_pos (by decide)) (div_pos.real e (2 * K2) he (by linarith))
  use d; constructor; exact hd_pos
  intro s hs
  have hs_d1 : complex.abs (complex.sub s s0) < d1 := by linarith [min_le_left.real (min d1 1) (e / (2 * K2)), min_le_left.real d1 1]
  have hs_1 : complex.abs (complex.sub s s0) < 1 := by linarith [min_le_left.real (min d1 1) (e / (2 * K2)), min_le_right.real d1 1]
  have hs_K2 : complex.abs (complex.sub s s0) < e / (2 * K2) := by linarith [min_le_right.real (min d1 1) (e / (2 * K2))]
  have hsplit : complex.sub (complex.sub (complex.mul (complex.sub s complex.one) (f s)) (complex.mul (complex.sub s0 complex.one) (f s0))) (complex.mul (complex.add (f s0) (complex.mul (complex.sub s0 complex.one) V)) (complex.sub s s0)) = complex.add (complex.mul (complex.sub s complex.one) (complex.sub (complex.sub (f s) (f s0)) (complex.mul V (complex.sub s s0)))) (complex.mul (complex.mul V (complex.sub s s0)) (complex.sub s s0)) := by ring
  rw [hsplit]
  have htri := complex.abs_add_le (complex.mul (complex.sub s complex.one) (complex.sub (complex.sub (f s) (f s0)) (complex.mul V (complex.sub s s0)))) (complex.mul (complex.mul V (complex.sub s s0)) (complex.sub s s0))
  rw [complex.abs_mul, complex.abs_mul, complex.abs_mul] at htri
  have hs1_le : complex.abs (complex.sub s complex.one) ≤ K1
    have ht := complex.abs_sub_triangle s s0 complex.one
    rw [hK1]; linarith
  have h1a := hd1 s hs_d1
  have hm1 := mul_le_mul_of_nonneg_left.real (complex.abs (complex.sub (complex.sub (f s) (f s0)) (complex.mul V (complex.sub s s0)))) (e / (2 * K1) * complex.abs (complex.sub s s0)) (complex.abs (complex.sub s complex.one)) h1a (complex.abs_nonneg (complex.sub s complex.one))
  have hm2 := mul_le_mul_of_nonneg_right.real (complex.abs (complex.sub s complex.one)) K1 (e / (2 * K1) * complex.abs (complex.sub s s0)) hs1_le (mul_nonneg.real (e / (2 * K1)) (complex.abs (complex.sub s s0)) (div_nonneg.real e (2 * K1) (by linarith) (by linarith)) (complex.abs_nonneg (complex.sub s s0)))
  have hre1 : K1 * (e / (2 * K1) * complex.abs (complex.sub s s0)) = (e / 2) * complex.abs (complex.sub s s0) := by field_simp
  have hm3 : complex.abs V * complex.abs (complex.sub s s0) ≤ e / 2
    have h1 := (lt_div_iff.real (complex.abs (complex.sub s s0)) e (2 * K2) (by linarith)).mp hs_K2
    have hle : complex.abs V ≤ K2 := by rw [hK2]; linarith
    have hm := mul_le_mul_of_nonneg_right.real (complex.abs V) K2 (complex.abs (complex.sub s s0)) hle (complex.abs_nonneg (complex.sub s s0))
    exact (le_div_iff.real (complex.abs V * complex.abs (complex.sub s s0)) e 2 (by decide)).mpr (by linarith)
  have hm4 := mul_le_mul_of_nonneg_right.real (complex.abs V * complex.abs (complex.sub s s0)) (e / 2) (complex.abs (complex.sub s s0)) hm3 (complex.abs_nonneg (complex.sub s s0))
  linarith

+ has_cderiv_at.congr_nbhd (f g : ℂ → ℂ) (z0 V : ℂ) (r : ℝ) (hr : 0 < r)
    (hf : has_cderiv_at f z0 V) (hagree : ∀ z, complex.abs (complex.sub z z0) < r → f z = g z) :
    has_cderiv_at g z0 V
  unfold has_cderiv_at at hf ⊢
  intro e he
  obtain ⟨d, hd_pos, hd⟩ := hf e he
  use min d r; constructor; exact lt_min.real d r 0 hd_pos hr
  intro z hz
  have hz_d : complex.abs (complex.sub z z0) < d := by linarith [min_le_left.real d r]
  have hz_r : complex.abs (complex.sub z z0) < r := by linarith [min_le_right.real d r]
  rw [← hagree z hz_r, ← hagree z0 (by rw [complex.sub_self, complex.abs_zero]; exact hr)]
  exact hd z hz_d

+ dchar.is_trivial_inv_iff (chi : DChar) :
    dchar.is_trivial (dchar.inv chi) ↔ dchar.is_trivial chi
  unfold dchar.is_trivial dchar.inv; simp
  constructor
  · intro h a ha
    have hc := h a ha
    apply complex.ext
    · have hr : complex.re (complex.conj (chi.val a)) = complex.re complex.one := by rw [hc]
      simp at hr ⊢
    · have hi : complex.im (complex.conj (chi.val a)) = complex.im complex.one := by rw [hc]
      simp at hi ⊢; linarith
  · intro h a ha
    rw [h a ha]; apply complex.ext <;> simp

-- Regularized zeta factor Z(s) = (s - 1) * zeta(s), analytic on ALL Re(s) > 0:
-> Z_reg (s : ℂ) : ℂ := classical_L_reg dchar.trivial_one s

+ Z_reg.is_canalytic_at_re_pos (s0 : ℂ) (hs0 : 0 < complex.re s0) :
    is_canalytic_at Z_reg s0
  unfold Z_reg
  exact classical_L_reg.is_canalytic_at_re_pos dchar.trivial_one dchar.trivial_one_valid s0 hs0

+ Z_reg.eq_re_gt_one (s : ℂ) (hs : 1 < complex.re s) :
    Z_reg s = complex.mul (complex.sub s complex.one) (DirichletLOps.l_fn classical_L dchar.trivial_one s)
  have hs1 : s ≠ complex.one
    intro h1; have hr : complex.re s = complex.re complex.one := by rw [h1]
    simp at hr; linarith
  unfold Z_reg
  rw [classical_L_reg.eq_re_pos dchar.trivial_one dchar.trivial_one_valid s (by linarith) hs1]
  have htriv := dchar.trivial_one_is_trivial
  rw [if_pos htriv]

+ Z_reg.cderiv_at_re_gt_one (s0 : ℂ) (hs0 : 1 < complex.re s0) :
    cderiv_at Z_reg s0 = complex.add (DirichletLOps.l_fn classical_L dchar.trivial_one s0) (complex.mul (complex.sub s0 complex.one) (dchar_log_dseries dchar.trivial_one s0))
  have hd0 := classical_L.has_cderiv_at_re_gt_one dchar.trivial_one dchar.trivial_one_valid s0 hs0
  have hd1 := has_cderiv_at.mul_sub_one (DirichletLOps.l_fn classical_L dchar.trivial_one) s0 (dchar_log_dseries dchar.trivial_one s0) hd0
  have hd2 : has_cderiv_at Z_reg s0 (complex.add (DirichletLOps.l_fn classical_L dchar.trivial_one s0) (complex.mul (complex.sub s0 complex.one) (dchar_log_dseries dchar.trivial_one s0)))
    apply has_cderiv_at.congr_nbhd (fun s => complex.mul (complex.sub s complex.one) (DirichletLOps.l_fn classical_L dchar.trivial_one s)) Z_reg s0 (complex.add (DirichletLOps.l_fn classical_L dchar.trivial_one s0) (complex.mul (complex.sub s0 complex.one) (dchar_log_dseries dchar.trivial_one s0))) ((complex.re s0 - 1) / 2) (by linarith) hd1
    intro s hs
    have hs_re : 1 < complex.re s
      have h1 := complex.re_abs_le (complex.sub s s0); simp at h1
      linarith [neg_le_abs.real (complex.re s - complex.re s0)]
    exact (Z_reg.eq_re_gt_one s hs_re).symm
  exact has_cderiv_at.cderiv_at_eq Z_reg s0 (complex.add (DirichletLOps.l_fn classical_L dchar.trivial_one s0) (complex.mul (complex.sub s0 complex.one) (dchar_log_dseries dchar.trivial_one s0))) hd2

+ classical_L_reg.eq_nt_all (chi : DChar) (hval : dchar.valid chi) (hnt : ¬ dchar.is_trivial chi) (s : ℂ) :
    classical_L_reg chi s = DirichletLOps.l_fn classical_L chi s
  have hne1 : (dchar.prim chi).level ≠ 1 := by intro h1; exact hnt ((dchar.is_trivial_iff_prim_level_one chi hval).mpr h1)
  unfold classical_L_reg
  rw [if_neg hne1]

+ classical_L_reg.cderiv_at_nt_re_gt_one (chi : DChar) (hval : dchar.valid chi) (hnt : ¬ dchar.is_trivial chi) (s0 : ℂ) (hs0 : 1 < complex.re s0) :
    cderiv_at (classical_L_reg chi) s0 = dchar_log_dseries chi s0
  have hd0 := classical_L.has_cderiv_at_re_gt_one chi hval s0 hs0
  have hd1 : has_cderiv_at (classical_L_reg chi) s0 (dchar_log_dseries chi s0)
    have h1pos : (0 : ℝ) < 1 := by decide
    apply has_cderiv_at.congr_nbhd (DirichletLOps.l_fn classical_L chi) (classical_L_reg chi) s0 (dchar_log_dseries chi s0) 1 h1pos hd0
    intro s _; exact (classical_L_reg.eq_nt_all chi hval hnt s).symm
  exact has_cderiv_at.cderiv_at_eq (classical_L_reg chi) s0 (dchar_log_dseries chi s0) hd1

-- Denominator-cleared analytic base functions D_chi and N_base on ALL Re(s) > 0:
-> D_chi (chi : DChar) (s : ℂ) : ℂ :=
  if dchar.is_trivial chi then
    Z_reg s
  else
    complex.mul (Z_reg s) (complex.mul (classical_L_reg chi s) (classical_L_reg (dchar.inv chi) s))

-> N_base (chi : DChar) (s : ℂ) : ℂ :=
  if dchar.is_trivial chi then
    complex.neg (complex.add (Z_reg s) (cderiv_at Z_reg s))
  else
    complex.sub
      (complex.neg (complex.mul (complex.add (Z_reg s) (cderiv_at Z_reg s)) (complex.mul (classical_L_reg chi s) (classical_L_reg (dchar.inv chi) s))))
      (complex.smul (1 / 2) (complex.mul (Z_reg s)
        (complex.add
          (complex.mul (cderiv_at (classical_L_reg chi) s) (classical_L_reg (dchar.inv chi) s))
          (complex.mul (classical_L_reg chi s) (cderiv_at (classical_L_reg (dchar.inv chi)) s)))))

+ D_chi.is_canalytic_at_re_pos (chi : DChar) (hval : dchar.valid chi) (s0 : ℂ) (hs0 : 0 < complex.re s0) :
    is_canalytic_at (D_chi chi) s0
  by_cases ht : dchar.is_trivial chi <;> canalytic [D_chi]

+ N_base.is_canalytic_at_re_pos (chi : DChar) (hval : dchar.valid chi) (s0 : ℂ) (hs0 : 0 < complex.re s0) :
    is_canalytic_at (N_base chi) s0
  by_cases ht : dchar.is_trivial chi <;> canalytic [N_base]

-- Exact pole cancellation identity on Re(s) > 1:
--   s * D_chi(s) * G_mellin_mer(chi, s) = N_base(chi, s)  AND  D_chi(s) != 0!
+ D_chi.ne_zero_re_gt_one (chi : DChar) (hval : dchar.valid chi) (s : ℂ) (hs : 1 < complex.re s) :
    D_chi chi s ≠ complex.zero
  have hs1_ne : complex.sub s complex.one ≠ complex.zero
    intro h0; have hr : complex.re (complex.sub s complex.one) = complex.re complex.zero := by rw [h0]
    simp at hr; linarith
  have hZ_ne : Z_reg s ≠ complex.zero
    rw [Z_reg.eq_re_gt_one s hs]
    exact complex.mul_ne_zero (complex.sub s complex.one) (DirichletLOps.l_fn classical_L dchar.trivial_one s) hs1_ne (classical_L.l_fn_ne_zero_re_gt_one dchar.trivial_one dchar.trivial_one_valid s hs)
  unfold D_chi
  by_cases ht : dchar.is_trivial chi
  · rw [if_pos ht]; exact hZ_ne
  · rw [if_neg ht]
    have hnt_inv : ¬ dchar.is_trivial (dchar.inv chi) := by intro h; exact ht ((dchar.is_trivial_inv_iff chi).mp h)
    have hL1_ne : classical_L_reg chi s ≠ complex.zero := by rw [classical_L_reg.eq_nt_all chi hval ht s]; exact classical_L.l_fn_ne_zero_re_gt_one chi hval s hs
    have hL2_ne : classical_L_reg (dchar.inv chi) s ≠ complex.zero := by rw [classical_L_reg.eq_nt_all (dchar.inv chi) (dchar.inv_valid chi hval) hnt_inv s]; exact classical_L.l_fn_ne_zero_re_gt_one (dchar.inv chi) (dchar.inv_valid chi hval) s hs
    exact complex.mul_ne_zero (Z_reg s) (complex.mul (classical_L_reg chi s) (classical_L_reg (dchar.inv chi) s)) hZ_ne (complex.mul_ne_zero (classical_L_reg chi s) (classical_L_reg (dchar.inv chi) s) hL1_ne hL2_ne)

+ G_mellin_mer.cleared_eq_N_base (chi : DChar) (hval : dchar.valid chi) (s : ℂ) (hs : 1 < complex.re s) :
    complex.mul (complex.mul s (D_chi chi s)) (G_mellin_mer chi s) = N_base chi s
  have hs0 : s ≠ complex.zero
    intro h0; have hr : complex.re s = complex.re complex.zero := by rw [h0]
    simp at hr; linarith
  have hs1 : complex.sub s complex.one ≠ complex.zero
    intro h0; have hr : complex.re (complex.sub s complex.one) = complex.re complex.zero := by rw [h0]
    simp at hr; linarith
  have hcs := complex.mul_inv_cancel s hs0
  have hcs1 := complex.mul_inv_cancel (complex.sub s complex.one) hs1
  have hZ_eq := Z_reg.eq_re_gt_one s hs
  have hZp_eq := Z_reg.cderiv_at_re_gt_one s hs
  have hvm0 := classical_L.mul_vm_eq_neg_deriv_re_gt_one dchar.trivial_one dchar.trivial_one_valid s hs
  -- Key zeta cancellation: s * Z(s) * (1/s * vm(1, s) - 1/(s - 1)) = -(Z(s) + Z'(s))!
  have hzeta_cancel : complex.mul (complex.mul s (Z_reg s)) (complex.sub (complex.mul (complex.inv s) (vm_dseries dchar.trivial_one s)) (complex.inv (complex.sub s complex.one))) = complex.neg (complex.add (Z_reg s) (cderiv_at Z_reg s))
    have h1 : complex.mul (complex.mul s (Z_reg s)) (complex.sub (complex.mul (complex.inv s) (vm_dseries dchar.trivial_one s)) (complex.inv (complex.sub s complex.one))) = complex.sub (complex.mul (complex.mul s (complex.inv s)) (complex.mul (Z_reg s) (vm_dseries dchar.trivial_one s))) (complex.mul s (complex.mul (complex.mul (complex.sub s complex.one) (complex.inv (complex.sub s complex.one))) (DirichletLOps.l_fn classical_L dchar.trivial_one s)))
      rw [hZ_eq]; apply complex.ext <;> simp <;> ring
    rw [h1, hcs, hcs1, complex.one_mul, complex.one_mul, hZ_eq, hZp_eq]
    have h2 : complex.mul (complex.mul (complex.sub s complex.one) (DirichletLOps.l_fn classical_L dchar.trivial_one s)) (vm_dseries dchar.trivial_one s) = complex.mul (complex.sub s complex.one) (complex.mul (DirichletLOps.l_fn classical_L dchar.trivial_one s) (vm_dseries dchar.trivial_one s))
      apply complex.ext <;> simp <;> ring
    rw [h2, hvm0]; apply complex.ext <;> simp <;> ring
  unfold D_chi N_base G_mellin_mer Phi_chi
  by_cases ht : dchar.is_trivial chi
  · rw [if_pos ht, if_pos ht, if_pos ht]; exact hzeta_cancel
  · rw [if_neg ht, if_neg ht, if_neg ht]
    have hnt_inv : ¬ dchar.is_trivial (dchar.inv chi) := by intro h; exact ht ((dchar.is_trivial_inv_iff chi).mp h)
    have hL1_eq := classical_L_reg.eq_nt_all chi hval ht s
    have hL2_eq := classical_L_reg.eq_nt_all (dchar.inv chi) (dchar.inv_valid chi hval) hnt_inv s
    have hL1p := classical_L_reg.cderiv_at_nt_re_gt_one chi hval ht s hs
    have hL2p := classical_L_reg.cderiv_at_nt_re_gt_one (dchar.inv chi) (dchar.inv_valid chi hval) hnt_inv s hs
    have hvm1 := classical_L.mul_vm_eq_neg_deriv_re_gt_one chi hval s hs
    have hvm2 := classical_L.mul_vm_eq_neg_deriv_re_gt_one (dchar.inv chi) (dchar.inv_valid chi hval) s hs
    set L1 := classical_L_reg chi s with hL1_def
    set L2 := classical_L_reg (dchar.inv chi) s with hL2_def
    set P := complex.mul L1 L2 with hP_def
    set v0 := vm_dseries dchar.trivial_one s with hv0_def
    set v1 := vm_dseries chi s with hv1_def
    set v2 := vm_dseries (dchar.inv chi) s with hv2_def
    set s1i := complex.inv (complex.sub s complex.one) with hs1i_def
    have hsplit_rhs : ∀ c : ℝ, complex.sub (complex.mul (complex.inv s) (complex.add v0 (complex.smul c (complex.add v1 v2)))) s1i = complex.add (complex.sub (complex.mul (complex.inv s) v0) s1i) (complex.smul c (complex.mul (complex.inv s) (complex.add v1 v2)))
      intro c; apply complex.ext <;> simp <;> ring
    rw [hsplit_rhs, cmul.add_left]
    have ht1 : complex.mul (complex.mul s (complex.mul (Z_reg s) P)) (complex.sub (complex.mul (complex.inv s) v0) s1i) = complex.mul (complex.neg (complex.add (Z_reg s) (cderiv_at Z_reg s))) P
      rw [← cmul.assoc s (Z_reg s) P, cmul.comm (complex.mul s (Z_reg s)) P, cmul.assoc P (complex.mul s (Z_reg s)) (complex.sub (complex.mul (complex.inv s) v0) s1i), cmul.comm P]
      rw [hzeta_cancel]
    have ht2 : ∀ c : ℝ, complex.mul (complex.mul s (complex.mul (Z_reg s) P)) (complex.smul c (complex.mul (complex.inv s) (complex.add v1 v2))) = complex.neg (complex.smul c (complex.mul (Z_reg s) (complex.add (complex.mul (cderiv_at (classical_L_reg chi) s) L2) (complex.mul L1 (cderiv_at (classical_L_reg (dchar.inv chi)) s)))))
      intro c
      rw [cmul.smul_right, cmul.swap4 s (complex.mul (Z_reg s) P) (complex.inv s) (complex.add v1 v2), hcs, complex.one_mul, cmul.assoc (Z_reg s) P (complex.add v1 v2)]
      have hPv : complex.mul P (complex.add v1 v2) = complex.neg (complex.add (complex.mul (cderiv_at (classical_L_reg chi) s) L2) (complex.mul L1 (cderiv_at (classical_L_reg (dchar.inv chi)) s)))
        have h1a : complex.mul (complex.mul L1 L2) (complex.add v1 v2) = complex.add (complex.mul (complex.mul L1 v1) L2) (complex.mul L1 (complex.mul L2 v2))
          apply complex.ext <;> simp <;> ring
        rw [hP_def, h1a, hL1_eq, hL2_eq, hvm1, hvm2, ← hL1p, ← hL2p]
        apply complex.ext <;> simp <;> ring
      rw [hPv]; apply complex.ext <;> simp <;> ring
    rw [ht1, ht2]
    ring

+ convex_gt (a b c t : ℝ) (ha : c < a) (hb : c < b) (ht0 : 0 ≤ t) (ht1 : t ≤ 1) :
    c < a + t * (b - a)
  by_cases hab : a ≤ b
  · linarith [mul_nonneg.real t (b - a) ht0 (by linarith)]
  · linarith [mul_nonneg.real (1 - t) (a - b) (by linarith) (by linarith)]

-- Non-triviality of `classical_L_reg chi`: power series at ANY z0 with Re(z0) > 0 is not identically zero!
+ classical_L_reg.not_all_coeffs_zero (chi : DChar) (hval : dchar.valid chi)
    (z0 : ℂ) (a : ℕ → ℂ) (r : ℝ) (hz0 : 0 < complex.re z0)
    (hps : is_cpower_series_at (classical_L_reg chi) z0 a r) :
    ∃ k : ℕ, a k ≠ complex.zero
  by_contra hall
  have haz : ∀ k : ℕ, a k = complex.zero := by intro k; by_contra hne; exact hall ⟨k, hne⟩
  have hvan : ∀ z : ℂ, complex.abs (complex.sub z z0) < r → classical_L_reg chi z = complex.zero
    intro z hz
    have hl := hps.2.2 z hz
    have h0l : ctends_to (fun N => csum N (fun k => complex.mul (a k) (cpow_nat (complex.sub z z0) k))) complex.zero
      unfold ctends_to; intro e he; use 0; intro N _
      have hcz : ∀ M : ℕ, csum M (fun k => complex.mul (a k) (cpow_nat (complex.sub z z0) k)) = complex.zero
        intro M; induction M with m ihm
        · rw [csum.zero]
        · rw [succ_eq_add_one.nat, csum.succ, ihm, haz m, complex.zero_mul, complex.add_zero]
      rw [hcz N, complex.sub_self, complex.abs_zero]; exact he
    exact ctends_to.unique (fun N => csum N (fun k => complex.mul (a k) (cpow_nat (complex.sub z z0) k))) (classical_L_reg chi z) complex.zero hl h0l
  have h2_zero : classical_L_reg chi (complex.of_real 2) = complex.zero
    apply is_canalytic_on.identity_segment (classical_L_reg chi) (fun _ => complex.zero) z0 (complex.of_real 2) r hps.1
    · intro t ht1 ht2
      have hre : 0 < complex.re (complex.add z0 (complex.smul t (complex.sub (complex.of_real 2) z0))) := by unfold complex.of_real; simp; exact convex_gt (complex.re z0) 2 0 t hz0 (by decide) ht1 ht2
      exact classical_L_reg.is_canalytic_at_re_pos chi hval (complex.add z0 (complex.smul t (complex.sub (complex.of_real 2) z0))) hre
    · intro t _ _; exact is_canalytic_at.const complex.zero (complex.add z0 (complex.smul t (complex.sub (complex.of_real 2) z0)))
    · exact hvan
  have h2_re1 : 1 < complex.re (complex.of_real 2) := by unfold complex.of_real; simp
  have h2_ne1 : complex.of_real 2 ≠ complex.one
    intro h1; have hr : complex.re (complex.of_real 2) = complex.re complex.one := by rw [h1]
    unfold complex.of_real at hr; simp at hr
  have h2_sub_ne : complex.sub (complex.of_real 2) complex.one ≠ complex.zero
    intro h0; have hr : complex.re (complex.sub (complex.of_real 2) complex.one) = complex.re complex.zero := by rw [h0]
    unfold complex.of_real at hr; simp at hr
  have hL2_ne := classical_L.l_fn_ne_zero_re_gt_one chi hval (complex.of_real 2) h2_re1
  rw [classical_L_reg.eq_re_pos chi hval (complex.of_real 2) (by linarith) h2_ne1] at h2_zero
  by_cases ht : dchar.is_trivial chi
  · rw [if_pos ht] at h2_zero
    exact complex.mul_ne_zero (complex.sub (complex.of_real 2) complex.one) (DirichletLOps.l_fn classical_L chi (complex.of_real 2)) h2_sub_ne hL2_ne h2_zero
  · rw [if_neg ht] at h2_zero
    exact hL2_ne h2_zero

-- Zero transfer: any zero rho (Re(rho) > 0, and rho != 1 if chi trivial) of L(chi, s) is a zero of D_chi!
+ D_chi.eq_zero_of_l_fn_zero (chi : DChar) (hval : dchar.valid chi) (rho : ℂ)
    (hre : 0 < complex.re rho) (hnot1 : ¬ dchar.is_trivial chi ∨ rho ≠ complex.one)
    (hz : DirichletLOps.l_fn classical_L chi rho = complex.zero) :
    D_chi chi rho = complex.zero
  unfold D_chi
  by_cases ht : dchar.is_trivial chi
  · rw [if_pos ht]
    have hrho1 : rho ≠ complex.one
      obtain hnt | hne1 := hnot1
      · exfalso; exact hnt ht
      · exact hne1
    have hl1 : (dchar.prim chi).level = 1 := (dchar.is_trivial_iff_prim_level_one chi hval).mp ht
    have hsp := dchar.prim_spec chi hval
    have heul := induced_euler_ratio.ne_zero_re_pos chi.level (dchar.prim chi) hsp.1.1 rho hre
    -- Show classical_L_reg chi rho = 0 AND classical_L_reg dchar.trivial_one rho = 0!
    have hreg_z : classical_L_reg chi rho = complex.zero
      rw [classical_L_reg.eq_re_pos chi hval rho hre hrho1]
      rw [if_pos ht, hz, complex.mul_zero]
    unfold classical_L_reg at hreg_z
    rw [if_pos hl1] at hreg_z
    have hgam_ne := classical_gamma.ne_zero_re_pos (dchar.prim chi) rho hre
    have hinv_gam_ne : complex.inv (classical_gamma (dchar.prim chi) rho) ≠ complex.zero
      intro h0; have hc := complex.mul_inv_cancel (classical_gamma (dchar.prim chi) rho) hgam_ne
      rw [h0, complex.mul_zero] at hc; exact complex.one_ne_zero hc.symm
    have hlam_z : classical_Lambda_triv_reg rho = complex.zero
      by_contra hne
      exact complex.mul_ne_zero (induced_euler_ratio chi.level (dchar.prim chi) rho) (complex.mul (complex.inv (classical_gamma (dchar.prim chi) rho)) (classical_Lambda_triv_reg rho)) heul (complex.mul_ne_zero (complex.inv (classical_gamma (dchar.prim chi) rho)) (classical_Lambda_triv_reg rho) hinv_gam_ne hne) hreg_z
    unfold Z_reg classical_L_reg
    have hprim1 : (dchar.prim dchar.trivial_one).level = 1 := by rw [dchar.prim_of_primitive dchar.trivial_one dchar.trivial_one_is_primitive]; unfold dchar.trivial_one; simp
    rw [if_pos hprim1, hlam_z, complex.mul_zero, complex.mul_zero]
  · rw [if_neg ht, classical_L_reg.eq_nt_all chi hval ht rho, hz, complex.zero_mul, complex.mul_zero]

-- Exact local log-derivative decomposition of N_base(z) / (z * D_chi(z)) at ANY z0 with Re(z0) > 0!
-- Yields `m_tot >= 0` (and `m_tot >= 1/2` whenever D_chi(z0) = 0!), `delta > 0`, `M >= 0` such that
-- on `0 < |z - z0| < delta`:
--   D_chi(z) != 0  AND  |N_base(z) / (z * D_chi(z)) - (-m_tot / (z0 * (z - z0)))| <= M !
+ single_reg.log_deriv_bound (chi : DChar) (hval : dchar.valid chi) (z0 : ℂ) (hz0 : 0 < complex.re z0) :
    ∃ (m : ℕ) (delta M : ℝ),
      (classical_L_reg chi z0 = complex.zero → 1 ≤ m) ∧
      0 < delta ∧ 0 ≤ M ∧
      ∀ z : ℂ, z ≠ z0 → complex.abs (complex.sub z z0) < delta →
        classical_L_reg chi z ≠ complex.zero ∧
        complex.abs (complex.sub
          (complex.neg (complex.mul (cderiv_at (classical_L_reg chi) z) (complex.inv (classical_L_reg chi z))))
          (complex.neg (complex.mul (complex.of_real (m : ℝ)) (complex.inv (complex.sub z z0))))) ≤ M
  have hana := classical_L_reg.is_canalytic_at_re_pos chi hval z0 hz0
  unfold is_canalytic_at at hana
  obtain ⟨a, r, hps⟩ := hana
  by_cases hf0 : classical_L_reg chi z0 = complex.zero
  · have hnt := classical_L_reg.not_all_coeffs_zero chi hval z0 a r hz0 hps
    obtain ⟨m, delta, M, hm1, hdel, hM, hdec⟩ := is_cpower_series_at.log_deriv_decomp (classical_L_reg chi) z0 a r hps hf0 hnt
    exact ⟨m, delta, M, by intro _; exact hm1, hdel, hM, by intro z hne hlt; have h := hdec z hne hlt; exact ⟨h.1, h.2.2⟩⟩
  · -- f(z0) != 0 => m = 0, and -f'/f is continuous (bounded!) on a small disk!
    have hfa : is_canalytic_at (classical_L_reg chi) z0 := by unfold is_canalytic_at; exact ⟨a, r, hps⟩
    have hinv_a := is_canalytic_at.inv (classical_L_reg chi) z0 hfa hf0
    have hder_a := (is_canalytic_at.cderiv_at (classical_L_reg chi) z0 hfa).2
    have hq_a := is_canalytic_at.neg (fun z => complex.mul (cderiv_at (classical_L_reg chi) z) (complex.inv (classical_L_reg chi z))) z0 (is_canalytic_at.mul (cderiv_at (classical_L_reg chi)) (fun z => complex.inv (classical_L_reg chi z)) z0 hder_a hinv_a)
    unfold is_canalytic_at at hq_a
    obtain ⟨aq, rq, hq_ps⟩ := hq_a
    have hf0_pos : 0 < complex.abs (classical_L_reg chi z0) := by by_contra hle; exact hf0 ((complex.abs_eq_zero (classical_L_reg chi z0)).mp (by linarith [complex.abs_nonneg (classical_L_reg chi z0)]))
    obtain ⟨d1, hd1_pos, hd1⟩ := is_cpower_series_at.continuous_at (classical_L_reg chi) z0 a r hps (complex.abs (classical_L_reg chi z0) / 2) (by linarith)
    obtain ⟨d2, hd2_pos, hd2⟩ := is_cpower_series_at.continuous_at (fun z => complex.neg (complex.mul (cderiv_at (classical_L_reg chi) z) (complex.inv (classical_L_reg chi z)))) z0 aq rq hq_ps 1 (by decide)
    set del := min d1 d2 with hdel
    have hdel_pos : 0 < del := by rw [hdel]; exact lt_min.real d1 d2 0 hd1_pos hd2_pos
    set q0 := complex.neg (complex.mul (cderiv_at (classical_L_reg chi) z0) (complex.inv (classical_L_reg chi z0))) with hq0
    use 0; use del; use complex.abs q0 + 1
    constructor; intro hc; exfalso; exact hf0 hc
    constructor; exact hdel_pos
    constructor; linarith [complex.abs_nonneg q0]
    intro z _ hz
    have hz1 : complex.abs (complex.sub z z0) < d1 := by linarith [min_le_left.real d1 d2]
    have hz2 : complex.abs (complex.sub z z0) < d2 := by linarith [min_le_right.real d1 d2]
    have hne_z : classical_L_reg chi z ≠ complex.zero
      intro h0
      have h1 := hd1 z hz1
      rw [h0] at h1
      have hsub0 : complex.sub complex.zero (classical_L_reg chi z0) = complex.neg (classical_L_reg chi z0)
        apply complex.ext <;> simp <;> ring
      rw [hsub0, complex.abs_neg] at h1
      linarith
    constructor; exact hne_z
    have h0sub : complex.sub (complex.neg (complex.mul (cderiv_at (classical_L_reg chi) z) (complex.inv (classical_L_reg chi z)))) (complex.neg (complex.mul (complex.of_real ((0 : ℕ) : ℝ)) (complex.inv (complex.sub z z0)))) = complex.neg (complex.mul (cderiv_at (classical_L_reg chi) z) (complex.inv (classical_L_reg chi z))) := by ring
    rw [h0sub]
    have h2 := hd2 z hz2
    have ht := complex.abs_sub_abs_le (complex.neg (complex.mul (cderiv_at (classical_L_reg chi) z) (complex.inv (classical_L_reg chi z)))) q0
    linarith

+ N_base_div_zD.pole_decomp (chi : DChar) (hval : dchar.valid chi) (z0 : ℂ) (hz0 : 0 < complex.re z0) :
    ∃ (m_tot delta M : ℝ),
      0 ≤ m_tot ∧ (D_chi chi z0 = complex.zero → 1 / 2 ≤ m_tot) ∧
      0 < delta ∧ 0 ≤ M ∧
      ∀ z : ℂ, z ≠ z0 → complex.abs (complex.sub z z0) < delta →
        z ≠ complex.zero ∧ D_chi chi z ≠ complex.zero ∧
        complex.abs (complex.sub
          (complex.mul (N_base chi z) (complex.inv (complex.mul z (D_chi chi z))))
          (complex.neg (complex.mul (complex.of_real m_tot) (complex.inv (complex.mul z0 (complex.sub z z0)))))) ≤ M
  have hz0_ne : z0 ≠ complex.zero
    intro h0; have hr : complex.re z0 = complex.re complex.zero := by rw [h0]
    simp at hr; linarith
  have hz0_pos : 0 < complex.abs z0 := by by_contra hle; exact hz0_ne ((complex.abs_eq_zero z0).mp (by linarith [complex.abs_nonneg z0]))
  -- Helper: dividing (-m / (z - z0) + O(1)) by z produces -m / (z0 * (z - z0)) + O(1)!
  have hdiv_z : ∀ (q_fn : ℂ → ℂ) (m_val d0 M0 : ℝ), 0 ≤ m_val → 0 < d0 → 0 ≤ M0 →
      (∀ z : ℂ, z ≠ z0 → complex.abs (complex.sub z z0) < d0 → complex.abs (complex.sub (q_fn z) (complex.neg (complex.mul (complex.of_real m_val) (complex.inv (complex.sub z z0))))) ≤ M0) →
      ∀ z : ℂ, z ≠ z0 → complex.abs (complex.sub z z0) < min d0 (complex.abs z0 / 2) →
        z ≠ complex.zero ∧
        complex.abs (complex.sub (complex.mul (complex.inv z) (q_fn z)) (complex.neg (complex.mul (complex.of_real m_val) (complex.inv (complex.mul z0 (complex.sub z z0)))))) ≤ (2 / complex.abs z0) * M0 + 2 * m_val / (complex.abs z0 * complex.abs z0)
    intro q_fn m_val d0 M0 hm_nn hd0 hM0 hq z hne hz
    have hz_d0 : complex.abs (complex.sub z z0) < d0 := by linarith [min_le_left.real d0 (complex.abs z0 / 2)]
    have hz_half : complex.abs (complex.sub z z0) < complex.abs z0 / 2 := by linarith [min_le_right.real d0 (complex.abs z0 / 2)]
    have hz_ge : complex.abs z0 / 2 ≤ complex.abs z
      have ht := complex.abs_sub_abs_le z0 z; rw [complex.abs_sub_comm z0 z] at ht; linarith
    have hz_ne : z ≠ complex.zero := by intro h0; rw [h0, complex.abs_zero] at hz_ge; linarith
    have hsub_ne : complex.sub z z0 ≠ complex.zero
      intro h0; apply hne; apply complex.ext
      · have hr : complex.re (complex.sub z z0) = complex.re complex.zero := by rw [h0]
        simp at hr; linarith
      · have hi : complex.im (complex.sub z z0) = complex.im complex.zero := by rw [h0]
        simp at hi; linarith
    constructor; exact hz_ne
    have hinv_prod : complex.inv (complex.mul z0 (complex.sub z z0)) = complex.mul (complex.inv z0) (complex.inv (complex.sub z z0))
      have hp_ne := complex.mul_ne_zero z0 (complex.sub z z0) hz0_ne hsub_ne
      have hc1 := complex.mul_inv_cancel (complex.mul z0 (complex.sub z z0)) hp_ne
      have hc2 := complex.mul_inv_cancel z0 hz0_ne
      have hc3 := complex.mul_inv_cancel (complex.sub z z0) hsub_ne
      have hprod : complex.mul (complex.mul z0 (complex.sub z z0)) (complex.mul (complex.inv z0) (complex.inv (complex.sub z z0))) = complex.one
        have hre : complex.mul (complex.mul z0 (complex.sub z z0)) (complex.mul (complex.inv z0) (complex.inv (complex.sub z z0))) = complex.mul (complex.mul z0 (complex.inv z0)) (complex.mul (complex.sub z z0) (complex.inv (complex.sub z z0)))
          apply complex.ext <;> simp <;> ring
        rw [hre, hc2, hc3, complex.one_mul]
      have h1 : complex.mul (complex.inv (complex.mul z0 (complex.sub z z0))) (complex.mul (complex.mul z0 (complex.sub z z0)) (complex.mul (complex.inv z0) (complex.inv (complex.sub z z0)))) = complex.mul (complex.inv (complex.mul z0 (complex.sub z z0))) complex.one := by rw [hprod]
      have h2 : complex.mul (complex.inv (complex.mul z0 (complex.sub z z0))) (complex.mul (complex.mul z0 (complex.sub z z0)) (complex.mul (complex.inv z0) (complex.inv (complex.sub z z0)))) = complex.mul (complex.mul (complex.mul z0 (complex.sub z z0)) (complex.inv (complex.mul z0 (complex.sub z z0)))) (complex.mul (complex.inv z0) (complex.inv (complex.sub z z0)))
        apply complex.ext <;> simp <;> ring
      rw [h2, hc1, complex.one_mul, complex.mul_one] at h1; exact h1.symm
    have hinv_diff : complex.mul (complex.sub (complex.inv z) (complex.inv z0)) (complex.inv (complex.sub z z0)) = complex.neg (complex.mul (complex.inv z) (complex.inv z0))
      have hcz := complex.mul_inv_cancel z hz_ne
      have hcz0 := complex.mul_inv_cancel z0 hz0_ne
      have hcs := complex.mul_inv_cancel (complex.sub z z0) hsub_ne
      have h1 : complex.sub (complex.inv z) (complex.inv z0) = complex.neg (complex.mul (complex.sub z z0) (complex.mul (complex.inv z) (complex.inv z0)))
        have hre : complex.neg (complex.mul (complex.sub z z0) (complex.mul (complex.inv z) (complex.inv z0))) = complex.sub (complex.mul (complex.mul z0 (complex.inv z0)) (complex.inv z)) (complex.mul (complex.mul z (complex.inv z)) (complex.inv z0))
          apply complex.ext <;> simp <;> ring
        rw [hre, hcz, hcz0, complex.one_mul, complex.one_mul]
      rw [h1]
      have h2 : complex.mul (complex.neg (complex.mul (complex.sub z z0) (complex.mul (complex.inv z) (complex.inv z0)))) (complex.inv (complex.sub z z0)) = complex.neg (complex.mul (complex.mul (complex.sub z z0) (complex.inv (complex.sub z z0))) (complex.mul (complex.inv z) (complex.inv z0)))
        apply complex.ext <;> simp <;> ring
      rw [h2, hcs, complex.one_mul]
    have hsplit : complex.sub (complex.mul (complex.inv z) (q_fn z)) (complex.neg (complex.mul (complex.of_real m_val) (complex.inv (complex.mul z0 (complex.sub z z0))))) = complex.add (complex.mul (complex.inv z) (complex.sub (q_fn z) (complex.neg (complex.mul (complex.of_real m_val) (complex.inv (complex.sub z z0)))))) (complex.mul (complex.of_real m_val) (complex.mul (complex.inv z) (complex.inv z0)))
