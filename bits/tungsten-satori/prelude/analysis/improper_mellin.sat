-- Milestone 3.24: Improper Complex Mellin Transform Holomorphy on Re(s) > sigma0,
--                 Landau Non-Negative Mellin Holomorphy + Dominance Bundle, and
--                 FULL Critical-Strip Complex Holomorphy of EVERY Non-Trivial Dirichlet
--                 L-Function L(chi, s) on Re(s) > 0 (0 CUSTOM AXIOMS!)
--
-- Direct, unconditional analytic breakthroughs advancing Frontiers #1 & #2:
--   1. `c_has_integral.abs_le_integral`:
--        General complex integral comparison theorem via conjugate rotation:
--        if |f(x)| <= g(x) on [a, b], then |int_a^b f(x) dx| <= int_a^b g(x) dx !
--   2. `mellin.has_cderiv_at_improper`:
--        EXACT COMPLEX HOLOMORPHY OF EVERY IMPROPER COMPLEX MELLIN TRANSFORM on Re(s) > sigma0:
--        if |H(x)| <= C * x^sigma0 on [X, inf) (X >= 1) and F(s) = lim int_X^{X+N} H(x) x^(-s-1) dx,
--        then at EVERY s0 with Re(s0) > sigma0, `has_cderiv_at F s0 V`!
--   3. `mellin.nonneg_dominance_and_holomorphy`:
--        For Landau's shifted Mellin integrand H(x) = G(x) + c * x^beta >= 0 on [X, inf),
--        proves BOTH complex holomorphy on Re(s) > beta AND complex-vs-real dominance
--        |F(sigma + i*gamma)| <= Re(F(sigma)) (directly advancing Frontier #2)!
--   4. `dirichlet_L.abel_step_has_integral` & `dirichlet_L.abel_step_deriv_has_integral`:
--        Exact constructive integral formulas on [n+1, n+2] for the Abel-summation step
--        (n+1)^(-s) - (n+2)^(-s) = int_{n+1}^{n+2} s * x^(-s-1) dx and its exact complex
--        derivative -(log(n+1))*(n+1)^(-s0) + (log(n+2))*(n+2)^(-s0) = int_{n+1}^{n+2} (1 - s0*log x) x^(-s0-1) dx!
--   5. `dirichlet_L.has_cderiv_at_re_pos`:
--        FULL COMPLEX HOLOMORPHY OF EVERY BOUNDED-PARTIAL-SUM DIRICHLET SERIES
--        (INCLUDING EVERY NON-TRIVIAL DIRICHLET L-FUNCTION L(chi, s)!) ON THE ENTIRE
--        HALF-PLANE Re(s) > 0: proves `∃ V, has_cderiv_at L s0 V` unconditionally (0 AXIOMS)!

import analysis.landau_oscillation
import analysis.zeta_continuation

-- ====================================================================================
-- 1. GENERAL COMPLEX INTEGRAL DOMINANCE: |int_a^b f| <= int_a^b g (0 AXIOMS!)
-- ====================================================================================

+ c_has_integral.abs_le_integral (f : ℝ → ℂ) (g : ℝ → ℝ) (a b J : ℝ) (I : ℂ)
    (hab : a ≤ b)
    (hI : c_has_integral f a b I)
    (hJ : darboux.has_integral g a b J)
    (hle : ∀ x, a ≤ x → x ≤ b → complex.abs (f x) ≤ g x) :
    complex.abs I ≤ J
  by_cases h0 : I = complex.zero
  · rw [h0, complex.abs_zero]
    have hz := darboux.const a b 0 hab
    have h00 : 0 * (b - a) = (0 : ℝ) := by ring
    rw [h00] at hz
    apply darboux.mono (fun _ => (0 : ℝ)) g a b 0 J hz hJ
    intro x hx1 hx2
    linarith [complex.abs_nonneg (f x), hle x hx1 hx2]
  · have habs_pos : 0 < complex.abs I
      have hnn := complex.abs_nonneg I
      by_contra hlt
      have hz : complex.abs I = 0 := by linarith
      exact h0 ((complex.abs_eq_zero I).mp hz)
    set u := complex.mul (complex.of_real (1 / complex.abs I)) (complex.conj I) with hu
    have hu_abs : complex.abs u = 1
      rw [hu, complex.abs_mul, complex.abs_conj]
      have h1_abs : complex.abs (complex.of_real (1 / complex.abs I)) = 1 / complex.abs I
        have hsq : complex.abs (complex.of_real (1 / complex.abs I)) * complex.abs (complex.of_real (1 / complex.abs I)) = (1 / complex.abs I) * (1 / complex.abs I)
          rw [complex.abs_sq]; unfold complex.norm_sq complex.of_real; simp
        have h1 := complex.abs_nonneg (complex.of_real (1 / complex.abs I))
        have h2 := one_div_pos.real (complex.abs I) habs_pos
        nlinarith
      rw [h1_abs]
      have hc := mul_inv_cancel.real (complex.abs I) (by linarith)
      rw [div_def.real 1 (complex.abs I)]
      linarith
    have huI_re : complex.re (complex.mul u I) = complex.abs I
      rw [hu]; unfold complex.of_real; simp
      have hns : complex.re I * complex.re I + complex.im I * complex.im I = complex.abs I * complex.abs I
        have hs := (complex.abs_sq I).symm
        unfold complex.norm_sq at hs; exact hs
      have hc := mul_inv_cancel.real (complex.abs I) (by linarith)
      rw [div_def.real 1 (complex.abs I)]
      linear_combination ((complex.abs I)⁻¹) * hns + complex.abs I * hc
    have hscaled := c_has_integral.scale_complex f a b u I hI
    unfold c_has_integral at hscaled
    have hre_int : darboux.has_integral (fun x => complex.re (complex.mul u (f x))) a b (complex.abs I) := by rw [← huI_re]; exact hscaled.1
    apply darboux.mono (fun x => complex.re (complex.mul u (f x))) g a b (complex.abs I) J hre_int hJ
    intro x hx1 hx2
    have h1 : complex.re (complex.mul u (f x)) ≤ complex.abs (complex.mul u (f x))
      have ha := complex.re_abs_le (complex.mul u (f x))
      linarith [le_abs_self.real (complex.re (complex.mul u (f x)))]
    rw [complex.abs_mul, hu_abs] at h1
    linarith [hle x hx1 hx2]

-- ====================================================================================
-- 2. IMPROPER COMPLEX MELLIN TRANSFORM HOLOMORPHY ON Re(s) > sigma0 (FRONTIER #2!)
-- ====================================================================================

-- THEOREM 1 (EXACT COMPLEX HOLOMORPHY OF IMPROPER MELLIN TRANSFORMS — 0 AXIOMS!):
+ mellin.has_cderiv_at_improper (H : ℝ → ℝ) (F_seq : ℕ → ℂ → ℂ) (V_seq : ℕ → ℂ)
    (F : ℂ → ℂ) (s0 V : ℂ) (X sigma0 C : ℝ)
    (hX : 1 ≤ X) (hC : 0 ≤ C) (hs0 : sigma0 < complex.re s0)
    (hH_bd : ∀ x, X ≤ x → |H x| ≤ C * rpow x sigma0)
    (hF_int : ∀ (N : ℕ) (s : ℂ), sigma0 < complex.re s →
      c_has_integral (fun x => complex.mul (complex.of_real (H x)) (cpow_real x (complex.neg (complex.add s complex.one)))) X (X + (N : ℝ)) (F_seq N s))
    (hV_int : ∀ (N : ℕ),
      c_has_integral (fun x => complex.mul (complex.of_real (H x * (-log x))) (cpow_real x (complex.neg (complex.add s0 complex.one)))) X (X + (N : ℝ)) (V_seq N))
    (hF_lim : ∀ s : ℂ, sigma0 < complex.re s → ctends_to (fun (N : ℕ) => F_seq N s) (F s))
    (hV_lim : ctends_to V_seq V) :
    has_cderiv_at F s0 V
  set delta := (complex.re s0 - sigma0) / 3 with hdelta
  have hdelta_pos : 0 < delta := by rw [hdelta]; linarith
  set M := 6 * C * (4 / (delta * delta)) / delta with hM
  have hM_nn : 0 ≤ M
    rw [hM]
    have h4 : 0 ≤ 4 / (delta * delta) := by linarith [div_pos.real 4 (delta * delta) (by decide) (by nlinarith)]
    exact div_nonneg.real (6 * C * (4 / (delta * delta))) delta (by nlinarith) (by linarith)
  apply has_cderiv_at.of_uniform_quad_limit F_seq V_seq F s0 V delta M hdelta_pos hM_nn
  · intro z hz
    have hre_z : sigma0 < complex.re z
      have h1 := complex.re_abs_le (complex.sub z s0)
      simp at h1
      have h2 : complex.re s0 - complex.re z ≤ complex.abs (complex.sub z s0) := by linarith [neg_le_abs.real (complex.re z - complex.re s0)]
      linarith
    exact hF_lim z hre_z
  · exact hV_lim
  · intro N z hz
    have hre_z : sigma0 < complex.re z
      have h1 := complex.re_abs_le (complex.sub z s0)
      simp at h1
      have h2 : complex.re s0 - complex.re z ≤ complex.abs (complex.sub z s0) := by linarith [neg_le_abs.real (complex.re z - complex.re s0)]
      linarith
    have hN_nn : (0 : ℝ) ≤ (N : ℝ) := (cast_le.real 0 N).mpr (by omega)
    have hXN : X ≤ X + (N : ℝ) := by linarith
    have hFz := hF_int N z hre_z
    have hF0 := hF_int N s0 hs0
    have hVN := hV_int N
    set z1 := complex.add z complex.one with hz1
    set s01 := complex.add s0 complex.one with hs01
    have hsub1 : complex.sub z1 s01 = complex.sub z s0
      rw [hz1, hs01]; apply complex.ext <;> simp <;> ring
    set fz := (fun x => complex.mul (complex.of_real (H x)) (cpow_real x (complex.neg z1))) with hfz
    set f0 := (fun x => complex.mul (complex.of_real (H x)) (cpow_real x (complex.neg s01))) with hf0
    set fv := (fun x => complex.mul (complex.of_real (H x * (-log x))) (cpow_real x (complex.neg s01))) with hfv
    have hneg0 := c_has_integral.scale_complex f0 X (X + (N : ℝ)) (complex.neg complex.one) (F_seq N s0) hF0
    have hdiff1 := c_has_integral.add fz (fun x => complex.mul (complex.neg complex.one) (f0 x)) X (X + (N : ℝ)) (F_seq N z) (complex.mul (complex.neg complex.one) (F_seq N s0)) hFz hneg0
    have hscV := c_has_integral.scale_complex fv X (X + (N : ℝ)) (complex.neg (complex.sub z s0)) (V_seq N) hVN
    have htot := c_has_integral.add (fun x => complex.add (fz x) (complex.mul (complex.neg complex.one) (f0 x))) (fun x => complex.mul (complex.neg (complex.sub z s0)) (fv x)) X (X + (N : ℝ)) (complex.add (F_seq N z) (complex.mul (complex.neg complex.one) (F_seq N s0))) (complex.mul (complex.neg (complex.sub z s0)) (V_seq N)) hdiff1 hscV
    have hval_eq : complex.add (complex.add (F_seq N z) (complex.mul (complex.neg complex.one) (F_seq N s0))) (complex.mul (complex.neg (complex.sub z s0)) (V_seq N)) = complex.sub (complex.sub (F_seq N z) (F_seq N s0)) (complex.mul (V_seq N) (complex.sub z s0)) := by ring
    rw [hval_eq] at htot
    -- Comparison integral: int_X^{X+N} (M * |z - s0|^2) * (delta * x^(-delta - 1)) dx <= M * |z - s0|^2!
    have hrpow_int := darboux.rpow_neg_power delta X (X + (N : ℝ)) (by linarith) hXN
    set K := M * (complex.abs (complex.sub z s0) * complex.abs (complex.sub z s0)) with hK
    have hK_nn : 0 ≤ K := by rw [hK]; exact mul_nonneg.real M (complex.abs (complex.sub z s0) * complex.abs (complex.sub z s0)) hM_nn (by nlinarith [complex.abs_nonneg (complex.sub z s0)])
    have hdom_int := darboux.scale (fun x => delta * rpow x (-delta - 1)) X (X + (N : ℝ)) (rpow X (-delta) - rpow (X + (N : ℝ)) (-delta)) K hrpow_int
    have hcomp := c_has_integral.abs_le_integral (fun x => complex.add (complex.add (fz x) (complex.mul (complex.neg complex.one) (f0 x))) (complex.mul (complex.neg (complex.sub z s0)) (fv x))) (fun x => K * (delta * rpow x (-delta - 1))) X (X + (N : ℝ)) (K * (rpow X (-delta) - rpow (X + (N : ℝ)) (-delta))) (complex.sub (complex.sub (F_seq N z) (F_seq N s0)) (complex.mul (V_seq N) (complex.sub z s0))) hXN htot hdom_int
    have hpt : ∀ x, X ≤ x → x ≤ X + (N : ℝ) → complex.abs (complex.add (complex.add (fz x) (complex.mul (complex.neg complex.one) (f0 x))) (complex.mul (complex.neg (complex.sub z s0)) (fv x))) ≤ K * (delta * rpow x (-delta - 1))
      intro x hx1 hx2
      have hx_ge1 : 1 ≤ x := by linarith
      rw [hfz, hf0, hfv]
      have hrearr : complex.add (complex.add (complex.mul (complex.of_real (H x)) (cpow_real x (complex.neg z1))) (complex.mul (complex.neg complex.one) (complex.mul (complex.of_real (H x)) (cpow_real x (complex.neg s01))))) (complex.mul (complex.neg (complex.sub z s0)) (complex.mul (complex.of_real (H x * (-log x))) (cpow_real x (complex.neg s01)))) = complex.mul (complex.of_real (H x)) (complex.sub (complex.sub (cpow_real x (complex.neg z1)) (cpow_real x (complex.neg s01))) (complex.mul (complex.mul (complex.of_real (-log x)) (cpow_real x (complex.neg s01))) (complex.sub z s0)))
        apply complex.ext <;> simp <;> ring
      rw [hrearr, complex.abs_mul]
      have hH_abs : complex.abs (complex.of_real (H x)) = |H x|
        have hsq : complex.abs (complex.of_real (H x)) * complex.abs (complex.of_real (H x)) = |H x| * |H x|
          have hsqa : |H x| * |H x| = H x * H x := sq_abs.real (H x)
          rw [complex.abs_sq, hsqa]; unfold complex.norm_sq complex.of_real; simp
        have h1 := complex.abs_nonneg (complex.of_real (H x))
        have h2 := abs_nonneg.real (H x)
        nlinarith
      rw [hH_abs]
      have hqt := cpow_real.quad_taylor_bound x delta z1 s01 hx_ge1 (by linarith) (by rw [hsub1]; linarith)
      rw [hsub1] at hqt
      have hre_s01 : -complex.re s01 + delta = -complex.re s0 - 1 + delta := by rw [hs01]; simp; ring
      rw [hre_s01] at hqt
      have hlsq := log_sq_le_rpow x delta hx_ge1 hdelta_pos
      have hr_mul : rpow x sigma0 * (rpow x delta * rpow x (-complex.re s0 - 1 + delta)) = rpow x (-delta - 1)
        unfold rpow; rw [← exp_add, ← exp_add]
        have he : sigma0 * log x + (delta * log x + (-complex.re s0 - 1 + delta) * log x) = (-delta - 1) * log x
          rw [hdelta]; ring
        rw [he]
      have hKdelta : K * delta = 6 * C * (4 / (delta * delta)) * (complex.abs (complex.sub z s0) * complex.abs (complex.sub z s0))
        rw [hK, hM]
        have hc := mul_inv_cancel.real delta (by linarith)
        rw [div_def.real (6 * C * (4 / (delta * delta))) delta]
        linear_combination (6 * C * (4 / (delta * delta)) * (complex.abs (complex.sub z s0) * complex.abs (complex.sub z s0))) * hc
      have hHx := hH_bd x hx1
      have hrem_nn := complex.abs_nonneg (complex.sub (complex.sub (cpow_real x (complex.neg z1)) (cpow_real x (complex.neg s01))) (complex.mul (complex.mul (complex.of_real (-log x)) (cpow_real x (complex.neg s01))) (complex.sub z s0)))
      have hm1 := mul_le_mul_of_nonneg_right.real (|H x|) (C * rpow x sigma0) (complex.abs (complex.sub (complex.sub (cpow_real x (complex.neg z1)) (cpow_real x (complex.neg s01))) (complex.mul (complex.mul (complex.of_real (-log x)) (cpow_real x (complex.neg s01))) (complex.sub z s0)))) hHx hrem_nn
      have hCx_nn : 0 ≤ C * rpow x sigma0 := mul_nonneg.real C (rpow x sigma0) hC (by linarith [rpow.pos x sigma0])
      have hm2 := mul_le_mul_of_nonneg_left.real (complex.abs (complex.sub (complex.sub (cpow_real x (complex.neg z1)) (cpow_real x (complex.neg s01))) (complex.mul (complex.mul (complex.of_real (-log x)) (cpow_real x (complex.neg s01))) (complex.sub z s0)))) (6 * (log x * log x) * rpow x (-complex.re s0 - 1 + delta) * (complex.abs (complex.sub z s0) * complex.abs (complex.sub z s0))) (C * rpow x sigma0) hqt hCx_nn
      have hfac_nn : 0 ≤ 6 * C * rpow x sigma0 * rpow x (-complex.re s0 - 1 + delta) * (complex.abs (complex.sub z s0) * complex.abs (complex.sub z s0))
        have h1 := mul_nonneg.real (6 * C) (rpow x sigma0) (by linarith) (by linarith [rpow.pos x sigma0])
        have h2 := mul_nonneg.real (6 * C * rpow x sigma0) (rpow x (-complex.re s0 - 1 + delta)) h1 (by linarith [rpow.pos x (-complex.re s0 - 1 + delta)])
        exact mul_nonneg.real (6 * C * rpow x sigma0 * rpow x (-complex.re s0 - 1 + delta)) (complex.abs (complex.sub z s0) * complex.abs (complex.sub z s0)) h2 (by nlinarith [complex.abs_nonneg (complex.sub z s0)])
      have hm3 := mul_le_mul_of_nonneg_right.real (log x * log x) ((4 / (delta * delta)) * rpow x delta) (6 * C * rpow x sigma0 * rpow x (-complex.re s0 - 1 + delta) * (complex.abs (complex.sub z s0) * complex.abs (complex.sub z s0))) hlsq hfac_nn
      have hl_eq : (log x * log x) * (6 * C * rpow x sigma0 * rpow x (-complex.re s0 - 1 + delta) * (complex.abs (complex.sub z s0) * complex.abs (complex.sub z s0))) = (C * rpow x sigma0) * (6 * (log x * log x) * rpow x (-complex.re s0 - 1 + delta) * (complex.abs (complex.sub z s0) * complex.abs (complex.sub z s0))) := by ring
      have hr_eq : (4 / (delta * delta)) * rpow x delta * (6 * C * rpow x sigma0 * rpow x (-complex.re s0 - 1 + delta) * (complex.abs (complex.sub z s0) * complex.abs (complex.sub z s0))) = (6 * C * (4 / (delta * delta)) * (complex.abs (complex.sub z s0) * complex.abs (complex.sub z s0))) * (rpow x sigma0 * (rpow x delta * rpow x (-complex.re s0 - 1 + delta))) := by ring
      rw [hl_eq, hr_eq, hr_mul, ← hKdelta] at hm3
      linarith
    have hbd := hcomp hpt
    have hX_le1 : rpow X (-delta) ≤ 1
      unfold rpow
      have hlogX : 0 ≤ log X
        have hl := (log_le_log 1 X (by decide) (by linarith)).mpr hX
        rw [log_one] at hl; exact hl
      have h := (exp_le_exp ((-delta) * log X) 0).mpr (by nlinarith)
      rw [exp_zero] at h; exact h
    have hsub_le1 : rpow X (-delta) - rpow (X + (N : ℝ)) (-delta) ≤ 1 := by linarith [rpow.pos (X + (N : ℝ)) (-delta)]
    have hm_fin := mul_le_mul_of_nonneg_left.real (rpow X (-delta) - rpow (X + (N : ℝ)) (-delta)) 1 K hsub_le1 hK_nn
    linarith

-- THEOREM 2 (LANDAU NON-NEGATIVE MELLIN HOLOMORPHY + COMPLEX-VS-REAL DOMINANCE BUNDLE!):
-- For H(x) = G(x) + c * x^beta >= 0 on [X, inf) with H(x) <= C * x^beta:
--   Proves BOTH holomorphy on Re(s) > beta AND |F(sigma + i*gamma)| <= Re(F(sigma))!
+ mellin.nonneg_dominance_and_holomorphy (G : ℝ → ℝ) (F_seq : ℕ → ℂ → ℂ) (V_seq : ℕ → ℂ)
    (F : ℂ → ℂ) (s0 V : ℂ) (X beta c C : ℝ)
    (hX : 1 ≤ X) (hC : 0 ≤ C) (hs0 : beta < complex.re s0)
    (hnonneg : ∀ x, X ≤ x → 0 ≤ G x + c * rpow x beta)
    (hub : ∀ x, X ≤ x → G x + c * rpow x beta ≤ C * rpow x beta)
    (hF_int : ∀ (N : ℕ) (s : ℂ), beta < complex.re s →
      c_has_integral (fun x => complex.mul (complex.of_real (G x + c * rpow x beta)) (cpow_real x (complex.neg (complex.add s complex.one)))) X (X + (N : ℝ)) (F_seq N s))
    (hV_int : ∀ (N : ℕ),
      c_has_integral (fun x => complex.mul (complex.of_real ((G x + c * rpow x beta) * (-log x))) (cpow_real x (complex.neg (complex.add s0 complex.one)))) X (X + (N : ℝ)) (V_seq N))
    (hF_lim : ∀ s : ℂ, beta < complex.re s → ctends_to (fun (N : ℕ) => F_seq N s) (F s))
    (hV_lim : ctends_to V_seq V) :
    has_cderiv_at F s0 V ∧
    (∀ (sigma gamma : ℝ), beta < sigma → complex.abs (F (complex.mk sigma gamma)) ≤ complex.re (F (complex.of_real sigma)))
  constructor
  · exact mellin.has_cderiv_at_improper (fun x => G x + c * rpow x beta) F_seq V_seq F s0 V X beta C hX hC hs0 (by intro x hx; rw [abs_of_nonneg.real (G x + c * rpow x beta) (hnonneg x hx)]; exact hub x hx) hF_int hV_int hF_lim hV_lim
  · intro sigma gamma hsig
    have hc_lim := hF_lim (complex.mk sigma gamma) (by simp)
    have hr_lim := hF_lim (complex.of_real sigma) (by simp)
    have hr_re_lim : tends_to (fun (N : ℕ) => complex.re (F_seq N (complex.of_real sigma))) (complex.re (F (complex.of_real sigma)))
      unfold ctends_to at hr_lim
      unfold tends_to; intro e he
      obtain ⟨N0, hN0⟩ := hr_lim e he
      use N0; intro N hN
      have h1 := hN0 N hN
      have h2 := complex.re_abs_le (complex.sub (F_seq N (complex.of_real sigma)) (F (complex.of_real sigma)))
      simp at h2; linarith
    apply mellin.limit_abs_le_real (fun (N : ℕ) => F_seq N (complex.mk sigma gamma)) (fun (N : ℕ) => complex.re (F_seq N (complex.of_real sigma))) (F (complex.mk sigma gamma)) (complex.re (F (complex.of_real sigma))) hc_lim hr_re_lim
    intro N
    have hN_nn : (0 : ℝ) ≤ (N : ℝ) := (cast_le.real 0 N).mpr (by omega)
    have hXN : X ≤ X + (N : ℝ) := by linarith
    have hIc := hF_int N (complex.mk sigma gamma) (by simp)
    have hIr_c := hF_int N (complex.of_real sigma) (by simp)
    unfold c_has_integral at hIr_c
    have hIr_eq : (fun x => complex.re (complex.mul (complex.of_real (G x + c * rpow x beta)) (cpow_real x (complex.neg (complex.add (complex.of_real sigma) complex.one))))) = (fun x => (G x + c * rpow x beta) * rpow x (-complex.re (complex.mk sigma gamma) - 1))
      funext x
      unfold cpow_real rpow complex.of_real; simp [cos_zero]
      have h0 : log x * (0 - (sigma + 1)) = (-sigma - 1) * log x := by ring
      rw [h0]; ring
    have hIr : darboux.has_integral (fun x => (G x + c * rpow x beta) * rpow x (-complex.re (complex.mk sigma gamma) - 1)) X (X + (N : ℝ)) (complex.re (F_seq N (complex.of_real sigma))) := by rw [← hIr_eq]; exact hIr_c.1
    exact mellin.abs_complex_le_real (fun x => G x + c * rpow x beta) X (X + (N : ℝ)) (complex.re (F_seq N (complex.of_real sigma))) (complex.mk sigma gamma) (F_seq N (complex.mk sigma gamma)) hXN (by intro x hx1 _; exact hnonneg x hx1) hIc hIr

-- ====================================================================================
-- 3. FULL CRITICAL-STRIP HOLOMORPHY OF NON-TRIVIAL DIRICHLET L-FUNCTIONS ON Re(s) > 0!
-- ====================================================================================

-- Abel-summation step term: d_n(s) = (n+1)^(-s) - (n+2)^(-s) = int_{n+1}^{n+2} s * x^(-s-1) dx!
-> abel_step_diff (s : ℂ) (n : ℕ) : ℂ :=
  complex.sub (cpow_real ((n + 1 : ℕ) : ℝ) (complex.neg s)) (cpow_real ((n + 2 : ℕ) : ℝ) (complex.neg s))

-- Exact closed-form derivative d_n'(s0) = -(log(n+1))*(n+1)^(-s0) + (log(n+2))*(n+2)^(-s0)!
-> abel_step_deriv (s0 : ℂ) (n : ℕ) : ℂ :=
  complex.sub
    (complex.mul (complex.of_real (-log ((n + 1 : ℕ) : ℝ))) (cpow_real ((n + 1 : ℕ) : ℝ) (complex.neg s0)))
    (complex.mul (complex.of_real (-log ((n + 2 : ℕ) : ℝ))) (cpow_real ((n + 2 : ℕ) : ℝ) (complex.neg s0)))

-- Helper: d_n(s) = int_{n+1}^{n+2} s * x^(-s - 1) dx !
+ dirichlet_L.abel_step_has_integral (s : ℂ) (n : ℕ) :
    c_has_integral (fun x => complex.mul s (cpow_real x (complex.neg (complex.add s complex.one)))) ((n + 1 : ℕ) : ℝ) ((n + 2 : ℕ) : ℝ) (abel_step_diff s n)
  set a := ((n + 1 : ℕ) : ℝ) with ha_def
  have ha_pos : 0 < a := by rw [ha_def]; exact (cast_pos.real (n + 1)).mpr (by omega)
  have ha1_eq : ((n + 2 : ℕ) : ℝ) = a + 1 := by rw [ha_def, cast_add.real n 2, cast_add.real n 1]; simp; ring
  rw [ha1_eq]
  set w1 := complex.neg (complex.add s complex.one) with hw1
  have hsub_eq : complex.sub (complex.neg s) complex.one = w1 := by rw [hw1]; ring
  obtain ⟨J_re, hJ_re⟩ := darboux.continuous (fun x => complex.re (complex.mul s (cpow_real x w1))) a (a + 1) (by linarith) (by intro t ht1 _; have hcp := cpow_real.continuous_re_im w1 t (by linarith); continuity)
  obtain ⟨J_im, hJ_im⟩ := darboux.continuous (fun x => complex.im (complex.mul s (cpow_real x w1))) a (a + 1) (by linarith) (by intro t ht1 _; have hcp := cpow_real.continuous_re_im w1 t (by linarith); continuity)
  have hd_re : ∀ t, a ≤ t → t ≤ a + 1 → has_deriv_within (fun x => -complex.re (cpow_real x (complex.neg s))) (fun z => a ≤ z ∧ z ≤ a + 1) t (complex.re (complex.mul s (cpow_real t w1)))
    intro t ht1 ht2
    have hd := (cpow_real.has_deriv_re_im (complex.neg s) a (a + 1) t ha_pos ht1 ht2).1
    have hsc := has_deriv_within.scale (-1) (fun x => complex.re (cpow_real x (complex.neg s))) (fun z => a ≤ z ∧ z ≤ a + 1) t (complex.re (complex.mul (complex.neg s) (cpow_real t (complex.sub (complex.neg s) complex.one)))) hd
    have hf : (fun x => (-1 : ℝ) * complex.re (cpow_real x (complex.neg s))) = (fun x => -complex.re (cpow_real x (complex.neg s))) := by funext x; ring
    have hv : (-1 : ℝ) * complex.re (complex.mul (complex.neg s) (cpow_real t (complex.sub (complex.neg s) complex.one))) = complex.re (complex.mul s (cpow_real t w1)) := by rw [hsub_eq]; simp; ring
    rw [hf, hv] at hsc; exact hsc
  have hd_im : ∀ t, a ≤ t → t ≤ a + 1 → has_deriv_within (fun x => -complex.im (cpow_real x (complex.neg s))) (fun z => a ≤ z ∧ z ≤ a + 1) t (complex.im (complex.mul s (cpow_real t w1)))
    intro t ht1 ht2
    have hd := (cpow_real.has_deriv_re_im (complex.neg s) a (a + 1) t ha_pos ht1 ht2).2
    have hsc := has_deriv_within.scale (-1) (fun x => complex.im (cpow_real x (complex.neg s))) (fun z => a ≤ z ∧ z ≤ a + 1) t (complex.im (complex.mul (complex.neg s) (cpow_real t (complex.sub (complex.neg s) complex.one)))) hd
    have hf : (fun x => (-1 : ℝ) * complex.im (cpow_real x (complex.neg s))) = (fun x => -complex.im (cpow_real x (complex.neg s))) := by funext x; ring
    have hv : (-1 : ℝ) * complex.im (complex.mul (complex.neg s) (cpow_real t (complex.sub (complex.neg s) complex.one))) = complex.im (complex.mul s (cpow_real t w1)) := by rw [hsub_eq]; simp; ring
    rw [hf, hv] at hsc; exact hsc
  have hftc_re := darboux.eval_primitive (fun x => -complex.re (cpow_real x (complex.neg s))) (fun x => complex.re (complex.mul s (cpow_real x w1))) a (a + 1) J_re hJ_re hd_re
  have hftc_im := darboux.eval_primitive (fun x => -complex.im (cpow_real x (complex.neg s))) (fun x => complex.im (complex.mul s (cpow_real x w1))) a (a + 1) J_im hJ_im hd_im
  have hre_eq : J_re = complex.re (abel_step_diff s n) := by unfold abel_step_diff; rw [ha1_eq, ← ha_def]; simp; linarith
  have him_eq : J_im = complex.im (abel_step_diff s n) := by unfold abel_step_diff; rw [ha1_eq, ← ha_def]; simp; linarith
  unfold c_has_integral
  rw [← hre_eq, ← him_eq]
  exact ⟨hJ_re, hJ_im⟩

-- Helper: d_n'(s0) = int_{n+1}^{n+2} (1 - s0 * log x) * x^(-s0 - 1) dx !
+ dirichlet_L.abel_step_deriv_has_integral (s0 : ℂ) (n : ℕ) :
    c_has_integral (fun x => complex.mul (complex.sub complex.one (complex.mul (complex.of_real (log x)) s0)) (cpow_real x (complex.neg (complex.add s0 complex.one)))) ((n + 1 : ℕ) : ℝ) ((n + 2 : ℕ) : ℝ) (abel_step_deriv s0 n)
  set a := ((n + 1 : ℕ) : ℝ) with ha_def
  have ha_pos : 0 < a := by rw [ha_def]; exact (cast_pos.real (n + 1)).mpr (by omega)
  have ha1_eq : ((n + 2 : ℕ) : ℝ) = a + 1 := by rw [ha_def, cast_add.real n 2, cast_add.real n 1]; simp; ring
  rw [ha1_eq]
  set w1 := complex.neg (complex.add s0 complex.one) with hw1
  have hsub_eq : complex.sub (complex.neg s0) complex.one = w1 := by rw [hw1]; ring
  obtain ⟨J_re, hJ_re⟩ := darboux.continuous (fun x => complex.re (complex.mul (complex.sub complex.one (complex.mul (complex.of_real (log x)) s0)) (cpow_real x w1))) a (a + 1) (by linarith) (by intro t ht1 _; have hcl := has_deriv_within.continuous_at_of_pos_log t (by linarith); have hcp := cpow_real.continuous_re_im w1 t (by linarith); continuity)
  obtain ⟨J_im, hJ_im⟩ := darboux.continuous (fun x => complex.im (complex.mul (complex.sub complex.one (complex.mul (complex.of_real (log x)) s0)) (cpow_real x w1))) a (a + 1) (by linarith) (by intro t ht1 _; have hcl := has_deriv_within.continuous_at_of_pos_log t (by linarith); have hcp := cpow_real.continuous_re_im w1 t (by linarith); continuity)
  have hd_re : ∀ t, a ≤ t → t ≤ a + 1 → has_deriv_within (fun x => -complex.re (complex.mul (complex.of_real (-log x)) (cpow_real x (complex.neg s0)))) (fun z => a ≤ z ∧ z ≤ a + 1) t (complex.re (complex.mul (complex.sub complex.one (complex.mul (complex.of_real (log t)) s0)) (cpow_real t w1)))
    intro t ht1 ht2
    have hd := (cpow_real.has_deriv_neg_log_mul (complex.neg s0) a (a + 1) t ha_pos ht1 ht2).1
    have hsc := has_deriv_within.scale (-1) (fun x => complex.re (complex.mul (complex.of_real (-log x)) (cpow_real x (complex.neg s0)))) (fun z => a ≤ z ∧ z ≤ a + 1) t (complex.re (complex.mul (complex.sub (complex.neg complex.one) (complex.mul (complex.of_real (log t)) (complex.neg s0))) (cpow_real t (complex.sub (complex.neg s0) complex.one)))) hd
    have hf : (fun x => (-1 : ℝ) * complex.re (complex.mul (complex.of_real (-log x)) (cpow_real x (complex.neg s0)))) = (fun x => -complex.re (complex.mul (complex.of_real (-log x)) (cpow_real x (complex.neg s0)))) := by funext x; ring
    have hv : (-1 : ℝ) * complex.re (complex.mul (complex.sub (complex.neg complex.one) (complex.mul (complex.of_real (log t)) (complex.neg s0))) (cpow_real t (complex.sub (complex.neg s0) complex.one))) = complex.re (complex.mul (complex.sub complex.one (complex.mul (complex.of_real (log t)) s0)) (cpow_real t w1)) := by rw [hsub_eq]; unfold complex.of_real; simp; ring
    rw [hf, hv] at hsc; exact hsc
  have hd_im : ∀ t, a ≤ t → t ≤ a + 1 → has_deriv_within (fun x => -complex.im (complex.mul (complex.of_real (-log x)) (cpow_real x (complex.neg s0)))) (fun z => a ≤ z ∧ z ≤ a + 1) t (complex.im (complex.mul (complex.sub complex.one (complex.mul (complex.of_real (log t)) s0)) (cpow_real t w1)))
    intro t ht1 ht2
    have hd := (cpow_real.has_deriv_neg_log_mul (complex.neg s0) a (a + 1) t ha_pos ht1 ht2).2
    have hsc := has_deriv_within.scale (-1) (fun x => complex.im (complex.mul (complex.of_real (-log x)) (cpow_real x (complex.neg s0)))) (fun z => a ≤ z ∧ z ≤ a + 1) t (complex.im (complex.mul (complex.sub (complex.neg complex.one) (complex.mul (complex.of_real (log t)) (complex.neg s0))) (cpow_real t (complex.sub (complex.neg s0) complex.one)))) hd
    have hf : (fun x => (-1 : ℝ) * complex.im (complex.mul (complex.of_real (-log x)) (cpow_real x (complex.neg s0)))) = (fun x => -complex.im (complex.mul (complex.of_real (-log x)) (cpow_real x (complex.neg s0)))) := by funext x; ring
    have hv : (-1 : ℝ) * complex.im (complex.mul (complex.sub (complex.neg complex.one) (complex.mul (complex.of_real (log t)) (complex.neg s0))) (cpow_real t (complex.sub (complex.neg s0) complex.one))) = complex.im (complex.mul (complex.sub complex.one (complex.mul (complex.of_real (log t)) s0)) (cpow_real t w1)) := by rw [hsub_eq]; unfold complex.of_real; simp; ring
    rw [hf, hv] at hsc; exact hsc
  have hftc_re := darboux.eval_primitive (fun x => -complex.re (complex.mul (complex.of_real (-log x)) (cpow_real x (complex.neg s0)))) (fun x => complex.re (complex.mul (complex.sub complex.one (complex.mul (complex.of_real (log x)) s0)) (cpow_real x w1))) a (a + 1) J_re hJ_re hd_re
  have hftc_im := darboux.eval_primitive (fun x => -complex.im (complex.mul (complex.of_real (-log x)) (cpow_real x (complex.neg s0)))) (fun x => complex.im (complex.mul (complex.sub complex.one (complex.mul (complex.of_real (log x)) s0)) (cpow_real x w1))) a (a + 1) J_im hJ_im hd_im
  have hre_eq : J_re = complex.re (abel_step_deriv s0 n) := by rw [hftc_re]; unfold abel_step_deriv; rw [ha1_eq, ← ha_def]; simp; ring
  have him_eq : J_im = complex.im (abel_step_deriv s0 n) := by rw [hftc_im]; unfold abel_step_deriv; rw [ha1_eq, ← ha_def]; simp; ring
  unfold c_has_integral
  rw [← hre_eq, ← him_eq]
  exact ⟨hJ_re, hJ_im⟩

-- THEOREM 3 (FULL COMPLEX HOLOMORPHY OF EVERY BOUNDED-PARTIAL-SUM DIRICHLET SERIES /
--            NON-TRIVIAL L(chi, s) ON THE ENTIRE HALF-PLANE Re(s) > 0 — 0 CUSTOM AXIOMS!):
+ dirichlet_L.has_cderiv_at_re_pos (A : ℕ → ℂ) (L : ℂ → ℂ) (s0 : ℂ) (MA : ℝ)
    (hMA : 0 ≤ MA) (hs0 : 0 < complex.re s0)
    (hA_bd : ∀ n : ℕ, complex.abs (A n) ≤ MA)
    (hL : ∀ s : ℂ, 0 < complex.re s → ctends_to (fun (N : ℕ) => csum N (fun n => complex.mul (A n) (abel_step_diff s n))) (L s)) :
    ∃ V : ℂ, has_cderiv_at L s0 V
  set delta := complex.re s0 / 3 with hdelta
  have hdelta_pos : 0 < delta := by rw [hdelta]; linarith
  -- Step 1: Absolute convergence of derivative series sum A(n) * abel_step_deriv s0 n!
  have hderiv_summable : csummable (fun n => complex.mul (A n) (abel_step_deriv s0 n))
    apply csummable.of_abs_summable (fun n => complex.mul (A n) (abel_step_deriv s0 n))
    set Cd := MA * (1 + complex.abs s0 * (1 + 4 / (delta * delta))) with hCd
    have hscaled := pseries.scaled_shift_summable delta Cd hdelta_pos
    apply summable.of_nonneg_le (fun n => complex.abs (complex.mul (A n) (abel_step_deriv s0 n))) (fun n => Cd * pseries.term (delta + 1) (n + 1))
    · intro n; exact complex.abs_nonneg (complex.mul (A n) (abel_step_deriv s0 n))
    · intro n
      rw [complex.abs_mul]
      set a := ((n + 1 : ℕ) : ℝ) with ha_def
      have ha1_eq : ((n + 2 : ℕ) : ℝ) = a + 1 := by rw [ha_def, cast_add.real n 2, cast_add.real n 1]; simp; ring
      have ha_ge1 : 1 ≤ a := by rw [ha_def]; exact (cast_le.real 1 (n + 1)).mpr (by omega)
      have hint := dirichlet_L.abel_step_deriv_has_integral s0 n
      rw [ha1_eq, ← ha_def] at hint
      set K0 := 1 + complex.abs s0 * (1 + 4 / (delta * delta)) with hK0
      have hK0_nn : 0 ≤ K0
        rw [hK0]
        have h4 : 0 ≤ 4 / (delta * delta) := by linarith [div_pos.real 4 (delta * delta) (by decide) (by nlinarith)]
        nlinarith [complex.abs_nonneg s0]
      have hml := c_has_integral.abs_le (fun x => complex.mul (complex.sub complex.one (complex.mul (complex.of_real (log x)) s0)) (cpow_real x (complex.neg (complex.add s0 complex.one)))) a (a + 1) (K0 * rpow a (-delta - 1)) (abel_step_deriv s0 n) (by linarith) (mul_nonneg.real K0 (rpow a (-delta - 1)) hK0_nn (by linarith [rpow.pos a (-delta - 1)])) hint
      have hpt : ∀ x, a ≤ x → x ≤ a + 1 → complex.abs (complex.mul (complex.sub complex.one (complex.mul (complex.of_real (log x)) s0)) (cpow_real x (complex.neg (complex.add s0 complex.one)))) ≤ K0 * rpow a (-delta - 1)
        intro x hx1 hx2
        have hx_ge1 : 1 ≤ x := by linarith
        have hlog_nn : 0 ≤ log x
          have hl := (log_le_log 1 x (by decide) (by linarith)).mpr hx_ge1
          rw [log_one] at hl; exact hl
        rw [complex.abs_mul, cpow_real.abs_neg_add_one x s0]
        have hcoeff : complex.abs (complex.sub complex.one (complex.mul (complex.of_real (log x)) s0)) ≤ K0 * rpow x delta
          have ht := complex.abs_sub_le_sum complex.one (complex.mul (complex.of_real (log x)) s0)
          rw [complex.abs_mul] at ht
          have h1_abs : complex.abs complex.one = 1
            have hsq : complex.abs complex.one * complex.abs complex.one = 1 := by rw [complex.abs_sq]; unfold complex.norm_sq; simp
            have hnn := complex.abs_nonneg complex.one
            nlinarith
          have hl_abs : complex.abs (complex.of_real (log x)) = log x
            have hsq : complex.abs (complex.of_real (log x)) * complex.abs (complex.of_real (log x)) = log x * log x := by rw [complex.abs_sq]; unfold complex.norm_sq complex.of_real; simp
            have hnn := complex.abs_nonneg (complex.of_real (log x))
            nlinarith
          rw [h1_abs, hl_abs] at ht
          have hr_ge1 : 1 ≤ rpow x delta
            unfold rpow
            have h := (exp_le_exp 0 (delta * log x)).mpr (by nlinarith)
            rw [exp_zero] at h; exact h
          have hlsq := log_sq_le_rpow x delta hx_ge1 hdelta_pos
          have hlog_bd : log x ≤ (1 + 4 / (delta * delta)) * rpow x delta := by nlinarith
          have hm := mul_le_mul_of_nonneg_left.real (log x) ((1 + 4 / (delta * delta)) * rpow x delta) (complex.abs s0) hlog_bd (complex.abs_nonneg s0)
          rw [hK0]; linarith
        have hr_prod : rpow x delta * rpow x (-complex.re s0 - 1) ≤ rpow a (-delta - 1)
          unfold rpow; rw [← exp_add]
          have hlog_a : log a ≤ log x := (log_le_log a x (by linarith) (by linarith)).mpr hx1
          have h1 : delta * log x + (-complex.re s0 - 1) * log x ≤ (-delta - 1) * log x := by rw [hdelta]; nlinarith
          have h2 : (-delta - 1) * log x ≤ (-delta - 1) * log a := by nlinarith
          exact (exp_le_exp (delta * log x + (-complex.re s0 - 1) * log x) ((-delta - 1) * log a)).mpr (by linarith)
        have hm1 := mul_le_mul_of_nonneg_right.real (complex.abs (complex.sub complex.one (complex.mul (complex.of_real (log x)) s0))) (K0 * rpow x delta) (rpow x (-complex.re s0 - 1)) hcoeff (by linarith [rpow.pos x (-complex.re s0 - 1)])
        have hm2 := mul_le_mul_of_nonneg_left.real (rpow x delta * rpow x (-complex.re s0 - 1)) (rpow a (-delta - 1)) K0 hr_prod hK0_nn
        linarith
      have hres := hml hpt
      have hlen : (a + 1) - a = 1 := by ring
      rw [hlen] at hres
      have hp_eq : pseries.term (delta + 1) (n + 1) = rpow a (-delta - 1)
        unfold pseries.term
        have hne0' : n + 1 ≠ 0 := by omega
        rw [if_neg hne0', ← ha_def]
        have he : -(delta + 1) = -delta - 1 := by ring
        rw [he]
      have hm1 := mul_le_mul_of_nonneg_right.real (complex.abs (A n)) MA (complex.abs (abel_step_deriv s0 n)) (hA_bd n) (complex.abs_nonneg (abel_step_deriv s0 n))
      have hm2 := mul_le_mul_of_nonneg_left.real (complex.abs (abel_step_deriv s0 n)) (K0 * rpow a (-delta - 1)) MA (by linarith) hMA
      rw [hp_eq, hCd]; linarith
    · exact hscaled
  unfold csummable cconverges at hderiv_summable
  obtain ⟨V, hV⟩ := hderiv_summable
  use V
  -- Step 2: Uniform quadratic remainder bound on |z - s0| < delta!
  set K_int := MA * (6 * (complex.abs s0 + delta) * (4 / (delta * delta)) + (1 + 4 / (delta * delta))) with hK_int
  set M_tot := K_int * ((1 + delta) / delta) with hM_tot
  have hK_int_nn : 0 ≤ K_int
    rw [hK_int]
    have h4 : 0 ≤ 4 / (delta * delta) := by linarith [div_pos.real 4 (delta * delta) (by decide) (by nlinarith)]
    nlinarith [complex.abs_nonneg s0]
  have hM_tot_nn : 0 ≤ M_tot
    rw [hM_tot]
    have hps_pos : 0 ≤ (1 + delta) / delta := by linarith [div_pos.real (1 + delta) delta (by linarith) hdelta_pos]
    exact mul_nonneg.real K_int ((1 + delta) / delta) hK_int_nn hps_pos
  apply has_cderiv_at.of_uniform_quad_limit (fun (N : ℕ) (s : ℂ) => csum N (fun n => complex.mul (A n) (abel_step_diff s n))) (fun (N : ℕ) => csum N (fun n => complex.mul (A n) (abel_step_deriv s0 n))) L s0 V delta M_tot hdelta_pos hM_tot_nn
  · intro z hz
    have hre_z : 0 < complex.re z
      have h1 := complex.re_abs_le (complex.sub z s0)
      simp at h1
      have h2 : complex.re s0 - complex.re z ≤ complex.abs (complex.sub z s0) := by linarith [neg_le_abs.real (complex.re z - complex.re s0)]
      rw [hdelta] at hz; linarith
    exact hL z hre_z
  · exact hV
  · intro N z hz
    have hcomb : complex.sub (complex.sub (csum N (fun n => complex.mul (A n) (abel_step_diff z n))) (csum N (fun n => complex.mul (A n) (abel_step_diff s0 n)))) (complex.mul (csum N (fun n => complex.mul (A n) (abel_step_deriv s0 n))) (complex.sub z s0)) = csum N (fun n => complex.mul (A n) (complex.sub (complex.sub (abel_step_diff z n) (abel_step_diff s0 n)) (complex.mul (abel_step_deriv s0 n) (complex.sub z s0))))
      induction N with k ih
      · rw [csum.zero, csum.zero, csum.zero, csum.zero]; ring
      · rw [succ_eq_add_one.nat, csum.succ, csum.succ, csum.succ, csum.succ, ← ih]; ring
    rw [hcomb]
    have htri := csum.abs_le_sum N (fun n => complex.mul (A n) (complex.sub (complex.sub (abel_step_diff z n) (abel_step_diff s0 n)) (complex.mul (abel_step_deriv s0 n) (complex.sub z s0))))
    have hterm_le : ∀ n : ℕ, n < N → complex.abs (complex.mul (A n) (complex.sub (complex.sub (abel_step_diff z n) (abel_step_diff s0 n)) (complex.mul (abel_step_deriv s0 n) (complex.sub z s0)))) ≤ (K_int * (complex.abs (complex.sub z s0) * complex.abs (complex.sub z s0))) * pseries.term (1 + delta) (n + 1)
      intro n _
      rw [complex.abs_mul]
      set a := ((n + 1 : ℕ) : ℝ) with ha_def
      have ha1_eq : ((n + 2 : ℕ) : ℝ) = a + 1 := by rw [ha_def, cast_add.real n 2, cast_add.real n 1]; simp; ring
      have ha_ge1 : 1 ≤ a := by rw [ha_def]; exact (cast_le.real 1 (n + 1)).mpr (by omega)
      have hIz := dirichlet_L.abel_step_has_integral z n
      have hI0 := dirichlet_L.abel_step_has_integral s0 n
      have hId := dirichlet_L.abel_step_deriv_has_integral s0 n
      rw [ha1_eq, ← ha_def] at hIz hI0 hId
      set z1 := complex.add z complex.one with hz1
      set s01 := complex.add s0 complex.one with hs01
      have hsub1 : complex.sub z1 s01 = complex.sub z s0
        rw [hz1, hs01]; apply complex.ext <;> simp <;> ring
      set fz := (fun x => complex.mul z (cpow_real x (complex.neg z1))) with hfz
      set f0 := (fun x => complex.mul s0 (cpow_real x (complex.neg s01))) with hf0
      set fd := (fun x => complex.mul (complex.sub complex.one (complex.mul (complex.of_real (log x)) s0)) (cpow_real x (complex.neg s01))) with hfd
      have hneg0 := c_has_integral.scale_complex f0 a (a + 1) (complex.neg complex.one) (abel_step_diff s0 n) hI0
      have hdiff1 := c_has_integral.add fz (fun x => complex.mul (complex.neg complex.one) (f0 x)) a (a + 1) (abel_step_diff z n) (complex.mul (complex.neg complex.one) (abel_step_diff s0 n)) hIz hneg0
      have hscd := c_has_integral.scale_complex fd a (a + 1) (complex.neg (complex.sub z s0)) (abel_step_deriv s0 n) hId
      have htot := c_has_integral.add (fun x => complex.add (fz x) (complex.mul (complex.neg complex.one) (f0 x))) (fun x => complex.mul (complex.neg (complex.sub z s0)) (fd x)) a (a + 1) (complex.add (abel_step_diff z n) (complex.mul (complex.neg complex.one) (abel_step_diff s0 n))) (complex.mul (complex.neg (complex.sub z s0)) (abel_step_deriv s0 n)) hdiff1 hscd
      have hval_eq : complex.add (complex.add (abel_step_diff z n) (complex.mul (complex.neg complex.one) (abel_step_diff s0 n))) (complex.mul (complex.neg (complex.sub z s0)) (abel_step_deriv s0 n)) = complex.sub (complex.sub (abel_step_diff z n) (abel_step_diff s0 n)) (complex.mul (abel_step_deriv s0 n) (complex.sub z s0))
        apply complex.ext <;> simp <;> ring
      rw [hval_eq] at htot
      set C0 := 6 * (complex.abs s0 + delta) * (4 / (delta * delta)) + (1 + 4 / (delta * delta)) with hC0
      have hC0_nn : 0 ≤ C0
        rw [hC0]
        have h4 : 0 ≤ 4 / (delta * delta) := by linarith [div_pos.real 4 (delta * delta) (by decide) (by nlinarith)]
        nlinarith [complex.abs_nonneg s0]
      set Mn := C0 * (complex.abs (complex.sub z s0) * complex.abs (complex.sub z s0)) * rpow a (-delta - 1) with hMn
      have hMn_nn : 0 ≤ Mn
        rw [hMn]
        have h1 := mul_nonneg.real C0 (complex.abs (complex.sub z s0) * complex.abs (complex.sub z s0)) hC0_nn (by nlinarith [complex.abs_nonneg (complex.sub z s0)])
        exact mul_nonneg.real (C0 * (complex.abs (complex.sub z s0) * complex.abs (complex.sub z s0))) (rpow a (-delta - 1)) h1 (by linarith [rpow.pos a (-delta - 1)])
      have hml := c_has_integral.abs_le (fun x => complex.add (complex.add (fz x) (complex.mul (complex.neg complex.one) (f0 x))) (complex.mul (complex.neg (complex.sub z s0)) (fd x))) a (a + 1) Mn (complex.sub (complex.sub (abel_step_diff z n) (abel_step_diff s0 n)) (complex.mul (abel_step_deriv s0 n) (complex.sub z s0))) (by linarith) hMn_nn htot
      have hpt : ∀ x, a ≤ x → x ≤ a + 1 → complex.abs (complex.add (complex.add (fz x) (complex.mul (complex.neg complex.one) (f0 x))) (complex.mul (complex.neg (complex.sub z s0)) (fd x))) ≤ Mn
        intro x hx1 hx2
        have hx_ge1 : 1 ≤ x := by linarith
        have hlog_nn : 0 ≤ log x
          have hl := (log_le_log 1 x (by decide) (by linarith)).mpr hx_ge1
          rw [log_one] at hl; exact hl
        rw [hfz, hf0, hfd]
        set h := complex.sub z s0 with hh
        set qz := cpow_real x (complex.neg z1) with hqz
        set q0 := cpow_real x (complex.neg s01) with hq0
        set Rq := complex.sub (complex.sub qz q0) (complex.mul (complex.mul (complex.of_real (-log x)) q0) h) with hRq
        have hdecomp : complex.add (complex.add (complex.mul z qz) (complex.mul (complex.neg complex.one) (complex.mul s0 q0))) (complex.mul (complex.neg h) (complex.mul (complex.sub complex.one (complex.mul (complex.of_real (log x)) s0)) q0)) = complex.add (complex.mul (complex.add s0 h) Rq) (complex.mul (complex.mul (complex.of_real (-log x)) q0) (complex.mul h h))
          rw [hRq, hh]; unfold complex.of_real; apply complex.ext <;> simp <;> ring
        rw [hdecomp]
        have htri_in := complex.abs_add_le (complex.mul (complex.add s0 h) Rq) (complex.mul (complex.mul (complex.of_real (-log x)) q0) (complex.mul h h))
        -- Bound Rq via `cpow_real.quad_taylor_bound`!
        have hRq_bd : complex.abs Rq ≤ 6 * (4 / (delta * delta)) * rpow x (-complex.re s0 - 1 + 2 * delta) * (complex.abs h * complex.abs h)
          have hqt := cpow_real.quad_taylor_bound x delta z1 s01 hx_ge1 (by linarith) (by rw [hsub1]; linarith)
          rw [hsub1, ← hqz, ← hq0, ← hRq] at hqt
          have hre_s01 : -complex.re s01 + delta = -complex.re s0 - 1 + delta := by rw [hs01]; simp; ring
          rw [hre_s01] at hqt
          have hlsq := log_sq_le_rpow x delta hx_ge1 hdelta_pos
          have hr_add : rpow x delta * rpow x (-complex.re s0 - 1 + delta) = rpow x (-complex.re s0 - 1 + 2 * delta)
            unfold rpow; rw [← exp_add]
            have he : delta * log x + (-complex.re s0 - 1 + delta) * log x = (-complex.re s0 - 1 + 2 * delta) * log x := by ring
            rw [he]
          have hfac_nn : 0 ≤ 6 * rpow x (-complex.re s0 - 1 + delta) * (complex.abs h * complex.abs h)
            have h1 := mul_nonneg.real 6 (rpow x (-complex.re s0 - 1 + delta)) (by decide) (by linarith [rpow.pos x (-complex.re s0 - 1 + delta)])
            exact mul_nonneg.real (6 * rpow x (-complex.re s0 - 1 + delta)) (complex.abs h * complex.abs h) h1 (by nlinarith [complex.abs_nonneg h])
          have hm := mul_le_mul_of_nonneg_right.real (log x * log x) ((4 / (delta * delta)) * rpow x delta) (6 * rpow x (-complex.re s0 - 1 + delta) * (complex.abs h * complex.abs h)) hlsq hfac_nn
          have hl_eq : (log x * log x) * (6 * rpow x (-complex.re s0 - 1 + delta) * (complex.abs h * complex.abs h)) = 6 * (log x * log x) * rpow x (-complex.re s0 - 1 + delta) * (complex.abs h * complex.abs h) := by ring
          have hr_eq : (4 / (delta * delta)) * rpow x delta * (6 * rpow x (-complex.re s0 - 1 + delta) * (complex.abs h * complex.abs h)) = 6 * (4 / (delta * delta)) * (rpow x delta * rpow x (-complex.re s0 - 1 + delta)) * (complex.abs h * complex.abs h) := by ring
          rw [hl_eq, hr_eq, hr_add] at hm
          linarith
        have hT1 : complex.abs (complex.mul (complex.add s0 h) Rq) ≤ (complex.abs s0 + delta) * 6 * (4 / (delta * delta)) * rpow x (-complex.re s0 - 1 + 2 * delta) * (complex.abs h * complex.abs h)
          rw [complex.abs_mul]
          have hs0h : complex.abs (complex.add s0 h) ≤ complex.abs s0 + delta
            have ht := complex.abs_add_le s0 h; linarith
          have hm1 := mul_le_mul_of_nonneg_right.real (complex.abs (complex.add s0 h)) (complex.abs s0 + delta) (complex.abs Rq) hs0h (complex.abs_nonneg Rq)
          have hm2 := mul_le_mul_of_nonneg_left.real (complex.abs Rq) (6 * (4 / (delta * delta)) * rpow x (-complex.re s0 - 1 + 2 * delta) * (complex.abs h * complex.abs h)) (complex.abs s0 + delta) hRq_bd (by linarith [complex.abs_nonneg s0])
          linarith
        have hT2 : complex.abs (complex.mul (complex.mul (complex.of_real (-log x)) q0) (complex.mul h h)) ≤ (1 + 4 / (delta * delta)) * rpow x (-complex.re s0 - 1 + 2 * delta) * (complex.abs h * complex.abs h)
          rw [complex.abs_mul, complex.abs_mul, complex.abs_mul, hq0, hs01, cpow_real.abs_neg_add_one x s0]
          have hl_abs : complex.abs (complex.of_real (-log x)) = log x
            have hsq : complex.abs (complex.of_real (-log x)) * complex.abs (complex.of_real (-log x)) = log x * log x
              rw [complex.abs_sq]; unfold complex.norm_sq complex.of_real; simp; ring
            have hnn := complex.abs_nonneg (complex.of_real (-log x))
            nlinarith
          rw [hl_abs]
          have hlog_bd : log x ≤ (1 + 4 / (delta * delta)) * rpow x (2 * delta)
            have hlsq := log_sq_le_rpow x delta hx_ge1 hdelta_pos
            have hr1 : 1 ≤ rpow x delta := by unfold rpow; have h1 := (exp_le_exp 0 (delta * log x)).mpr (by nlinarith); rw [exp_zero] at h1; exact h1
            have hr2 : rpow x delta ≤ rpow x (2 * delta) := by unfold rpow; exact (exp_le_exp (delta * log x) ((2 * delta) * log x)).mpr (by nlinarith)
            have h4 : 0 ≤ 4 / (delta * delta) := by linarith [div_pos.real 4 (delta * delta) (by decide) (by nlinarith)]
            have h1 : log x ≤ 1 + log x * log x := by nlinarith
            have h2 := mul_le_mul_of_nonneg_left.real (rpow x delta) (rpow x (2 * delta)) (4 / (delta * delta)) hr2 h4
            linarith
          have hr_add : rpow x (2 * delta) * rpow x (-complex.re s0 - 1) = rpow x (-complex.re s0 - 1 + 2 * delta)
            unfold rpow; rw [← exp_add]
            have he : 2 * delta * log x + (-complex.re s0 - 1) * log x = (-complex.re s0 - 1 + 2 * delta) * log x := by ring
            rw [he]
          have hm1 := mul_le_mul_of_nonneg_right.real (log x) ((1 + 4 / (delta * delta)) * rpow x (2 * delta)) (rpow x (-complex.re s0 - 1)) hlog_bd (by linarith [rpow.pos x (-complex.re s0 - 1)])
          have hm2 := mul_le_mul_of_nonneg_right.real (log x * rpow x (-complex.re s0 - 1)) ((1 + 4 / (delta * delta)) * rpow x (-complex.re s0 - 1 + 2 * delta)) (complex.abs h * complex.abs h) (by rw [← hr_add]; linarith) (by nlinarith [complex.abs_nonneg h])
          linarith
        have hr_ax : rpow x (-complex.re s0 - 1 + 2 * delta) ≤ rpow a (-delta - 1)
          unfold rpow
          have hlog_a : log a ≤ log x := (log_le_log a x (by linarith) (by linarith)).mpr hx1
          have h1 : (-complex.re s0 - 1 + 2 * delta) * log x = (-delta - 1) * log x := by rw [hdelta]; ring
          have h2 : (-delta - 1) * log x ≤ (-delta - 1) * log a := by nlinarith
          exact (exp_le_exp ((-complex.re s0 - 1 + 2 * delta) * log x) ((-delta - 1) * log a)).mpr (by linarith)
        have hC0_eq : (complex.abs s0 + delta) * 6 * (4 / (delta * delta)) + (1 + 4 / (delta * delta)) = C0
          rw [hC0]; ring
        have hm1 := mul_le_mul_of_nonneg_left.real (rpow x (-complex.re s0 - 1 + 2 * delta)) (rpow a (-delta - 1)) C0 hr_ax hC0_nn
        have hm2 := mul_le_mul_of_nonneg_right.real (C0 * rpow x (-complex.re s0 - 1 + 2 * delta)) (C0 * rpow a (-delta - 1)) (complex.abs h * complex.abs h) hm1 (by nlinarith [complex.abs_nonneg h])
        have hdist : ((complex.abs s0 + delta) * 6 * (4 / (delta * delta)) + (1 + 4 / (delta * delta))) * rpow x (-complex.re s0 - 1 + 2 * delta) * (complex.abs h * complex.abs h) = C0 * rpow x (-complex.re s0 - 1 + 2 * delta) * (complex.abs h * complex.abs h) := by rw [hC0_eq]
        linarith
      have hres := hml hpt
      have hlen : (a + 1) - a = 1 := by ring
      rw [hlen] at hres
      have hp_eq : pseries.term (1 + delta) (n + 1) = rpow a (-delta - 1)
        unfold pseries.term
        have hne0' : n + 1 ≠ 0 := by omega
        rw [if_neg hne0', ← ha_def]
        have he : -(1 + delta) = -delta - 1 := by ring
        rw [he]
      have hm1 := mul_le_mul_of_nonneg_right.real (complex.abs (A n)) MA (complex.abs (complex.sub (complex.sub (abel_step_diff z n) (abel_step_diff s0 n)) (complex.mul (abel_step_deriv s0 n) (complex.sub z s0)))) (hA_bd n) (complex.abs_nonneg (complex.sub (complex.sub (abel_step_diff z n) (abel_step_diff s0 n)) (complex.mul (abel_step_deriv s0 n) (complex.sub z s0))))
      have hm2 := mul_le_mul_of_nonneg_left.real (complex.abs (complex.sub (complex.sub (abel_step_diff z n) (abel_step_diff s0 n)) (complex.mul (abel_step_deriv s0 n) (complex.sub z s0)))) Mn MA (by linarith) hMA
      have hK_eq : MA * Mn = (K_int * (complex.abs (complex.sub z s0) * complex.abs (complex.sub z s0))) * rpow a (-delta - 1)
        rw [hMn, hK_int, hC0]; ring
      rw [hp_eq]; linarith
    have hsum_le := sum_le.real (fun n => complex.abs (complex.mul (A n) (complex.sub (complex.sub (abel_step_diff z n) (abel_step_diff s0 n)) (complex.mul (abel_step_deriv s0 n) (complex.sub z s0))))) (fun n => (K_int * (complex.abs (complex.sub z s0) * complex.abs (complex.sub z s0))) * pseries.term (1 + delta) (n + 1)) N hterm_le
    rw [sum_const_mul.real] at hsum_le
    have hshift : (∑ n < N, pseries.term (1 + delta) (n + 1)) = partial_sum (pseries.term (1 + delta)) (N + 1)
      unfold partial_sum
      rw [sum_range_succ'.real (pseries.term (1 + delta)) N]
      have h0 : pseries.term (1 + delta) 0 = 0 := by unfold pseries.term; simp
      rw [h0]; ring
    have hps_ub := pseries.partial_sum_le (1 + delta) (by linarith) (N + 1)
    have hsub1 : (1 + delta) - 1 = delta := by ring
    rw [hsub1] at hps_ub
    rw [hshift] at hsum_le
    have hKh_nn : 0 ≤ K_int * (complex.abs (complex.sub z s0) * complex.abs (complex.sub z s0)) :=
      mul_nonneg.real K_int (complex.abs (complex.sub z s0) * complex.abs (complex.sub z s0)) hK_int_nn (by nlinarith [complex.abs_nonneg (complex.sub z s0)])
    have hps_fin := mul_le_mul_of_nonneg_left.real (partial_sum (pseries.term (1 + delta)) (N + 1)) ((1 + delta) / delta) (K_int * (complex.abs (complex.sub z s0) * complex.abs (complex.sub z s0))) hps_ub hKh_nn
    have hM_eq : K_int * (complex.abs (complex.sub z s0) * complex.abs (complex.sub z s0)) * ((1 + delta) / delta) = M_tot * (complex.abs (complex.sub z s0) * complex.abs (complex.sub z s0)) := by rw [hM_tot]; ring
    linarith
