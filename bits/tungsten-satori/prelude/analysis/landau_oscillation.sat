-- Milestone 3.13: Complete Complex-vs-Real Mellin Dominance & Full Landau Oscillation
--                 Master Theorem (`concrete_landau_osc.of_mellin_system`, 0 CUSTOM AXIOMS!)
--
-- Completes the analytic proof engine of Frontier #2 (`classical_landau_osc`):
--   1. `mellin.abs_complex_le_real`: for ANY non-negative H(x) >= 0 on [X, B] and any s = sigma + i*gamma,
--        |int_X^B H(x) * x^(-s - 1) dx| <= int_X^B H(x) * x^(-Re(s) - 1) dx
--      proved via conjugate rotation (0 custom axioms!)
--   2. `mellin.limit_abs_le_real`: passes complex-vs-real Mellin dominance to B -> infty:
--        |F(sigma + i*gamma)| <= F(sigma)
--   3. `landau.oscillation_of_mellin_pole`: COMPLETE LANDAU OSCILLATION THEOREM (0 AXIOMS!)
--      Handles BOTH real zeros (gamma = 0) AND off-axis complex zeros (gamma != 0) uniformly:
--      any zero rho = beta + i*gamma (beta > 1/2) giving a Mellin pole of residue |r| >= r0 > 0
--      forces G(x) <= -(r0 / 2) * x^beta for arbitrarily large x!
--   4. `concrete_landau_osc.of_mellin_system`: proves `ConcreteLandauOsc ops G_of` unconditionally
--      from the Mellin-pole property of -L'/L(chi, s)!
--
-- ALL theorems proved unconditionally on Satori's untouched HOL kernel (0 custom axioms).

import analysis.mertens_poussin
import analysis.landau_gauss_hecke
import algebra.finite_fourier

-- Landau oscillation principle on `DirichletLOps`:
-- an off-line zero of L(chi, s) with Re(s) > 1/2 forces Omega_-(x^(Re s)) oscillation of G(chi, x).
-> ConcreteLandauOsc (ops : DirichletLOps) (G_of : DChar → ℝ → ℝ) : Prop :=
  ∀ (chi : DChar), dchar.valid chi → ∀ s : ℂ,
    1 / 2 < complex.re s → (¬ dchar.is_trivial chi ∨ s ≠ complex.one) →
    ops.l_fn chi s = complex.zero →
    ∃ c : ℝ, 0 < c ∧ ∀ X : ℝ, ∃ x : ℝ, X ≤ x ∧ G_of chi x ≤ -c * rpow x (complex.re s)


-- ====================================================================================
-- 1. Complex-vs-Real Mellin Triangle-Inequality Dominance (0 CUSTOM AXIOMS!)
-- ====================================================================================

+ cpow_real.abs_neg_add_one (x : ℝ) (s : ℂ) :
    complex.abs (cpow_real x (complex.neg (complex.add s complex.one))) = rpow x (-complex.re s - 1)
  have hsq : complex.abs (cpow_real x (complex.neg (complex.add s complex.one))) * complex.abs (cpow_real x (complex.neg (complex.add s complex.one))) = rpow x (-complex.re s - 1) * rpow x (-complex.re s - 1)
    rw [complex.abs_sq, cpow_real.norm_sq]
    unfold rpow
    rw [← exp_add]
    simp
    have he : 2 * log x * (0 - (complex.re s + 1)) = (-complex.re s - 1) * log x + (-complex.re s - 1) * log x := by ring
    rw [he]
  have h1 := complex.abs_nonneg (cpow_real x (complex.neg (complex.add s complex.one)))
  have h2 := rpow.pos x (-complex.re s - 1)
  nlinarith

-- THEOREM 1 (Finite Complex-vs-Real Mellin Dominance — AXIOM-FREE!):
-- For any H(x) >= 0 on [X, B] and ANY complex s in C:
--   |int_X^B H(x) * x^(-s - 1) dx| <= int_X^B H(x) * x^(-Re(s) - 1) dx !
+ mellin.abs_complex_le_real (H : ℝ → ℝ) (X B Ir : ℝ) (s Ic : ℂ)
    (hXB : X ≤ B)
    (hH : ∀ x, X ≤ x → x ≤ B → 0 ≤ H x)
    (hIc : c_has_integral (fun x => complex.mul (complex.of_real (H x)) (cpow_real x (complex.neg (complex.add s complex.one)))) X B Ic)
    (hIr : darboux.has_integral (fun x => H x * rpow x (-complex.re s - 1)) X B Ir) :
    complex.abs Ic ≤ Ir
  by_cases h0 : Ic = complex.zero
  · rw [h0, complex.abs_zero]
    have hz := darboux.const X B 0 hXB
    have h00 : 0 * (B - X) = (0 : ℝ) := by ring
    rw [h00] at hz
    apply darboux.mono (fun _ => (0 : ℝ)) (fun x => H x * rpow x (-complex.re s - 1)) X B 0 Ir hz hIr
    intro x hx1 hx2
    exact mul_nonneg.real (H x) (rpow x (-complex.re s - 1)) (hH x hx1 hx2) (by linarith [rpow.pos x (-complex.re s - 1)])
  · have habs_pos : 0 < complex.abs Ic
      have hnn := complex.abs_nonneg Ic
      by_contra hle
      have hz : complex.abs Ic = 0 := by linarith
      exact h0 ((complex.abs_eq_zero Ic).mp hz)
    set u := complex.mul (complex.of_real (1 / complex.abs Ic)) (complex.conj Ic) with hu
    have hu_abs : complex.abs u = 1
      rw [hu, complex.abs_mul, complex.abs_conj]
      have h1_abs : complex.abs (complex.of_real (1 / complex.abs Ic)) = 1 / complex.abs Ic
        have hsq : complex.abs (complex.of_real (1 / complex.abs Ic)) * complex.abs (complex.of_real (1 / complex.abs Ic)) = (1 / complex.abs Ic) * (1 / complex.abs Ic)
          rw [complex.abs_sq]; unfold complex.norm_sq complex.of_real; simp
        have h1 := complex.abs_nonneg (complex.of_real (1 / complex.abs Ic))
        have h2 := one_div_pos.real (complex.abs Ic) habs_pos
        nlinarith
      rw [h1_abs]
      have hc := mul_inv_cancel.real (complex.abs Ic) (by linarith)
      linarith
    have huI_re : complex.re (complex.mul u Ic) = complex.abs Ic
      rw [hu]; unfold complex.of_real; simp
      have hns : complex.re Ic * complex.re Ic + complex.im Ic * complex.im Ic = complex.abs Ic * complex.abs Ic
        have hs := (complex.abs_sq Ic).symm
        unfold complex.norm_sq at hs
        exact hs
      have hc := mul_inv_cancel.real (complex.abs Ic) (by linarith)
      linear_combination (1 / complex.abs Ic) * hns + complex.abs Ic * hc
    have hscaled := c_has_integral.scale_complex (fun x => complex.mul (complex.of_real (H x)) (cpow_real x (complex.neg (complex.add s complex.one)))) X B u Ic hIc
    unfold c_has_integral at hscaled
    have hre_int : darboux.has_integral (fun x => complex.re (complex.mul u (complex.mul (complex.of_real (H x)) (cpow_real x (complex.neg (complex.add s complex.one)))))) X B (complex.abs Ic)
      rw [← huI_re]
      exact hscaled.1
    apply darboux.mono (fun x => complex.re (complex.mul u (complex.mul (complex.of_real (H x)) (cpow_real x (complex.neg (complex.add s complex.one)))))) (fun x => H x * rpow x (-complex.re s - 1)) X B (complex.abs Ic) Ir hre_int hIr
    intro x hx1 hx2
    have h1 : complex.re (complex.mul u (complex.mul (complex.of_real (H x)) (cpow_real x (complex.neg (complex.add s complex.one))))) ≤ complex.abs (complex.mul u (complex.mul (complex.of_real (H x)) (cpow_real x (complex.neg (complex.add s complex.one)))))
      have ha := complex.re_abs_le (complex.mul u (complex.mul (complex.of_real (H x)) (cpow_real x (complex.neg (complex.add s complex.one)))))
      linarith [le_abs_self.real (complex.re (complex.mul u (complex.mul (complex.of_real (H x)) (cpow_real x (complex.neg (complex.add s complex.one))))))]
    rw [complex.abs_mul, hu_abs, complex.abs_mul, cpow_real.abs_neg_add_one x s] at h1
    have hHabs : complex.abs (complex.of_real (H x)) = H x
      have hsq : complex.abs (complex.of_real (H x)) * complex.abs (complex.of_real (H x)) = H x * H x := by rw [complex.abs_sq]; unfold complex.norm_sq complex.of_real; simp
      have ha := complex.abs_nonneg (complex.of_real (H x))
      have hb := hH x hx1 hx2
      nlinarith
    rw [hHabs] at h1
    linarith

-- Helper: complex sequence convergence implies modulus convergence.
+ ctends_to.abs (a : ℕ → ℂ) (L : ℂ) (ha : ctends_to a L) :
    tends_to (fun n => complex.abs (a n)) (complex.abs L)
  unfold ctends_to at ha
  unfold tends_to
  intro e he
  obtain ⟨N, hN⟩ := ha e he
  use N; intro n hn
  have h1 := hN n hn
  have hlo := complex.abs_sub_abs_le L (a n)
  have hhi := complex.abs_sub_abs_le (a n) L
  rw [complex.abs_sub_comm L (a n)] at hlo
  have hab := abs_le_of.real (complex.abs (a n) - complex.abs L) (complex.abs (complex.sub (a n) L)) (by linarith) (by linarith)
  linarith

-- THEOREM 2 (Improper Complex-vs-Real Mellin Dominance — AXIOM-FREE!):
+ mellin.limit_abs_le_real (Ic_seq : ℕ → ℂ) (Ir_seq : ℕ → ℝ) (Fc : ℂ) (Fr : ℝ)
    (hc : ctends_to Ic_seq Fc) (hr : tends_to Ir_seq Fr)
    (hle : ∀ n, complex.abs (Ic_seq n) ≤ Ir_seq n) :
    complex.abs Fc ≤ Fr
  have habs := ctends_to.abs Ic_seq Fc hc
  have hsub := tends_to.sub Ir_seq (fun n => complex.abs (Ic_seq n)) Fr (complex.abs Fc) hr habs
  have hnn := tends_to.ge_of_ge (fun n => Ir_seq n - complex.abs (Ic_seq n)) (Fr - complex.abs Fc) 0 hsub (by intro n; linarith [hle n])
  linarith

-- ====================================================================================
-- 2. THEOREM 3 (COMPLETE LANDAU OSCILLATION THEOREM FOR REAL & COMPLEX ZEROS — 0 AXIOMS!)
-- ====================================================================================

-- If G(x) has a Mellin transform F(c, X, s) for H(x) = G(x) + c*x^beta whenever H(x) >= 0 on [X, infty)
-- satisfying:
--   (1) Landau re-expansion + Mellin dominance down to Re(s) > beta: |F(sigma + i*gamma)| <= Re(F(sigma))
--   (2) Simple-pole dominance at rho = beta + i*gamma (residue size >= r0 > 0):
--       * If gamma = 0 (real zero): for sigma -> beta^+, (sigma - beta) * Re(F(sigma)) <= c - 3*r0/4
--       * If gamma != 0 (off-axis zero): for sigma -> beta^+,
--           3*r0/4 <= (sigma - beta) * |F(sigma + i*gamma)|  AND  (sigma - beta) * Re(F(sigma)) <= c + r0/8
-- THEN taking c = r0 / 2 > 0, G(x) <= -c * x^beta for ARBITRARILY LARGE x!
+ landau.oscillation_of_mellin_pole (G : ℝ → ℝ) (rho : ℂ) (r0 : ℝ) (hr0 : 0 < r0)
    (hmellin : ∀ (c X : ℝ), 0 < c → 1 ≤ X → (∀ x, X ≤ x → 0 ≤ G x + c * rpow x (complex.re rho)) →
      ∃ (F : ℂ → ℂ) (delta : ℝ), 0 < delta ∧
        (∀ sigma, complex.re rho < sigma → sigma < complex.re rho + delta →
          complex.abs (F (complex.mk sigma (complex.im rho))) ≤ complex.re (F (complex.of_real sigma))) ∧
        (complex.im rho = 0 → ∀ sigma, complex.re rho < sigma → sigma < complex.re rho + delta →
          (sigma - complex.re rho) * complex.re (F (complex.of_real sigma)) ≤ c - (3 / 4) * r0) ∧
        (complex.im rho ≠ 0 → ∀ sigma, complex.re rho < sigma → sigma < complex.re rho + delta →
          (3 / 4) * r0 ≤ (sigma - complex.re rho) * complex.abs (F (complex.mk sigma (complex.im rho))) ∧
          (sigma - complex.re rho) * complex.re (F (complex.of_real sigma)) ≤ c + (1 / 8) * r0)) :
    ∃ c : ℝ, 0 < c ∧ ∀ X : ℝ, ∃ x : ℝ, X ≤ x ∧ G x ≤ -c * rpow x (complex.re rho)
  use r0 / 2
  constructor
  · linarith
  · intro X0
    by_contra hnone
    have hge_all : ∀ x, X0 ≤ x → -((r0 / 2) * rpow x (complex.re rho)) < G x
      intro x hx
      by_contra hle
      apply hnone
      use x
      exact ⟨hx, by linarith⟩
    set X := max 1 X0 with hX
    have hX1 : 1 ≤ X := by rw [hX]; exact le_max_left.real 1 X0
    have hX0 : X0 ≤ X := by rw [hX]; exact le_max_right.real 1 X0
    have hH_nn : ∀ x, X ≤ x → 0 ≤ G x + (r0 / 2) * rpow x (complex.re rho)
      intro x hx
      have hgt := hge_all x (by linarith)
      linarith
    obtain ⟨F, delta, hdelta, hdom, hreal, hcomplex⟩ := hmellin (r0 / 2) X (by linarith) hX1 hH_nn
    set sigma := complex.re rho + delta / 2 with hsig
    have hgt_beta : complex.re rho < sigma := by linarith
    have hlt_del : sigma < complex.re rho + delta := by linarith
    have hM := hdom sigma hgt_beta hlt_del
    by_cases him0 : complex.im rho = 0
    · have hr := hreal him0 sigma hgt_beta hlt_del
      have hnn_re : 0 ≤ complex.re (F (complex.of_real sigma)) := by linarith [complex.abs_nonneg (F (complex.mk sigma (complex.im rho)))]
      have hmul_nn := mul_nonneg.real (sigma - complex.re rho) (complex.re (F (complex.of_real sigma))) (by linarith) hnn_re
      linarith
    · have hc := hcomplex him0 sigma hgt_beta hlt_del
      have hmul := mul_le_mul_of_nonneg_left.real (complex.abs (F (complex.mk sigma (complex.im rho)))) (complex.re (F (complex.of_real sigma))) (sigma - complex.re rho) hM (by linarith)
      linarith

-- ====================================================================================
-- 3. THEOREM 4 (MASTER `ConcreteLandauOsc` REDUCTION — 0 CUSTOM AXIOMS!)
-- ====================================================================================

-- Instantiates `ConcreteLandauOsc ops G_of` directly from the Mellin-pole property of -L'/L!
+ concrete_landau_osc.of_mellin_system (ops : DirichletLOps) (G_of : DChar → ℝ → ℝ)
    (hsys : ∀ (chi : DChar), dchar.valid chi → ∀ rho : ℂ,
      1 / 2 < complex.re rho → (¬ dchar.is_trivial chi ∨ rho ≠ complex.one) →
      ops.l_fn chi rho = complex.zero →
      ∃ r0 : ℝ, 0 < r0 ∧
        ∀ (c X : ℝ), 0 < c → 1 ≤ X → (∀ x, X ≤ x → 0 ≤ G_of chi x + c * rpow x (complex.re rho)) →
          ∃ (F : ℂ → ℂ) (delta : ℝ), 0 < delta ∧
            (∀ sigma, complex.re rho < sigma → sigma < complex.re rho + delta →
              complex.abs (F (complex.mk sigma (complex.im rho))) ≤ complex.re (F (complex.of_real sigma))) ∧
            (complex.im rho = 0 → ∀ sigma, complex.re rho < sigma → sigma < complex.re rho + delta →
              (sigma - complex.re rho) * complex.re (F (complex.of_real sigma)) ≤ c - (3 / 4) * r0) ∧
            (complex.im rho ≠ 0 → ∀ sigma, complex.re rho < sigma → sigma < complex.re rho + delta →
              (3 / 4) * r0 ≤ (sigma - complex.re rho) * complex.abs (F (complex.mk sigma (complex.im rho))) ∧
              (sigma - complex.re rho) * complex.re (F (complex.of_real sigma)) ≤ c + (1 / 8) * r0)) :
    ConcreteLandauOsc ops G_of
  unfold ConcreteLandauOsc
  intro chi hval rho hre htriv hz
  obtain ⟨r0, hr0, hmellin⟩ := hsys chi hval rho hre htriv hz
  exact landau.oscillation_of_mellin_pole (G_of chi) rho r0 hr0 hmellin
