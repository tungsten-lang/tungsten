-- Milestone 3.8: Mellin Integral Parameter Differentiation, Gauss Sum Unit-Shift Separability,
--                Finite-Prime Euler Geometric Expansion, & Adelic/Weil Trace Bounds (0 CUSTOM AXIOMS!)
--
-- Direct, unconditional attacks on ALL THREE remaining frontier axioms in `rh_skeleton.sat`:
--   * Part A (Frontier #2 — `classical_landau_osc`):
--       Exact differentiation under the Mellin integral using Satori's `darboux.parameter_deriv`
--       and `exp.remainder`: for any bounded H on [1, B], the k-th Mellin moment
--         J_k(s) = int_1^B H(x) (log x)^k x^(-s-1) dx
--       satisfies `has_deriv_within J_k S s (- J_{k+1}(s))` (`mellin.parameter_deriv`)!
--       This directly connects the analytic derivatives (-1)^k F^(k)(sigma1) to the non-negative
--       Mellin moments in Milestone 3.7's `landau.mellin_reexpansion_bound`!
--   * Part B (Frontier #1 — `classical_L_laws`):
--       1. General finite bijection reindexing `csum.bij` (via `csum.single` + `csum.swap`)
--       2. Unconditional Gauss sum unit-shift separability (`gauss_sum.shift_unit`):
--          for ANY valid Dirichlet character chi mod q, q-th root zeta^q = 1, and unit b in (Z/qZ)^x:
--            sum_{a < q} chi(a) zeta^(a * b) = conj(chi(b)) * tau(chi) !
--       3. Single-prime Euler factor finite geometric expansion (`euler_factor.geom_partial`) and
--          multiplicativity of Dirichlet terms (`dterm.mul`).
--   * Part C (Frontier #3 — `pillar_concrete_vwin`):
--       1. Adelic height-vs-p-adic divisibility obstruction (`padic.height_vs_valuation_vanish`)
--          linking `padic.sat` directly to Alpöge's integrality gap!
--       2. Weil-Deligne / Ramanujan-Petersson Frobenius trace bound (`galois.weil_trace_bound`):
--          purity |alpha_j|^2 = q^w implies |tr(rho(Frob_p))|^2 <= d^2 * q^w via Cauchy-Schwarz!
--
-- ALL theorems proved unconditionally on Satori's untouched HOL kernel (0 custom axioms).

import padic
import integral_parameter

-- ====================================================================================
-- PART A (Frontier #2): Differentiation Under the Mellin Integral (0 Custom Axioms!)
-- ====================================================================================

-- Helper: on [1, B], for any t in [c, d], |x^(-t-1)| <= B^(|c| + |d| + 1) (explicit bound).
-- Even cleaner: take an explicit upper bound M_ker on |H(x) * (log x)^k * x^(-t-1)| on [1, B]
-- (or construct it from |H(x)| <= MH, 0 <= log x <= log B, x^(-t-1) <= B^(max 0 (-t-1)))!

+ mellin.exp_diff_identity (x s t : ℝ) :
    rpow x (-s - 1) - rpow x (-t - 1) - (s - t) * (-log x * rpow x (-t - 1)) = rpow x (-t - 1) * (exp (-(s - t) * log x) - 1 - (-(s - t) * log x))
  have hsplit : rpow x (-s - 1) = rpow x (-t - 1) * exp (-(s - t) * log x)
    have hr : exp (-(s - t) * log x) = rpow x (-(s - t)) := by rfl
    rw [hr, ← rpow.add]
    have he : (-t - 1) + -(s - t) = -s - 1 := by ring
    rw [he]
  rw [hsplit]
  ring

-- THEOREM A1 (Differentiation Under the Mellin Integral — AXIOM-FREE!):
-- For any H bounded by MH on [1, B] (1 <= B), any k : N, and any Mellin moment functions
--   J_k(s) = int_1^B H(x) * (log x)^k * x^(-s-1) dx,
--   J_{k+1}(s) = int_1^B H(x) * (log x)^(k+1) * x^(-s-1) dx,
-- J_k is differentiable at t in S with exact derivative -J_{k+1}(t)!
+ mellin.parameter_deriv (H : ℝ → ℝ) (J : ℝ → ℝ) (S : set ℝ) (B t V MH : ℝ) (k : ℕ)
    (hB : 1 ≤ B) (ht : t ∈ S) (hMH : 0 ≤ MH)
    (hH_bd : ∀ x, 1 ≤ x → x ≤ B → |H x| ≤ MH)
    (hslices : ∀ s ∈ S, darboux.has_integral (fun x => H x * ((log x) ^ k) * rpow x (-s - 1)) 1 B (J s))
    (hrate : darboux.has_integral (fun x => H x * ((log x) ^ (k + 1)) * rpow x (-t - 1)) 1 B V) :
    has_deriv_within J S t (-V)
  have hneg_rate : darboux.has_integral (fun x => (-1) * (H x * ((log x) ^ (k + 1)) * rpow x (-t - 1))) 1 B ((-1) * V) := by exact darboux.scale (fun x => H x * ((log x) ^ (k + 1)) * rpow x (-t - 1)) 1 B V (-1) hrate
  have hv_eq : (-1) * V = -V := by ring
  rw [hv_eq] at hneg_rate
  apply darboux.parameter_deriv (fun s x => H x * ((log x) ^ k) * rpow x (-s - 1)) (fun x => (-1) * (H x * ((log x) ^ (k + 1)) * rpow x (-t - 1))) J S 1 B t (-V) ht hslices hneg_rate
  unfold uniform_deriv_within
  intro e he
  have hlogB_nn : 0 ≤ log B
    have h0 := (log_le_log 1 B (by decide) (by linarith)).mpr hB
    have hl1 : log 1 = 0 := by rw [← exp_zero, log_exp]
    linarith
  set L := log B + 1 with hL
  -- Uniform bound on x^(-t-1) for x in [1, B]: x^(-t-1) <= exp(|t + 1| * log B)
  set E := exp (|t + 1| * log B) with hE
  have hE_pos : 0 < E := by rw [hE]; exact exp_pos (|t + 1| * log B)
  set Kmax := 2 * MH * (L ^ k) * E * (L * L) + 1 with hKmax
  have hLk_nn : 0 ≤ L ^ k := pow_nonneg.real L (by linarith) k
  have hKmax_pos : 0 < Kmax
    rw [hKmax]
    have h1 : 0 ≤ 2 * MH := by linarith
    have h2 : 0 ≤ 2 * MH * (L ^ k) := mul_nonneg.real (2 * MH) (L ^ k) h1 hLk_nn
    have h3 : 0 ≤ 2 * MH * (L ^ k) * E := mul_nonneg.real (2 * MH * (L ^ k)) E h2 (by linarith)
    have h4 : 0 ≤ 2 * MH * (L ^ k) * E * (L * L) := mul_nonneg.real (2 * MH * (L ^ k) * E) (L * L) h3 (by nlinarith)
    linarith
  set d1 := 1 / (2 * L) with hd1
  set d2 := e / Kmax with hd2
  have hd1_pos : 0 < d1 := by rw [hd1]; exact div_pos.real 1 (2 * L) (by decide) (by linarith)
  have hd2_pos : 0 < d2 := by rw [hd2]; exact div_pos.real e Kmax he hKmax_pos
  use min d1 d2
  constructor
  · exact lt_min.real d1 d2 0 hd1_pos hd2_pos
  · intro s hs hst x hx
    have hx1 : 1 ≤ x := hx.1
    have hxB : x ≤ B := hx.2
    have hlogx_nn : 0 ≤ log x
      have h0 := (log_le_log 1 x (by decide) (by linarith)).mpr hx1
      have hl1 : log 1 = 0 := by rw [← exp_zero, log_exp]
      linarith
    have hlogx_le : log x ≤ log B := (log_le_log x B (by linarith) (by linarith)).mpr hxB
    have hlogx_L : log x ≤ L := by rw [hL]; linarith
    -- Show |-(s-t)*log x| <= 1/2 so exp.remainder applies!
    have hst_d1 : |s - t| < d1 := by linarith [min_le_left.real d1 d2]
    have hst_d2 : |s - t| < d2 := by linarith [min_le_right.real d1 d2]
    have hh_le_half : -(s - t) * log x ≤ 1 / 2
      have h1 : |s - t| * L < 1 / 2
        have hlt := (lt_div_iff.real (|s - t|) 1 (2 * L) (by linarith)).mp (by rw [← hd1]; exact hst_d1)
        linarith
      have h2 : |s - t| * log x ≤ |s - t| * L := mul_le_mul_of_nonneg_left.real (log x) L (|s - t|) hlogx_L (abs_nonneg.real (s - t))
      have h3 : -(s - t) ≤ |s - t| := by linarith [neg_le_abs.real (s - t)]
      have h4 : -(s - t) * log x ≤ |s - t| * log x := mul_le_mul_of_nonneg_right.real (-(s - t)) (|s - t|) (log x) h3 hlogx_nn
      linarith
    have hrem := exp.remainder (-(s - t) * log x) hh_le_half
    -- Algebraic factorization of the uniform derivative error:
    have hfac : H x * ((log x) ^ k) * rpow x (-s - 1) - H x * ((log x) ^ k) * rpow x (-t - 1) - (s - t) * ((-1) * (H x * ((log x) ^ (k + 1)) * rpow x (-t - 1))) = (H x * ((log x) ^ k) * rpow x (-t - 1)) * (exp (-(s - t) * log x) - 1 - (-(s - t) * log x))
      have hid := mellin.exp_diff_identity x s t
      have hpow : (log x) ^ (k + 1) = (log x) ^ k * log x := pow_succ.real (log x) k
      rw [hpow]
      linear_combination (H x * ((log x) ^ k)) * hid
    have hgoal : |H x * ((log x) ^ k) * rpow x (-s - 1) - H x * ((log x) ^ k) * rpow x (-t - 1) - (s - t) * ((-1) * (H x * ((log x) ^ (k + 1)) * rpow x (-t - 1)))| ≤ e * |s - t|
      rw [hfac, abs_mul.real]
      -- Bound the second factor: |exp h - 1 - h| <= 2 * (s - t)^2 * L^2
      have hrem_abs : |exp (-(s - t) * log x) - 1 - (-(s - t) * log x)| ≤ 2 * (|s - t| * |s - t|) * (L * L)
        rw [abs_of_nonneg.real (exp (-(s - t) * log x) - 1 - (-(s - t) * log x)) hrem.1]
        have hsq_st : (s - t) * (s - t) = |s - t| * |s - t|
          have ha := sq_abs.real (s - t)
          linear_combination -ha
        have hlog_sq : log x * log x ≤ L * L
          have h1 := mul_le_mul_of_nonneg_right.real (log x) L (log x) hlogx_L hlogx_nn
          have h2 := mul_le_mul_of_nonneg_left.real (log x) L L hlogx_L (by linarith)
          linarith
        have hstep : 2 * (-(s - t) * log x) ^ 2 = 2 * ((|s - t| * |s - t|) * (log x * log x)) := by linear_combination 2 * (log x * log x) * hsq_st
        have hmul := mul_le_mul_of_nonneg_left.real (log x * log x) (L * L) (|s - t| * |s - t|) hlog_sq (by nlinarith [abs_nonneg.real (s - t)])
        linarith [hrem.2]
      -- Bound the first factor: |H x * (log x)^k * x^(-t-1)| <= MH * L^k * E
      have hrpow_le : rpow x (-t - 1) ≤ E
        rw [hE]; unfold rpow
        have h1 : (-t - 1) ≤ |t + 1| := by linarith [neg_le_abs.real (t + 1)]
        have h2 : (-t - 1) * log x ≤ |t + 1| * log x := mul_le_mul_of_nonneg_right.real (-t - 1) (|t + 1|) (log x) h1 hlogx_nn
        have h3 : |t + 1| * log x ≤ |t + 1| * log B := mul_le_mul_of_nonneg_left.real (log x) (log B) (|t + 1|) hlogx_le (abs_nonneg.real (t + 1))
        exact (exp_le_exp ((-t - 1) * log x) (|t + 1| * log B)).mpr (by linarith)
      have hpow_le : (log x) ^ k ≤ L ^ k
        have hpm : ∀ n : ℕ, (log x) ^ n ≤ L ^ n
          intro n
          induction n with j ihj
          · rw [pow_zero.real, pow_zero.real]; linarith
          · rw [succ_eq_add_one.nat, pow_succ.real, pow_succ.real]
            have h1 := mul_le_mul_of_nonneg_left.real (log x) L ((log x) ^ j) hlogx_L (pow_nonneg.real (log x) hlogx_nn j)
            have h2 := mul_le_mul_of_nonneg_right.real ((log x) ^ j) (L ^ j) L ihj (by linarith)
            linarith
        exact hpm k
      have hcoeff_abs : |H x * ((log x) ^ k) * rpow x (-t - 1)| ≤ MH * (L ^ k) * E
        rw [abs_mul.real, abs_mul.real]
        rw [abs_of_nonneg.real ((log x) ^ k) (pow_nonneg.real (log x) hlogx_nn k)]
        rw [abs_of_nonneg.real (rpow x (-t - 1)) (by linarith [rpow.pos x (-t - 1)])]
        have h1 := mul_le_mul_of_nonneg_right.real (|H x|) MH ((log x) ^ k) (hH_bd x hx1 hxB) (pow_nonneg.real (log x) hlogx_nn k)
        have h2 := mul_le_mul_of_nonneg_left.real ((log x) ^ k) (L ^ k) MH hpow_le hMH
        have h12 : |H x| * ((log x) ^ k) ≤ MH * (L ^ k) := by linarith
        have h3 := mul_le_mul_of_nonneg_right.real (|H x| * ((log x) ^ k)) (MH * (L ^ k)) (rpow x (-t - 1)) h12 (by linarith [rpow.pos x (-t - 1)])
        have h4 := mul_le_mul_of_nonneg_left.real (rpow x (-t - 1)) E (MH * (L ^ k)) hrpow_le (mul_nonneg.real MH (L ^ k) hMH hLk_nn)
        linarith
      -- Combine both bounds: <= Kmax * |s-t| * |s-t| <= e * |s-t|!
      have hprod1 := mul_le_mul_of_nonneg_right.real (|H x * ((log x) ^ k) * rpow x (-t - 1)|) (MH * (L ^ k) * E) (|exp (-(s - t) * log x) - 1 - (-(s - t) * log x)|) hcoeff_abs (abs_nonneg.real (exp (-(s - t) * log x) - 1 - (-(s - t) * log x)))
      have hMHE_nn : 0 ≤ MH * (L ^ k) * E := mul_nonneg.real (MH * (L ^ k)) E (mul_nonneg.real MH (L ^ k) hMH hLk_nn) (by linarith)
      have hprod2 := mul_le_mul_of_nonneg_left.real (|exp (-(s - t) * log x) - 1 - (-(s - t) * log x)|) (2 * (|s - t| * |s - t|) * (L * L)) (MH * (L ^ k) * E) hrem_abs hMHE_nn
      have hKst : Kmax * |s - t| ≤ e
        have hlt := (lt_div_iff.real (|s - t|) e Kmax hKmax_pos).mp (by rw [← hd2]; exact hst_d2)
        linarith
      have hK_le : 2 * MH * (L ^ k) * E * (L * L) ≤ Kmax := by rw [hKmax]; linarith
      have hst_sq_nn : 0 ≤ |s - t| * |s - t| := mul_nonneg.real (|s - t|) (|s - t|) (abs_nonneg.real (s - t)) (abs_nonneg.real (s - t))
      have hstep1 := mul_le_mul_of_nonneg_right.real (2 * MH * (L ^ k) * E * (L * L)) Kmax (|s - t| * |s - t|) hK_le hst_sq_nn
      have hstep2 := mul_le_mul_of_nonneg_right.real (Kmax * |s - t|) e (|s - t|) hKst (abs_nonneg.real (s - t))
      linarith
    exact hgoal

-- ====================================================================================
-- PART B (Frontier #1): Finite Bijection Reindexing, Gauss Sum Unit-Shift Separability,
--                       and Finite-Prime Euler Geometric Expansion!
-- ====================================================================================

-- General finite bijection reindexing of complex sums (proved in 10 lines via csum.single + swap!).
-- Helper: periodicity of cpow_nat zeta when cpow_nat zeta q = 1.
+ cpow_nat.mul_pow (z : ℂ) (q k : ℕ) (hq : cpow_nat z q = complex.one) : cpow_nat z (q * k) = complex.one
  induction k with j ih
  · rw [mul_zero.nat]; rfl
  · rw [succ_eq_add_one.nat, left_distrib.nat, mul_one.nat, cpow_nat.add, ih, hq, complex.mul_one]

-- Helper: Dirichlet character periodicity mod q.
+ dchar.mod_eq (q : ℕ) (chi : ℕ → ℂ) (hper : ∀ a, chi (a + q) = chi a) (n : ℕ) : chi (n % q) = chi n
  have hmul : ∀ k m : ℕ, chi (m + q * k) = chi m
    intro k
    induction k with m j ih m
    · rw [mul_zero.nat, add_zero.nat]
    · rw [succ_eq_add_one.nat, left_distrib.nat, mul_one.nat, ← add_assoc.nat, hper, ih m]
  have hdiv := div_add_mod.nat n q
  have h1 : n = n % q + q * (n / q) := by linarith
  have h2 := hmul (n / q) (n % q)
  rw [← h1] at h2
  exact h2.symm

-- Helper: for a Dirichlet character chi with |chi(b)|^2 = 1 on units, chi(b^{-1}) = conj(chi(b))!
+ dchar.val_inv_eq_conj (q b ib : ℕ) (chi : ℕ → ℂ)
    (hchar : is_dirichlet_char q chi)
    (hunit : (b * ib) % q = 1 % q)
    (hnorm : complex.norm_sq (chi b) = 1) :
    chi ib = complex.conj (chi b)
  unfold is_dirichlet_char at hchar
  have hmul : complex.mul (chi b) (chi ib) = complex.one := by rw [← hchar.2.2.2 b ib, ← dchar.mod_eq q chi hchar.1 (b * ib), hunit, dchar.mod_eq q chi hchar.1 1, hchar.2.1]
  have hcb : complex.mul (complex.conj (chi b)) (chi b) = complex.one
    apply complex.ext
    · simp; unfold complex.norm_sq at hnorm; linarith
    · simp; ring
  have hstep : complex.mul (complex.conj (chi b)) (complex.mul (chi b) (chi ib)) = complex.mul (complex.conj (chi b)) complex.one := by rw [hmul]
  have hassoc : complex.mul (complex.conj (chi b)) (complex.mul (chi b) (chi ib)) = complex.mul (complex.mul (complex.conj (chi b)) (chi b)) (chi ib) := by ring
  rw [hassoc, hcb, complex.one_mul, complex.mul_one] at hstep
  exact hstep

-- THEOREM B1 (Unconditional Gauss Sum Unit-Shift Separability — AXIOM-FREE!):
-- For ANY valid Dirichlet character chi mod q, q-th root zeta (zeta^q = 1), and unit b in (Z/qZ)^x
-- with |chi(b)|^2 = 1:
--   sum_{a < q} chi(a) * zeta^(a * b) = conj(chi(b)) * tau(chi) !
+ gauss_sum.shift_unit (q b : ℕ) (zeta : ℂ) (chi : ℕ → ℂ)
    (hq : 0 < q)
    (hchar : is_dirichlet_char q chi)
    (hzeta : cpow_nat zeta q = complex.one)
    (hb : zmod.is_unit q b)
    (hnorm : complex.norm_sq (chi b) = 1) :
    csum q (fun a => complex.mul (chi a) (cpow_nat zeta (a * b))) = complex.mul (complex.conj (chi b)) (csum q (fun c => complex.mul (chi c) (cpow_nat zeta c)))
  unfold zmod.is_unit at hb
  obtain ⟨ib, hib_lt, hbib⟩ := hb
  have hinv_chi : chi ib = complex.conj (chi b) := dchar.val_inv_eq_conj q b ib chi hchar hbib hnorm
  have hpi_lt : ∀ a < q, (a * b) % q < q := by intro a _; exact mod_lt.nat (a * b) q hq
  have hinv_lt : ∀ c < q, (c * ib) % q < q := by intro c _; exact mod_lt.nat (c * ib) q hq
  have hleft : ∀ a < q, ((a * b) % q * ib) % q = a
    intro a ha
    rw [mul_mod.nat ((a * b) % q) ib q, zmod.mod_mod (a * b) q, ← mul_mod.nat (a * b) ib q]
    have hre : a * b * ib = a * (b * ib) := by ring
    rw [hre, mul_mod.nat a (b * ib) q, hbib, ← mul_mod.nat a 1 q]
    have ha1 : a * 1 = a := by ring
    rw [ha1]
    exact (div_mod_of_lt.nat a q ha).2
  have hright : ∀ c < q, ((c * ib) % q * b) % q = c
    intro c hc
    rw [mul_mod.nat ((c * ib) % q) b q, zmod.mod_mod (c * ib) q, ← mul_mod.nat (c * ib) b q]
    have hre : c * ib * b = c * (b * ib) := by ring
    rw [hre, mul_mod.nat c (b * ib) q, hbib, ← mul_mod.nat c 1 q]
    have hc1 : c * 1 = c := by ring
    rw [hc1]
    exact (div_mod_of_lt.nat c q hc).2
  -- Reindex c = (a * b) % q, so a = (c * ib) % q!
  have hterm : csum q (fun a => complex.mul (chi a) (cpow_nat zeta (a * b))) = csum q (fun a => complex.mul (chi ((((a * b) % q) * ib) % q)) (cpow_nat zeta ((a * b) % q)))
    apply csum.congr; intro a ha
    rw [hleft a ha, cpow_nat.pow_mod zeta q (a * b) hzeta]
  rw [hterm]
  rw [csum.bij q (fun a => (a * b) % q) (fun c => (c * ib) % q) (fun c => complex.mul (chi ((c * ib) % q)) (cpow_nat zeta c)) hpi_lt hinv_lt hleft hright]
  rw [← csum.scale_left]
  apply csum.congr; intro c hc
  unfold is_dirichlet_char at hchar
  rw [dchar.mod_eq q chi hchar.1 (c * ib), hchar.2.2.2 c ib, hinv_chi]
  ring

-- THEOREM B2 (Single-Prime Euler Factor Geometric Partial-Sum Identity — AXIOM-FREE!):
--   (1 - w * p^(-s)) * sum_{e < E} (w * p^(-s))^e = 1 - (w * p^(-s))^E !
+ euler_factor.geom_partial (w : ℂ) (p : ℝ) (s : ℂ) (E : ℕ) :
    complex.mul (euler_factor w p s) (csum E (fun e => cpow_nat (complex.mul w (cpow_real p (complex.neg s))) e)) = complex.sub complex.one (cpow_nat (complex.mul w (cpow_real p (complex.neg s))) E)
  unfold euler_factor
  have hg := csum.geom_series E (complex.mul w (cpow_real p (complex.neg s)))
  have hre : complex.re (complex.mul (complex.sub (complex.mul w (cpow_real p (complex.neg s))) complex.one) (csum E (fun h => cpow_nat (complex.mul w (cpow_real p (complex.neg s))) h))) = complex.re (complex.sub (cpow_nat (complex.mul w (cpow_real p (complex.neg s))) E) complex.one) := by rw [hg]
  have him : complex.im (complex.mul (complex.sub (complex.mul w (cpow_real p (complex.neg s))) complex.one) (csum E (fun h => cpow_nat (complex.mul w (cpow_real p (complex.neg s))) h))) = complex.im (complex.sub (cpow_nat (complex.mul w (cpow_real p (complex.neg s))) E) complex.one) := by rw [hg]
  simp at hre him
  apply complex.ext
  · simp; linarith
  · simp; linarith

-- ====================================================================================
-- PART C (Frontier #3): Adelic Integrality Gap & Weil-Deligne Frobenius Trace Bound!
-- ====================================================================================

-- THEOREM C1 (Adelic Height-vs-p-adic Valuation Obstruction — AXIOM-FREE!):
-- If a : N satisfies p^v | a (so |a|_p <= p^(-v)) and archimedean height a < p^v, then a = 0!
+ padic.height_vs_valuation_vanish (p v a : ℕ) (hp : 2 ≤ p)
    (hdvd : p ^ v ∣ a) (hheight : (a : ℝ) < rpow (p : ℝ) ((v : ℕ) : ℝ)) :
    a = 0
  by_contra hnz
  have hvp : v ≤ vp p a := (vp.le_iff_pow_dvd p a v hp (by omega)).mpr hdvd
  have hp1 : (1 : ℝ) ≤ (p : ℝ) := (cast_le.real 1 p).mpr (by omega)
  have hnorm_le : padic.abs p a ≤ rpow (p : ℝ) (-((v : ℕ) : ℝ))
    rw [padic.abs_pos_val p a hnz]
    exact rpow_le_of_exp_le (p : ℝ) (-((vp p a : ℕ) : ℝ)) (-((v : ℕ) : ℝ)) hp1 (by linarith)
  have ha_nn : (0 : ℝ) ≤ (a : ℝ) := cast_nonneg.real a
  have h1 := mul_le_mul_of_nonneg_left.real (padic.abs p a) (rpow (p : ℝ) (-((v : ℕ) : ℝ))) (a : ℝ) hnorm_le ha_nn
  have h2 := mul_lt_mul_of_pos_right.real (a : ℝ) (rpow (p : ℝ) ((v : ℕ) : ℝ)) (rpow (p : ℝ) (-((v : ℕ) : ℝ))) hheight (rpow.pos (p : ℝ) (-((v : ℕ) : ℝ)))
  have hinv : rpow (p : ℝ) ((v : ℕ) : ℝ) * rpow (p : ℝ) (-((v : ℕ) : ℝ)) = 1
    rw [← rpow.add]
    have h0 : ((v : ℕ) : ℝ) + -((v : ℕ) : ℝ) = 0 := by ring
    rw [h0]; unfold rpow; simp; exact exp_zero
  exact hnz (padic.vanish_of_arch_mul_lt_one p a hp (by linarith))

-- THEOREM C2 (Weil-Deligne / Ramanujan-Petersson Frobenius Trace Bound — AXIOM-FREE!):
-- If a d-dimensional Galois/Hecke Frobenius operator has Satake eigenvalues alpha_0, ..., alpha_{d-1}
-- pure of weight w (|alpha_j|^2 <= R for all j < d, e.g. R = q^w), then:
--   |tr(Frob_p)|^2 = |sum_{j < d} alpha_j|^2 <= d^2 * R !
+ galois.weil_trace_bound (d : ℕ) (alpha : ℕ → ℂ) (R : ℝ)
    (hR : 0 ≤ R)
    (hpure : ∀ j < d, complex.norm_sq (alpha j) ≤ R) :
    complex.norm_sq (csum d alpha) ≤ ((d : ℝ) * (d : ℝ)) * R
  have hdot : csum d alpha = cdot d (fun _ => complex.one) alpha := by ring
  rw [hdot]
  have hcs := cdot.cauchy_schwarz d (fun _ => complex.one) alpha
  have hnorm1 : complex.re (cdot d (fun _ => complex.one) (fun _ => complex.one)) = (d : ℝ)
    rw [cdot.self_re]
    have hcon : (∑ j < d, complex.norm_sq complex.one) = ∑ j < d, (1 : ℝ) := by apply sum_below.congr; intro j hj; unfold complex.norm_sq; simp
    rw [hcon, sum_const.real]; ring
  have hnorma : complex.re (cdot d alpha alpha) ≤ (d : ℝ) * R
    rw [cdot.self_re]
    have hle : (∑ j < d, complex.norm_sq (alpha j)) ≤ ∑ j < d, R := by apply sum_le.real; intro j hj; exact hpure j hj
    rw [sum_const.real] at hle
    exact hle
  rw [hnorm1] at hcs
  have hmul := mul_le_mul_of_nonneg_left.real (complex.re (cdot d alpha alpha)) ((d : ℝ) * R) (d : ℝ) hnorma (cast_nonneg.real d)
  linarith
