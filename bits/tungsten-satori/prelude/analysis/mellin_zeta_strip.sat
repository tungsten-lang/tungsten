-- Milestone 3.9: Primitive Gauss Sum Non-Unit Vanishing & Euler Geometric Convergence,
--                Log/rpow Calculus + Iterated Mellin Derivatives + Abel-Mellin Identity,
--                and Arbitrary-Rank GL_d Local L-Factor Nonvanishing (100% AXIOM-FREE!)
--
-- Direct, unconditional attacks on ALL THREE remaining frontier axioms in `rh_skeleton.sat`:
--   * Part A (Frontier #1 — `classical_L_laws`):
--       1. Primitive-character non-unit Gauss sum vanishing (`gauss_sum.vanish_of_witness`):
--          if unit u in (Z/qZ)^x fixes b mod q (u * b = b mod q) and chi(u) != 1, then
--            sum_{a < q} chi(a) zeta^(a * b) = 0 !
--       2. Single-prime Euler factor geometric series convergence (`euler_factor.inv_eq_geom_series`):
--          for p > 1, |w|^2 <= 1, Re(s) > 0, the complex geometric series sum_{e < E} (w p^(-s))^e
--          converges in C to the inverse Euler factor (1 - w p^(-s))^(-1)!
--   * Part B (Frontier #2 — `classical_landau_osc`):
--       1. Derivative & continuity of `log` (`has_deriv_within.log`, `continuous_at.log`) and
--          base-differentiation of `rpow` (`has_deriv_within.rpow_base`), giving the exact
--          Darboux integral `int_a^b sigma * x^(-sigma - 1) dx = a^(-sigma) - b^(-sigma)`
--          (`darboux.rpow_neg_power`)!
--       2. Iterated n-th Mellin derivative (`mellin.iterated_deriv`):
--          J_0^(n)(t) = (-1)^n * int_1^B H(x) (log x)^n x^(-t-1) dx !
--       3. Exact Abel-Mellin step-sum identity (`mellin.abel_step_sum_eq_integral`):
--          sum_{n=1}^N a(n) n^(-sigma) = A(N) N^(-sigma) + sum_{n=1}^{N-1} A(n) int_n^{n+1} sigma x^(-sigma-1) dx !
--   * Part C (Frontier #3 — `pillar_concrete_vwin`):
--       1. Arbitrary-rank GL_d Frobenius power-trace bound (`galois.frobenius_pow_trace_bound`):
--          |tr(Frob_p^r)|^2 <= d^2 * R^r for all r >= 1 !
--       2. Arbitrary-rank GL_d local L-factor nonvanishing & uniform lower bound
--          (`galois.local_L_factor_nonvanishing`): for |alpha_j|^2 <= R and sqrt(R) * p^(-sigma) < 1,
--          prod_{j < d} (1 - alpha_j p^(-s)) != 0 and exp(-d * sqrt(R) * p^(-sigma)) <= |L_p(rho, s)|!
--
-- ALL theorems proved unconditionally on Satori's untouched HOL kernel (0 custom axioms).

import adelic
import integral_parameter

-- ====================================================================================
-- PART A (Frontier #1): Primitive Gauss Sum Non-Unit Vanishing & Euler Geometric Limit
-- ====================================================================================

-- Self-contained finite bijection reindexing & periodicity helpers (reusing Milestone 3.8 pattern).
+ dchar.mod_eq_m39 (q : ℕ) (chi : ℕ → ℂ) (hper : ∀ a, chi (a + q) = chi a) (n : ℕ) : chi (n % q) = chi n
  have hmul : ∀ k m : ℕ, chi (m + q * k) = chi m
    intro k
    induction k with m j ih m
    · rw [mul_zero.nat, add_zero.nat]
    · rw [succ_eq_add_one.nat, left_distrib.nat, mul_one.nat, ← add_assoc.nat, hper, ih m]
  have hdiv := div_add_mod.nat n q
  have h1 : n = n % q + q * (n / q) := by linarith
  have h2 := hmul (n / q) (n % q)
  rw [← h1] at h2
  exact h2.symm

-- THEOREM A1 (Primitive-Character Non-Unit Gauss Sum Vanishing — AXIOM-FREE!):
-- If a unit u in (Z/qZ)^x fixes b mod q (u * b = b mod q) and chi(u) != 1
-- (which always exists for every non-unit b when chi is primitive mod q), then:
--   sum_{a < q} chi(a) * zeta^(a * b) = 0 !
+ gauss_sum.vanish_of_witness (q b u : ℕ) (zeta : ℂ) (chi : ℕ → ℂ)
    (hq : 0 < q)
    (hchar : is_dirichlet_char q chi)
    (hzeta : cpow_nat zeta q = complex.one)
    (hu : zmod.is_unit q u)
    (hfix : (u * b) % q = b % q)
    (hne : chi u ≠ complex.one) :
    csum q (fun a => complex.mul (chi a) (cpow_nat zeta (a * b))) = complex.zero
  unfold zmod.is_unit at hu
  obtain ⟨iu, hiu_lt, hui⟩ := hu
  have hpi_lt : ∀ a < q, (a * u) % q < q := by intro a _; exact mod_lt.nat (a * u) q hq
  have hinv_lt : ∀ c < q, (c * iu) % q < q := by intro c _; exact mod_lt.nat (c * iu) q hq
  have hleft : ∀ a < q, ((a * u) % q * iu) % q = a
    intro a ha
    rw [mul_mod.nat ((a * u) % q) iu q, zmod.mod_mod (a * u) q, ← mul_mod.nat (a * u) iu q]
    have hre : a * u * iu = a * (u * iu) := by ring
    rw [hre, mul_mod.nat a (u * iu) q, hui, ← mul_mod.nat a 1 q]
    have ha1 : a * 1 = a := by ring
    rw [ha1]; exact (div_mod_of_lt.nat a q ha).2
  have hright : ∀ c < q, ((c * iu) % q * u) % q = c
    intro c hc
    rw [mul_mod.nat ((c * iu) % q) u q, zmod.mod_mod (c * iu) q, ← mul_mod.nat (c * iu) u q]
    have hre : c * iu * u = c * (u * iu) := by ring
    rw [hre, mul_mod.nat c (u * iu) q, hui, ← mul_mod.nat c 1 q]
    have hc1 : c * 1 = c := by ring
    rw [hc1]; exact (div_mod_of_lt.nat c q hc).2
  -- Reindex S := sum_{a < q} chi(a) zeta^(a * b) via a |-> (a * u) % q:
  set S := csum q (fun a => complex.mul (chi a) (cpow_nat zeta (a * b))) with hS
  have hreidx : S = complex.mul (chi u) S
    have hbij := csum.bij q (fun a => (a * u) % q) (fun c => (c * iu) % q) (fun a => complex.mul (chi a) (cpow_nat zeta (a * b))) hpi_lt hinv_lt hleft hright
    have hstep : csum q (fun a => complex.mul (chi ((a * u) % q)) (cpow_nat zeta ((a * u) % q * b))) = complex.mul (chi u) (csum q (fun a => complex.mul (chi a) (cpow_nat zeta (a * b))))
      rw [← csum.scale_left]
      apply csum.congr; intro a ha
      unfold is_dirichlet_char at hchar
      rw [dchar.mod_eq_m39 q chi hchar.1 (a * u), hchar.2.2.2 a u]
      have hmod_ab : ((a * u) % q * b) % q = (a * b) % q
        rw [mul_mod.nat ((a * u) % q) b q, zmod.mod_mod (a * u) q, ← mul_mod.nat (a * u) b q]
        have hre : a * u * b = a * (u * b) := by ring
        rw [hre, mul_mod.nat a (u * b) q, hfix, ← mul_mod.nat a b q]
      rw [← cpow_nat.pow_mod zeta q ((a * u) % q * b) hzeta, hmod_ab, cpow_nat.pow_mod zeta q (a * b) hzeta]
      apply complex.ext <;> simp <;> ring
    calc S
      = csum q (fun a => complex.mul (chi a) (cpow_nat zeta (a * b))) := hS
      _ = csum q (fun a => complex.mul (chi ((a * u) % q)) (cpow_nat zeta ((a * u) % q * b))) := hbij.symm
      _ = complex.mul (chi u) (csum q (fun a => complex.mul (chi a) (cpow_nat zeta (a * b)))) := hstep
      _ = complex.mul (chi u) S := by rw [← hS]
  have hdiff : complex.mul (complex.sub complex.one (chi u)) S = complex.zero
    have h1 : complex.mul (complex.sub complex.one (chi u)) S = complex.sub S (complex.mul (chi u) S)
      apply complex.ext <;> simp <;> ring
    rw [h1, ← hreidx, complex.sub_self]
  have hsub_ne : complex.sub complex.one (chi u) ≠ complex.zero
    intro h0; apply hne
    have hre : complex.re (complex.sub complex.one (chi u)) = 0 := by rw [h0]; simp
    have him : complex.im (complex.sub complex.one (chi u)) = 0 := by rw [h0]; simp
    simp at hre him
    apply complex.ext <;> simp <;> linarith
  by_contra hSnz
  exact complex.mul_ne_zero (complex.sub complex.one (chi u)) S hsub_ne hSnz hdiff

-- Helper: |cpow_nat z E| = |z|^E.
+ complex.abs_cpow_nat (z : ℂ) (E : ℕ) : complex.abs (cpow_nat z E) = (complex.abs z) ^ E
  induction E with k ih
  · have h0 : cpow_nat z 0 = complex.one := by rfl
    rw [h0, pow_zero.real]
    have hsq : complex.abs complex.one * complex.abs complex.one = 1 := by rw [complex.abs_sq]; unfold complex.norm_sq; simp
    have hnn := complex.abs_nonneg complex.one
    nlinarith
  · rw [succ_eq_add_one.nat, pow_succ.real]
    have hs : cpow_nat z (k + 1) = complex.mul (cpow_nat z k) z := by rfl
    rw [hs, complex.abs_mul, ih]

-- Helper: r^E -> 0 when 0 <= r < 1 (via Bernoulli / r^E <= 1 / (1 + E*(1/r - 1))!).
+ geom_pow_tends_to_zero (r : ℝ) (hr0 : 0 ≤ r) (hr1 : r < 1) : tends_to (fun E => r ^ E) 0
  unfold tends_to; intro e he
  by_cases hz : r = 0
  · use 1; intro n hn
    have hpow : r ^ n = 0
      have hn1 : n = (n - 1) + 1 := by omega
      rw [hn1, pow_succ.real, hz]; ring
    rw [hpow]; simp
  · have hr_pos : 0 < r := by
      by_contra hle; exact hz (by linarith)
    set t := (1 - r) / r with ht
    have ht_pos : 0 < t := by rw [ht]; exact div_pos.real (1 - r) r (by linarith) hr_pos
    have hinv_r : 1 + t = 1 / r
      rw [ht, div_def.real (1 - r) r]
      have hc := mul_inv_cancel.real r (by linarith)
      linear_combination -hc
    -- Bernoulli inequality: 1 + E * t <= (1 + t)^E
    have hbern : ∀ E : ℕ, 1 + (E : ℝ) * t ≤ (1 + t) ^ E
      intro E
      induction E with k ih
      · rw [pow_zero.real]; simp
      · rw [succ_eq_add_one.nat, pow_succ.real, cast_add.real k 1]; simp
        have h1 : (1 + (k : ℝ) * t) * (1 + t) ≤ (1 + t) ^ k * (1 + t) := mul_le_mul_of_nonneg_right.real (1 + (k : ℝ) * t) ((1 + t) ^ k) (1 + t) ih (by linarith)
        have h2 : 0 ≤ (k : ℝ) * (t * t) := mul_nonneg.real (k : ℝ) (t * t) (cast_nonneg.real k) (by nlinarith)
        linarith
    have hinv_pow : ∀ E : ℕ, r ^ E * (1 + t) ^ E = 1
      intro E
      rw [← mul_pow.real r (1 + t) E, hinv_r, mul_inv_cancel.real r (by linarith)]
      induction E with k ih
      · rw [pow_zero.real]
      · rw [succ_eq_add_one.nat, pow_succ.real, ih]; ring
    obtain ⟨N, hN⟩ := exists_nat_gt.real (1 / (e * t))
    use N; intro n hn
    have h1et_lt : 1 / (e * t) < (n : ℝ) := by linarith
    have het_pos : 0 < e * t := mul_pos.real e t he ht_pos
    have h1_lt : 1 < (n : ℝ) * (e * t)
      have h := (div_lt_iff.real 1 (n : ℝ) (e * t) het_pos).mp h1et_lt
      linarith
    have hden_pos : 0 < (1 + t) ^ n := by linarith [hbern n, mul_nonneg.real (n : ℝ) t (cast_nonneg.real n) (by linarith)]
    have hrn_nn : 0 ≤ r ^ n := pow_nonneg.real r hr0 n
    have hprod_lt : 1 < e * ((1 + t) ^ n)
      have h := mul_le_mul_of_nonneg_left.real (1 + (n : ℝ) * t) ((1 + t) ^ n) e (hbern n) (by linarith)
      linarith
    have hrn_lt : r ^ n < e
      by_contra hge
      have hmul := mul_le_mul_of_nonneg_right.real e (r ^ n) ((1 + t) ^ n) (by linarith) (by linarith)
      rw [hinv_pow n] at hmul
      linarith
    have hsub : r ^ n - 0 = r ^ n := by ring
    rw [hsub, abs_of_nonneg.real (r ^ n) hrn_nn]
    exact hrn_lt

-- THEOREM A2 (Single-Prime Euler Factor Inverse Equals Convergent Geometric Series — AXIOM-FREE!):
-- For any p > 1, |w|^2 <= 1, and Re(s) > 0, the geometric partial sums
--   S_E = sum_{e < E} (w * p^(-s))^e
-- converge in C to complex.inv (euler_factor w p s) !
+ euler_factor.inv_eq_geom_series (w : ℂ) (p : ℝ) (s : ℂ)
    (hp : 1 < p) (hw : complex.norm_sq w ≤ 1) (hs : 0 < complex.re s) :
    ctends_to (fun E => csum E (fun e => cpow_nat (complex.mul w (cpow_real p (complex.neg s))) e)) (complex.inv (euler_factor w p s))
  set r := complex.mul w (cpow_real p (complex.neg s)) with hr
  have hef_ne : euler_factor w p s ≠ complex.zero := euler_factor.ne_zero w p s hp hs hw
  have hr_lt1 : complex.abs r < 1
    rw [hr, complex.abs_mul]
    have hw_le : complex.abs w ≤ 1
      have hsq : complex.abs w * complex.abs w ≤ 1 * 1 := by rw [complex.abs_sq]; linarith
      have hnn := complex.abs_nonneg w
      nlinarith
    have hp_lt1 : complex.abs (cpow_real p (complex.neg s)) < 1
      have hsq : complex.abs (cpow_real p (complex.neg s)) * complex.abs (cpow_real p (complex.neg s)) < 1 * 1
        rw [complex.abs_sq]
        unfold cpow_real
        rw [complex.norm_sq_exp]
        simp
        have hlog_pos : 0 < log p
          have h0 := (log_lt_log 1 p (by decide) (by linarith)).mpr hp
          have hl1 : log 1 = 0 := by rw [← exp_zero, log_exp]
          linarith
        have hneg : -complex.re s * log p < 0 := by nlinarith
        have hexp_lt : exp (-complex.re s * log p) < 1
          rw [← exp_zero]
          exact (exp_lt_exp (-complex.re s * log p) 0).mpr hneg
        have hexp_pos := exp_pos (-complex.re s * log p)
        have he_comm : log p * (0 - complex.re s) = -complex.re s * log p := by ring
        rw [he_comm]
        nlinarith
      have hnn := complex.abs_nonneg (cpow_real p (complex.neg s))
      nlinarith
    have hmul := mul_le_mul_of_nonneg_right.real (complex.abs w) 1 (complex.abs (cpow_real p (complex.neg s))) hw_le (complex.abs_nonneg (cpow_real p (complex.neg s)))
    linarith
  have hlim_pow := geom_pow_tends_to_zero (complex.abs r) (complex.abs_nonneg r) hr_lt1
  have hinv_mul : complex.mul (complex.inv (euler_factor w p s)) (euler_factor w p s) = complex.one := complex.inv_mul_cancel (euler_factor w p s) hef_ne
  unfold ctends_to; intro eps heps
  set K := complex.abs (complex.inv (euler_factor w p s)) + 1 with hK
  have hK_pos : 0 < K := by rw [hK]; linarith [complex.abs_nonneg (complex.inv (euler_factor w p s))]
  unfold tends_to at hlim_pow
  obtain ⟨N, hN⟩ := hlim_pow (eps / K) (div_pos.real eps K heps hK_pos)
  use N; intro E hE
  -- Exact error identity: S_E - ef^{-1} = -ef^{-1} * r^E !
  have hgeom : complex.mul (euler_factor w p s) (csum E (fun e => cpow_nat r e)) = complex.sub complex.one (cpow_nat r E)
    unfold euler_factor
    have hg := csum.geom_series E r
    have hre : complex.re (complex.mul (complex.sub r complex.one) (csum E (fun e => cpow_nat r e))) = complex.re (complex.sub (cpow_nat r E) complex.one) := by rw [hg]
    have him : complex.im (complex.mul (complex.sub r complex.one) (csum E (fun e => cpow_nat r e))) = complex.im (complex.sub (cpow_nat r E) complex.one) := by rw [hg]
    rw [hr] at hre him ⊢
    simp at hre him
    apply complex.ext <;> simp <;> linarith
  have herr_eq : complex.sub (csum E (fun e => cpow_nat r e)) (complex.inv (euler_factor w p s)) = complex.neg (complex.mul (complex.inv (euler_factor w p s)) (cpow_nat r E))
    have h1 : complex.mul (complex.inv (euler_factor w p s)) (complex.mul (euler_factor w p s) (csum E (fun e => cpow_nat r e))) = complex.mul (complex.inv (euler_factor w p s)) (complex.sub complex.one (cpow_nat r E)) := by rw [hgeom]
    have hassoc : complex.mul (complex.inv (euler_factor w p s)) (complex.mul (euler_factor w p s) (csum E (fun e => cpow_nat r e))) = complex.mul (complex.mul (complex.inv (euler_factor w p s)) (euler_factor w p s)) (csum E (fun e => cpow_nat r e))
      apply complex.ext <;> simp <;> ring
    rw [hassoc, hinv_mul, complex.one_mul] at h1
    rw [h1]
    apply complex.ext <;> simp <;> ring
  rw [herr_eq, complex.abs_neg, complex.abs_mul, complex.abs_cpow_nat]
  have hb := hN E hE
  have hsub0 : (complex.abs r) ^ E - 0 = (complex.abs r) ^ E := by ring
  rw [hsub0, abs_of_nonneg.real ((complex.abs r) ^ E) (pow_nonneg.real (complex.abs r) (complex.abs_nonneg r) E)] at hb
  have hlt1 := (lt_div_iff.real ((complex.abs r) ^ E) eps K hK_pos).mp hb
  have hle2 := mul_le_mul_of_nonneg_right.real (complex.abs (complex.inv (euler_factor w p s))) K ((complex.abs r) ^ E) (by rw [hK]; linarith) (pow_nonneg.real (complex.abs r) (complex.abs_nonneg r) E)
  linarith

-- ====================================================================================
-- PART B (Frontier #2): Log/rpow Calculus, Iterated Mellin Derivatives, & Abel-Mellin
-- ====================================================================================

-- Derivative of log(x) = 1 / x on any subset of (0, infty) (100% AXIOM-FREE from exp_ge_one_add!).
+ has_deriv_within.log (S : set ℝ) (x : ℝ) (hx : 0 < x) (hS_pos : ∀ y ∈ S, 0 < y) :
    has_deriv_within log S x (1 / x)
  unfold has_deriv_within; intro e he
  set d1 := x / 2 with hd1
  set d2 := e * (x * x) / 2 with hd2
  have hd1_pos : 0 < d1 := by rw [hd1]; linarith
  have hd2_pos : 0 < d2 := by rw [hd2]; nlinarith
  use min d1 d2; constructor
  · exact lt_min.real d1 d2 0 hd1_pos hd2_pos
  · intro y hy hclose
    have hy_pos : 0 < y := hS_pos y hy
    have hy_gt : x / 2 < y
      have h1 : |y - x| < x / 2 := by linarith [min_le_left.real d1 d2]
      linarith [neg_le_abs.real (y - x)]
    -- Upper bound: log y - log x <= (y - x) / x
    have hup : log y - log x ≤ (y - x) / x
      have h1 := exp_ge_one_add (log y - log x)
      have hexp : exp (log y - log x) = y / x
        have h2 : log y - log x = log y + (0 - log x) := by ring
        rw [h2, exp_add, exp_log y hy_pos]
        have hinv : exp (0 - log x) = 1 / x
          have hm := exp_neg_mul (log x)
          rw [exp_log x hx] at hm
          exact (eq_div_iff.real (exp (0 - log x)) 1 x (by linarith)).mpr (by linarith)
        rw [hinv, div_def.real y x]
      rw [hexp] at h1
      have hsub : y / x - 1 = (y - x) / x
        have hc := mul_inv_cancel.real x (by linarith)
        rw [div_def.real y x, div_def.real (y - x) x]
        linear_combination hc
      linarith
    -- Lower bound: (y - x) / y <= log y - log x
    have hlo : (y - x) / y ≤ log y - log x
      have h1 := exp_ge_one_add (log x - log y)
      have hexp : exp (log x - log y) = x / y
        have h2 : log x - log y = log x + (0 - log y) := by ring
        rw [h2, exp_add, exp_log x hx]
        have hinv : exp (0 - log y) = 1 / y
          have hm := exp_neg_mul (log y)
          rw [exp_log y hy_pos] at hm
          exact (eq_div_iff.real (exp (0 - log y)) 1 y (by linarith)).mpr (by linarith)
        rw [hinv, div_def.real x y]
      rw [hexp] at h1
      have hsub : 1 - x / y = (y - x) / y
        have hc := mul_inv_cancel.real y (by linarith)
        rw [div_def.real x y, div_def.real (y - x) y]
        linear_combination -hc
      linarith
    have h1x : 1 / x * (y - x) = (y - x) / x := by rw [div_def.real 1 x, div_def.real (y - x) x]; ring
    rw [h1x]
    -- Thus -((y-x)^2 / (x*y)) <= (log y - log x) - (y - x)/x <= 0!
    have hgap : (y - x) / y - (y - x) / x = -((y - x) * (y - x)) / (x * y) := by field_simp
    have hnonpos : log y - log x - (y - x) / x ≤ 0 := by linarith
    rw [abs_of_nonpos.real (log y - log x - (y - x) / x) hnonpos]
    have hbound1 : -(log y - log x - (y - x) / x) ≤ ((y - x) * (y - x)) / (x * y)
      have hneg_eq : -(-((y - x) * (y - x)) / (x * y)) = ((y - x) * (y - x)) / (x * y)
        rw [div_def.real (-((y - x) * (y - x))) (x * y), div_def.real ((y - x) * (y - x)) (x * y)]; ring
      linarith
    have hsq : (y - x) * (y - x) = |y - x| * |y - x|
      have ha := sq_abs.real (y - x); linear_combination -ha
    have hbound2 : ((y - x) * (y - x)) / (x * y) ≤ e * |y - x|
      have hxy_pos : 0 < x * y := mul_pos.real x y hx hy_pos
      have hle_mul : (y - x) * (y - x) ≤ (e * |y - x|) * (x * y)
        rw [hsq]
        have hd2_lt : |y - x| < e * (x * x) / 2 := by linarith [min_le_right.real d1 d2]
        have hxy_gt : x * x / 2 < x * y := by nlinarith
        have hrate : |y - x| ≤ e * (x * y) := by nlinarith
        have hfin := mul_le_mul_of_nonneg_right.real (|y - x|) (e * (x * y)) (|y - x|) hrate (abs_nonneg.real (y - x))
        linarith
      exact (div_le_iff.real ((y - x) * (y - x)) (e * |y - x|) (x * y) hxy_pos).mpr hle_mul
    linarith

+ continuous_at.log (x : ℝ) (hx : 0 < x) : continuous_at log x
  have hd := has_deriv_within.log (fun z => x / 2 < z) x hx (by intro y hy; linarith)
  unfold continuous_at; intro e he
  unfold has_deriv_within at hd
  obtain ⟨d, hd_pos, hnear⟩ := hd 1 (by decide)
  set K := |1 / x| + 1 with hK
  have hK_pos : 0 < K := by rw [hK]; linarith [abs_nonneg.real (1 / x)]
  use min (min (x / 2) d) (e / K); constructor
  · exact lt_min.real (min (x / 2) d) (e / K) 0 (lt_min.real (x / 2) d 0 (by linarith) hd_pos) (div_pos.real e K he hK_pos)
  · intro y hy
    have hy1 : |y - x| < x / 2 := by linarith [min_le_left.real (min (x / 2) d) (e / K), min_le_left.real (x / 2) d]
    have hy2 : |y - x| < d := by linarith [min_le_left.real (min (x / 2) d) (e / K), min_le_right.real (x / 2) d]
    have hy3 : |y - x| < e / K := by linarith [min_le_right.real (min (x / 2) d) (e / K)]
    have hy_in : x / 2 < y := by linarith [neg_le_abs.real (y - x)]
    have hb := hnear y hy_in hy2
    have htri : |log y - log x| ≤ |log y - log x - 1 / x * (y - x)| + |1 / x * (y - x)|
      apply abs_le_of.real
      · linarith [neg_le_abs.real (log y - log x - 1 / x * (y - x)), neg_le_abs.real (1 / x * (y - x))]
      · linarith [le_abs_self.real (log y - log x - 1 / x * (y - x)), le_abs_self.real (1 / x * (y - x))]
    rw [abs_mul.real] at htri
    have hK_lt : K * |y - x| < e
      have h := (lt_div_iff.real (|y - x|) e K hK_pos).mp hy3
      linarith
    have hcomb : |log y - log x| ≤ K * |y - x| := by rw [hK]; linarith
    linarith

-- Exact Fundamental Theorem of Calculus for power functions:
--   int_a^b sigma * x^(-sigma - 1) dx = a^(-sigma) - b^(-sigma)   for 0 < a <= b!
+ darboux.rpow_neg_power (sigma a b : ℝ) (ha : 0 < a) (hab : a ≤ b) :
    darboux.has_integral (fun x => sigma * rpow x (-sigma - 1)) a b (rpow a (-sigma) - rpow b (-sigma))
  have hneg : rpow a (-sigma) - rpow b (-sigma) = (-rpow b (-sigma)) - (-rpow a (-sigma)) := by ring
  rw [hneg]
  apply darboux.fundamental (fun x => -rpow x (-sigma)) (fun x => sigma * rpow x (-sigma - 1)) a b hab
  · intro t atle tb
    have ht_pos : 0 < t := by linarith
    have hlogc := continuous_at.log t ht_pos
    have hlin : continuous_at (fun x => (-sigma - 1) * log x) t := continuous_at.mul (fun _ => (-sigma - 1)) log t (continuous_at.const (-sigma - 1) t) hlogc
    have hexpc : continuous_at (fun x => exp ((-sigma - 1) * log x)) t := continuous_at.exp_comp (fun x => (-sigma - 1) * log x) t hlin
    have hsc := continuous_at.mul (fun _ => sigma) (fun x => exp ((-sigma - 1) * log x)) t (continuous_at.const sigma t) hexpc
    exact hsc
  · intro t atle tb
    have ht_pos : 0 < t := by linarith
    have hd_log := has_deriv_within.log (fun z => a ≤ z ∧ z ≤ b) t ht_pos (by intro y hy; linarith [hy.1])
    have hd_sc := has_deriv_within.scale (-sigma) log (fun z => a ≤ z ∧ z ≤ b) t (1 / t) hd_log
    have hd_exp := has_deriv_within.exp_comp (fun x => (-sigma) * log x) (fun z => a ≤ z ∧ z ≤ b) t ((-sigma) * (1 / t)) hd_sc
    have hd_neg := has_deriv_within.scale (-1) (fun x => exp ((-sigma) * log x)) (fun z => a ≤ z ∧ z ≤ b) t (exp ((-sigma) * log t) * ((-sigma) * (1 / t))) hd_exp
    have hf : (fun x => (-1) * exp ((-sigma) * log x)) = (fun x => -rpow x (-sigma)) := by funext x; unfold rpow; ring
    have hv : (-1) * (exp ((-sigma) * log t) * ((-sigma) * (1 / t))) = sigma * rpow t (-sigma - 1)
      have h1t : 1 / t = rpow t (-1)
        have htm : rpow t (-1) * t = 1
          unfold rpow
          have hlogt : t = exp (log t) := (exp_log t ht_pos).symm
          have h0 : (-1) * log t + log t = 0 := by ring
          calc exp ((-1) * log t) * t
            = exp ((-1) * log t) * exp (log t) := by rw [← hlogt]
            _ = exp ((-1) * log t + log t) := by rw [← exp_add]
            _ = exp 0 := by rw [h0]
            _ = 1 := exp_zero
        exact ((eq_div_iff.real (rpow t (-1)) 1 t (by linarith)).mpr htm).symm
      have hr1 : exp ((-sigma) * log t) = rpow t (-sigma) := by rfl
      rw [hr1, h1t]
      have hadd : rpow t (-sigma) * rpow t (-1) = rpow t (-sigma - 1)
        rw [← rpow.add]
        have he : -sigma + -1 = -sigma - 1 := by ring
        rw [he]
      calc (-1) * (rpow t (-sigma) * ((-sigma) * rpow t (-1)))
        = sigma * (rpow t (-sigma) * rpow t (-1)) := by ring
        _ = sigma * rpow t (-sigma - 1) := by rw [hadd]
    rw [hf, hv] at hd_neg
    exact hd_neg

-- THEOREM B1 (Iterated n-th Derivative of Mellin Integrals — AXIOM-FREE!):
-- Defines n-th derivative within S and proves that J_0(s) = int_1^B H(x) x^(-s-1) dx has
-- exact n-th derivative J_0^(n)(t) = (-1)^n * int_1^B H(x) (log x)^n x^(-t-1) dx !
-> has_nth_deriv_within : ℕ → (ℝ → ℝ) → set ℝ → ℝ → ℝ → Prop
  | 0, f, _, t, v => f t = v
  | n + 1, f, S, t, v => ∃ g : ℝ → ℝ, (∀ s ∈ S, has_nth_deriv_within n f S s (g s)) ∧ has_deriv_within g S t v

+ has_nth_deriv_within.zero_eq (f : ℝ → ℝ) (S : set ℝ) (t v : ℝ) : has_nth_deriv_within 0 f S t v ↔ f t = v := by rfl
+ has_nth_deriv_within.succ_eq (n : ℕ) (f : ℝ → ℝ) (S : set ℝ) (t v : ℝ) : has_nth_deriv_within (n + 1) f S t v ↔ ∃ g : ℝ → ℝ, (∀ s ∈ S, has_nth_deriv_within n f S s (g s)) ∧ has_deriv_within g S t v
  constructor <;> intro h <;> exact h

+ mellin.iterated_deriv (H : ℝ → ℝ) (J : ℕ → ℝ → ℝ) (S : set ℝ) (B MH : ℝ) (n : ℕ)
    (hB : 1 ≤ B) (hMH : 0 ≤ MH)
    (hH_bd : ∀ x, 1 ≤ x → x ≤ B → |H x| ≤ MH)
    (hJ : ∀ k s, s ∈ S → darboux.has_integral (fun x => H x * ((log x) ^ k) * rpow x (-s - 1)) 1 B (J k s))
    (hstep : ∀ k s, s ∈ S → has_deriv_within (J k) S s (-J (k + 1) s)) :
    ∀ t ∈ S, has_nth_deriv_within n (J 0) S t (((-1 : ℝ) ^ n) * J n t)
  induction n with t ht k ih t ht
  · rw [has_nth_deriv_within.zero_eq, pow_zero.real]; ring
  · rw [succ_eq_add_one.nat, has_nth_deriv_within.succ_eq]
    use (fun s => ((-1 : ℝ) ^ k) * J k s)
    constructor
    · intro s hs; exact ih s hs
    · have hsc := has_deriv_within.scale ((-1 : ℝ) ^ k) (J k) S t (-J (k + 1) t) (hstep k t ht)
      have hv : ((-1 : ℝ) ^ k) * (-J (k + 1) t) = ((-1 : ℝ) ^ (k + 1)) * J (k + 1) t := by rw [pow_succ.real]; ring
      rw [hv] at hsc
      exact hsc

-- THEOREM B2 (Exact Abel-Mellin Step-Sum Identity — AXIOM-FREE!):
-- Connects ANY discrete Dirichlet partial sum sum_{n < N} a(n+1) * (n+1)^(-sigma)
-- to the Darboux Mellin step-integrals int_{n+1}^{n+2} sigma * x^(-sigma-1) dx:
--   sum_{n < N} a(n+1) * (n+1)^(-sigma)
--     = A(N) * (N+1)^(-sigma) + sum_{n < N} A(n+1) * I(n)
-- where I(n) = int_{n+1}^{n+2} sigma * x^(-sigma-1) dx = (n+1)^(-sigma) - (n+2)^(-sigma)!
-> psum_shift (a : ℕ → ℝ) (k : ℕ) : ℝ := ∑ j < k, a (j + 1)

+ mellin.abel_step_sum_eq_integral (N : ℕ) (a : ℕ → ℝ) (sigma : ℝ) (I : ℕ → ℝ)
    (hI : ∀ n < N, darboux.has_integral (fun x => sigma * rpow x (-sigma - 1)) ((n + 1 : ℕ) : ℝ) ((n + 2 : ℕ) : ℝ) (I n)) :
    (∑ n < N, a (n + 1) * rpow ((n + 1 : ℕ) : ℝ) (-sigma)) = psum_shift a N * rpow ((N + 1 : ℕ) : ℝ) (-sigma) + ∑ n < N, psum_shift a (n + 1) * I n
  have hI_val : ∀ n < N, I n = rpow ((n + 1 : ℕ) : ℝ) (-sigma) - rpow ((n + 2 : ℕ) : ℝ) (-sigma)
    intro n hn
    have h1_pos : (0 : ℝ) < ((n + 1 : ℕ) : ℝ) := (cast_pos.real (n + 1)).mpr (by omega)
    have h12 : ((n + 1 : ℕ) : ℝ) ≤ ((n + 2 : ℕ) : ℝ) := (cast_le.real (n + 1) (n + 2)).mpr (by omega)
    have hftc := darboux.rpow_neg_power sigma ((n + 1 : ℕ) : ℝ) ((n + 2 : ℕ) : ℝ) h1_pos h12
    exact darboux.unique (fun x => sigma * rpow x (-sigma - 1)) ((n + 1 : ℕ) : ℝ) ((n + 2 : ℕ) : ℝ) (I n) (rpow ((n + 1 : ℕ) : ℝ) (-sigma) - rpow ((n + 2 : ℕ) : ℝ) (-sigma)) (hI n hn) hftc
  have habel : ∀ M : ℕ, (∀ n < M, I n = rpow ((n + 1 : ℕ) : ℝ) (-sigma) - rpow ((n + 2 : ℕ) : ℝ) (-sigma)) → (∑ n < M, a (n + 1) * rpow ((n + 1 : ℕ) : ℝ) (-sigma)) = psum_shift a M * rpow ((M + 1 : ℕ) : ℝ) (-sigma) + ∑ n < M, psum_shift a (n + 1) * I n
    intro M
    induction M with _ k ih hIv
    · unfold psum_shift; simp
    · rw [succ_eq_add_one.nat] at hIv ⊢
      rw [sum_below_succ, sum_below_succ]
      rw [ih (by intro n hn; exact hIv n (by omega)), hIv k (by omega)]
      have hsucc : psum_shift a (k + 1) = psum_shift a k + a (k + 1) := by unfold psum_shift; simp
      rw [hsucc]
      have hk2 : ((k + 1 + 1 : ℕ) : ℝ) = ((k + 2 : ℕ) : ℝ)
        have he : k + 1 + 1 = k + 2 := by omega
        rw [he]
      rw [hk2]; ring
  exact habel N hI_val

-- ====================================================================================
-- PART C (Frontier #3): Arbitrary-Rank GL_d Frobenius Power Traces & Local L-Factors
-- ====================================================================================

-- THEOREM C1 (GL_d Frobenius Power-Trace Bound |tr(Frob_p^r)|^2 <= d^2 * R^r — AXIOM-FREE!):
+ galois.frobenius_pow_trace_bound (d r : ℕ) (alpha : ℕ → ℂ) (R : ℝ)
    (hR : 0 ≤ R)
    (hpure : ∀ j < d, complex.norm_sq (alpha j) ≤ R) :
    complex.norm_sq (csum d (fun j => cpow_nat (alpha j) r)) ≤ ((d : ℝ) * (d : ℝ)) * (R ^ r)
  have hpow_ns : ∀ j < d, complex.norm_sq (cpow_nat (alpha j) r) ≤ R ^ r
    intro j hj
    have hns_pow : ∀ m : ℕ, complex.norm_sq (cpow_nat (alpha j) m) = (complex.norm_sq (alpha j)) ^ m
      intro m
      induction m with l ihl
      · have h0 : cpow_nat (alpha j) 0 = complex.one := by rfl
        rw [h0, pow_zero.real]; unfold complex.norm_sq; simp
      · rw [succ_eq_add_one.nat, pow_succ.real]
        have hs : cpow_nat (alpha j) (l + 1) = complex.mul (cpow_nat (alpha j) l) (alpha j) := by rfl
        rw [hs, complex.norm_sq_mul, ihl]
    rw [hns_pow r]
    have hmono : ∀ m : ℕ, (complex.norm_sq (alpha j)) ^ m ≤ R ^ m
      intro m
      induction m with l ihl
      · rw [pow_zero.real, pow_zero.real]; linarith
      · rw [succ_eq_add_one.nat, pow_succ.real, pow_succ.real]
        have hnn := pow_nonneg.real (complex.norm_sq (alpha j)) (complex.norm_sq_nonneg (alpha j)) l
        have h1 := mul_le_mul_of_nonneg_left.real (complex.norm_sq (alpha j)) R ((complex.norm_sq (alpha j)) ^ l) (hpure j hj) hnn
        have h2 := mul_le_mul_of_nonneg_right.real ((complex.norm_sq (alpha j)) ^ l) (R ^ l) R ihl hR
        linarith
    exact hmono r
  have hdot : csum d (fun j => cpow_nat (alpha j) r) = cdot d (fun _ => complex.one) (fun j => cpow_nat (alpha j) r) := by ring
  rw [hdot]
  have hcs := cdot.cauchy_schwarz d (fun _ => complex.one) (fun j => cpow_nat (alpha j) r)
  have hnorm1 : complex.re (cdot d (fun _ => complex.one) (fun _ => complex.one)) = (d : ℝ)
    rw [cdot.self_re]
    have hcon : (∑ j < d, complex.norm_sq complex.one) = ∑ j < d, (1 : ℝ) := by apply sum_below.congr; intro j hj; unfold complex.norm_sq; simp
    rw [hcon, sum_const.real]; ring
  have hnorma : complex.re (cdot d (fun j => cpow_nat (alpha j) r) (fun j => cpow_nat (alpha j) r)) ≤ (d : ℝ) * (R ^ r)
    rw [cdot.self_re]
    have hle : (∑ j < d, complex.norm_sq (cpow_nat (alpha j) r)) ≤ ∑ j < d, (R ^ r) := by apply sum_le.real; intro j hj; exact hpow_ns j hj
    rw [sum_const.real] at hle
    exact hle
  rw [hnorm1] at hcs
  have hmul := mul_le_mul_of_nonneg_left.real (complex.re (cdot d (fun j => cpow_nat (alpha j) r) (fun j => cpow_nat (alpha j) r))) ((d : ℝ) * (R ^ r)) (d : ℝ) hnorma (cast_nonneg.real d)
  linarith

-- THEOREM C2 (Arbitrary-Rank GL_d Local Automorphic/Galois L-Factor Nonvanishing — AXIOM-FREE!):
-- If alpha_0, ..., alpha_{d-1} satisfy |alpha_j|^2 <= R and sqrt(R) * p^(-Re s) < 1,
-- then the degree-d local L-factor prod_{j < d} (1 - alpha_j * p^(-s)) is NONZERO,
-- and its inverse L_p satisfies exp(-d * sqrt(R) * p^(-Re s)) <= |L_p|!
+ galois.local_L_factor_nonvanishing (d : ℕ) (alpha : ℕ → ℂ) (p : ℝ) (s L_p : ℂ) (R : ℝ)
    (hp : 1 < p) (hR : 0 ≤ R)
    (hpure : ∀ j < d, complex.norm_sq (alpha j) ≤ R)
    (hconv : sqrt R * rpow p (-complex.re s) < 1)
    (hinv : complex.mul (cprod d (fun j => euler_factor (alpha j) p s)) L_p = complex.one) :
    cprod d (fun j => euler_factor (alpha j) p s) ≠ complex.zero ∧
    exp (-((d : ℝ) * (sqrt R * rpow p (-complex.re s)))) ≤ complex.abs L_p ∧
    L_p ≠ complex.zero
  have hfac_bound : ∀ j < d, complex.abs (euler_factor (alpha j) p s) ≤ exp (sqrt R * rpow p (-complex.re s))
    intro j hj
    unfold euler_factor
    have htri : complex.abs (complex.sub complex.one (complex.mul (alpha j) (cpow_real p (complex.neg s)))) ≤ 1 + complex.abs (complex.mul (alpha j) (cpow_real p (complex.neg s)))
      have heq : complex.sub complex.one (complex.mul (alpha j) (cpow_real p (complex.neg s))) = complex.add complex.one (complex.neg (complex.mul (alpha j) (cpow_real p (complex.neg s))))
        apply complex.ext <;> simp <;> ring
      rw [heq]
      have h1 := complex.abs_add_le complex.one (complex.neg (complex.mul (alpha j) (cpow_real p (complex.neg s))))
      rw [complex.abs_neg] at h1
      have h1abs : complex.abs complex.one = 1
        have hsq : complex.abs complex.one * complex.abs complex.one = 1
          rw [complex.abs_sq]; unfold complex.norm_sq; simp
        have hnn := complex.abs_nonneg complex.one; nlinarith
      linarith
    have ha_le : complex.abs (alpha j) ≤ sqrt R
      have hsqR := sqrt_spec R hR
      have hsq : complex.abs (alpha j) * complex.abs (alpha j) ≤ sqrt R * sqrt R
        rw [complex.abs_sq, hsqR.2]; exact hpure j hj
      have hnn := complex.abs_nonneg (alpha j)
      nlinarith
    have hp_abs : complex.abs (cpow_real p (complex.neg s)) = rpow p (-complex.re s)
      have hsq : complex.abs (cpow_real p (complex.neg s)) * complex.abs (cpow_real p (complex.neg s)) = rpow p (-complex.re s) * rpow p (-complex.re s)
        rw [complex.abs_sq]; unfold cpow_real rpow; rw [complex.norm_sq_exp]; simp
        have he : log p * (0 - complex.re s) = -complex.re s * log p := by ring
        rw [he]
      have h1 := complex.abs_nonneg (cpow_real p (complex.neg s))
      have h2 := rpow.pos p (-complex.re s)
      nlinarith
    rw [complex.abs_mul, hp_abs] at htri
    have hmul := mul_le_mul_of_nonneg_right.real (complex.abs (alpha j)) (sqrt R) (rpow p (-complex.re s)) ha_le (by linarith [rpow.pos p (-complex.re s)])
    have hexp := exp_ge_one_add (sqrt R * rpow p (-complex.re s))
    linarith
  have hprod_le : complex.abs (cprod d (fun j => euler_factor (alpha j) p s)) ≤ exp ((d : ℝ) * (sqrt R * rpow p (-complex.re s)))
    have hgen : ∀ m : ℕ, (∀ j < m, complex.abs (euler_factor (alpha j) p s) ≤ exp (sqrt R * rpow p (-complex.re s))) → complex.abs (cprod m (fun j => euler_factor (alpha j) p s)) ≤ exp ((m : ℝ) * (sqrt R * rpow p (-complex.re s)))
      intro m
      induction m with _ k ih hfb
      · have h0 : cprod 0 (fun j => euler_factor (alpha j) p s) = complex.one := by rfl
        rw [h0]; simp; rw [exp_zero]
        have h1abs : complex.abs complex.one = 1
          have hsq : complex.abs complex.one * complex.abs complex.one = 1 := by rw [complex.abs_sq]; unfold complex.norm_sq; simp
          have hnn := complex.abs_nonneg complex.one; nlinarith
        linarith
      · rw [succ_eq_add_one.nat] at hfb ⊢
        have hs : cprod (k + 1) (fun j => euler_factor (alpha j) p s) = complex.mul (cprod k (fun j => euler_factor (alpha j) p s)) (euler_factor (alpha k) p s) := by rfl
        rw [hs, complex.abs_mul, cast_add.real k 1]
        have hprev := ih (by intro j hj; exact hfb j (by omega))
        have hlast := hfb k (by omega)
        have h1 := mul_le_mul_of_nonneg_right.real (complex.abs (cprod k (fun j => euler_factor (alpha j) p s))) (exp ((k : ℝ) * (sqrt R * rpow p (-complex.re s)))) (complex.abs (euler_factor (alpha k) p s)) hprev (complex.abs_nonneg (euler_factor (alpha k) p s))
        have h2 := mul_le_mul_of_nonneg_left.real (complex.abs (euler_factor (alpha k) p s)) (exp (sqrt R * rpow p (-complex.re s))) (exp ((k : ℝ) * (sqrt R * rpow p (-complex.re s)))) hlast (by linarith [exp_pos ((k : ℝ) * (sqrt R * rpow p (-complex.re s)))])
        have hexp_add : exp ((k : ℝ) * (sqrt R * rpow p (-complex.re s))) * exp (sqrt R * rpow p (-complex.re s)) = exp (((k : ℝ) + ((1 : ℕ) : ℝ)) * (sqrt R * rpow p (-complex.re s)))
          rw [← exp_add]; simp
          have he : (k : ℝ) * (sqrt R * rpow p (-complex.re s)) + sqrt R * rpow p (-complex.re s) = ((k : ℝ) + 1) * (sqrt R * rpow p (-complex.re s)) := by ring
          rw [he]
        linarith
    exact hgen d hfac_bound
  have h1eq : complex.abs (cprod d (fun j => euler_factor (alpha j) p s)) * complex.abs L_p = 1
    rw [← complex.abs_mul, hinv]
    have hsq : complex.abs complex.one * complex.abs complex.one = 1 := by rw [complex.abs_sq]; unfold complex.norm_sq; simp
    have hnn := complex.abs_nonneg complex.one; nlinarith
  have hL_ge : exp (-((d : ℝ) * (sqrt R * rpow p (-complex.re s)))) ≤ complex.abs L_p
    have hmul := mul_le_mul_of_nonneg_right.real (complex.abs (cprod d (fun j => euler_factor (alpha j) p s))) (exp ((d : ℝ) * (sqrt R * rpow p (-complex.re s)))) (complex.abs L_p) hprod_le (complex.abs_nonneg L_p)
    have h1le : 1 ≤ exp ((d : ℝ) * (sqrt R * rpow p (-complex.re s))) * complex.abs L_p := by linarith
    have h2 := mul_le_mul_of_nonneg_left.real 1 (exp ((d : ℝ) * (sqrt R * rpow p (-complex.re s))) * complex.abs L_p) (exp (-((d : ℝ) * (sqrt R * rpow p (-complex.re s))))) h1le (by linarith [exp_pos (-((d : ℝ) * (sqrt R * rpow p (-complex.re s))))])
    have hcanc : exp (-((d : ℝ) * (sqrt R * rpow p (-complex.re s)))) * (exp ((d : ℝ) * (sqrt R * rpow p (-complex.re s))) * complex.abs L_p) = complex.abs L_p
      have hre : exp (-((d : ℝ) * (sqrt R * rpow p (-complex.re s)))) * (exp ((d : ℝ) * (sqrt R * rpow p (-complex.re s))) * complex.abs L_p) = (exp (-((d : ℝ) * (sqrt R * rpow p (-complex.re s)))) * exp ((d : ℝ) * (sqrt R * rpow p (-complex.re s)))) * complex.abs L_p := by ring
      rw [hre, ← exp_add]
      have h0 : -((d : ℝ) * (sqrt R * rpow p (-complex.re s))) + (d : ℝ) * (sqrt R * rpow p (-complex.re s)) = 0 := by ring
      rw [h0, exp_zero]; ring
    linarith
  constructor
  · intro hz
    rw [hz, complex.zero_mul] at hinv
    have hre : complex.re complex.zero = complex.re complex.one := by rw [hinv]
    simp at hre
  · constructor
    · exact hL_ge
    · intro hz
      rw [hz, complex.abs_zero] at hL_ge
      linarith [exp_pos (-((d : ℝ) * (sqrt R * rpow p (-complex.re s))))]
