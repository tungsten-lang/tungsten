-- Milestone 3.11: Mertens 3-4-1 Trigonometric Positivity, Euler-Log Inequality, &
--                 Full Hadamard-de la Vallee Poussin Re(s) >= 1 Nonvanishing (0 AXIOMS!)
--
-- Direct, unconditional retirement of the critical-line boundary nonvanishing clause
-- of Frontier #1 (`classical_L_laws`, clause 7: zeta(s) != 0 for ALL Re(s) >= 1, s != 1)
-- AND Dirichlet L(chi, 1 + it) != 0 for non-quadratic characters:
--   1. `trig.cos_two_mul` & `trig.mertens_nonneg`: 3 + 4*cos(theta) + cos(2*theta) = 2*(1+cos(theta))^2 >= 0
--   2. `mertens.euler_log_341_nonneg` & `mertens.finite_euler_341_ge_one`:
--      exp(E_N(sigma,0,0))^3 * exp(E_N(sigma,phi,t))^4 * exp(E_N(sigma,2*phi,2*t)) >= 1
--   3. `mertens.limit_341_ge_one`: passage to the limit as N -> infty
--   4. `hadamard_poussin.ne_zero_re_eq_one`: FULL Hadamard-de la Vallee Poussin theorem!
--      From Mertens 3-4-1 + simple pole |zeta(sigma)| <= C1/(sigma-1) + complex differentiability
--      at 1 + it + local boundedness at 1 + 2it  ==>  L(1 + it) != 0 !
--   5. `zeta.ne_zero_re_ge_one`: combines Re(s) > 1 (`euler_limit.ne_zero_of_re_gt_one`) with
--      Re(s) = 1 (`hadamard_poussin.ne_zero_re_eq_one`) for the ENTIRE closed half-plane Re(s) >= 1!
--
-- ALL theorems proved unconditionally on Satori's untouched HOL kernel (0 custom axioms).

import complex_contour

-- ====================================================================================
-- 1. Mertens Trigonometric Identity: 3 + 4*cos(theta) + cos(2*theta) >= 0
-- ====================================================================================

+ trig.cos_two_mul (theta : ℝ) : cos (2 * theta) = 2 * (cos theta * cos theta) - 1
  have h2 : 2 * theta = theta + theta := by ring
  rw [h2, cos_add]
  linear_combination -(sin_sq_add_cos_sq theta)

+ trig.mertens_nonneg (theta : ℝ) : 0 ≤ 3 + 4 * cos theta + cos (2 * theta)
  rw [trig.cos_two_mul]
  have hsq : 3 + 4 * cos theta + (2 * (cos theta * cos theta) - 1) = 2 * ((1 + cos theta) * (1 + cos theta)) := by ring
  rw [hsq]
  nlinarith

-- ====================================================================================
-- 2. Finite Euler-Logarithm 3-4-1 Inequality: |zeta|^3 * |L(chi)|^4 * |L(chi^2)| >= 1
-- ====================================================================================

-> mertens_log_term (p phi sigma t : ℝ) (k : ℕ) : ℝ :=
  (1 / ((k + 1 : ℕ) : ℝ)) * rpow p (-((k + 1 : ℕ) : ℝ) * sigma) * cos (((k + 1 : ℕ) : ℝ) * (phi - t * log p))

-> mertens_log_sum (m K : ℕ) (p phi : ℕ → ℝ) (sigma t : ℝ) : ℝ :=
  ∑ j < m, ∑ k < K, mertens_log_term (p j) (phi j) sigma t k

+ mertens.term_341_nonneg (p phi sigma t : ℝ) (k : ℕ) :
    0 ≤ 3 * mertens_log_term p 0 sigma 0 k + 4 * mertens_log_term p phi sigma t k + mertens_log_term p (2 * phi) sigma (2 * t) k
  unfold mertens_log_term
  have h0 : ((k + 1 : ℕ) : ℝ) * (0 - 0 * log p) = 0 := by ring
  have h2 : ((k + 1 : ℕ) : ℝ) * (2 * phi - (2 * t) * log p) = 2 * (((k + 1 : ℕ) : ℝ) * (phi - t * log p)) := by ring
  rw [h0, cos_zero, h2]
  set w := (1 / ((k + 1 : ℕ) : ℝ)) * rpow p (-((k + 1 : ℕ) : ℝ) * sigma) with hw
  have hw_nn : 0 ≤ w
    rw [hw]
    have hk_pos : (0 : ℝ) < ((k + 1 : ℕ) : ℝ) := (cast_pos.real (k + 1)).mpr (by omega)
    exact mul_nonneg.real (1 / ((k + 1 : ℕ) : ℝ)) (rpow p (-((k + 1 : ℕ) : ℝ) * sigma)) (by linarith [one_div_pos.real ((k + 1 : ℕ) : ℝ) hk_pos]) (by linarith [rpow.pos p (-((k + 1 : ℕ) : ℝ) * sigma)])
  have hfac : 3 * (w * 1) + 4 * (w * cos (((k + 1 : ℕ) : ℝ) * (phi - t * log p))) + w * cos (2 * (((k + 1 : ℕ) : ℝ) * (phi - t * log p))) = w * (3 + 4 * cos (((k + 1 : ℕ) : ℝ) * (phi - t * log p)) + cos (2 * (((k + 1 : ℕ) : ℝ) * (phi - t * log p)))) := by ring
  rw [hfac]
  exact mul_nonneg.real w (3 + 4 * cos (((k + 1 : ℕ) : ℝ) * (phi - t * log p)) + cos (2 * (((k + 1 : ℕ) : ℝ) * (phi - t * log p)))) hw_nn (trig.mertens_nonneg (((k + 1 : ℕ) : ℝ) * (phi - t * log p)))

+ mertens.log_sum_341_nonneg (m K : ℕ) (p phi : ℕ → ℝ) (sigma t : ℝ) :
    0 ≤ 3 * mertens_log_sum m K p (fun _ => 0) sigma 0 + 4 * mertens_log_sum m K p phi sigma t + mertens_log_sum m K p (fun j => 2 * phi j) sigma (2 * t)
  unfold mertens_log_sum
  rw [← sum_const_mul.real, ← sum_const_mul.real, ← sum_add.real, ← sum_add.real]
  apply sum_nonneg.real; intro j hj
  rw [← sum_const_mul.real, ← sum_const_mul.real, ← sum_add.real, ← sum_add.real]
  apply sum_nonneg.real; intro k hk
  exact mertens.term_341_nonneg (p j) (phi j) sigma t k

-- THEOREM 1 (Finite Euler-Product Mertens 3-4-1 Inequality — AXIOM-FREE!):
+ mertens.finite_euler_341_ge_one (m K : ℕ) (p phi : ℕ → ℝ) (sigma t : ℝ) :
    1 ≤ (exp (mertens_log_sum m K p (fun _ => 0) sigma 0)) ^ 3 * (exp (mertens_log_sum m K p phi sigma t)) ^ 4 * exp (mertens_log_sum m K p (fun j => 2 * phi j) sigma (2 * t))
  set a := mertens_log_sum m K p (fun _ => 0) sigma 0 with ha
  set b := mertens_log_sum m K p phi sigma t with hb
  set c := mertens_log_sum m K p (fun j => 2 * phi j) sigma (2 * t) with hc
  have hnn : 0 ≤ 3 * a + 4 * b + c
    rw [ha, hb, hc]
    exact mertens.log_sum_341_nonneg m K p phi sigma t
  have hexp_ge : 1 ≤ exp (3 * a + 4 * b + c)
    rw [← exp_zero]
    exact (exp_le_exp 0 (3 * a + 4 * b + c)).mpr hnn
  have hpow3 : (exp a) ^ 3 = exp (3 * a)
    have h3 : (exp a) ^ 3 = exp a * exp a * exp a := by ring
    rw [h3, ← exp_add, ← exp_add]
    have he : a + a + a = 3 * a := by ring
    rw [he]
  have hpow4 : (exp b) ^ 4 = exp (4 * b)
    have h4 : (exp b) ^ 4 = exp b * exp b * exp b * exp b := by ring
    rw [h4, ← exp_add, ← exp_add, ← exp_add]
    have he : b + b + b + b = 4 * b := by ring
    rw [he]
  rw [hpow3, hpow4, ← exp_add, ← exp_add]
  exact hexp_ge

-- ====================================================================================
-- 3. Real Limit Product & Order Persistence (For Passing Mertens to the Limit)
-- ====================================================================================

+ tends_to.ge_of_ge (a : ℕ → ℝ) (A c : ℝ) (ha : tends_to a A) (hge : ∀ n, c ≤ a n) : c ≤ A
  by_contra hlt
  unfold tends_to at ha
  obtain ⟨N, hN⟩ := ha (c - A) (by linarith)
  have h1 := hN N (by omega)
  have h2 := hge N
  have h3 := le_abs_self.real (a N - A)
  linarith

+ tends_to.mul (a b : ℕ → ℝ) (A B : ℝ) (ha : tends_to a A) (hb : tends_to b B) :
    tends_to (fun n => a n * b n) (A * B)
  unfold tends_to at ha hb ⊢
  intro e he
  obtain ⟨Nb, hNb⟩ := hb 1 (by decide)
  set Mb := |B| + 1 with hMb
  have hMb_pos : 0 < Mb := by rw [hMb]; linarith [abs_nonneg.real B]
  set Ma := |A| + 1 with hMa
  have hMa_pos : 0 < Ma := by rw [hMa]; linarith [abs_nonneg.real A]
  obtain ⟨N1, hN1⟩ := ha (e / (2 * Mb)) (div_pos.real e (2 * Mb) he (by linarith))
  obtain ⟨N2, hN2⟩ := hb (e / (2 * Ma)) (div_pos.real e (2 * Ma) he (by linarith))
  use N1 + N2 + Nb
  intro n hn
  have hbn : |b n| ≤ Mb
    have h1 := hNb n (by omega)
    exact abs_le_of.real (b n) Mb (by linarith [neg_le_abs.real (b n - B), neg_le_abs.real B]) (by linarith [le_abs_self.real (b n - B), le_abs_self.real B])
  have h1 := hN1 n (by omega)
  have h2 := hN2 n (by omega)
  have hdecomp : a n * b n - A * B = (a n - A) * b n + A * (b n - B) := by ring
  rw [hdecomp]
  have htri : |(a n - A) * b n + A * (b n - B)| ≤ |a n - A| * |b n| + |A| * |b n - B|
    have hab := abs_le_of.real ((a n - A) * b n + A * (b n - B)) (|(a n - A) * b n| + |A * (b n - B)|) (by linarith [neg_le_abs.real ((a n - A) * b n), neg_le_abs.real (A * (b n - B))]) (by linarith [le_abs_self.real ((a n - A) * b n), le_abs_self.real (A * (b n - B))])
    rw [abs_mul.real, abs_mul.real] at hab
    exact hab
  have ht1 : |a n - A| * |b n| < e / 2
    have hm1 := mul_le_mul_of_nonneg_left.real (|b n|) Mb (|a n - A|) hbn (abs_nonneg.real (a n - A))
    have hm2 := mul_lt_mul_of_pos_right.real (|a n - A|) (e / (2 * Mb)) Mb h1 hMb_pos
    have hcancel : (e / (2 * Mb)) * Mb = e / 2
      have hne : 2 * Mb ≠ 0 := by linarith
      have hc := mul_inv_cancel.real Mb (by linarith)
      rw [div_def.real e (2 * Mb), div_def.real e 2]
      have hinv2 : 1 / (2 * Mb) = (1 / 2) * (1 / Mb)
        have hprod : (2 * Mb) * ((1 / 2) * (1 / Mb)) = 1
          have h2c := mul_inv_cancel.real 2 (by decide)
          calc (2 * Mb) * ((1 / 2) * (1 / Mb))
            = (2 * (1 / 2)) * (Mb * (1 / Mb)) := by ring
            _ = 1 * 1 := by rw [h2c, hc]
            _ = 1 := by ring
        exact ((eq_div_iff.real ((1 / 2) * (1 / Mb)) 1 (2 * Mb) hne).mpr (by linarith)).symm
      rw [hinv2]
      calc e * ((1 / 2) * (1 / Mb)) * Mb
        = (e * (1 / 2)) * (Mb * (1 / Mb)) := by ring
        _ = (e * (1 / 2)) * 1 := by rw [hc]
        _ = e * (1 / 2) := by ring
    linarith
  have ht2 : |A| * |b n - B| < e / 2
    have hm1 := mul_le_mul_of_nonneg_right.real (|A|) Ma (|b n - B|) (by rw [hMa]; linarith) (abs_nonneg.real (b n - B))
    have hm2 := mul_lt_mul_of_pos_left.real (|b n - B|) (e / (2 * Ma)) Ma h2 hMa_pos
    have hcancel : Ma * (e / (2 * Ma)) = e / 2
      have hne : 2 * Ma ≠ 0 := by linarith
      have hc := mul_inv_cancel.real Ma (by linarith)
      rw [div_def.real e (2 * Ma), div_def.real e 2]
      have hinv2 : 1 / (2 * Ma) = (1 / 2) * (1 / Ma)
        have hprod : (2 * Ma) * ((1 / 2) * (1 / Ma)) = 1
          have h2c := mul_inv_cancel.real 2 (by decide)
          calc (2 * Ma) * ((1 / 2) * (1 / Ma))
            = (2 * (1 / 2)) * (Ma * (1 / Ma)) := by ring
            _ = 1 * 1 := by rw [h2c, hc]
            _ = 1 := by ring
        exact ((eq_div_iff.real ((1 / 2) * (1 / Ma)) 1 (2 * Ma) hne).mpr (by linarith)).symm
      rw [hinv2]
      calc Ma * (e * ((1 / 2) * (1 / Ma)))
        = (e * (1 / 2)) * (Ma * (1 / Ma)) := by ring
        _ = (e * (1 / 2)) * 1 := by rw [hc]
        _ = e * (1 / 2) := by ring
    linarith
  linarith

+ tends_to.pow (a : ℕ → ℝ) (A : ℝ) (k : ℕ) (ha : tends_to a A) :
    tends_to (fun n => (a n) ^ k) (A ^ k)
  induction k with j ih
  · have hf : (fun n => (a n) ^ 0) = (fun _ => (1 : ℝ)) := by funext n; rw [pow_zero.real]
    rw [hf, pow_zero.real]
    exact tends_to.const 1
  · rw [succ_eq_add_one.nat, pow_succ.real]
    have hm := tends_to.mul (fun n => (a n) ^ j) a (A ^ j) A ih ha
    exact tends_to.congr (fun n => (a n) ^ j * a n) (fun n => (a n) ^ (j + 1)) (A ^ j * A) hm (by intro n; rw [pow_succ.real])

-- THEOREM 2 (Limit Mertens 3-4-1 Inequality — AXIOM-FREE!):
+ mertens.limit_341_ge_one (a b c : ℕ → ℝ) (A B C : ℝ)
    (ha : tends_to a A) (hb : tends_to b B) (hc : tends_to c C)
    (hge : ∀ n, 1 ≤ (a n) ^ 3 * (b n) ^ 4 * c n) :
    1 ≤ A ^ 3 * B ^ 4 * C
  have h1 := tends_to.pow a A 3 ha
  have h2 := tends_to.pow b B 4 hb
  have h12 := tends_to.mul (fun n => (a n) ^ 3) (fun n => (b n) ^ 4) (A ^ 3) (B ^ 4) h1 h2
  have h123 := tends_to.mul (fun n => (a n) ^ 3 * (b n) ^ 4) c (A ^ 3 * B ^ 4) C h12 hc
  exact tends_to.ge_of_ge (fun n => (a n) ^ 3 * (b n) ^ 4 * c n) (A ^ 3 * B ^ 4 * C) 1 h123 hge

-- ====================================================================================
-- 4. THEOREM 3 (FULL HADAMARD-DE LA VALLEE POUSSIN Re(s) = 1 NONVANISHING — 0 AXIOMS!)
-- ====================================================================================

-- Helper: if L1 has complex derivative v at z0 and L1(z0) = 0, then near z0,
-- |L1(z)| <= (|v| + 1) * |z - z0|.
+ has_cderiv_at.linear_bound_of_zero (f : ℂ → ℂ) (z0 v : ℂ)
    (hf : has_cderiv_at f z0 v) (hz0 : f z0 = complex.zero) :
    ∃ δ : ℝ, 0 < δ ∧ ∀ z : ℂ, complex.abs (complex.sub z z0) < δ → complex.abs (f z) ≤ (complex.abs v + 1) * complex.abs (complex.sub z z0)
  unfold has_cderiv_at at hf
  obtain ⟨d, hd, hnear⟩ := hf 1 (by decide)
  use d; constructor
  · exact hd
  · intro z hz
    have hb := hnear z hz
    rw [hz0] at hb
    have hsub0 : complex.sub (f z) complex.zero = f z := by ring
    rw [hsub0] at hb
    have htri : complex.abs (f z) ≤ complex.abs (complex.sub (f z) (complex.mul v (complex.sub z z0))) + complex.abs (complex.mul v (complex.sub z z0))
      have heq : f z = complex.add (complex.sub (f z) (complex.mul v (complex.sub z z0))) (complex.mul v (complex.sub z z0))
        apply complex.ext <;> simp <;> ring
      have h1 := complex.abs_add_le (complex.sub (f z) (complex.mul v (complex.sub z z0))) (complex.mul v (complex.sub z z0))
      rw [← heq] at h1
      exact h1
    rw [complex.abs_mul] at htri
    linarith

-- HADAMARD-DE LA VALLEE POUSSIN NONVANISHING ON Re(s) = 1 (0 CUSTOM AXIOMS!):
-- Works uniformly for BOTH zeta(1 + it) != 0 (take L1 = L2 = zeta, t != 0) AND
-- Dirichlet L(chi, 1 + it) != 0 for every non-quadratic character (take L1 = L(chi), L2 = L(chi^2))!
+ hadamard_poussin.ne_zero_re_eq_one (zeta L1 L2 : ℂ → ℂ) (t delta C1 C3 : ℝ) (v : ℂ)
    (hdelta : 0 < delta) (hC1 : 0 ≤ C1) (hC3 : 0 ≤ C3)
    (hmertens : ∀ sigma : ℝ, 1 < sigma → sigma < 1 + delta → 1 ≤ (complex.abs (zeta (complex.of_real sigma))) ^ 3 * (complex.abs (L1 (complex.mk sigma t))) ^ 4 * complex.abs (L2 (complex.mk sigma (2 * t))))
    (hpole : ∀ sigma : ℝ, 1 < sigma → sigma < 1 + delta → complex.abs (zeta (complex.of_real sigma)) ≤ C1 / (sigma - 1))
    (hdiff : has_cderiv_at L1 (complex.mk 1 t) v)
    (hbdd : ∀ sigma : ℝ, 1 < sigma → sigma < 1 + delta → complex.abs (L2 (complex.mk sigma (2 * t))) ≤ C3) :
    L1 (complex.mk 1 t) ≠ complex.zero
  intro hz
  obtain ⟨d1, hd1, hlin⟩ := has_cderiv_at.linear_bound_of_zero L1 (complex.mk 1 t) v hdiff hz
  set C2 := complex.abs v + 1 with hC2
  have hC2_nn : 0 ≤ C2 := by rw [hC2]; linarith [complex.abs_nonneg v]
  set K := C1 ^ 3 * C2 ^ 4 * C3 + 1 with hK
  have hK_pos : 0 < K
    rw [hK]
    have h1 := pow_nonneg.real C1 hC1 3
    have h2 := pow_nonneg.real C2 hC2_nn 4
    have h12 := mul_nonneg.real (C1 ^ 3) (C2 ^ 4) h1 h2
    have h123 := mul_nonneg.real (C1 ^ 3 * C2 ^ 4) C3 h12 hC3
    linarith
  set eps := min (min (delta / 2) (d1 / 2)) (1 / (2 * K)) with heps
  have heps_pos : 0 < eps
    rw [heps]
    apply lt_min.real
    · apply lt_min.real
      · linarith
      · linarith
    · exact one_div_pos.real (2 * K) (by linarith)
  have heps_lt_delta : eps < delta
    have h1 := min_le_left.real (min (delta / 2) (d1 / 2)) (1 / (2 * K))
    have h2 := min_le_left.real (delta / 2) (d1 / 2)
    linarith
  have heps_lt_d1 : eps < d1
    have h1 := min_le_left.real (min (delta / 2) (d1 / 2)) (1 / (2 * K))
    have h2 := min_le_right.real (delta / 2) (d1 / 2)
    linarith
  have heps_le_K : eps ≤ 1 / (2 * K)
    rw [heps]
    exact min_le_right.real (min (delta / 2) (d1 / 2)) (1 / (2 * K))
  set sigma := 1 + eps with hsig
  have hsig_gt1 : 1 < sigma := by linarith
  have hsig_lt : sigma < 1 + delta := by linarith
  have hdist : complex.abs (complex.sub (complex.mk sigma t) (complex.mk 1 t)) = eps
    have hsq : complex.abs (complex.sub (complex.mk sigma t) (complex.mk 1 t)) * complex.abs (complex.sub (complex.mk sigma t) (complex.mk 1 t)) = eps * eps := by rw [complex.abs_sq]; unfold complex.norm_sq; simp; rw [hsig]; ring
    have h1 := complex.abs_nonneg (complex.sub (complex.mk sigma t) (complex.mk 1 t))
    nlinarith
  have hM := hmertens sigma hsig_gt1 hsig_lt
  have hZ := hpole sigma hsig_gt1 hsig_lt
  have hL1 := hlin (complex.mk sigma t) (by rw [hdist]; exact heps_lt_d1)
  rw [hdist] at hL1
  have hL2 := hbdd sigma hsig_gt1 hsig_lt
  have hse : sigma - 1 = eps := by rw [hsig]; ring
  rw [hse] at hZ
  -- Raise non-negative inequalities to powers 3 and 4:
  have hpow_mono : ∀ (x y : ℝ) (n : ℕ), 0 ≤ x → x ≤ y → x ^ n ≤ y ^ n
    intro x y n hx hxy
    induction n with j ih
    · rw [pow_zero.real, pow_zero.real]; linarith
    · rw [succ_eq_add_one.nat, pow_succ.real, pow_succ.real]
      have hxj := pow_nonneg.real x hx j
      have h1 := mul_le_mul_of_nonneg_left.real x y (x ^ j) hxy hxj
      have h2 := mul_le_mul_of_nonneg_right.real (x ^ j) (y ^ j) y ih (by linarith)
      linarith
  have hZ3 : (complex.abs (zeta (complex.of_real sigma))) ^ 3 ≤ (C1 / eps) ^ 3 :=
    hpow_mono (complex.abs (zeta (complex.of_real sigma))) (C1 / eps) 3 (complex.abs_nonneg (zeta (complex.of_real sigma))) hZ
  have hL14 : (complex.abs (L1 (complex.mk sigma t))) ^ 4 ≤ (C2 * eps) ^ 4 :=
    hpow_mono (complex.abs (L1 (complex.mk sigma t))) (C2 * eps) 4 (complex.abs_nonneg (L1 (complex.mk sigma t))) hL1
  have hL14_nn : 0 ≤ (complex.abs (L1 (complex.mk sigma t))) ^ 4 := pow_nonneg.real (complex.abs (L1 (complex.mk sigma t))) (complex.abs_nonneg (L1 (complex.mk sigma t))) 4
  have hL2_nn : 0 ≤ complex.abs (L2 (complex.mk sigma (2 * t))) := complex.abs_nonneg (L2 (complex.mk sigma (2 * t)))
  have hC1e_nn : 0 ≤ (C1 / eps) ^ 3 := pow_nonneg.real (C1 / eps) (div_nonneg.real C1 eps hC1 (by linarith)) 3
  have hC2e_nn : 0 ≤ (C2 * eps) ^ 4 := pow_nonneg.real (C2 * eps) (mul_nonneg.real C2 eps hC2_nn (by linarith)) 4
  have hprod1 : (complex.abs (zeta (complex.of_real sigma))) ^ 3 * (complex.abs (L1 (complex.mk sigma t))) ^ 4 ≤ (C1 / eps) ^ 3 * (C2 * eps) ^ 4
    have ha := mul_le_mul_of_nonneg_right.real ((complex.abs (zeta (complex.of_real sigma))) ^ 3) ((C1 / eps) ^ 3) ((complex.abs (L1 (complex.mk sigma t))) ^ 4) hZ3 hL14_nn
    have hb := mul_le_mul_of_nonneg_left.real ((complex.abs (L1 (complex.mk sigma t))) ^ 4) ((C2 * eps) ^ 4) ((C1 / eps) ^ 3) hL14 hC1e_nn
    linarith
  have hprod2 : (complex.abs (zeta (complex.of_real sigma))) ^ 3 * (complex.abs (L1 (complex.mk sigma t))) ^ 4 * complex.abs (L2 (complex.mk sigma (2 * t))) ≤ (C1 / eps) ^ 3 * (C2 * eps) ^ 4 * C3
    have ha := mul_le_mul_of_nonneg_right.real ((complex.abs (zeta (complex.of_real sigma))) ^ 3 * (complex.abs (L1 (complex.mk sigma t))) ^ 4) ((C1 / eps) ^ 3 * (C2 * eps) ^ 4) (complex.abs (L2 (complex.mk sigma (2 * t)))) hprod1 hL2_nn
    have hb := mul_le_mul_of_nonneg_left.real (complex.abs (L2 (complex.mk sigma (2 * t)))) C3 ((C1 / eps) ^ 3 * (C2 * eps) ^ 4) hL2 (mul_nonneg.real ((C1 / eps) ^ 3) ((C2 * eps) ^ 4) hC1e_nn hC2e_nn)
    linarith
  -- Cancel eps^3 from (C1 / eps)^3 * (C2 * eps)^4 = C1^3 * C2^4 * eps!
  have hcancel : (C1 / eps) ^ 3 * (C2 * eps) ^ 4 = C1 ^ 3 * C2 ^ 4 * eps
    have hc := mul_inv_cancel.real eps (by linarith)
    have hd : C1 / eps = C1 * (1 / eps) := div_def.real C1 eps
    rw [hd]
    have h3 : (C1 * (1 / eps)) ^ 3 = (C1 ^ 3) * ((1 / eps) * (1 / eps) * (1 / eps)) := by ring
    have h4 : (C2 * eps) ^ 4 = (C2 ^ 4) * (eps * eps * eps * eps) := by ring
    rw [h3, h4]
    calc (C1 ^ 3 * (1 / eps * (1 / eps) * (1 / eps))) * (C2 ^ 4 * (eps * eps * eps * eps))
      = (C1 ^ 3 * C2 ^ 4 * eps) * ((eps * (1 / eps)) * (eps * (1 / eps)) * (eps * (1 / eps))) := by ring
      _ = (C1 ^ 3 * C2 ^ 4 * eps) * (1 * 1 * 1) := by rw [hc]
      _ = C1 ^ 3 * C2 ^ 4 * eps := by ring
  rw [hcancel] at hprod2
  have hfinal_le : C1 ^ 3 * C2 ^ 4 * eps * C3 ≤ K * eps
    have heq : C1 ^ 3 * C2 ^ 4 * eps * C3 = (C1 ^ 3 * C2 ^ 4 * C3) * eps := by ring
    rw [heq]
    exact mul_le_mul_of_nonneg_right.real (C1 ^ 3 * C2 ^ 4 * C3) K eps (by rw [hK]; linarith) (by linarith)
  have hKeps : K * eps ≤ 1 / 2
    have hm := mul_le_mul_of_nonneg_left.real eps (1 / (2 * K)) K heps_le_K (by linarith)
    have hkc : K * (1 / (2 * K)) = 1 / 2
      have hne : 2 * K ≠ 0 := by linarith
      have hc := mul_inv_cancel.real (2 * K) hne
      have h2 := mul_inv_cancel.real 2 (by decide)
      linear_combination (1 / 2) * hc - (1 / (2 * K)) * K * h2
    linarith
  linarith

-- THEOREM 4 (Complete Closed Half-Plane Re(s) >= 1, s != 1 Nonvanishing — 0 AXIOMS!):
-- Combines `euler_limit.ne_zero_of_re_gt_one` (Re(s) > 1) and `hadamard_poussin.ne_zero_re_eq_one` (Re(s) = 1)!
+ zeta.ne_zero_re_ge_one (zeta : ℂ → ℂ) (s : ℂ)
    (hs : 1 ≤ complex.re s) (hne1 : s ≠ complex.one)
    (hgt1 : 1 < complex.re s → ∃ (w : ℕ → ℂ) (p : ℕ → ℝ) (B : ℝ) (L_seq : ℕ → ℂ),
      (∀ i, complex.norm_sq (w i) ≤ 1) ∧
      (∀ k, (∑ i < k, rpow (p i) (-complex.re s)) ≤ B) ∧
      (∀ k, complex.mul (cprod k (fun i => euler_factor (w i) (p i) s)) (L_seq k) = complex.one) ∧
      ctends_to L_seq (zeta s))
    (heq1 : complex.re s = 1 → ∃ (delta C1 C3 : ℝ) (v : ℂ),
      0 < delta ∧ 0 ≤ C1 ∧ 0 ≤ C3 ∧
      (∀ sigma : ℝ, 1 < sigma → sigma < 1 + delta → 1 ≤ (complex.abs (zeta (complex.of_real sigma))) ^ 3 * (complex.abs (zeta (complex.mk sigma (complex.im s)))) ^ 4 * complex.abs (zeta (complex.mk sigma (2 * complex.im s)))) ∧
      (∀ sigma : ℝ, 1 < sigma → sigma < 1 + delta → complex.abs (zeta (complex.of_real sigma)) ≤ C1 / (sigma - 1)) ∧
      has_cderiv_at zeta (complex.mk 1 (complex.im s)) v ∧
      (∀ sigma : ℝ, 1 < sigma → sigma < 1 + delta → complex.abs (zeta (complex.mk sigma (2 * complex.im s))) ≤ C3)) :
    zeta s ≠ complex.zero
  by_cases hstrict : 1 < complex.re s
  · obtain ⟨w, p, B, L_seq, hw, hsum, hinv, hlim⟩ := hgt1 hstrict
    exact (euler_limit.ne_zero_of_re_gt_one w p s B L_seq (zeta s) hw hsum hinv hlim).2
  · have hre1 : complex.re s = 1 := by linarith
    obtain ⟨delta, C1, C3, v, hd, hC1, hC3, hM, hP, hD, hB⟩ := heq1 hre1
    have hseta : s = complex.mk 1 (complex.im s)
      apply complex.ext <;> simp [hre1]
    rw [hseta]
    exact hadamard_poussin.ne_zero_re_eq_one zeta zeta zeta (complex.im s) delta C1 C3 v hd hC1 hC3 hM hP hD hB
