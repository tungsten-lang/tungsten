-- Milestone 3.34: Power-Series Analyticity Core, Identity Theorem, Zero Multiplicity
--                 & Log-Derivative Pole Decomposition, and Full Half-Plane Analyticity
--                 of `classical_L.l_fn chi` on Re(s) > 0 (0 CUSTOM AXIOMS!)
--
-- Purely elementary, 0-axiom complex analyticity library built directly on Satori's
-- real Darboux integral, Weierstrass-Gauss Gamma integral (M3.29), Riemann-Jacobi &
-- twisted theta integrals (M3.31-3.33), and `has_cderiv_at.of_uniform_quad_limit` (M3.22):
--   1. Exact complex exponential Taylor remainder:
--        |exp(z) - sum_{k < N} z^k / k!| <= (|z|^N / N!) * exp(|z|)  (via 1D real FTC)
--   2. Power-series analyticity core (`is_cpower_series_at`, `is_canalytic_at`, `cderiv_at`):
--        * closure under add/sub/neg/smul/mul (Cauchy product)/cprod/inv (when f(z0) != 0)
--        * term-by-term complex differentiation (`is_canalytic_at.cderiv_at`)
--        * disk re-expansion (`is_cpower_series_at.reexpand`) for Pringsheim-Landau
--        * coefficient uniqueness along rays & 1D segment Identity Theorem
--        * zero multiplicity, isolated zeros, & -f'(z)/f(z) = -m/(z - z0) + O(1)
--   3. Full half-plane Re(s) > 0 analyticity of:
--        * `cexp`, `cpow_real`, `induced_euler_ratio` (and nonvanishing on Re(s) > 0)
--        * `nt_mellin_int`, `classical_Lambda_nt`, `riemann_theta_tail_int` (entire on C!)
--        * `(s - 1) * classical_Lambda_triv s` (analytic on Re(s) > 0, equals 1 at s = 1!)
--        * `gamma` and `1 / classical_gamma` (on Re(s) > 0 via M3.29 + M3.27!)
--        * `classical_L_reg chi`: analytic on ALL Re(s) > 0, nonzero at s = 1 for trivial chi!
--
-- ALL theorems proved unconditionally on Satori's untouched HOL kernel (0 custom axioms).

import number_theory.classical_L_log_deriv

-- ====================================================================================
-- 1. COMPLEX EXPONENTIAL TAYLOR REMAINDER (VIA 1D REAL FTC, 0 AXIOMS!)
-- ====================================================================================

-> cexp_taylor (N : ℕ) (z : ℂ) : ℂ :=
  csum N (fun k => complex.smul (1 / ((fact k : ℕ) : ℝ)) (cpow_nat z k))

+ cpow_nat.real_smul (t : ℝ) (z : ℂ) (k : ℕ) :
    cpow_nat (complex.smul t z) k = complex.smul (t ^ k) (cpow_nat z k)
  induction k with j ihj
  · rw [pow_zero.real]; unfold cpow_nat; apply complex.ext <;> simp
  · rw [succ_eq_add_one.nat, pow_succ.real]
    have h1 : cpow_nat (complex.smul t z) (j + 1) = complex.mul (cpow_nat (complex.smul t z) j) (complex.smul t z) := by rfl
    have h2 : cpow_nat z (j + 1) = complex.mul (cpow_nat z j) z := by rfl
    rw [h1, h2, ihj]; apply complex.ext <;> simp <;> ring

+ cpow_nat.zero_succ (k : ℕ) : cpow_nat complex.zero (k + 1) = complex.zero
  have h1 : cpow_nat complex.zero (k + 1) = complex.mul (cpow_nat complex.zero k) complex.zero := by rfl
  rw [h1, complex.mul_zero]

+ complex.abs_smul (c : ℝ) (z : ℂ) : complex.abs (complex.smul c z) = |c| * complex.abs z
  have h1 : complex.smul c z = complex.mul (complex.of_real c) z
    unfold complex.of_real; apply complex.ext <;> simp <;> ring
  rw [h1, complex.abs_mul]
  have hof : complex.abs (complex.of_real c) = |c|
    have hsq : complex.abs (complex.of_real c) * complex.abs (complex.of_real c) = |c| * |c|
      rw [complex.abs_sq]; unfold complex.norm_sq complex.of_real; simp
      by_cases hc : 0 ≤ c
      · rw [abs_of_nonneg.real c hc]
      · rw [abs_of_neg.real c (by linarith)]; ring
    exact eq_of_sq_eq_nonneg (complex.abs (complex.of_real c)) (|c|) (complex.abs_nonneg (complex.of_real c)) (abs_nonneg.real c) hsq
  rw [hof]

+ complex.abs_exp (z : ℂ) : complex.abs (complex.exp z) = exp (complex.re z)
  have hsq : complex.abs (complex.exp z) * complex.abs (complex.exp z) = exp (complex.re z) * exp (complex.re z)
    rw [complex.abs_sq]; unfold complex.norm_sq; simp
    linear_combination (exp (complex.re z) * exp (complex.re z)) * sin_sq_add_cos_sq (complex.im z)
  exact eq_of_sq_eq_nonneg (complex.abs (complex.exp z)) (exp (complex.re z)) (complex.abs_nonneg (complex.exp z)) (by linarith [exp_pos (complex.re z)]) hsq

+ cexp_taylor.at_zero (N : ℕ) : cexp_taylor (N + 1) complex.zero = complex.one
  unfold cexp_taylor
  rw [csum.shift_zero (fun k => complex.smul (1 / ((fact k : ℕ) : ℝ)) (cpow_nat complex.zero k)) N]
  have h0 : complex.smul (1 / ((fact 0 : ℕ) : ℝ)) (cpow_nat complex.zero 0) = complex.one
    rw [fact_zero]; unfold cpow_nat; apply complex.ext <;> simp
  have htail : csum N (fun j => complex.smul (1 / ((fact (j + 1) : ℕ) : ℝ)) (cpow_nat complex.zero (j + 1))) = complex.zero
    have hgen : ∀ M : ℕ, csum M (fun j => complex.smul (1 / ((fact (j + 1) : ℕ) : ℝ)) (cpow_nat complex.zero (j + 1))) = complex.zero
      intro M; induction M with m ihm
      · rw [csum.zero]
      · rw [succ_eq_add_one.nat, csum.succ, ihm, cpow_nat.zero_succ]; apply complex.ext <;> simp
    exact hgen N
  rw [h0, htail, complex.add_zero]

-- Exact complex exponential Taylor remainder for ALL N and ALL z in C (via 1D real FTC on [0, 1]!):
+ cexp.taylor_rem_le (N : ℕ) :
    ∀ z : ℂ, complex.abs (complex.sub (complex.exp z) (cexp_taylor N z)) ≤ (complex.abs z ^ N / ((fact N : ℕ) : ℝ)) * exp (complex.abs z)
  induction N with z k ihk z
  · unfold cexp_taylor; rw [csum.zero, pow_zero.real, fact_zero]
    have hsub : complex.sub (complex.exp z) complex.zero = complex.exp z := by ring
    rw [hsub, complex.abs_exp]
    have hre : complex.re z ≤ complex.abs z := by linarith [le_abs_self.real (complex.re z), complex.re_abs_le z]
    have he := (exp_le_exp (complex.re z) (complex.abs z)).mpr hre
    simp
  · rw [succ_eq_add_one.nat]
    set S := (fun (w : ℝ) => (0 : ℝ) ≤ w ∧ w ≤ 1) with hS
    set R := (fun (m : ℕ) (w : ℂ) => complex.sub (complex.exp w) (cexp_taylor m w)) with hR
    set g := (fun (t : ℝ) => R (k + 1) (complex.smul t z)) with hg
    set gp := (fun (t : ℝ) => complex.mul z (R k (complex.smul t z))) with hgp
    -- Step 1: d/dt exp(t * z) = z * exp(t * z) componentwise!
    have hd_exp : ∀ t : ℝ, 0 ≤ t → t ≤ 1 →
        has_deriv_within (fun x => complex.re (complex.exp (complex.smul x z))) S t (complex.re (complex.mul z (complex.exp (complex.smul t z)))) ∧
        has_deriv_within (fun x => complex.im (complex.exp (complex.smul x z))) S t (complex.im (complex.mul z (complex.exp (complex.smul t z))))
      intro t _ _
      have ha : has_deriv_within (fun x => x * complex.re z) S t (complex.re z)
        have h := has_deriv_within.scale (complex.re z) (fun x => x) S t 1 (has_deriv_within.id S t)
        have hf : (fun x => complex.re z * x) = (fun x => x * complex.re z) := by funext x; ring
        have hv : complex.re z * 1 = complex.re z := by ring
        rw [hf, hv] at h; exact h
      have hb : has_deriv_within (fun x => x * complex.im z) S t (complex.im z)
        have h := has_deriv_within.scale (complex.im z) (fun x => x) S t 1 (has_deriv_within.id S t)
        have hf : (fun x => complex.im z * x) = (fun x => x * complex.im z) := by funext x; ring
        have hv : complex.im z * 1 = complex.im z := by ring
        rw [hf, hv] at h; exact h
      have he := has_deriv_within.exp_comp (fun x => x * complex.re z) S t (complex.re z) ha
      have hcos := has_deriv_within.comp cos (fun x => x * complex.im z) S (fun _ => True) t (-sin (t * complex.im z)) (complex.im z) (has_deriv_within.cos (fun _ => True) (t * complex.im z)) hb (by intro _ _; trivial)
      have hsin := has_deriv_within.comp sin (fun x => x * complex.im z) S (fun _ => True) t (cos (t * complex.im z)) (complex.im z) (has_deriv_within.sin (fun _ => True) (t * complex.im z)) hb (by intro _ _; trivial)
      constructor
      · have hm := has_deriv_within.mul (fun x => exp (x * complex.re z)) (fun x => cos (x * complex.im z)) S t (exp (t * complex.re z) * complex.re z) (-sin (t * complex.im z) * complex.im z) he hcos
        have hf : (fun x => exp (x * complex.re z) * cos (x * complex.im z)) = (fun x => complex.re (complex.exp (complex.smul x z))) := by funext x; simp
        have hv : exp (t * complex.re z) * complex.re z * cos (t * complex.im z) + exp (t * complex.re z) * (-sin (t * complex.im z) * complex.im z) = complex.re (complex.mul z (complex.exp (complex.smul t z))) := by simp; ring
        rw [hf, hv] at hm; exact hm
      · have hm := has_deriv_within.mul (fun x => exp (x * complex.re z)) (fun x => sin (x * complex.im z)) S t (exp (t * complex.re z) * complex.re z) (cos (t * complex.im z) * complex.im z) he hsin
        have hf : (fun x => exp (x * complex.re z) * sin (x * complex.im z)) = (fun x => complex.im (complex.exp (complex.smul x z))) := by funext x; simp
        have hv : exp (t * complex.re z) * complex.re z * sin (t * complex.im z) + exp (t * complex.re z) * (cos (t * complex.im z) * complex.im z) = complex.im (complex.mul z (complex.exp (complex.smul t z))) := by simp; ring
        rw [hf, hv] at hm; exact hm
    -- Step 2: d/dt cexp_taylor (k + 1) (t * z) = z * cexp_taylor k (t * z) componentwise!
    have hd_tay : ∀ t : ℝ, 0 ≤ t → t ≤ 1 →
        has_deriv_within (fun x => complex.re (cexp_taylor (k + 1) (complex.smul x z))) S t (complex.re (complex.mul z (cexp_taylor k (complex.smul t z)))) ∧
        has_deriv_within (fun x => complex.im (cexp_taylor (k + 1) (complex.smul x z))) S t (complex.im (complex.mul z (cexp_taylor k (complex.smul t z))))
      intro t _ _
      have hre_eq : (fun x => complex.re (cexp_taylor (k + 1) (complex.smul x z))) = (fun x => 1 + ∑ j < k, (x ^ (j + 1) / ((fact (j + 1) : ℕ) : ℝ)) * complex.re (cpow_nat z (j + 1)))
        funext x; unfold cexp_taylor
        rw [csum.shift_zero (fun m => complex.smul (1 / ((fact m : ℕ) : ℝ)) (cpow_nat (complex.smul x z) m)) k]
        have h0 : complex.re (complex.smul (1 / ((fact 0 : ℕ) : ℝ)) (cpow_nat (complex.smul x z) 0)) = 1
          rw [fact_zero]; unfold cpow_nat; simp
        have hre_add : complex.re (complex.add (complex.smul (1 / ((fact 0 : ℕ) : ℝ)) (cpow_nat (complex.smul x z) 0)) (csum k (fun j => complex.smul (1 / ((fact (j + 1) : ℕ) : ℝ)) (cpow_nat (complex.smul x z) (j + 1))))) = complex.re (complex.smul (1 / ((fact 0 : ℕ) : ℝ)) (cpow_nat (complex.smul x z) 0)) + complex.re (csum k (fun j => complex.smul (1 / ((fact (j + 1) : ℕ) : ℝ)) (cpow_nat (complex.smul x z) (j + 1)))) := by simp
        rw [hre_add, h0, csum.re_eq]
        have hcs : (∑ j < k, complex.re (complex.smul (1 / ((fact (j + 1) : ℕ) : ℝ)) (cpow_nat (complex.smul x z) (j + 1)))) = ∑ j < k, (x ^ (j + 1) / ((fact (j + 1) : ℕ) : ℝ)) * complex.re (cpow_nat z (j + 1))
          apply sum_congr.real; intro j _
          rw [cpow_nat.real_smul, div_def.real 1 ((fact (j + 1) : ℕ) : ℝ), div_def.real (x ^ (j + 1)) ((fact (j + 1) : ℕ) : ℝ)]; simp; ring
        rw [hcs]
      have him_eq : (fun x => complex.im (cexp_taylor (k + 1) (complex.smul x z))) = (fun x => ∑ j < k, (x ^ (j + 1) / ((fact (j + 1) : ℕ) : ℝ)) * complex.im (cpow_nat z (j + 1)))
        funext x; unfold cexp_taylor
        rw [csum.shift_zero (fun m => complex.smul (1 / ((fact m : ℕ) : ℝ)) (cpow_nat (complex.smul x z) m)) k]
        have h0 : complex.im (complex.smul (1 / ((fact 0 : ℕ) : ℝ)) (cpow_nat (complex.smul x z) 0)) = 0
          rw [fact_zero]; unfold cpow_nat; simp
        have him_add : complex.im (complex.add (complex.smul (1 / ((fact 0 : ℕ) : ℝ)) (cpow_nat (complex.smul x z) 0)) (csum k (fun j => complex.smul (1 / ((fact (j + 1) : ℕ) : ℝ)) (cpow_nat (complex.smul x z) (j + 1))))) = complex.im (complex.smul (1 / ((fact 0 : ℕ) : ℝ)) (cpow_nat (complex.smul x z) 0)) + complex.im (csum k (fun j => complex.smul (1 / ((fact (j + 1) : ℕ) : ℝ)) (cpow_nat (complex.smul x z) (j + 1)))) := by simp
        rw [him_add, h0, csum.im_eq]
        have hcs : (∑ j < k, complex.im (complex.smul (1 / ((fact (j + 1) : ℕ) : ℝ)) (cpow_nat (complex.smul x z) (j + 1)))) = ∑ j < k, (x ^ (j + 1) / ((fact (j + 1) : ℕ) : ℝ)) * complex.im (cpow_nat z (j + 1))
          apply sum_congr.real; intro j _
          rw [cpow_nat.real_smul, div_def.real 1 ((fact (j + 1) : ℕ) : ℝ), div_def.real (x ^ (j + 1)) ((fact (j + 1) : ℕ) : ℝ)]; simp; ring
        rw [hcs]; ring
      have hv_re : (∑ j < k, (t ^ j / ((fact j : ℕ) : ℝ)) * complex.re (cpow_nat z (j + 1))) = complex.re (complex.mul z (cexp_taylor k (complex.smul t z)))
        unfold cexp_taylor; rw [← csum.scale_left, csum.re_eq]
        apply sum_congr.real; intro j _
        rw [cpow_nat.real_smul]
        have h1 : cpow_nat z (j + 1) = complex.mul (cpow_nat z j) z := by rfl
        rw [h1]; simp
        rw [div_def.real (t ^ j) ((fact j : ℕ) : ℝ), div_def.real 1 ((fact j : ℕ) : ℝ)]; ring
      have hv_im : (∑ j < k, (t ^ j / ((fact j : ℕ) : ℝ)) * complex.im (cpow_nat z (j + 1))) = complex.im (complex.mul z (cexp_taylor k (complex.smul t z)))
        unfold cexp_taylor; rw [← csum.scale_left, csum.im_eq]
        apply sum_congr.real; intro j _
        rw [cpow_nat.real_smul]
        have h1 : cpow_nat z (j + 1) = complex.mul (cpow_nat z j) z := by rfl
        rw [h1]; simp
        rw [div_def.real (t ^ j) ((fact j : ℕ) : ℝ), div_def.real 1 ((fact j : ℕ) : ℝ)]; ring
      constructor
      · rw [hre_eq, ← hv_re]
        have hpt_re : ∀ j : ℕ, j < k → has_deriv_within (fun x => (x ^ (j + 1) / ((fact (j + 1) : ℕ) : ℝ)) * complex.re (cpow_nat z (j + 1))) S t ((t ^ j / ((fact j : ℕ) : ℝ)) * complex.re (cpow_nat z (j + 1)))
          intro j _
          have h1 := has_deriv_within.scale (complex.re (cpow_nat z (j + 1))) (fun x => x ^ (j + 1) / ((fact (j + 1) : ℕ) : ℝ)) S t (t ^ j / ((fact j : ℕ) : ℝ)) (has_deriv_within.exp_taylor_term j S t)
          have hf : (fun x => complex.re (cpow_nat z (j + 1)) * (x ^ (j + 1) / ((fact (j + 1) : ℕ) : ℝ))) = (fun x => (x ^ (j + 1) / ((fact (j + 1) : ℕ) : ℝ)) * complex.re (cpow_nat z (j + 1))) := by funext x; ring
          have hv : complex.re (cpow_nat z (j + 1)) * (t ^ j / ((fact j : ℕ) : ℝ)) = (t ^ j / ((fact j : ℕ) : ℝ)) * complex.re (cpow_nat z (j + 1)) := by ring
          rw [hf, hv] at h1; exact h1
        have hsum := has_deriv_within.sum_below (fun j x => (x ^ (j + 1) / ((fact (j + 1) : ℕ) : ℝ)) * complex.re (cpow_nat z (j + 1))) (fun j => (t ^ j / ((fact j : ℕ) : ℝ)) * complex.re (cpow_nat z (j + 1))) S t k hpt_re
        have hadd := has_deriv_within.add (fun _ => (1 : ℝ)) (fun x => ∑ j < k, (x ^ (j + 1) / ((fact (j + 1) : ℕ) : ℝ)) * complex.re (cpow_nat z (j + 1))) S t 0 (∑ j < k, (t ^ j / ((fact j : ℕ) : ℝ)) * complex.re (cpow_nat z (j + 1))) (has_deriv_within.const 1 S t) hsum
        have hv0 : 0 + (∑ j < k, (t ^ j / ((fact j : ℕ) : ℝ)) * complex.re (cpow_nat z (j + 1))) = ∑ j < k, (t ^ j / ((fact j : ℕ) : ℝ)) * complex.re (cpow_nat z (j + 1)) := by ring
        rw [hv0] at hadd; exact hadd
      · rw [him_eq, ← hv_im]
        have hpt_im : ∀ j : ℕ, j < k → has_deriv_within (fun x => (x ^ (j + 1) / ((fact (j + 1) : ℕ) : ℝ)) * complex.im (cpow_nat z (j + 1))) S t ((t ^ j / ((fact j : ℕ) : ℝ)) * complex.im (cpow_nat z (j + 1)))
          intro j _
          have h1 := has_deriv_within.scale (complex.im (cpow_nat z (j + 1))) (fun x => x ^ (j + 1) / ((fact (j + 1) : ℕ) : ℝ)) S t (t ^ j / ((fact j : ℕ) : ℝ)) (has_deriv_within.exp_taylor_term j S t)
          have hf : (fun x => complex.im (cpow_nat z (j + 1)) * (x ^ (j + 1) / ((fact (j + 1) : ℕ) : ℝ))) = (fun x => (x ^ (j + 1) / ((fact (j + 1) : ℕ) : ℝ)) * complex.im (cpow_nat z (j + 1))) := by funext x; ring
          have hv : complex.im (cpow_nat z (j + 1)) * (t ^ j / ((fact j : ℕ) : ℝ)) = (t ^ j / ((fact j : ℕ) : ℝ)) * complex.im (cpow_nat z (j + 1)) := by ring
          rw [hf, hv] at h1; exact h1
        exact has_deriv_within.sum_below (fun j x => (x ^ (j + 1) / ((fact (j + 1) : ℕ) : ℝ)) * complex.im (cpow_nat z (j + 1))) (fun j => (t ^ j / ((fact j : ℕ) : ℝ)) * complex.im (cpow_nat z (j + 1))) S t k hpt_im
    -- Step 3: Continuity of gp (re & im) on [0, 1] & complex FTC: int_0^1 gp(t) dt = g(1) - g(0) = R (k+1) z!
    have hcont_gp : ∀ t : ℝ, 0 ≤ t → t ≤ 1 → continuous_at (fun x => complex.re (gp x)) t ∧ continuous_at (fun x => complex.im (gp x)) t
      intro t _ _; rw [hgp, hR]; unfold cexp_taylor; continuity
    have hg0 : g 0 = complex.zero
      rw [hg, hR]
      have h0z : complex.smul 0 z = complex.zero
        apply complex.ext <;> simp
      rw [h0z, cexp_taylor.at_zero k]
      apply complex.ext
      · simp [exp_zero, cos_zero]
      · simp [sin_zero]
    have hg1 : g 1 = R (k + 1) z
      rw [hg]
      have h1z : complex.smul 1 z = z
        apply complex.ext <;> simp <;> ring
      rw [h1z]
    have hftc : c_has_integral gp 0 1 (R (k + 1) z)
      unfold c_has_integral; constructor
      · have hd_re : ∀ t : ℝ, 0 ≤ t → t ≤ 1 → has_deriv_within (fun x => complex.re (g x)) S t (complex.re (gp t))
          intro t ht1 ht2
          have hd := has_deriv_within.sub (fun x => complex.re (complex.exp (complex.smul x z))) (fun x => complex.re (cexp_taylor (k + 1) (complex.smul x z))) S t (complex.re (complex.mul z (complex.exp (complex.smul t z)))) (complex.re (complex.mul z (cexp_taylor k (complex.smul t z)))) (hd_exp t ht1 ht2).1 (hd_tay t ht1 ht2).1
          have hf : (fun x => complex.re (complex.exp (complex.smul x z)) - complex.re (cexp_taylor (k + 1) (complex.smul x z))) = (fun x => complex.re (g x)) := by funext x; rw [hg, hR]; simp
          have hv : complex.re (complex.mul z (complex.exp (complex.smul t z))) - complex.re (complex.mul z (cexp_taylor k (complex.smul t z))) = complex.re (gp t) := by rw [hgp, hR]; simp; ring
          rw [hf, hv] at hd; exact hd
        rw [hS] at hd_re
        have h1 := darboux.fundamental (fun x => complex.re (g x)) (fun x => complex.re (gp x)) 0 1 (by decide) (by intro t h1 h2; exact (hcont_gp t h1 h2).1) hd_re
        have hv1 : ((fun x => complex.re (g x)) 1 - (fun x => complex.re (g x)) 0) = complex.re (R (k + 1) z) := by simp [hg1, hg0]; ring
        rw [hv1] at h1; exact h1
      · have hd_im : ∀ t : ℝ, 0 ≤ t → t ≤ 1 → has_deriv_within (fun x => complex.im (g x)) S t (complex.im (gp t))
          intro t ht1 ht2
          have hd := has_deriv_within.sub (fun x => complex.im (complex.exp (complex.smul x z))) (fun x => complex.im (cexp_taylor (k + 1) (complex.smul x z))) S t (complex.im (complex.mul z (complex.exp (complex.smul t z)))) (complex.im (complex.mul z (cexp_taylor k (complex.smul t z)))) (hd_exp t ht1 ht2).2 (hd_tay t ht1 ht2).2
          have hf : (fun x => complex.im (complex.exp (complex.smul x z)) - complex.im (cexp_taylor (k + 1) (complex.smul x z))) = (fun x => complex.im (g x)) := by funext x; rw [hg, hR]; simp
          have hv : complex.im (complex.mul z (complex.exp (complex.smul t z))) - complex.im (complex.mul z (cexp_taylor k (complex.smul t z))) = complex.im (gp t) := by rw [hgp, hR]; simp; ring
          rw [hf, hv] at hd; exact hd
        rw [hS] at hd_im
        have h1 := darboux.fundamental (fun x => complex.im (g x)) (fun x => complex.im (gp x)) 0 1 (by decide) (by intro t h1 h2; exact (hcont_gp t h1 h2).2) hd_im
        have hv1 : ((fun x => complex.im (g x)) 1 - (fun x => complex.im (g x)) 0) = complex.im (R (k + 1) z) := by simp [hg1, hg0]; ring
        rw [hv1] at h1; exact h1
    -- Step 4: Majorize |gp t| <= (|z|^(k+1) / k! * exp(|z|)) * t^k and integrate t^k on [0, 1]!
    set C := (complex.abs z ^ (k + 1) / ((fact k : ℕ) : ℝ)) * exp (complex.abs z) with hC
    have hmaj_int : darboux.has_integral (fun t => C * t ^ k) 0 1 (C * (1 / ((k : ℝ) + 1)))
      have hp := darboux.pow 0 1 k (by decide)
      have hsc := darboux.scale (fun t => t ^ k) 0 1 (((1 : ℝ) ^ (k + 1) - (0 : ℝ) ^ (k + 1)) / ((k : ℝ) + 1)) C hp
      have h1p : ∀ m : ℕ, (1 : ℝ) ^ m = 1
        intro m; induction m with j ihj
        · rw [pow_zero.real]
        · rw [succ_eq_add_one.nat, pow_succ.real, ihj]; ring
      have h0p : (0 : ℝ) ^ (k + 1) = 0 := by rw [pow_succ.real]; ring
      rw [h1p (k + 1), h0p] at hsc
      have hv : C * ((1 - 0) / ((k : ℝ) + 1)) = C * (1 / ((k : ℝ) + 1)) := by ring
      rw [hv] at hsc; exact hsc
    have hpt : ∀ t : ℝ, 0 ≤ t → t ≤ 1 → complex.abs (gp t) ≤ C * t ^ k
      intro t ht1 ht2
      have hgpt : gp t = complex.mul z (R k (complex.smul t z)) := by rw [hgp]
      rw [hgpt, complex.abs_mul]
      have hih := ihk (complex.smul t z)
      rw [complex.abs_smul, abs_of_nonneg.real t ht1] at hih
      have hpow_mul : ∀ m : ℕ, (t * complex.abs z) ^ m = t ^ m * complex.abs z ^ m
        intro m; induction m with j ihj
        · rw [pow_zero.real, pow_zero.real, pow_zero.real]; ring
        · rw [succ_eq_add_one.nat, pow_succ.real, pow_succ.real, pow_succ.real, ihj]; ring
      rw [hpow_mul k] at hih
      have he_le : exp (t * complex.abs z) ≤ exp (complex.abs z)
        have h1 : t * complex.abs z ≤ complex.abs z := by nlinarith [complex.abs_nonneg z]
        exact (exp_le_exp (t * complex.abs z) (complex.abs z)).mpr h1
      have htk_nn : 0 ≤ t ^ k * complex.abs z ^ k / ((fact k : ℕ) : ℝ) := div_nonneg.real (t ^ k * complex.abs z ^ k) ((fact k : ℕ) : ℝ) (mul_nonneg.real (t ^ k) (complex.abs z ^ k) (pow_nonneg.real t ht1 k) (pow_nonneg.real (complex.abs z) (complex.abs_nonneg z) k)) (by linarith [fact_cast_pos k])
      have hm1 := mul_le_mul_of_nonneg_left.real (exp (t * complex.abs z)) (exp (complex.abs z)) (t ^ k * complex.abs z ^ k / ((fact k : ℕ) : ℝ)) he_le htk_nn
      have hRk : R k (complex.smul t z) = complex.sub (complex.exp (complex.smul t z)) (cexp_taylor k (complex.smul t z)) := by rw [hR]
      have hm2 := mul_le_mul_of_nonneg_left.real (complex.abs (R k (complex.smul t z))) ((t ^ k * complex.abs z ^ k / ((fact k : ℕ) : ℝ)) * exp (complex.abs z)) (complex.abs z) (by rw [hRk]; linarith) (complex.abs_nonneg z)
      have hre : complex.abs z * ((t ^ k * complex.abs z ^ k / ((fact k : ℕ) : ℝ)) * exp (complex.abs z)) = C * t ^ k
        rw [hC, pow_succ.real, div_def.real (t ^ k * complex.abs z ^ k) ((fact k : ℕ) : ℝ), div_def.real (complex.abs z ^ k * complex.abs z) ((fact k : ℕ) : ℝ)]; ring
      linarith
    have hbd := c_has_integral.abs_le_integral gp (fun t => C * t ^ k) 0 1 (C * (1 / ((k : ℝ) + 1))) (R (k + 1) z) (by decide) hftc hmaj_int hpt
    have hval_eq : C * (1 / ((k : ℝ) + 1)) = (complex.abs z ^ (k + 1) / ((fact (k + 1) : ℕ) : ℝ)) * exp (complex.abs z)
      rw [hC, fact_succ k, cast_mul.real (k + 1) (fact k), cast_add.real k 1]; simp
      have hk1_pos : (0 : ℝ) < (k : ℝ) + 1 := by linarith [cast_nonneg.real k]
      have hfk_pos : (0 : ℝ) < ((fact k : ℕ) : ℝ) := fact_cast_pos k
      field_simp
    have hR1 : R (k + 1) z = complex.sub (complex.exp z) (cexp_taylor (k + 1) z) := by rw [hR]
    rw [hval_eq, hR1] at hbd; exact hbd

-- ====================================================================================
-- 2. POWER-SERIES ANALYTICITY CORE (`is_cpower_series_at`, `is_canalytic_at`, `cderiv_at`)
-- ====================================================================================

-> is_cpower_series_at (f : ℂ → ℂ) (z0 : ℂ) (a : ℕ → ℂ) (r : ℝ) : Prop :=
  0 < r ∧ (∃ M : ℝ, 0 ≤ M ∧ ∀ k : ℕ, complex.abs (a k) * r ^ k ≤ M) ∧
  ∀ z : ℂ, complex.abs (complex.sub z z0) < r →
    ctends_to (fun N => csum N (fun k => complex.mul (a k) (cpow_nat (complex.sub z z0) k))) (f z)

-> is_canalytic_at (f : ℂ → ℂ) (z0 : ℂ) : Prop :=
  ∃ (a : ℕ → ℂ) (r : ℝ), is_cpower_series_at f z0 a r

-> cderiv_at (f : ℂ → ℂ) (z0 : ℂ) : ℂ :=
  clim (fun (n : ℕ) => complex.smul ((n + 1 : ℕ) : ℝ) (complex.sub (f (complex.add z0 (complex.of_real (1 / ((n + 1 : ℕ) : ℝ))))) (f z0)))

+ has_cderiv_at.cderiv_at_eq (f : ℂ → ℂ) (z0 V : ℂ) (hd : has_cderiv_at f z0 V) :
    cderiv_at f z0 = V
  unfold cderiv_at
  apply clim.eq_of_tends_to
  unfold ctends_to; intro e he
  unfold has_cderiv_at at hd
  obtain ⟨d, hd_pos, hbd⟩ := hd (e / 2) (by linarith)
  obtain ⟨N0, hN0⟩ := exists_nat_gt.real (1 / d)
  use N0; intro n hn
  set m := ((n + 1 : ℕ) : ℝ) with hm
  have hm_pos : 0 < m := by rw [hm]; exact (cast_pos.real (n + 1)).mpr (by omega)
  have h1m_pos : 0 < 1 / m := one_div_pos.real m hm_pos
  have h1m_lt_d : 1 / m < d
    have h1 : (N0 : ℝ) < m := by rw [hm]; exact (cast_lt.real N0 (n + 1)).mpr (by omega)
    have h2 : 1 / d < m := by linarith
    have h3 := (div_lt_iff.real 1 m d hd_pos).mp h2
    exact (div_lt_iff.real 1 d m hm_pos).mpr (by linarith)
  set z := complex.add z0 (complex.of_real (1 / m)) with hz
  have hsub_z : complex.sub z z0 = complex.of_real (1 / m)
    rw [hz]; unfold complex.of_real; apply complex.ext <;> simp <;> ring
  have habs_sub : complex.abs (complex.sub z z0) = 1 / m
    rw [hsub_z]
    have hsq : complex.abs (complex.of_real (1 / m)) * complex.abs (complex.of_real (1 / m)) = (1 / m) * (1 / m) := by rw [complex.abs_sq]; unfold complex.norm_sq complex.of_real; simp
    exact eq_of_sq_eq_nonneg (complex.abs (complex.of_real (1 / m))) (1 / m) (complex.abs_nonneg (complex.of_real (1 / m))) (by linarith) hsq
  have hq := hbd z (by linarith)
  rw [habs_sub] at hq
  have hcm := mul_inv_cancel.real m (by linarith)
  have hdiff_eq : complex.sub (complex.smul m (complex.sub (f z) (f z0))) V = complex.smul m (complex.sub (complex.sub (f z) (f z0)) (complex.mul V (complex.sub z z0)))
    rw [hsub_z]; unfold complex.of_real; apply complex.ext
    · simp; linear_combination (complex.re V) * hcm
    · simp; linear_combination (complex.im V) * hcm
  rw [hdiff_eq, complex.abs_smul, abs_of_pos.real m hm_pos]
  have hm1 := mul_le_mul_of_nonneg_left.real (complex.abs (complex.sub (complex.sub (f z) (f z0)) (complex.mul V (complex.sub z z0)))) ((e / 2) * (1 / m)) m hq (by linarith)
  have hre : m * ((e / 2) * (1 / m)) = e / 2 := by linear_combination (e / 2) * hcm
  linarith

-- Helper: geometric series bound & summability for 0 <= q < 1!
+ geom_sum_le_inv (q : ℝ) (hq0 : 0 ≤ q) (hq1 : q < 1) (N : ℕ) :
    (∑ k < N, q ^ k) ≤ 1 / (1 - q)
  have h1 : ∀ M : ℕ, (1 - q) * (∑ k < M, q ^ k) = 1 - q ^ M
    intro M; induction M with m ihm
    · rw [sum_below_zero, pow_zero.real]; ring
    · rw [succ_eq_add_one.nat, sum_below_succ]
      have ha : (1 - q) * ((∑ k < m, q ^ k) + q ^ m) = (1 - q) * (∑ k < m, q ^ k) + (1 - q) * q ^ m := by ring
      rw [ha, ihm, pow_succ.real]; ring
  have hnn : 0 ≤ q ^ N := pow_nonneg.real q hq0 N
  exact (le_div_iff.real (∑ k < N, q ^ k) 1 (1 - q) (by linarith)).mpr (by linarith [h1 N])

+ geom_summable (M q : ℝ) (hM : 0 ≤ M) (hq0 : 0 ≤ q) (hq1 : q < 1) :
    summable (fun k => M * q ^ k)
  unfold summable converges
  have hmon : monotone_seq (partial_sum (fun k => M * q ^ k))
    unfold monotone_seq partial_sum; intro m n hmn
    have hsh : ∀ d : ℕ, (∑ k < m, M * q ^ k) ≤ ∑ k < m + d, M * q ^ k
      intro d; induction d with l ihl
      · have h0 : m + 0 = m := by omega
        rw [h0]; linarith
      · rw [succ_eq_add_one.nat]
        have h1 : m + (l + 1) = (m + l) + 1 := by omega
        rw [h1, sum_below_succ]; linarith [mul_nonneg.real M (q ^ (m + l)) hM (pow_nonneg.real q hq0 (m + l))]
    have hn : n = m + (n - m) := by omega
    rw [hn]; exact hsh (n - m)
  have hbd : ∀ N : ℕ, partial_sum (fun k => M * q ^ k) N ≤ M / (1 - q)
    intro N; unfold partial_sum
    have hsc : ∀ k : ℕ, (∑ j < k, M * q ^ j) = M * (∑ j < k, q ^ j)
      intro k; induction k with j ihj
      · rw [sum_below_zero, sum_below_zero]; ring
      · rw [succ_eq_add_one.nat, sum_below_succ, sum_below_succ, ihj]; ring
    rw [hsc N]
    have hm := mul_le_mul_of_nonneg_left.real (∑ j < N, q ^ j) (1 / (1 - q)) M (geom_sum_le_inv q hq0 hq1 N) hM
    rw [div_def.real M (1 - q)]; linarith
  exact monotone_seq.converges_of_upper_bound (partial_sum (fun k => M * q ^ k)) (M / (1 - q)) hmon hbd

+ pow_div_pow_eq (x r : ℝ) (hr : 0 < r) (k : ℕ) : (x / r) ^ k = x ^ k / r ^ k :=
  div_pow.real x r k

+ rpow_nat_pos (r : ℝ) (hr : 0 < r) (k : ℕ) : 0 < r ^ k :=
  pow_pos.real r k hr

+ is_cpower_series_at.shrink (f : ℂ → ℂ) (z0 : ℂ) (a : ℕ → ℂ) (r r1 : ℝ)
    (hps : is_cpower_series_at f z0 a r) (hr1 : 0 < r1) (hle : r1 ≤ r) :
    is_cpower_series_at f z0 a r1
  unfold is_cpower_series_at at hps ⊢
  obtain ⟨M, hM, hMaj⟩ := hps.2.1
  constructor; exact hr1
  constructor
  · use M; constructor; exact hM; intro k
    have hpow : r1 ^ k ≤ r ^ k
      have hgen : ∀ m : ℕ, r1 ^ m ≤ r ^ m
        intro m; induction m with j ihj
        · rw [pow_zero.real, pow_zero.real]; linarith
        · rw [succ_eq_add_one.nat, pow_succ.real, pow_succ.real]
          have hm1 := mul_le_mul_of_nonneg_right.real (r1 ^ j) (r ^ j) r1 ihj (by linarith)
          have hm2 := mul_le_mul_of_nonneg_left.real r1 r (r ^ j) hle (pow_nonneg.real r (by linarith) j)
          linarith
      exact hgen k
    have hm := mul_le_mul_of_nonneg_left.real (r1 ^ k) (r ^ k) (complex.abs (a k)) hpow (complex.abs_nonneg (a k))
    linarith [hMaj k]
  · intro z hz; exact hps.2.2 z (by linarith)

+ is_cpower_series_at.at_center (f : ℂ → ℂ) (z0 : ℂ) (a : ℕ → ℂ) (r : ℝ)
    (hps : is_cpower_series_at f z0 a r) : a 0 = f z0
  have hz0 : complex.abs (complex.sub z0 z0) < r := by rw [complex.sub_self, complex.abs_zero]; exact hps.1
  have hlim := hps.2.2 z0 hz0
  have hconst : ctends_to (fun N => csum N (fun k => complex.mul (a k) (cpow_nat (complex.sub z0 z0) k))) (a 0)
    unfold ctends_to; intro e he; use 1; intro N hN
    have hN1 : N = (N - 1) + 1 := by omega
    rw [hN1, csum.shift_zero (fun k => complex.mul (a k) (cpow_nat (complex.sub z0 z0) k)) (N - 1)]
    have h0 : complex.mul (a 0) (cpow_nat (complex.sub z0 z0) 0) = a 0 := by unfold cpow_nat; exact complex.mul_one (a 0)
    have htail : csum (N - 1) (fun j => complex.mul (a (j + 1)) (cpow_nat (complex.sub z0 z0) (j + 1))) = complex.zero
      have hgen : ∀ M : ℕ, csum M (fun j => complex.mul (a (j + 1)) (cpow_nat (complex.sub z0 z0) (j + 1))) = complex.zero
        intro M; induction M with m ihm
        · rw [csum.zero]
        · rw [succ_eq_add_one.nat, csum.succ, ihm, complex.sub_self, cpow_nat.zero_succ, complex.mul_zero, complex.add_zero]
      exact hgen (N - 1)
    rw [h0, htail, complex.add_zero, complex.sub_self, complex.abs_zero]; exact he
  exact ctends_to.unique (fun N => csum N (fun k => complex.mul (a k) (cpow_nat (complex.sub z0 z0) k))) (a 0) (f z0) hconst hlim

+ is_canalytic_at.comp_affine (f : ℂ → ℂ) (a_sc : ℝ) (b_off s0 : ℂ) (ha : a_sc ≠ 0)
    (hf : is_canalytic_at f (complex.add (complex.smul a_sc s0) b_off)) :
    is_canalytic_at (fun s => f (complex.add (complex.smul a_sc s) b_off)) s0
  unfold is_canalytic_at at hf ⊢
  obtain ⟨c, r, hps⟩ := hf
  obtain ⟨M, hM, hMaj⟩ := hps.2.1
  have hr := hps.1
  have habs_pos : 0 < |a_sc|
    by_cases h : 0 ≤ a_sc
    · rw [abs_of_nonneg.real a_sc h]; by_contra hc; exact ha (by linarith)
    · rw [abs_of_neg.real a_sc (by linarith)]; linarith
  have habs_pow : ∀ k : ℕ, |a_sc ^ k| = |a_sc| ^ k
    intro k; induction k with j ihj
    · rw [pow_zero.real, pow_zero.real, abs_of_pos.real 1 (by decide)]
    · rw [succ_eq_add_one.nat, pow_succ.real, pow_succ.real, ← ihj]
      have hsq : |a_sc ^ j * a_sc| * |a_sc ^ j * a_sc| = (|a_sc ^ j| * |a_sc|) * (|a_sc ^ j| * |a_sc|)
        have h1 := sq_abs.real (a_sc ^ j * a_sc)
        have h2 := sq_abs.real (a_sc ^ j)
        have h3 := sq_abs.real a_sc
        linear_combination h1 - (a_sc * a_sc) * h2 - (|a_sc ^ j| * |a_sc ^ j|) * h3
      exact eq_of_sq_eq_nonneg (|a_sc ^ j * a_sc|) (|a_sc ^ j| * |a_sc|) (abs_nonneg.real (a_sc ^ j * a_sc)) (mul_nonneg.real (|a_sc ^ j|) (|a_sc|) (abs_nonneg.real (a_sc ^ j)) (abs_nonneg.real a_sc)) hsq
  use (fun k => complex.smul (a_sc ^ k) (c k)); use (r / |a_sc|)
  unfold is_cpower_series_at
  constructor; exact div_pos.real r (|a_sc|) hr habs_pos
  constructor
  · use M; constructor; exact hM; intro k
    rw [complex.abs_smul, habs_pow k, div_pow.real r (|a_sc|) k]
    have hre : |a_sc| ^ k * complex.abs (c k) * (r ^ k / |a_sc| ^ k) = complex.abs (c k) * r ^ k := by field_simp
    linarith [hMaj k]
  · intro s hs
    have hsub : complex.sub (complex.add (complex.smul a_sc s) b_off) (complex.add (complex.smul a_sc s0) b_off) = complex.smul a_sc (complex.sub s s0) := by ring
    have hdist : complex.abs (complex.sub (complex.add (complex.smul a_sc s) b_off) (complex.add (complex.smul a_sc s0) b_off)) < r
      rw [hsub, complex.abs_smul]
      have h1 := (lt_div_iff.real (complex.abs (complex.sub s s0)) r (|a_sc|) habs_pos).mp hs
      linarith
    have hl := hps.2.2 (complex.add (complex.smul a_sc s) b_off) hdist
    have hfe : (fun N => csum N (fun k => complex.mul (c k) (cpow_nat (complex.sub (complex.add (complex.smul a_sc s) b_off) (complex.add (complex.smul a_sc s0) b_off)) k))) = (fun N => csum N (fun k => complex.mul (complex.smul (a_sc ^ k) (c k)) (cpow_nat (complex.sub s s0) k)))
      funext N; apply csum.congr; intro k _
      rw [hsub, cpow_nat.real_smul a_sc (complex.sub s s0) k]; apply complex.ext <;> simp <;> ring
    rw [hfe] at hl; exact hl

+ is_cpower_series_at.tail_bound (f : ℂ → ℂ) (z0 : ℂ) (a : ℕ → ℂ) (r M : ℝ)
    (hr : 0 < r) (hM : 0 ≤ M) (hMaj : ∀ k : ℕ, complex.abs (a k) * r ^ k ≤ M)
    (hf : ∀ z : ℂ, complex.abs (complex.sub z z0) < r → ctends_to (fun N => csum N (fun k => complex.mul (a k) (cpow_nat (complex.sub z z0) k))) (f z))
    (z : ℂ) (hz : complex.abs (complex.sub z z0) < r) (N : ℕ) :
    complex.abs (complex.sub (f z) (csum N (fun k => complex.mul (a k) (cpow_nat (complex.sub z z0) k)))) ≤ M * (complex.abs (complex.sub z z0) / r) ^ N / (1 - complex.abs (complex.sub z z0) / r)
  set w := complex.sub z z0 with hw
  set q := complex.abs w / r with hq
  have hq0 : 0 ≤ q := by rw [hq]; exact div_nonneg.real (complex.abs w) r (complex.abs_nonneg w) (by linarith)
  have hq1 : q < 1 := by rw [hq]; exact (div_lt_iff.real (complex.abs w) 1 r hr).mpr (by linarith)
  have hterm : ∀ k : ℕ, complex.abs (complex.mul (a k) (cpow_nat w k)) ≤ M * q ^ k
    intro k; rw [complex.abs_mul, cpow_nat.abs_eq, hq, pow_div_pow_eq (complex.abs w) r hr k]
    have hrk := rpow_nat_pos r hr k
    have hc := mul_inv_cancel.real (r ^ k) (by linarith)
    have hm := mul_le_mul_of_nonneg_right.real (complex.abs (a k) * r ^ k) M (complex.abs w ^ k / r ^ k) (hMaj k) (div_nonneg.real (complex.abs w ^ k) (r ^ k) (pow_nonneg.real (complex.abs w) (complex.abs_nonneg w) k) (by linarith))
    have hre : complex.abs (a k) * r ^ k * (complex.abs w ^ k / r ^ k) = complex.abs (a k) * complex.abs w ^ k
      rw [div_def.real (complex.abs w ^ k) (r ^ k)]
      linear_combination (complex.abs (a k) * complex.abs w ^ k) * hc
    linarith
  have hfin : ∀ d : ℕ, complex.abs (complex.sub (csum (N + d) (fun k => complex.mul (a k) (cpow_nat w k))) (csum N (fun k => complex.mul (a k) (cpow_nat w k)))) ≤ M * q ^ N / (1 - q)
    intro d
    rw [csum.split_add N d (fun k => complex.mul (a k) (cpow_nat w k))]
    have hsub : complex.sub (complex.add (csum N (fun k => complex.mul (a k) (cpow_nat w k))) (csum d (fun j => complex.mul (a (N + j)) (cpow_nat w (N + j))))) (csum N (fun k => complex.mul (a k) (cpow_nat w k))) = csum d (fun j => complex.mul (a (N + j)) (cpow_nat w (N + j)))
      apply complex.ext <;> simp <;> ring
    rw [hsub]
    have hle1 := csum.abs_le_sum d (fun j => complex.mul (a (N + j)) (cpow_nat w (N + j)))
    have hpow_add : ∀ m : ℕ, q ^ (N + m) = q ^ N * q ^ m
      intro m; induction m with l ihl
      · have h0 : N + 0 = N := by omega
        rw [h0, pow_zero.real]; ring
      · rw [succ_eq_add_one.nat]
        have h1 : N + (l + 1) = (N + l) + 1 := by omega
        rw [h1, pow_succ.real, pow_succ.real, ihl]; ring
    have hle2 := sum_le.real (fun j => complex.abs (complex.mul (a (N + j)) (cpow_nat w (N + j)))) (fun j => (M * q ^ N) * q ^ j) d (by intro j hj; have ht := hterm (N + j); rw [hpow_add j] at ht; linarith)
    have hsc : ∀ m : ℕ, (∑ j < m, (M * q ^ N) * q ^ j) = (M * q ^ N) * (∑ j < m, q ^ j)
      intro m; induction m with l ihl
      · rw [sum_below_zero, sum_below_zero]; ring
      · rw [succ_eq_add_one.nat, sum_below_succ, sum_below_succ, ihl]; ring
    have hg := geom_sum_le_inv q hq0 hq1 d
    have hmq_nn : 0 ≤ M * q ^ N := mul_nonneg.real M (q ^ N) hM (pow_nonneg.real q hq0 N)
    have hm := mul_le_mul_of_nonneg_left.real (∑ j < d, q ^ j) (1 / (1 - q)) (M * q ^ N) hg hmq_nn
    rw [div_def.real (M * q ^ N) (1 - q)]
    linarith [hsc d]
  have hlim := hf z (by rw [← hw]; exact hz)
  have hsh : ctends_to (fun d => complex.sub (csum (N + d) (fun k => complex.mul (a k) (cpow_nat w k))) (csum N (fun k => complex.mul (a k) (cpow_nat w k)))) (complex.sub (f z) (csum N (fun k => complex.mul (a k) (cpow_nat w k))))
    unfold ctends_to at hlim ⊢; intro e he; obtain ⟨N0, hN0⟩ := hlim e he; use N0; intro d hd
    have hre : complex.sub (complex.sub (csum (N + d) (fun k => complex.mul (a k) (cpow_nat w k))) (csum N (fun k => complex.mul (a k) (cpow_nat w k)))) (complex.sub (f z) (csum N (fun k => complex.mul (a k) (cpow_nat w k)))) = complex.sub (csum (N + d) (fun k => complex.mul (a k) (cpow_nat w k))) (f z)
      apply complex.ext <;> simp <;> ring
    rw [hre, hw]; exact hN0 (N + d) (by omega)
  have habs_lim := ctends_to.abs (fun d => complex.sub (csum (N + d) (fun k => complex.mul (a k) (cpow_nat w k))) (csum N (fun k => complex.mul (a k) (cpow_nat w k)))) (complex.sub (f z) (csum N (fun k => complex.mul (a k) (cpow_nat w k)))) hsh
  have hneg_lim : tends_to (fun d => -complex.abs (complex.sub (csum (N + d) (fun k => complex.mul (a k) (cpow_nat w k))) (csum N (fun k => complex.mul (a k) (cpow_nat w k))))) (-complex.abs (complex.sub (f z) (csum N (fun k => complex.mul (a k) (cpow_nat w k)))))
    unfold tends_to at habs_lim ⊢; intro e he; obtain ⟨N0, hN0⟩ := habs_lim e he; use N0; intro d hd
    have hre : -complex.abs (complex.sub (csum (N + d) (fun k => complex.mul (a k) (cpow_nat w k))) (csum N (fun k => complex.mul (a k) (cpow_nat w k)))) - -complex.abs (complex.sub (f z) (csum N (fun k => complex.mul (a k) (cpow_nat w k)))) = -(complex.abs (complex.sub (csum (N + d) (fun k => complex.mul (a k) (cpow_nat w k))) (csum N (fun k => complex.mul (a k) (cpow_nat w k)))) - complex.abs (complex.sub (f z) (csum N (fun k => complex.mul (a k) (cpow_nat w k))))) := by ring
    rw [hre, abs_neg_eq]; exact hN0 d hd
  have hge := tends_to.ge_of_ge (fun d => -complex.abs (complex.sub (csum (N + d) (fun k => complex.mul (a k) (cpow_nat w k))) (csum N (fun k => complex.mul (a k) (cpow_nat w k))))) (-complex.abs (complex.sub (f z) (csum N (fun k => complex.mul (a k) (cpow_nat w k))))) (-(M * q ^ N / (1 - q))) hneg_lim (by intro d; linarith [hfin d])
  linarith

+ is_cpower_series_at.continuous_at (f : ℂ → ℂ) (z0 : ℂ) (a : ℕ → ℂ) (r : ℝ)
    (hps : is_cpower_series_at f z0 a r) :
    ∀ e : ℝ, 0 < e → ∃ d : ℝ, 0 < d ∧ ∀ z : ℂ, complex.abs (complex.sub z z0) < d → complex.abs (complex.sub (f z) (f z0)) < e
  obtain ⟨M, hM, hMaj⟩ := hps.2.1
  have ha0 := is_cpower_series_at.at_center f z0 a r hps
  intro e he
  set d := min (r / 2) (e * r / (4 * (M + 1))) with hd
  have hd_pos : 0 < d := by rw [hd]; exact lt_min.real (r / 2) (e * r / (4 * (M + 1))) 0 (by linarith [hps.1]) (div_pos.real (e * r) (4 * (M + 1)) (mul_pos.real e r he hps.1) (by linarith))
  use d; constructor; exact hd_pos; intro z hz
  have hzr2 : complex.abs (complex.sub z z0) < r / 2 := by linarith [min_le_left.real (r / 2) (e * r / (4 * (M + 1)))]
  have hzr : complex.abs (complex.sub z z0) < r := by linarith [hps.1]
  have htb := is_cpower_series_at.tail_bound f z0 a r M hps.1 hM hMaj hps.2.2 z hzr 1
  have hcs1 : csum 1 (fun k => complex.mul (a k) (cpow_nat (complex.sub z z0) k)) = f z0
    have h1 : csum 1 (fun k => complex.mul (a k) (cpow_nat (complex.sub z z0) k)) = complex.add (csum 0 (fun k => complex.mul (a k) (cpow_nat (complex.sub z z0) k))) (complex.mul (a 0) (cpow_nat (complex.sub z z0) 0)) := by rfl
    rw [h1, csum.zero, complex.zero_add]; unfold cpow_nat; rw [complex.mul_one, ha0]
  rw [hcs1] at htb
  have h10 : (1 : ℕ) = 0 + 1 := by omega
  have hpow1 : (complex.abs (complex.sub z z0) / r) ^ 1 = complex.abs (complex.sub z z0) / r := by rw [h10, pow_succ.real, pow_zero.real]; ring
  rw [hpow1] at htb
  have hq_le : complex.abs (complex.sub z z0) / r < 1 / 2 := by exact (div_lt_iff.real (complex.abs (complex.sub z z0)) (1 / 2) r hps.1).mpr (by linarith)
  have hnum_nn : 0 ≤ M * (complex.abs (complex.sub z z0) / r) := mul_nonneg.real M (complex.abs (complex.sub z z0) / r) hM (div_nonneg.real (complex.abs (complex.sub z z0)) r (complex.abs_nonneg (complex.sub z z0)) (by linarith [hps.1]))
  have hdiv_le : M * (complex.abs (complex.sub z z0) / r) / (1 - complex.abs (complex.sub z z0) / r) ≤ 2 * (M * (complex.abs (complex.sub z z0) / r)) := by exact (div_le_iff.real (M * (complex.abs (complex.sub z z0) / r)) (2 * (M * (complex.abs (complex.sub z z0) / r))) (1 - complex.abs (complex.sub z z0) / r) (by linarith)).mpr (by nlinarith)
  have hlt_e : complex.abs (complex.sub z z0) < e * r / (4 * (M + 1)) := by linarith [min_le_right.real (r / 2) (e * r / (4 * (M + 1)))]
  have hprod : complex.abs (complex.sub z z0) * (4 * (M + 1)) < e * r := (lt_div_iff.real (complex.abs (complex.sub z z0)) (e * r) (4 * (M + 1)) (by linarith)).mp hlt_e
  have hq_lt : 2 * M * (complex.abs (complex.sub z z0) / r) < e
    have h1 : 2 * M * complex.abs (complex.sub z z0) < e * r := by nlinarith [complex.abs_nonneg (complex.sub z z0)]
    have h2 := (div_lt_iff.real (2 * M * complex.abs (complex.sub z z0)) e r hps.1).mpr h1
    rw [div_def.real (2 * M * complex.abs (complex.sub z z0)) r] at h2
    rw [div_def.real (complex.abs (complex.sub z z0)) r]
    linarith
  linarith

+ is_cpower_series_at.congr (f g : ℂ → ℂ) (z0 : ℂ) (a : ℕ → ℂ) (r : ℝ)
    (hps : is_cpower_series_at f z0 a r)
    (heq : ∀ z : ℂ, complex.abs (complex.sub z z0) < r → f z = g z) :
    is_cpower_series_at g z0 a r
  unfold is_cpower_series_at at hps ⊢
  constructor; exact hps.1
  constructor; exact hps.2.1
  intro z hz; rw [← heq z hz]; exact hps.2.2 z hz

+ is_canalytic_at.congr (f g : ℂ → ℂ) (z0 : ℂ) (r : ℝ) (hr : 0 < r)
    (hf : is_canalytic_at f z0)
    (heq : ∀ z : ℂ, complex.abs (complex.sub z z0) < r → f z = g z) :
    is_canalytic_at g z0
  unfold is_canalytic_at at hf ⊢
  obtain ⟨a, r0, hps⟩ := hf
  set r1 := min r0 r with hr1
  have hr1_pos : 0 < r1 := by rw [hr1]; exact lt_min.real r0 r 0 hps.1 hr
  have hsh := is_cpower_series_at.shrink f z0 a r0 r1 hps hr1_pos (by rw [hr1]; exact min_le_left.real r0 r)
  exact ⟨a, r1, is_cpower_series_at.congr f g z0 a r1 hsh (by intro z hz; exact heq z (by linarith [min_le_right.real r0 r]))⟩


-- Arithmetic closure of `is_canalytic_at`: const, id, neg, smul, add, sub, mul, cprod, inv!
+ is_canalytic_at.const (c z0 : ℂ) : is_canalytic_at (fun _ => c) z0
  unfold is_canalytic_at
  use (fun k => if k = 0 then c else complex.zero); use 1
  unfold is_cpower_series_at
  constructor
  · use complex.abs c; constructor; exact complex.abs_nonneg c; intro k
    have h1p : ∀ m : ℕ, (1 : ℝ) ^ m = 1
      intro m; induction m with j ihj
      · rw [pow_zero.real]
      · rw [succ_eq_add_one.nat, pow_succ.real, ihj]; ring
    rw [h1p k]
    by_cases hk : k = 0
    · rw [if_pos hk]; linarith
    · rw [if_neg hk, complex.abs_zero]; linarith [complex.abs_nonneg c]
  · intro z _; unfold ctends_to; intro e he; use 1; intro N hN
    have hN1 : N = (N - 1) + 1 := by omega
    rw [hN1, csum.shift_zero (fun k => complex.mul (if k = 0 then c else complex.zero) (cpow_nat (complex.sub z z0) k)) (N - 1)]
    have h0 : complex.mul (if (0 : ℕ) = 0 then c else complex.zero) (cpow_nat (complex.sub z z0) 0) = c := by simp; unfold cpow_nat; exact complex.mul_one c
    have htail : csum (N - 1) (fun j => complex.mul (if j + 1 = 0 then c else complex.zero) (cpow_nat (complex.sub z z0) (j + 1))) = complex.zero
      have hgen : ∀ M : ℕ, csum M (fun j => complex.mul (if j + 1 = 0 then c else complex.zero) (cpow_nat (complex.sub z z0) (j + 1))) = complex.zero
        intro M; induction M with m ihm
        · rw [csum.zero]
        · rw [succ_eq_add_one.nat, csum.succ, ihm]
          have hne : m + 1 ≠ 0 := by omega
          rw [if_neg hne, complex.zero_mul, complex.add_zero]
      exact hgen (N - 1)
    rw [h0, htail, complex.add_zero, complex.sub_self, complex.abs_zero]; exact he

+ is_canalytic_at.id (z0 : ℂ) : is_canalytic_at (fun z => z) z0
  unfold is_canalytic_at
  use (fun k => if k = 0 then z0 else if k = 1 then complex.one else complex.zero); use 1
  unfold is_cpower_series_at
  constructor
  · use complex.abs z0 + 1; constructor; linarith [complex.abs_nonneg z0]; intro k
    have h1p : ∀ m : ℕ, (1 : ℝ) ^ m = 1
      intro m; induction m with j ihj
      · rw [pow_zero.real]
      · rw [succ_eq_add_one.nat, pow_succ.real, ihj]; ring
    rw [h1p k]
    by_cases hk0 : k = 0
    · rw [if_pos hk0]; linarith
    · rw [if_neg hk0]
      by_cases hk1 : k = 1
      · rw [if_pos hk1]
        have hab1 : complex.abs complex.one = 1
          have hsq : complex.abs complex.one * complex.abs complex.one = 1 := by rw [complex.abs_sq]; unfold complex.norm_sq; simp
          exact eq_of_sq_eq_nonneg (complex.abs complex.one) 1 (complex.abs_nonneg complex.one) (by decide) hsq
        rw [hab1]; linarith [complex.abs_nonneg z0]
      · rw [if_neg hk1, complex.abs_zero]; linarith [complex.abs_nonneg z0]
  · intro z _; unfold ctends_to; intro e he; use 2; intro N hN
    have hN2 : N = (N - 2) + 1 + 1 := by omega
    rw [hN2]
    set g := (fun k => complex.mul (if k = 0 then z0 else if k = 1 then complex.one else complex.zero) (cpow_nat (complex.sub z z0) k)) with hg
    rw [csum.shift_zero g ((N - 2) + 1), csum.shift_zero (fun j => g (j + 1)) (N - 2)]
    have hg0 : g 0 = z0 := by rw [hg]; simp; unfold cpow_nat; exact complex.mul_one z0
    have hg1 : g 1 = complex.sub z z0
      have hne : (1 : ℕ) ≠ 0 := by omega
      have hif0 : ∀ (u v : ℂ), (if (1 : ℕ) = 0 then u else v) = v := by intro u v; simp [hne]
      have hif1 : ∀ (u v : ℂ), (if (1 : ℕ) = 1 then u else v) = u := by intro u v; simp
      rw [hg]; simp [hif0, hif1]
      have hp1 : cpow_nat (complex.sub z z0) 1 = complex.mul (cpow_nat (complex.sub z z0) 0) (complex.sub z z0) := by rfl
      rw [hp1]; unfold cpow_nat; apply complex.ext <;> simp <;> ring
    have htail : csum (N - 2) (fun j => g (j + 1 + 1)) = complex.zero
      have hgen : ∀ M : ℕ, csum M (fun j => g (j + 1 + 1)) = complex.zero
        intro M; induction M with m ihm
        · rw [csum.zero]
        · rw [succ_eq_add_one.nat, csum.succ, ihm]
          have hne0 : m + 1 + 1 ≠ 0 := by omega
          have hne1 : m + 1 + 1 ≠ 1 := by omega
          have h0 : g (m + 1 + 1) = complex.mul (if m + 1 + 1 = 0 then z0 else if m + 1 + 1 = 1 then complex.one else complex.zero) (cpow_nat (complex.sub z z0) (m + 1 + 1)) := by rw [hg]
          have hm1 : g (m + 1 + 1) = complex.zero := by rw [h0, if_neg hne0, if_neg hne1, complex.zero_mul]
          rw [hm1, complex.add_zero]
      exact hgen (N - 2)
    have h01 : (0 : ℕ) + 1 = 1 := by omega
    rw [hg0, h01, hg1, htail, complex.add_zero]
    have hsum : complex.add z0 (complex.sub z z0) = z := by ring
    rw [hsum, complex.sub_self, complex.abs_zero]; exact he

+ is_canalytic_at.const_mul (c : ℂ) (f : ℂ → ℂ) (z0 : ℂ) (hf : is_canalytic_at f z0) :
    is_canalytic_at (fun z => complex.mul c (f z)) z0
  unfold is_canalytic_at at hf ⊢
  obtain ⟨a, r, hps⟩ := hf
  obtain ⟨M, hM, hMaj⟩ := hps.2.1
  use (fun k => complex.mul c (a k)); use r
  unfold is_cpower_series_at
  constructor; exact hps.1
  constructor
  · use complex.abs c * M; constructor; exact mul_nonneg.real (complex.abs c) M (complex.abs_nonneg c) hM
    intro k; rw [complex.abs_mul]
    have hm := mul_le_mul_of_nonneg_left.real (complex.abs (a k) * r ^ k) M (complex.abs c) (hMaj k) (complex.abs_nonneg c)
    linarith
  · intro z hz
    have hl := ctends_to.const_mul c (fun N => csum N (fun k => complex.mul (a k) (cpow_nat (complex.sub z z0) k))) (f z) (hps.2.2 z hz)
    have hfe : (fun N => complex.mul c (csum N (fun k => complex.mul (a k) (cpow_nat (complex.sub z z0) k)))) = (fun N => csum N (fun k => complex.mul (complex.mul c (a k)) (cpow_nat (complex.sub z z0) k)))
      funext N; rw [← csum.scale_left]; apply csum.congr; intro k _; apply complex.ext <;> simp <;> ring
    rw [hfe] at hl; exact hl

+ is_canalytic_at.neg (f : ℂ → ℂ) (z0 : ℂ) (hf : is_canalytic_at f z0) :
    is_canalytic_at (fun z => complex.neg (f z)) z0
  have h1 := is_canalytic_at.const_mul (complex.neg complex.one) f z0 hf
  have hfe : (fun z => complex.mul (complex.neg complex.one) (f z)) = (fun z => complex.neg (f z)) := by ring
  rw [hfe] at h1; exact h1

+ is_canalytic_at.add (f g : ℂ → ℂ) (z0 : ℂ) (hf : is_canalytic_at f z0) (hg : is_canalytic_at g z0) :
    is_canalytic_at (fun z => complex.add (f z) (g z)) z0
  unfold is_canalytic_at at hf hg ⊢
  obtain ⟨a, r1, h1⟩ := hf
  obtain ⟨b, r2, h2⟩ := hg
  set r := min r1 r2 with hr
  have hr_pos : 0 < r := by rw [hr]; exact lt_min.real r1 r2 0 h1.1 h2.1
  have h1s := is_cpower_series_at.shrink f z0 a r1 r h1 hr_pos (by rw [hr]; exact min_le_left.real r1 r2)
  have h2s := is_cpower_series_at.shrink g z0 b r2 r h2 hr_pos (by rw [hr]; exact min_le_right.real r1 r2)
  obtain ⟨M1, hM1, hMaj1⟩ := h1s.2.1
  obtain ⟨M2, hM2, hMaj2⟩ := h2s.2.1
  use (fun k => complex.add (a k) (b k)); use r
  unfold is_cpower_series_at
  constructor; exact hr_pos
  constructor
  · use M1 + M2; constructor; linarith; intro k
    have ht := complex.abs_add_le (a k) (b k)
    have hrk := pow_nonneg.real r (by linarith) k
    have hm := mul_le_mul_of_nonneg_right.real (complex.abs (complex.add (a k) (b k))) (complex.abs (a k) + complex.abs (b k)) (r ^ k) ht hrk
    linarith [hMaj1 k, hMaj2 k]
  · intro z hz
    have hl := ctends_to.add (fun N => csum N (fun k => complex.mul (a k) (cpow_nat (complex.sub z z0) k))) (fun N => csum N (fun k => complex.mul (b k) (cpow_nat (complex.sub z z0) k))) (f z) (g z) (h1s.2.2 z hz) (h2s.2.2 z hz)
    have hfe : (fun N => complex.add (csum N (fun k => complex.mul (a k) (cpow_nat (complex.sub z z0) k))) (csum N (fun k => complex.mul (b k) (cpow_nat (complex.sub z z0) k)))) = (fun N => csum N (fun k => complex.mul (complex.add (a k) (b k)) (cpow_nat (complex.sub z z0) k)))
      funext N
      have hgen : ∀ M : ℕ, complex.add (csum M (fun k => complex.mul (a k) (cpow_nat (complex.sub z z0) k))) (csum M (fun k => complex.mul (b k) (cpow_nat (complex.sub z z0) k))) = csum M (fun k => complex.mul (complex.add (a k) (b k)) (cpow_nat (complex.sub z z0) k))
        intro M; induction M with m ihm
        · rw [csum.zero, csum.zero, csum.zero, complex.add_zero]
        · rw [succ_eq_add_one.nat, csum.succ, csum.succ, csum.succ, ← ihm]; apply complex.ext <;> simp <;> ring
      exact hgen N
    rw [hfe] at hl; exact hl

+ is_canalytic_at.sub (f g : ℂ → ℂ) (z0 : ℂ) (hf : is_canalytic_at f z0) (hg : is_canalytic_at g z0) :
    is_canalytic_at (fun z => complex.sub (f z) (g z)) z0
  have h1 := is_canalytic_at.add f (fun z => complex.neg (g z)) z0 hf (is_canalytic_at.neg g z0 hg)
  have hfe : (fun z => complex.add (f z) (complex.neg (g z))) = (fun z => complex.sub (f z) (g z)) := by ring
  rw [hfe] at h1; exact h1

-- Cauchy product of two power series (0 axioms!):
-> cauchy_prod (a b : ℕ → ℂ) (n : ℕ) : ℂ :=
  csum (n + 1) (fun j => complex.mul (a j) (b (n - j)))

+ is_cpower_series_at.mul (f g : ℂ → ℂ) (z0 : ℂ) (a b : ℕ → ℂ) (r1 r2 : ℝ)
    (hf : is_cpower_series_at f z0 a r1) (hg : is_cpower_series_at g z0 b r2) :
    is_cpower_series_at (fun z => complex.mul (f z) (g z)) z0 (cauchy_prod a b) (min r1 r2 / 2)
  set r := min r1 r2 with hr
  have hr_pos : 0 < r := by rw [hr]; exact lt_min.real r1 r2 0 hf.1 hg.1
  have h1 := is_cpower_series_at.shrink f z0 a r1 r hf hr_pos (by rw [hr]; exact min_le_left.real r1 r2)
  have h2 := is_cpower_series_at.shrink g z0 b r2 r hg hr_pos (by rw [hr]; exact min_le_right.real r1 r2)
  obtain ⟨M1, hM1, hMaj1⟩ := h1.2.1
  obtain ⟨M2, hM2, hMaj2⟩ := h2.2.1
  set r0 := r / 2 with hr0
  have hr0_pos : 0 < r0 := by rw [hr0]; linarith
  have hpow_half : ∀ n : ℕ, r0 ^ n = r ^ n / (2 : ℝ) ^ n := by intro n; rw [hr0]; exact pow_div_pow_eq r 2 (by decide) n
  have hpow_add : ∀ (x : ℝ) (j k : ℕ), x ^ (j + k) = x ^ j * x ^ k
    intro x j k; induction k with l ihl
    · have h0 : j + 0 = j := by omega
      rw [h0, pow_zero.real]; ring
    · rw [succ_eq_add_one.nat]
      have h1a : j + (l + 1) = (j + l) + 1 := by omega
      rw [h1a, pow_succ.real, pow_succ.real, ihl]; ring
  have h2n_pos : ∀ n : ℕ, (0 : ℝ) < (2 : ℝ) ^ n := by intro n; exact rpow_nat_pos 2 (by decide) n
  unfold is_cpower_series_at
  constructor; exact hr0_pos
  constructor
  · use M1 * M2; constructor; exact mul_nonneg.real M1 M2 hM1 hM2
    intro n
    unfold cauchy_prod
    have hle1 := csum.abs_le_sum (n + 1) (fun j => complex.mul (a j) (b (n - j)))
    have hterm : ∀ j : ℕ, j < n + 1 → complex.abs (complex.mul (a j) (b (n - j))) * r ^ n ≤ M1 * M2
      intro j hj
      rw [complex.abs_mul]
      have hjn : j + (n - j) = n := by omega
      have hr_sp : r ^ n = r ^ j * r ^ (n - j) := by rw [← hpow_add r j (n - j), hjn]
      rw [hr_sp]
      have hre : complex.abs (a j) * complex.abs (b (n - j)) * (r ^ j * r ^ (n - j)) = (complex.abs (a j) * r ^ j) * (complex.abs (b (n - j)) * r ^ (n - j)) := by ring
      rw [hre]
      have hm1 := mul_le_mul_of_nonneg_right.real (complex.abs (a j) * r ^ j) M1 (complex.abs (b (n - j)) * r ^ (n - j)) (hMaj1 j) (mul_nonneg.real (complex.abs (b (n - j))) (r ^ (n - j)) (complex.abs_nonneg (b (n - j))) (pow_nonneg.real r (by linarith) (n - j)))
      have hm2 := mul_le_mul_of_nonneg_left.real (complex.abs (b (n - j)) * r ^ (n - j)) M2 M1 (hMaj2 (n - j)) hM1
      linarith
    have hsum_bd : (∑ j < n + 1, complex.abs (complex.mul (a j) (b (n - j)))) * r ^ n ≤ ((n + 1 : ℕ) : ℝ) * (M1 * M2)
      have hsc : ∀ m : ℕ, (∑ j < m, complex.abs (complex.mul (a j) (b (n - j)))) * r ^ n = ∑ j < m, complex.abs (complex.mul (a j) (b (n - j))) * r ^ n
        intro m; induction m with l ihl
        · rw [sum_below_zero, sum_below_zero]; ring
        · rw [succ_eq_add_one.nat, sum_below_succ, sum_below_succ, ← ihl]; ring
      rw [hsc (n + 1)]
      have hle2 := sum_le.real (fun j => complex.abs (complex.mul (a j) (b (n - j))) * r ^ n) (fun _ => M1 * M2) (n + 1) hterm
      have hconst : ∀ m : ℕ, (∑ j < m, M1 * M2) = (m : ℝ) * (M1 * M2)
        intro m; induction m with l ihl
        · rw [sum_below_zero]; simp
        · rw [succ_eq_add_one.nat, sum_below_succ, ihl, cast_add.real l 1]; simp; ring
      rw [hconst (n + 1)] at hle2; exact hle2
    have hm_le := mul_le_mul_of_nonneg_right.real (complex.abs (csum (n + 1) (fun j => complex.mul (a j) (b (n - j))))) (∑ j < n + 1, complex.abs (complex.mul (a j) (b (n - j)))) (r ^ n) hle1 (pow_nonneg.real r (by linarith) n)
    have h1 := le_trans.real (complex.abs (csum (n + 1) (fun j => complex.mul (a j) (b (n - j)))) * r ^ n) ((∑ j < n + 1, complex.abs (complex.mul (a j) (b (n - j)))) * r ^ n) (((n + 1 : ℕ) : ℝ) * (M1 * M2)) hm_le hsum_bd
    rw [hpow_half n]
    have hre : complex.abs (csum (n + 1) (fun j => complex.mul (a j) (b (n - j)))) * (r ^ n / (2 : ℝ) ^ n) = (complex.abs (csum (n + 1) (fun j => complex.mul (a j) (b (n - j)))) * r ^ n) / (2 : ℝ) ^ n := by field_simp
    rw [hre]
    have h2ge := two_pow_ge_succ n
    have hm2 := mul_le_mul_of_nonneg_right.real (((n + 1 : ℕ) : ℝ)) ((2 : ℝ) ^ n) (M1 * M2) h2ge (mul_nonneg.real M1 M2 hM1 hM2)
    exact (div_le_iff.real (complex.abs (csum (n + 1) (fun j => complex.mul (a j) (b (n - j)))) * r ^ n) (M1 * M2) ((2 : ℝ) ^ n) (h2n_pos n)).mpr (by linarith)
  · intro z hz
    set w := complex.sub z z0 with hw
    have hzr : complex.abs w < r := by linarith
    set q := complex.abs w / r with hq
    have hq0 : 0 ≤ q := by rw [hq]; exact div_nonneg.real (complex.abs w) r (complex.abs_nonneg w) (by linarith)
    have hq_half : q < 1 / 2 := by rw [hq]; exact (div_lt_iff.real (complex.abs w) (1 / 2) r hr_pos).mpr (by linarith)
    have hq1 : q < 1 := by linarith
    set A := (fun k => complex.mul (a k) (cpow_nat w k)) with hA
    set B := (fun k => complex.mul (b k) (cpow_nat w k)) with hB
    set C := (fun n => complex.mul (cauchy_prod a b n) (cpow_nat w n)) with hC
    have hA_bd : ∀ k : ℕ, complex.abs (A k) ≤ M1 * q ^ k
      intro k; rw [hA, complex.abs_mul, cpow_nat.abs_eq, hq, pow_div_pow_eq (complex.abs w) r hr_pos k]
      have hrk := rpow_nat_pos r hr_pos k
      have hc := mul_inv_cancel.real (r ^ k) (by linarith)
      have hm := mul_le_mul_of_nonneg_right.real (complex.abs (a k) * r ^ k) M1 (complex.abs w ^ k / r ^ k) (hMaj1 k) (div_nonneg.real (complex.abs w ^ k) (r ^ k) (pow_nonneg.real (complex.abs w) (complex.abs_nonneg w) k) (by linarith))
      have hre : complex.abs (a k) * r ^ k * (complex.abs w ^ k / r ^ k) = complex.abs (a k) * complex.abs w ^ k
        rw [div_def.real (complex.abs w ^ k) (r ^ k)]; linear_combination (complex.abs (a k) * complex.abs w ^ k) * hc
      linarith
    have hB_bd : ∀ k : ℕ, complex.abs (B k) ≤ M2 * q ^ k
      intro k; rw [hB, complex.abs_mul, cpow_nat.abs_eq, hq, pow_div_pow_eq (complex.abs w) r hr_pos k]
      have hrk := rpow_nat_pos r hr_pos k
      have hc := mul_inv_cancel.real (r ^ k) (by linarith)
      have hm := mul_le_mul_of_nonneg_right.real (complex.abs (b k) * r ^ k) M2 (complex.abs w ^ k / r ^ k) (hMaj2 k) (div_nonneg.real (complex.abs w ^ k) (r ^ k) (pow_nonneg.real (complex.abs w) (complex.abs_nonneg w) k) (by linarith))
      have hre : complex.abs (b k) * r ^ k * (complex.abs w ^ k / r ^ k) = complex.abs (b k) * complex.abs w ^ k
        rw [div_def.real (complex.abs w ^ k) (r ^ k)]; linear_combination (complex.abs (b k) * complex.abs w ^ k) * hc
      linarith
    -- Finite Cauchy product identity: csum N A * csum N B - csum N C = sum_{j<N} sum_{k<N} (if N <= j + k then A j * B k else 0)!
    have hfin_rem : ∀ N : ℕ, complex.sub (complex.mul (csum N A) (csum N B)) (csum N C) = csum N (fun j => csum N (fun k => if N ≤ j + k then complex.mul (A j) (B k) else complex.zero))
      intro N
      have hcsum_zero : ∀ (M : ℕ) (h : ℕ → ℂ), (∀ k, k < M → h k = complex.zero) → csum M h = complex.zero
        intro M h; induction M with h0 m ihm hz
        · rw [csum.zero]
        · rw [succ_eq_add_one.nat, csum.succ, ihm (by intro k hk; exact hz k (by omega)), hz m (by omega), complex.add_zero]
      have hcsum_single : ∀ (M k0 : ℕ) (h : ℕ → ℂ), k0 < M → csum M (fun k => if k = k0 then h k else complex.zero) = h k0
        intro M k0 h hk0
        have hgen : ∀ L : ℕ, csum L (fun k => if k = k0 then h k else complex.zero) = if k0 < L then h k0 else complex.zero
          intro L; induction L with l ihl
          · rw [csum.zero]; have hnot : ¬ (k0 < 0) := by omega
            have hif : ∀ (u v : ℂ), (if k0 < 0 then u else v) = v := by intro u v; simp [hnot]
            exact (hif (h k0) complex.zero).symm
          · rw [succ_eq_add_one.nat, csum.succ, ihl]
            by_cases hlt : k0 < l
            · have hne : l ≠ k0 := by omega
              have hlt1 : k0 < l + 1 := by omega
              rw [if_pos hlt, if_neg hne, if_pos hlt1, complex.add_zero]
            · by_cases heq : l = k0
              · have hlt1 : k0 < l + 1 := by omega
                rw [if_neg hlt, if_pos heq, if_pos hlt1, complex.zero_add, heq]
              · have hnot1 : ¬ (k0 < l + 1) := by omega
                rw [if_neg hlt, if_neg heq, if_neg hnot1, complex.add_zero]
        rw [hgen M]
        exact if_pos hk0
      have hswap : ∀ (P Q : ℕ) (h : ℕ → ℕ → ℂ), csum P (fun i => csum Q (fun j => h i j)) = csum Q (fun j => csum P (fun i => h i j))
        intro P Q h; induction P with p ihp
        · rw [csum.zero]; exact (hcsum_zero Q (fun j => csum 0 (fun i => h i j)) (by intro j _; rw [csum.zero])).symm
        · rw [succ_eq_add_one.nat, csum.succ, ihp]
          have h1a : ∀ M : ℕ, complex.add (csum M (fun j => csum p (fun i => h i j))) (csum M (fun j => h p j)) = csum M (fun j => csum (p + 1) (fun i => h i j))
            intro M; induction M with m ihm
            · rw [csum.zero, csum.zero, csum.zero, complex.add_zero]
            · rw [succ_eq_add_one.nat, csum.succ, csum.succ, csum.succ, ← ihm]; apply complex.ext <;> simp <;> ring
          exact h1a Q
      have hprod : complex.mul (csum N A) (csum N B) = csum N (fun j => csum N (fun k => complex.mul (A j) (B k)))
        have hgen : ∀ M : ℕ, complex.mul (csum M A) (csum N B) = csum M (fun j => csum N (fun k => complex.mul (A j) (B k)))
          intro M; induction M with m ihm
          · rw [csum.zero, csum.zero, complex.zero_mul]
          · rw [succ_eq_add_one.nat, csum.succ, csum.succ]
            have hd : complex.mul (complex.add (csum m A) (A m)) (csum N B) = complex.add (complex.mul (csum m A) (csum N B)) (complex.mul (A m) (csum N B))
              apply complex.ext <;> simp <;> ring
            rw [hd, ihm, csum.scale_left]
        exact hgen N
      have hC_dbl : csum N C = csum N (fun j => csum N (fun k => if j + k < N then complex.mul (A j) (B k) else complex.zero))
        have hCn : ∀ n : ℕ, n < N → C n = csum N (fun j => csum N (fun k => if j + k = n then complex.mul (A j) (B k) else complex.zero))
          intro n hn
          have hCn1 : C n = complex.mul (cauchy_prod a b n) (cpow_nat w n) := by rw [hC]
          rw [hCn1]; unfold cauchy_prod
          have hpull : ∀ M : ℕ, complex.mul (csum M (fun j => complex.mul (a j) (b (n - j)))) (cpow_nat w n) = csum M (fun j => complex.mul (complex.mul (a j) (b (n - j))) (cpow_nat w n))
            intro M; induction M with m ihm
            · rw [csum.zero, csum.zero, complex.zero_mul]
            · rw [succ_eq_add_one.nat, csum.succ, csum.succ]
              have hd : complex.mul (complex.add (csum m (fun j => complex.mul (a j) (b (n - j)))) (complex.mul (a m) (b (n - m)))) (cpow_nat w n) = complex.add (complex.mul (csum m (fun j => complex.mul (a j) (b (n - j)))) (cpow_nat w n)) (complex.mul (complex.mul (a m) (b (n - m))) (cpow_nat w n))
                apply complex.ext <;> simp <;> ring
              rw [hd, ihm]
          rw [hpull (n + 1)]
          have hinner : ∀ j : ℕ, j < N → csum N (fun k => if j + k = n then complex.mul (A j) (B k) else complex.zero) = if j ≤ n then complex.mul (complex.mul (a j) (b (n - j))) (cpow_nat w n) else complex.zero
            intro j hj
            by_cases hjn : j ≤ n
            · have hcon : csum N (fun k => if j + k = n then complex.mul (A j) (B k) else complex.zero) = csum N (fun k => if k = n - j then complex.mul (A j) (B k) else complex.zero)
                apply csum.congr; intro k _
                by_cases hkn : k = n - j
                · have h1a : j + k = n := by omega
                  rw [if_pos h1a, if_pos hkn]
                · have h1a : j + k ≠ n := by omega
                  rw [if_neg h1a, if_neg hkn]
              rw [hcon, hcsum_single N (n - j) (fun k => complex.mul (A j) (B k)) (by omega)]
              rw [if_pos hjn]
              have hAB : complex.mul (A j) (B (n - j)) = complex.mul (complex.mul (a j) (b (n - j))) (complex.mul (cpow_nat w j) (cpow_nat w (n - j)))
                rw [hA, hB]; apply complex.ext <;> simp <;> ring
              have haddn : j + (n - j) = n := by omega
              rw [hAB, ← cpow_nat.add w j (n - j), haddn]
            · rw [if_neg hjn]; apply hcsum_zero N; intro k _
              have hne : j + k ≠ n := by omega
              exact if_neg hne
          have houter : csum N (fun j => csum N (fun k => if j + k = n then complex.mul (A j) (B k) else complex.zero)) = csum N (fun j => if j ≤ n then complex.mul (complex.mul (a j) (b (n - j))) (cpow_nat w n) else complex.zero)
            apply csum.congr; intro j hj; exact hinner j hj
          rw [houter]
          have htrunc : ∀ (d : ℕ), csum ((n + 1) + d) (fun j => if j ≤ n then complex.mul (complex.mul (a j) (b (n - j))) (cpow_nat w n) else complex.zero) = csum (n + 1) (fun j => if j ≤ n then complex.mul (complex.mul (a j) (b (n - j))) (cpow_nat w n) else complex.zero)
            intro d; induction d with l ihl
            · have h0 : (n + 1) + 0 = n + 1 := by omega
              rw [h0]
            · rw [succ_eq_add_one.nat]
              have h1a : (n + 1) + (l + 1) = ((n + 1) + l) + 1 := by omega
              rw [h1a, csum.succ, ihl]
              have hnot : ¬ ((n + 1) + l ≤ n) := by omega
              rw [if_neg hnot, complex.add_zero]
          have hN_eq : N = (n + 1) + (N - (n + 1)) := by omega
          rw [hN_eq, htrunc (N - (n + 1))]
          apply csum.congr; intro j hj
          have hle : j ≤ n := by omega
          have hif : ∀ (u v : ℂ), (if j ≤ n then u else v) = u := by intro u v; simp [hle]
          exact (hif (complex.mul (complex.mul (a j) (b (n - j))) (cpow_nat w n)) complex.zero).symm
        have hC1 : csum N C = csum N (fun n => csum N (fun j => csum N (fun k => if j + k = n then complex.mul (A j) (B k) else complex.zero)))
          apply csum.congr; intro n hn; exact hCn n hn
