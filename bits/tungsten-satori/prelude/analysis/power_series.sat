        apply csum.congr; intro j _
        rw [hswap N N (fun n k => if j + k = n then complex.mul (A j) (B k) else complex.zero)]
        apply csum.congr; intro k _
        by_cases hlt : j + k < N
        · rw [if_pos hlt]
          have hcon : csum N (fun n => if j + k = n then complex.mul (A j) (B k) else complex.zero) = csum N (fun n => if n = j + k then complex.mul (A j) (B k) else complex.zero)
            apply csum.congr; intro n _
            by_cases heq : n = j + k
            · have h1a : j + k = n := heq.symm
              rw [if_pos h1a, if_pos heq]
            · have h1a : j + k ≠ n := by intro h; exact heq h.symm
              rw [if_neg h1a, if_neg heq]
