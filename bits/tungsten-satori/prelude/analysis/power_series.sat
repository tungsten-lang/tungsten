-- Exact quadratic Taylor remainder for complex powers (u + h)^(k + 2):
+ cpow_nat.quad_rem_le (u h : ℂ) (R : ℝ) (hu : complex.abs u ≤ R) (huh : complex.abs (complex.add u h) ≤ R) (k : ℕ) :
    complex.abs (complex.sub (complex.sub (cpow_nat (complex.add u h) (k + 2)) (cpow_nat u (k + 2))) (complex.mul (complex.smul ((k + 2 : ℕ) : ℝ) (cpow_nat u (k + 1))) h)) ≤ (((k + 2) * (k + 1) : ℕ) : ℝ) * R ^ k * (complex.abs h * complex.abs h)
  have hR_nn : 0 ≤ R := by linarith [complex.abs_nonneg u]
  induction k with j ihj
  · have h02 : (0 : ℕ) + 2 = 2 := by omega
    have h01 : (0 : ℕ) + 1 = 1 := by omega
    rw [h02, h01]
    have h0 : complex.sub (complex.sub (cpow_nat (complex.add u h) 2) (cpow_nat u 2)) (complex.mul (complex.smul ((2 : ℕ) : ℝ) (cpow_nat u 1)) h) = complex.mul h h
      have hp2 : ∀ w : ℂ, cpow_nat w 2 = complex.mul (complex.mul complex.one w) w := by intro w; rfl
      have hp1 : cpow_nat u 1 = complex.mul complex.one u := by rfl
      rw [hp2 (complex.add u h), hp2 u, hp1]; apply complex.ext <;> simp <;> ring
    rw [h0, complex.abs_mul, pow_zero.real]; simp; nlinarith [complex.abs_nonneg h]
  · rw [succ_eq_add_one.nat]
    have hid : complex.sub (complex.sub (cpow_nat (complex.add u h) (j + 1 + 2)) (cpow_nat u (j + 1 + 2))) (complex.mul (complex.smul ((j + 1 + 2 : ℕ) : ℝ) (cpow_nat u (j + 1 + 1))) h) = complex.add (complex.mul (complex.add u h) (complex.sub (complex.sub (cpow_nat (complex.add u h) (j + 2)) (cpow_nat u (j + 2))) (complex.mul (complex.smul ((j + 2 : ℕ) : ℝ) (cpow_nat u (j + 1))) h))) (complex.mul (complex.smul ((j + 2 : ℕ) : ℝ) (cpow_nat u (j + 1))) (complex.mul h h))
      have hp_uh : cpow_nat (complex.add u h) (j + 1 + 2) = complex.mul (cpow_nat (complex.add u h) (j + 2)) (complex.add u h) := by rfl
      have hp_u2 : cpow_nat u (j + 1 + 2) = complex.mul (cpow_nat u (j + 2)) u := by rfl
      have hp_u1 : cpow_nat u (j + 2) = complex.mul (cpow_nat u (j + 1)) u := by rfl
      have h12 : j + 1 + 2 = (j + 2) + 1 := by omega
      have hcast : ((j + 1 + 2 : ℕ) : ℝ) = ((j + 2 : ℕ) : ℝ) + 1 := by rw [h12, cast_add.real (j + 2) 1]; simp
      rw [hp_uh, hp_u2, hp_u1, hcast]; apply complex.ext <;> simp <;> ring
    rw [hid]
    have ht := complex.abs_add_le (complex.mul (complex.add u h) (complex.sub (complex.sub (cpow_nat (complex.add u h) (j + 2)) (cpow_nat u (j + 2))) (complex.mul (complex.smul ((j + 2 : ℕ) : ℝ) (cpow_nat u (j + 1))) h))) (complex.mul (complex.smul ((j + 2 : ℕ) : ℝ) (cpow_nat u (j + 1))) (complex.mul h h))
    rw [complex.abs_mul, complex.abs_mul, complex.abs_mul, complex.abs_smul, cpow_nat.abs_eq] at ht
    have hpow_u : complex.abs u ^ (j + 1) ≤ R ^ (j + 1)
      have hgen : ∀ m : ℕ, complex.abs u ^ m ≤ R ^ m
        intro m; induction m with l ihl
        · rw [pow_zero.real, pow_zero.real]; linarith
        · rw [succ_eq_add_one.nat, pow_succ.real, pow_succ.real]
          have hm1 := mul_le_mul_of_nonneg_right.real (complex.abs u ^ l) (R ^ l) (complex.abs u) ihl (complex.abs_nonneg u)
          have hm2 := mul_le_mul_of_nonneg_left.real (complex.abs u) R (R ^ l) hu (pow_nonneg.real R hR_nn l)
          linarith
      exact hgen (j + 1)
    have hterm1 : complex.abs (complex.add u h) * complex.abs (complex.sub (complex.sub (cpow_nat (complex.add u h) (j + 2)) (cpow_nat u (j + 2))) (complex.mul (complex.smul ((j + 2 : ℕ) : ℝ) (cpow_nat u (j + 1))) h)) ≤ (((j + 2) * (j + 1) : ℕ) : ℝ) * R ^ (j + 1) * (complex.abs h * complex.abs h)
      have hm1 := mul_le_mul_of_nonneg_left.real (complex.abs (complex.sub (complex.sub (cpow_nat (complex.add u h) (j + 2)) (cpow_nat u (j + 2))) (complex.mul (complex.smul ((j + 2 : ℕ) : ℝ) (cpow_nat u (j + 1))) h))) ((((j + 2) * (j + 1) : ℕ) : ℝ) * R ^ j * (complex.abs h * complex.abs h)) (complex.abs (complex.add u h)) ihj (complex.abs_nonneg (complex.add u h))
      have hm2 := mul_le_mul_of_nonneg_right.real (complex.abs (complex.add u h)) R ((((j + 2) * (j + 1) : ℕ) : ℝ) * R ^ j * (complex.abs h * complex.abs h)) huh (mul_nonneg.real ((((j + 2) * (j + 1) : ℕ) : ℝ) * R ^ j) (complex.abs h * complex.abs h) (mul_nonneg.real (((j + 2) * (j + 1) : ℕ) : ℝ) (R ^ j) (cast_nonneg.real ((j + 2) * (j + 1))) (pow_nonneg.real R hR_nn j)) (mul_nonneg.real (complex.abs h) (complex.abs h) (complex.abs_nonneg h) (complex.abs_nonneg h)))
      rw [pow_succ.real]; linarith
    have hterm2 : |((j + 2 : ℕ) : ℝ)| * complex.abs u ^ (j + 1) * (complex.abs h * complex.abs h) ≤ ((j + 2 : ℕ) : ℝ) * R ^ (j + 1) * (complex.abs h * complex.abs h)
      rw [abs_of_nonneg.real ((j + 2 : ℕ) : ℝ) (cast_nonneg.real (j + 2))]
      have hm1 := mul_le_mul_of_nonneg_left.real (complex.abs u ^ (j + 1)) (R ^ (j + 1)) ((j + 2 : ℕ) : ℝ) hpow_u (cast_nonneg.real (j + 2))
      exact mul_le_mul_of_nonneg_right.real (((j + 2 : ℕ) : ℝ) * complex.abs u ^ (j + 1)) (((j + 2 : ℕ) : ℝ) * R ^ (j + 1)) (complex.abs h * complex.abs h) hm1 (mul_nonneg.real (complex.abs h) (complex.abs h) (complex.abs_nonneg h) (complex.abs_nonneg h))
    have hcoeff : (((j + 2) * (j + 1) : ℕ) : ℝ) + ((j + 2 : ℕ) : ℝ) ≤ (((j + 1 + 2) * (j + 1 + 1) : ℕ) : ℝ)
      have hnat : (j + 2) * (j + 1) + (j + 2) ≤ (j + 1 + 2) * (j + 1 + 1) := by nlinarith
      rw [← cast_add.real ((j + 2) * (j + 1)) (j + 2)]
      exact (cast_le.real ((j + 2) * (j + 1) + (j + 2)) ((j + 1 + 2) * (j + 1 + 1))).mpr hnat
    have hmul_c := mul_le_mul_of_nonneg_right.real ((((j + 2) * (j + 1) : ℕ) : ℝ) + ((j + 2 : ℕ) : ℝ)) (((j + 1 + 2) * (j + 1 + 1) : ℕ) : ℝ) (R ^ (j + 1) * (complex.abs h * complex.abs h)) hcoeff (mul_nonneg.real (R ^ (j + 1)) (complex.abs h * complex.abs h) (pow_nonneg.real R hR_nn (j + 1)) (mul_nonneg.real (complex.abs h) (complex.abs h) (complex.abs_nonneg h) (complex.abs_nonneg h)))
    linarith

-- Elementary geometric dominance: ((k+2)*(k+1)) * (3/4)^k <= 256 * (7/8)^k!
+ quad_poly_geom_le (k : ℕ) : (((k + 2) * (k + 1) : ℕ) : ℝ) * (3 / 4) ^ k ≤ 256 * (7 / 8) ^ k
  -- Equivalent to ((k+2)*(k+1)) <= 256 * (7/6)^k!
  -- Prove by induction on k: for k >= 15, (k+3)/(k+1) <= 7/6; actually direct: (7/6)^k >= 1 + k/6 + k*(k-1)/(2*36)?
  -- Even simpler: (7/6)^k = exp(k * log(7/6)), wait: direct induction on `((k + 2) * (k + 1) : ℝ) * (6 / 7)^k <= 256`!
  -- Better: (k+2)*(k+1) * (3/4)^k * (8/7)^k = (k+2)*(k+1) * (6/7)^k; prove `((k + 2) * (k + 1) : ℝ) * (6 / 7)^k <= 256` directly!
  have h67 : ∀ m : ℕ, (((m + 2) * (m + 1) : ℕ) : ℝ) * (6 / 7) ^ m ≤ 256
    intro m
    -- Note 7/6 = 1 + 1/6; prove by induction: (7/6)^m >= 1 + (m : R) / 6 + (m * (m - 1) : R) / 72?
    -- Even easier: prove `(m + 2) * (m + 1) <= 256 * (7 / 6)^m` by induction on m!
    -- Wait: for m < 12, (m+2)*(m+1) <= 13*12 = 156 <= 256 <= 256 * (7/6)^m!
    -- For m >= 12, (m + 3) * (m + 2) <= (7 / 6) * (m + 2) * (m + 1) because 6*(m + 3) = 6m + 18 <= 7m + 7 = 7*(m + 1) (since m >= 11)!
    have h76 : ∀ n : ℕ, (((n + 2) * (n + 1) : ℕ) : ℝ) ≤ 256 * (7 / 6) ^ n
      intro n; induction n with j ihj
      · rw [pow_zero.real]; simp
      · rw [succ_eq_add_one.nat, pow_succ.real]
        by_cases hj11 : j < 11
        · have hle : (j + 1 + 2) * (j + 1 + 1) ≤ 156 := by nlinarith
          have hge1 : ∀ l : ℕ, (1 : ℝ) ≤ (7 / 6) ^ l
            intro l; induction l with p ihp
            · rw [pow_zero.real]; linarith
            · rw [succ_eq_add_one.nat, pow_succ.real]; nlinarith
          have h1 := hge1 (j + 1); rw [pow_succ.real] at h1; linarith
        · have hstep : 6 * ((j + 1 + 2) * (j + 1 + 1)) ≤ 7 * ((j + 2) * (j + 1)) := by nlinarith
          linarith
    have hmul_pow : ∀ n : ℕ, (7 / 6 : ℝ) ^ n * (6 / 7 : ℝ) ^ n = 1
      intro n; induction n with j ihj
      · rw [pow_zero.real, pow_zero.real]; ring
      · rw [succ_eq_add_one.nat, pow_succ.real, pow_succ.real]
        have hre : (7 / 6 : ℝ) ^ j * (7 / 6) * ((6 / 7) ^ j * (6 / 7)) = ((7 / 6) ^ j * (6 / 7) ^ j) * ((7 / 6) * (6 / 7)) := by ring
        rw [hre, ihj]; ring
    have hm := mul_le_mul_of_nonneg_right.real (((m + 2) * (m + 1) : ℕ) : ℝ) (256 * (7 / 6) ^ m) ((6 / 7) ^ m) (h76 m) (pow_nonneg.real (6 / 7) (by decide) m)
    have hre : 256 * (7 / 6 : ℝ) ^ m * (6 / 7) ^ m = 256 * ((7 / 6) ^ m * (6 / 7) ^ m) := by ring
    rw [hre, hmul_pow m] at hm; linarith
  have hpow_sp : ∀ n : ℕ, (3 / 4 : ℝ) ^ n = (6 / 7 : ℝ) ^ n * (7 / 8 : ℝ) ^ n
    intro n; induction n with j ihj
    · rw [pow_zero.real, pow_zero.real, pow_zero.real]; ring
    · rw [succ_eq_add_one.nat, pow_succ.real, pow_succ.real, pow_succ.real, ihj]; ring
  rw [hpow_sp k]
  have hm := mul_le_mul_of_nonneg_right.real ((((k + 2) * (k + 1) : ℕ) : ℝ) * (6 / 7) ^ k) 256 ((7 / 8) ^ k) (h67 k) (pow_nonneg.real (7 / 8) (by decide) k)
  linarith

-- Term-by-term complex differentiation of power series on |z - z0| < r / 2 (0 axioms!):
+ is_cpower_series_at.has_cderiv_and_deriv (f : ℂ → ℂ) (z0 : ℂ) (a : ℕ → ℂ) (r : ℝ)
    (hps : is_cpower_series_at f z0 a r) :
    (∀ z : ℂ, complex.abs (complex.sub z z0) < r / 2 → has_cderiv_at f z (cderiv_at f z)) ∧
    is_cpower_series_at (cderiv_at f) z0 (fun k => complex.smul ((k + 1 : ℕ) : ℝ) (a (k + 1))) (r / 2)
  obtain ⟨M, hM, hMaj⟩ := hps.2.1
  have hr := hps.1
  set a' := (fun (k : ℕ) => complex.smul ((k + 1 : ℕ) : ℝ) (a (k + 1))) with ha'
  have h2n_pos : ∀ n : ℕ, (0 : ℝ) < (2 : ℝ) ^ n := by intro n; exact rpow_nat_pos 2 (by decide) n
  have hMaj' : ∀ k : ℕ, complex.abs (a' k) * (r / 2) ^ k ≤ M / r
    intro k
    rw [ha', complex.abs_smul, abs_of_nonneg.real ((k + 1 : ℕ) : ℝ) (cast_nonneg.real (k + 1)), pow_div_pow_eq r 2 (by decide) k]
    have h1 := hMaj (k + 1)
    rw [pow_succ.real] at h1
    have h2ge := two_pow_ge_succ k
    have hle1 : ((k + 1 : ℕ) : ℝ) / (2 : ℝ) ^ k ≤ 1 := (div_le_iff.real ((k + 1 : ℕ) : ℝ) 1 ((2 : ℝ) ^ k) (h2n_pos k)).mpr (by linarith)
    have hak_le : complex.abs (a (k + 1)) * r ^ k ≤ M / r := by exact (le_div_iff.real (complex.abs (a (k + 1)) * r ^ k) M r hr).mpr (by linarith)
    have hm1 := mul_le_mul_of_nonneg_right.real (((k + 1 : ℕ) : ℝ) / (2 : ℝ) ^ k) 1 (complex.abs (a (k + 1)) * r ^ k) hle1 (mul_nonneg.real (complex.abs (a (k + 1))) (r ^ k) (complex.abs_nonneg (a (k + 1))) (pow_nonneg.real r (by linarith) k))
    have hre : ((k + 1 : ℕ) : ℝ) * complex.abs (a (k + 1)) * (r ^ k / (2 : ℝ) ^ k) = (((k + 1 : ℕ) : ℝ) / (2 : ℝ) ^ k) * (complex.abs (a (k + 1)) * r ^ k) := by field_simp
    linarith
  -- For every z with |z - z0| < r / 2, the derivative series converges to some V(z) AND has_cderiv_at f z (V z)!
  have hderiv_at : ∀ z : ℂ, complex.abs (complex.sub z z0) < r / 2 →
      ∃ V : ℂ, ctends_to (fun N => csum N (fun k => complex.mul (a' k) (cpow_nat (complex.sub z z0) k))) V ∧ has_cderiv_at f z V
    intro z hz
    set q := complex.abs (complex.sub z z0) / (r / 2) with hq
    have hq0 : 0 ≤ q := by rw [hq]; exact div_nonneg.real (complex.abs (complex.sub z z0)) (r / 2) (complex.abs_nonneg (complex.sub z z0)) (by linarith)
    have hq1 : q < 1 := by rw [hq]; exact (div_lt_iff.real (complex.abs (complex.sub z z0)) 1 (r / 2) (by linarith)).mpr (by linarith)
    have hcs : csummable (fun k => complex.mul (a' k) (cpow_nat (complex.sub z z0) k))
      apply csummable.of_abs_summable
      apply summable.of_nonneg_le (fun k => complex.abs (complex.mul (a' k) (cpow_nat (complex.sub z z0) k))) (fun k => (M / r) * q ^ k)
      · intro k; exact complex.abs_nonneg (complex.mul (a' k) (cpow_nat (complex.sub z z0) k))
      · intro k; rw [complex.abs_mul, cpow_nat.abs_eq, hq, pow_div_pow_eq (complex.abs (complex.sub z z0)) (r / 2) (by linarith) k]
        have hrk := rpow_nat_pos (r / 2) (by linarith) k
        have hc := mul_inv_cancel.real ((r / 2) ^ k) (by linarith)
        have hm := mul_le_mul_of_nonneg_right.real (complex.abs (a' k) * (r / 2) ^ k) (M / r) (complex.abs (complex.sub z z0) ^ k / (r / 2) ^ k) (hMaj' k) (div_nonneg.real (complex.abs (complex.sub z z0) ^ k) ((r / 2) ^ k) (pow_nonneg.real (complex.abs (complex.sub z z0)) (complex.abs_nonneg (complex.sub z z0)) k) (by linarith))
        have hre : complex.abs (a' k) * (r / 2) ^ k * (complex.abs (complex.sub z z0) ^ k / (r / 2) ^ k) = complex.abs (a' k) * complex.abs (complex.sub z z0) ^ k
          rw [div_def.real (complex.abs (complex.sub z z0) ^ k) ((r / 2) ^ k)]; linear_combination (complex.abs (a' k) * complex.abs (complex.sub z z0) ^ k) * hc
        linarith
      · exact geom_summable (M / r) q (div_nonneg.real M r hM (by linarith)) hq0 hq1
    unfold csummable cconverges at hcs; obtain ⟨V, hV⟩ := hcs
    use V; constructor; exact hV
    -- Apply M3.22 `has_cderiv_at.of_uniform_quad_limit` with radius r / 4 and S_seq N w = csum (N + 1) ...!
    set S_seq := (fun (N : ℕ) (w : ℂ) => csum (N + 1) (fun k => complex.mul (a k) (cpow_nat (complex.sub w z0) k))) with hSseq
    set V_seq := (fun (N : ℕ) => csum N (fun k => complex.mul (a' k) (cpow_nat (complex.sub z z0) k))) with hVseq
    set Mq := 4096 * M / (r * r) with hMq
    have hMq_nn : 0 ≤ Mq := by rw [hMq]; exact div_nonneg.real (4096 * M) (r * r) (by linarith) (by nlinarith)
    apply has_cderiv_at.of_uniform_quad_limit S_seq V_seq f z V (r / 4) Mq (by linarith) hMq_nn
    · intro w hw
      have hwr : complex.abs (complex.sub w z0) < r
        have ht := complex.abs_sub_triangle w z z0; linarith
      have hl := hps.2.2 w hwr
      unfold ctends_to at hl ⊢; intro e he; obtain ⟨N0, hN0⟩ := hl e he; use N0; intro N hN
      rw [hSseq]; exact hN0 (N + 1) (by omega)
    · exact hV
    · intro N w hw
      set u := complex.sub z z0 with hu
      set h := complex.sub w z with hh
      have huh : complex.add u h = complex.sub w z0
        rw [hu, hh]; apply complex.ext <;> simp <;> ring
      have hu_le : complex.abs u ≤ (3 / 4) * r := by linarith
      have huh_le : complex.abs (complex.add u h) ≤ (3 / 4) * r
        rw [huh]; have ht := complex.abs_sub_triangle w z z0; rw [← hu, ← hh] at ht; linarith
      have hdiff_eq : ∀ L : ℕ, complex.sub (complex.sub (S_seq L w) (S_seq L z)) (complex.mul (V_seq L) h) = csum L (fun k => complex.mul (a (k + 1)) (complex.sub (complex.sub (cpow_nat (complex.add u h) (k + 1)) (cpow_nat u (k + 1))) (complex.mul (complex.smul ((k + 1 : ℕ) : ℝ) (cpow_nat u k)) h)))
        intro L; rw [hSseq, hVseq]; induction L with l ihl
        · rw [csum.zero, csum.shift_zero (fun k => complex.mul (a k) (cpow_nat (complex.sub w z0) k)) 0, csum.shift_zero (fun k => complex.mul (a k) (cpow_nat (complex.sub z z0) k)) 0, csum.zero, csum.zero]
          unfold cpow_nat; apply complex.ext <;> simp <;> ring
        · rw [succ_eq_add_one.nat, csum.succ (l + 1), csum.succ (l + 1), csum.succ l (fun k => complex.mul (a' k) (cpow_nat u k)), csum.succ l (fun k => complex.mul (a (k + 1)) (complex.sub (complex.sub (cpow_nat (complex.add u h) (k + 1)) (cpow_nat u (k + 1))) (complex.mul (complex.smul ((k + 1 : ℕ) : ℝ) (cpow_nat u k)) h)))]
          have hre : complex.sub (complex.sub (complex.add (csum (l + 1) (fun k => complex.mul (a k) (cpow_nat (complex.sub w z0) k))) (complex.mul (a (l + 1)) (cpow_nat (complex.sub w z0) (l + 1)))) (complex.add (csum (l + 1) (fun k => complex.mul (a k) (cpow_nat (complex.sub z z0) k))) (complex.mul (a (l + 1)) (cpow_nat (complex.sub z z0) (l + 1))))) (complex.mul (complex.add (csum l (fun k => complex.mul (a' k) (cpow_nat u k))) (complex.mul (a' l) (cpow_nat u l))) h) = complex.add (complex.sub (complex.sub (csum (l + 1) (fun k => complex.mul (a k) (cpow_nat (complex.sub w z0) k))) (csum (l + 1) (fun k => complex.mul (a k) (cpow_nat (complex.sub z z0) k)))) (complex.mul (csum l (fun k => complex.mul (a' k) (cpow_nat u k))) h)) (complex.mul (a (l + 1)) (complex.sub (complex.sub (cpow_nat (complex.add u h) (l + 1)) (cpow_nat u (l + 1))) (complex.mul (complex.smul ((l + 1 : ℕ) : ℝ) (cpow_nat u l)) h)))
            rw [huh, ← hu, ha']; apply complex.ext <;> simp <;> ring
          rw [hre, ihl]
      rw [hdiff_eq N]
      have hterm_bd : ∀ k : ℕ, complex.abs (complex.mul (a (k + 1)) (complex.sub (complex.sub (cpow_nat (complex.add u h) (k + 1)) (cpow_nat u (k + 1))) (complex.mul (complex.smul ((k + 1 : ℕ) : ℝ) (cpow_nat u k)) h))) ≤ (512 * M / (r * r)) * (7 / 8) ^ k * (complex.abs h * complex.abs h)
        intro k
        by_cases hk0 : k = 0
        · rw [hk0]
          have h01 : (0 : ℕ) + 1 = 1 := by omega
          rw [h01]
          have h0 : complex.sub (complex.sub (cpow_nat (complex.add u h) 1) (cpow_nat u 1)) (complex.mul (complex.smul ((1 : ℕ) : ℝ) (cpow_nat u 0)) h) = complex.zero
            have hp1 : ∀ y : ℂ, cpow_nat y 1 = complex.mul complex.one y := by intro y; rfl
            rw [hp1 (complex.add u h), hp1 u]; unfold cpow_nat; apply complex.ext <;> simp <;> ring
          rw [h0, complex.mul_zero, complex.abs_zero, pow_zero.real]
          exact mul_nonneg.real ((512 * M / (r * r)) * 1) (complex.abs h * complex.abs h) (mul_nonneg.real (512 * M / (r * r)) 1 (div_nonneg.real (512 * M) (r * r) (by linarith) (by nlinarith)) (by decide)) (mul_nonneg.real (complex.abs h) (complex.abs h) (complex.abs_nonneg h) (complex.abs_nonneg h))
        · set j := k - 1 with hj
          have hk_eq : k = j + 1 := by omega
          rw [hk_eq, complex.abs_mul]
          have hqr := cpow_nat.quad_rem_le u h ((3 / 4) * r) hu_le huh_le j
          have hpow_mul : ∀ m : ℕ, ((3 / 4) * r) ^ m = (3 / 4) ^ m * r ^ m
            intro m; induction m with l ihl
            · rw [pow_zero.real, pow_zero.real, pow_zero.real]; ring
            · rw [succ_eq_add_one.nat, pow_succ.real, pow_succ.real, pow_succ.real, ihl]; ring
          rw [hpow_mul j] at hqr
          have hm1 := mul_le_mul_of_nonneg_left.real (complex.abs (complex.sub (complex.sub (cpow_nat (complex.add u h) (j + 2)) (cpow_nat u (j + 2))) (complex.mul (complex.smul ((j + 2 : ℕ) : ℝ) (cpow_nat u (j + 1))) h))) ((((j + 2) * (j + 1) : ℕ) : ℝ) * ((3 / 4) ^ j * r ^ j) * (complex.abs h * complex.abs h)) (complex.abs (a (j + 2))) hqr (complex.abs_nonneg (a (j + 2)))
          have hMj := hMaj (j + 2)
          have h21 : j + 2 = (j + 1) + 1 := by omega
          rw [h21, pow_succ.real, pow_succ.real] at hMj
          have ha_le : complex.abs (a (j + 2)) * r ^ j ≤ M / (r * r)
            rw [h21]
            exact (le_div_iff.real (complex.abs (a ((j + 1) + 1)) * r ^ j) M (r * r) (by nlinarith)).mpr (by linarith)
          have hpg := quad_poly_geom_le j
          have h78 : 256 * (7 / 8 : ℝ) ^ j ≤ 512 * (7 / 8) ^ (j + 1)
            rw [pow_succ.real]; linarith [pow_nonneg.real (7 / 8) (by decide) j]
          have hnn_pg : 0 ≤ (((j + 2) * (j + 1) : ℕ) : ℝ) * (3 / 4) ^ j := mul_nonneg.real (((j + 2) * (j + 1) : ℕ) : ℝ) ((3 / 4) ^ j) (cast_nonneg.real ((j + 2) * (j + 1))) (pow_nonneg.real (3 / 4) (by decide) j)
          have hm2 := mul_le_mul_of_nonneg_right.real (complex.abs (a (j + 2)) * r ^ j) (M / (r * r)) ((((j + 2) * (j + 1) : ℕ) : ℝ) * (3 / 4) ^ j) ha_le hnn_pg
          have hm3 := mul_le_mul_of_nonneg_left.real ((((j + 2) * (j + 1) : ℕ) : ℝ) * (3 / 4) ^ j) (512 * (7 / 8) ^ (j + 1)) (M / (r * r)) (by linarith) (div_nonneg.real M (r * r) hM (by nlinarith))
          have hm4 := mul_le_mul_of_nonneg_right.real ((complex.abs (a (j + 2)) * r ^ j) * ((((j + 2) * (j + 1) : ℕ) : ℝ) * (3 / 4) ^ j)) ((M / (r * r)) * (512 * (7 / 8) ^ (j + 1))) (complex.abs h * complex.abs h) (by linarith) (mul_nonneg.real (complex.abs h) (complex.abs h) (complex.abs_nonneg h) (complex.abs_nonneg h))
          have hre2 : (M / (r * r)) * (512 * (7 / 8) ^ (j + 1)) = (512 * M / (r * r)) * (7 / 8) ^ (j + 1)
            rw [div_def.real M (r * r), div_def.real (512 * M) (r * r)]; ring
          rw [hre2] at hm4; rw [← h21]; linarith
      have h1 := csum.abs_le_sum N (fun k => complex.mul (a (k + 1)) (complex.sub (complex.sub (cpow_nat (complex.add u h) (k + 1)) (cpow_nat u (k + 1))) (complex.mul (complex.smul ((k + 1 : ℕ) : ℝ) (cpow_nat u k)) h)))
      have h2 := sum_le.real (fun k => complex.abs (complex.mul (a (k + 1)) (complex.sub (complex.sub (cpow_nat (complex.add u h) (k + 1)) (cpow_nat u (k + 1))) (complex.mul (complex.smul ((k + 1 : ℕ) : ℝ) (cpow_nat u k)) h)))) (fun k => (512 * M / (r * r) * (complex.abs h * complex.abs h)) * (7 / 8) ^ k) N (by intro k _; linarith [hterm_bd k])
      have hsc : ∀ m : ℕ, (∑ k < m, (512 * M / (r * r) * (complex.abs h * complex.abs h)) * (7 / 8) ^ k) = (512 * M / (r * r) * (complex.abs h * complex.abs h)) * (∑ k < m, (7 / 8) ^ k)
        intro m; induction m with l ihl
        · rw [sum_below_zero, sum_below_zero]; ring
        · rw [succ_eq_add_one.nat, sum_below_succ, sum_below_succ, ihl]; ring
      have hg := geom_sum_le_inv (7 / 8) (by decide) (by decide) N
      have hnn := mul_nonneg.real (512 * M / (r * r)) (complex.abs h * complex.abs h) (div_nonneg.real (512 * M) (r * r) (by linarith) (by nlinarith)) (mul_nonneg.real (complex.abs h) (complex.abs h) (complex.abs_nonneg h) (complex.abs_nonneg h))
      have hm := mul_le_mul_of_nonneg_left.real (∑ k < N, (7 / 8) ^ k) (1 / (1 - 7 / 8)) (512 * M / (r * r) * (complex.abs h * complex.abs h)) hg hnn
      have hre : (512 * M / (r * r) * (complex.abs h * complex.abs h)) * (1 / (1 - 7 / 8)) = Mq * (complex.abs h * complex.abs h)
        rw [hMq, div_def.real (512 * M) (r * r), div_def.real (4096 * M) (r * r)]; ring
      linarith [hsc N]
  constructor
  · intro z hz
    obtain ⟨V, _, hd⟩ := hderiv_at z hz
    rw [has_cderiv_at.cderiv_at_eq f z V hd]; exact hd
  · unfold is_cpower_series_at
    constructor; linarith
    constructor
    · use M / r; constructor; exact div_nonneg.real M r hM (by linarith); exact hMaj'
    · intro z hz
      obtain ⟨V, hV, hd⟩ := hderiv_at z hz
      rw [has_cderiv_at.cderiv_at_eq f z V hd]; exact hV

+ is_canalytic_at.cderiv_at (f : ℂ → ℂ) (z0 : ℂ) (hf : is_canalytic_at f z0) :
    has_cderiv_at f z0 (cderiv_at f z0) ∧ is_canalytic_at (cderiv_at f) z0
  unfold is_canalytic_at at hf ⊢
  obtain ⟨a, r, hps⟩ := hf
  have h := is_cpower_series_at.has_cderiv_and_deriv f z0 a r hps
  constructor
  · exact h.1 z0 (by rw [complex.sub_self, complex.abs_zero]; linarith [hps.1])
  · exact ⟨fun k => complex.smul ((k + 1 : ℕ) : ℝ) (a (k + 1)), r / 2, h.2⟩

-- Binomial theorem on reals and complexes (needed for disk re-expansion `reexpand`, 0 axioms!):
+ real_binom_pow (x y : ℝ) (n : ℕ) :
    (x + y) ^ n = ∑ j < n + 1, ((choose n j : ℕ) : ℝ) * x ^ j * y ^ (n - j)
  induction n with m ihm
  · have hs0 : (0 : ℕ) - 0 = 0 := by omega
    rw [pow_zero.real, sum_below_succ, sum_below_zero, hs0, choose_zero_zero, pow_zero.real, pow_zero.real]; simp
  · rw [succ_eq_add_one.nat, pow_succ.real, ihm]
    have hmul : (∑ j < m + 1, ((choose m j : ℕ) : ℝ) * x ^ j * y ^ (m - j)) * (x + y) =
        (∑ j < m + 1, ((choose m j : ℕ) : ℝ) * x ^ (j + 1) * y ^ (m - j)) +
        (∑ j < m + 1, ((choose m j : ℕ) : ℝ) * x ^ j * y ^ (m + 1 - j))
      have hgen : ∀ K : ℕ, K ≤ m + 1 →
          (∑ j < K, ((choose m j : ℕ) : ℝ) * x ^ j * y ^ (m - j)) * (x + y) =
          (∑ j < K, ((choose m j : ℕ) : ℝ) * x ^ (j + 1) * y ^ (m - j)) +
          (∑ j < K, ((choose m j : ℕ) : ℝ) * x ^ j * y ^ (m + 1 - j))
        intro K; induction K with h0 k ihk hk
        · rw [sum_below_zero, sum_below_zero, sum_below_zero]; ring
        · rw [succ_eq_add_one.nat, sum_below_succ, sum_below_succ, sum_below_succ]
          have hsub : m + 1 - k = (m - k) + 1 := by omega
          have hadd : ((∑ j < k, ((choose m j : ℕ) : ℝ) * x ^ j * y ^ (m - j)) + ((choose m k : ℕ) : ℝ) * x ^ k * y ^ (m - k)) * (x + y) =
              (∑ j < k, ((choose m j : ℕ) : ℝ) * x ^ j * y ^ (m - j)) * (x + y) + ((choose m k : ℕ) : ℝ) * x ^ k * y ^ (m - k) * (x + y) := by ring
          rw [hadd, ihk (by omega), hsub, pow_succ.real x k, pow_succ.real y (m - k)]; ring
      exact hgen (m + 1) (by omega)
    rw [hmul]
    -- Reindex RHS sum_{j < m+2} choose (m+1) j * x^j * y^(m+1-j) by peeling j = 0 and j = m+1!
    have hshift_sum : ∀ (K : ℕ) (h : ℕ → ℝ), (∑ j < K + 1, h j) = h 0 + ∑ j < K, h (j + 1)
      intro K h; induction K with k ihk
      · rw [sum_below_succ, sum_below_zero, sum_below_zero]; ring
      · rw [succ_eq_add_one.nat, sum_below_succ (k + 1) h, ihk, sum_below_succ k (fun j => h (j + 1))]; ring
    rw [hshift_sum (m + 1) (fun j => ((choose (m + 1) j : ℕ) : ℝ) * x ^ j * y ^ (m + 1 - j))]
    rw [sum_below_succ m (fun j => ((choose (m + 1) (j + 1) : ℕ) : ℝ) * x ^ (j + 1) * y ^ (m + 1 - (j + 1)))]
    rw [sum_below_succ m (fun j => ((choose m j : ℕ) : ℝ) * x ^ (j + 1) * y ^ (m - j))]
    rw [hshift_sum m (fun j => ((choose m j : ℕ) : ℝ) * x ^ j * y ^ (m + 1 - j))]
    have hmid : (∑ j < m, ((choose (m + 1) (j + 1) : ℕ) : ℝ) * x ^ (j + 1) * y ^ (m + 1 - (j + 1))) =
        (∑ j < m, ((choose m j : ℕ) : ℝ) * x ^ (j + 1) * y ^ (m - j)) +
        (∑ j < m, ((choose m (j + 1) : ℕ) : ℝ) * x ^ (j + 1) * y ^ (m + 1 - (j + 1)))
      have hgen : ∀ K : ℕ, K ≤ m →
          (∑ j < K, ((choose (m + 1) (j + 1) : ℕ) : ℝ) * x ^ (j + 1) * y ^ (m + 1 - (j + 1))) =
          (∑ j < K, ((choose m j : ℕ) : ℝ) * x ^ (j + 1) * y ^ (m - j)) +
          (∑ j < K, ((choose m (j + 1) : ℕ) : ℝ) * x ^ (j + 1) * y ^ (m + 1 - (j + 1)))
        intro K; induction K with h0 k ihk hk
        · rw [sum_below_zero, sum_below_zero, sum_below_zero]; ring
        · rw [succ_eq_add_one.nat, sum_below_succ, sum_below_succ, sum_below_succ, ihk (by omega), choose_succ_succ m k, cast_add.real (choose m k) (choose m (k + 1))]
          have hsub : m + 1 - (k + 1) = m - k := by omega
          rw [hsub]; ring
      exact hgen m (by omega)
    rw [hmid, choose_succ_zero m, choose_zero_right m, choose_self (m + 1), choose_self m]
    have hs1 : m + 1 - 0 = m + 1 := by omega
    have hs2 : m + 1 - (m + 1) = 0 := by omega
    have hs3 : m - m = 0 := by omega
    rw [hs1, hs2, hs3]; ring

+ complex_binom_pow (u v : ℂ) (n : ℕ) :
    cpow_nat (complex.add u v) n = csum (n + 1) (fun j => complex.smul ((choose n j : ℕ) : ℝ) (complex.mul (cpow_nat u j) (cpow_nat v (n - j))))
  induction n with m ihm
  · rw [csum.shift_zero (fun j => complex.smul ((choose 0 j : ℕ) : ℝ) (complex.mul (cpow_nat u j) (cpow_nat v (0 - j)))) 0, csum.zero, complex.add_zero, choose_zero_zero]
    unfold cpow_nat; apply complex.ext <;> simp
  · rw [succ_eq_add_one.nat]
    have hp : cpow_nat (complex.add u v) (m + 1) = complex.mul (cpow_nat (complex.add u v) m) (complex.add u v) := by rfl
    rw [hp, ihm]
    have hmul : complex.mul (csum (m + 1) (fun j => complex.smul ((choose m j : ℕ) : ℝ) (complex.mul (cpow_nat u j) (cpow_nat v (m - j))))) (complex.add u v) = complex.add (csum (m + 1) (fun j => complex.smul ((choose m j : ℕ) : ℝ) (complex.mul (cpow_nat u (j + 1)) (cpow_nat v (m - j))))) (csum (m + 1) (fun j => complex.smul ((choose m j : ℕ) : ℝ) (complex.mul (cpow_nat u j) (cpow_nat v (m + 1 - j)))))
      have hgen : ∀ K : ℕ, K ≤ m + 1 → complex.mul (csum K (fun j => complex.smul ((choose m j : ℕ) : ℝ) (complex.mul (cpow_nat u j) (cpow_nat v (m - j))))) (complex.add u v) = complex.add (csum K (fun j => complex.smul ((choose m j : ℕ) : ℝ) (complex.mul (cpow_nat u (j + 1)) (cpow_nat v (m - j))))) (csum K (fun j => complex.smul ((choose m j : ℕ) : ℝ) (complex.mul (cpow_nat u j) (cpow_nat v (m + 1 - j)))))
        intro K; induction K with h0 k ihk hk
        · rw [csum.zero, csum.zero, csum.zero, complex.zero_mul, complex.add_zero]
        · rw [succ_eq_add_one.nat, csum.succ, csum.succ, csum.succ]
          have hsub : m + 1 - k = (m - k) + 1 := by omega
          have hpu : cpow_nat u (k + 1) = complex.mul (cpow_nat u k) u := by rfl
          have hpv : cpow_nat v ((m - k) + 1) = complex.mul (cpow_nat v (m - k)) v := by rfl
          have hdist : complex.mul (complex.add (csum k (fun j => complex.smul ((choose m j : ℕ) : ℝ) (complex.mul (cpow_nat u j) (cpow_nat v (m - j))))) (complex.smul ((choose m k : ℕ) : ℝ) (complex.mul (cpow_nat u k) (cpow_nat v (m - k))))) (complex.add u v) = complex.add (complex.mul (csum k (fun j => complex.smul ((choose m j : ℕ) : ℝ) (complex.mul (cpow_nat u j) (cpow_nat v (m - j))))) (complex.add u v)) (complex.mul (complex.smul ((choose m k : ℕ) : ℝ) (complex.mul (cpow_nat u k) (cpow_nat v (m - k)))) (complex.add u v))
            apply complex.ext <;> simp <;> ring
          rw [hdist, ihk (by omega), hsub, hpu, hpv]; apply complex.ext <;> simp <;> ring
      exact hgen (m + 1) (by omega)
    rw [hmul]
    rw [csum.shift_zero (fun j => complex.smul ((choose (m + 1) j : ℕ) : ℝ) (complex.mul (cpow_nat u j) (cpow_nat v (m + 1 - j)))) (m + 1)]
    rw [csum.succ m (fun j => complex.smul ((choose (m + 1) (j + 1) : ℕ) : ℝ) (complex.mul (cpow_nat u (j + 1)) (cpow_nat v (m + 1 - (j + 1)))))]
    rw [csum.succ m (fun j => complex.smul ((choose m j : ℕ) : ℝ) (complex.mul (cpow_nat u (j + 1)) (cpow_nat v (m - j))))]
    rw [csum.shift_zero (fun j => complex.smul ((choose m j : ℕ) : ℝ) (complex.mul (cpow_nat u j) (cpow_nat v (m + 1 - j)))) m]
    have hmid : csum m (fun j => complex.smul ((choose (m + 1) (j + 1) : ℕ) : ℝ) (complex.mul (cpow_nat u (j + 1)) (cpow_nat v (m + 1 - (j + 1))))) = complex.add (csum m (fun j => complex.smul ((choose m j : ℕ) : ℝ) (complex.mul (cpow_nat u (j + 1)) (cpow_nat v (m - j))))) (csum m (fun j => complex.smul ((choose m (j + 1) : ℕ) : ℝ) (complex.mul (cpow_nat u (j + 1)) (cpow_nat v (m + 1 - (j + 1))))))
      have hgen : ∀ K : ℕ, K ≤ m → csum K (fun j => complex.smul ((choose (m + 1) (j + 1) : ℕ) : ℝ) (complex.mul (cpow_nat u (j + 1)) (cpow_nat v (m + 1 - (j + 1))))) = complex.add (csum K (fun j => complex.smul ((choose m j : ℕ) : ℝ) (complex.mul (cpow_nat u (j + 1)) (cpow_nat v (m - j))))) (csum K (fun j => complex.smul ((choose m (j + 1) : ℕ) : ℝ) (complex.mul (cpow_nat u (j + 1)) (cpow_nat v (m + 1 - (j + 1))))))
        intro K; induction K with h0 k ihk hk
        · rw [csum.zero, csum.zero, csum.zero, complex.add_zero]
        · rw [succ_eq_add_one.nat, csum.succ, csum.succ, csum.succ, ihk (by omega), choose_succ_succ m k, cast_add.real (choose m k) (choose m (k + 1))]
          have hsub : m + 1 - (k + 1) = m - k := by omega
          rw [hsub]; apply complex.ext <;> simp <;> ring
      exact hgen m (by omega)
    rw [hmid, choose_succ_zero m, choose_zero_right m, choose_self (m + 1), choose_self m]
    have hs1 : m + 1 - 0 = m + 1 := by omega
    have hs2 : m + 1 - (m + 1) = 0 := by omega
    have hs3 : m - m = 0 := by omega
    rw [hs1, hs2, hs3]; apply complex.ext <;> simp <;> ring

-- Disk re-expansion of a power series to any interior center z1 (|z1 - z0| < r) on radius rho1 < r - |z1 - z0|!
-- (Key ingredient for Pringsheim-Landau analytic continuation along the real line — 0 axioms!)
+ is_cpower_series_at.reexpand (f : ℂ → ℂ) (z0 z1 : ℂ) (a : ℕ → ℂ) (r rho1 : ℝ)
    (hps : is_cpower_series_at f z0 a r) (hrho1 : 0 < rho1)
    (hdist : complex.abs (complex.sub z1 z0) + rho1 < r) :
    ∃ b : ℕ → ℂ, is_cpower_series_at f z1 b rho1
  obtain ⟨M, hM, hMaj⟩ := hps.2.1
  have hr := hps.1
  set w0 := complex.sub z1 z0 with hw0
  set s := complex.abs w0 + rho1 with hs
  have hs_pos : 0 < s := by rw [hs]; linarith [complex.abs_nonneg w0]
  set q := s / r with hq
  have hq0 : 0 ≤ q := by rw [hq]; exact div_nonneg.real s r (by linarith) (by linarith)
  have hq1 : q < 1 := by rw [hq]; exact (div_lt_iff.real s 1 r hr).mpr (by linarith)
  -- Key binomial bound: for every j, m, choose (j + m) j * rho1^j * |w0|^m <= s^(j + m)!
  have hbin_term : ∀ (j m : ℕ) (x y : ℝ), 0 ≤ x → 0 ≤ y → ((choose (j + m) j : ℕ) : ℝ) * x ^ j * y ^ m ≤ (x + y) ^ (j + m)
    intro j m x y hx hy
    rw [real_binom_pow x y (j + m)]
    have hnn : ∀ k : ℕ, 0 ≤ ((choose (j + m) k : ℕ) : ℝ) * x ^ k * y ^ (j + m - k) := by intro k; exact mul_nonneg.real (((choose (j + m) k : ℕ) : ℝ) * x ^ k) (y ^ (j + m - k)) (mul_nonneg.real ((choose (j + m) k : ℕ) : ℝ) (x ^ k) (cast_nonneg.real (choose (j + m) k)) (pow_nonneg.real x hx k)) (pow_nonneg.real y hy (j + m - k))
    have hmem : ∀ (K k0 : ℕ) (h : ℕ → ℝ), (∀ k, 0 ≤ h k) → k0 < K → h k0 ≤ ∑ k < K, h k
      intro K k0 h hh; induction K with h0 l ihl hk0
      · omega
      · rw [succ_eq_add_one.nat, sum_below_succ]
        by_cases heq : k0 = l
        · rw [heq]
          have hsnn : ∀ P : ℕ, 0 ≤ ∑ k < P, h k
            intro P; induction P with p ihp
            · rw [sum_below_zero]; linarith
            · rw [succ_eq_add_one.nat, sum_below_succ]; linarith [hh p]
          linarith [hsnn l]
        · linarith [ihl (by omega), hh l]
    have h1 := hmem (j + m + 1) j (fun k => ((choose (j + m) k : ℕ) : ℝ) * x ^ k * y ^ (j + m - k)) hnn (by omega)
    have hsub : j + m - j = m := by omega
    have h1_eq : ((choose (j + m) j : ℕ) : ℝ) * x ^ j * y ^ m = ((choose (j + m) j : ℕ) : ℝ) * x ^ j * y ^ (j + m - j) := by rw [hsub]
    rw [h1_eq]; exact h1
  set b_term := (fun (j m : ℕ) => complex.mul (complex.smul ((choose (j + m) j : ℕ) : ℝ) (a (j + m))) (cpow_nat w0 m)) with hbterm
  have hbt_bd : ∀ j m : ℕ, complex.abs (b_term j m) * rho1 ^ j ≤ M * q ^ (j + m)
    intro j m; rw [hbterm, complex.abs_mul, complex.abs_smul, abs_of_nonneg.real ((choose (j + m) j : ℕ) : ℝ) (cast_nonneg.real (choose (j + m) j)), cpow_nat.abs_eq]
    have h1 := hbin_term j m rho1 (complex.abs w0) (by linarith) (complex.abs_nonneg w0)
    have hs_eq : rho1 + complex.abs w0 = s := by rw [hs]; ring
    rw [hs_eq] at h1
    have hre1 : ((choose (j + m) j : ℕ) : ℝ) * complex.abs (a (j + m)) * complex.abs w0 ^ m * rho1 ^ j = complex.abs (a (j + m)) * (((choose (j + m) j : ℕ) : ℝ) * rho1 ^ j * complex.abs w0 ^ m) := by ring
    rw [hre1]
    have hm1 := mul_le_mul_of_nonneg_left.real (((choose (j + m) j : ℕ) : ℝ) * rho1 ^ j * complex.abs w0 ^ m) (s ^ (j + m)) (complex.abs (a (j + m))) h1 (complex.abs_nonneg (a (j + m)))
    rw [hq, pow_div_pow_eq s r hr (j + m)]
    have hrjm := rpow_nat_pos r hr (j + m)
    have hc := mul_inv_cancel.real (r ^ (j + m)) (by linarith)
    have hm2 := mul_le_mul_of_nonneg_right.real (complex.abs (a (j + m)) * r ^ (j + m)) M (s ^ (j + m) / r ^ (j + m)) (hMaj (j + m)) (div_nonneg.real (s ^ (j + m)) (r ^ (j + m)) (pow_nonneg.real s (by linarith) (j + m)) (by linarith))
    have hre2 : complex.abs (a (j + m)) * r ^ (j + m) * (s ^ (j + m) / r ^ (j + m)) = complex.abs (a (j + m)) * s ^ (j + m)
      rw [div_def.real (s ^ (j + m)) (r ^ (j + m))]; linear_combination (complex.abs (a (j + m)) * s ^ (j + m)) * hc
    linarith
  have hpow_add : ∀ (x : ℝ) (j k : ℕ), x ^ (j + k) = x ^ j * x ^ k
    intro x j k; induction k with l ihl
    · have h0 : j + 0 = j := by omega
      rw [h0, pow_zero.real]; ring
    · rw [succ_eq_add_one.nat]
      have h1a : j + (l + 1) = (j + l) + 1 := by omega
      rw [h1a, pow_succ.real, pow_succ.real, ihl]; ring
  set b := (fun (j : ℕ) => clim (fun N => csum N (b_term j))) with hb
  have hb_lim : ∀ j : ℕ, ctends_to (fun N => csum N (b_term j)) (b j) ∧ complex.abs (b j) * rho1 ^ j ≤ M / (1 - q)
    intro j
    have hrhoj_pos := rpow_nat_pos rho1 hrho1 j
    have hcs : csummable (b_term j)
      apply csummable.of_abs_summable
      apply summable.of_nonneg_le (fun m => complex.abs (b_term j m)) (fun m => (M / rho1 ^ j) * q ^ m)
      · intro m; exact complex.abs_nonneg (b_term j m)
      · intro m
        have h1 := hbt_bd j m
        rw [hpow_add q j m] at h1
        have hqj_le1 : q ^ j ≤ 1
          have hgen : ∀ l : ℕ, q ^ l ≤ 1
            intro l; induction l with p ihp
            · rw [pow_zero.real]; linarith
            · rw [succ_eq_add_one.nat, pow_succ.real]; nlinarith [pow_nonneg.real q hq0 p]
          exact hgen j
        have hmq : M * (q ^ j * q ^ m) ≤ M * q ^ m
          have hm1 := mul_le_mul_of_nonneg_right.real (q ^ j) 1 (q ^ m) hqj_le1 (pow_nonneg.real q hq0 m)
          have hm2 := mul_le_mul_of_nonneg_left.real (q ^ j * q ^ m) (q ^ m) M (by linarith) hM
          linarith
        have hdiv := (le_div_iff.real (complex.abs (b_term j m)) (M * q ^ m) (rho1 ^ j) hrhoj_pos).mpr (by linarith)
        rw [div_def.real (M * q ^ m) (rho1 ^ j)] at hdiv
        rw [div_def.real M (rho1 ^ j)]; linarith
      · exact geom_summable (M / rho1 ^ j) q (div_nonneg.real M (rho1 ^ j) hM (by linarith)) hq0 hq1
    unfold csummable cconverges at hcs; obtain ⟨L, hL⟩ := hcs
    have hbj : b j = L := by rw [hb]; exact clim.eq_of_tends_to (fun N => csum N (b_term j)) L hL
    rw [hbj]
    constructor; exact hL
    have hfin : ∀ N : ℕ, complex.abs (csum N (b_term j)) * rho1 ^ j ≤ M / (1 - q)
      intro N
      have h1 := csum.abs_le_sum N (b_term j)
      have hm1 := mul_le_mul_of_nonneg_right.real (complex.abs (csum N (b_term j))) (∑ m < N, complex.abs (b_term j m)) (rho1 ^ j) h1 (by linarith)
      have hsc : ∀ P : ℕ, (∑ m < P, complex.abs (b_term j m)) * rho1 ^ j = ∑ m < P, complex.abs (b_term j m) * rho1 ^ j
        intro P; induction P with p ihp
        · rw [sum_below_zero, sum_below_zero]; ring
        · rw [succ_eq_add_one.nat, sum_below_succ, sum_below_succ, ← ihp]; ring
      have hle2_pt : ∀ m : ℕ, m < N → complex.abs (b_term j m) * rho1 ^ j ≤ M * q ^ m
        intro m _
        have hbt := hbt_bd j m; rw [hpow_add q j m] at hbt
        have hqj_le1 : q ^ j ≤ 1
          have hgen : ∀ l : ℕ, q ^ l ≤ 1
            intro l; induction l with p ihp
            · rw [pow_zero.real]; linarith
            · rw [succ_eq_add_one.nat, pow_succ.real]; nlinarith [pow_nonneg.real q hq0 p]
          exact hgen j
        have hm2 := mul_le_mul_of_nonneg_right.real (q ^ j) 1 (q ^ m) hqj_le1 (pow_nonneg.real q hq0 m)
        have hm3 := mul_le_mul_of_nonneg_left.real (q ^ j * q ^ m) (q ^ m) M (by linarith) hM
        linarith
      have hle2 := sum_le.real (fun m => complex.abs (b_term j m) * rho1 ^ j) (fun m => M * q ^ m) N hle2_pt
      have hsc2 : ∀ P : ℕ, (∑ m < P, M * q ^ m) = M * (∑ m < P, q ^ m)
        intro P; induction P with p ihp
        · rw [sum_below_zero, sum_below_zero]; ring
        · rw [succ_eq_add_one.nat, sum_below_succ, sum_below_succ, ihp]; ring
      have hg := geom_sum_le_inv q hq0 hq1 N
      have hm3 := mul_le_mul_of_nonneg_left.real (∑ m < N, q ^ m) (1 / (1 - q)) M hg hM
      rw [div_def.real M (1 - q)]; linarith [hsc N, hsc2 N]
    have habs_lim := ctends_to.abs (fun N => csum N (b_term j)) L hL
    have hneg_lim : tends_to (fun N => -(complex.abs (csum N (b_term j)) * rho1 ^ j)) (-(complex.abs L * rho1 ^ j))
      unfold tends_to at habs_lim ⊢; intro e he
      obtain ⟨N0, hN0⟩ := habs_lim (e / rho1 ^ j) (div_pos.real e (rho1 ^ j) he hrhoj_pos)
      use N0; intro N hN
      have h1 := hN0 N hN
      have hre : -(complex.abs (csum N (b_term j)) * rho1 ^ j) - -(complex.abs L * rho1 ^ j) = -((complex.abs (csum N (b_term j)) - complex.abs L) * rho1 ^ j) := by ring
      rw [hre, abs_neg_eq, abs_mul.real, abs_of_pos.real (rho1 ^ j) hrhoj_pos]
      have hm := (lt_div_iff.real (|complex.abs (csum N (b_term j)) - complex.abs L|) e (rho1 ^ j) hrhoj_pos).mp h1
      linarith
    have hge := tends_to.ge_of_ge (fun N => -(complex.abs (csum N (b_term j)) * rho1 ^ j)) (-(complex.abs L * rho1 ^ j)) (-(M / (1 - q))) hneg_lim (by intro N; linarith [hfin N])
    linarith
  use b; unfold is_cpower_series_at
  constructor; exact hrho1
  constructor
  · use M / (1 - q); constructor; exact div_nonneg.real M (1 - q) hM (by linarith); intro j; exact (hb_lim j).2
  · intro z hz
    set w := complex.sub z z1 with hw
    have hzw0 : complex.sub z z0 = complex.add w w0
      rw [hw, hw0]; apply complex.ext <;> simp <;> ring
    have hzr : complex.abs (complex.sub z z0) < r
      rw [hzw0]; have ht := complex.abs_add_le w w0; linarith
    -- For every N, csum N (fun n => a n * (w + w0)^n) = csum N (fun j => (csum (N - j) (b_term j)) * w^j)!
    have hswap_tri : ∀ N : ℕ, csum N (fun n => complex.mul (a n) (cpow_nat (complex.add w w0) n)) =
        csum N (fun j => complex.mul (csum (N - j) (b_term j)) (cpow_nat w j))
      intro N; induction N with m ihm
      · rw [csum.zero, csum.zero]
      · rw [succ_eq_add_one.nat, csum.succ, ihm, complex_binom_pow w w0 m, csum.succ]
        have h1 : complex.add (csum m (fun j => complex.mul (csum (m - j) (b_term j)) (cpow_nat w j))) (complex.mul (a m) (csum (m + 1) (fun j => complex.smul ((choose m j : ℕ) : ℝ) (complex.mul (cpow_nat w j) (cpow_nat w0 (m - j)))))) = complex.add (csum m (fun j => complex.mul (csum (m + 1 - j) (b_term j)) (cpow_nat w j))) (complex.mul (csum (m + 1 - m) (b_term m)) (cpow_nat w m))
          have hpull' : ∀ K : ℕ, K ≤ m + 1 → complex.mul (a m) (csum K (fun j => complex.smul ((choose m j : ℕ) : ℝ) (complex.mul (cpow_nat w j) (cpow_nat w0 (m - j))))) = csum K (fun j => complex.mul (b_term j (m - j)) (cpow_nat w j))
            intro K; induction K with h0 k ihk hk
            · rw [csum.zero, csum.zero, complex.mul_zero]
            · rw [succ_eq_add_one.nat, csum.succ, csum.succ]
              have hdist : complex.mul (a m) (complex.add (csum k (fun j => complex.smul ((choose m j : ℕ) : ℝ) (complex.mul (cpow_nat w j) (cpow_nat w0 (m - j))))) (complex.smul ((choose m k : ℕ) : ℝ) (complex.mul (cpow_nat w k) (cpow_nat w0 (m - k))))) = complex.add (complex.mul (a m) (csum k (fun j => complex.smul ((choose m j : ℕ) : ℝ) (complex.mul (cpow_nat w j) (cpow_nat w0 (m - j)))))) (complex.mul (a m) (complex.smul ((choose m k : ℕ) : ℝ) (complex.mul (cpow_nat w k) (cpow_nat w0 (m - k)))))
                apply complex.ext <;> simp <;> ring
              rw [hdist, ihk (by omega), hbterm]
              have hadd : k + (m - k) = m := by omega
              rw [hadd]; apply complex.ext <;> simp <;> ring
          rw [hpull' (m + 1) (by omega), csum.succ]
          have hadd_m : complex.add (csum m (fun j => complex.mul (csum (m - j) (b_term j)) (cpow_nat w j))) (csum m (fun j => complex.mul (b_term j (m - j)) (cpow_nat w j))) = csum m (fun j => complex.mul (csum (m + 1 - j) (b_term j)) (cpow_nat w j))
            have hgen : ∀ K : ℕ, K ≤ m → complex.add (csum K (fun j => complex.mul (csum (m - j) (b_term j)) (cpow_nat w j))) (csum K (fun j => complex.mul (b_term j (m - j)) (cpow_nat w j))) = csum K (fun j => complex.mul (csum (m + 1 - j) (b_term j)) (cpow_nat w j))
              intro K; induction K with h0 k ihk hk
              · rw [csum.zero, csum.zero, csum.zero, complex.add_zero]
              · rw [succ_eq_add_one.nat, csum.succ, csum.succ, csum.succ]
                have hsub : m + 1 - k = (m - k) + 1 := by omega
                have hre : complex.add (complex.add (csum k (fun j => complex.mul (csum (m - j) (b_term j)) (cpow_nat w j))) (complex.mul (csum (m - k) (b_term k)) (cpow_nat w k))) (complex.add (csum k (fun j => complex.mul (b_term j (m - j)) (cpow_nat w j))) (complex.mul (b_term k (m - k)) (cpow_nat w k))) = complex.add (complex.add (csum k (fun j => complex.mul (csum (m - j) (b_term j)) (cpow_nat w j))) (csum k (fun j => complex.mul (b_term j (m - j)) (cpow_nat w j)))) (complex.mul (complex.add (csum (m - k) (b_term k)) (b_term k (m - k))) (cpow_nat w k))
                  apply complex.ext <;> simp <;> ring
                rw [hre, ihk (by omega), hsub, csum.succ]
            exact hgen m (by omega)
          have hlast : csum (m + 1 - m) (b_term m) = b_term m (m - m)
            have hs1 : m + 1 - m = 0 + 1 := by omega
            have hs0 : m - m = 0 := by omega
            rw [hs1, hs0, csum.succ 0, csum.zero, complex.zero_add]
          rw [hlast]
          have hassoc : complex.add (csum m (fun j => complex.mul (csum (m - j) (b_term j)) (cpow_nat w j))) (complex.add (csum m (fun j => complex.mul (b_term j (m - j)) (cpow_nat w j))) (complex.mul (b_term m (m - m)) (cpow_nat w m))) = complex.add (complex.add (csum m (fun j => complex.mul (csum (m - j) (b_term j)) (cpow_nat w j))) (csum m (fun j => complex.mul (b_term j (m - j)) (cpow_nat w j)))) (complex.mul (b_term m (m - m)) (cpow_nat w m))
            apply complex.ext <;> simp <;> ring
          rw [hassoc, hadd_m]
        exact h1
    -- Bound tail |b j - csum (N - j) (b_term j)| * |w|^j <= M * q^N / (1 - q) * (|w|/rho1)^j!
    set t := complex.abs w / rho1 with ht
    have ht0 : 0 ≤ t := by rw [ht]; exact div_nonneg.real (complex.abs w) rho1 (complex.abs_nonneg w) (by linarith)
    have ht1 : t < 1 := by rw [ht]; exact (div_lt_iff.real (complex.abs w) 1 rho1 hrho1).mpr (by linarith)
    have htail_j : ∀ (N j : ℕ), j < N → complex.abs (complex.mul (complex.sub (b j) (csum (N - j) (b_term j))) (cpow_nat w j)) ≤ (M * q ^ N / (1 - q)) * t ^ j
      intro N j hj
      rw [complex.abs_mul, cpow_nat.abs_eq]
      have hrhoj := rpow_nat_pos rho1 hrho1 j
      have htail_b : complex.abs (complex.sub (b j) (csum (N - j) (b_term j))) * rho1 ^ j ≤ M * q ^ N / (1 - q)
        have hfin_d : ∀ d : ℕ, complex.abs (complex.sub (csum ((N - j) + d) (b_term j)) (csum (N - j) (b_term j))) * rho1 ^ j ≤ M * q ^ N / (1 - q)
          intro d
          rw [csum.split_add (N - j) d (b_term j)]
          have hsub : complex.sub (complex.add (csum (N - j) (b_term j)) (csum d (fun l => b_term j ((N - j) + l)))) (csum (N - j) (b_term j)) = csum d (fun l => b_term j ((N - j) + l))
            apply complex.ext <;> simp <;> ring
          rw [hsub]
          have h1 := csum.abs_le_sum d (fun l => b_term j ((N - j) + l))
          have hm1 := mul_le_mul_of_nonneg_right.real (complex.abs (csum d (fun l => b_term j ((N - j) + l)))) (∑ l < d, complex.abs (b_term j ((N - j) + l))) (rho1 ^ j) h1 (by linarith)
          have hsc : ∀ P : ℕ, (∑ l < P, complex.abs (b_term j ((N - j) + l))) * rho1 ^ j = ∑ l < P, complex.abs (b_term j ((N - j) + l)) * rho1 ^ j
            intro P; induction P with p ihp
            · rw [sum_below_zero, sum_below_zero]; ring
            · rw [succ_eq_add_one.nat, sum_below_succ, sum_below_succ, ← ihp]; ring
          have hle2_pt : ∀ l : ℕ, l < d → complex.abs (b_term j ((N - j) + l)) * rho1 ^ j ≤ (M * q ^ N) * q ^ l
            intro l _
            have hbt := hbt_bd j ((N - j) + l)
            have hidx : j + ((N - j) + l) = N + l := by omega
            rw [hidx, hpow_add q N l] at hbt; linarith
          have hle2 := sum_le.real (fun l => complex.abs (b_term j ((N - j) + l)) * rho1 ^ j) (fun l => (M * q ^ N) * q ^ l) d hle2_pt
          have hsc2 : ∀ P : ℕ, (∑ l < P, (M * q ^ N) * q ^ l) = (M * q ^ N) * (∑ l < P, q ^ l)
            intro P; induction P with p ihp
            · rw [sum_below_zero, sum_below_zero]; ring
            · rw [succ_eq_add_one.nat, sum_below_succ, sum_below_succ, ihp]; ring
          have hg := geom_sum_le_inv q hq0 hq1 d
          have hm3 := mul_le_mul_of_nonneg_left.real (∑ l < d, q ^ l) (1 / (1 - q)) (M * q ^ N) hg (mul_nonneg.real M (q ^ N) hM (pow_nonneg.real q hq0 N))
          rw [div_def.real (M * q ^ N) (1 - q)]; linarith [hsc d, hsc2 d]
        have hlim_j := (hb_lim j).1
        have hsh : ctends_to (fun d => complex.sub (csum ((N - j) + d) (b_term j)) (csum (N - j) (b_term j))) (complex.sub (b j) (csum (N - j) (b_term j)))
          unfold ctends_to at hlim_j ⊢; intro e he; obtain ⟨N0, hN0⟩ := hlim_j e he; use N0; intro d hd
          have hre : complex.sub (complex.sub (csum ((N - j) + d) (b_term j)) (csum (N - j) (b_term j))) (complex.sub (b j) (csum (N - j) (b_term j))) = complex.sub (csum ((N - j) + d) (b_term j)) (b j)
            apply complex.ext <;> simp <;> ring
          rw [hre]; exact hN0 ((N - j) + d) (by omega)
        have habs_l := ctends_to.abs (fun d => complex.sub (csum ((N - j) + d) (b_term j)) (csum (N - j) (b_term j))) (complex.sub (b j) (csum (N - j) (b_term j))) hsh
        have hneg_l : tends_to (fun d => -(complex.abs (complex.sub (csum ((N - j) + d) (b_term j)) (csum (N - j) (b_term j))) * rho1 ^ j)) (-(complex.abs (complex.sub (b j) (csum (N - j) (b_term j))) * rho1 ^ j))
          unfold tends_to at habs_l ⊢; intro e he
          obtain ⟨N0, hN0⟩ := habs_l (e / rho1 ^ j) (div_pos.real e (rho1 ^ j) he hrhoj)
          use N0; intro d hd
          have h1 := hN0 d hd
          have hre : -(complex.abs (complex.sub (csum ((N - j) + d) (b_term j)) (csum (N - j) (b_term j))) * rho1 ^ j) - -(complex.abs (complex.sub (b j) (csum (N - j) (b_term j))) * rho1 ^ j) = -((complex.abs (complex.sub (csum ((N - j) + d) (b_term j)) (csum (N - j) (b_term j))) - complex.abs (complex.sub (b j) (csum (N - j) (b_term j)))) * rho1 ^ j) := by ring
          rw [hre, abs_neg_eq, abs_mul.real, abs_of_pos.real (rho1 ^ j) hrhoj]
          have hm := (lt_div_iff.real (|complex.abs (complex.sub (csum ((N - j) + d) (b_term j)) (csum (N - j) (b_term j))) - complex.abs (complex.sub (b j) (csum (N - j) (b_term j)))|) e (rho1 ^ j) hrhoj).mp h1
          linarith
        have hge := tends_to.ge_of_ge (fun d => -(complex.abs (complex.sub (csum ((N - j) + d) (b_term j)) (csum (N - j) (b_term j))) * rho1 ^ j)) (-(complex.abs (complex.sub (b j) (csum (N - j) (b_term j))) * rho1 ^ j)) (-(M * q ^ N / (1 - q))) hneg_l (by intro d; linarith [hfin_d d])
        linarith
      rw [ht, pow_div_pow_eq (complex.abs w) rho1 hrho1 j]
      have hc := mul_inv_cancel.real (rho1 ^ j) (by linarith)
      have hm := mul_le_mul_of_nonneg_right.real (complex.abs (complex.sub (b j) (csum (N - j) (b_term j))) * rho1 ^ j) (M * q ^ N / (1 - q)) (complex.abs w ^ j / rho1 ^ j) htail_b (div_nonneg.real (complex.abs w ^ j) (rho1 ^ j) (pow_nonneg.real (complex.abs w) (complex.abs_nonneg w) j) (by linarith))
      have hre : complex.abs (complex.sub (b j) (csum (N - j) (b_term j))) * rho1 ^ j * (complex.abs w ^ j / rho1 ^ j) = complex.abs (complex.sub (b j) (csum (N - j) (b_term j))) * complex.abs w ^ j
        rw [div_def.real (complex.abs w ^ j) (rho1 ^ j)]; linear_combination (complex.abs (complex.sub (b j) (csum (N - j) (b_term j))) * complex.abs w ^ j) * hc
      linarith
    have hdiff_N : ∀ N : ℕ, complex.abs (complex.sub (csum N (fun j => complex.mul (b j) (cpow_nat w j))) (csum N (fun n => complex.mul (a n) (cpow_nat (complex.add w w0) n)))) ≤ (M / ((1 - q) * (1 - t))) * q ^ N
      intro N; rw [hswap_tri N]
      have hsub_cs : ∀ (P : ℕ) (u v : ℕ → ℂ), complex.sub (csum P u) (csum P v) = csum P (fun j => complex.sub (u j) (v j))
        intro P u v; induction P with p ihp
        · rw [csum.zero, csum.zero, csum.zero]; apply complex.ext <;> simp
        · rw [succ_eq_add_one.nat, csum.succ, csum.succ, csum.succ, ← ihp]; apply complex.ext <;> simp <;> ring
      rw [hsub_cs N]
      have hcon : csum N (fun j => complex.sub (complex.mul (b j) (cpow_nat w j)) (complex.mul (csum (N - j) (b_term j)) (cpow_nat w j))) = csum N (fun j => complex.mul (complex.sub (b j) (csum (N - j) (b_term j))) (cpow_nat w j))
        apply csum.congr; intro j _; apply complex.ext <;> simp <;> ring
      rw [hcon]
      have h1 := csum.abs_le_sum N (fun j => complex.mul (complex.sub (b j) (csum (N - j) (b_term j))) (cpow_nat w j))
      have h2 := sum_le.real (fun j => complex.abs (complex.mul (complex.sub (b j) (csum (N - j) (b_term j))) (cpow_nat w j))) (fun j => (M * q ^ N / (1 - q)) * t ^ j) N htail_j
      have hsc : ∀ P : ℕ, (∑ j < P, (M * q ^ N / (1 - q)) * t ^ j) = (M * q ^ N / (1 - q)) * (∑ j < P, t ^ j)
        intro P; induction P with p ihp
        · rw [sum_below_zero, sum_below_zero]; ring
        · rw [succ_eq_add_one.nat, sum_below_succ, sum_below_succ, ihp]; ring
      have hg := geom_sum_le_inv t ht0 ht1 N
      have hcoeff_nn : 0 ≤ M * q ^ N / (1 - q) := div_nonneg.real (M * q ^ N) (1 - q) (mul_nonneg.real M (q ^ N) hM (pow_nonneg.real q hq0 N)) (by linarith)
      have hm := mul_le_mul_of_nonneg_left.real (∑ j < N, t ^ j) (1 / (1 - t)) (M * q ^ N / (1 - q)) hg hcoeff_nn
      have hc1 := mul_inv_cancel.real (1 - q) (by linarith)
      have hc2 := mul_inv_cancel.real (1 - t) (by linarith)
      have hc3 := mul_inv_cancel.real ((1 - q) * (1 - t)) (by nlinarith)
      have hinv : (1 / (1 - q)) * (1 / (1 - t)) = 1 / ((1 - q) * (1 - t))
        have h0 : ((1 - q) * (1 - t)) * ((1 / (1 - q)) * (1 / (1 - t)) - 1 / ((1 - q) * (1 - t))) = 0
          have ha1 : ((1 - q) * (1 - t)) * ((1 / (1 - q)) * (1 / (1 - t))) = ((1 - q) * (1 / (1 - q))) * ((1 - t) * (1 / (1 - t))) := by ring
          rw [mul_sub.real, ha1, hc1, hc2, hc3]; ring
        linear_combination (1 / ((1 - q) * (1 - t))) * h0 - ((1 / (1 - q)) * (1 / (1 - t)) - 1 / ((1 - q) * (1 - t))) * hc3
      have hre : (M * q ^ N / (1 - q)) * (1 / (1 - t)) = (M / ((1 - q) * (1 - t))) * q ^ N
        rw [div_def.real (M * q ^ N) (1 - q), div_def.real M ((1 - q) * (1 - t))]
        have h2a : M * q ^ N * (1 / (1 - q)) * (1 / (1 - t)) = M * ((1 / (1 - q)) * (1 / (1 - t))) * q ^ N := by ring
        rw [h2a, hinv]
      linarith [hsc N]
    have hflim := hps.2.2 z hzr
    rw [hzw0] at hflim
    have hqlim := geom_pow_tends_to_zero q hq0 hq1
    set B0 := M / ((1 - q) * (1 - t)) + 1 with hB0
    have hB0_pos : 0 < B0 := by rw [hB0]; linarith [div_nonneg.real M ((1 - q) * (1 - t)) hM (by nlinarith)]
    unfold ctends_to at hflim ⊢; unfold tends_to at hqlim
    intro e he
    obtain ⟨N1, hN1⟩ := hflim (e / 2) (by linarith)
    obtain ⟨N2, hN2⟩ := hqlim (e / (2 * B0)) (div_pos.real e (2 * B0) he (by linarith))
    use N1 + N2; intro N hN
    have h1 := hN1 N (by omega)
    have h2 := hN2 N (by omega)
    have hsub0 : q ^ N - 0 = q ^ N := by ring
    rw [hsub0, abs_of_nonneg.real (q ^ N) (pow_nonneg.real q hq0 N)] at h2
    have h2b : B0 * q ^ N < e / 2 := by linarith [(lt_div_iff.real (q ^ N) e (2 * B0) (by linarith)).mp h2]
    have hd := hdiff_N N
    have hd_lt : complex.abs (complex.sub (csum N (fun j => complex.mul (b j) (cpow_nat w j))) (csum N (fun n => complex.mul (a n) (cpow_nat (complex.add w w0) n)))) < e / 2
      have hle : M / ((1 - q) * (1 - t)) ≤ B0 := by rw [hB0]; linarith
      have hm := mul_le_mul_of_nonneg_right.real (M / ((1 - q) * (1 - t))) B0 (q ^ N) hle (pow_nonneg.real q hq0 N)
      linarith
    have htri := complex.abs_sub_triangle (csum N (fun j => complex.mul (b j) (cpow_nat w j))) (csum N (fun n => complex.mul (a n) (cpow_nat (complex.add w w0) n))) (f z)
    linarith

-- Coefficient uniqueness along any nonzero ray z0 + t * dir (t in (0, eps)) (0 axioms!):
+ is_cpower_series_at.coeff_zero_of_ray (f : ℂ → ℂ) (z0 dir : ℂ) (a : ℕ → ℂ) (r eps : ℝ)
    (hps : is_cpower_series_at f z0 a r) (hdir : dir ≠ complex.zero) (heps : 0 < eps)
    (hvan : ∀ t : ℝ, 0 < t → t < eps → f (complex.add z0 (complex.smul t dir)) = complex.zero) :
    ∀ n : ℕ, a n = complex.zero
  obtain ⟨M, hM, hMaj⟩ := hps.2.1
  have hr := hps.1
  have hdir_pos : 0 < complex.abs dir
    by_contra hle
    have hz : complex.abs dir = 0 := by linarith [complex.abs_nonneg dir]
    exact hdir ((complex.abs_eq_zero dir).mp hz)
  -- Strong induction via ∀ N, ∀ k < N, a k = 0:
  have hstrong : ∀ N : ℕ, ∀ k : ℕ, k < N → a k = complex.zero
    intro N; induction N with k hk m ihm k hk
    · omega
    · rw [succ_eq_add_one.nat] at hk
      by_cases hlt : k < m
      · exact ihm k hlt
      · have hkm : k = m := by omega
        rw [hkm]
        by_contra hne
        have ham_pos : 0 < complex.abs (a m)
          by_contra hle
          have hz : complex.abs (a m) = 0 := by linarith [complex.abs_nonneg (a m)]
          exact hne ((complex.abs_eq_zero (a m)).mp hz)
        -- Pick tiny t > 0 so t * |dir| < min(r/2, eps*|dir|) and 2 * M * (t * |dir| / r) / r^m < |a m|!
        have hrm_pos := rpow_nat_pos r hr m
        set B := 2 * M / (r * r ^ m) + 1 with hB
        have hB_pos : 0 < B := by rw [hB]; linarith [div_nonneg.real (2 * M) (r * r ^ m) (by linarith) (by nlinarith)]
        set t := min (min (eps / 2) (r / (2 * complex.abs dir))) (complex.abs (a m) / (2 * B * complex.abs dir)) with ht
        have ht_pos : 0 < t
          rw [ht]
          have h1 := lt_min.real (eps / 2) (r / (2 * complex.abs dir)) 0 (by linarith) (div_pos.real r (2 * complex.abs dir) hr (by linarith))
          have h2 := div_pos.real (complex.abs (a m)) (2 * B * complex.abs dir) ham_pos (by nlinarith)
          exact lt_min.real (min (eps / 2) (r / (2 * complex.abs dir))) (complex.abs (a m) / (2 * B * complex.abs dir)) 0 h1 h2
        have ht_eps : t < eps
          have h1 := min_le_left.real (min (eps / 2) (r / (2 * complex.abs dir))) (complex.abs (a m) / (2 * B * complex.abs dir))
          have h2 := min_le_left.real (eps / 2) (r / (2 * complex.abs dir))
          linarith
        have ht_r2 : t * complex.abs dir ≤ r / 2
          have h1 := min_le_left.real (min (eps / 2) (r / (2 * complex.abs dir))) (complex.abs (a m) / (2 * B * complex.abs dir))
          have h2 := min_le_right.real (eps / 2) (r / (2 * complex.abs dir))
          have h3 : t ≤ r / (2 * complex.abs dir) := by linarith
          have h4 := (le_div_iff.real t r (2 * complex.abs dir) (by linarith)).mp h3
          linarith
        have ht_small : B * (t * complex.abs dir) < complex.abs (a m)
          have h1 := min_le_right.real (min (eps / 2) (r / (2 * complex.abs dir))) (complex.abs (a m) / (2 * B * complex.abs dir))
          have h2 : t ≤ complex.abs (a m) / (2 * B * complex.abs dir) := by linarith
          have h3 := (le_div_iff.real t (complex.abs (a m)) (2 * B * complex.abs dir) (by nlinarith)).mp h2
          linarith
        set z := complex.add z0 (complex.smul t dir) with hz
        have hsub : complex.sub z z0 = complex.smul t dir
          rw [hz]; apply complex.ext <;> simp <;> ring
        have habs_sub : complex.abs (complex.sub z z0) = t * complex.abs dir
          rw [hsub, complex.abs_smul, abs_of_pos.real t ht_pos]
        have hzr : complex.abs (complex.sub z z0) < r := by rw [habs_sub]; linarith
        have hfz : f z = complex.zero := by rw [hz]; exact hvan t ht_pos ht_eps
        have htb := is_cpower_series_at.tail_bound f z0 a r M hr hM hMaj hps.2.2 z hzr (m + 1)
        -- csum (m + 1) = a m * (z - z0)^m since a k = 0 for all k < m!
        have hcs_m : csum (m + 1) (fun j => complex.mul (a j) (cpow_nat (complex.sub z z0) j)) = complex.mul (a m) (cpow_nat (complex.sub z z0) m)
          rw [csum.succ]
          have hz_prev : ∀ P : ℕ, P ≤ m → csum P (fun j => complex.mul (a j) (cpow_nat (complex.sub z z0) j)) = complex.zero
            intro P; induction P with h0 p ihp hp
            · rw [csum.zero]
            · rw [succ_eq_add_one.nat, csum.succ, ihp (by omega), ihm p (by omega), complex.zero_mul, complex.add_zero]
          rw [hz_prev m (by omega), complex.zero_add]
        rw [hfz, hcs_m] at htb
        have hneg_abs : complex.abs (complex.sub complex.zero (complex.mul (a m) (cpow_nat (complex.sub z z0) m))) = complex.abs (a m) * (t * complex.abs dir) ^ m
          have h1 : complex.sub complex.zero (complex.mul (a m) (cpow_nat (complex.sub z z0) m)) = complex.neg (complex.mul (a m) (cpow_nat (complex.sub z z0) m))
            apply complex.ext <;> simp <;> ring
          rw [h1, complex.abs_neg, complex.abs_mul, cpow_nat.abs_eq, habs_sub]
        rw [hneg_abs, habs_sub] at htb
        set u := t * complex.abs dir with hu
        have hu_pos : 0 < u := by rw [hu]; exact mul_pos.real t (complex.abs dir) ht_pos hdir_pos
        have hu_pow_pos := rpow_nat_pos u hu_pos m
        have hq_le : u / r ≤ 1 / 2 := (div_le_iff.real u (1 / 2) r hr).mpr (by linarith)
        have hnum_nn : 0 ≤ M * (u / r) ^ (m + 1) := mul_nonneg.real M ((u / r) ^ (m + 1)) hM (pow_nonneg.real (u / r) (div_nonneg.real u r (by linarith) (by linarith)) (m + 1))
        have hdiv_le : M * (u / r) ^ (m + 1) / (1 - u / r) ≤ 2 * M * (u / r) ^ (m + 1)
          exact (div_le_iff.real (M * (u / r) ^ (m + 1)) (2 * M * (u / r) ^ (m + 1)) (1 - u / r) (by linarith)).mpr (by nlinarith)
        rw [pow_succ.real, pow_div_pow_eq u r hr m] at hdiv_le htb
        have hre : 2 * M * (u ^ m / r ^ m * (u / r)) = (2 * M / (r * r ^ m) * u) * u ^ m
          have hc1 := mul_inv_cancel.real (r ^ m) (by linarith)
          have hc2 := mul_inv_cancel.real r (by linarith)
          have hc3 := mul_inv_cancel.real (r * r ^ m) (by nlinarith)
          have hinv : (1 / r ^ m) * (1 / r) = 1 / (r * r ^ m)
            have h0 : (r * r ^ m) * ((1 / r ^ m) * (1 / r) - 1 / (r * r ^ m)) = 0
              have ha1 : (r * r ^ m) * ((1 / r ^ m) * (1 / r)) = (r * (1 / r)) * (r ^ m * (1 / r ^ m)) := by ring
              rw [mul_sub.real, ha1, hc1, hc2, hc3]; ring
            linear_combination (1 / (r * r ^ m)) * h0 - ((1 / r ^ m) * (1 / r) - 1 / (r * r ^ m)) * hc3
          rw [div_def.real (u ^ m) (r ^ m), div_def.real u r, div_def.real (2 * M) (r * r ^ m)]
          have h2a : 2 * M * (u ^ m * (1 / r ^ m) * (u * (1 / r))) = 2 * M * ((1 / r ^ m) * (1 / r)) * u * u ^ m := by ring
          rw [h2a, hinv]
        rw [hre] at hdiv_le
        have hle_B : 2 * M / (r * r ^ m) * u ≤ B * u
          have hle1 : 2 * M / (r * r ^ m) ≤ B := by rw [hB]; linarith
          exact mul_le_mul_of_nonneg_right.real (2 * M / (r * r ^ m)) B u hle1 (by linarith)
        have hlt_am : (2 * M / (r * r ^ m) * u) * u ^ m < complex.abs (a m) * u ^ m
          exact mul_lt_mul_of_pos_right.real (2 * M / (r * r ^ m) * u) (complex.abs (a m)) (u ^ m) (by linarith) hu_pow_pos
        linarith
  intro n; exact hstrong (n + 1) n (by omega)

+ is_cpower_series_at.coeff_unique (f : ℂ → ℂ) (z0 : ℂ) (a b : ℕ → ℂ) (r1 r2 : ℝ)
    (h1 : is_cpower_series_at f z0 a r1) (h2 : is_cpower_series_at f z0 b r2) :
    ∀ n : ℕ, a n = b n
  set r := min r1 r2 with hr
  have hr_pos : 0 < r := by rw [hr]; exact lt_min.real r1 r2 0 h1.1 h2.1
  have h1s := is_cpower_series_at.shrink f z0 a r1 r h1 hr_pos (by rw [hr]; exact min_le_left.real r1 r2)
  have h2s := is_cpower_series_at.shrink f z0 b r2 r h2 hr_pos (by rw [hr]; exact min_le_right.real r1 r2)
  obtain ⟨M1, hM1, hMaj1⟩ := h1s.2.1
  obtain ⟨M2, hM2, hMaj2⟩ := h2s.2.1
  have hdiff : is_cpower_series_at (fun _ => complex.zero) z0 (fun k => complex.sub (a k) (b k)) r
    unfold is_cpower_series_at
    constructor; exact hr_pos
    constructor
    · use M1 + M2; constructor; linarith; intro k
      have ht := complex.abs_sub_le_sum (a k) (b k)
      have hm := mul_le_mul_of_nonneg_right.real (complex.abs (complex.sub (a k) (b k))) (complex.abs (a k) + complex.abs (b k)) (r ^ k) ht (pow_nonneg.real r (by linarith) k)
      linarith [hMaj1 k, hMaj2 k]
    · intro z hz
      have hl := ctends_to.sub (fun N => csum N (fun k => complex.mul (a k) (cpow_nat (complex.sub z z0) k))) (fun N => csum N (fun k => complex.mul (b k) (cpow_nat (complex.sub z z0) k))) (f z) (f z) (h1s.2.2 z hz) (h2s.2.2 z hz)
      have hfe : (fun N => complex.sub (csum N (fun k => complex.mul (a k) (cpow_nat (complex.sub z z0) k))) (csum N (fun k => complex.mul (b k) (cpow_nat (complex.sub z z0) k)))) = (fun N => csum N (fun k => complex.mul (complex.sub (a k) (b k)) (cpow_nat (complex.sub z z0) k)))
        funext N
        have hgen : ∀ M : ℕ, complex.sub (csum M (fun k => complex.mul (a k) (cpow_nat (complex.sub z z0) k))) (csum M (fun k => complex.mul (b k) (cpow_nat (complex.sub z z0) k))) = csum M (fun k => complex.mul (complex.sub (a k) (b k)) (cpow_nat (complex.sub z z0) k))
          intro M; induction M with m ihm
          · rw [csum.zero, csum.zero, csum.zero]; apply complex.ext <;> simp
          · rw [succ_eq_add_one.nat, csum.succ, csum.succ, csum.succ, ← ihm]; apply complex.ext <;> simp <;> ring
        exact hgen N
      rw [hfe, complex.sub_self] at hl; exact hl
  have hcz := is_cpower_series_at.coeff_zero_of_ray (fun _ => complex.zero) z0 complex.one (fun k => complex.sub (a k) (b k)) r r hdiff complex.one_ne_zero hr_pos (by intro _ _ _; rfl)
  intro n
  have hn := hcz n
  apply complex.ext
  · have hr0 : complex.re (complex.sub (a n) (b n)) = complex.re complex.zero := by rw [hn]
    simp at hr0; linarith
  · have hi0 : complex.im (complex.sub (a n) (b n)) = complex.im complex.zero := by rw [hn]
    simp at hi0; linarith

-- 1D Segment Identity Theorem for analytic functions (via `sup_exists` — 0 axioms!):
+ is_canalytic_on.identity_segment (f g : ℂ → ℂ) (za zb : ℂ) (eps : ℝ) (heps : 0 < eps)
    (hf : ∀ t : ℝ, 0 ≤ t → t ≤ 1 → is_canalytic_at f (complex.add za (complex.smul t (complex.sub zb za))))
    (hg : ∀ t : ℝ, 0 ≤ t → t ≤ 1 → is_canalytic_at g (complex.add za (complex.smul t (complex.sub zb za))))
    (hinit : ∀ z : ℂ, complex.abs (complex.sub z za) < eps → f z = g z) :
    f zb = g zb
  by_cases heq_ab : za = zb
  · rw [← heq_ab]; exact hinit za (by rw [complex.sub_self, complex.abs_zero]; exact heps)
  · set dir := complex.sub zb za with hdir
    have hdir_ne : dir ≠ complex.zero
      intro hz; apply heq_ab
      apply complex.ext
      · have hr0 : complex.re (complex.sub zb za) = complex.re complex.zero := by rw [← hdir, hz]
        simp at hr0; linarith
      · have hi0 : complex.im (complex.sub zb za) = complex.im complex.zero := by rw [← hdir, hz]
        simp at hi0; linarith
    have hdir_pos : 0 < complex.abs dir
      by_contra hle; have hz : complex.abs dir = 0 := by linarith [complex.abs_nonneg dir]
      exact hdir_ne ((complex.abs_eq_zero dir).mp hz)
    set seg := (fun (t : ℝ) => complex.add za (complex.smul t dir)) with hseg
    set h := (fun (z : ℂ) => complex.sub (f z) (g z)) with hh
    have hh_eq : ∀ z : ℂ, h z = complex.sub (f z) (g z) := by intro z; rw [hh]
    set T := (fun (t : ℝ) => (0 : ℝ) ≤ t ∧ t ≤ 1 ∧ ∀ u : ℝ, 0 ≤ u → u ≤ t → h (seg u) = complex.zero) with hT
    have h0_mem : 0 ∈ T
      rw [hT]; constructor; linarith; constructor; linarith
      intro u hu1 hu2
      have hu0 : u = 0 := by linarith
      rw [hu0, hseg]
      have hs0 : complex.add za (complex.smul 0 dir) = za
        apply complex.ext <;> simp <;> ring
      rw [hs0, hh_eq za, hinit za (by rw [complex.sub_self, complex.abs_zero]; exact heps), complex.sub_self]
    have hub : upper_bound T 1 := by unfold upper_bound; intro x hx; rw [hT] at hx; exact hx.2.1
    obtain ⟨ts, hts⟩ := sup_exists T ⟨0, h0_mem⟩ ⟨1, hub⟩
    have hts_ge0 : 0 ≤ ts := is_sup.le_of_mem T ts 0 hts h0_mem
    have hts_le1 : ts ≤ 1 := hts.2 1 hub
    -- Show ts > 0 because h vanishes on |z - za| < eps!
    have hts_pos : 0 < ts
      set t0 := min 1 (eps / (2 * complex.abs dir)) with ht0
      have ht0_pos : 0 < t0 := by rw [ht0]; exact lt_min.real 1 (eps / (2 * complex.abs dir)) 0 (by decide) (div_pos.real eps (2 * complex.abs dir) heps (by linarith))
      have ht0_mem : t0 ∈ T
        rw [hT]; constructor; linarith; constructor; rw [ht0]; exact min_le_left.real 1 (eps / (2 * complex.abs dir))
        intro u hu1 hu2
        have hle : u ≤ eps / (2 * complex.abs dir) := by linarith [min_le_right.real 1 (eps / (2 * complex.abs dir))]
        have hsub : complex.sub (seg u) za = complex.smul u dir
          rw [hseg]; apply complex.ext <;> simp <;> ring
        have habs : complex.abs (complex.sub (seg u) za) < eps
          rw [hsub, complex.abs_smul, abs_of_nonneg.real u hu1]
          have h1 := (le_div_iff.real u eps (2 * complex.abs dir) (by linarith)).mp hle
          linarith
        rw [hh_eq (seg u), hinit (seg u) habs, complex.sub_self]
      have hge := is_sup.le_of_mem T ts t0 hts ht0_mem
      linarith
    -- Show h(seg u) = 0 for all 0 <= u < ts!
    have hvan_lt : ∀ u : ℝ, 0 ≤ u → u < ts → h (seg u) = complex.zero
      intro u hu1 hu2
      obtain ⟨x, hx, hux⟩ := is_sup.exists_gt T ts u hts hu2
      rw [hT] at hx; exact hx.2.2 u hu1 (by linarith)
    -- Expand h at seg ts!
    have hf_ts : is_canalytic_at f (seg ts) := by rw [hseg]; exact hf ts hts_ge0 hts_le1
    have hg_ts : is_canalytic_at g (seg ts) := by rw [hseg]; exact hg ts hts_ge0 hts_le1
    have hh_ana : is_canalytic_at h (seg ts) := by rw [hh]; exact is_canalytic_at.sub f g (seg ts) hf_ts hg_ts
    unfold is_canalytic_at at hh_ana
    obtain ⟨a, r, hps⟩ := hh_ana
    have hray : ∀ s : ℝ, 0 < s → s < ts → h (complex.add (seg ts) (complex.smul s (complex.neg dir))) = complex.zero
      intro s hs1 hs2
      have heq : complex.add (seg ts) (complex.smul s (complex.neg dir)) = seg (ts - s)
        rw [hseg]; apply complex.ext <;> simp <;> ring
      rw [heq]; exact hvan_lt (ts - s) (by linarith) (by linarith)
    have hneg_ne : complex.neg dir ≠ complex.zero
      intro hz; apply hdir_ne
      apply complex.ext
      · have hr0 : complex.re (complex.neg dir) = complex.re complex.zero := by rw [hz]
        simp at hr0 ⊢; linarith
      · have hi0 : complex.im (complex.neg dir) = complex.im complex.zero := by rw [hz]
        simp at hi0 ⊢; linarith
    have ha_zero := is_cpower_series_at.coeff_zero_of_ray h (seg ts) (complex.neg dir) a r ts hps hneg_ne hts_pos hray
    -- Therefore h(z) = 0 for ALL |z - seg ts| < r!
    have hdisk_zero : ∀ z : ℂ, complex.abs (complex.sub z (seg ts)) < r → h z = complex.zero
      intro z hz
      have hl := hps.2.2 z hz
      have h0l : ctends_to (fun N => csum N (fun k => complex.mul (a k) (cpow_nat (complex.sub z (seg ts)) k))) complex.zero
        unfold ctends_to; intro e he; use 0; intro N _
        have hcz : ∀ M : ℕ, csum M (fun k => complex.mul (a k) (cpow_nat (complex.sub z (seg ts)) k)) = complex.zero
          intro M; induction M with m ihm
          · rw [csum.zero]
          · rw [succ_eq_add_one.nat, csum.succ, ihm, ha_zero m, complex.zero_mul, complex.add_zero]
        rw [hcz N, complex.sub_self, complex.abs_zero]; exact he
      exact ctends_to.unique (fun N => csum N (fun k => complex.mul (a k) (cpow_nat (complex.sub z (seg ts)) k))) (h z) complex.zero hl h0l
    -- If ts < 1, extend ts by min((1 - ts)/2, r / (2 * |dir|)) -> contradiction!
    have hts_eq1 : ts = 1
      by_contra hne1
      set step := min ((1 - ts) / 2) (r / (2 * complex.abs dir)) with hstep
      have hstep_pos : 0 < step := by rw [hstep]; exact lt_min.real ((1 - ts) / 2) (r / (2 * complex.abs dir)) 0 (by linarith) (div_pos.real r (2 * complex.abs dir) hps.1 (by linarith))
      have hmem : (ts + step) ∈ T
        rw [hT]; constructor; linarith; constructor; linarith [min_le_left.real ((1 - ts) / 2) (r / (2 * complex.abs dir))]
        intro u hu1 hu2
        by_cases hlt : u < ts
        · exact hvan_lt u hu1 hlt
        · have hdist_u : complex.abs (complex.sub (seg u) (seg ts)) < r
            have hsub : complex.sub (seg u) (seg ts) = complex.smul (u - ts) dir
              rw [hseg]; apply complex.ext <;> simp <;> ring
            rw [hsub, complex.abs_smul, abs_of_nonneg.real (u - ts) (by linarith)]
            have h1 : u - ts ≤ r / (2 * complex.abs dir) := by linarith [min_le_right.real ((1 - ts) / 2) (r / (2 * complex.abs dir))]
            have h2 := (le_div_iff.real (u - ts) r (2 * complex.abs dir) (by linarith)).mp h1
            linarith [hps.1, mul_nonneg.real (u - ts) (complex.abs dir) (by linarith) (by linarith)]
          exact hdisk_zero (seg u) hdist_u
      have hle := is_sup.le_of_mem T ts (ts + step) hts hmem
      linarith
    have hzb : seg ts = zb
      rw [hts_eq1, hseg, hdir]; apply complex.ext <;> simp <;> ring
    have hhzb : h zb = complex.zero := by rw [← hzb]; exact hdisk_zero (seg ts) (by rw [complex.sub_self, complex.abs_zero]; exact hps.1)
    apply complex.ext
    · have hr0 : complex.re (complex.sub (f zb) (g zb)) = complex.re complex.zero := by rw [← hh_eq zb, hhzb]
      simp at hr0; linarith
    · have hi0 : complex.im (complex.sub (f zb) (g zb)) = complex.im complex.zero := by rw [← hh_eq zb, hhzb]
      simp at hi0; linarith

-- Zero Multiplicity, Isolated Zeros, and Exact Log-Derivative Pole Decomposition (0 axioms!):
-- If f is analytic at z0 with f(z0) = 0 and not all power-series coefficients vanish, then:
--   there exist m >= 1, delta > 0, and M >= 0 such that on 0 < |z - z0| < delta:
--     f(z) != 0, has_cderiv_at f z (cderiv_at f z), AND
--     |-cderiv_at f z / f z - (-m / (z - z0))| <= M !
+ is_cpower_series_at.log_deriv_decomp (f : ℂ → ℂ) (z0 : ℂ) (a : ℕ → ℂ) (r : ℝ)
    (hps : is_cpower_series_at f z0 a r) (hf0 : f z0 = complex.zero)
    (hnt : ∃ k : ℕ, a k ≠ complex.zero) :
    ∃ (m : ℕ) (delta M : ℝ), 1 ≤ m ∧ 0 < delta ∧ 0 ≤ M ∧
      ∀ z : ℂ, z ≠ z0 → complex.abs (complex.sub z z0) < delta →
        f z ≠ complex.zero ∧ has_cderiv_at f z (cderiv_at f z) ∧
        complex.abs (complex.sub (complex.neg (complex.mul (cderiv_at f z) (complex.inv (f z)))) (complex.neg (complex.mul (complex.of_real (m : ℝ)) (complex.inv (complex.sub z z0))))) ≤ M
  -- Step 1: Find least m with a m != 0 (well-ordering on N):
  have hmin_ex : ∀ K : ℕ, (∃ k : ℕ, k ≤ K ∧ a k ≠ complex.zero) → ∃ m : ℕ, a m ≠ complex.zero ∧ ∀ j : ℕ, j < m → a j = complex.zero
    intro K; induction K with h0 k ihk hk
    · obtain ⟨j, hj, hne⟩ := h0
      have hj0 : j = 0 := by omega
      rw [hj0] at hne; exact ⟨0, hne, by intro l hl; omega⟩
    · by_cases hex : ∃ j : ℕ, j ≤ k ∧ a j ≠ complex.zero
      · exact ihk hex
      · obtain ⟨j, hj, hne⟩ := hk
        rw [succ_eq_add_one.nat] at hj
        have hjeq : j = k + 1 := by
          by_contra hne1; apply hex; exact ⟨j, by omega, hne⟩
        rw [hjeq] at hne
        use k + 1; constructor; exact hne; intro l hl
        by_contra hne_l; apply hex; exact ⟨l, by omega, hne_l⟩
  obtain ⟨k0, hk0⟩ := hnt
  obtain ⟨m, ham_ne, ha_prev⟩ := hmin_ex k0 ⟨k0, by omega, hk0⟩
  have hm_ge1 : 1 ≤ m
    by_contra hlt; have hm0 : m = 0 := by omega
    rw [hm0, is_cpower_series_at.at_center f z0 a r hps, hf0] at ham_ne; exact ham_ne rfl
  -- Step 2: Factor f(z) = (z - z0)^m * g(z) where g(z) = sum_{k>=0} a(k + m) (z - z0)^k and g(z0) = a m != 0!
  obtain ⟨M0, hM0, hMaj0⟩ := hps.2.1
  have hr := hps.1
  have hrm_pos := rpow_nat_pos r hr m
  set b := (fun (k : ℕ) => a (k + m)) with hb
  set g := (fun (z : ℂ) => clim (fun N => csum N (fun k => complex.mul (b k) (cpow_nat (complex.sub z z0) k)))) with hg
  have hpow_add : ∀ (x : ℝ) (j k : ℕ), x ^ (j + k) = x ^ j * x ^ k
    intro x j k; induction k with l ihl
    · have h0 : j + 0 = j := by omega
      rw [h0, pow_zero.real]; ring
    · rw [succ_eq_add_one.nat]
      have h1a : j + (l + 1) = (j + l) + 1 := by omega
      rw [h1a, pow_succ.real, pow_succ.real, ihl]; ring
  have hb_maj : ∀ k : ℕ, complex.abs (b k) * r ^ k ≤ M0 / r ^ m
    intro k; rw [hb]
    have h1 := hMaj0 (k + m); rw [hpow_add r k m] at h1
    exact (le_div_iff.real (complex.abs (a (k + m)) * r ^ k) M0 (r ^ m) hrm_pos).mpr (by linarith)
  have hg_ps : is_cpower_series_at g z0 b r
    unfold is_cpower_series_at
    constructor; exact hr
    constructor
    · use M0 / r ^ m; constructor; exact div_nonneg.real M0 (r ^ m) hM0 (by linarith); exact hb_maj
    · intro z hz
      set qz := complex.abs (complex.sub z z0) / r with hqz
      have hqz0 : 0 ≤ qz := by rw [hqz]; exact div_nonneg.real (complex.abs (complex.sub z z0)) r (complex.abs_nonneg (complex.sub z z0)) (by linarith)
      have hqz1 : qz < 1 := by rw [hqz]; exact (div_lt_iff.real (complex.abs (complex.sub z z0)) 1 r hr).mpr (by linarith)
      have hcs : csummable (fun k => complex.mul (b k) (cpow_nat (complex.sub z z0) k))
        apply csummable.of_abs_summable
        apply summable.of_nonneg_le (fun k => complex.abs (complex.mul (b k) (cpow_nat (complex.sub z z0) k))) (fun k => (M0 / r ^ m) * qz ^ k)
        · intro k; exact complex.abs_nonneg (complex.mul (b k) (cpow_nat (complex.sub z z0) k))
        · intro k; rw [complex.abs_mul, cpow_nat.abs_eq, hqz, pow_div_pow_eq (complex.abs (complex.sub z z0)) r hr k]
          have hrk := rpow_nat_pos r hr k
          have hc := mul_inv_cancel.real (r ^ k) (by linarith)
          have hm := mul_le_mul_of_nonneg_right.real (complex.abs (b k) * r ^ k) (M0 / r ^ m) (complex.abs (complex.sub z z0) ^ k / r ^ k) (hb_maj k) (div_nonneg.real (complex.abs (complex.sub z z0) ^ k) (r ^ k) (pow_nonneg.real (complex.abs (complex.sub z z0)) (complex.abs_nonneg (complex.sub z z0)) k) (by linarith))
          have hre : complex.abs (b k) * r ^ k * (complex.abs (complex.sub z z0) ^ k / r ^ k) = complex.abs (b k) * complex.abs (complex.sub z z0) ^ k
            rw [div_def.real (complex.abs (complex.sub z z0) ^ k) (r ^ k)]; linear_combination (complex.abs (b k) * complex.abs (complex.sub z z0) ^ k) * hc
          linarith
        · exact geom_summable (M0 / r ^ m) qz (div_nonneg.real M0 (r ^ m) hM0 (by linarith)) hqz0 hqz1
      unfold csummable cconverges at hcs; obtain ⟨L, hL⟩ := hcs
      rw [hg]; rw [clim.eq_of_tends_to (fun N => csum N (fun k => complex.mul (b k) (cpow_nat (complex.sub z z0) k))) L hL]; exact hL
  have hfg_eq : ∀ z : ℂ, complex.abs (complex.sub z z0) < r → f z = complex.mul (cpow_nat (complex.sub z z0) m) (g z)
    intro z hz
    have hfl := hps.2.2 z hz
    have hgl := hg_ps.2.2 z hz
    have hml := ctends_to.const_mul (cpow_nat (complex.sub z z0) m) (fun N => csum N (fun k => complex.mul (b k) (cpow_nat (complex.sub z z0) k))) (g z) hgl
    have hsh_eq : ∀ N : ℕ, csum (m + N) (fun k => complex.mul (a k) (cpow_nat (complex.sub z z0) k)) = complex.mul (cpow_nat (complex.sub z z0) m) (csum N (fun k => complex.mul (b k) (cpow_nat (complex.sub z z0) k)))
      intro N; rw [csum.split_add m N, ← csum.scale_left]
      have hz0 : ∀ P : ℕ, P ≤ m → csum P (fun k => complex.mul (a k) (cpow_nat (complex.sub z z0) k)) = complex.zero
        intro P; induction P with h0 p ihp hp
        · rw [csum.zero]
        · rw [succ_eq_add_one.nat, csum.succ, ihp (by omega), ha_prev p (by omega), complex.zero_mul, complex.add_zero]
      rw [hz0 m (by omega), complex.zero_add]
      apply csum.congr; intro k _
      rw [hb]
      have hkm : m + k = k + m := by omega
      rw [hkm, cpow_nat.add (complex.sub z z0) k m]; apply complex.ext <;> simp <;> ring
    have hfl_sh : ctends_to (fun N => csum (m + N) (fun k => complex.mul (a k) (cpow_nat (complex.sub z z0) k))) (f z)
      unfold ctends_to at hfl ⊢; intro e he; obtain ⟨N0, hN0⟩ := hfl e he; use N0; intro N hN; exact hN0 (m + N) (by omega)
    have hfe : (fun N => csum (m + N) (fun k => complex.mul (a k) (cpow_nat (complex.sub z z0) k))) = (fun N => complex.mul (cpow_nat (complex.sub z z0) m) (csum N (fun k => complex.mul (b k) (cpow_nat (complex.sub z z0) k))))
      funext N; exact hsh_eq N
    rw [hfe] at hfl_sh
    exact ctends_to.unique (fun N => complex.mul (cpow_nat (complex.sub z z0) m) (csum N (fun k => complex.mul (b k) (cpow_nat (complex.sub z z0) k)))) (f z) (complex.mul (cpow_nat (complex.sub z z0) m) (g z)) hfl_sh hml
  -- Step 3: g(z0) = a m != 0 => g != 0, bounded below, and g' bounded above on a small disk!
  have hg0 : g z0 = a m := by have h := is_cpower_series_at.at_center g z0 b r hg_ps; rw [hb] at h; simp at h; exact h.symm
  have hg0_ne : g z0 ≠ complex.zero := by rw [hg0]; exact ham_ne
  have hg0_pos : 0 < complex.abs (g z0)
    by_contra hle; have hz : complex.abs (g z0) = 0 := by linarith [complex.abs_nonneg (g z0)]
    exact hg0_ne ((complex.abs_eq_zero (g z0)).mp hz)
  obtain ⟨d1, hd1_pos, hd1_cont⟩ := is_cpower_series_at.continuous_at g z0 b r hg_ps (complex.abs (g z0) / 2) (by linarith)
  have hf_der := is_cpower_series_at.has_cderiv_and_deriv f z0 a r hps
  have hg_der := is_cpower_series_at.has_cderiv_and_deriv g z0 b r hg_ps
  obtain ⟨d2, hd2_pos, hd2_cont⟩ := is_cpower_series_at.continuous_at (cderiv_at g) z0 (fun k => complex.smul ((k + 1 : ℕ) : ℝ) (b (k + 1))) (r / 2) hg_der.2 1 (by decide)
  set delta := min (min (r / 2) d1) d2 with hdelta
  have hdelta_pos : 0 < delta := by rw [hdelta]; exact lt_min.real (min (r / 2) d1) d2 0 (lt_min.real (r / 2) d1 0 (by linarith) hd1_pos) hd2_pos
  set Mg := (complex.abs (cderiv_at g z0) + 1) / (complex.abs (g z0) / 2) with hMg
  have hMg_nn : 0 ≤ Mg := by rw [hMg]; exact div_nonneg.real (complex.abs (cderiv_at g z0) + 1) (complex.abs (g z0) / 2) (by linarith [complex.abs_nonneg (cderiv_at g z0)]) (by linarith)
  use m; use delta; use Mg
  constructor; exact hm_ge1
  constructor; exact hdelta_pos
  constructor; exact hMg_nn
  intro z hzne hzdel
  have hzr2 : complex.abs (complex.sub z z0) < r / 2 := by linarith [min_le_left.real (min (r / 2) d1) d2, min_le_left.real (r / 2) d1]
  have hzr : complex.abs (complex.sub z z0) < r := by linarith
  have hzd1 : complex.abs (complex.sub z z0) < d1 := by linarith [min_le_left.real (min (r / 2) d1) d2, min_le_right.real (r / 2) d1]
  have hzd2 : complex.abs (complex.sub z z0) < d2 := by linarith [min_le_right.real (min (r / 2) d1) d2]
  have hgz_ge : complex.abs (g z0) / 2 ≤ complex.abs (g z)
    have h1 := hd1_cont z hzd1
    have h2 := complex.abs_sub_abs_le (g z0) (g z)
    rw [complex.abs_sub_comm (g z0) (g z)] at h2; linarith
  have hgz_ne : g z ≠ complex.zero := by intro h0; rw [h0, complex.abs_zero] at hgz_ge; linarith
  have hsub_ne : complex.sub z z0 ≠ complex.zero
    intro h0; apply hzne; apply complex.ext
    · have hr0 : complex.re (complex.sub z z0) = complex.re complex.zero := by rw [h0]
      simp at hr0; linarith
    · have hi0 : complex.im (complex.sub z z0) = complex.im complex.zero := by rw [h0]
      simp at hi0; linarith
  have hpm_ne : cpow_nat (complex.sub z z0) m ≠ complex.zero
    intro h0
    have ha0 : complex.abs (cpow_nat (complex.sub z z0) m) = 0 := by rw [h0, complex.abs_zero]
    rw [cpow_nat.abs_eq] at ha0
    have hpos_sub : 0 < complex.abs (complex.sub z z0) := by by_contra hle; exact hsub_ne ((complex.abs_eq_zero (complex.sub z z0)).mp (by linarith [complex.abs_nonneg (complex.sub z z0)]))
    linarith [rpow_nat_pos (complex.abs (complex.sub z z0)) hpos_sub m]
  have hfz_eq := hfg_eq z hzr
  have hfz_ne : f z ≠ complex.zero := by rw [hfz_eq]; exact complex.mul_ne_zero (cpow_nat (complex.sub z z0) m) (g z) hpm_ne hgz_ne
  have hfd := hf_der.1 z hzr2
  have hgd := hg_der.1 z hzr2
  -- Product rule at z: cderiv_at f z = m * (z - z0)^(m - 1) * g z + (z - z0)^m * cderiv_at g z!
  have hprod_deriv : cderiv_at f z = complex.add (complex.mul (complex.smul (m : ℝ) (cpow_nat (complex.sub z z0) (m - 1))) (g z)) (complex.mul (cpow_nat (complex.sub z z0) m) (cderiv_at g z))
    -- Directly prove has_cderiv_at f z (RHS) via has_cderiv_at.of_factor or product rule on (z - z0)^m * g z!
    set w := complex.sub z z0 with hw
    set V := complex.add (complex.mul (complex.smul (m : ℝ) (cpow_nat w (m - 1))) (g z)) (complex.mul (cpow_nat w m) (cderiv_at g z)) with hV
    have hhd : has_cderiv_at f z V
      -- Note has_cderiv_at (fun y => cpow_nat (y - z0) m) z (m * w^(m - 1)) by induction on m (or directly from cpow_nat.quad_rem_le)!
      have hpow_d : has_cderiv_at (fun y => cpow_nat (complex.sub y z0) m) z (complex.smul (m : ℝ) (cpow_nat w (m - 1)))
        by_cases hm1 : m = 1
        · rw [hm1]
          unfold has_cderiv_at; intro e he; use 1
          constructor
          · linarith
          intro y _
