    have hgz_pos : 0 < complex.abs (g z) := by linarith
    have h1 := mul_le_mul_of_nonneg_left.real (complex.abs (g z0) / 2) (complex.abs (g z)) (1 / complex.abs (g z)) hgz_ge (by linarith [one_div_pos.real (complex.abs (g z)) hgz_pos])
    have hc := mul_inv_cancel.real (complex.abs (g z)) (by linarith)
    exact (le_div_iff.real (1 / complex.abs (g z)) 1 (complex.abs (g z0) / 2) (by linarith)).mpr (by linarith)
  have hm1 := mul_le_mul_of_nonneg_right.real (complex.abs (cderiv_at g z)) (complex.abs (cderiv_at g z0) + 1) (1 / complex.abs (g z)) hgd_bd (by linarith [one_div_pos.real (complex.abs (g z)) (by linarith)])
  have hm2 := mul_le_mul_of_nonneg_left.real (1 / complex.abs (g z)) (1 / (complex.abs (g z0) / 2)) (complex.abs (cderiv_at g z0) + 1) hinv_le (by linarith [complex.abs_nonneg (cderiv_at g z0)])
  rw [hMg, div_def.real (complex.abs (cderiv_at g z0) + 1) (complex.abs (g z0) / 2)]
  linarith

-- ====================================================================================
-- 3. HALF-PLANE Re(s) > 0 ANALYTICITY OF `cexp`, `cpow_real`, `induced_euler_ratio`,
--    `nt_mellin_int`, `riemann_theta_tail_int`, `gamma`, AND `classical_L_reg` (0 AXIOMS!)
-- ====================================================================================

-- 3a. Shared `cexp_taylor` convergence + geometric remainder & entire analyticity of `cexp`/`cpow_real`/`induced_euler_ratio`!
+ cexp_taylor.tends_to (z : ℂ) :
    ctends_to (fun N => cexp_taylor N z) (complex.exp z)
  unfold ctends_to; intro e he
  set C1 := exp (complex.abs z) * exp (2 * complex.abs z) + 1 with hC1
  obtain ⟨D0, hD0⟩ := exists_nat_gt.real (C1 / e)
  use D0; intro N hN
  rw [complex.abs_sub_comm]
  have hrem := cexp.taylor_rem_le N z
  have hpf := pow_div_fact_le_exp_div N (complex.abs z) (complex.abs_nonneg z)
  have hm := mul_le_mul_of_nonneg_right.real (complex.abs z ^ N / ((fact N : ℕ) : ℝ)) (exp (2 * complex.abs z) / ((N + 1 : ℕ) : ℝ)) (exp (complex.abs z)) hpf (by linarith [exp_pos (complex.abs z)])
  have hlt_D : C1 / e < ((N + 1 : ℕ) : ℝ) := by linarith [(cast_lt.real D0 (N + 1)).mpr (by omega)]
  have hlt_e : C1 / ((N + 1 : ℕ) : ℝ) < e
    have h1 := (div_lt_iff.real C1 ((N + 1 : ℕ) : ℝ) e he).mp hlt_D
    exact (div_lt_iff.real C1 e ((N + 1 : ℕ) : ℝ) ((cast_pos.real (N + 1)).mpr (by omega))).mpr (by linarith)
  have hle_C1 : exp (2 * complex.abs z) * exp (complex.abs z) ≤ C1 := by rw [hC1]; linarith
  have hm2 := mul_le_mul_of_nonneg_right.real (exp (2 * complex.abs z) * exp (complex.abs z)) C1 (1 / ((N + 1 : ℕ) : ℝ)) hle_C1 (by linarith [one_div_pos.real ((N + 1 : ℕ) : ℝ) ((cast_pos.real (N + 1)).mpr (by omega))])
  rw [div_def.real (exp (2 * complex.abs z)) ((N + 1 : ℕ) : ℝ)] at hm
  rw [div_def.real C1 ((N + 1 : ℕ) : ℝ)] at hlt_e; linarith

+ cexp_taylor.rem_le_pow_exp (K : ℕ) (z : ℂ) (q y : ℝ)
    (hq0 : 0 ≤ q) (hq1 : q ≤ 1) (hy_nn : 0 ≤ y) (habs_z : complex.abs z = q * y) :
    complex.abs (complex.sub (complex.exp z) (cexp_taylor K z)) ≤ q ^ K * exp y
  have hpow_mul : ∀ (a b : ℝ) (k : ℕ), (a * b) ^ k = a ^ k * b ^ k
    intro a b k; induction k with j ihj
    · rw [pow_zero.real, pow_zero.real, pow_zero.real]; ring
    · rw [succ_eq_add_one.nat, pow_succ.real, pow_succ.real, pow_succ.real, ihj]; ring
  have htay_diff : ∀ d : ℕ, complex.abs (complex.sub (cexp_taylor (K + d) z) (cexp_taylor K z)) ≤ q ^ K * exp y
    intro d; unfold cexp_taylor; rw [csum.split_add K d]
    have hsub : complex.sub (complex.add (csum K (fun k => complex.smul (1 / ((fact k : ℕ) : ℝ)) (cpow_nat z k))) (csum d (fun j => complex.smul (1 / ((fact (K + j) : ℕ) : ℝ)) (cpow_nat z (K + j))))) (csum K (fun k => complex.smul (1 / ((fact k : ℕ) : ℝ)) (cpow_nat z k))) = csum d (fun j => complex.smul (1 / ((fact (K + j) : ℕ) : ℝ)) (cpow_nat z (K + j))) := by ring
    rw [hsub]
    have h1 := csum.abs_le_sum d (fun j => complex.smul (1 / ((fact (K + j) : ℕ) : ℝ)) (cpow_nat z (K + j)))
    have hle2_pt : ∀ j : ℕ, j < d → complex.abs (complex.smul (1 / ((fact (K + j) : ℕ) : ℝ)) (cpow_nat z (K + j))) ≤ q ^ K * (y ^ (K + j) / ((fact (K + j) : ℕ) : ℝ))
      intro j _
      rw [complex.abs_smul, abs_of_pos.real (1 / ((fact (K + j) : ℕ) : ℝ)) (one_div_pos.real ((fact (K + j) : ℕ) : ℝ) (fact_cast_pos (K + j))), cpow_nat.abs_eq, habs_z, hpow_mul q y (K + j)]
      have hpow_add : ∀ m : ℕ, q ^ (K + m) = q ^ K * q ^ m
        intro m; induction m with l ihl
        · have h0 : K + 0 = K := by omega; rw [h0, pow_zero.real]; ring
        · rw [succ_eq_add_one.nat]; have h1a : K + (l + 1) = (K + l) + 1 := by omega; rw [h1a, pow_succ.real, pow_succ.real, ihl]; ring
      have hqj_le1 : q ^ j ≤ 1
        have hgen : ∀ l : ℕ, q ^ l ≤ 1
          intro l; induction l with p ihp
          · rw [pow_zero.real]; linarith
          · rw [succ_eq_add_one.nat, pow_succ.real]; nlinarith [pow_nonneg.real q hq0 p]
        exact hgen j
      rw [hpow_add j]
      have hqK_le : q ^ K * q ^ j ≤ q ^ K := by linarith [mul_le_mul_of_nonneg_left.real (q ^ j) 1 (q ^ K) hqj_le1 (pow_nonneg.real q hq0 K)]
      have hm := mul_le_mul_of_nonneg_right.real (q ^ K * q ^ j) (q ^ K) (y ^ (K + j) / ((fact (K + j) : ℕ) : ℝ)) hqK_le (div_nonneg.real (y ^ (K + j)) ((fact (K + j) : ℕ) : ℝ) (pow_nonneg.real y hy_nn (K + j)) (by linarith [fact_cast_pos (K + j)]))
      rw [div_def.real (y ^ (K + j)) ((fact (K + j) : ℕ) : ℝ)] at hm ⊢
      rw [div_def.real 1 ((fact (K + j) : ℕ) : ℝ)]; linarith
    have hle2 := sum_le.real (fun j => complex.abs (complex.smul (1 / ((fact (K + j) : ℕ) : ℝ)) (cpow_nat z (K + j)))) (fun j => q ^ K * (y ^ (K + j) / ((fact (K + j) : ℕ) : ℝ))) d hle2_pt
    have hsc : ∀ m : ℕ, (∑ j < m, q ^ K * (y ^ (K + j) / ((fact (K + j) : ℕ) : ℝ))) = q ^ K * (∑ j < m, y ^ (K + j) / ((fact (K + j) : ℕ) : ℝ))
      intro m; induction m with l ihl
      · rw [sum_below_zero, sum_below_zero]; ring
      · rw [succ_eq_add_one.nat, sum_below_succ, sum_below_succ, ihl]; ring
    have hsplit_et : (∑ j < d, y ^ (K + j) / ((fact (K + j) : ℕ) : ℝ)) ≤ exp y
      have hadd_s : ∀ m : ℕ, (∑ j < K + m, y ^ j / ((fact j : ℕ) : ℝ)) = (∑ j < K, y ^ j / ((fact j : ℕ) : ℝ)) + (∑ j < m, y ^ (K + j) / ((fact (K + j) : ℕ) : ℝ))
        intro m; induction m with l ihl
        · have h0 : K + 0 = K := by omega; rw [h0, sum_below_zero]; ring
        · rw [succ_eq_add_one.nat]; have h1a : K + (l + 1) = (K + l) + 1 := by omega; rw [h1a, sum_below_succ, sum_below_succ, ihl]; ring
      have hle_e := exp_taylor.le_exp (K + d) y hy_nn
      unfold exp_taylor at hle_e; rw [hadd_s d] at hle_e
      have hnn_sum : 0 ≤ ∑ j < K, y ^ j / ((fact j : ℕ) : ℝ) := exp_taylor.nonneg K y hy_nn
      linarith
    linarith [mul_le_mul_of_nonneg_left.real (∑ j < d, y ^ (K + j) / ((fact (K + j) : ℕ) : ℝ)) (exp y) (q ^ K) hsplit_et (pow_nonneg.real q hq0 K), hsc d]
  have htay_lim : ctends_to (fun d => cexp_taylor (K + d) z) (complex.exp z)
    have hl := cexp_taylor.tends_to z
    unfold ctends_to at hl ⊢; intro e he; obtain ⟨N0, hN0⟩ := hl e he; use N0; intro d hd; exact hN0 (K + d) (by omega)
  have hsh_lim := ctends_to.sub (fun d => cexp_taylor (K + d) z) (fun _ => cexp_taylor K z) (complex.exp z) (cexp_taylor K z) htay_lim (ctends_to.const (cexp_taylor K z))
  have habs_l := ctends_to.abs (fun d => complex.sub (cexp_taylor (K + d) z) (cexp_taylor K z)) (complex.sub (complex.exp z) (cexp_taylor K z)) hsh_lim
  have hneg_l : tends_to (fun d => -complex.abs (complex.sub (cexp_taylor (K + d) z) (cexp_taylor K z))) (-complex.abs (complex.sub (complex.exp z) (cexp_taylor K z)))
    unfold tends_to at habs_l ⊢; intro e he; obtain ⟨N0, hN0⟩ := habs_l e he; use N0; intro d hd
    have hre : -complex.abs (complex.sub (cexp_taylor (K + d) z) (cexp_taylor K z)) - -complex.abs (complex.sub (complex.exp z) (cexp_taylor K z)) = -(complex.abs (complex.sub (cexp_taylor (K + d) z) (cexp_taylor K z)) - complex.abs (complex.sub (complex.exp z) (cexp_taylor K z))) := by ring
    rw [hre, abs_neg_eq]; exact hN0 d hd
  linarith [tends_to.ge_of_ge (fun d => -complex.abs (complex.sub (cexp_taylor (K + d) z) (cexp_taylor K z))) (-complex.abs (complex.sub (complex.exp z) (cexp_taylor K z))) (-(q ^ K * exp y)) hneg_l (by intro d; linarith [htay_diff d])]

+ cexp.is_cpower_series_at (z0 : ℂ) (R : ℝ) (hR : 0 < R) :
    is_cpower_series_at complex.exp z0 (fun k => complex.smul (1 / ((fact k : ℕ) : ℝ)) (complex.exp z0)) R
  unfold is_cpower_series_at
  constructor; exact hR
  constructor
  · use complex.abs (complex.exp z0) * exp R
    constructor; exact mul_nonneg.real (complex.abs (complex.exp z0)) (exp R) (complex.abs_nonneg (complex.exp z0)) (by linarith [exp_pos R])
    intro k
    rw [complex.abs_smul, abs_of_pos.real (1 / ((fact k : ℕ) : ℝ)) (one_div_pos.real ((fact k : ℕ) : ℝ) (fact_cast_pos k))]
    have hpow_le : R ^ k / ((fact k : ℕ) : ℝ) ≤ exp R
      have h1 := exp_taylor.le_exp (k + 1) R (by linarith)
      unfold exp_taylor at h1
      rw [sum_below_succ] at h1
      have hnn : 0 ≤ ∑ j < k, R ^ j / ((fact j : ℕ) : ℝ) := exp_taylor.nonneg k R (by linarith)
      linarith
    have hm := mul_le_mul_of_nonneg_left.real (R ^ k / ((fact k : ℕ) : ℝ)) (exp R) (complex.abs (complex.exp z0)) hpow_le (complex.abs_nonneg (complex.exp z0))
    have hre : 1 / ((fact k : ℕ) : ℝ) * complex.abs (complex.exp z0) * R ^ k = complex.abs (complex.exp z0) * (R ^ k / ((fact k : ℕ) : ℝ)) := by field_simp
    linarith
  · intro z hz
    set w := complex.sub z z0 with hw
    have hexp_eq : complex.exp z = complex.mul (complex.exp z0) (complex.exp w)
      rw [hw, ← complex.exp_add]
      have h1 : complex.add z0 (complex.sub z z0) = z := by ring
      rw [h1]
    have hsum_eq : (fun N => complex.mul (complex.exp z0) (cexp_taylor N w)) = (fun N => csum N (fun k => complex.mul (complex.smul (1 / ((fact k : ℕ) : ℝ)) (complex.exp z0)) (cpow_nat w k)))
      funext N; unfold cexp_taylor; rw [← csum.scale_left]; apply csum.congr; intro k _; ring
    have hlim := ctends_to.const_mul (complex.exp z0) (fun N => cexp_taylor N w) (complex.exp w) (cexp_taylor.tends_to w)
    rw [hsum_eq, ← hexp_eq] at hlim; exact hlim

+ cpow_real.is_canalytic_at_linear (c a_sc : ℝ) (b_off : ℂ) (hc : 0 < c) (s0 : ℂ) :
    is_canalytic_at (fun s => cpow_real c (complex.add (complex.smul a_sc s) b_off)) s0
  set lam := log c * a_sc with hlam
  set A0 := cpow_real c (complex.add (complex.smul a_sc s0) b_off) with hA0
  unfold is_canalytic_at
  use (fun k => complex.smul (lam ^ k / ((fact k : ℕ) : ℝ)) A0); use 1
  unfold is_cpower_series_at
  constructor
  · use complex.abs A0 * exp (|lam|)
    constructor; exact mul_nonneg.real (complex.abs A0) (exp (|lam|)) (complex.abs_nonneg A0) (by linarith [exp_pos (|lam|)])
    intro k
    have h1p : ∀ m : ℕ, (1 : ℝ) ^ m = 1
      intro m; induction m with j ihj
      · rw [pow_zero.real]
      · rw [succ_eq_add_one.nat, pow_succ.real, ihj]; ring
    rw [h1p k, complex.abs_smul]
    have habs_div : |lam ^ k / ((fact k : ℕ) : ℝ)| = |lam| ^ k / ((fact k : ℕ) : ℝ)
      rw [div_def.real (lam ^ k) ((fact k : ℕ) : ℝ), abs_mul.real, abs_of_pos.real (1 / ((fact k : ℕ) : ℝ)) (one_div_pos.real ((fact k : ℕ) : ℝ) (fact_cast_pos k)), div_def.real (|lam| ^ k) ((fact k : ℕ) : ℝ)]
      have hap : ∀ m : ℕ, |lam ^ m| = |lam| ^ m
        intro m; induction m with j ihj
        · rw [pow_zero.real, pow_zero.real, abs_of_pos.real 1 (by decide)]
        · rw [succ_eq_add_one.nat, pow_succ.real, pow_succ.real, abs_mul.real, ihj]
      rw [hap k]
    rw [habs_div]
    have hle : |lam| ^ k / ((fact k : ℕ) : ℝ) ≤ exp (|lam|)
      have h1 := exp_taylor.le_exp (k + 1) (|lam|) (abs_nonneg.real lam)
      unfold exp_taylor at h1; rw [sum_below_succ] at h1
      have hnn_sum : 0 ≤ ∑ i < k, |lam| ^ i / ((fact i : ℕ) : ℝ) := exp_taylor.nonneg k (|lam|) (abs_nonneg.real lam)
      linarith
    have hm := mul_le_mul_of_nonneg_right.real (|lam| ^ k / ((fact k : ℕ) : ℝ)) (exp (|lam|)) (complex.abs A0) hle (complex.abs_nonneg A0)
    linarith
  · intro s _
    set w := complex.sub s s0 with hw
    have hexp_eq : cpow_real c (complex.add (complex.smul a_sc s) b_off) = complex.mul A0 (complex.exp (complex.smul lam w))
      rw [hA0]; unfold cpow_real; rw [← complex.exp_add, hlam, hw]
      have harg : complex.smul (log c) (complex.add (complex.smul a_sc s) b_off) = complex.add (complex.smul (log c) (complex.add (complex.smul a_sc s0) b_off)) (complex.smul (log c * a_sc) (complex.sub s s0)) := by ring
      rw [harg]
    have hsum_eq : (fun N => complex.mul A0 (cexp_taylor N (complex.smul lam w))) = (fun N => csum N (fun k => complex.mul (complex.smul (lam ^ k / ((fact k : ℕ) : ℝ)) A0) (cpow_nat w k)))
      funext N; unfold cexp_taylor; rw [← csum.scale_left]; apply csum.congr; intro k _
      rw [cpow_nat.real_smul lam w k, div_def.real (lam ^ k) ((fact k : ℕ) : ℝ), div_def.real 1 ((fact k : ℕ) : ℝ)]; ring
    have hlim := ctends_to.const_mul A0 (fun N => cexp_taylor N (complex.smul lam w)) (complex.exp (complex.smul lam w)) (cexp_taylor.tends_to (complex.smul lam w))
    rw [hsum_eq, ← hexp_eq] at hlim; exact hlim

+ induced_euler_ratio.is_canalytic_at (q : ℕ) (psi : DChar) (s0 : ℂ) :
    is_canalytic_at (fun s => induced_euler_ratio q psi s) s0
  unfold induced_euler_ratio
  apply is_canalytic_at.cprod (q + 1) (fun k s => euler_factor (induced_weight q psi k) (induced_prime q k) s) s0
  intro k _
  have hp_pos : 0 < induced_prime q k := by linarith [induced_prime.gt_one q k]
  have hcp := cpow_real.is_canalytic_at_linear (induced_prime q k) (-1) complex.zero hp_pos s0
  have hfe : (fun s => cpow_real (induced_prime q k) (complex.add (complex.smul (-1) s) complex.zero)) = (fun s => cpow_real (induced_prime q k) (complex.neg s)) := by ring
  rw [hfe] at hcp
  have hmul := is_canalytic_at.const_mul (induced_weight q psi k) (fun s => cpow_real (induced_prime q k) (complex.neg s)) s0 hcp
  have hsub := is_canalytic_at.sub (fun _ => complex.one) (fun s => complex.mul (induced_weight q psi k) (cpow_real (induced_prime q k) (complex.neg s))) s0 (is_canalytic_at.const complex.one s0) hmul
  exact hsub

+ induced_euler_ratio.ne_zero_re_pos (q : ℕ) (psi : DChar) (hval : dchar.valid psi) (s : ℂ) (hs : 0 < complex.re s) :
    induced_euler_ratio q psi s ≠ complex.zero
  unfold induced_euler_ratio
  exact finite_euler_prod.ne_zero (q + 1) (induced_weight q psi) (induced_prime q) s hs (by intro i _; exact induced_prime.gt_one q i) (by intro i _; exact induced_weight.norm_sq_le_one q psi hval i)

-- 3b. Unified Majorized Mellin Integral Power-Series Engine (0 axioms!):
-- Factoring the common improper-integral + Taylor-remainder engine once makes BOTH
-- `exp_mellin_int.is_cpower_series_at` AND `rpow_mellin_int.is_cpower_series_at` short corollaries!
+ majorized_mellin_int.is_cpower_series_at (g : ℝ → ℂ) (w_maj : ℝ → ℝ) (alpha : ℝ) (s0 : ℂ) (R B_int : ℝ)
    (hR : 0 < R) (hB_nn : 0 ≤ B_int)
    (hcont_re : ∀ u : ℝ, 1 ≤ u → continuous_at (fun x => complex.re (g x)) u)
    (hcont_im : ∀ u : ℝ, 1 ≤ u → continuous_at (fun x => complex.im (g x)) u)
    (hbd : ∀ u : ℝ, 1 ≤ u → complex.abs (g u) * exp (R * |alpha| * log u) ≤ w_maj u)
    (hw_imp : ∀ (f : ℝ → ℂ) (K : ℝ), 0 ≤ K →
      (∀ u : ℝ, 1 ≤ u → continuous_at (fun x => complex.re (f x)) u) →
      (∀ u : ℝ, 1 ≤ u → continuous_at (fun x => complex.im (f x)) u) →
      (∀ u : ℝ, 1 ≤ u → complex.abs (f u) ≤ K * w_maj u) →
      ctends_to (fun (N : ℕ) => cint f 1 (1 + (N : ℝ))) (clim (fun (N : ℕ) => cint f 1 (1 + (N : ℝ)))) ∧
      complex.abs (clim (fun (N : ℕ) => cint f 1 (1 + (N : ℝ)))) ≤ K * B_int)
    (hw_fin : ∀ (B K : ℝ), 1 ≤ B → 0 ≤ K → ∃ I : ℝ, darboux.has_integral (fun u => K * w_maj u) 1 B I ∧ I ≤ K * B_int) :
    is_cpower_series_at (fun s => clim (fun (N : ℕ) => cint (fun u => complex.mul (g u) (complex.exp (complex.smul (alpha * log u) (complex.sub s s0)))) 1 (1 + (N : ℝ)))) s0 (fun k => clim (fun (N : ℕ) => cint (fun u => complex.smul ((alpha * log u) ^ k / ((fact k : ℕ) : ℝ)) (g u)) 1 (1 + (N : ℝ)))) R
  set F := (fun (s : ℂ) => clim (fun (N : ℕ) => cint (fun u => complex.mul (g u) (complex.exp (complex.smul (alpha * log u) (complex.sub s s0)))) 1 (1 + (N : ℝ)))) with hF
  set fk := (fun (k : ℕ) (u : ℝ) => complex.smul ((alpha * log u) ^ k / ((fact k : ℕ) : ℝ)) (g u)) with hfk
  set a := (fun (k : ℕ) => clim (fun (N : ℕ) => cint (fk k) 1 (1 + (N : ℝ)))) with ha
  have hpow_abs : ∀ (x : ℝ) (k : ℕ), |x ^ k| = |x| ^ k
    intro x k; induction k with j ihj
    · rw [pow_zero.real, pow_zero.real, abs_of_pos.real 1 (by decide)]
    · rw [succ_eq_add_one.nat, pow_succ.real, pow_succ.real, abs_mul.real, ihj]
  have hpow_mul : ∀ (x y : ℝ) (k : ℕ), (x * y) ^ k = x ^ k * y ^ k
    intro x y k; induction k with j ihj
    · rw [pow_zero.real, pow_zero.real, pow_zero.real]; ring
    · rw [succ_eq_add_one.nat, pow_succ.real, pow_succ.real, pow_succ.real, ihj]; ring
  have hfk_props : ∀ k : ℕ,
      (∀ u, 1 ≤ u → continuous_at (fun x => complex.re (fk k x)) u) ∧
      (∀ u, 1 ≤ u → continuous_at (fun x => complex.im (fk k x)) u) ∧
      (∀ u, 1 ≤ u → complex.abs (fk k u) * R ^ k ≤ w_maj u)
    intro k
    constructor
    · intro u hu; rw [hfk]; continuity
    · constructor
      · intro u hu; rw [hfk]; continuity
      · intro u hu
        rw [hfk, complex.abs_smul]
        have hlu_nn : 0 ≤ log u := log_nonneg u hu
        have habs_sc : |(alpha * log u) ^ k / ((fact k : ℕ) : ℝ)| * R ^ k = (R * |alpha| * log u) ^ k / ((fact k : ℕ) : ℝ)
          rw [div_def.real ((alpha * log u) ^ k) ((fact k : ℕ) : ℝ), abs_mul.real, abs_of_pos.real (1 / ((fact k : ℕ) : ℝ)) (one_div_pos.real ((fact k : ℕ) : ℝ) (fact_cast_pos k)), hpow_abs, abs_mul.real, abs_of_nonneg.real (log u) hlu_nn, div_def.real ((R * |alpha| * log u) ^ k) ((fact k : ℕ) : ℝ)]
          have h1 : (R * (|alpha| * log u)) ^ k = R ^ k * (|alpha| * log u) ^ k := hpow_mul R (|alpha| * log u) k
          have h2 : R * |alpha| * log u = R * (|alpha| * log u) := by ring
          rw [h2, h1]; ring
        have hle_exp : (R * |alpha| * log u) ^ k / ((fact k : ℕ) : ℝ) ≤ exp (R * |alpha| * log u)
          have hnn : 0 ≤ R * |alpha| * log u := mul_nonneg.real (R * |alpha|) (log u) (mul_nonneg.real R (|alpha|) (by linarith) (abs_nonneg.real alpha)) hlu_nn
          have h1 := exp_taylor.le_exp (k + 1) (R * |alpha| * log u) hnn
          unfold exp_taylor at h1; rw [sum_below_succ] at h1
          have hnn_sum : 0 ≤ ∑ i < k, (R * |alpha| * log u) ^ i / ((fact i : ℕ) : ℝ) := exp_taylor.nonneg k (R * |alpha| * log u) hnn
          linarith
        have hre : |(alpha * log u) ^ k / ((fact k : ℕ) : ℝ)| * complex.abs (g u) * R ^ k = complex.abs (g u) * (|(alpha * log u) ^ k / ((fact k : ℕ) : ℝ)| * R ^ k) := by ring
        rw [hre, habs_sc]
        have hm := mul_le_mul_of_nonneg_left.real ((R * |alpha| * log u) ^ k / ((fact k : ℕ) : ℝ)) (exp (R * |alpha| * log u)) (complex.abs (g u)) hle_exp (complex.abs_nonneg (g u))
        linarith [hbd u hu]
  have ha_spec : ∀ k : ℕ, ctends_to (fun (N : ℕ) => cint (fk k) 1 (1 + (N : ℝ))) (a k) ∧ complex.abs (a k) * R ^ k ≤ B_int
    intro k
    have hp := hfk_props k
    have hRk := rpow_nat_pos R hR k
    have hbd_k : ∀ u : ℝ, 1 ≤ u → complex.abs (fk k u) ≤ (1 / R ^ k) * w_maj u
      intro u hu
      have h1 := (le_div_iff.real (complex.abs (fk k u)) (w_maj u) (R ^ k) hRk).mpr (hp.2.2 u hu)
      rw [div_def.real (w_maj u) (R ^ k)] at h1; linarith
    have himp := hw_imp (fk k) (1 / R ^ k) (by linarith [one_div_pos.real (R ^ k) hRk]) hp.1 hp.2.1 hbd_k
    constructor; rw [ha]; exact himp.1
    have hak : a k = clim (fun (N : ℕ) => cint (fk k) 1 (1 + (N : ℝ))) := by rw [ha]
    rw [← hak] at himp
    have hm := mul_le_mul_of_nonneg_right.real (complex.abs (a k)) ((1 / R ^ k) * B_int) (R ^ k) himp.2 (by linarith)
    have hre : (1 / R ^ k) * B_int * R ^ k = B_int := by field_simp
    linarith
  unfold is_cpower_series_at
  constructor; exact hR
  constructor
  · use B_int; constructor; exact hB_nn; intro k; have hk := (ha_spec k).2; rw [ha, hfk] at hk; exact hk
  · intro s hs
    set w := complex.sub s s0 with hw
    set fs := (fun (u : ℝ) => complex.mul (g u) (complex.exp (complex.smul (alpha * log u) w))) with hfs
    have hfs_cont : ∀ u : ℝ, 1 ≤ u → continuous_at (fun x => complex.re (fs x)) u ∧ continuous_at (fun x => complex.im (fs x)) u
      intro u hu; rw [hfs]; continuity
    have hfs_bd : ∀ u : ℝ, 1 ≤ u → complex.abs (fs u) ≤ 1 * w_maj u
      intro u hu; rw [hfs, complex.abs_mul, complex.abs_exp]; simp
      have hlu_nn : 0 ≤ log u := log_nonneg u hu
      have h1 : alpha * complex.re w ≤ |alpha| * complex.abs w
        have ha1 := le_abs_self.real (alpha * complex.re w); rw [abs_mul.real] at ha1
        linarith [mul_le_mul_of_nonneg_left.real (|complex.re w|) (complex.abs w) (|alpha|) (complex.re_abs_le w) (abs_nonneg.real alpha)]
      have h2 := mul_le_mul_of_nonneg_left.real (complex.abs w) R (|alpha|) (by linarith) (abs_nonneg.real alpha)
      have hre_le : alpha * log u * complex.re w ≤ R * |alpha| * log u := by linarith [mul_le_mul_of_nonneg_right.real (alpha * complex.re w) (R * |alpha|) (log u) (by linarith) hlu_nn]
      have he := (exp_le_exp (alpha * log u * complex.re w) (R * |alpha| * log u)).mpr hre_le
      linarith [mul_le_mul_of_nonneg_left.real (exp (alpha * log u * complex.re w)) (exp (R * |alpha| * log u)) (complex.abs (g u)) he (complex.abs_nonneg (g u)), hbd u hu]
    have hF_imp := hw_imp fs 1 (by decide) (by intro u hu; exact (hfs_cont u hu).1) (by intro u hu; exact (hfs_cont u hu).2) hfs_bd
    set q := complex.abs w / R with hq
    have hq0 : 0 ≤ q := by rw [hq]; exact div_nonneg.real (complex.abs w) R (complex.abs_nonneg w) (by linarith)
    have hq1 : q < 1 := by rw [hq]; exact (div_lt_iff.real (complex.abs w) 1 R hR).mpr (by linarith)
    have hpt_rem : ∀ (K : ℕ) (u : ℝ), 1 ≤ u →
        complex.abs (complex.sub (fs u) (csum K (fun k => complex.mul (fk k u) (cpow_nat w k)))) ≤ q ^ K * w_maj u
      intro K u hu
      set z := complex.smul (alpha * log u) w with hz
      have hsum_tay : csum K (fun k => complex.mul (fk k u) (cpow_nat w k)) = complex.mul (g u) (cexp_taylor K z)
        unfold cexp_taylor; rw [← csum.scale_left]; apply csum.congr; intro k _
        have hfku : fk k u = complex.smul ((alpha * log u) ^ k / ((fact k : ℕ) : ℝ)) (g u) := by rw [hfk]
        rw [hfku, hz, cpow_nat.real_smul (alpha * log u) w k, div_def.real ((alpha * log u) ^ k) ((fact k : ℕ) : ℝ), div_def.real 1 ((fact k : ℕ) : ℝ)]
        ring
      have hfsu : fs u = complex.mul (g u) (complex.exp z) := by rw [hfs, hz]
      rw [hsum_tay, hfsu]
      have hfac : complex.sub (complex.mul (g u) (complex.exp z)) (complex.mul (g u) (cexp_taylor K z)) = complex.mul (g u) (complex.sub (complex.exp z) (cexp_taylor K z)) := by ring
      rw [hfac, complex.abs_mul]
      have hlu_nn : 0 ≤ log u := log_nonneg u hu
      set y := R * |alpha| * log u with hy
      have hy_nn : 0 ≤ y := by rw [hy]; exact mul_nonneg.real (R * |alpha|) (log u) (mul_nonneg.real R (|alpha|) (by linarith) (abs_nonneg.real alpha)) hlu_nn
      have habs_z : complex.abs z = q * y
        rw [hz, complex.abs_smul, abs_mul.real, abs_of_nonneg.real (log u) hlu_nn, hq, hy]; field_simp
      have hrem_z := cexp_taylor.rem_le_pow_exp K z q y hq0 (by linarith) hy_nn habs_z
      have hm_g := mul_le_mul_of_nonneg_left.real (complex.abs (complex.sub (complex.exp z) (cexp_taylor K z))) (q ^ K * exp y) (complex.abs (g u)) hrem_z (complex.abs_nonneg (g u))
      have hbd_y : complex.abs (g u) * exp y ≤ w_maj u := by rw [hy]; exact hbd u hu
      have hm_bd := mul_le_mul_of_nonneg_left.real (complex.abs (g u) * exp y) (w_maj u) (q ^ K) hbd_y (pow_nonneg.real q hq0 K)
      linarith
    have hK_err : ∀ K : ℕ, complex.abs (complex.sub (F s) (csum K (fun k => complex.mul (a k) (cpow_nat w k)))) ≤ B_int * q ^ K
      intro K
      have hN_err : ∀ N : ℕ, complex.abs (complex.sub (cint fs 1 (1 + (N : ℝ))) (csum K (fun k => complex.mul (cint (fk k) 1 (1 + (N : ℝ))) (cpow_nat w k)))) ≤ B_int * q ^ K
        intro N
        set B := 1 + (N : ℝ) with hB
        have hB1 : 1 ≤ B := by rw [hB]; linarith [cast_nonneg.real N]
        have hI_fs : c_has_integral fs 1 B (cint fs 1 B)
          obtain ⟨Ir, hIr⟩ := darboux.continuous (fun x => complex.re (fs x)) 1 B hB1 (by intro t ht1 _; exact (hfs_cont t ht1).1)
          obtain ⟨Ii, hIi⟩ := darboux.continuous (fun x => complex.im (fs x)) 1 B hB1 (by intro t ht1 _; exact (hfs_cont t ht1).2)
          have hI : c_has_integral fs 1 B (complex.mk Ir Ii) := by unfold c_has_integral; simp; exact ⟨hIr, hIi⟩
          rw [cint.eq_of_has_integral fs 1 B (complex.mk Ir Ii) hI]; exact hI
        have hI_sum : ∀ M : ℕ, c_has_integral (fun u => csum M (fun k => complex.mul (fk k u) (cpow_nat w k))) 1 B (csum M (fun k => complex.mul (cint (fk k) 1 B) (cpow_nat w k)))
          intro M; induction M with m ihm
          · have h0 : (fun (u : ℝ) => csum 0 (fun k => complex.mul (fk k u) (cpow_nat w k))) = (fun _ => complex.zero) := by funext u; rw [csum.zero]
            rw [h0, csum.zero]; unfold c_has_integral; simp
            have hc0 := darboux.const 1 B 0 hB1; have hz : 0 * (B - 1) = 0 := by ring; rw [hz] at hc0; exact hc0
          · rw [succ_eq_add_one.nat, csum.succ]
            have hI_fk : c_has_integral (fk m) 1 B (cint (fk m) 1 B)
              have hp := hfk_props m
              obtain ⟨Ir, hIr⟩ := darboux.continuous (fun x => complex.re (fk m x)) 1 B hB1 (by intro t ht1 _; exact hp.1 t ht1)
              obtain ⟨Ii, hIi⟩ := darboux.continuous (fun x => complex.im (fk m x)) 1 B hB1 (by intro t ht1 _; exact hp.2.1 t ht1)
              have hI : c_has_integral (fk m) 1 B (complex.mk Ir Ii) := by unfold c_has_integral; simp; exact ⟨hIr, hIi⟩
              rw [cint.eq_of_has_integral (fk m) 1 B (complex.mk Ir Ii) hI]; exact hI
            have hsc := c_has_integral.scale_complex (fk m) 1 B (cpow_nat w m) (cint (fk m) 1 B) hI_fk
            have hsc_r : c_has_integral (fun u => complex.mul (fk m u) (cpow_nat w m)) 1 B (complex.mul (cint (fk m) 1 B) (cpow_nat w m))
              have hval : complex.mul (cpow_nat w m) (cint (fk m) 1 B) = complex.mul (cint (fk m) 1 B) (cpow_nat w m) := by ring
              rw [← hval]; apply c_has_integral.congr (fun u => complex.mul (cpow_nat w m) (fk m u)) (fun u => complex.mul (fk m u) (cpow_nat w m)) 1 B (complex.mul (cpow_nat w m) (cint (fk m) 1 B)) hsc
              intro u _ _; ring
            have hadd := c_has_integral.add (fun u => csum m (fun k => complex.mul (fk k u) (cpow_nat w k))) (fun u => complex.mul (fk m u) (cpow_nat w m)) 1 B (csum m (fun k => complex.mul (cint (fk k) 1 B) (cpow_nat w k))) (complex.mul (cint (fk m) 1 B) (cpow_nat w m)) ihm hsc_r
            apply c_has_integral.congr (fun u => complex.add (csum m (fun k => complex.mul (fk k u) (cpow_nat w k))) (complex.mul (fk m u) (cpow_nat w m))) (fun u => csum (m + 1) (fun k => complex.mul (fk k u) (cpow_nat w k))) 1 B (complex.add (csum m (fun k => complex.mul (cint (fk k) 1 B) (cpow_nat w k))) (complex.mul (cint (fk m) 1 B) (cpow_nat w m))) hadd
            intro u _ _; rw [csum.succ]
        have hIdiff := c_has_integral.sub fs (fun u => csum K (fun k => complex.mul (fk k u) (cpow_nat w k))) 1 B (cint fs 1 B) (csum K (fun k => complex.mul (cint (fk k) 1 B) (cpow_nat w k))) hI_fs (hI_sum K)
        obtain ⟨Imaj, hmaj, hImaj_le⟩ := hw_fin B (q ^ K) hB1 (pow_nonneg.real q hq0 K)
        have hbd_int := c_has_integral.abs_le_integral (fun u => complex.sub (fs u) (csum K (fun k => complex.mul (fk k u) (cpow_nat w k)))) (fun u => q ^ K * w_maj u) 1 B Imaj (complex.sub (cint fs 1 B) (csum K (fun k => complex.mul (cint (fk k) 1 B) (cpow_nat w k)))) hB1 hIdiff hmaj (by intro u hu1 _; exact hpt_rem K u hu1)
        have hcomm : q ^ K * B_int = B_int * q ^ K := by ring
        linarith
      have hsum_lim : ∀ M : ℕ, ctends_to (fun (N : ℕ) => csum M (fun k => complex.mul (cint (fk k) 1 (1 + (N : ℝ))) (cpow_nat w k))) (csum M (fun k => complex.mul (a k) (cpow_nat w k)))
        intro M; induction M with m ihm
        · have h1 : (fun (N : ℕ) => csum 0 (fun k => complex.mul (cint (fk k) 1 (1 + (N : ℝ))) (cpow_nat w k))) = (fun _ => complex.zero) := by funext N; rw [csum.zero]
          rw [h1, csum.zero]; exact ctends_to.const complex.zero
        · rw [succ_eq_add_one.nat]
          have hm_l : ctends_to (fun (N : ℕ) => complex.mul (cint (fk m) 1 (1 + (N : ℝ))) (cpow_nat w m)) (complex.mul (a m) (cpow_nat w m))
            have h1 := ctends_to.const_mul (cpow_nat w m) (fun (N : ℕ) => cint (fk m) 1 (1 + (N : ℝ))) (a m) (ha_spec m).1
            have hf : (fun (N : ℕ) => complex.mul (cpow_nat w m) (cint (fk m) 1 (1 + (N : ℝ)))) = (fun (N : ℕ) => complex.mul (cint (fk m) 1 (1 + (N : ℝ))) (cpow_nat w m)) := by funext N; ring
            have hv : complex.mul (cpow_nat w m) (a m) = complex.mul (a m) (cpow_nat w m) := by ring
            rw [hf, hv] at h1; exact h1
          have hadd := ctends_to.add (fun (N : ℕ) => csum m (fun k => complex.mul (cint (fk k) 1 (1 + (N : ℝ))) (cpow_nat w k))) (fun (N : ℕ) => complex.mul (cint (fk m) 1 (1 + (N : ℝ))) (cpow_nat w m)) (csum m (fun k => complex.mul (a k) (cpow_nat w k))) (complex.mul (a m) (cpow_nat w m)) ihm hm_l
          have hf : (fun (N : ℕ) => complex.add (csum m (fun k => complex.mul (cint (fk k) 1 (1 + (N : ℝ))) (cpow_nat w k))) (complex.mul (cint (fk m) 1 (1 + (N : ℝ))) (cpow_nat w m))) = (fun (N : ℕ) => csum (m + 1) (fun k => complex.mul (cint (fk k) 1 (1 + (N : ℝ))) (cpow_nat w k))) := by funext N; rw [csum.succ]
          rw [hf, ← csum.succ m] at hadd; exact hadd
      have hFs : F s = clim (fun (N : ℕ) => cint (fun u => complex.mul (g u) (complex.exp (complex.smul (alpha * log u) (complex.sub s s0)))) 1 (1 + (N : ℝ))) := by rw [hF]
      have hF_lim : ctends_to (fun (N : ℕ) => cint fs 1 (1 + (N : ℝ))) (F s) := by rw [hFs, ← hw, ← hfs]; exact hF_imp.1
      have hdiff_l := ctends_to.sub (fun (N : ℕ) => cint fs 1 (1 + (N : ℝ))) (fun (N : ℕ) => csum K (fun k => complex.mul (cint (fk k) 1 (1 + (N : ℝ))) (cpow_nat w k))) (F s) (csum K (fun k => complex.mul (a k) (cpow_nat w k))) hF_lim (hsum_lim K)
      have habs_l := ctends_to.abs (fun (N : ℕ) => complex.sub (cint fs 1 (1 + (N : ℝ))) (csum K (fun k => complex.mul (cint (fk k) 1 (1 + (N : ℝ))) (cpow_nat w k)))) (complex.sub (F s) (csum K (fun k => complex.mul (a k) (cpow_nat w k)))) hdiff_l
      have hneg_l : tends_to (fun (N : ℕ) => -complex.abs (complex.sub (cint fs 1 (1 + (N : ℝ))) (csum K (fun k => complex.mul (cint (fk k) 1 (1 + (N : ℝ))) (cpow_nat w k))))) (-complex.abs (complex.sub (F s) (csum K (fun k => complex.mul (a k) (cpow_nat w k)))))
        unfold tends_to at habs_l ⊢; intro e he; obtain ⟨N0, hN0⟩ := habs_l e he; use N0; intro N hN
        have hre : -complex.abs (complex.sub (cint fs 1 (1 + (N : ℝ))) (csum K (fun k => complex.mul (cint (fk k) 1 (1 + (N : ℝ))) (cpow_nat w k)))) - -complex.abs (complex.sub (F s) (csum K (fun k => complex.mul (a k) (cpow_nat w k)))) = -(complex.abs (complex.sub (cint fs 1 (1 + (N : ℝ))) (csum K (fun k => complex.mul (cint (fk k) 1 (1 + (N : ℝ))) (cpow_nat w k)))) - complex.abs (complex.sub (F s) (csum K (fun k => complex.mul (a k) (cpow_nat w k))))) := by ring
        rw [hre, abs_neg_eq]; exact hN0 N hN
      have hge := tends_to.ge_of_ge (fun (N : ℕ) => -complex.abs (complex.sub (cint fs 1 (1 + (N : ℝ))) (csum K (fun k => complex.mul (cint (fk k) 1 (1 + (N : ℝ))) (cpow_nat w k))))) (-complex.abs (complex.sub (F s) (csum K (fun k => complex.mul (a k) (cpow_nat w k))))) (-(B_int * q ^ K)) hneg_l (by intro N; linarith [hN_err N])
      linarith
    have hqlim := geom_pow_tends_to_zero q hq0 hq1
    set B0 := B_int + 1 with hB0
    have hB0_pos : 0 < B0 := by rw [hB0]; linarith
    unfold ctends_to; unfold tends_to at hqlim
    intro e he
    obtain ⟨K0, hK0⟩ := hqlim (e / B0) (div_pos.real e B0 he hB0_pos)
    use K0; intro K hK
    have h1 := hK0 K hK
    have hsub0 : q ^ K - 0 = q ^ K := by ring
    rw [hsub0, abs_of_nonneg.real (q ^ K) (pow_nonneg.real q hq0 K)] at h1
    have hlt : B0 * q ^ K < e := by linarith [(lt_div_iff.real (q ^ K) e B0 hB0_pos).mp h1]
    have hm := mul_le_mul_of_nonneg_right.real B_int B0 (q ^ K) (by rw [hB0]; linarith) (pow_nonneg.real q hq0 K)
    have hcs_a : csum K (fun (k : ℕ) => complex.mul (clim (fun (N : ℕ) => cint (fun (u : ℝ) => complex.smul ((alpha * log u) ^ k / ((fact k : ℕ) : ℝ)) (g u)) 1 (1 + (N : ℝ)))) (cpow_nat w k)) = csum K (fun k => complex.mul (a k) (cpow_nat w k))
      apply csum.congr; intro k _
      have hak_eq : a k = clim (fun (N : ℕ) => cint (fun (u : ℝ) => complex.smul ((alpha * log u) ^ k / ((fact k : ℕ) : ℝ)) (g u)) 1 (1 + (N : ℝ))) := by rw [ha, hfk]
      rw [hak_eq]
    rw [complex.abs_sub_comm, hcs_a]
    linarith [hK_err K]

+ exp_mellin_int.is_cpower_series_at (g : ℝ → ℂ) (alpha : ℝ) (s0 : ℂ) (R C c : ℝ)
    (hR : 0 < R) (hC : 0 ≤ C) (hc : 0 < c)
    (hcont_re : ∀ u : ℝ, 1 ≤ u → continuous_at (fun x => complex.re (g x)) u)
    (hcont_im : ∀ u : ℝ, 1 ≤ u → continuous_at (fun x => complex.im (g x)) u)
    (hbd : ∀ u : ℝ, 1 ≤ u → complex.abs (g u) * exp (R * |alpha| * log u) ≤ C * exp (-c * u)) :
    is_cpower_series_at (fun s => clim (fun (N : ℕ) => cint (fun u => complex.mul (g u) (complex.exp (complex.smul (alpha * log u) (complex.sub s s0)))) 1 (1 + (N : ℝ)))) s0 (fun k => clim (fun (N : ℕ) => cint (fun u => complex.smul ((alpha * log u) ^ k / ((fact k : ℕ) : ℝ)) (g u)) 1 (1 + (N : ℝ)))) R
  apply majorized_mellin_int.is_cpower_series_at g (fun u => C * exp (-c * u)) alpha s0 R (C / c) hR (div_nonneg.real C c hC (by linarith)) hcont_re hcont_im hbd
  · intro f K hK hcr hci hf_bd
    have hf_bd' : ∀ u : ℝ, 1 ≤ u → complex.abs (f u) ≤ (K * C) * exp (-c * u)
      intro u hu; have hre : K * (C * exp (-c * u)) = (K * C) * exp (-c * u) := by ring
      linarith [hf_bd u hu]
    have himp := improper_cint.of_exp_bound f (K * C) c (mul_nonneg.real K C hK hC) hc hcr hci hf_bd'
    constructor; exact himp.1
    have hb1 := himp.2 1 (by decide)
    have hc11 : cint f 1 1 = complex.zero := cint.eq_of_has_integral f 1 1 complex.zero (by unfold c_has_integral; simp; exact ⟨darboux.point (fun x => complex.re (f x)) 1, darboux.point (fun x => complex.im (f x)) 1⟩)
    have hsub0 : complex.sub (clim (fun (N : ℕ) => cint f 1 (1 + (N : ℝ)))) complex.zero = clim (fun (N : ℕ) => cint f 1 (1 + (N : ℝ))) := by ring
    rw [hc11, hsub0] at hb1
    have he1 : exp (-c * 1) ≤ 1 := by have h := (exp_le_exp (-c * 1) 0).mpr (by linarith); rw [exp_zero] at h; exact h
    have hdiv_nn : 0 ≤ (K * C) / c := div_nonneg.real (K * C) c (mul_nonneg.real K C hK hC) (by linarith)
    have hm1 := mul_le_mul_of_nonneg_left.real (exp (-c * 1)) 1 ((K * C) / c) he1 hdiv_nn
    have hre : (K * C) / c = K * (C / c) := by field_simp
    linarith
  · intro B K hB1 hK
    use ((K * C) / c) * (exp (-c * 1) - exp (-c * B))
    constructor
    · have hcm : ∀ t, 1 ≤ t → t ≤ B → continuous_at (fun u => K * (C * exp (-c * u))) t := by intro t _ _; continuity
      have hdm : ∀ t, 1 ≤ t → t ≤ B → has_deriv_within (fun u => -((K * C) / c) * exp (-c * u)) (fun z => 1 ≤ z ∧ z ≤ B) t (K * (C * exp (-c * t)))
        intro t _ _
        set S := (fun (z : ℝ) => (1 : ℝ) ≤ z ∧ z ≤ B)
        have hlin : has_deriv_within (fun u => -c * u) S t (-c) := by simpa using has_deriv_within.scale (-c) (fun u => u) S t 1 (has_deriv_within.id S t)
        have hsc := has_deriv_within.scale (-((K * C) / c)) (fun u => exp (-c * u)) S t (exp (-c * t) * -c) (has_deriv_within.exp_comp (fun u => -c * u) S t (-c) hlin)
        have hv : -((K * C) / c) * (exp (-c * t) * -c) = K * (C * exp (-c * t)) := by field_simp
        rw [hv] at hsc; exact hsc
      have hftc := darboux.fundamental (fun u => -((K * C) / c) * exp (-c * u)) (fun u => K * (C * exp (-c * u))) 1 B hB1 hcm hdm
      have hv : -((K * C) / c) * exp (-c * B) - -((K * C) / c) * exp (-c * 1) = ((K * C) / c) * (exp (-c * 1) - exp (-c * B)) := by ring
      rw [hv] at hftc; exact hftc
    · have he1 : exp (-c * 1) ≤ 1 := by have h := (exp_le_exp (-c * 1) 0).mpr (by linarith); rw [exp_zero] at h; exact h
      have hsub_le1 : exp (-c * 1) - exp (-c * B) ≤ 1 := by linarith [exp_pos (-c * B)]
      have hm := mul_le_mul_of_nonneg_left.real (exp (-c * 1) - exp (-c * B)) 1 ((K * C) / c) hsub_le1 (div_nonneg.real (K * C) c (mul_nonneg.real K C hK hC) (by linarith))
      have hre : (K * C) / c = K * (C / c) := by field_simp
      linarith

-- 3c. Power-Decay Mellin Integral Analyticity Engine (handles Gamma on (0, 1] via u = 1/t AND Mellin integrals!):
+ improper_cint.of_rpow_bound (f : ℝ → ℂ) (C d : ℝ) (hC : 0 ≤ C) (hd : 0 < d)
    (hcr : ∀ u : ℝ, 1 ≤ u → continuous_at (fun x => complex.re (f x)) u)
    (hci : ∀ u : ℝ, 1 ≤ u → continuous_at (fun x => complex.im (f x)) u)
    (hbd : ∀ u : ℝ, 1 ≤ u → complex.abs (f u) ≤ C * rpow u (-d - 1)) :
    ctends_to (fun (N : ℕ) => cint f 1 (1 + (N : ℝ))) (clim (fun (N : ℕ) => cint f 1 (1 + (N : ℝ)))) ∧
    ∀ B : ℝ, 1 ≤ B → complex.abs (complex.sub (clim (fun (N : ℕ) => cint f 1 (1 + (N : ℝ)))) (cint f 1 B)) ≤ (C / d) * rpow B (-d)
  have hint : ∀ a b : ℝ, 1 ≤ a → a ≤ b → c_has_integral f a b (cint f a b) ∧ complex.abs (cint f a b) ≤ (C / d) * (rpow a (-d) - rpow b (-d))
    intro a b ha hab
    obtain ⟨Ir, hIr⟩ := darboux.continuous (fun x => complex.re (f x)) a b hab (by intro t h1 _; exact hcr t (by linarith))
    obtain ⟨Ii, hIi⟩ := darboux.continuous (fun x => complex.im (f x)) a b hab (by intro t h1 _; exact hci t (by linarith))
    have hI : c_has_integral f a b (complex.mk Ir Ii) := by unfold c_has_integral; simp; exact ⟨hIr, hIi⟩
    have heq := cint.eq_of_has_integral f a b (complex.mk Ir Ii) hI
    rw [heq]; constructor; exact hI
    have hrp := darboux.rpow_neg_power d a b (by linarith) hab
    have hsc := darboux.scale (fun x => d * rpow x (-d - 1)) a b (rpow a (-d) - rpow b (-d)) (C / d) hrp
    have hf_eq : (fun x => (C / d) * (d * rpow x (-d - 1))) = (fun x => C * rpow x (-d - 1)) := by funext x; field_simp
    rw [hf_eq] at hsc
    exact c_has_integral.abs_le_integral f (fun x => C * rpow x (-d - 1)) a b ((C / d) * (rpow a (-d) - rpow b (-d))) (complex.mk Ir Ii) hab hI hsc (by intro u h1 _; exact hbd u (by linarith))
  set blk := (fun (n : ℕ) => cint f (1 + (n : ℝ)) (1 + ((n + 1 : ℕ) : ℝ))) with hblk
  have htele : ∀ N : ℕ, cint f 1 (1 + (N : ℝ)) = csum N blk
    intro N; induction N with k ihk
    · rw [csum.zero]; have h10 : (1 : ℝ) + ((0 : ℕ) : ℝ) = 1 := by simp
      rw [h10]
      exact cint.eq_of_has_integral f 1 1 complex.zero (by unfold c_has_integral; simp; exact ⟨darboux.point (fun x => complex.re (f x)) 1, darboux.point (fun x => complex.im (f x)) 1⟩)
    · rw [succ_eq_add_one.nat, csum.succ, ← ihk, hblk]
      have hk1 : (1 : ℝ) + (k : ℝ) ≤ 1 + ((k + 1 : ℕ) : ℝ) := by rw [cast_add.real k 1]; simp; linarith
      have hI1 := (hint 1 (1 + (k : ℝ)) (by decide) (by linarith [cast_nonneg.real k])).1
      have hI2 := (hint (1 + (k : ℝ)) (1 + ((k + 1 : ℕ) : ℝ)) (by linarith [cast_nonneg.real k]) hk1).1
      exact cint.eq_of_has_integral f 1 (1 + ((k + 1 : ℕ) : ℝ)) (complex.add (cint f 1 (1 + (k : ℝ))) (cint f (1 + (k : ℝ)) (1 + ((k + 1 : ℕ) : ℝ)))) (c_has_integral.adjacent f 1 (1 + (k : ℝ)) (1 + ((k + 1 : ℕ) : ℝ)) (cint f 1 (1 + (k : ℝ))) (cint f (1 + (k : ℝ)) (1 + ((k + 1 : ℕ) : ℝ))) hI1 hI2)
  have hcs : csummable blk
    apply csummable.of_abs_summable
    apply summable.of_nonneg_le (fun n => complex.abs (blk n)) (fun n => C * pseries.term (d + 1) (n + 1))
    · intro n; exact complex.abs_nonneg (blk n)
    · intro n; rw [hblk]
      have h1n : (1 : ℝ) + (n : ℝ) = ((n + 1 : ℕ) : ℝ) := by rw [cast_add.real n 1]; simp; ring
      have h12 : n + 2 = (n + 1) + 1 := by omega
      have h2n : (1 : ℝ) + ((n + 1 : ℕ) : ℝ) = ((n + 2 : ℕ) : ℝ) := by rw [h12, cast_add.real (n + 1) 1]; simp; ring
      rw [h1n, h2n]
      have hb := (hint ((n + 1 : ℕ) : ℝ) ((n + 2 : ℕ) : ℝ) ((cast_le.real 1 (n + 1)).mpr (by omega)) ((cast_le.real (n + 1) (n + 2)).mpr (by omega))).2
      have hm := mul_le_mul_of_nonneg_left.real (rpow ((n + 1 : ℕ) : ℝ) (-d) - rpow ((n + 2 : ℕ) : ℝ) (-d)) (d * rpow ((n + 1 : ℕ) : ℝ) (-d - 1)) (C / d) (rpow.neg_step_diff_bound n d hd).2 (div_nonneg.real C d hC (by linarith))
      have hre : (C / d) * (d * rpow ((n + 1 : ℕ) : ℝ) (-d - 1)) = C * rpow ((n + 1 : ℕ) : ℝ) (-d - 1) := by field_simp
      have hpt : pseries.term (d + 1) (n + 1) = rpow ((n + 1 : ℕ) : ℝ) (-d - 1)
        unfold pseries.term; have hne0 : n + 1 ≠ 0 := by omega
        rw [if_neg hne0]; have he : -(d + 1) = -d - 1 := by ring; rw [he]
      rw [hpt]; linarith
    · exact pseries.scaled_shift_summable d C hd
  unfold csummable cconverges at hcs; obtain ⟨L, hL⟩ := hcs
  have hfe : (fun (N : ℕ) => cint f 1 (1 + (N : ℝ))) = (fun N => csum N blk) := by funext N; exact htele N
  rw [← hfe] at hL
  rw [clim.eq_of_tends_to (fun (N : ℕ) => cint f 1 (1 + (N : ℝ))) L hL]; constructor; exact hL
  intro B hB
  obtain ⟨M0, hM0⟩ := exists_nat_gt.real B
  have htail_N : ∀ N : ℕ, M0 ≤ N → complex.abs (complex.sub (cint f 1 (1 + (N : ℝ))) (cint f 1 B)) ≤ (C / d) * rpow B (-d)
    intro N hN
    have hBN : B ≤ 1 + (N : ℝ) := by linarith [(cast_le.real M0 N).mpr hN]
    have hadj := c_has_integral.adjacent f 1 B (1 + (N : ℝ)) (cint f 1 B) (cint f B (1 + (N : ℝ))) (hint 1 B (by decide) hB).1 (hint B (1 + (N : ℝ)) hB hBN).1
    have hu := c_has_integral.unique f 1 (1 + (N : ℝ)) (cint f 1 (1 + (N : ℝ))) (complex.add (cint f 1 B) (cint f B (1 + (N : ℝ)))) (hint 1 (1 + (N : ℝ)) (by decide) (by linarith)).1 hadj
    have hdiff : complex.sub (cint f 1 (1 + (N : ℝ))) (cint f 1 B) = cint f B (1 + (N : ℝ)) := by rw [hu]; ring
    rw [hdiff]
    have hm := mul_le_mul_of_nonneg_left.real (rpow B (-d) - rpow (1 + (N : ℝ)) (-d)) (rpow B (-d)) (C / d) (by linarith [rpow.pos (1 + (N : ℝ)) (-d)]) (div_nonneg.real C d hC (by linarith))
    linarith [(hint B (1 + (N : ℝ)) hB hBN).2]
  have hsh : ctends_to (fun k => complex.sub (cint f 1 (1 + ((M0 + k : ℕ) : ℝ))) (cint f 1 B)) (complex.sub L (cint f 1 B))
    have h1 := ctends_to.sub (fun (N : ℕ) => cint f 1 (1 + (N : ℝ))) (fun _ => cint f 1 B) L (cint f 1 B) hL (ctends_to.const (cint f 1 B))
    unfold ctends_to at h1 ⊢; intro e he; obtain ⟨N0, hN0⟩ := h1 e he; use N0; intro k hk; exact hN0 (M0 + k) (by omega)
  have habs_l := ctends_to.abs (fun k => complex.sub (cint f 1 (1 + ((M0 + k : ℕ) : ℝ))) (cint f 1 B)) (complex.sub L (cint f 1 B)) hsh
  have hneg_l : tends_to (fun k => -complex.abs (complex.sub (cint f 1 (1 + ((M0 + k : ℕ) : ℝ))) (cint f 1 B))) (-complex.abs (complex.sub L (cint f 1 B)))
    unfold tends_to at habs_l ⊢; intro e he; obtain ⟨N0, hN0⟩ := habs_l e he; use N0; intro k hk
    have hre : -complex.abs (complex.sub (cint f 1 (1 + ((M0 + k : ℕ) : ℝ))) (cint f 1 B)) - -complex.abs (complex.sub L (cint f 1 B)) = -(complex.abs (complex.sub (cint f 1 (1 + ((M0 + k : ℕ) : ℝ))) (cint f 1 B)) - complex.abs (complex.sub L (cint f 1 B))) := by ring
    rw [hre, abs_neg_eq]; exact hN0 k hk
  have hge := tends_to.ge_of_ge (fun k => -complex.abs (complex.sub (cint f 1 (1 + ((M0 + k : ℕ) : ℝ))) (cint f 1 B))) (-complex.abs (complex.sub L (cint f 1 B))) (-((C / d) * rpow B (-d))) hneg_l (by intro k; linarith [htail_N (M0 + k) (by omega)])
  linarith

+ rpow_mellin_int.is_cpower_series_at (g : ℝ → ℂ) (alpha : ℝ) (s0 : ℂ) (R C d : ℝ)
    (hR : 0 < R) (hC : 0 ≤ C) (hd : 0 < d)
    (hcont_re : ∀ u : ℝ, 1 ≤ u → continuous_at (fun x => complex.re (g x)) u)
    (hcont_im : ∀ u : ℝ, 1 ≤ u → continuous_at (fun x => complex.im (g x)) u)
    (hbd : ∀ u : ℝ, 1 ≤ u → complex.abs (g u) * exp (R * |alpha| * log u) ≤ C * rpow u (-d - 1)) :
    is_cpower_series_at (fun s => clim (fun (N : ℕ) => cint (fun u => complex.mul (g u) (complex.exp (complex.smul (alpha * log u) (complex.sub s s0)))) 1 (1 + (N : ℝ)))) s0 (fun k => clim (fun (N : ℕ) => cint (fun u => complex.smul ((alpha * log u) ^ k / ((fact k : ℕ) : ℝ)) (g u)) 1 (1 + (N : ℝ)))) R
  apply majorized_mellin_int.is_cpower_series_at g (fun u => C * rpow u (-d - 1)) alpha s0 R (C / d) hR (div_nonneg.real C d hC (by linarith)) hcont_re hcont_im hbd
  · intro f K hK hcr hci hf_bd
    have hf_bd' : ∀ u : ℝ, 1 ≤ u → complex.abs (f u) ≤ (K * C) * rpow u (-d - 1)
      intro u hu; have hre : K * (C * rpow u (-d - 1)) = (K * C) * rpow u (-d - 1) := by ring
      linarith [hf_bd u hu]
    have himp := improper_cint.of_rpow_bound f (K * C) d (mul_nonneg.real K C hK hC) hd hcr hci hf_bd'
    constructor; exact himp.1
    have hb1 := himp.2 1 (by decide)
    have hc11 : cint f 1 1 = complex.zero := cint.eq_of_has_integral f 1 1 complex.zero (by unfold c_has_integral; simp; exact ⟨darboux.point (fun x => complex.re (f x)) 1, darboux.point (fun x => complex.im (f x)) 1⟩)
    have hrp1 : rpow 1 (-d) = 1 := by unfold rpow; simp [log_one, exp_zero]
    have hsub0 : complex.sub (clim (fun (N : ℕ) => cint f 1 (1 + (N : ℝ)))) complex.zero = clim (fun (N : ℕ) => cint f 1 (1 + (N : ℝ))) := by ring
    rw [hc11, hrp1, hsub0] at hb1
    have hre : (K * C) / d = K * (C / d) := by field_simp
    linarith
  · intro B K hB1 hK
    use ((K * C) / d) * (1 - rpow B (-d))
    constructor
    · have hsc := darboux.scale (fun u => d * rpow u (-d - 1)) 1 B (rpow 1 (-d) - rpow B (-d)) ((K * C) / d) (darboux.rpow_neg_power d 1 B (by decide) hB1)
      have hrp1 : rpow 1 (-d) = 1 := by unfold rpow; simp [log_one, exp_zero]
      have hf_eq : (fun u => ((K * C) / d) * (d * rpow u (-d - 1))) = (fun u => K * (C * rpow u (-d - 1))) := by funext u; field_simp
      rw [hf_eq, hrp1] at hsc; exact hsc
    · have hm := mul_le_mul_of_nonneg_left.real (1 - rpow B (-d)) 1 ((K * C) / d) (by linarith [rpow.pos B (-d)]) (div_nonneg.real (K * C) d (mul_nonneg.real K C hK hC) (by linarith))
      have hre : (K * C) / d = K * (C / d) := by field_simp
      linarith

-- 3d. Entire Analyticity of `nt_mellin_int`, `classical_Lambda_nt`, `riemann_theta_tail_int`,
--     and Re(s) > 0 Analyticity of `classical_Lambda_triv_reg` & `gamma` & `classical_L_reg`!
+ nt_mellin_int.is_canalytic_at (psi : DChar) (hval : dchar.valid psi) (s0 : ℂ) :
    is_canalytic_at (nt_mellin_int psi) s0
  -- Match nt_mellin_integrand psi s u = nt_mellin_integrand psi s0 u * exp(((1/2) * log u) * (s - s0))!
  have hsp := nt_mellin_int.spec psi hval (complex.add s0 complex.one)
  have hsp0 := nt_mellin_int.spec psi hval s0
  obtain ⟨C, c, hC, hc, _⟩ := hsp.2.2
  -- Even cleaner: directly use |nt_mellin_integrand psi (s0 + 1) u| = |nt_mellin_integrand psi s0 u| * exp((1/2)*log u) <= C' * exp(-c' * u)!
  -- Note nt_mellin_int.spec doesn't directly expose the pointwise bound, so re-derive the 10-line pointwise bound from theta_char.spec_and_bounds?
  -- Actually we HAVE `nt_mellin_integrand psi s0 u` continuous on u >= 1 from hsp0.1, AND from M3.32/M3.33 let's check:
  -- For u >= 1, |theta_char psi u| <= C0 * exp(-2*c1*u) -- wait: `theta_char.spec_and_bounds` has `u`-dependent `r`!
  -- Wait: `nt_mellin_int.spec` gives `|cint ... 1 B - clim ...| <= (C/c) * exp(-c*B)`, NOT pointwise!
  -- Let's prove a 15-line uniform bound on `|theta_char psi u|` for `u >= 1` right here (or reuse `nt_mellin_int.spec` by noting:
  -- Wait: for any u >= 1, `|theta_char psi u| <= C0 * exp(-c0 * u)` where `c0 = pi / (2 * q)`, 25 lines using `theta_char.spec_and_bounds`?
  -- Even shorter: `nt_mellin_integrand psi (s0 + 1)` has `|theta_char psi u|` bounded by `C0 * exp(-2*c1*u)` in 20 lines!)
  have hpi_pos : 0 < pi := by linarith [pi_bounds.1]
  have hq_pos : 0 < psi.level := by have h := hval.1; omega
  set c1 := pi / (4 * (psi.level : ℝ)) with hc1
  have hc1_pos : 0 < c1 := by rw [hc1]; exact div_pos.real pi (4 * (psi.level : ℝ)) hpi_pos (by linarith)
  set r0 := exp (-(2 * c1)) with hr0
  have hr0_lt1 : r0 < 1 := by rw [hr0]; have h := (exp_lt_exp (-(2 * c1)) 0).mpr (by linarith); rw [exp_zero] at h; exact h
  set A0 := 1 + 1 / (2 * c1) with hA0
  have hA0_pos : 0 < A0 := by rw [hA0]; linarith [one_div_pos.real (2 * c1) (by linarith)]
  set C0 := A0 / (1 - r0) with hC0
  have hC0_pos : 0 < C0 := by rw [hC0]; exact div_pos.real A0 (1 - r0) hA0_pos (by linarith)
  have hth_bd : ∀ u : ℝ, 1 ≤ u → complex.abs (theta_char psi u) ≤ C0 * exp (-(2 * c1) * u)
    intro u hu
    set ru := exp (-(2 * c1) * u) with hru
    have hru_pos : 0 < ru := by rw [hru]; exact exp_pos (-(2 * c1) * u)
    have hru_le : ru ≤ r0 := by rw [hru, hr0]; exact (exp_le_exp (-(2 * c1) * u) (-(2 * c1))).mpr (by nlinarith)
    have hru_lt1 : ru < 1 := by linarith
    have hru_pow : ∀ m : ℕ, ru ^ m = exp (-(2 * c1) * u * (m : ℝ))
      intro m; induction m with j ihj
      · rw [pow_zero.real]; simp [exp_zero]
      · rw [succ_eq_add_one.nat, pow_succ.real, ihj, hru, ← exp_add, cast_add.real j 1]; simp
        have h1 : -(2 * c1) * u * (j : ℝ) + -(2 * c1) * u = -(2 * c1) * u * ((j : ℝ) + 1) := by ring
        rw [h1]
    have hterm : ∀ n : ℕ, complex.abs (theta_char_term psi u n) ≤ A0 * ru ^ (n + 1)
      intro n; unfold theta_char_term
      set m := ((n + 1 : ℕ) : ℝ) with hm
      have hm_ge1 : 1 ≤ m := by rw [hm]; exact (cast_le.real 1 (n + 1)).mpr (by omega)
      have h2c : 2 * c1 = pi / (2 * (psi.level : ℝ))
        rw [hc1, div_def.real pi (4 * (psi.level : ℝ)), div_def.real pi (2 * (psi.level : ℝ))]
        have hq4 := mul_inv_cancel.real (4 * (psi.level : ℝ)) (by linarith)
        have hq2 := mul_inv_cancel.real (2 * (psi.level : ℝ)) (by linarith)
        have h0 : (4 * (psi.level : ℝ)) * (2 * (1 / (4 * (psi.level : ℝ))) - 1 / (2 * (psi.level : ℝ))) = 0 := by linear_combination 2 * hq4 - 2 * hq2
        have heq : 2 * (1 / (4 * (psi.level : ℝ))) = 1 / (2 * (psi.level : ℝ)) := by linear_combination (1 / (4 * (psi.level : ℝ))) * h0 - (2 * (1 / (4 * (psi.level : ℝ))) - 1 / (2 * (psi.level : ℝ))) * hq4
        linear_combination pi * heq
      have hsplit : -pi * m * m * u / (psi.level : ℝ) = -(2 * c1) * u * (m * m) + -(2 * c1) * u * (m * m)
        rw [h2c, div_def.real (-pi * m * m * u) (psi.level : ℝ), div_def.real pi (2 * (psi.level : ℝ))]
        have hq1 := mul_inv_cancel.real (psi.level : ℝ) (by linarith)
        have hq2 := mul_inv_cancel.real (2 * (psi.level : ℝ)) (by linarith)
        have h0 : (2 * (psi.level : ℝ)) * (2 * (1 / (2 * (psi.level : ℝ))) - 1 / (psi.level : ℝ)) = 0 := by linear_combination 2 * hq2 - 2 * hq1
        have heq : 2 * (1 / (2 * (psi.level : ℝ))) = 1 / (psi.level : ℝ) := by linear_combination (1 / (2 * (psi.level : ℝ))) * h0 - (2 * (1 / (2 * (psi.level : ℝ))) - 1 / (psi.level : ℝ)) * hq2
        linear_combination (pi * m * m * u) * heq
      have he_half : exp (-(2 * c1) * u * (m * m)) ≤ ru ^ (n + 1)
        rw [hru_pow (n + 1), ← hm]
        have h2cu : 0 < (2 * c1) * u := mul_pos.real (2 * c1) u (by linarith) (by linarith)
        have hmul := mul_le_mul_of_nonneg_left.real m (m * m) ((2 * c1) * u) (by nlinarith) (by linarith)
        exact (exp_le_exp (-(2 * c1) * u * (m * m)) (-(2 * c1) * u * m)).mpr (by linarith)
      have hchi := dchar.abs_le_one psi hval (n + 1)
      rw [complex.abs_smul]
      by_cases hp1 : dchar.parity psi = 1
      · rw [if_pos hp1]
        have hnn := mul_nonneg.real m (exp (-pi * m * m * u / (psi.level : ℝ))) (by linarith) (by linarith [exp_pos (-pi * m * m * u / (psi.level : ℝ))])
        rw [abs_of_nonneg.real (m * exp (-pi * m * m * u / (psi.level : ℝ))) hnn]
        have hm1 := mul_le_mul_of_nonneg_left.real (complex.abs (psi.val (n + 1))) 1 (m * exp (-pi * m * m * u / (psi.level : ℝ))) hchi hnn
        rw [hsplit, exp_add] at hm1 ⊢
        have hme : m * exp (-(2 * c1) * u * (m * m)) ≤ 1 / (2 * c1)
          have hle1 : 2 * c1 * m ≤ 2 * c1 * u * (m * m)
            have h1 : m ≤ m * m := by nlinarith
            have h2 := mul_le_mul_of_nonneg_right.real 1 u (m * m) hu (by nlinarith)
            have h3 := mul_le_mul_of_nonneg_left.real m (u * (m * m)) (2 * c1) (by linarith) (by linarith)
            linarith
          have hle2 : 2 * c1 * m ≤ exp (2 * c1 * u * (m * m)) := by linarith [exp_ge_one_add (2 * c1 * u * (m * m))]
          have hinv : exp (-(2 * c1) * u * (m * m)) * exp (2 * c1 * u * (m * m)) = 1
            rw [← exp_add]; have h0 : -(2 * c1) * u * (m * m) + 2 * c1 * u * (m * m) = 0 := by ring
            rw [h0, exp_zero]
          have h3 := mul_le_mul_of_nonneg_right.real (2 * c1 * m) (exp (2 * c1 * u * (m * m))) (exp (-(2 * c1) * u * (m * m))) hle2 (by linarith [exp_pos (-(2 * c1) * u * (m * m))])
          have h4 := mul_le_mul_of_nonneg_right.real ((2 * c1 * m) * exp (-(2 * c1) * u * (m * m))) 1 (1 / (2 * c1)) (by linarith) (by linarith [one_div_pos.real (2 * c1) (by linarith)])
          have hc2 := mul_inv_cancel.real (2 * c1) (by linarith)
          have hre : (2 * c1 * m) * exp (-(2 * c1) * u * (m * m)) * (1 / (2 * c1)) = m * exp (-(2 * c1) * u * (m * m)) := by linear_combination (m * exp (-(2 * c1) * u * (m * m))) * hc2
          linarith
        have h2 := mul_le_mul_of_nonneg_right.real (m * exp (-(2 * c1) * u * (m * m))) A0 (exp (-(2 * c1) * u * (m * m))) (by rw [hA0]; linarith) (by linarith [exp_pos (-(2 * c1) * u * (m * m))])
        have h3 := mul_le_mul_of_nonneg_left.real (exp (-(2 * c1) * u * (m * m))) (ru ^ (n + 1)) A0 he_half (by linarith)
        linarith
      · rw [if_neg hp1]
        have hnn : 0 ≤ exp (-pi * m * m * u / (psi.level : ℝ)) := by linarith [exp_pos (-pi * m * m * u / (psi.level : ℝ))]
        rw [abs_of_nonneg.real (exp (-pi * m * m * u / (psi.level : ℝ))) hnn]
        have hm1 := mul_le_mul_of_nonneg_left.real (complex.abs (psi.val (n + 1))) 1 (exp (-pi * m * m * u / (psi.level : ℝ))) hchi hnn
        rw [hsplit, exp_add] at hm1 ⊢
        have he1 : exp (-(2 * c1) * u * (m * m)) ≤ A0
          have hpos_arg : 0 ≤ (2 * c1) * u * (m * m) := mul_nonneg.real ((2 * c1) * u) (m * m) (mul_nonneg.real (2 * c1) u (by linarith) (by linarith)) (by nlinarith)
          have h1 : exp (-(2 * c1) * u * (m * m)) ≤ 1 := by have h := (exp_le_exp (-(2 * c1) * u * (m * m)) 0).mpr (by linarith); rw [exp_zero] at h; exact h
          rw [hA0]; linarith [one_div_pos.real (2 * c1) (by linarith)]
        have h2 := mul_le_mul_of_nonneg_right.real (exp (-(2 * c1) * u * (m * m))) A0 (exp (-(2 * c1) * u * (m * m))) he1 (by linarith [exp_pos (-(2 * c1) * u * (m * m))])
        have h3 := mul_le_mul_of_nonneg_left.real (exp (-(2 * c1) * u * (m * m))) (ru ^ (n + 1)) A0 he_half (by linarith)
        linarith
    have hfin : ∀ N : ℕ, complex.abs (csum N (theta_char_term psi u)) ≤ C0 * exp (-(2 * c1) * u)
      intro N
      have h1 := csum.abs_le_sum N (theta_char_term psi u)
      have h2 := sum_le.real (fun n => complex.abs (theta_char_term psi u n)) (fun n => A0 * ru ^ (n + 1)) N (by intro n _; exact hterm n)
      have hsc : ∀ k : ℕ, (∑ n < k, A0 * ru ^ (n + 1)) = A0 * (∑ n < k, ru ^ (n + 1))
        intro k; induction k with l ihl
        · rw [sum_below_zero, sum_below_zero]; ring
        · rw [succ_eq_add_one.nat, sum_below_succ, sum_below_succ, ihl]; ring
      have hg := geom_sum_succ_le ru N (by linarith) hru_lt1
      have hdiv_le : ru / (1 - ru) ≤ ru / (1 - r0)
        have hm := mul_le_mul_of_nonneg_left.real (1 - r0) (1 - ru) (ru / (1 - ru)) (by linarith) (div_nonneg.real ru (1 - ru) (by linarith) (by linarith))
        have hcu := mul_inv_cancel.real (1 - ru) (by linarith)
        have hre : ru / (1 - ru) * (1 - ru) = ru := by rw [div_def.real ru (1 - ru)]; linear_combination ru * hcu
        exact (le_div_iff.real (ru / (1 - ru)) ru (1 - r0) (by linarith)).mpr (by linarith)
      have hm := mul_le_mul_of_nonneg_left.real (∑ n < N, ru ^ (n + 1)) (ru / (1 - r0)) A0 (by linarith) (by linarith)
      have hre : A0 * (ru / (1 - r0)) = C0 * exp (-(2 * c1) * u) := by rw [hC0, hru, div_def.real A0 (1 - r0), div_def.real (exp (-(2 * c1) * u)) (1 - r0)]; ring
      linarith [hsc N]
    have hlim := (theta_char.spec_and_bounds psi hval u (by linarith)).1
    have habs_l := ctends_to.abs (fun N => csum N (theta_char_term psi u)) (theta_char psi u) hlim
    have hneg_l : tends_to (fun N => -complex.abs (csum N (theta_char_term psi u))) (-complex.abs (theta_char psi u))
      unfold tends_to at habs_l ⊢; intro e he; obtain ⟨N0, hN0⟩ := habs_l e he; use N0; intro N hN
      have hre : -complex.abs (csum N (theta_char_term psi u)) - -complex.abs (theta_char psi u) = -(complex.abs (csum N (theta_char_term psi u)) - complex.abs (theta_char psi u)) := by ring
      rw [hre, abs_neg_eq]; exact hN0 N hN
    have hge := tends_to.ge_of_ge (fun N => -complex.abs (csum N (theta_char_term psi u))) (-complex.abs (theta_char psi u)) (-(C0 * exp (-(2 * c1) * u))) hneg_l (by intro N; linarith [hfin N])
    rw [← hru] at hge; linarith
  set w0 := complex.sub (complex.smul (1 / 2) (complex.add s0 (complex.of_real ((dchar.parity psi : ℕ) : ℝ)))) complex.one with hw0
  obtain ⟨K0, hK0⟩ := exists_nat_gt.real (max 1 (complex.re w0 + 1 / 2))
  have hK0_ge1 : 1 ≤ K0
    have h1 : (1 : ℝ) < (K0 : ℝ) := lt_of_le_of_lt.real 1 (max 1 (complex.re w0 + 1 / 2)) (K0 : ℝ) (le_max_left.real 1 (complex.re w0 + 1 / 2)) hK0
    by_contra hlt; have hz : K0 = 0 := by omega
    rw [hz] at h1; simp at h1
  have hre_le : complex.re w0 + 1 / 2 ≤ (K0 : ℝ) := by linarith [le_max_right.real 1 (complex.re w0 + 1 / 2)]
  obtain ⟨M, hM_pos, hM⟩ := pow_le_exp_const K0 hK0_ge1 c1 hc1_pos
  have hbd : ∀ u : ℝ, 1 ≤ u → complex.abs (nt_mellin_integrand psi s0 u) * exp (1 * |(1 / 2 : ℝ)| * log u) ≤ (C0 * M) * exp (-c1 * u)
    intro u hu
    rw [nt_mellin_integrand.unfold_eq, ← hw0, complex.abs_mul, abs_of_pos.real (1 / 2) (by decide)]
    have hap : complex.abs (cpow_real u w0) = rpow u (complex.re w0)
      have hsq : complex.abs (cpow_real u w0) * complex.abs (cpow_real u w0) = rpow u (complex.re w0) * rpow u (complex.re w0)
        rw [complex.abs_sq]; unfold complex.norm_sq cpow_real rpow; simp
        have h1 : log u * complex.re w0 = complex.re w0 * log u := by ring
        rw [h1]; linear_combination (exp (complex.re w0 * log u) * exp (complex.re w0 * log u)) * sin_sq_add_cos_sq (log u * complex.im w0)
      exact eq_of_sq_eq_nonneg (complex.abs (cpow_real u w0)) (rpow u (complex.re w0)) (complex.abs_nonneg (cpow_real u w0)) (by linarith [rpow.pos u (complex.re w0)]) hsq
    rw [hap]
    have hcomb : rpow u (complex.re w0) * exp (1 * (1 / 2) * log u) = rpow u (complex.re w0 + 1 / 2)
      unfold rpow; rw [← exp_add]
      have h1 : ∀ a b : ℝ, a = b → exp a = exp b := by intro a b hab; rw [hab]
      apply h1; ring
    have hpow_le : rpow u (complex.re w0 + 1 / 2) ≤ M * exp (c1 * u)
      have hpow_exp : u ^ K0 = exp ((K0 : ℝ) * log u)
        have hgen : ∀ m : ℕ, u ^ m = exp ((m : ℝ) * log u)
          intro m; induction m with j ihj
          · rw [pow_zero.real]; simp [exp_zero]
          · rw [succ_eq_add_one.nat, pow_succ.real, ihj, cast_add.real j 1]; simp
            have h1 : ((j : ℝ) + 1) * log u = (j : ℝ) * log u + log u := by ring
            rw [h1, exp_add, exp_log u (by linarith)]
        exact hgen K0
      have hle_uK : rpow u (complex.re w0 + 1 / 2) ≤ u ^ K0
        rw [hpow_exp]; unfold rpow
        exact (exp_le_exp ((complex.re w0 + 1 / 2) * log u) ((K0 : ℝ) * log u)).mpr (mul_le_mul_of_nonneg_right.real (complex.re w0 + 1 / 2) (K0 : ℝ) (log u) hre_le (log_nonneg u hu))
      linarith [hM u (by linarith)]
    have hre1 : complex.abs (theta_char psi u) * rpow u (complex.re w0) * exp (1 * (1 / 2) * log u) = complex.abs (theta_char psi u) * rpow u (complex.re w0 + 1 / 2) := by rw [← hcomb]; ring
    rw [hre1]
    have hm1 := mul_le_mul_of_nonneg_right.real (complex.abs (theta_char psi u)) (C0 * exp (-(2 * c1) * u)) (rpow u (complex.re w0 + 1 / 2)) (hth_bd u hu) (by linarith [rpow.pos u (complex.re w0 + 1 / 2)])
    have hm2 := mul_le_mul_of_nonneg_left.real (rpow u (complex.re w0 + 1 / 2)) (M * exp (c1 * u)) (C0 * exp (-(2 * c1) * u)) hpow_le (mul_nonneg.real C0 (exp (-(2 * c1) * u)) (by linarith) (by linarith [exp_pos (-(2 * c1) * u)]))
    have hexp_mul : exp (-(2 * c1) * u) * exp (c1 * u) = exp (-c1 * u)
      rw [← exp_add]; have h1 : -(2 * c1) * u + c1 * u = -c1 * u := by ring
      rw [h1]
    have hre2 : C0 * exp (-(2 * c1) * u) * (M * exp (c1 * u)) = (C0 * M) * (exp (-(2 * c1) * u) * exp (c1 * u)) := by ring
    rw [hre2, hexp_mul] at hm2; linarith
  have hps := exp_mellin_int.is_cpower_series_at (nt_mellin_integrand psi s0) (1 / 2) s0 1 (C0 * M) c1 (by decide) (mul_nonneg.real C0 M (by linarith) (by linarith)) hc1_pos (by intro u hu; exact (hsp0.1 u hu).1) (by intro u hu; exact (hsp0.1 u hu).2) hbd
  have hps_nt : is_cpower_series_at (nt_mellin_int psi) s0 (fun k => clim (fun (N : ℕ) => cint (fun u => complex.smul (((1 / 2) * log u) ^ k / ((fact k : ℕ) : ℝ)) (nt_mellin_integrand psi s0 u)) 1 (1 + (N : ℝ)))) 1
    apply is_cpower_series_at.congr (fun s => clim (fun (N : ℕ) => cint (fun u => complex.mul (nt_mellin_integrand psi s0 u) (complex.exp (complex.smul ((1 / 2) * log u) (complex.sub s s0)))) 1 (1 + (N : ℝ)))) (nt_mellin_int psi) s0 (fun k => clim (fun (N : ℕ) => cint (fun u => complex.smul (((1 / 2) * log u) ^ k / ((fact k : ℕ) : ℝ)) (nt_mellin_integrand psi s0 u)) 1 (1 + (N : ℝ)))) 1 hps
    intro s _; unfold nt_mellin_int
    have hcl : ∀ (a b : ℕ → ℂ), a = b → clim a = clim b := by intro a b hab; rw [hab]
    apply hcl; funext N
    have hci : ∀ (f g : ℝ → ℂ), f = g → cint f 1 (1 + (N : ℝ)) = cint g 1 (1 + (N : ℝ)) := by intro f g hfg; rw [hfg]
    apply hci; funext u
    rw [nt_mellin_integrand.unfold_eq, nt_mellin_integrand.unfold_eq]
    have hmul_assoc : ∀ (a b c : ℂ), complex.mul (complex.mul a b) c = complex.mul a (complex.mul b c)
      intro a b c; apply complex.ext <;> simp <;> ring
    rw [hmul_assoc]; unfold cpow_real; rw [← complex.exp_add]
    have hce : ∀ a b : ℂ, a = b → complex.mul (theta_char psi u) (complex.exp a) = complex.mul (theta_char psi u) (complex.exp b) := by intro a b hab; rw [hab]
    apply hce; apply complex.ext <;> simp <;> ring
  unfold is_canalytic_at
  exact ⟨(fun k => clim (fun (N : ℕ) => cint (fun u => complex.smul (((1 / 2) * log u) ^ k / ((fact k : ℕ) : ℝ)) (nt_mellin_integrand psi s0 u)) 1 (1 + (N : ℝ)))), 1, hps_nt⟩

+ classical_Lambda_nt.is_canalytic_at (psi : DChar) (hval : dchar.valid psi) (s0 : ℂ) :
    is_canalytic_at (classical_Lambda_nt psi) s0
  canalytic [classical_Lambda_nt]

+ riemann_theta_tail_int.is_canalytic_at (s0 : ℂ) :
    is_canalytic_at riemann_theta_tail_int s0
  -- Split riemann_theta_integrand s u = f1 s u + f2 s u where
  --   f1 s u = jacobi_psi u * u^(s/2 - 1), f2 s u = jacobi_psi u * u^((1-s)/2 - 1)!
  set g1 := (fun (u : ℝ) => complex.smul (jacobi_psi u) (cpow_real u (complex.sub (complex.smul (1 / 2) s0) complex.one))) with hg1
  set g2 := (fun (u : ℝ) => complex.smul (jacobi_psi u) (cpow_real u (complex.sub (complex.smul (1 / 2) (complex.sub complex.one s0)) complex.one))) with hg2
  have hpi_ge3 : 3 ≤ pi := by linarith [pi_bounds.1]
  have hepi_lt : exp (-pi) < 1 / 2
    have h1 : (2 : ℝ) < exp pi := by linarith [exp_ge_one_add pi]
    have hinv : exp (-pi) * exp pi = 1 := by rw [← exp_add]; have h0 : -pi + pi = 0 := by ring; rw [h0, exp_zero]
    linarith [mul_lt_mul_of_pos_left.real 2 (exp pi) (exp (-pi)) h1 (exp_pos (-pi))]
  have hpsi_bd : ∀ u : ℝ, 1 ≤ u → jacobi_psi u ≤ 2 * exp (-2 * u)
    intro u hu
    have hpsi := jacobi_psi.spec_and_bounds u (by linarith)
    have h1 : exp (-pi * u) ≤ exp (-pi) := (exp_le_exp (-pi * u) (-pi)).mpr (by nlinarith)
    have hdiv : exp (-pi * u) / (1 - exp (-pi * u)) ≤ 2 * exp (-pi * u) := (div_le_iff.real (exp (-pi * u)) (2 * exp (-pi * u)) (1 - exp (-pi * u)) (by linarith)).mpr (by nlinarith [exp_pos (-pi * u)])
    have he2 : exp (-pi * u) ≤ exp (-2 * u) := (exp_le_exp (-pi * u) (-2 * u)).mpr (by nlinarith)
    linarith [hpsi.2.2]
  have hmk_ana : ∀ (w0 : ℂ) (alpha : ℝ), |alpha| ≤ 1 →
      is_canalytic_at (fun s => clim (fun (N : ℕ) => cint (fun u => complex.mul (complex.smul (jacobi_psi u) (cpow_real u w0)) (complex.exp (complex.smul (alpha * log u) (complex.sub s s0)))) 1 (1 + (N : ℝ)))) s0
    intro w0 alpha halpha
    obtain ⟨K0, hK0⟩ := exists_nat_gt.real (max 1 (complex.re w0 + 1))
    have hK0_ge1 : 1 ≤ K0
      have h1 : (1 : ℝ) < (K0 : ℝ) := lt_of_le_of_lt.real 1 (max 1 (complex.re w0 + 1)) (K0 : ℝ) (le_max_left.real 1 (complex.re w0 + 1)) hK0
      by_contra hlt; have hz : K0 = 0 := by omega
      rw [hz] at h1; simp at h1
    have hre_le : complex.re w0 + 1 ≤ (K0 : ℝ) := by linarith [le_max_right.real 1 (complex.re w0 + 1)]
    obtain ⟨M, hM_pos, hM⟩ := pow_le_exp_const K0 hK0_ge1 1 (by decide)
    have hcont : ∀ u : ℝ, 1 ≤ u → continuous_at (fun x => complex.re (complex.smul (jacobi_psi x) (cpow_real x w0))) u ∧ continuous_at (fun x => complex.im (complex.smul (jacobi_psi x) (cpow_real x w0))) u
      intro u hu
      have hcp := jacobi_psi.continuous_on_pos 1 (by decide) u hu
      have hcw := cpow_real.continuous_re_im w0 u (by linarith)
      continuity
    have hbd : ∀ u : ℝ, 1 ≤ u → complex.abs (complex.smul (jacobi_psi u) (cpow_real u w0)) * exp (1 * |alpha| * log u) ≤ (2 * M) * exp (-1 * u)
      intro u hu
      have hpsi_sp := jacobi_psi.spec_and_bounds u (by linarith)
      have hpsi_nn := hpsi_sp.2.1
      rw [complex.abs_smul, abs_of_nonneg.real (jacobi_psi u) hpsi_nn]
      have hap : complex.abs (cpow_real u w0) = rpow u (complex.re w0)
        have hsq : complex.abs (cpow_real u w0) * complex.abs (cpow_real u w0) = rpow u (complex.re w0) * rpow u (complex.re w0)
          rw [complex.abs_sq]; unfold complex.norm_sq cpow_real rpow; simp
          have h1 : log u * complex.re w0 = complex.re w0 * log u := by ring
          rw [h1]; linear_combination (exp (complex.re w0 * log u) * exp (complex.re w0 * log u)) * sin_sq_add_cos_sq (log u * complex.im w0)
        exact eq_of_sq_eq_nonneg (complex.abs (cpow_real u w0)) (rpow u (complex.re w0)) (complex.abs_nonneg (cpow_real u w0)) (by linarith [rpow.pos u (complex.re w0)]) hsq
      rw [hap]
      have hlu_nn : 0 ≤ log u := log_nonneg u hu
      have hcomb : rpow u (complex.re w0) * exp (1 * |alpha| * log u) ≤ rpow u (complex.re w0 + 1)
        unfold rpow; rw [← exp_add]
        have hm := mul_le_mul_of_nonneg_right.real (|alpha|) 1 (log u) halpha hlu_nn
        exact (exp_le_exp (complex.re w0 * log u + 1 * |alpha| * log u) ((complex.re w0 + 1) * log u)).mpr (by linarith)
      have hpow_le : rpow u (complex.re w0 + 1) ≤ M * exp (1 * u)
        have hpow_exp : u ^ K0 = exp ((K0 : ℝ) * log u)
          have hgen : ∀ m : ℕ, u ^ m = exp ((m : ℝ) * log u)
            intro m; induction m with j ihj
            · rw [pow_zero.real]; simp [exp_zero]
            · rw [succ_eq_add_one.nat, pow_succ.real, ihj, cast_add.real j 1]; simp
              have h1 : ((j : ℝ) + 1) * log u = (j : ℝ) * log u + log u := by ring
              rw [h1, exp_add, exp_log u (by linarith)]
          exact hgen K0
        have hle_uK : rpow u (complex.re w0 + 1) ≤ u ^ K0
          rw [hpow_exp]; unfold rpow
          exact (exp_le_exp ((complex.re w0 + 1) * log u) ((K0 : ℝ) * log u)).mpr (mul_le_mul_of_nonneg_right.real (complex.re w0 + 1) (K0 : ℝ) (log u) hre_le hlu_nn)
        linarith [hM u (by linarith)]
      have hre1 : jacobi_psi u * rpow u (complex.re w0) * exp (1 * |alpha| * log u) = jacobi_psi u * (rpow u (complex.re w0) * exp (1 * |alpha| * log u)) := by ring
      rw [hre1]
      have hm1 := mul_le_mul_of_nonneg_left.real (rpow u (complex.re w0) * exp (1 * |alpha| * log u)) (M * exp (1 * u)) (jacobi_psi u) (by linarith) hpsi_nn
      have hm2 := mul_le_mul_of_nonneg_right.real (jacobi_psi u) (2 * exp (-2 * u)) (M * exp (1 * u)) (hpsi_bd u hu) (mul_nonneg.real M (exp (1 * u)) (by linarith) (by linarith [exp_pos (1 * u)]))
      have hexp_m : exp (-2 * u) * exp (1 * u) = exp (-1 * u) := by rw [← exp_add]; have h1 : -2 * u + 1 * u = -1 * u := by ring; rw [h1]
      have hre2 : 2 * exp (-2 * u) * (M * exp (1 * u)) = (2 * M) * (exp (-2 * u) * exp (1 * u)) := by ring
      rw [hre2, hexp_m] at hm2; linarith
    unfold is_canalytic_at
    use (fun k => clim (fun (N : ℕ) => cint (fun u => complex.smul ((alpha * log u) ^ k / ((fact k : ℕ) : ℝ)) (complex.smul (jacobi_psi u) (cpow_real u w0))) 1 (1 + (N : ℝ))))
    use 1
    exact exp_mellin_int.is_cpower_series_at (fun u => complex.smul (jacobi_psi u) (cpow_real u w0)) alpha s0 1 (2 * M) 1 (by decide) (by linarith) (by decide) (by intro u hu; exact (hcont u hu).1) (by intro u hu; exact (hcont u hu).2) hbd
  have ha1 := hmk_ana (complex.sub (complex.smul (1 / 2) s0) complex.one) (1 / 2) (by rw [abs_of_pos.real (1 / 2) (by decide)]; linarith)
  have ha2 := hmk_ana (complex.sub (complex.smul (1 / 2) (complex.sub complex.one s0)) complex.one) (-(1 / 2)) (by rw [abs_neg_eq, abs_of_pos.real (1 / 2) (by decide)]; linarith)
  set F1 := (fun (s : ℂ) => clim (fun (N : ℕ) => cint (fun u => complex.mul (complex.smul (jacobi_psi u) (cpow_real u (complex.sub (complex.smul (1 / 2) s0) complex.one))) (complex.exp (complex.smul ((1 / 2) * log u) (complex.sub s s0)))) 1 (1 + (N : ℝ)))) with hF1
  set F2 := (fun (s : ℂ) => clim (fun (N : ℕ) => cint (fun u => complex.mul (complex.smul (jacobi_psi u) (cpow_real u (complex.sub (complex.smul (1 / 2) (complex.sub complex.one s0)) complex.one))) (complex.exp (complex.smul ((-(1 / 2)) * log u) (complex.sub s s0)))) 1 (1 + (N : ℝ)))) with hF2
  have hsum := is_canalytic_at.add F1 F2 s0 ha1 ha2
  -- Show F1 s + F2 s = riemann_theta_tail_int s on |s - s0| < 1!
  apply is_canalytic_at.congr (fun s => complex.add (F1 s) (F2 s)) riemann_theta_tail_int s0 1 (by decide) hsum
  intro s hs
  set f1 := (fun (u : ℝ) => complex.mul (complex.smul (jacobi_psi u) (cpow_real u (complex.sub (complex.smul (1 / 2) s0) complex.one))) (complex.exp (complex.smul ((1 / 2) * log u) (complex.sub s s0)))) with hf1
  set f2 := (fun (u : ℝ) => complex.mul (complex.smul (jacobi_psi u) (cpow_real u (complex.sub (complex.smul (1 / 2) (complex.sub complex.one s0)) complex.one))) (complex.exp (complex.smul ((-(1 / 2)) * log u) (complex.sub s s0)))) with hf2
  have hadd_pt : ∀ u : ℝ, complex.add (f1 u) (f2 u) = riemann_theta_integrand s u
    intro u; rw [hf1, hf2]
    have h1 : complex.mul (complex.smul (jacobi_psi u) (cpow_real u (complex.sub (complex.smul (1 / 2) s0) complex.one))) (complex.exp (complex.smul ((1 / 2) * log u) (complex.sub s s0))) = complex.smul (jacobi_psi u) (cpow_real u (complex.sub (complex.smul (1 / 2) s) complex.one))
      have ha : complex.mul (complex.smul (jacobi_psi u) (cpow_real u (complex.sub (complex.smul (1 / 2) s0) complex.one))) (complex.exp (complex.smul ((1 / 2) * log u) (complex.sub s s0))) = complex.smul (jacobi_psi u) (complex.mul (cpow_real u (complex.sub (complex.smul (1 / 2) s0) complex.one)) (complex.exp (complex.smul ((1 / 2) * log u) (complex.sub s s0))))
        apply complex.ext <;> simp <;> ring
      rw [ha]; unfold cpow_real; rw [← complex.exp_add]
      have hce : ∀ a b : ℂ, a = b → complex.smul (jacobi_psi u) (complex.exp a) = complex.smul (jacobi_psi u) (complex.exp b) := by intro a b hab; rw [hab]
      apply hce; apply complex.ext <;> simp <;> ring
    have h2 : complex.mul (complex.smul (jacobi_psi u) (cpow_real u (complex.sub (complex.smul (1 / 2) (complex.sub complex.one s0)) complex.one))) (complex.exp (complex.smul ((-(1 / 2)) * log u) (complex.sub s s0))) = complex.smul (jacobi_psi u) (cpow_real u (complex.sub (complex.smul (1 / 2) (complex.sub complex.one s)) complex.one))
      have ha : complex.mul (complex.smul (jacobi_psi u) (cpow_real u (complex.sub (complex.smul (1 / 2) (complex.sub complex.one s0)) complex.one))) (complex.exp (complex.smul ((-(1 / 2)) * log u) (complex.sub s s0))) = complex.smul (jacobi_psi u) (complex.mul (cpow_real u (complex.sub (complex.smul (1 / 2) (complex.sub complex.one s0)) complex.one)) (complex.exp (complex.smul ((-(1 / 2)) * log u) (complex.sub s s0))))
        apply complex.ext <;> simp <;> ring
      rw [ha]; unfold cpow_real; rw [← complex.exp_add]
      have hce : ∀ a b : ℂ, a = b → complex.smul (jacobi_psi u) (complex.exp a) = complex.smul (jacobi_psi u) (complex.exp b) := by intro a b hab; rw [hab]
      apply hce; apply complex.ext <;> simp <;> ring
    rw [h1, h2]; unfold riemann_theta_integrand
    have hdist : ∀ (a b c d : ℂ), a = c → b = d → complex.add (complex.smul (jacobi_psi u) a) (complex.smul (jacobi_psi u) b) = complex.smul (jacobi_psi u) (complex.add c d)
      intro a b c d hac hbd; rw [hac, hbd]; apply complex.ext <;> simp <;> ring
    apply hdist
    · apply complex.ext <;> simp <;> ring
    · apply complex.ext <;> simp <;> ring
  -- Shared continuity & improper convergence for u |-> jacobi_psi u * u^w on [1, inf):
  have hpsi_cpow : ∀ (f : ℝ → ℂ) (w : ℂ),
      (∀ u : ℝ, f u = complex.smul (jacobi_psi u) (cpow_real u w)) →
      (∀ u : ℝ, 1 ≤ u → continuous_at (fun x => complex.re (f x)) u ∧ continuous_at (fun x => complex.im (f x)) u) ∧
      ctends_to (fun (N : ℕ) => cint f 1 (1 + (N : ℝ))) (clim (fun (N : ℕ) => cint f 1 (1 + (N : ℝ))))
    intro f w hfeq
    have hf_fn : f = (fun x => complex.smul (jacobi_psi x) (cpow_real x w)) := by funext x; exact hfeq x
    have hc_re_im : ∀ u : ℝ, 1 ≤ u → continuous_at (fun x => complex.re (f x)) u ∧ continuous_at (fun x => complex.im (f x)) u
      intro u hu; rw [hf_fn]
      have hcp := jacobi_psi.continuous_on_pos 1 (by decide) u hu
      have hcw := cpow_real.continuous_re_im w u (by linarith)
      continuity
    constructor; exact hc_re_im
    obtain ⟨K1, hK1⟩ := exists_nat_gt.real (max 1 (complex.re w))
    have hK1_1 : 1 ≤ K1
      have h1 : (1 : ℝ) < (K1 : ℝ) := lt_of_le_of_lt.real 1 (max 1 (complex.re w)) (K1 : ℝ) (le_max_left.real 1 (complex.re w)) hK1
      by_contra hlt; have hz : K1 = 0 := by omega; rw [hz] at h1; simp at h1
    obtain ⟨M1, hM1_p, hM1⟩ := pow_le_exp_const K1 hK1_1 1 (by decide)
    have hf_bd : ∀ u : ℝ, 1 ≤ u → complex.abs (f u) ≤ (2 * M1) * exp (-1 * u)
      intro u hu
      have hpsi_sp1 := jacobi_psi.spec_and_bounds u (by linarith)
      rw [hfeq u, complex.abs_smul, abs_of_nonneg.real (jacobi_psi u) hpsi_sp1.2.1]
      have hap : complex.abs (cpow_real u w) = rpow u (complex.re w)
        have hsq : complex.abs (cpow_real u w) * complex.abs (cpow_real u w) = rpow u (complex.re w) * rpow u (complex.re w)
          rw [complex.abs_sq]; unfold complex.norm_sq cpow_real rpow; simp
          have h1 : log u * complex.re w = complex.re w * log u := by ring
          rw [h1]; linear_combination (exp (complex.re w * log u) * exp (complex.re w * log u)) * sin_sq_add_cos_sq (log u * complex.im w)
        exact eq_of_sq_eq_nonneg (complex.abs (cpow_real u w)) (rpow u (complex.re w)) (complex.abs_nonneg (cpow_real u w)) (by linarith [rpow.pos u (complex.re w)]) hsq
      rw [hap]
      have hpow_exp : u ^ K1 = exp ((K1 : ℝ) * log u)
        have hgen : ∀ m : ℕ, u ^ m = exp ((m : ℝ) * log u)
          intro m; induction m with j ihj
          · rw [pow_zero.real]; simp [exp_zero]
          · rw [succ_eq_add_one.nat, pow_succ.real, ihj, cast_add.real j 1]; simp
            have h1 : ((j : ℝ) + 1) * log u = (j : ℝ) * log u + log u := by ring
            rw [h1, exp_add, exp_log u (by linarith)]
        exact hgen K1
      have hle_uK : rpow u (complex.re w) ≤ M1 * exp (1 * u)
        have h1 : rpow u (complex.re w) ≤ u ^ K1 := by rw [hpow_exp]; unfold rpow; exact (exp_le_exp (complex.re w * log u) ((K1 : ℝ) * log u)).mpr (mul_le_mul_of_nonneg_right.real (complex.re w) (K1 : ℝ) (log u) (by linarith [le_max_right.real 1 (complex.re w)]) (log_nonneg u hu))
        linarith [hM1 u (by linarith)]
      have hm1 := mul_le_mul_of_nonneg_left.real (rpow u (complex.re w)) (M1 * exp (1 * u)) (jacobi_psi u) hle_uK hpsi_sp1.2.1
      have hm2 := mul_le_mul_of_nonneg_right.real (jacobi_psi u) (2 * exp (-2 * u)) (M1 * exp (1 * u)) (hpsi_bd u hu) (mul_nonneg.real M1 (exp (1 * u)) (by linarith) (by linarith [exp_pos (1 * u)]))
      have hexp_m : exp (-2 * u) * exp (1 * u) = exp (-1 * u) := by rw [← exp_add]; have h1 : -2 * u + 1 * u = -1 * u := by ring; rw [h1]
      have hre2 : 2 * exp (-2 * u) * (M1 * exp (1 * u)) = (2 * M1) * (exp (-2 * u) * exp (1 * u)) := by ring
      rw [hre2, hexp_m] at hm2; linarith
    exact (improper_cint.of_exp_bound f (2 * M1) 1 (by linarith) (by decide) (by intro u hu; exact (hc_re_im u hu).1) (by intro u hu; exact (hc_re_im u hu).2) hf_bd).1
  have hce_smul : ∀ u : ℝ, ∀ a b : ℂ, a = b → complex.smul (jacobi_psi u) (complex.exp a) = complex.smul (jacobi_psi u) (complex.exp b) := by intro u a b hab; rw [hab]
  have hf1_eq : ∀ u, f1 u = complex.smul (jacobi_psi u) (cpow_real u (complex.sub (complex.smul (1 / 2) s) complex.one))
    intro u; rw [hf1]
    have ha : complex.mul (complex.smul (jacobi_psi u) (cpow_real u (complex.sub (complex.smul (1 / 2) s0) complex.one))) (complex.exp (complex.smul ((1 / 2) * log u) (complex.sub s s0))) = complex.smul (jacobi_psi u) (complex.mul (cpow_real u (complex.sub (complex.smul (1 / 2) s0) complex.one)) (complex.exp (complex.smul ((1 / 2) * log u) (complex.sub s s0)))) := by ring
    rw [ha]; unfold cpow_real; rw [← complex.exp_add]; apply hce_smul u; ring
  have hf2_eq : ∀ u, f2 u = complex.smul (jacobi_psi u) (cpow_real u (complex.sub (complex.smul (1 / 2) (complex.sub complex.one s)) complex.one))
    intro u; rw [hf2]
    have ha : complex.mul (complex.smul (jacobi_psi u) (cpow_real u (complex.sub (complex.smul (1 / 2) (complex.sub complex.one s0)) complex.one))) (complex.exp (complex.smul ((-(1 / 2)) * log u) (complex.sub s s0))) = complex.smul (jacobi_psi u) (complex.mul (cpow_real u (complex.sub (complex.smul (1 / 2) (complex.sub complex.one s0)) complex.one)) (complex.exp (complex.smul ((-(1 / 2)) * log u) (complex.sub s s0)))) := by ring
    rw [ha]; unfold cpow_real; rw [← complex.exp_add]; apply hce_smul u; ring
  have hp1 := hpsi_cpow f1 (complex.sub (complex.smul (1 / 2) s) complex.one) hf1_eq
  have hp2 := hpsi_cpow f2 (complex.sub (complex.smul (1 / 2) (complex.sub complex.one s)) complex.one) hf2_eq
  have h1_c := hp1.1
  have h2_c := hp2.1
  have h1_lim := hp1.2
  have h2_lim := hp2.2
  have hadd_lim := ctends_to.add (fun (N : ℕ) => cint f1 1 (1 + (N : ℝ))) (fun (N : ℕ) => cint f2 1 (1 + (N : ℝ))) (clim (fun (N : ℕ) => cint f1 1 (1 + (N : ℝ)))) (clim (fun (N : ℕ) => cint f2 1 (1 + (N : ℝ)))) h1_lim h2_lim
  have hsum_eq : (fun (N : ℕ) => complex.add (cint f1 1 (1 + (N : ℝ))) (cint f2 1 (1 + (N : ℝ)))) = (fun (N : ℕ) => cint (riemann_theta_integrand s) 1 (1 + (N : ℝ)))
    funext N
    have hB1 : 1 ≤ 1 + (N : ℝ) := by linarith [cast_nonneg.real N]
    obtain ⟨I1r, hI1r⟩ := darboux.continuous (fun x => complex.re (f1 x)) 1 (1 + (N : ℝ)) hB1 (by intro t h1 h2; exact (h1_c t h1).1)
    obtain ⟨I1i, hI1i⟩ := darboux.continuous (fun x => complex.im (f1 x)) 1 (1 + (N : ℝ)) hB1 (by intro t h1 h2; exact (h1_c t h1).2)
    have hI1 : c_has_integral f1 1 (1 + (N : ℝ)) (cint f1 1 (1 + (N : ℝ)))
      have hI : c_has_integral f1 1 (1 + (N : ℝ)) (complex.mk I1r I1i) := by unfold c_has_integral; simp; exact ⟨hI1r, hI1i⟩
      rw [cint.eq_of_has_integral f1 1 (1 + (N : ℝ)) (complex.mk I1r I1i) hI]; exact hI
    obtain ⟨I2r, hI2r⟩ := darboux.continuous (fun x => complex.re (f2 x)) 1 (1 + (N : ℝ)) hB1 (by intro t h1 h2; exact (h2_c t h1).1)
    obtain ⟨I2i, hI2i⟩ := darboux.continuous (fun x => complex.im (f2 x)) 1 (1 + (N : ℝ)) hB1 (by intro t h1 h2; exact (h2_c t h1).2)
    have hI2 : c_has_integral f2 1 (1 + (N : ℝ)) (cint f2 1 (1 + (N : ℝ)))
      have hI : c_has_integral f2 1 (1 + (N : ℝ)) (complex.mk I2r I2i) := by unfold c_has_integral; simp; exact ⟨hI2r, hI2i⟩
      rw [cint.eq_of_has_integral f2 1 (1 + (N : ℝ)) (complex.mk I2r I2i) hI]; exact hI
    have hIa := c_has_integral.add f1 f2 1 (1 + (N : ℝ)) (cint f1 1 (1 + (N : ℝ))) (cint f2 1 (1 + (N : ℝ))) hI1 hI2
    have hIc := c_has_integral.congr (fun u => complex.add (f1 u) (f2 u)) (riemann_theta_integrand s) 1 (1 + (N : ℝ)) (complex.add (cint f1 1 (1 + (N : ℝ))) (cint f2 1 (1 + (N : ℝ)))) hIa (by intro u _ _; exact hadd_pt u)
    exact (cint.eq_of_has_integral (riemann_theta_integrand s) 1 (1 + (N : ℝ)) (complex.add (cint f1 1 (1 + (N : ℝ))) (cint f2 1 (1 + (N : ℝ)))) hIc).symm
  rw [hsum_eq] at hadd_lim
  have hF1s : F1 s = clim (fun (N : ℕ) => cint f1 1 (1 + (N : ℝ))) := by rw [hF1, hf1]
  have hF2s : F2 s = clim (fun (N : ℕ) => cint f2 1 (1 + (N : ℝ))) := by rw [hF2, hf2]
  rw [hF1s, hF2s]
  exact ctends_to.unique (fun (N : ℕ) => cint (riemann_theta_integrand s) 1 (1 + (N : ℝ))) (complex.add (clim (fun (N : ℕ) => cint f1 1 (1 + (N : ℝ)))) (clim (fun (N : ℕ) => cint f2 1 (1 + (N : ℝ))))) (riemann_theta_tail_int s) hadd_lim (riemann_theta_tail_int.spec s)

-- Regularized completed zeta: (s - 1) * classical_Lambda_triv s = -(s - 1)/s + 1 + (s - 1) * riemann_theta_tail_int s!
-> classical_Lambda_triv_reg (s : ℂ) : ℂ :=
  complex.add (complex.add (complex.neg (complex.mul (complex.sub s complex.one) (complex.inv s))) complex.one)
    (complex.mul (complex.sub s complex.one) (riemann_theta_tail_int s))

+ classical_Lambda_triv_reg.at_one : classical_Lambda_triv_reg complex.one = complex.one
  unfold classical_Lambda_triv_reg; rw [complex.sub_self, complex.zero_mul, complex.zero_mul]
  apply complex.ext <;> simp

+ classical_Lambda_triv_reg.eq_mul (s : ℂ) (hs1 : s ≠ complex.one) :
    classical_Lambda_triv_reg s = complex.mul (complex.sub s complex.one) (classical_Lambda_triv s)
  unfold classical_Lambda_triv_reg classical_Lambda_triv
  have h1s_ne : complex.sub complex.one s ≠ complex.zero
    intro h0; apply hs1; apply complex.ext
    · have hr : complex.re (complex.sub complex.one s) = complex.re complex.zero := by rw [h0]
      simp at hr ⊢; linarith
    · have hi : complex.im (complex.sub complex.one s) = complex.im complex.zero := by rw [h0]
      simp at hi ⊢; linarith
  have hc := complex.mul_inv_cancel (complex.sub complex.one s) h1s_ne
  have hterm : complex.mul (complex.sub s complex.one) (complex.neg (complex.inv (complex.sub complex.one s))) = complex.one
    have hre : complex.mul (complex.sub s complex.one) (complex.neg (complex.inv (complex.sub complex.one s))) = complex.mul (complex.sub complex.one s) (complex.inv (complex.sub complex.one s))
      apply complex.ext <;> simp <;> ring
    rw [hre, hc]
  have hdist : complex.mul (complex.sub s complex.one) (complex.add (complex.sub (complex.neg (complex.inv s)) (complex.inv (complex.sub complex.one s))) (riemann_theta_tail_int s)) = complex.add (complex.add (complex.neg (complex.mul (complex.sub s complex.one) (complex.inv s))) (complex.mul (complex.sub s complex.one) (complex.neg (complex.inv (complex.sub complex.one s))))) (complex.mul (complex.sub s complex.one) (riemann_theta_tail_int s)) := by ring
  rw [hdist, hterm]

+ classical_Lambda_triv_reg.is_canalytic_at_re_pos (s0 : ℂ) (hs0 : 0 < complex.re s0) :
    is_canalytic_at classical_Lambda_triv_reg s0
  canalytic [classical_Lambda_triv_reg]

-- 3e. Full Half-Plane Re(w) > 0 Analyticity of Weierstrass-Gauss `gamma` (0 axioms!)
+ gamma.is_canalytic_at_re_pos (w0 : ℂ) (hw0 : 0 < complex.re w0) :
    is_canalytic_at gamma w0
  -- Split gamma(w) = G_small(w) + G_large(w) on |w - w0| < Re(w0) / 2:
  --   G_small(w) = int_1^inf exp(-1/u) * u^(-w - 1) du  (via u = 1/t from int_0^1 t^(w-1) e^(-t) dt, `rpow_mellin_int`!)
  --   G_large(w) = int_1^inf exp(-u) * u^(w - 1) du     (`exp_mellin_int`!)
  set R := complex.re w0 / 2 with hR
  have hR_pos : 0 < R := by rw [hR]; linarith
  -- Part 1: G_small(w) analytic at w0 with radius R!
  set gs := (fun (u : ℝ) => complex.smul (exp (-(1 / u))) (cpow_real u (complex.neg (complex.add w0 complex.one)))) with hgs
  have hgs_cont : ∀ u : ℝ, 1 ≤ u → continuous_at (fun x => complex.re (gs x)) u ∧ continuous_at (fun x => complex.im (gs x)) u
    intro u hu; rw [hgs]; have hcw := cpow_real.continuous_re_im (complex.neg (complex.add w0 complex.one)) u (by linarith); continuity
  have hgs_bd : ∀ u : ℝ, 1 ≤ u → complex.abs (gs u) * exp (R * |(-1 : ℝ)| * log u) ≤ 1 * rpow u (-R - 1)
    intro u hu; rw [hgs, complex.abs_smul, abs_of_pos.real (exp (-(1 / u))) (exp_pos (-(1 / u))), abs_neg_eq, abs_of_pos.real 1 (by decide)]
    have he1 : exp (-(1 / u)) ≤ 1
      have h := (exp_le_exp (-(1 / u)) 0).mpr (by linarith [one_div_pos.real u (by linarith)])
      rw [exp_zero] at h; exact h
    rw [cpow_real.abs_neg_add_one u w0]
    have hcomb : rpow u (-complex.re w0 - 1) * exp (R * 1 * log u) = rpow u (-R - 1)
      unfold rpow; rw [← exp_add]
      have h1 : (-complex.re w0 - 1) * log u + R * 1 * log u = (-R - 1) * log u := by rw [hR]; ring
      rw [h1]
    have hre1 : exp (-(1 / u)) * rpow u (-complex.re w0 - 1) * exp (R * 1 * log u) = exp (-(1 / u)) * rpow u (-R - 1) := by rw [← hcomb]; ring
    rw [hre1]
    have hm := mul_le_mul_of_nonneg_right.real (exp (-(1 / u))) 1 (rpow u (-R - 1)) he1 (by linarith [rpow.pos u (-R - 1)])
    linarith
  have hGs_ps := rpow_mellin_int.is_cpower_series_at gs (-1) w0 R 1 R hR_pos (by decide) hR_pos (by intro u hu; exact (hgs_cont u hu).1) (by intro u hu; exact (hgs_cont u hu).2) hgs_bd
  -- Part 2: G_large(w) analytic at w0 with radius R!
  set gl := (fun (u : ℝ) => gamma_integrand w0 u) with hgl
  have hgl_cont : ∀ u : ℝ, 1 ≤ u → continuous_at (fun x => complex.re (gl x)) u ∧ continuous_at (fun x => complex.im (gl x)) u
    intro u hu; rw [hgl]; unfold gamma_integrand; have hcw := cpow_real.continuous_re_im (complex.sub w0 complex.one) u (by linarith); continuity
  obtain ⟨K0, hK0⟩ := exists_nat_gt.real (max 1 (complex.re w0 + R))
  have hK0_ge1 : 1 ≤ K0 := by by_contra hlt; have hz : K0 = 0 := by omega; have h := lt_of_le_of_lt.real 1 (max 1 (complex.re w0 + R)) (K0 : ℝ) (le_max_left.real 1 (complex.re w0 + R)) hK0; rw [hz] at h; simp at h
  obtain ⟨Ml, hMl_pos, hMl⟩ := pow_le_exp_const K0 hK0_ge1 (1 / 2) (by decide)
  have hgl_bd : ∀ u : ℝ, 1 ≤ u → complex.abs (gl u) * exp (R * |(1 : ℝ)| * log u) ≤ Ml * exp (-(1 / 2) * u)
    intro u hu; rw [hgl]; unfold gamma_integrand
    rw [complex.abs_smul, abs_of_pos.real (exp (-u)) (exp_pos (-u))]
    have hap : complex.abs (cpow_real u (complex.sub w0 complex.one)) = rpow u (complex.re w0 - 1)
      have hsq : complex.abs (cpow_real u (complex.sub w0 complex.one)) * complex.abs (cpow_real u (complex.sub w0 complex.one)) = rpow u (complex.re w0 - 1) * rpow u (complex.re w0 - 1)
        rw [complex.abs_sq]; unfold complex.norm_sq cpow_real rpow; simp
        have h1 : log u * (complex.re w0 - 1) = (complex.re w0 - 1) * log u := by ring
        rw [h1]; linear_combination (exp ((complex.re w0 - 1) * log u) * exp ((complex.re w0 - 1) * log u)) * sin_sq_add_cos_sq (log u * (complex.im w0 - 0))
      exact eq_of_sq_eq_nonneg (complex.abs (cpow_real u (complex.sub w0 complex.one))) (rpow u (complex.re w0 - 1)) (complex.abs_nonneg (cpow_real u (complex.sub w0 complex.one))) (by linarith [rpow.pos u (complex.re w0 - 1)]) hsq
    rw [hap]
    have hcomb : rpow u (complex.re w0 - 1) * exp (R * 1 * log u) ≤ rpow u (complex.re w0 + R)
      unfold rpow; rw [← exp_add]
      exact (exp_le_exp ((complex.re w0 - 1) * log u + R * 1 * log u) ((complex.re w0 + R) * log u)).mpr (by nlinarith [log_nonneg u hu])
    have hpow_exp : u ^ K0 = exp ((K0 : ℝ) * log u)
      have hgen : ∀ m : ℕ, u ^ m = exp ((m : ℝ) * log u)
        intro m; induction m with j ihj
        · rw [pow_zero.real]; simp [exp_zero]
        · rw [succ_eq_add_one.nat, pow_succ.real, ihj, cast_add.real j 1]; simp
          have h1 : ((j : ℝ) + 1) * log u = (j : ℝ) * log u + log u := by ring
          rw [h1, exp_add, exp_log u (by linarith)]
      exact hgen K0
    have hle_uK : rpow u (complex.re w0 + R) ≤ Ml * exp ((1 / 2) * u)
      have h1 : rpow u (complex.re w0 + R) ≤ u ^ K0 := by rw [hpow_exp]; unfold rpow; exact (exp_le_exp ((complex.re w0 + R) * log u) ((K0 : ℝ) * log u)).mpr (mul_le_mul_of_nonneg_right.real (complex.re w0 + R) (K0 : ℝ) (log u) (by linarith [le_max_right.real 1 (complex.re w0 + R)]) (log_nonneg u hu))
      linarith [hMl u (by linarith)]
    have hre1 : exp (-u) * rpow u (complex.re w0 - 1) * exp (R * 1 * log u) = exp (-u) * (rpow u (complex.re w0 - 1) * exp (R * 1 * log u)) := by ring
    rw [hre1]
    have hm := mul_le_mul_of_nonneg_left.real (rpow u (complex.re w0 - 1) * exp (R * 1 * log u)) (Ml * exp ((1 / 2) * u)) (exp (-u)) (by linarith) (by linarith [exp_pos (-u)])
    have hexp_m : exp (-u) * exp ((1 / 2) * u) = exp (-(1 / 2) * u) := by rw [← exp_add]; have h1 : -u + (1 / 2) * u = -(1 / 2) * u := by ring; rw [h1]
    have hre2 : exp (-u) * (Ml * exp ((1 / 2) * u)) = Ml * (exp (-u) * exp ((1 / 2) * u)) := by ring
    rw [hre2, hexp_m] at hm; linarith
  have hGl_ps := exp_mellin_int.is_cpower_series_at gl 1 w0 R Ml (1 / 2) hR_pos (by linarith) (by decide) (by intro u hu; exact (hgl_cont u hu).1) (by intro u hu; exact (hgl_cont u hu).2) hgl_bd
  set Gs := (fun (w : ℂ) => clim (fun (N : ℕ) => cint (fun u => complex.mul (gs u) (complex.exp (complex.smul ((-1) * log u) (complex.sub w w0)))) 1 (1 + (N : ℝ)))) with hGs_fn
  set Gl := (fun (w : ℂ) => clim (fun (N : ℕ) => cint (fun u => complex.mul (gl u) (complex.exp (complex.smul (1 * log u) (complex.sub w w0)))) 1 (1 + (N : ℝ)))) with hGl_fn
  have hGs_ana : is_canalytic_at Gs w0
    unfold is_canalytic_at
    exact ⟨(fun k => clim (fun (N : ℕ) => cint (fun u => complex.smul (((-1) * log u) ^ k / ((fact k : ℕ) : ℝ)) (gs u)) 1 (1 + (N : ℝ)))), R, hGs_ps⟩
  have hGl_ana : is_canalytic_at Gl w0
    unfold is_canalytic_at
    exact ⟨(fun k => clim (fun (N : ℕ) => cint (fun u => complex.smul ((1 * log u) ^ k / ((fact k : ℕ) : ℝ)) (gl u)) 1 (1 + (N : ℝ)))), R, hGl_ps⟩
  have hsum_ana := is_canalytic_at.add Gs Gl w0 hGs_ana hGl_ana
  -- Show G_small(w) + G_large(w) = gamma(w) on |w - w0| < R via u = 1/t + gamma.eq_integral_re_pos!
  apply is_canalytic_at.congr (fun w => complex.add (Gs w) (Gl w)) gamma w0 R hR_pos hsum_ana
  intro w hw
  have hw_re_pos : 0 < complex.re w
    have h1 := complex.re_abs_le (complex.sub w w0)
    simp at h1; rw [hR] at hw; linarith [neg_le_abs.real (complex.re w - complex.re w0)]
  set f_sm := (fun (u : ℝ) => complex.mul (gs u) (complex.exp (complex.smul ((-1) * log u) (complex.sub w w0)))) with hfsm
  set f_lg := (fun (u : ℝ) => complex.mul (gl u) (complex.exp (complex.smul (1 * log u) (complex.sub w w0)))) with hflg
  have hf_lg_eq : ∀ u : ℝ, f_lg u = gamma_integrand w u
    intro u; rw [hflg, hgl]; unfold gamma_integrand
    have ha : complex.mul (complex.smul (exp (-u)) (cpow_real u (complex.sub w0 complex.one))) (complex.exp (complex.smul (1 * log u) (complex.sub w w0))) = complex.smul (exp (-u)) (complex.mul (cpow_real u (complex.sub w0 complex.one)) (complex.exp (complex.smul (1 * log u) (complex.sub w w0))))
      apply complex.ext <;> simp <;> ring
    rw [ha]; unfold cpow_real; rw [← complex.exp_add]
    have harg : complex.add (complex.smul (log u) (complex.sub w0 complex.one)) (complex.smul (1 * log u) (complex.sub w w0)) = complex.smul (log u) (complex.sub w complex.one)
      apply complex.ext <;> simp <;> ring
    rw [harg]
  have hf_sm_eq : ∀ u : ℝ, 1 ≤ u → f_sm u = complex.smul (1 / (u * u)) (gamma_integrand w (1 / u))
    intro u hu
    have hfs_u : f_sm u = complex.mul (complex.smul (exp (-(1 / u))) (cpow_real u (complex.neg (complex.add w0 complex.one)))) (complex.exp (complex.smul ((-1) * log u) (complex.sub w w0))) := by rw [hfsm, hgs]
    rw [hfs_u]; unfold gamma_integrand
    rw [cpow_real.inv_base u (complex.sub w complex.one) (by linarith)]
    have hu2_rpow : 1 / (u * u) = rpow u (-2)
      have hr2 : rpow u 2 = u * u := by unfold rpow; have h2 : (2 : ℝ) * log u = log u + log u := by ring; rw [h2, exp_add, exp_log u (by linarith)]
      have hprod : rpow u (-2) * (u * u) = 1 := by rw [← hr2, ← rpow.add]; have h0 : (-2 : ℝ) + 2 = 0 := by ring; rw [h0]; unfold rpow; simp [exp_zero]
      have hinv := mul_inv_cancel.real (u * u) (by nlinarith)
      linear_combination rpow u (-2) * hinv - (1 / (u * u)) * hprod
    have hsm_sm : ∀ (r1 r2 : ℝ) (a : ℂ), complex.smul r1 (complex.smul r2 a) = complex.smul r2 (complex.mul (complex.of_real r1) a)
      intro r1 r2 a; unfold complex.of_real; apply complex.ext <;> simp <;> ring
    have hsm_m : ∀ (r1 : ℝ) (a b : ℂ), complex.mul (complex.smul r1 a) b = complex.smul r1 (complex.mul a b)
      intro r1 a b; apply complex.ext <;> simp <;> ring
    rw [hsm_sm, hsm_m, hu2_rpow, cpow_real.of_real_exp u (-2), ← cpow_real.add_exp]
    unfold cpow_real; rw [← complex.exp_add]
    have hce : ∀ a b : ℂ, a = b → complex.smul (exp (-(1 / u))) (complex.exp a) = complex.smul (exp (-(1 / u))) (complex.exp b) := by intro a b hab; rw [hab]
    apply hce; unfold complex.of_real; apply complex.ext <;> simp <;> ring
  -- For every N >= 1, cint f_sm 1 (1 + (N+1)) + cint f_lg 1 (1 + (N+1)) = gamma_trunc w (1/(N+2)) (N+2)!
  have htrunc_eq : ∀ N : ℕ, complex.add (cint f_sm 1 (1 + ((N + 1 : ℕ) : ℝ))) (cint f_lg 1 (1 + ((N + 1 : ℕ) : ℝ))) = gamma_trunc w (1 / ((N + 2 : ℕ) : ℝ)) ((N + 2 : ℕ) : ℝ)
    intro N
    set B := ((N + 2 : ℕ) : ℝ) with hB
    have hB_eq : 1 + ((N + 1 : ℕ) : ℝ) = B := by rw [hB, cast_add.real N 2, cast_add.real N 1]; simp; ring
    have hB_ge1 : 1 ≤ B := by rw [hB]; exact (cast_le.real 1 (N + 2)).mpr (by omega)
    have h1B_pos : 0 < 1 / B := one_div_pos.real B (by linarith)
    have h1B_le1 : 1 / B ≤ 1 := (div_le_iff.real 1 1 B (by linarith)).mpr (by linarith)
    rw [hB_eq]
    have hcont_g : ∀ t : ℝ, 1 / B ≤ t → t ≤ B → continuous_at (fun x => complex.re (gamma_integrand w x)) t ∧ continuous_at (fun x => complex.im (gamma_integrand w x)) t
      intro t ht1 _
      have hcw := cpow_real.continuous_re_im (complex.sub w complex.one) t (by linarith)
      unfold gamma_integrand; continuity
    have hcont_u : ∀ u : ℝ, 1 ≤ u → u ≤ B → continuous_at (fun v => complex.re (gamma_integrand w (1 / v)) * (1 / (v * v))) u ∧ continuous_at (fun v => complex.im (gamma_integrand w (1 / v)) * (1 / (v * v))) u
      intro u hu1 hu2
      have h1u_ge : 1 / B ≤ 1 / u := (le_div_iff.real (1 / B) 1 u (by linarith)).mpr (by have hm := mul_le_mul_of_nonneg_left.real u B (1 / B) hu2 (by linarith); have hcB : (1 / B) * B = 1 := by field_simp; linarith)
      have h1u_le : 1 / u ≤ B := (div_le_iff.real 1 B u (by linarith)).mpr (by nlinarith)
      have hcf := hcont_g (1 / u) h1u_ge h1u_le
      continuity
    have hsub := c_has_integral.subst_inv_cont (gamma_integrand w) B hB_ge1 (by intro t h1 h2; exact (hcont_g t h1 (by linarith)).1) (by intro t h1 h2; exact (hcont_g t h1 (by linarith)).2) (by intro u h1 h2; exact (hcont_u u h1 h2).1) (by intro u h1 h2; exact (hcont_u u h1 h2).2)
    have hsm_int := c_has_integral.congr (fun u => complex.smul (1 / (u * u)) (gamma_integrand w (1 / u))) f_sm 1 B (cint (gamma_integrand w) (1 / B) 1) hsub (by intro u h1 h2; exact (hf_sm_eq u h1).symm)
    have hsm_eq : cint f_sm 1 B = cint (gamma_integrand w) (1 / B) 1 := cint.eq_of_has_integral f_sm 1 B (cint (gamma_integrand w) (1 / B) 1) hsm_int
    have hlg_eq : cint f_lg 1 B = cint (gamma_integrand w) 1 B
      have hfe : f_lg = gamma_integrand w := by funext u; exact hf_lg_eq u
      rw [hfe]
    rw [hsm_eq, hlg_eq]
    have hI1 := gamma_trunc.has_integral w (1 / B) 1 h1B_pos h1B_le1
    have hI2 := gamma_trunc.has_integral w 1 B (by decide) hB_ge1
    have hadj := c_has_integral.adjacent (gamma_integrand w) (1 / B) 1 B (gamma_trunc w (1 / B) 1) (gamma_trunc w 1 B) hI1 hI2
    unfold gamma_trunc at hadj ⊢
    exact (cint.eq_of_has_integral (gamma_integrand w) (1 / B) B (complex.add (cint (gamma_integrand w) (1 / B) 1) (cint (gamma_integrand w) 1 B)) hadj).symm
  -- Limits of cint f_sm and cint f_lg converge to clim f_sm and clim f_lg!
  have hsm_lim : ctends_to (fun (N : ℕ) => cint f_sm 1 (1 + (N : ℝ))) (clim (fun (N : ℕ) => cint f_sm 1 (1 + (N : ℝ))))
    have hsm_cont : ∀ u : ℝ, 1 ≤ u → continuous_at (fun x => complex.re (f_sm x)) u ∧ continuous_at (fun x => complex.im (f_sm x)) u
      intro u hu; rw [hfsm, hgs]
      have hcw := cpow_real.continuous_re_im (complex.neg (complex.add w0 complex.one)) u (by linarith)
      continuity
    have hsm_bd : ∀ u : ℝ, 1 ≤ u → complex.abs (f_sm u) ≤ 1 * rpow u (-R - 1)
      intro u hu
      have hfsu : f_sm u = complex.mul (gs u) (complex.exp (complex.smul ((-1) * log u) (complex.sub w w0))) := by rw [hfsm]
      rw [hfsu, complex.abs_mul, complex.abs_exp]; simp
      have hlu_nn : 0 ≤ log u := log_nonneg u hu
      have hre_le : -(log u) * (complex.re w - complex.re w0) ≤ R * |(-1 : ℝ)| * log u
        rw [abs_neg_eq, abs_of_pos.real 1 (by decide)]
        have h1 := complex.re_abs_le (complex.sub w w0); simp at h1
        have h2 : -(complex.re w - complex.re w0) ≤ R := by linarith [neg_le_abs.real (complex.re w - complex.re w0)]
        have h3 := mul_le_mul_of_nonneg_right.real (-(complex.re w - complex.re w0)) R (log u) h2 hlu_nn
        linarith
      have hfin : ∀ a : ℝ, a = -(log u) * (complex.re w - complex.re w0) → complex.abs (gs u) * exp a ≤ rpow u (-R - 1)
        intro a ha; rw [ha]
        have he := (exp_le_exp (-(log u) * (complex.re w - complex.re w0)) (R * |(-1 : ℝ)| * log u)).mpr hre_le
        have hm := mul_le_mul_of_nonneg_left.real (exp (-(log u) * (complex.re w - complex.re w0))) (exp (R * |(-1 : ℝ)| * log u)) (complex.abs (gs u)) he (complex.abs_nonneg (gs u))
        linarith [hgs_bd u hu]
      apply hfin; ring
    exact (improper_cint.of_rpow_bound f_sm 1 R (by decide) hR_pos (by intro u hu; exact (hsm_cont u hu).1) (by intro u hu; exact (hsm_cont u hu).2) hsm_bd).1
  have hlg_lim : ctends_to (fun (N : ℕ) => cint f_lg 1 (1 + (N : ℝ))) (clim (fun (N : ℕ) => cint f_lg 1 (1 + (N : ℝ))))
    have hlg_cont : ∀ u : ℝ, 1 ≤ u → continuous_at (fun x => complex.re (f_lg x)) u ∧ continuous_at (fun x => complex.im (f_lg x)) u
      intro u hu; rw [hflg, hgl]; unfold gamma_integrand
      have hcw := cpow_real.continuous_re_im (complex.sub w0 complex.one) u (by linarith)
      continuity
    have hlg_bd : ∀ u : ℝ, 1 ≤ u → complex.abs (f_lg u) ≤ Ml * exp (-(1 / 2) * u)
      intro u hu
      have hflu : f_lg u = complex.mul (gl u) (complex.exp (complex.smul (1 * log u) (complex.sub w w0))) := by rw [hflg]
      rw [hflu, complex.abs_mul, complex.abs_exp]; simp
      have hlu_nn : 0 ≤ log u := log_nonneg u hu
      have hre_le : log u * (complex.re w - complex.re w0) ≤ R * |(1 : ℝ)| * log u
        rw [abs_of_pos.real 1 (by decide)]
        have h1 := complex.re_abs_le (complex.sub w w0); simp at h1
        have h2 : complex.re w - complex.re w0 ≤ R := by linarith [le_abs_self.real (complex.re w - complex.re w0)]
        have h3 := mul_le_mul_of_nonneg_right.real (complex.re w - complex.re w0) R (log u) h2 hlu_nn
        linarith
      have hfin : ∀ a : ℝ, a = log u * (complex.re w - complex.re w0) → complex.abs (gl u) * exp a ≤ Ml * exp (-(1 / 2) * u)
        intro a ha; rw [ha]
        have he := (exp_le_exp (log u * (complex.re w - complex.re w0)) (R * |(1 : ℝ)| * log u)).mpr hre_le
        have hm := mul_le_mul_of_nonneg_left.real (exp (log u * (complex.re w - complex.re w0))) (exp (R * |(1 : ℝ)| * log u)) (complex.abs (gl u)) he (complex.abs_nonneg (gl u))
        linarith [hgl_bd u hu]
      apply hfin; ring
    exact (improper_cint.of_exp_bound f_lg Ml (1 / 2) (by linarith) (by decide) (by intro u hu; exact (hlg_cont u hu).1) (by intro u hu; exact (hlg_cont u hu).2) hlg_bd).1
  have hadd_lim := ctends_to.add (fun (N : ℕ) => cint f_sm 1 (1 + (N : ℝ))) (fun (N : ℕ) => cint f_lg 1 (1 + (N : ℝ))) (clim (fun (N : ℕ) => cint f_sm 1 (1 + (N : ℝ)))) (clim (fun (N : ℕ) => cint f_lg 1 (1 + (N : ℝ)))) hsm_lim hlg_lim
  have hsh_lim : ctends_to (fun (N : ℕ) => complex.add (cint f_sm 1 (1 + ((N + 1 : ℕ) : ℝ))) (cint f_lg 1 (1 + ((N + 1 : ℕ) : ℝ)))) (complex.add (clim (fun (N : ℕ) => cint f_sm 1 (1 + (N : ℝ)))) (clim (fun (N : ℕ) => cint f_lg 1 (1 + (N : ℝ)))))
    unfold ctends_to at hadd_lim ⊢; intro e he; obtain ⟨N0, hN0⟩ := hadd_lim e he; use N0; intro N hN; exact hN0 (N + 1) (by omega)
  have hfe : (fun (N : ℕ) => complex.add (cint f_sm 1 (1 + ((N + 1 : ℕ) : ℝ))) (cint f_lg 1 (1 + ((N + 1 : ℕ) : ℝ)))) = (fun (N : ℕ) => gamma_trunc w (1 / ((N + 2 : ℕ) : ℝ)) ((N + 2 : ℕ) : ℝ)) := by funext N; exact htrunc_eq N
  rw [hfe] at hsh_lim
  have hGsw : Gs w = clim (fun (N : ℕ) => cint f_sm 1 (1 + (N : ℝ))) := by rw [hGs_fn, hfsm]
  have hGlw : Gl w = clim (fun (N : ℕ) => cint f_lg 1 (1 + (N : ℝ))) := by rw [hGl_fn, hflg]
  rw [hGsw, hGlw]
  exact ctends_to.unique (fun (N : ℕ) => gamma_trunc w (1 / ((N + 2 : ℕ) : ℝ)) ((N + 2 : ℕ) : ℝ)) (complex.add (clim (fun (N : ℕ) => cint f_sm 1 (1 + (N : ℝ)))) (clim (fun (N : ℕ) => cint f_lg 1 (1 + (N : ℝ))))) (gamma w) hsh_lim (gamma.eq_integral_re_pos w hw_re_pos)

-- Linear affine pullback of analyticity: f(a * s + b) is analytic at s0 when f is analytic at a * s0 + b (a > 0)!
+ is_canalytic_at.comp_pos_affine (f : ℂ → ℂ) (a_sc : ℝ) (b_off s0 : ℂ) (ha : 0 < a_sc)
    (hf : is_canalytic_at f (complex.add (complex.smul a_sc s0) b_off)) :
    is_canalytic_at (fun s => f (complex.add (complex.smul a_sc s) b_off)) s0 :=
  is_canalytic_at.comp_affine f a_sc b_off s0 (by linarith) hf

+ classical_gamma.is_canalytic_at_re_pos (chi : DChar) (hval : dchar.valid chi) (s0 : ℂ) (hs0 : 0 < complex.re s0) :
    is_canalytic_at (classical_gamma chi) s0
  set psi := dchar.prim chi with hpsi
  have hprim : dchar.is_primitive psi := by rw [hpsi]; exact (dchar.prim_spec chi hval).1
  have hq_pos : (0 : ℝ) < (psi.level : ℝ) := (cast_pos.real psi.level).mpr (by have h := hprim.1.1; omega)
  have hpi_pos : 0 < pi := by linarith [pi_bounds.1]
  have hqp_pos : 0 < (psi.level : ℝ) / pi := div_pos.real (psi.level : ℝ) pi hq_pos hpi_pos
  set b_off := complex.smul (1 / 2) (complex.of_real ((dchar.parity psi : ℕ) : ℝ)) with hboff
  have hw0_re : 0 < complex.re (complex.add (complex.smul (1 / 2) s0) b_off)
    rw [hboff]; unfold complex.of_real; simp
    have hnn : (0 : ℝ) ≤ ((dchar.parity psi : ℕ) : ℝ) := cast_nonneg.real (dchar.parity psi)
    linarith
  have hcp := cpow_real.is_canalytic_at_linear ((psi.level : ℝ) / pi) (1 / 2) b_off hqp_pos s0
  have hgam := is_canalytic_at.comp_pos_affine gamma (1 / 2) b_off s0 (by decide) (gamma.is_canalytic_at_re_pos (complex.add (complex.smul (1 / 2) s0) b_off) hw0_re)
  have hmul := is_canalytic_at.mul (fun s => cpow_real ((psi.level : ℝ) / pi) (complex.add (complex.smul (1 / 2) s) b_off)) (fun s => gamma (complex.add (complex.smul (1 / 2) s) b_off)) s0 hcp hgam
  apply is_canalytic_at.congr (fun s => complex.mul (cpow_real ((psi.level : ℝ) / pi) (complex.add (complex.smul (1 / 2) s) b_off)) (gamma (complex.add (complex.smul (1 / 2) s) b_off))) (classical_gamma chi) s0 1 (by decide) hmul
  intro s _; unfold classical_gamma; rw [← hpsi]
  have h1 : ∀ (wA wB : ℂ), wA = wB → complex.mul (cpow_real ((psi.level : ℝ) / pi) wA) (gamma wA) = complex.mul (cpow_real ((psi.level : ℝ) / pi) wB) (gamma wB) := by intro wA wB heq; rw [heq]
  apply h1; rw [hboff]; unfold complex.of_real; apply complex.ext <;> simp <;> ring

-- 3f. Exact Triviality Characterization & Full Re(s) > 0 Analyticity of `classical_L_reg chi` (0 AXIOMS!)
+ dchar.is_trivial_iff_prim_level_one (chi : DChar) (hval : dchar.valid chi) :
    dchar.is_trivial chi ↔ (dchar.prim chi).level = 1
  have hsp := dchar.prim_spec chi hval
  constructor
  · intro htriv
    have hind : dchar.induced_by chi dchar.trivial_one
      unfold dchar.induced_by dchar.trivial_one; simp
      constructor
      · unfold dvd; have h0 := add_mul_mod.nat 0 chi.level 1
        have h1 : 0 + 1 * chi.level = chi.level := by ring
        rw [h1] at h0; rw [h0]; exact (div_mod_of_lt.nat 0 1 (by decide)).2
      · unfold dchar.is_trivial at htriv; intro a ha; exact htriv a ha
    have heq := dchar.prim_eq chi hval dchar.trivial_one dchar.trivial_one_is_primitive hind
    rw [heq]; unfold dchar.trivial_one; simp
  · intro hl1
    set psi := dchar.prim chi with hpsi
    have hpsi_one : ∀ n : ℕ, psi.val n = complex.one
      intro n
      have hper : ∀ m : ℕ, psi.val (m + 1) = psi.val m
        intro m; have h := hsp.1.1.2.1 m; rw [hl1] at h; exact h
      have h0 : psi.val 0 = complex.one
        have h := hper 0; simp at h; rw [hsp.1.1.2.2.1] at h; exact h.symm
      induction n with k ihk
      · exact h0
      · rw [succ_eq_add_one.nat, hper k, ihk]
    unfold dchar.is_trivial; intro a ha
    rw [hsp.2.2 a ha, hpsi_one a]

-- Regularized classical Dirichlet L-function on Re(s) > 0 (removes the simple pole at s = 1 for trivial chi!):
-> classical_L_reg (chi : DChar) (s : ℂ) : ℂ :=
  if (dchar.prim chi).level = 1 then
    complex.mul (induced_euler_ratio chi.level (dchar.prim chi) s)
      (complex.mul (complex.inv (classical_gamma (dchar.prim chi) s)) (classical_Lambda_triv_reg s))
  else
    classical_L.l_fn chi s

+ classical_L_reg.eq_re_pos (chi : DChar) (hval : dchar.valid chi) (s : ℂ) (hs : 0 < complex.re s) (hs1 : s ≠ complex.one) :
    classical_L_reg chi s = if dchar.is_trivial chi then complex.mul (complex.sub s complex.one) (classical_L.l_fn chi s) else classical_L.l_fn chi s
  have hiff := dchar.is_trivial_iff_prim_level_one chi hval
  set psi := dchar.prim chi with hpsi
  have hs0 : s ≠ complex.zero
    intro hz; have hr : complex.re s = complex.re complex.zero := by rw [hz]
    simp at hr; linarith
  have hgam_ne := classical_gamma.ne_zero_re_pos psi s hs
  unfold classical_L_reg
  by_cases hl1 : psi.level = 1
  · have htriv : dchar.is_trivial chi := hiff.mpr hl1
    rw [← hpsi, if_pos hl1, if_pos htriv, classical_Lambda_triv_reg.eq_mul s hs1]
    unfold classical_L classical_L_fn classical_L_prim classical_Lambda; simp
    rw [← hpsi]
    have hnc0 : ¬ (psi.level = 1 ∧ s = complex.zero) := by intro h; exact hs0 h.2
    have hnc1 : ¬ (psi.level = 1 ∧ s = complex.one) := by intro h; exact hs1 h.2
    rw [if_neg hnc0, if_neg hnc1, if_neg hgam_ne, if_pos hl1]; apply complex.ext <;> simp <;> ring
  · have hntriv : ¬ dchar.is_trivial chi := by intro h; exact hl1 (hiff.mp h)
    rw [← hpsi, if_neg hl1, if_neg hntriv]

+ classical_L_reg.at_one_ne_zero (chi : DChar) (hval : dchar.valid chi) (htriv : dchar.is_trivial chi) :
    classical_L_reg chi complex.one ≠ complex.zero
  have hl1 : (dchar.prim chi).level = 1 := (dchar.is_trivial_iff_prim_level_one chi hval).mp htriv
  have hsp := dchar.prim_spec chi hval
  unfold classical_L_reg
  rw [if_pos hl1, classical_Lambda_triv_reg.at_one, complex.mul_one]
  have h1re : 0 < complex.re complex.one := by simp
  have heul := induced_euler_ratio.ne_zero_re_pos chi.level (dchar.prim chi) hsp.1.1 complex.one h1re
  have hgam := classical_gamma.ne_zero_re_pos (dchar.prim chi) complex.one h1re
  have hinv_ne : complex.inv (classical_gamma (dchar.prim chi) complex.one) ≠ complex.zero
    intro h0; have hc := complex.mul_inv_cancel (classical_gamma (dchar.prim chi) complex.one) hgam
    rw [h0, complex.mul_zero] at hc; exact complex.one_ne_zero hc.symm
  exact complex.mul_ne_zero (induced_euler_ratio chi.level (dchar.prim chi) complex.one) (complex.inv (classical_gamma (dchar.prim chi) complex.one)) heul hinv_ne

-- MASTER THEOREM OF MILESTONE 3.34: FULL HALF-PLANE Re(s) > 0 POWER-SERIES ANALYTICITY OF `classical_L_reg chi` (0 AXIOMS!)
+ classical_L_reg.is_canalytic_at_re_pos (chi : DChar) (hval : dchar.valid chi) (s0 : ℂ) (hs0 : 0 < complex.re s0) :
    is_canalytic_at (classical_L_reg chi) s0
  have hsp := dchar.prim_spec chi hval
  set psi := dchar.prim chi with hpsi
  by_cases hl1 : (dchar.prim chi).level = 1
  · canalytic [classical_L_reg]
  · have hprod : is_canalytic_at (fun s => complex.mul (induced_euler_ratio chi.level psi s) (complex.mul (complex.inv (classical_gamma psi s)) (classical_Lambda_nt psi s))) s0
      have hp_val : dchar.valid psi := hsp.1.1
      canalytic
    apply is_canalytic_at.congr (fun s => complex.mul (induced_euler_ratio chi.level psi s) (complex.mul (complex.inv (classical_gamma psi s)) (classical_Lambda_nt psi s))) (classical_L_reg chi) s0 (complex.re s0 / 2) (by linarith) hprod
    intro s hs
    have hs_re : 0 < complex.re s
      have h1 := complex.re_abs_le (complex.sub s s0); simp at h1
      linarith [neg_le_abs.real (complex.re s - complex.re s0)]
    have hgam_ne := classical_gamma.ne_zero_re_pos psi s hs_re
    unfold classical_L_reg classical_L classical_L_fn classical_L_prim classical_Lambda; simp
    rw [if_neg hl1, ← hpsi]
    have hl1p : ¬ (psi.level = 1) := by rw [hpsi]; exact hl1
    have hnc0 : ¬ (psi.level = 1 ∧ s = complex.zero) := by intro h; exact hl1p h.1
    have hnc1 : ¬ (psi.level = 1 ∧ s = complex.one) := by intro h; exact hl1p h.1
    rw [if_neg hnc0, if_neg hnc1, if_neg hgam_ne, if_neg hl1p]
