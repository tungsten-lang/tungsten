        intro M h1 h2; induction M with m ihm
        · rw [csum.zero, csum.zero, csum.zero]; apply complex.ext <;> simp
        · rw [succ_eq_add_one.nat, csum.succ, csum.succ, csum.succ, ← ihm]; apply complex.ext <;> simp <;> ring
      rw [hprod, hC_dbl, hsub_csum]
      apply csum.congr; intro j _
      rw [hsub_csum]; apply csum.congr; intro k _
      by_cases hge : N ≤ j + k
      · have hnot : ¬ (j + k < N) := by omega
        rw [if_neg hnot, if_pos hge]; apply complex.ext <;> simp <;> ring
      · have hlt : j + k < N := by omega
        rw [if_pos hlt, if_neg hge]; apply complex.ext <;> simp <;> ring
    -- Bound |csum N A * csum N B - csum N C| <= M1 * M2 * (N + 1) * q^N / (1 - q)^2? Even simpler:
    -- For every j, k with N <= j + k: |A j * B k| <= M1 * M2 * q^(j + k) <= M1 * M2 * q^(N / 2) * q^(j + k - N / 2)?
    -- Wait: j + k >= N => j >= N/2 OR k >= N/2! So sum <= 2 * M1 * M2 * q^(N/2) / (1 - q)^2!
    have hrem_bd : ∀ N : ℕ, complex.abs (complex.sub (complex.mul (csum N A) (csum N B)) (csum N C)) ≤ 2 * (M1 * M2 / ((1 - q) * (1 - q))) * q ^ (N / 2)
      intro N
      rw [hfin_rem N]
      set K := N / 2 with hK
      have h1 := csum.abs_le_sum N (fun j => csum N (fun k => if N ≤ j + k then complex.mul (A j) (B k) else complex.zero))
      have hinner_bd : ∀ j : ℕ, j < N → complex.abs (csum N (fun k => if N ≤ j + k then complex.mul (A j) (B k) else complex.zero)) ≤ (if K ≤ j then M1 * q ^ j * (M2 / (1 - q)) else M1 * q ^ j * (M2 * q ^ K / (1 - q)))
        intro j _
        have ha1 := csum.abs_le_sum N (fun k => if N ≤ j + k then complex.mul (A j) (B k) else complex.zero)
        by_cases hjK : K ≤ j
        · rw [if_pos hjK]
          have hpt1 : ∀ k : ℕ, k < N → complex.abs (if N ≤ j + k then complex.mul (A j) (B k) else complex.zero) ≤ (M1 * q ^ j * M2) * q ^ k
            intro k _
            by_cases hge : N ≤ j + k
            · rw [if_pos hge, complex.abs_mul]
              have hm1 := mul_le_mul_of_nonneg_right.real (complex.abs (A j)) (M1 * q ^ j) (complex.abs (B k)) (hA_bd j) (complex.abs_nonneg (B k))
              have hm2 := mul_le_mul_of_nonneg_left.real (complex.abs (B k)) (M2 * q ^ k) (M1 * q ^ j) (hB_bd k) (mul_nonneg.real M1 (q ^ j) hM1 (pow_nonneg.real q hq0 j))
              linarith
            · rw [if_neg hge, complex.abs_zero]
              exact mul_nonneg.real (M1 * q ^ j * M2) (q ^ k) (mul_nonneg.real (M1 * q ^ j) M2 (mul_nonneg.real M1 (q ^ j) hM1 (pow_nonneg.real q hq0 j)) hM2) (pow_nonneg.real q hq0 k)
          have hle := sum_le.real (fun k => complex.abs (if N ≤ j + k then complex.mul (A j) (B k) else complex.zero)) (fun k => (M1 * q ^ j * M2) * q ^ k) N hpt1
          have hsc : ∀ m : ℕ, (∑ k < m, (M1 * q ^ j * M2) * q ^ k) = (M1 * q ^ j * M2) * (∑ k < m, q ^ k)
            intro m; induction m with l ihl
            · rw [sum_below_zero, sum_below_zero]; ring
            · rw [succ_eq_add_one.nat, sum_below_succ, sum_below_succ, ihl]; ring
          have hm := mul_le_mul_of_nonneg_left.real (∑ k < N, q ^ k) (1 / (1 - q)) (M1 * q ^ j * M2) (geom_sum_le_inv q hq0 hq1 N) (mul_nonneg.real (M1 * q ^ j) M2 (mul_nonneg.real M1 (q ^ j) hM1 (pow_nonneg.real q hq0 j)) hM2)
          have hre : (M1 * q ^ j * M2) * (1 / (1 - q)) = M1 * q ^ j * (M2 / (1 - q))
            rw [div_def.real 1 (1 - q), div_def.real M2 (1 - q)]; ring
          linarith [hsc N]
        · rw [if_neg hjK]
          have hpt2 : ∀ k : ℕ, k < N → complex.abs (if N ≤ j + k then complex.mul (A j) (B k) else complex.zero) ≤ (if K ≤ k then (M1 * q ^ j * M2 * q ^ K) * q ^ (k - K) else 0)
            intro k _
            by_cases hge : N ≤ j + k
            · have hkK : K ≤ k := by rw [hK] at hjK ⊢; omega
              rw [if_pos hge, if_pos hkK, complex.abs_mul]
              have hm1 := mul_le_mul_of_nonneg_right.real (complex.abs (A j)) (M1 * q ^ j) (complex.abs (B k)) (hA_bd j) (complex.abs_nonneg (B k))
              have hm2 := mul_le_mul_of_nonneg_left.real (complex.abs (B k)) (M2 * q ^ k) (M1 * q ^ j) (hB_bd k) (mul_nonneg.real M1 (q ^ j) hM1 (pow_nonneg.real q hq0 j))
              have hkeq : K + (k - K) = k := by omega
              have hqp : q ^ k = q ^ K * q ^ (k - K) := by rw [← hpow_add q K (k - K), hkeq]
              rw [hqp] at hm2; linarith
            · rw [if_neg hge, complex.abs_zero]
              by_cases hkK : K ≤ k
              · rw [if_pos hkK]
                exact mul_nonneg.real (M1 * q ^ j * M2 * q ^ K) (q ^ (k - K)) (mul_nonneg.real (M1 * q ^ j * M2) (q ^ K) (mul_nonneg.real (M1 * q ^ j) M2 (mul_nonneg.real M1 (q ^ j) hM1 (pow_nonneg.real q hq0 j)) hM2) (pow_nonneg.real q hq0 K)) (pow_nonneg.real q hq0 (k - K))
              · rw [if_neg hkK]; linarith
          have hle := sum_le.real (fun k => complex.abs (if N ≤ j + k then complex.mul (A j) (B k) else complex.zero)) (fun k => if K ≤ k then (M1 * q ^ j * M2 * q ^ K) * q ^ (k - K) else 0) N hpt2
          have htail_sum : (∑ k < N, if K ≤ k then (M1 * q ^ j * M2 * q ^ K) * q ^ (k - K) else 0) ≤ M1 * q ^ j * (M2 * q ^ K / (1 - q))
            have hK_le_N : K ≤ N := by rw [hK]; omega
            have hsplit : ∀ d : ℕ, (∑ k < K + d, if K ≤ k then (M1 * q ^ j * M2 * q ^ K) * q ^ (k - K) else 0) = (M1 * q ^ j * M2 * q ^ K) * (∑ l < d, q ^ l)
              intro d; induction d with l ihl
              · have h0 : K + 0 = K := by omega
                rw [h0, sum_below_zero]
                have hz : ∀ m : ℕ, m ≤ K → (∑ k < m, if K ≤ k then (M1 * q ^ j * M2 * q ^ K) * q ^ (k - K) else 0) = 0
                  intro m; induction m with hm0 p ihp hp
                  · rw [sum_below_zero]
                  · rw [succ_eq_add_one.nat, sum_below_succ, ihp (by omega)]
                    have hnot : ¬ (K ≤ p) := by omega
                    rw [if_neg hnot]; ring
                rw [hz K (by omega)]; ring
              · rw [succ_eq_add_one.nat]
                have h1a : K + (l + 1) = (K + l) + 1 := by omega
                rw [h1a, sum_below_succ, sum_below_succ, ihl]
                have hgeK : K ≤ K + l := by omega
                have hsubK : (K + l) - K = l := by omega
                rw [if_pos hgeK, hsubK]; ring
            have hNeq : N = K + (N - K) := by omega
            rw [hNeq, hsplit (N - K)]
            have hm := mul_le_mul_of_nonneg_left.real (∑ l < N - K, q ^ l) (1 / (1 - q)) (M1 * q ^ j * M2 * q ^ K) (geom_sum_le_inv q hq0 hq1 (N - K)) (mul_nonneg.real (M1 * q ^ j * M2) (q ^ K) (mul_nonneg.real (M1 * q ^ j) M2 (mul_nonneg.real M1 (q ^ j) hM1 (pow_nonneg.real q hq0 j)) hM2) (pow_nonneg.real q hq0 K))
            have hre : (M1 * q ^ j * M2 * q ^ K) * (1 / (1 - q)) = M1 * q ^ j * (M2 * q ^ K / (1 - q))
              rw [div_def.real 1 (1 - q), div_def.real (M2 * q ^ K) (1 - q)]; ring
            linarith
          linarith
      have houter_pt : ∀ j : ℕ, j < N → complex.abs (csum N (fun k => if N ≤ j + k then complex.mul (A j) (B k) else complex.zero)) ≤ (if K ≤ j then M1 * q ^ j * (M2 / (1 - q)) else 0) + M1 * q ^ j * (M2 * q ^ K / (1 - q))
        intro j hj
        have hi := hinner_bd j hj
        by_cases hjK : K ≤ j
        · rw [if_pos hjK] at hi ⊢
          have hnn := mul_nonneg.real (M1 * q ^ j) (M2 * q ^ K / (1 - q)) (mul_nonneg.real M1 (q ^ j) hM1 (pow_nonneg.real q hq0 j)) (div_nonneg.real (M2 * q ^ K) (1 - q) (mul_nonneg.real M2 (q ^ K) hM2 (pow_nonneg.real q hq0 K)) (by linarith))
          linarith
        · rw [if_neg hjK] at hi ⊢; linarith
      have houter := sum_le.real (fun j => complex.abs (csum N (fun k => if N ≤ j + k then complex.mul (A j) (B k) else complex.zero))) (fun j => (if K ≤ j then M1 * q ^ j * (M2 / (1 - q)) else 0) + M1 * q ^ j * (M2 * q ^ K / (1 - q))) N houter_pt
      have hadd_sum : ∀ (M : ℕ) (u v : ℕ → ℝ), (∑ j < M, (u j + v j)) = (∑ j < M, u j) + (∑ j < M, v j)
        intro M u v; induction M with m ihm
        · rw [sum_below_zero, sum_below_zero, sum_below_zero]; ring
        · rw [succ_eq_add_one.nat, sum_below_succ, sum_below_succ, sum_below_succ, ihm]; ring
      rw [hadd_sum N] at houter
      have hpart1 : (∑ j < N, if K ≤ j then M1 * q ^ j * (M2 / (1 - q)) else 0) ≤ (M1 * M2 / ((1 - q) * (1 - q))) * q ^ K
        have hK_le_N : K ≤ N := by rw [hK]; omega
        have hsplit : ∀ d : ℕ, (∑ j < K + d, if K ≤ j then M1 * q ^ j * (M2 / (1 - q)) else 0) = (M1 * (M2 / (1 - q)) * q ^ K) * (∑ l < d, q ^ l)
          intro d; induction d with l ihl
          · have h0 : K + 0 = K := by omega
            rw [h0, sum_below_zero]
            have hz : ∀ m : ℕ, m ≤ K → (∑ j < m, if K ≤ j then M1 * q ^ j * (M2 / (1 - q)) else 0) = 0
              intro m; induction m with hm0 p ihp hp
              · rw [sum_below_zero]
              · rw [succ_eq_add_one.nat, sum_below_succ, ihp (by omega)]
                have hnot : ¬ (K ≤ p) := by omega
                rw [if_neg hnot]; ring
            rw [hz K (by omega)]; ring
          · rw [succ_eq_add_one.nat]
            have h1a : K + (l + 1) = (K + l) + 1 := by omega
            rw [h1a, sum_below_succ, sum_below_succ, ihl]
            have hgeK : K ≤ K + l := by omega
            rw [if_pos hgeK, hpow_add q K l]; ring
        have hNeq : N = K + (N - K) := by omega
        rw [hNeq, hsplit (N - K)]
        have hcoeff_nn : 0 ≤ M1 * (M2 / (1 - q)) * q ^ K := mul_nonneg.real (M1 * (M2 / (1 - q))) (q ^ K) (mul_nonneg.real M1 (M2 / (1 - q)) hM1 (div_nonneg.real M2 (1 - q) hM2 (by linarith))) (pow_nonneg.real q hq0 K)
        have hm := mul_le_mul_of_nonneg_left.real (∑ l < N - K, q ^ l) (1 / (1 - q)) (M1 * (M2 / (1 - q)) * q ^ K) (geom_sum_le_inv q hq0 hq1 (N - K)) hcoeff_nn
        have hc1 := mul_inv_cancel.real (1 - q) (by linarith)
        have hc2 := mul_inv_cancel.real ((1 - q) * (1 - q)) (by nlinarith)
        have hinv2 : (1 / (1 - q)) * (1 / (1 - q)) = 1 / ((1 - q) * (1 - q))
          have h0 : ((1 - q) * (1 - q)) * ((1 / (1 - q)) * (1 / (1 - q)) - 1 / ((1 - q) * (1 - q))) = 0
            have ha1 : ((1 - q) * (1 - q)) * ((1 / (1 - q)) * (1 / (1 - q))) = ((1 - q) * (1 / (1 - q))) * ((1 - q) * (1 / (1 - q))) := by ring
            rw [mul_sub.real, ha1, hc1, hc2]; ring
          linear_combination (1 / ((1 - q) * (1 - q))) * h0 - ((1 / (1 - q)) * (1 / (1 - q)) - 1 / ((1 - q) * (1 - q))) * hc2
        have hre : M1 * (M2 / (1 - q)) * q ^ K * (1 / (1 - q)) = (M1 * M2 / ((1 - q) * (1 - q))) * q ^ K
          rw [div_def.real M2 (1 - q), div_def.real (M1 * M2) ((1 - q) * (1 - q))]
          have h2a : M1 * (M2 * (1 / (1 - q))) * q ^ K * (1 / (1 - q)) = M1 * M2 * ((1 / (1 - q)) * (1 / (1 - q))) * q ^ K := by ring
          rw [h2a, hinv2]
        linarith
      have hpart2 : (∑ j < N, M1 * q ^ j * (M2 * q ^ K / (1 - q))) ≤ (M1 * M2 / ((1 - q) * (1 - q))) * q ^ K
        have hsc : ∀ m : ℕ, (∑ j < m, M1 * q ^ j * (M2 * q ^ K / (1 - q))) = (M1 * (M2 * q ^ K / (1 - q))) * (∑ j < m, q ^ j)
          intro m; induction m with l ihl
          · rw [sum_below_zero, sum_below_zero]; ring
          · rw [succ_eq_add_one.nat, sum_below_succ, sum_below_succ, ihl]; ring
        rw [hsc N]
        have hcoeff_nn : 0 ≤ M1 * (M2 * q ^ K / (1 - q)) := mul_nonneg.real M1 (M2 * q ^ K / (1 - q)) hM1 (div_nonneg.real (M2 * q ^ K) (1 - q) (mul_nonneg.real M2 (q ^ K) hM2 (pow_nonneg.real q hq0 K)) (by linarith))
        have hm := mul_le_mul_of_nonneg_left.real (∑ j < N, q ^ j) (1 / (1 - q)) (M1 * (M2 * q ^ K / (1 - q))) (geom_sum_le_inv q hq0 hq1 N) hcoeff_nn
        have hc1 := mul_inv_cancel.real (1 - q) (by linarith)
        have hc2 := mul_inv_cancel.real ((1 - q) * (1 - q)) (by nlinarith)
        have hinv2 : (1 / (1 - q)) * (1 / (1 - q)) = 1 / ((1 - q) * (1 - q))
          have h0 : ((1 - q) * (1 - q)) * ((1 / (1 - q)) * (1 / (1 - q)) - 1 / ((1 - q) * (1 - q))) = 0
            have ha1 : ((1 - q) * (1 - q)) * ((1 / (1 - q)) * (1 / (1 - q))) = ((1 - q) * (1 / (1 - q))) * ((1 - q) * (1 / (1 - q))) := by ring
            rw [mul_sub.real, ha1, hc1, hc2]; ring
          linear_combination (1 / ((1 - q) * (1 - q))) * h0 - ((1 / (1 - q)) * (1 / (1 - q)) - 1 / ((1 - q) * (1 - q))) * hc2
        have hre : M1 * (M2 * q ^ K / (1 - q)) * (1 / (1 - q)) = (M1 * M2 / ((1 - q) * (1 - q))) * q ^ K
          rw [div_def.real (M2 * q ^ K) (1 - q), div_def.real (M1 * M2) ((1 - q) * (1 - q))]
          have h2a : M1 * (M2 * q ^ K * (1 / (1 - q))) * (1 / (1 - q)) = M1 * M2 * ((1 / (1 - q)) * (1 / (1 - q))) * q ^ K := by ring
          rw [h2a, hinv2]
        linarith
      linarith
    have hzr' : complex.abs (complex.sub z z0) < r := by rw [← hw]; exact hzr
    have hAlim : ctends_to (fun N => csum N A) (f z) := by rw [hA, hw]; exact h1.2.2 z hzr'
    have hBlim : ctends_to (fun N => csum N B) (g z) := by rw [hB, hw]; exact h2.2.2 z hzr'
    have hAB_lim := ctends_to.mul (fun N => csum N A) (fun N => csum N B) (f z) (g z) hAlim hBlim
    have hq_lim := geom_pow_tends_to_zero q hq0 hq1
    set B0 := 2 * (M1 * M2 / ((1 - q) * (1 - q))) + 1 with hB0
    have hB0_pos : 0 < B0
      rw [hB0]; have hnn := div_nonneg.real (M1 * M2) ((1 - q) * (1 - q)) (mul_nonneg.real M1 M2 hM1 hM2) (by nlinarith)
      linarith
    unfold ctends_to at hAB_lim ⊢; unfold tends_to at hq_lim
    intro e he
    obtain ⟨N1, hN1⟩ := hAB_lim (e / 2) (by linarith)
    obtain ⟨K2, hK2⟩ := hq_lim (e / (2 * B0)) (div_pos.real e (2 * B0) he (by linarith))
    use N1 + 2 * K2; intro N hN
    have h1a := hN1 N (by omega)
    have h2a := hK2 (N / 2) (by omega)
    have hsub0 : q ^ (N / 2) - 0 = q ^ (N / 2) := by ring
    rw [hsub0, abs_of_nonneg.real (q ^ (N / 2)) (pow_nonneg.real q hq0 (N / 2))] at h2a
    have h2b : B0 * q ^ (N / 2) < e / 2
      have hmul := (lt_div_iff.real (q ^ (N / 2)) e (2 * B0) (by linarith)).mp h2a
      linarith
    have hrem := hrem_bd N
    have hrem_lt : complex.abs (complex.sub (complex.mul (csum N A) (csum N B)) (csum N C)) < e / 2
      have h1b : 2 * (M1 * M2 / ((1 - q) * (1 - q))) * q ^ (N / 2) ≤ B0 * q ^ (N / 2)
        have hle : 2 * (M1 * M2 / ((1 - q) * (1 - q))) ≤ B0 := by rw [hB0]; linarith
        exact mul_le_mul_of_nonneg_right.real (2 * (M1 * M2 / ((1 - q) * (1 - q)))) B0 (q ^ (N / 2)) hle (pow_nonneg.real q hq0 (N / 2))
      linarith
    have htri := complex.abs_sub_triangle (csum N C) (complex.mul (csum N A) (csum N B)) (complex.mul (f z) (g z))
    rw [complex.abs_sub_comm (csum N C) (complex.mul (csum N A) (csum N B))] at htri
    linarith

+ is_canalytic_at.mul (f g : ℂ → ℂ) (z0 : ℂ) (hf : is_canalytic_at f z0) (hg : is_canalytic_at g z0) :
    is_canalytic_at (fun z => complex.mul (f z) (g z)) z0
  unfold is_canalytic_at at hf hg ⊢
  obtain ⟨a, r1, h1⟩ := hf
  obtain ⟨b, r2, h2⟩ := hg
  exact ⟨cauchy_prod a b, min r1 r2 / 2, is_cpower_series_at.mul f g z0 a b r1 r2 h1 h2⟩

+ is_canalytic_at.cprod (K : ℕ) (F : ℕ → ℂ → ℂ) (z0 : ℂ) :
    (∀ k, k < K → is_canalytic_at (F k) z0) → is_canalytic_at (fun z => cprod K (fun k => F k z)) z0
  induction K with h0 m ihm hF
  · have hf : (fun z => cprod 0 (fun k => F k z)) = (fun _ => complex.one) := by funext z; rfl
    rw [hf]; exact is_canalytic_at.const complex.one z0
  · rw [succ_eq_add_one.nat]
    have hf : (fun z => cprod (m + 1) (fun k => F k z)) = (fun z => complex.mul (cprod m (fun k => F k z)) (F m z)) := by funext z; rfl
    rw [hf]
    exact is_canalytic_at.mul (fun z => cprod m (fun k => F k z)) (F m) z0 (ihm (by intro k hk; exact hF k (by omega))) (hF m (by omega))

-- Reciprocal of a nonvanishing power series (structurally recursive table, 0 axioms!):
-> inv_ps_step (a0_inv : ℂ) (a prev : ℕ → ℂ) (n : ℕ) : ℂ :=
  complex.neg (complex.mul a0_inv (csum (n + 1) (fun j => complex.mul (a (n + 1 - j)) (prev j))))

-> inv_ps_table (a0_inv : ℂ) (a : ℕ → ℂ) : ℕ → (ℕ → ℂ)
  | 0 => fun k => if k = 0 then a0_inv else complex.zero
  | n + 1 => fun k => if k = n + 1 then inv_ps_step a0_inv a (inv_ps_table a0_inv a n) n else inv_ps_table a0_inv a n k

-> inv_ps_coeff (a0_inv : ℂ) (a : ℕ → ℂ) (n : ℕ) : ℂ :=
  inv_ps_table a0_inv a n n

+ inv_ps_table.stable (a0_inv : ℂ) (a : ℕ → ℂ) (k d : ℕ) :
    inv_ps_table a0_inv a (k + d) k = inv_ps_coeff a0_inv a k
  induction d with l ihl
  · have h0 : k + 0 = k := by omega
    rw [h0]; rfl
  · rw [succ_eq_add_one.nat]
    have h1 : k + (l + 1) = (k + l) + 1 := by omega
    rw [h1]
    have hstep : inv_ps_table a0_inv a ((k + l) + 1) k = (if k = (k + l) + 1 then inv_ps_step a0_inv a (inv_ps_table a0_inv a (k + l)) (k + l) else inv_ps_table a0_inv a (k + l) k) := by rfl
    rw [hstep]
    have hne : k ≠ (k + l) + 1 := by omega
    rw [if_neg hne, ihl]

+ inv_ps_coeff.zero (a0_inv : ℂ) (a : ℕ → ℂ) : inv_ps_coeff a0_inv a 0 = a0_inv
  unfold inv_ps_coeff inv_ps_table; simp

+ inv_ps_coeff.succ (a0_inv : ℂ) (a : ℕ → ℂ) (n : ℕ) :
    inv_ps_coeff a0_inv a (n + 1) = complex.neg (complex.mul a0_inv (csum (n + 1) (fun j => complex.mul (a (n + 1 - j)) (inv_ps_coeff a0_inv a j))))
  unfold inv_ps_coeff
  have hstep : inv_ps_table a0_inv a (n + 1) (n + 1) = (if n + 1 = n + 1 then inv_ps_step a0_inv a (inv_ps_table a0_inv a n) n else inv_ps_table a0_inv a n (n + 1)) := by rfl
  have hif : ∀ (u v : ℂ), (if n + 1 = n + 1 then u else v) = u := by intro u v; simp
  rw [hstep, hif]; unfold inv_ps_step
  have hcs : csum (n + 1) (fun j => complex.mul (a (n + 1 - j)) (inv_ps_table a0_inv a n j)) = csum (n + 1) (fun j => complex.mul (a (n + 1 - j)) (inv_ps_coeff a0_inv a j))
    apply csum.congr; intro j hj
    have hn : n = j + (n - j) := by omega
    rw [hn, inv_ps_table.stable a0_inv a j (n - j)]
  unfold inv_ps_coeff at hcs
  rw [hcs]

+ is_cpower_series_at.inv (f : ℂ → ℂ) (z0 : ℂ) (a : ℕ → ℂ) (r : ℝ)
    (hps : is_cpower_series_at f z0 a r) (hne : f z0 ≠ complex.zero) :
    is_canalytic_at (fun z => complex.inv (f z)) z0
  obtain ⟨M, hM, hMaj⟩ := hps.2.1
  have hr := hps.1
  have ha0_eq : a 0 = f z0 := is_cpower_series_at.at_center f z0 a r hps
  have ha0_ne : a 0 ≠ complex.zero := by rw [ha0_eq]; exact hne
  set a0i := complex.inv (a 0) with ha0i
  set b := inv_ps_coeff a0i a with hb
  set A := complex.abs a0i with hA
  have hA_pos : 0 < A
    rw [hA, ha0i, complex.abs_inv_eq (a 0) ha0_ne]
    have hpos : 0 < complex.abs (a 0)
      by_contra hle
      have hz : complex.abs (a 0) = 0 := by linarith [complex.abs_nonneg (a 0)]
      exact ha0_ne ((complex.abs_eq_zero (a 0)).mp hz)
    exact one_div_pos.real (complex.abs (a 0)) hpos
  set q := 1 + A * M with hq
  have hq_ge1 : 1 ≤ q := by rw [hq]; linarith [mul_nonneg.real A M (by linarith) hM]
  set r1 := r / q with hr1
  have hr1_pos : 0 < r1 := by rw [hr1]; exact div_pos.real r q hr (by linarith)
  have hr1_le : r1 ≤ r := by rw [hr1]; exact (div_le_iff.real r r q (by linarith)).mpr (by nlinarith)
  have hpow_add : ∀ (x : ℝ) (j k : ℕ), x ^ (j + k) = x ^ j * x ^ k
    intro x j k; induction k with l ihl
    · have h0 : j + 0 = j := by omega
      rw [h0, pow_zero.real]; ring
    · rw [succ_eq_add_one.nat]
      have h1a : j + (l + 1) = (j + l) + 1 := by omega
      rw [h1a, pow_succ.real, pow_succ.real, ihl]; ring
  -- Inductive bound: |b k| * r1^k <= A for ALL k!
  have hb_bd : ∀ N : ℕ, ∀ k : ℕ, k ≤ N → complex.abs (b k) * r1 ^ k ≤ A
    intro N; induction N with k hk n ihn k hk
    · have hk0 : k = 0 := by omega
      rw [hk0, pow_zero.real, hb, inv_ps_coeff.zero]; linarith
    · rw [succ_eq_add_one.nat] at hk
      by_cases hle : k ≤ n
      · exact ihn k hle
      · have hkeq : k = n + 1 := by omega
        rw [hkeq, hb, inv_ps_coeff.succ, complex.abs_neg, complex.abs_mul, ← hA]
        have hle1 := csum.abs_le_sum (n + 1) (fun j => complex.mul (a (n + 1 - j)) (b j))
        have hterm : ∀ j : ℕ, j < n + 1 → complex.abs (complex.mul (a (n + 1 - j)) (b j)) * r1 ^ (n + 1) ≤ (A * M) * q ^ j / q ^ (n + 1)
          intro j hj
          rw [complex.abs_mul]
          have hjn : j + (n + 1 - j) = n + 1 := by omega
          have hr1_split : r1 ^ (n + 1) = r1 ^ j * (r ^ (n + 1 - j) / q ^ (n + 1 - j))
            have h1 : r1 ^ (n + 1) = r1 ^ j * r1 ^ (n + 1 - j) := by rw [← hpow_add r1 j (n + 1 - j), hjn]
            rw [h1, hr1, pow_div_pow_eq r q (by linarith) (n + 1 - j)]
          rw [hr1_split]
          have hq_sub_pos : 0 < q ^ (n + 1 - j) := rpow_nat_pos q (by linarith) (n + 1 - j)
          have hq_n1_pos : 0 < q ^ (n + 1) := rpow_nat_pos q (by linarith) (n + 1)
          have hq_j_pos : 0 < q ^ j := rpow_nat_pos q (by linarith) j
          have hinv_q : 1 / q ^ (n + 1 - j) = q ^ j / q ^ (n + 1)
            have hprod : q ^ j * q ^ (n + 1 - j) = q ^ (n + 1) := by rw [← hpow_add q j (n + 1 - j), hjn]
            have hc1 := mul_inv_cancel.real (q ^ (n + 1 - j)) (by linarith)
            have hc2 := mul_inv_cancel.real (q ^ (n + 1)) (by linarith)
            have h0 : q ^ (n + 1) * (1 / q ^ (n + 1 - j) - q ^ j / q ^ (n + 1)) = 0
              rw [mul_sub.real, div_def.real (q ^ j) (q ^ (n + 1))]
              have ha1 : q ^ (n + 1) * (q ^ j * (1 / q ^ (n + 1))) = q ^ j * (q ^ (n + 1) * (1 / q ^ (n + 1))) := by ring
              have ha2 : q ^ (n + 1) * (1 / q ^ (n + 1 - j)) = q ^ j * (q ^ (n + 1 - j) * (1 / q ^ (n + 1 - j))) := by rw [← hprod]; ring
              rw [ha1, ha2, hc1, hc2]; ring
            linear_combination (1 / q ^ (n + 1)) * h0 - (1 / q ^ (n + 1 - j) - q ^ j / q ^ (n + 1)) * hc2
          have hre : complex.abs (a (n + 1 - j)) * complex.abs (b j) * (r1 ^ j * (r ^ (n + 1 - j) / q ^ (n + 1 - j))) = (complex.abs (a (n + 1 - j)) * r ^ (n + 1 - j)) * (complex.abs (b j) * r1 ^ j) * (1 / q ^ (n + 1 - j))
            rw [div_def.real (r ^ (n + 1 - j)) (q ^ (n + 1 - j))]; ring
          rw [hre, hinv_q]
          have hm1 := mul_le_mul_of_nonneg_right.real (complex.abs (a (n + 1 - j)) * r ^ (n + 1 - j)) M (complex.abs (b j) * r1 ^ j) (hMaj (n + 1 - j)) (mul_nonneg.real (complex.abs (b j)) (r1 ^ j) (complex.abs_nonneg (b j)) (pow_nonneg.real r1 (by linarith) j))
          have hm2 := mul_le_mul_of_nonneg_left.real (complex.abs (b j) * r1 ^ j) A M (ihn j (by omega)) hM
          have hm3 := mul_le_mul_of_nonneg_right.real ((complex.abs (a (n + 1 - j)) * r ^ (n + 1 - j)) * (complex.abs (b j) * r1 ^ j)) (M * A) (q ^ j / q ^ (n + 1)) (by linarith) (div_nonneg.real (q ^ j) (q ^ (n + 1)) (by linarith) (by linarith))
          rw [div_def.real (q ^ j) (q ^ (n + 1))] at hm3 ⊢
          rw [div_def.real ((A * M) * q ^ j) (q ^ (n + 1))]
          linarith
        have hsc : ∀ m : ℕ, (∑ j < m, complex.abs (complex.mul (a (n + 1 - j)) (b j))) * r1 ^ (n + 1) = ∑ j < m, complex.abs (complex.mul (a (n + 1 - j)) (b j)) * r1 ^ (n + 1)
          intro m; induction m with l ihl
          · rw [sum_below_zero, sum_below_zero]; ring
          · rw [succ_eq_add_one.nat, sum_below_succ, sum_below_succ, ← ihl]; ring
        have hsum_le := sum_le.real (fun j => complex.abs (complex.mul (a (n + 1 - j)) (b j)) * r1 ^ (n + 1)) (fun j => (A * M) * q ^ j / q ^ (n + 1)) (n + 1) hterm
        -- Note (A * M) * sum_{j < n+1} q^j = (q - 1) * sum_{j < n+1} q^j = q^(n+1) - 1 <= q^(n+1)!
        have htele : ∀ m : ℕ, (∑ j < m, (A * M) * q ^ j / q ^ (n + 1)) = (q ^ m - 1) / q ^ (n + 1)
          intro m; induction m with l ihl
          · rw [sum_below_zero, pow_zero.real, div_def.real (1 - 1) (q ^ (n + 1))]; ring
          · rw [succ_eq_add_one.nat, sum_below_succ, ihl, pow_succ.real q l]
            rw [div_def.real (q ^ l - 1) (q ^ (n + 1)), div_def.real ((A * M) * q ^ l) (q ^ (n + 1)), div_def.real (q ^ l * q - 1) (q ^ (n + 1)), hq]; ring
        rw [htele (n + 1)] at hsum_le
        have hle_one : (q ^ (n + 1) - 1) / q ^ (n + 1) ≤ 1
          exact (div_le_iff.real (q ^ (n + 1) - 1) 1 (q ^ (n + 1)) (rpow_nat_pos q (by linarith) (n + 1))).mpr (by linarith)
        have hcs_bd : complex.abs (csum (n + 1) (fun j => complex.mul (a (n + 1 - j)) (b j))) * r1 ^ (n + 1) ≤ 1
          have hm := mul_le_mul_of_nonneg_right.real (complex.abs (csum (n + 1) (fun j => complex.mul (a (n + 1 - j)) (b j)))) (∑ j < n + 1, complex.abs (complex.mul (a (n + 1 - j)) (b j))) (r1 ^ (n + 1)) hle1 (pow_nonneg.real r1 (by linarith) (n + 1))
          linarith [hsc (n + 1)]
        have hmA := mul_le_mul_of_nonneg_left.real (complex.abs (csum (n + 1) (fun j => complex.mul (a (n + 1 - j)) (b j))) * r1 ^ (n + 1)) 1 A hcs_bd (by linarith)
        rw [← hb]
        have hre : A * complex.abs (csum (n + 1) (fun j => complex.mul (a (n + 1 - j)) (b j))) * r1 ^ (n + 1) = A * (complex.abs (csum (n + 1) (fun j => complex.mul (a (n + 1 - j)) (b j))) * r1 ^ (n + 1)) := by ring
        rw [hre]; linarith
  -- Define g(z) = clim (sum b_k (z - z0)^k) on |z - z0| < r1!
  set g := (fun (z : ℂ) => clim (fun N => csum N (fun k => complex.mul (b k) (cpow_nat (complex.sub z z0) k)))) with hg
  have hg_ps : is_cpower_series_at g z0 b r1
    unfold is_cpower_series_at
    constructor; exact hr1_pos
    constructor
    · use A; constructor; linarith; intro k; exact hb_bd k k (by omega)
    · intro z hz
      set qz := complex.abs (complex.sub z z0) / r1 with hqz
      have hqz0 : 0 ≤ qz := by rw [hqz]; exact div_nonneg.real (complex.abs (complex.sub z z0)) r1 (complex.abs_nonneg (complex.sub z z0)) (by linarith)
      have hqz1 : qz < 1 := by rw [hqz]; exact (div_lt_iff.real (complex.abs (complex.sub z z0)) 1 r1 hr1_pos).mpr (by linarith)
      have hcs : csummable (fun k => complex.mul (b k) (cpow_nat (complex.sub z z0) k))
        apply csummable.of_abs_summable
        apply summable.of_nonneg_le (fun k => complex.abs (complex.mul (b k) (cpow_nat (complex.sub z z0) k))) (fun k => A * qz ^ k)
        · intro k; exact complex.abs_nonneg (complex.mul (b k) (cpow_nat (complex.sub z z0) k))
        · intro k; rw [complex.abs_mul, cpow_nat.abs_eq, hqz, pow_div_pow_eq (complex.abs (complex.sub z z0)) r1 hr1_pos k]
          have hrk := rpow_nat_pos r1 hr1_pos k
          have hc := mul_inv_cancel.real (r1 ^ k) (by linarith)
          have hm := mul_le_mul_of_nonneg_right.real (complex.abs (b k) * r1 ^ k) A (complex.abs (complex.sub z z0) ^ k / r1 ^ k) (hb_bd k k (by omega)) (div_nonneg.real (complex.abs (complex.sub z z0) ^ k) (r1 ^ k) (pow_nonneg.real (complex.abs (complex.sub z z0)) (complex.abs_nonneg (complex.sub z z0)) k) (by linarith))
          have hre : complex.abs (b k) * r1 ^ k * (complex.abs (complex.sub z z0) ^ k / r1 ^ k) = complex.abs (b k) * complex.abs (complex.sub z z0) ^ k
            rw [div_def.real (complex.abs (complex.sub z z0) ^ k) (r1 ^ k)]; linear_combination (complex.abs (b k) * complex.abs (complex.sub z z0) ^ k) * hc
          linarith
        · exact geom_summable A qz (by linarith) hqz0 hqz1
      unfold csummable cconverges at hcs; obtain ⟨L, hL⟩ := hcs
      rw [hg]; rw [clim.eq_of_tends_to (fun N => csum N (fun k => complex.mul (b k) (cpow_nat (complex.sub z z0) k))) L hL]; exact hL
  -- Cauchy product of a and b equals (1, 0, 0, ...) => f z * g z = 1 on |z - z0| < r1 / 2!
  have hprod_ps := is_cpower_series_at.mul f g z0 a b r r1 hps hg_ps
  have hmin : min r r1 = r1 := le_antisymm.real (min r r1) r1 (min_le_right.real r r1) (le_min.real r r1 r1 (by linarith) (by linarith))
  rw [hmin] at hprod_ps
  have hcp0 : cauchy_prod a b 0 = complex.one
    unfold cauchy_prod
    have h1 : csum 1 (fun j => complex.mul (a j) (b (0 - j))) = complex.add (csum 0 (fun j => complex.mul (a j) (b (0 - j)))) (complex.mul (a 0) (b (0 - 0))) := by rfl
    rw [h1, csum.zero, complex.zero_add]; simp; rw [hb, inv_ps_coeff.zero, ha0i]
    exact complex.mul_inv_cancel (a 0) ha0_ne
  have hcp_succ : ∀ n : ℕ, cauchy_prod a b (n + 1) = complex.zero
    intro n; unfold cauchy_prod
    have hsplit_last : csum (n + 2) (fun j => complex.mul (a j) (b (n + 1 - j))) = complex.add (complex.mul (a 0) (b (n + 1))) (csum (n + 1) (fun j => complex.mul (a (n + 1 - j)) (b j)))
      have h1 := csum.shift_zero (fun j => complex.mul (a j) (b (n + 1 - j))) (n + 1)
      have h21 : n + 1 + 1 = n + 2 := by omega
      rw [h21] at h1
      have h0 : n + 1 - 0 = n + 1 := by omega
      rw [h1, h0]
      have hrev := csum.rev_idx (fun j => complex.mul (a (j + 1)) (b (n + 1 - (j + 1)))) (n + 1)
      rw [← hrev]
      have hcon : csum (n + 1) (fun j => (fun j1 => complex.mul (a (j1 + 1)) (b (n + 1 - (j1 + 1)))) (n + 1 - 1 - j)) = csum (n + 1) (fun j => complex.mul (a (n + 1 - j)) (b j))
        apply csum.congr; intro j hj
        have ha1 : n + 1 - 1 - j + 1 = n + 1 - j := by omega
        have hb1 : n + 1 - (n + 1 - j) = j := by omega
        simp [ha1, hb1]
      rw [hcon]
    have h21 : n + 1 + 1 = n + 2 := by omega
    rw [h21, hsplit_last]
    rw [hb, inv_ps_coeff.succ, ha0i]
    have hcan := complex.mul_inv_cancel (a 0) ha0_ne
    have hre : complex.mul (a 0) (complex.neg (complex.mul (complex.inv (a 0)) (csum (n + 1) (fun j => complex.mul (a (n + 1 - j)) (inv_ps_coeff (complex.inv (a 0)) a j))))) = complex.neg (complex.mul (complex.mul (a 0) (complex.inv (a 0))) (csum (n + 1) (fun j => complex.mul (a (n + 1 - j)) (inv_ps_coeff (complex.inv (a 0)) a j))))
      apply complex.ext <;> simp <;> ring
    rw [hre, hcan, complex.one_mul]; apply complex.ext <;> simp <;> ring
  have hfg_eq : ∀ z : ℂ, complex.abs (complex.sub z z0) < r1 / 2 → g z = complex.inv (f z)
    intro z hz
    have hlim := hprod_ps.2.2 z hz
    have hconst : ctends_to (fun N => csum N (fun k => complex.mul (cauchy_prod a b k) (cpow_nat (complex.sub z z0) k))) complex.one
      unfold ctends_to; intro e he; use 1; intro N hN
      have hN1 : N = (N - 1) + 1 := by omega
      rw [hN1, csum.shift_zero (fun k => complex.mul (cauchy_prod a b k) (cpow_nat (complex.sub z z0) k)) (N - 1)]
      have h0 : complex.mul (cauchy_prod a b 0) (cpow_nat (complex.sub z z0) 0) = complex.one
        rw [hcp0]; unfold cpow_nat; exact complex.mul_one complex.one
      have htail : csum (N - 1) (fun j => complex.mul (cauchy_prod a b (j + 1)) (cpow_nat (complex.sub z z0) (j + 1))) = complex.zero
        have hgen : ∀ M : ℕ, csum M (fun j => complex.mul (cauchy_prod a b (j + 1)) (cpow_nat (complex.sub z z0) (j + 1))) = complex.zero
          intro M; induction M with m ihm
          · rw [csum.zero]
          · rw [succ_eq_add_one.nat, csum.succ, ihm, hcp_succ m, complex.zero_mul, complex.add_zero]
        exact hgen (N - 1)
      rw [h0, htail, complex.add_zero, complex.sub_self, complex.abs_zero]; exact he
    have hfg1 : complex.mul (f z) (g z) = complex.one := (ctends_to.unique (fun N => csum N (fun k => complex.mul (cauchy_prod a b k) (cpow_nat (complex.sub z z0) k))) complex.one (complex.mul (f z) (g z)) hconst hlim).symm
    have hfz_ne : f z ≠ complex.zero
      intro h0; rw [h0, complex.zero_mul] at hfg1; exact complex.one_ne_zero hfg1.symm
    have hcan := complex.mul_inv_cancel (f z) hfz_ne
    have h1 : complex.mul (complex.inv (f z)) (complex.mul (f z) (g z)) = complex.mul (complex.inv (f z)) complex.one := by rw [hfg1]
    have h2 : complex.mul (complex.inv (f z)) (complex.mul (f z) (g z)) = complex.mul (complex.mul (f z) (complex.inv (f z))) (g z)
      apply complex.ext <;> simp <;> ring
    rw [h2, hcan, complex.one_mul, complex.mul_one] at h1; exact h1
  have hg_sh := is_cpower_series_at.shrink g z0 b r1 (r1 / 2) hg_ps (by linarith) (by linarith)
  unfold is_canalytic_at
  exact ⟨b, r1 / 2, is_cpower_series_at.congr g (fun z => complex.inv (f z)) z0 b (r1 / 2) hg_sh hfg_eq⟩

+ is_canalytic_at.inv (f : ℂ → ℂ) (z0 : ℂ) (hf : is_canalytic_at f z0) (hne : f z0 ≠ complex.zero) :
    is_canalytic_at (fun z => complex.inv (f z)) z0
  unfold is_canalytic_at at hf
  obtain ⟨a, r, hps⟩ := hf
  exact is_cpower_series_at.inv f z0 a r hps hne

