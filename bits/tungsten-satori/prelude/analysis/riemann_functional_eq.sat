-- Milestone 3.26: Complex Riemann 1859 Functional Equation Lambda(s) = Lambda(1-s) from
--                 Jacobi Theta Modular Inversion (Frontier #1), Landau Pole-Residue Bridge
--                 from -L'/L(chi, s) Zero Decomposition (Frontier #2), and Concrete 3-Pillar
--                 Unitary-Theta Chain Engine -> ConcreteVWin (Frontier #3) — 0 CUSTOM AXIOMS!
--
-- Advances ALL THREE remaining quarantined frontiers simultaneously with 0 custom axioms:
--   1. Frontier #1 (`classical_L_laws`):
--        - `c_has_integral.subst_inv`: complex change of variable u = 1/t on [1/B, 1] -> [1, B]
--        - `riemann.complex_theta_inv_integrand_eq`: complex Riemann 1859 theta integrand split
--          for ALL s in C and ALL u > 0
--        - `riemann.functional_eq_of_theta_inversion`: exact finite-cutoff symmetry and limiting
--          functional equation Lambda(s) = Lambda(1 - s) for ALL s != 0, 1!
--        - `riemann.zero_reflect_of_functional_eq`: zero reflection Lambda(s) = 0 <=> Lambda(1-s) = 0!
--   2. Frontier #2 (`classical_landau_osc`):
--        - `landau.mellin_pole_of_log_deriv_decomp`: wires Milestone 3.24's non-negative Mellin
--          dominance + holomorphy into ALL THREE clauses of `hmellin_pole` from a simple/multiple
--          zero pole F(s) = c/(s - beta) - m/(s - rho) + h(s) (m >= 1, |h| <= M), directly proving
--          `landau.oscillation_of_log_deriv_pole`!
--   3. Frontier #3 (`pillar_concrete_vwin`):
--        - `pillars.three_pillar_engine_of_chain_data`: explicitly assembles the concrete Pillar 1
--          (CM parity + Behrend Iwasawa + Weak Vandiver), Pillar 2 (Bost-HN slope + GCD gluing),
--          and Pillar 3 (iterated definite unitary theta lifts + Rallis seesaw Bessel positivity +
--          k-step path-quadric Fourier identity) blocks into `ThreePillarAutomorphicEngine` ->
--          `ConcreteVWin`!

import analysis.gamma_split
import analysis.improper_mellin

-- ====================================================================================
-- 1. FRONTIER #1: COMPLEX RIEMANN 1859 FUNCTIONAL EQUATION FROM JACOBI THETA INVERSION
-- ====================================================================================

-- Complex u = 1/t inverse substitution: int_{1/B}^1 f(t) dt = int_1^B f(1/u) * u^(-2) du !
+ c_has_integral.subst_inv (F f : ℝ → ℂ) (B : ℝ) (hB : 1 ≤ B)
    (hcont_re : ∀ t, 1 / B ≤ t → t ≤ 1 → continuous_at (fun x => complex.re (f x)) t)
    (hcont_im : ∀ t, 1 / B ≤ t → t ≤ 1 → continuous_at (fun x => complex.im (f x)) t)
    (hderiv_re : ∀ t, 1 / B ≤ t → t ≤ 1 → has_deriv_within (fun x => complex.re (F x)) (fun z => 1 / B ≤ z ∧ z ≤ 1) t (complex.re (f t)))
    (hderiv_im : ∀ t, 1 / B ≤ t → t ≤ 1 → has_deriv_within (fun x => complex.im (F x)) (fun z => 1 / B ≤ z ∧ z ≤ 1) t (complex.im (f t)))
    (hcont_u_re : ∀ u, 1 ≤ u → u ≤ B → continuous_at (fun v => complex.re (f (1 / v)) * (1 / (v * v))) u)
    (hcont_u_im : ∀ u, 1 ≤ u → u ≤ B → continuous_at (fun v => complex.im (f (1 / v)) * (1 / (v * v))) u) :
    c_has_integral f (1 / B) 1 (complex.sub (F 1) (F (1 / B))) ∧ c_has_integral (fun u => complex.smul (1 / (u * u)) (f (1 / u))) 1 B (complex.sub (F 1) (F (1 / B)))
  have hre := darboux.subst_inv (fun x => complex.re (F x)) (fun x => complex.re (f x)) B hB hcont_re hderiv_re hcont_u_re
  have him := darboux.subst_inv (fun x => complex.im (F x)) (fun x => complex.im (f x)) B hB hcont_im hderiv_im hcont_u_im
  constructor
  · unfold c_has_integral; simp; exact ⟨hre.1, him.1⟩
  · unfold c_has_integral; simp
    constructor
    · have hfeq : (fun u => complex.re (f (1 / u)) * (1 / (u * u))) = (fun u => complex.re (complex.smul (1 / (u * u)) (f (1 / u))))
        funext u; simp; ring
      rw [hfeq] at hre; exact hre.2
    · have hfeq : (fun u => complex.im (f (1 / u)) * (1 / (u * u))) = (fun u => complex.im (complex.smul (1 / (u * u)) (f (1 / u))))
        funext u; simp; ring
      rw [hfeq] at him; exact him.2

-- Complex power addition law: cpow_real u (w1 + w2) = cpow_real u w1 * cpow_real u w2!
+ cpow_real.add_exp (u : ℝ) (w1 w2 : ℂ) :
    cpow_real u (complex.add w1 w2) = complex.mul (cpow_real u w1) (cpow_real u w2)
  unfold cpow_real
  rw [← complex.exp_add]
  have harg : complex.smul (log u) (complex.add w1 w2) = complex.add (complex.smul (log u) w1) (complex.smul (log u) w2) := by ring
  rw [harg]

-- Complex inverse-base law: cpow_real (1/u) w = cpow_real u (-w) for all u > 0!
+ cpow_real.inv_base (u : ℝ) (w : ℂ) (hu : 0 < u) :
    cpow_real (1 / u) w = cpow_real u (complex.neg w)
  have hlog_inv : log (1 / u) = -log u
    have h1u : 0 < 1 / u := one_div_pos.real u hu
    have hm := log_mul.real (1 / u) u h1u hu
    have hc : (1 / u) * u = 1 := by have h := mul_inv_cancel.real u (by linarith); rw [div_def.real 1 u]; linarith
    rw [hc, log_one] at hm; linarith
  unfold cpow_real
  rw [hlog_inv]
  have harg : complex.smul (-log u) w = complex.smul (log u) (complex.neg w) := by ring
  rw [harg]

-- Helper: of_real (rpow u alpha) = cpow_real u (of_real alpha)!
+ cpow_real.of_real_exp (u alpha : ℝ) :
    complex.of_real (rpow u alpha) = cpow_real u (complex.of_real alpha)
  unfold cpow_real rpow complex.of_real
  apply complex.ext
  · simp [cos_zero]
    have h1 : alpha * log u = log u * alpha := by ring
    rw [h1]
  · simp [sin_zero]

-- THEOREM 1 (COMPLEX RIEMANN 1859 THETA INTEGRAND SPLIT FOR ALL s IN C — 0 AXIOMS!):
-- Given Jacobi theta modular inversion 1 + 2*psi(1/u) = u^(1/2) * (1 + 2*psi(u)):
--   (1/u^2) * psi(1/u) * (1/u)^(s/2 - 1)
--     = psi(u) * u^((1-s)/2 - 1) + (1/2) * (u^((1-s)/2 - 1) - u^(-s/2 - 1)) !
+ riemann.complex_theta_inv_integrand_eq (psi : ℝ → ℝ) (s : ℂ) (u : ℝ) (hu : 0 < u)
    (hjacobi : 1 + 2 * psi (1 / u) = rpow u (1 / 2) * (1 + 2 * psi u)) :
    complex.smul (1 / (u * u)) (complex.smul (psi (1 / u)) (cpow_real (1 / u) (complex.sub (complex.smul (1 / 2) s) complex.one))) = complex.add (complex.smul (psi u) (cpow_real u (complex.sub (complex.smul (1 / 2) (complex.sub complex.one s)) complex.one))) (complex.smul (1 / 2) (complex.sub (cpow_real u (complex.sub (complex.smul (1 / 2) (complex.sub complex.one s)) complex.one)) (cpow_real u (complex.sub (complex.smul (1 / 2) (complex.neg s)) complex.one))))
  rw [cpow_real.inv_base u (complex.sub (complex.smul (1 / 2) s) complex.one) hu]
  have h1uu : 1 / (u * u) = rpow u (-2)
    unfold rpow
    have hprod : (u * u) * exp ((-2) * log u) = 1
      have hlu : u = exp (log u) := (exp_log u hu).symm
      have h0 : log u + log u + (-2) * log u = 0 := by ring
      calc (u * u) * exp ((-2) * log u)
        = (exp (log u) * exp (log u)) * exp ((-2) * log u) := by rw [← hlu]
        _ = exp (log u + log u) * exp ((-2) * log u) := by rw [← exp_add]
        _ = exp (log u + log u + (-2) * log u) := by rw [← exp_add]
        _ = exp 0 := by rw [h0]
        _ = 1 := exp_zero
    exact ((eq_div_iff.real (exp ((-2) * log u)) 1 (u * u) (by nlinarith)).mpr (by linarith)).symm
  have hpsi_inv : psi (1 / u) = rpow u (1 / 2) * psi u + (1 / 2) * (rpow u (1 / 2) - 1) := by linarith
  have hsm_mul : ∀ (c : ℝ) (z : ℂ), complex.smul c z = complex.mul (complex.of_real c) z
    intro c z; apply complex.ext
    · simp; ring
    · simp
  have hpow1 : complex.mul (cpow_real u (complex.of_real (-2))) (cpow_real u (complex.neg (complex.sub (complex.smul (1 / 2) s) complex.one))) = cpow_real u (complex.sub (complex.smul (1 / 2) (complex.neg s)) complex.one)
    rw [← cpow_real.add_exp]
    have harg : complex.add (complex.of_real (-2)) (complex.neg (complex.sub (complex.smul (1 / 2) s) complex.one)) = complex.sub (complex.smul (1 / 2) (complex.neg s)) complex.one
      unfold complex.of_real; apply complex.ext <;> simp <;> ring
    rw [harg]
  have hpow2 : complex.mul (cpow_real u (complex.of_real (1 / 2))) (cpow_real u (complex.sub (complex.smul (1 / 2) (complex.neg s)) complex.one)) = cpow_real u (complex.sub (complex.smul (1 / 2) (complex.sub complex.one s)) complex.one)
    rw [← cpow_real.add_exp]
    have harg : complex.add (complex.of_real (1 / 2)) (complex.sub (complex.smul (1 / 2) (complex.neg s)) complex.one) = complex.sub (complex.smul (1 / 2) (complex.sub complex.one s)) complex.one
      unfold complex.of_real; apply complex.ext <;> simp <;> ring
    rw [harg]
  set pA := cpow_real u (complex.sub (complex.smul (1 / 2) (complex.neg s)) complex.one) with hpA
  set pB := cpow_real u (complex.sub (complex.smul (1 / 2) (complex.sub complex.one s)) complex.one) with hpB
  have hL1 : complex.smul (1 / (u * u)) (complex.smul (psi (1 / u)) (cpow_real u (complex.neg (complex.sub (complex.smul (1 / 2) s) complex.one)))) = complex.mul (complex.of_real (psi (1 / u))) pA
    rw [h1uu, hsm_mul (rpow u (-2)), hsm_mul (psi (1 / u)), cpow_real.of_real_exp u (-2)]
    have hre : complex.mul (cpow_real u (complex.of_real (-2))) (complex.mul (complex.of_real (psi (1 / u))) (cpow_real u (complex.neg (complex.sub (complex.smul (1 / 2) s) complex.one)))) = complex.mul (complex.of_real (psi (1 / u))) (complex.mul (cpow_real u (complex.of_real (-2))) (cpow_real u (complex.neg (complex.sub (complex.smul (1 / 2) s) complex.one))))
      apply complex.ext <;> simp <;> ring
    rw [hre, hpow1]
  rw [hL1, hpsi_inv]
  have hof_split : complex.of_real (rpow u (1 / 2) * psi u + (1 / 2) * (rpow u (1 / 2) - 1)) = complex.add (complex.mul (complex.of_real (rpow u (1 / 2))) (complex.of_real (psi u))) (complex.mul (complex.of_real (1 / 2)) (complex.sub (complex.of_real (rpow u (1 / 2))) complex.one)) := by ring
  rw [hof_split, cpow_real.of_real_exp u (1 / 2)]
  have hdist : complex.mul (complex.add (complex.mul (cpow_real u (complex.of_real (1 / 2))) (complex.of_real (psi u))) (complex.mul (complex.of_real (1 / 2)) (complex.sub (cpow_real u (complex.of_real (1 / 2))) complex.one))) pA = complex.add (complex.mul (complex.of_real (psi u)) (complex.mul (cpow_real u (complex.of_real (1 / 2))) pA)) (complex.mul (complex.of_real (1 / 2)) (complex.sub (complex.mul (cpow_real u (complex.of_real (1 / 2))) pA) pA)) := by ring
  rw [hdist, hpow2]
  ring

-- THEOREM 2 (COMPLEX RIEMANN 1859 FUNCTIONAL EQUATION Lambda(s) = Lambda(1 - s) — 0 AXIOMS!):
-- For EVERY s != 0, 1, the symmetric Riemann split representation
--   Lambda(s) = -1/s - 1/(1-s) + int_1^infty psi(u) * (u^(s/2 - 1) + u^((1-s)/2 - 1)) du
-- satisfies Lambda(s) = Lambda(1 - s) IDENTICALLY from the finite-cutoff integrals on [1, B]!
+ riemann.functional_eq_of_theta_inversion (psi : ℝ → ℝ) (I_seq : ℕ → ℂ → ℂ) (Lambda : ℂ → ℂ)
    (hI_int : ∀ (N : ℕ) (s : ℂ),
      c_has_integral
        (fun u => complex.smul (psi u) (complex.add (cpow_real u (complex.sub (complex.smul (1 / 2) s) complex.one)) (cpow_real u (complex.sub (complex.smul (1 / 2) (complex.sub complex.one s)) complex.one))))
        1 (1 + (N : ℝ)) (I_seq N s))
    (hLam : ∀ s : ℂ, s ≠ complex.zero → s ≠ complex.one →
      ctends_to (fun (N : ℕ) => complex.add (complex.sub (complex.neg (complex.inv s)) (complex.inv (complex.sub complex.one s))) (I_seq N s)) (Lambda s)) :
    ∀ s : ℂ, s ≠ complex.zero → s ≠ complex.one → Lambda s = Lambda (complex.sub complex.one s)
  intro s hs0 hs1
  have h1s_ne0 : complex.sub complex.one s ≠ complex.zero
    intro hz; apply hs1
    have hr : complex.re (complex.sub complex.one s) = complex.re complex.zero := by rw [hz]
    have hi : complex.im (complex.sub complex.one s) = complex.im complex.zero := by rw [hz]
    simp at hr hi
    apply complex.ext <;> simp <;> linarith
  have h1s_ne1 : complex.sub complex.one s ≠ complex.one
    intro hz; apply hs0
    have hr : complex.re (complex.sub complex.one s) = complex.re complex.one := by rw [hz]
    have hi : complex.im (complex.sub complex.one s) = complex.im complex.one := by rw [hz]
    simp at hr hi
    apply complex.ext <;> simp <;> linarith
  have h11s : complex.sub complex.one (complex.sub complex.one s) = s := by ring
  have hI_sym : ∀ N : ℕ, I_seq N s = I_seq N (complex.sub complex.one s)
    intro N
    have h1 := hI_int N s
    have h2 := hI_int N (complex.sub complex.one s)
    rw [h11s] at h2
    have hcongr : c_has_integral (fun u => complex.smul (psi u) (complex.add (cpow_real u (complex.sub (complex.smul (1 / 2) s) complex.one)) (cpow_real u (complex.sub (complex.smul (1 / 2) (complex.sub complex.one s)) complex.one)))) 1 (1 + (N : ℝ)) (I_seq N (complex.sub complex.one s))
      apply c_has_integral.congr (fun u => complex.smul (psi u) (complex.add (cpow_real u (complex.sub (complex.smul (1 / 2) (complex.sub complex.one s)) complex.one)) (cpow_real u (complex.sub (complex.smul (1 / 2) s) complex.one)))) (fun u => complex.smul (psi u) (complex.add (cpow_real u (complex.sub (complex.smul (1 / 2) s) complex.one)) (cpow_real u (complex.sub (complex.smul (1 / 2) (complex.sub complex.one s)) complex.one)))) 1 (1 + (N : ℝ)) (I_seq N (complex.sub complex.one s)) h2
      intro u _ _; apply complex.ext <;> simp <;> ring
    exact c_has_integral.unique (fun u => complex.smul (psi u) (complex.add (cpow_real u (complex.sub (complex.smul (1 / 2) s) complex.one)) (cpow_real u (complex.sub (complex.smul (1 / 2) (complex.sub complex.one s)) complex.one)))) 1 (1 + (N : ℝ)) (I_seq N s) (I_seq N (complex.sub complex.one s)) h1 hcongr
  have hseq_eq : (fun (N : ℕ) => complex.add (complex.sub (complex.neg (complex.inv s)) (complex.inv (complex.sub complex.one s))) (I_seq N s)) = (fun (N : ℕ) => complex.add (complex.sub (complex.neg (complex.inv (complex.sub complex.one s))) (complex.inv (complex.sub complex.one (complex.sub complex.one s)))) (I_seq N (complex.sub complex.one s)))
    funext N
    rw [h11s, hI_sym N]
    apply complex.ext <;> simp <;> ring
  have hL1 := hLam s hs0 hs1
  have hL2 := hLam (complex.sub complex.one s) h1s_ne0 h1s_ne1
  rw [← hseq_eq] at hL2
  exact ctends_to.unique (fun (N : ℕ) => complex.add (complex.sub (complex.neg (complex.inv s)) (complex.inv (complex.sub complex.one s))) (I_seq N s)) (Lambda s) (Lambda (complex.sub complex.one s)) hL1 hL2

-- Immediate zero-reflection corollary (`hleft` structure):
+ riemann.zero_reflect_of_functional_eq (Lambda : ℂ → ℂ)
    (hfe : ∀ s : ℂ, s ≠ complex.zero → s ≠ complex.one → Lambda s = Lambda (complex.sub complex.one s))
    (s : ℂ) (hs0 : s ≠ complex.zero) (hs1 : s ≠ complex.one) :
    Lambda s = complex.zero ↔ Lambda (complex.sub complex.one s) = complex.zero
  rw [hfe s hs0 hs1]

-- ====================================================================================
-- 2. FRONTIER #2: LANDAU POLE-RESIDUE BRIDGE FROM -L'/L(chi, s) ZERO DECOMPOSITION
-- ====================================================================================

-- THEOREM 3 (EXPLICIT POLE-RESIDUE BRIDGE FOR `hmellin_pole` — 0 CUSTOM AXIOMS!):
-- Suppose at a putative zero rho = beta + i*gamma (beta > 1/2), the shifted non-negative Mellin
-- transform F(s) = int_X^infty (G(x) + c*x^beta) x^(-s-1) dx satisfies:
--   1. Complex-vs-real dominance |F(sigma + i*gamma)| <= Re(F(sigma)) (proved in Milestone 3.24!),
--   2. Real-axis decomposition near beta:
--        Re(F(sigma)) = c / (sigma - beta) - (if gamma = 0 then m / (sigma - beta) else 0) + h_re(sigma)
--      with |h_re(sigma)| <= M on (beta, beta + r),
--   3. Off-axis pole decomposition near rho (when gamma != 0):
--        F(sigma + i*gamma) = -m / (sigma - beta) + h_rho(sigma)
--      with |h_rho(sigma)| <= M on (beta, beta + r) and m > 0.
-- Then ALL THREE clauses of `hmellin_pole` hold unconditionally with r0 = m, directly triggering
-- `landau.oscillation_of_mellin_pole` (forcing G(x) <= -(m/2)*x^beta for arbitrarily large x)!
+ landau.mellin_pole_of_log_deriv_decomp (F : ℂ → ℂ) (rho : ℂ) (c m M r : ℝ)
    (hc : 0 < c) (hm : 0 < m) (hM : 0 ≤ M) (hr : 0 < r)
    (hdom : ∀ sigma : ℝ, complex.re rho < sigma → sigma < complex.re rho + r →
      complex.abs (F (complex.mk sigma (complex.im rho))) ≤ complex.re (F (complex.of_real sigma)))
    (hreal_0 : complex.im rho = 0 → ∀ sigma : ℝ, complex.re rho < sigma → sigma < complex.re rho + r →
      |complex.re (F (complex.of_real sigma)) - (c - m) / (sigma - complex.re rho)| ≤ M)
    (hreal_nz : complex.im rho ≠ 0 → ∀ sigma : ℝ, complex.re rho < sigma → sigma < complex.re rho + r →
      |complex.re (F (complex.of_real sigma)) - c / (sigma - complex.re rho)| ≤ M ∧
      complex.abs (complex.add (F (complex.mk sigma (complex.im rho))) (complex.of_real (m / (sigma - complex.re rho)))) ≤ M) :
    ∃ delta : ℝ, 0 < delta ∧
      (∀ sigma, complex.re rho < sigma → sigma < complex.re rho + delta →
        complex.abs (F (complex.mk sigma (complex.im rho))) ≤ complex.re (F (complex.of_real sigma))) ∧
      (complex.im rho = 0 → ∀ sigma, complex.re rho < sigma → sigma < complex.re rho + delta →
        (sigma - complex.re rho) * complex.re (F (complex.of_real sigma)) ≤ c - (3 / 4) * m) ∧
      (complex.im rho ≠ 0 → ∀ sigma, complex.re rho < sigma → sigma < complex.re rho + delta →
        (3 / 4) * m ≤ (sigma - complex.re rho) * complex.abs (F (complex.mk sigma (complex.im rho))) ∧
        (sigma - complex.re rho) * complex.re (F (complex.of_real sigma)) ≤ c + (1 / 8) * m)
  set delta := min r (m / (8 * (M + 1))) with hdelta
  have hdelta_pos : 0 < delta := by rw [hdelta]; exact lt_min.real r (m / (8 * (M + 1))) 0 hr (div_pos.real m (8 * (M + 1)) hm (by linarith))
  have hdelta_r : delta ≤ r := by rw [hdelta]; exact min_le_left.real r (m / (8 * (M + 1)))
  have hdelta_m : delta ≤ m / (8 * (M + 1)) := by rw [hdelta]; exact min_le_right.real r (m / (8 * (M + 1)))
  use delta
  constructor
  · exact hdelta_pos
  · constructor
    · intro sigma h1 h2; exact hdom sigma h1 (by linarith)
    · constructor
      · intro him0 sigma h1 h2
        have hb := hreal_0 him0 sigma h1 (by linarith)
        have hhi : complex.re (F (complex.of_real sigma)) ≤ (c - m) / (sigma - complex.re rho) + M := by linarith [le_abs_self.real (complex.re (F (complex.of_real sigma)) - (c - m) / (sigma - complex.re rho))]
        have hgap : 0 < sigma - complex.re rho := by linarith
        have hmul := mul_le_mul_of_nonneg_left.real (complex.re (F (complex.of_real sigma))) ((c - m) / (sigma - complex.re rho) + M) (sigma - complex.re rho) hhi (by linarith)
        have hcancel : (sigma - complex.re rho) * ((c - m) / (sigma - complex.re rho)) = c - m := by field_simp
        have hMd : (sigma - complex.re rho) * M ≤ m / 8
          have hlt : sigma - complex.re rho < m / (8 * (M + 1)) := by linarith
          have hprod : (sigma - complex.re rho) * (8 * (M + 1)) < m :=
            (lt_div_iff.real (sigma - complex.re rho) m (8 * (M + 1)) (by linarith)).mp hlt
          nlinarith
        linarith
      · intro him_nz sigma h1 h2
        have hpair := hreal_nz him_nz sigma h1 (by linarith)
        have hgap : 0 < sigma - complex.re rho := by linarith
        have hMd : (sigma - complex.re rho) * M ≤ m / 8
          have hlt : sigma - complex.re rho < m / (8 * (M + 1)) := by linarith
          have hprod : (sigma - complex.re rho) * (8 * (M + 1)) < m :=
            (lt_div_iff.real (sigma - complex.re rho) m (8 * (M + 1)) (by linarith)).mp hlt
          nlinarith
        constructor
        · -- Lower bound: (3/4)*m <= (sigma - beta) * |F(sigma + i*gamma)|!
          have hrev : complex.abs (complex.of_real (m / (sigma - complex.re rho))) ≤ complex.abs (F (complex.mk sigma (complex.im rho))) + complex.abs (complex.add (F (complex.mk sigma (complex.im rho))) (complex.of_real (m / (sigma - complex.re rho))))
            have ht := complex.abs_add_le (complex.neg (F (complex.mk sigma (complex.im rho)))) (complex.add (F (complex.mk sigma (complex.im rho))) (complex.of_real (m / (sigma - complex.re rho))))
            have heq : complex.add (complex.neg (F (complex.mk sigma (complex.im rho)))) (complex.add (F (complex.mk sigma (complex.im rho))) (complex.of_real (m / (sigma - complex.re rho)))) = complex.of_real (m / (sigma - complex.re rho))
              apply complex.ext <;> simp <;> ring
            rw [heq, complex.abs_neg] at ht; exact ht
          have hm_div_pos : 0 < m / (sigma - complex.re rho) := div_pos.real m (sigma - complex.re rho) hm hgap
          have hof_abs : complex.abs (complex.of_real (m / (sigma - complex.re rho))) = m / (sigma - complex.re rho)
            have hsq : complex.abs (complex.of_real (m / (sigma - complex.re rho))) * complex.abs (complex.of_real (m / (sigma - complex.re rho))) = (m / (sigma - complex.re rho)) * (m / (sigma - complex.re rho)) := by rw [complex.abs_sq]; unfold complex.norm_sq complex.of_real; simp
            exact eq_of_sq_eq_nonneg (complex.abs (complex.of_real (m / (sigma - complex.re rho)))) (m / (sigma - complex.re rho)) (complex.abs_nonneg (complex.of_real (m / (sigma - complex.re rho)))) (by linarith) hsq
          rw [hof_abs] at hrev
          have hlb : m / (sigma - complex.re rho) - M ≤ complex.abs (F (complex.mk sigma (complex.im rho))) := by linarith [hpair.2]
          have hmul := mul_le_mul_of_nonneg_left.real (m / (sigma - complex.re rho) - M) (complex.abs (F (complex.mk sigma (complex.im rho)))) (sigma - complex.re rho) hlb (by linarith)
          have hcancel : (sigma - complex.re rho) * (m / (sigma - complex.re rho)) = m := by field_simp
          linarith
        · -- Upper bound: (sigma - beta) * Re(F(sigma)) <= c + (1/8)*m!
          have hhi : complex.re (F (complex.of_real sigma)) ≤ c / (sigma - complex.re rho) + M := by linarith [le_abs_self.real (complex.re (F (complex.of_real sigma)) - c / (sigma - complex.re rho))]
          have hmul := mul_le_mul_of_nonneg_left.real (complex.re (F (complex.of_real sigma))) (c / (sigma - complex.re rho) + M) (sigma - complex.re rho) hhi (by linarith)
          have hcancel : (sigma - complex.re rho) * (c / (sigma - complex.re rho)) = c := by field_simp
          linarith
