              have he1 : log x * (0 - (complex.re z + 2)) = (-complex.re z - 2) * log x := by ring
              rw [he1]
              have hpy := sin_sq_add_cos_sq (log x * (0 - complex.im z))
              linear_combination (exp ((-complex.re z - 2) * log x) * exp ((-complex.re z - 2) * log x)) * hpy
            exact eq_of_sq_eq_nonneg (complex.abs qz) (rpow x (-complex.re z - 2)) (complex.abs_nonneg qz) (by linarith [rpow.pos x (-complex.re z - 2)]) hsq
          rw [hqz_abs]
          have hrez : -complex.re z ≤ -complex.re s0 + delta
            have h1 := complex.re_abs_le h
            rw [hh] at h1; simp at h1
            have h2 : complex.re s0 - complex.re z ≤ complex.abs (complex.sub z s0) := by linarith [neg_le_abs.real (complex.re z - complex.re s0)]
            rw [← hh] at h2; linarith
          have hr_le : rpow x (-complex.re z - 2) ≤ rpow x (-complex.re s0 - 2 + 2 * delta)
            unfold rpow
            have hle_exp := mul_le_mul_of_nonneg_right.real (-complex.re z - 2) (-complex.re s0 - 2 + 2 * delta) (log x) (by linarith) hlog_nn
            exact (exp_le_exp ((-complex.re z - 2) * log x) ((-complex.re s0 - 2 + 2 * delta) * log x)).mpr hle_exp
          exact mul_le_mul_of_nonneg_right.real (rpow x (-complex.re z - 2)) (rpow x (-complex.re s0 - 2 + 2 * delta)) (complex.abs h * complex.abs h) hr_le (mul_nonneg.real (complex.abs h) (complex.abs h) (complex.abs_nonneg h) (complex.abs_nonneg h))
        -- Combine Terms 1 + 2 + 3 and use x^(-Re(s0) - 2 + 2*delta) <= a^(-delta - 1)!
        have hr_ax : rpow x (-complex.re s0 - 2 + 2 * delta) ≤ rpow a (-delta - 1)
          unfold rpow
          have hlog_a : log a ≤ log x := (log_le_log a x (by linarith) (by linarith)).mpr hx1
          have h1 := mul_le_mul_of_nonneg_right.real (-complex.re s0 - 2 + 2 * delta) (-delta - 1) (log x) (by linarith) hlog_nn
          have h2 : (-delta - 1) * log x ≤ (-delta - 1) * log a
            have hm := mul_le_mul_of_nonneg_left.real (log a) (log x) (delta + 1) hlog_a (by linarith)
            linarith
          exact (exp_le_exp ((-complex.re s0 - 2 + 2 * delta) * log x) ((-delta - 1) * log a)).mpr (by linarith)
        have h8K : (complex.abs c2 + complex.abs c1 * delta) * 6 * (4 / (delta * delta)) + complex.abs c1 * (1 + 4 / (delta * delta)) + 1 = 8 * K_int
          rw [hK_int]; ring
        have hsum_inner : complex.abs (complex.add (complex.add (complex.mul (complex.add c2 (complex.mul c1 h)) Rq) (complex.mul (complex.mul c1 (complex.mul (complex.of_real (-log x)) q0)) (complex.mul h h))) (complex.mul qz (complex.mul h h))) ≤ 8 * K_int * rpow a (-delta - 1) * (complex.abs h * complex.abs h)
          have h8K_nn : 0 ≤ 8 * K_int := by linarith
          have hfac : (complex.abs c2 + complex.abs c1 * delta) * 6 * (4 / (delta * delta)) * rpow x (-complex.re s0 - 2 + 2 * delta) * (complex.abs h * complex.abs h) + complex.abs c1 * (1 + 4 / (delta * delta)) * rpow x (-complex.re s0 - 2 + 2 * delta) * (complex.abs h * complex.abs h) + rpow x (-complex.re s0 - 2 + 2 * delta) * (complex.abs h * complex.abs h) = 8 * K_int * rpow x (-complex.re s0 - 2 + 2 * delta) * (complex.abs h * complex.abs h) := by linear_combination (rpow x (-complex.re s0 - 2 + 2 * delta) * (complex.abs h * complex.abs h)) * h8K
          have hm1 := mul_le_mul_of_nonneg_left.real (rpow x (-complex.re s0 - 2 + 2 * delta)) (rpow a (-delta - 1)) (8 * K_int) hr_ax h8K_nn
          have hm2 := mul_le_mul_of_nonneg_right.real (8 * K_int * rpow x (-complex.re s0 - 2 + 2 * delta)) (8 * K_int * rpow a (-delta - 1)) (complex.abs h * complex.abs h) hm1 (by nlinarith [complex.abs_nonneg h])
          linarith
        have h8K_tot_nn : 0 ≤ 8 * K_int * rpow a (-delta - 1) * (complex.abs h * complex.abs h)
          have h1 := mul_nonneg.real (8 * K_int) (rpow a (-delta - 1)) (by linarith) (by linarith [rpow.pos a (-delta - 1)])
          exact mul_nonneg.real (8 * K_int * rpow a (-delta - 1)) (complex.abs h * complex.abs h) h1 (by nlinarith [complex.abs_nonneg h])
        have hm1 := mul_le_mul_of_nonneg_left.real (complex.abs (complex.add (complex.add (complex.mul (complex.add c2 (complex.mul c1 h)) Rq) (complex.mul (complex.mul c1 (complex.mul (complex.of_real (-log x)) q0)) (complex.mul h h))) (complex.mul qz (complex.mul h h)))) (8 * K_int * rpow a (-delta - 1) * (complex.abs h * complex.abs h)) (complex.abs (complex.of_real (-((x - a) * (x - a - 1) / 2)))) hsum_inner (complex.abs_nonneg (complex.of_real (-((x - a) * (x - a - 1) / 2))))
        have hm2 := mul_le_mul_of_nonneg_right.real (complex.abs (complex.of_real (-((x - a) * (x - a - 1) / 2)))) (1 / 8) (8 * K_int * rpow a (-delta - 1) * (complex.abs h * complex.abs h)) hq_abs h8K_tot_nn
        linarith
      have hres := hml hpt
      have hlen : (a + 1) - a = 1 := by ring
      rw [hlen] at hres
      have hp_eq : pseries.term (1 + delta) (n + 1) = rpow a (-delta - 1)
        unfold pseries.term
        have hne0' : n + 1 ≠ 0 := by omega
        rw [if_neg hne0', ← ha_def]
        have he : -(1 + delta) = -delta - 1 := by ring
        rw [he]
      rw [hMn] at hres
      rw [hp_eq]
      linarith
    have hsum_le := sum_le.real (fun n => complex.abs (complex.sub (complex.sub (zeta_em2_term z n) (zeta_em2_term s0 n)) (complex.mul (zeta_em2_deriv_term s0 n) (complex.sub z s0)))) (fun n => (K_int * (complex.abs (complex.sub z s0) * complex.abs (complex.sub z s0))) * pseries.term (1 + delta) (n + 1)) N hterm_quad
    rw [sum_const_mul.real] at hsum_le
    have hshift : (∑ n < N, pseries.term (1 + delta) (n + 1)) = partial_sum (pseries.term (1 + delta)) (N + 1)
      unfold partial_sum
      rw [sum_range_succ'.real (pseries.term (1 + delta)) N]
      have h0 : pseries.term (1 + delta) 0 = 0 := by unfold pseries.term; simp
      rw [h0]; ring
    have hps_ub := pseries.partial_sum_le (1 + delta) (by linarith) (N + 1)
    have hsub1 : (1 + delta) - 1 = delta := by ring
    rw [hsub1] at hps_ub
    rw [hshift] at hsum_le
    have hKh_nn : 0 ≤ K_int * (complex.abs (complex.sub z s0) * complex.abs (complex.sub z s0)) :=
      mul_nonneg.real K_int (complex.abs (complex.sub z s0) * complex.abs (complex.sub z s0)) hK_int_nn (by nlinarith [complex.abs_nonneg (complex.sub z s0)])
    have hps_fin := mul_le_mul_of_nonneg_left.real (partial_sum (pseries.term (1 + delta)) (N + 1)) ((1 + delta) / delta) (K_int * (complex.abs (complex.sub z s0) * complex.abs (complex.sub z s0))) hps_ub hKh_nn
    have hM_eq : K_pole * (complex.abs (complex.sub z s0) * complex.abs (complex.sub z s0)) + K_int * (complex.abs (complex.sub z s0) * complex.abs (complex.sub z s0)) * ((1 + delta) / delta) = M_tot * (complex.abs (complex.sub z s0) * complex.abs (complex.sub z s0)) := by rw [hM_tot]; ring
    linarith

-- ====================================================================================
-- 5. GRAND FINALE: UNCONDITIONAL HADAMARD-DE LA VALLEE POUSSIN FOR zeta_EM2(1 + it)!
-- ====================================================================================

-- THEOREM 5 (UNCONDITIONAL NONVANISHING zeta_EM2(1 + it) != 0 FROM MERTENS 3-4-1 ALONE!):
-- Discharges ALL THREE analytic hypotheses (`hpole`, `hdiff`, `hbdd`) of Hadamard-de la Vallee
-- Poussin AUTOMATICALLY for the order-2 Euler-Maclaurin continuation zeta_EM2 (which agrees
-- with sum n^(-s) on Re(s) > 1 and satisfies zeta_EM2(0) = -1/2)!
+ zeta.em2_ne_zero_re_eq_one_of_mertens (zeta : ℂ → ℂ) (hzeta : is_zeta_em2 zeta)
    (t : ℝ) (ht : t ≠ 0)
    (hmertens : ∀ sigma : ℝ, 1 < sigma → sigma < 2 →
      1 ≤ (complex.abs (zeta (complex.of_real sigma))) ^ 3 *
          (complex.abs (zeta (complex.mk sigma t))) ^ 4 *
          complex.abs (zeta (complex.mk sigma (2 * t)))) :
    zeta (complex.mk 1 t) ≠ complex.zero
  have hne1 : complex.mk 1 t ≠ complex.one
    intro hz
    have hi : complex.im (complex.mk 1 t) = complex.im complex.one := by rw [hz]
    simp at hi; exact ht hi
  obtain ⟨v, hv⟩ := zeta.em2_has_cderiv_at zeta hzeta (complex.mk 1 t) (by simp) hne1
  set C3 := 1 / (2 * |t|) + 1 / 2 + (2 + 2 * |t|) * (3 + 2 * |t|) / 4 with hC3
  have hC3_nn : 0 ≤ C3
    rw [hC3]
    have ht_pos : 0 < |t|
      have hnn := abs_nonneg.real t
      by_contra hle
      have h0 : |t| = 0 := by linarith
      have ht0 : t = 0 := by linarith [le_abs_self.real t, neg_le_abs.real t]
      exact ht ht0
    have h1 := one_div_pos.real (2 * |t|) (by linarith)
    nlinarith
  apply hadamard_poussin.ne_zero_re_eq_one zeta zeta zeta t 1 3 C3 v (by decide) (by decide) hC3_nn
  · intro sigma hs1 hs2; exact hmertens sigma hs1 (by linarith)
  · intro sigma hs1 hs2; exact zeta.em2_pole_bound zeta hzeta sigma hs1 (by linarith)
  · exact hv
  · intro sigma hs1 hs2; rw [hC3]; exact zeta.em2_vertical_bound zeta hzeta t sigma ht hs1 (by linarith)
