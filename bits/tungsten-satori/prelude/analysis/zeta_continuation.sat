      set f0_n := (fun x => complex.smul (-((x - a) * (x - a - 1) / 2)) (complex.mul (complex.mul s0 (complex.add s0 complex.one)) (cpow_real x (complex.sub (complex.sub (complex.neg s0) complex.one) complex.one)))) with hf0_n
      set fd_n := (fun x => complex.smul (-((x - a) * (x - a - 1) / 2)) (complex.mul (complex.sub c1 (complex.mul (complex.of_real (log x)) c2)) (cpow_real x (complex.sub (complex.sub (complex.neg s0) complex.one) complex.one)))) with hfd_n
      have hneg0 := c_has_integral.scale_complex f0_n a (a + 1) (complex.neg complex.one) (zeta_em2_term s0 n) hI0
      have hsub1 := c_has_integral.add fz_n (fun x => complex.mul (complex.neg complex.one) (f0_n x)) a (a + 1) (zeta_em2_term z n) (complex.mul (complex.neg complex.one) (zeta_em2_term s0 n)) hIz hneg0
      have hscd := c_has_integral.scale_complex fd_n a (a + 1) (complex.neg (complex.sub z s0)) (zeta_em2_deriv_term s0 n) hId
      have htot := c_has_integral.add (fun x => complex.add (fz_n x) (complex.mul (complex.neg complex.one) (f0_n x))) (fun x => complex.mul (complex.neg (complex.sub z s0)) (fd_n x)) a (a + 1) (complex.add (zeta_em2_term z n) (complex.mul (complex.neg complex.one) (zeta_em2_term s0 n))) (complex.mul (complex.neg (complex.sub z s0)) (zeta_em2_deriv_term s0 n)) hsub1 hscd
      have hval_eq : complex.add (complex.add (zeta_em2_term z n) (complex.mul (complex.neg complex.one) (zeta_em2_term s0 n))) (complex.mul (complex.neg (complex.sub z s0)) (zeta_em2_deriv_term s0 n)) = complex.sub (complex.sub (zeta_em2_term z n) (zeta_em2_term s0 n)) (complex.mul (zeta_em2_deriv_term s0 n) (complex.sub z s0))
        apply complex.ext <;> simp <;> ring
      rw [hval_eq] at htot
      set M_n := K_int * (complex.abs (complex.sub z s0) * complex.abs (complex.sub z s0)) * rpow a (-delta - 1) with hMn
      have hMn_nn : 0 ≤ M_n
        rw [hMn]
        have h1 := mul_nonneg.real K_int (complex.abs (complex.sub z s0) * complex.abs (complex.sub z s0)) hK_int_nn (by nlinarith [complex.abs_nonneg (complex.sub z s0)])
        exact mul_nonneg.real (K_int * (complex.abs (complex.sub z s0) * complex.abs (complex.sub z s0))) (rpow a (-delta - 1)) h1 (by linarith [rpow.pos a (-delta - 1)])
      have hml := c_has_integral.abs_le (fun x => complex.add (complex.add (fz_n x) (complex.mul (complex.neg complex.one) (f0_n x))) (complex.mul (complex.neg (complex.sub z s0)) (fd_n x))) a (a + 1) M_n (complex.sub (complex.sub (zeta_em2_term z n) (zeta_em2_term s0 n)) (complex.mul (zeta_em2_deriv_term s0 n) (complex.sub z s0))) (by linarith) hMn_nn htot
      have hpt : ∀ x, a ≤ x → x ≤ a + 1 → complex.abs (complex.add (complex.add (fz_n x) (complex.mul (complex.neg complex.one) (f0_n x))) (complex.mul (complex.neg (complex.sub z s0)) (fd_n x))) ≤ M_n
        intro x hx1 hx2
        rw [hfz_n, hf0_n, hfd_n]
        have hx_ge1 : 1 ≤ x := by linarith
        have hlog_nn : 0 ≤ log x
          have hl := (log_le_log 1 x (by decide) (by linarith)).mpr hx_ge1
          rw [log_one] at hl; exact hl
