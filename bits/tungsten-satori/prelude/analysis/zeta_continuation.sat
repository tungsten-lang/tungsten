      have hinv0_nn : 0 ≤ (1 / complex.abs (complex.sub s0 complex.one)) * (1 / complex.abs (complex.sub s0 complex.one))
        have hp := one_div_pos.real (complex.abs (complex.sub s0 complex.one)) hs01_pos
        nlinarith
      have hm1 := mul_le_mul_of_nonneg_right.real (1 / complex.abs (complex.sub z complex.one)) (2 / complex.abs (complex.sub s0 complex.one)) ((1 / complex.abs (complex.sub s0 complex.one)) * (1 / complex.abs (complex.sub s0 complex.one))) hinv_z_le hinv0_nn
      rw [hprod_inv] at hm1
      exact mul_le_mul_of_nonneg_right.real ((1 / complex.abs (complex.sub z complex.one)) * ((1 / complex.abs (complex.sub s0 complex.one)) * (1 / complex.abs (complex.sub s0 complex.one)))) K_pole (complex.abs (complex.sub z s0) * complex.abs (complex.sub z s0)) hm1 (by nlinarith [complex.abs_nonneg (complex.sub z s0)])
    -- Part B: Sum_{n<N} |T_n(z) - T_n(s0) - T_n'(s0)*(z - s0)| <= K_int * ((1+delta)/delta) * |z - s0|^2!
    have hcsum_le := csum.abs_le_sum N (fun n => complex.sub (complex.sub (zeta_em2_term z n) (zeta_em2_term s0 n)) (complex.mul (zeta_em2_deriv_term s0 n) (complex.sub z s0)))
    have hterm_quad : ∀ n : ℕ, n < N → complex.abs (complex.sub (complex.sub (zeta_em2_term z n) (zeta_em2_term s0 n)) (complex.mul (zeta_em2_deriv_term s0 n) (complex.sub z s0))) ≤ (K_int * (complex.abs (complex.sub z s0) * complex.abs (complex.sub z s0))) * pseries.term (1 + delta) (n + 1)
      intro n _
      set a := ((n + 1 : ℕ) : ℝ) with ha_def
      have ha1_eq : ((n + 2 : ℕ) : ℝ) = a + 1 := by rw [ha_def, cast_add.real n 2, cast_add.real n 1]; simp; ring
      have ha_ge1 : 1 ≤ a := by rw [ha_def]; exact (cast_le.real 1 (n + 1)).mpr (by omega)
      have hIz := zeta.em2_term_has_integral z n hne_z
      have hI0 := zeta.em2_term_has_integral s0 n hne0
      have hId := zeta.em2_deriv_term_has_integral s0 n hne0
