        have hT2 : complex.abs (complex.mul (complex.mul c1 (complex.mul (complex.of_real (-log x)) q0)) (complex.mul h h)) ≤ complex.abs c1 * (1 + 4 / (delta * delta)) * rpow x (-complex.re s0 - 2 + 2 * delta) * (complex.abs h * complex.abs h)
