          have hq_le : -((x - a) * (x - a - 1) / 2) ≤ 1 / 8
            have hc : 1 / 8 - -((x - a) * (x - a - 1) / 2) = ((x - a - 1 / 2) * (x - a - 1 / 2)) / 2 := by ring
            have hs : 0 ≤ (x - a - 1 / 2) * (x - a - 1 / 2) := by nlinarith
            linarith
          have hsq : complex.abs (complex.of_real (-((x - a) * (x - a - 1) / 2))) * complex.abs (complex.of_real (-((x - a) * (x - a - 1) / 2))) = (-((x - a) * (x - a - 1) / 2)) * (-((x - a) * (x - a - 1) / 2))
            rw [complex.abs_sq]; unfold complex.norm_sq complex.of_real; simp
          nlinarith
        have htri1 := complex.abs_add_le (complex.add (complex.mul (complex.add c2 (complex.mul c1 h)) Rq) (complex.mul (complex.mul c1 (complex.mul (complex.of_real (-log x)) q0)) (complex.mul h h))) (complex.mul qz (complex.mul h h))
        have htri2 := complex.abs_add_le (complex.mul (complex.add c2 (complex.mul c1 h)) Rq) (complex.mul (complex.mul c1 (complex.mul (complex.of_real (-log x)) q0)) (complex.mul h h))
        -- Bound Rq using `cpow_real.quad_taylor_bound`!
        have hRq_bd : complex.abs Rq ≤ 6 * (4 / (delta * delta)) * rpow x (-complex.re s0 - 2 + 2 * delta) * (complex.abs h * complex.abs h)
          have hqt := cpow_real.quad_taylor_bound x delta z2 s02 hx_ge1 (by linarith) (by rw [hsub2]; linarith)
          rw [hsub2, ← hqz, ← hq0, ← hRq] at hqt
          have hre_s02 : -complex.re s02 + delta = -complex.re s0 - 2 + delta := by rw [hs02]; unfold complex.of_real; simp; ring
          rw [hre_s02] at hqt
          have hlsq := log_sq_le_rpow x delta hx_ge1 hdelta_pos
          have hr_add : rpow x delta * rpow x (-complex.re s0 - 2 + delta) = rpow x (-complex.re s0 - 2 + 2 * delta)
            unfold rpow; rw [← exp_add]
            have he : delta * log x + (-complex.re s0 - 2 + delta) * log x = (-complex.re s0 - 2 + 2 * delta) * log x := by ring
            rw [he]
          have hfac_nn : 0 ≤ 6 * rpow x (-complex.re s0 - 2 + delta) * (complex.abs h * complex.abs h)
            have h1 := mul_nonneg.real 6 (rpow x (-complex.re s0 - 2 + delta)) (by decide) (by linarith [rpow.pos x (-complex.re s0 - 2 + delta)])
            exact mul_nonneg.real (6 * rpow x (-complex.re s0 - 2 + delta)) (complex.abs h * complex.abs h) h1 (by nlinarith [complex.abs_nonneg h])
          have hm := mul_le_mul_of_nonneg_right.real (log x * log x) ((4 / (delta * delta)) * rpow x delta) (6 * rpow x (-complex.re s0 - 2 + delta) * (complex.abs h * complex.abs h)) hlsq hfac_nn
          have hl_eq : (log x * log x) * (6 * rpow x (-complex.re s0 - 2 + delta) * (complex.abs h * complex.abs h)) = 6 * (log x * log x) * rpow x (-complex.re s0 - 2 + delta) * (complex.abs h * complex.abs h) := by ring
          have hr_eq : (4 / (delta * delta)) * rpow x delta * (6 * rpow x (-complex.re s0 - 2 + delta) * (complex.abs h * complex.abs h)) = 6 * (4 / (delta * delta)) * (rpow x delta * rpow x (-complex.re s0 - 2 + delta)) * (complex.abs h * complex.abs h) := by ring
