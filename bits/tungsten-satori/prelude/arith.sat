+ sum_nonneg.nat (f : ℕ → ℕ) (n : ℕ) (h : ∀ i < n, 0 ≤ f i) : 0 ≤ ∑ i < n, f i
  exact zero_le.nat (∑ i < n, f i)
+ geometric_sum_two.nat (n : ℕ) : (∑ i < n, 2 ^ i) + 1 = 2 ^ n
  induction n with n ih
  · decide
  · rw [succ_eq_add_one.nat, sum_below_succ, pow_succ.nat 2 n]
    linarith
+ sum_range_succ_id_mul_two.nat (n : ℕ) : (∑ i < n + 1, i) * 2 = (n + 1) * n
  induction n with n ih
  · decide
  · rw [succ_eq_add_one.nat, sum_below_succ]
    linarith
+ sum_range_id_mul_two.nat (n : ℕ) : (∑ i < n, i) * 2 = n * (n - 1)
  induction n with n ih
  · decide
  · rw [succ_eq_add_one.nat]
    have e : n + 1 - 1 = n := by linarith [sub_add_cancel.nat (n + 1) 1 (by linarith)]
    rw [e]
    exact sum_range_succ_id_mul_two.nat n
+ single_le_sum.nat (f : ℕ → ℕ) (n k : ℕ) (h : ∀ i < n, 0 ≤ f i) (hk : k < n) : f k ≤ ∑ i < n, f i
  induction n with h hk n ih h hk
  · linarith
  · simp only [succ_eq_add_one.nat] at h
