  by_cases h : a ≤ b
  · left; exact ⟨by simp [max, h], h⟩
  · right; exact ⟨by simp [max, h], by linarith⟩
+ min_le_left.rat (a b : ℚ) : min a b ≤ a
  obtain ⟨e, h⟩ | ⟨e, h⟩ := min_cases.rat a b <;> linarith
+ min_le_right.rat (a b : ℚ) : min a b ≤ b
  obtain ⟨e, h⟩ | ⟨e, h⟩ := min_cases.rat a b <;> linarith
+ le_min.rat (a b c : ℚ) (h : c ≤ a) (k : c ≤ b) : c ≤ min a b
  obtain ⟨e, l⟩ | ⟨e, l⟩ := min_cases.rat a b <;> linarith
+ lt_min.rat (a b c : ℚ) (h : c < a) (k : c < b) : c < min a b
  obtain ⟨e, l⟩ | ⟨e, l⟩ := min_cases.rat a b <;> linarith
+ le_min_iff.rat (a b c : ℚ) : c ≤ min a b ↔ c ≤ a ∧ c ≤ b
  constructor
  · intro h; exact ⟨by linarith [min_le_left.rat a b], by linarith [min_le_right.rat a b]⟩
  · intro h; exact le_min.rat a b c h.1 h.2
+ min_eq_left.rat (a b : ℚ) (h : a ≤ b) : min a b = a
  obtain ⟨e, l⟩ | ⟨e, l⟩ := min_cases.rat a b <;> linarith
+ min_eq_right.rat (a b : ℚ) (h : b ≤ a) : min a b = b
  obtain ⟨e, l⟩ | ⟨e, l⟩ := min_cases.rat a b <;> linarith
+ min_comm.rat (a b : ℚ) : min a b = min b a
  obtain ⟨e, h⟩ | ⟨e, h⟩ := min_cases.rat a b <;> obtain ⟨f, k⟩ | ⟨f, k⟩ := min_cases.rat b a <;> linarith
+ min_self.rat (a : ℚ) : min a a = a
  exact min_eq_left.rat a a (le_refl.rat a)
+ le_max_left.rat (a b : ℚ) : a ≤ max a b
  obtain ⟨e, h⟩ | ⟨e, h⟩ := max_cases.rat a b <;> linarith
+ le_max_right.rat (a b : ℚ) : b ≤ max a b
  obtain ⟨e, h⟩ | ⟨e, h⟩ := max_cases.rat a b <;> linarith
+ max_le.rat (a b c : ℚ) (h : a ≤ c) (k : b ≤ c) : max a b ≤ c
  obtain ⟨e, l⟩ | ⟨e, l⟩ := max_cases.rat a b <;> linarith
+ max_lt.rat (a b c : ℚ) (h : a < c) (k : b < c) : max a b < c
  obtain ⟨e, l⟩ | ⟨e, l⟩ := max_cases.rat a b <;> linarith
+ max_le_iff.rat (a b c : ℚ) : max a b ≤ c ↔ a ≤ c ∧ b ≤ c
  constructor
  · intro h; exact ⟨by linarith [le_max_left.rat a b], by linarith [le_max_right.rat a b]⟩
  · intro h; exact max_le.rat a b c h.1 h.2
+ max_eq_left.rat (a b : ℚ) (h : b ≤ a) : max a b = a
  obtain ⟨e, l⟩ | ⟨e, l⟩ := max_cases.rat a b <;> linarith
+ max_eq_right.rat (a b : ℚ) (h : a ≤ b) : max a b = b
  obtain ⟨e, l⟩ | ⟨e, l⟩ := max_cases.rat a b <;> linarith
+ max_comm.rat (a b : ℚ) : max a b = max b a
  obtain ⟨e, h⟩ | ⟨e, h⟩ := max_cases.rat a b <;> obtain ⟨f, k⟩ | ⟨f, k⟩ := max_cases.rat b a <;> linarith
+ max_self.rat (a : ℚ) : max a a = a
