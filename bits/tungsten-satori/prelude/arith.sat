-- Elementary arithmetic library (import arith): the abs, min/max, power, division, cast, binomial and sum facts that
-- Mathlib supplies and that Satori files kept re-proving (~/math/openai/benchmarks/like_for_like). Every lemma is
-- proved from the foundational axioms in core.sat; this module adds no axioms.
--
-- Naming follows the prelude convention: a fact that holds on several number types is stated once per type with the
-- suffix .nat .int .rat .real (lemma_at(base, ty) finds base.ty). Casts from ℕ are named by their target type
-- (cast_add.real : ((m + n : ℕ) : ℝ) = (m : ℝ) + (n : ℝ)); casts from ℤ and ℚ are int_cast_*.T and rat_cast_*.real.
-- Already in core.sat, so not repeated here: pow_zero.T, pow_succ.T, mod_lt.T, mod_nonneg.T, div_add_mod.T, div_zero.T,
-- abs_nonneg.T, abs_of_nonneg.T, abs_of_neg.T, mul_inv_cancel.T, div_def.T, sub_add_cancel.nat and the one-step cast laws
-- (int_of_nat_add, rat_of_int_le, real_of_rat_mul, …). sq_nonneg.T is in order.sat.
--
-- Sections: big-operator steps and induction from m · abs · min/max · products and order · powers ·
-- ℕ/ℤ division and remainder · field division · casts · factorial and binomial coefficients · sums.
-- Exponential, logarithm, square root and the Archimedean property of ℝ are in realx (import realx).

-- ---- big operators: one step (∑ i < n, f i is sum_below n f; note ∑ i < n, f i + c parses as ∑ i < n, (f i + c)) ----
@[simp] + sum_below_zero (f : ℕ → α) : ∑ i < 0, f i = 0 := by rfl
+ sum_below_succ (n : ℕ) (f : ℕ → α) : ∑ i < n + 1, f i = (∑ i < n, f i) + f n := by rfl
@[simp] + prod_below_zero (f : ℕ → α) : ∏ i < 0, f i = 1 := by rfl
+ prod_below_succ (n : ℕ) (f : ℕ → α) : ∏ i < n + 1, f i = (∏ i < n, f i) * f n := by rfl

-- induction from m (Mathlib's Nat.le_induction)
+ le_induction.nat (P : ℕ → Prop) (m : ℕ) (h0 : P m) (hs : ∀ n, m ≤ n → P n → P (n + 1)) : ∀ n, m ≤ n → P n
  have k : ∀ d, P (m + d)
    intro d
    induction d with d ih
    · rw [add_zero.nat]
      exact h0
    · rw [succ_eq_add_one.nat, ← add_assoc.nat]
      exact hs (m + d) (by linarith) ih
  intro n hn
  have e : n = m + (n - m) := by linarith [sub_add_cancel.nat n m hn]
  rw [e]
  exact k (n - m)

-- ---- absolute value (ℝ ℚ ℤ) -------------------------------------------------------------------------------------
-- abs_cases.T is the workhorse: obtain ⟨e, h⟩ | ⟨e, h⟩ := abs_cases.T x <;> linarith
-- ℝ
+ abs_cases.real (x : ℝ) : (|x| = x ∧ 0 ≤ x) ∨ (|x| = 0 - x ∧ x < 0)
  by_cases h : 0 ≤ x
  · left
    exact ⟨abs_of_nonneg.real x h, h⟩
  · right
    have e := abs_of_neg.real x (by linarith)
    have e2 : neg x = 0 - x := by ring
    rw [e2] at e
    exact ⟨e, by linarith⟩
+ abs_of_nonpos.real (x : ℝ) (h : x ≤ 0) : |x| = 0 - x
  obtain ⟨e, k⟩ | ⟨e, k⟩ := abs_cases.real x <;> linarith
+ abs_of_pos.real (x : ℝ) (h : 0 < x) : |x| = x
  obtain ⟨e, k⟩ | ⟨e, k⟩ := abs_cases.real x <;> linarith
+ le_abs_self.real (x : ℝ) : x ≤ |x|
  obtain ⟨e, k⟩ | ⟨e, k⟩ := abs_cases.real x <;> linarith
+ neg_le_abs.real (x : ℝ) : 0 - x ≤ |x|
  obtain ⟨e, k⟩ | ⟨e, k⟩ := abs_cases.real x <;> linarith
+ neg_abs_le.real (x : ℝ) : 0 - |x| ≤ x
  obtain ⟨e, k⟩ | ⟨e, k⟩ := abs_cases.real x <;> linarith
+ abs_le.real (x c : ℝ) : |x| ≤ c ↔ 0 - c ≤ x ∧ x ≤ c
  constructor
  · intro h
    exact ⟨by linarith [neg_le_abs.real x], by linarith [le_abs_self.real x]⟩
  · intro h
    obtain ⟨e, k⟩ | ⟨e, k⟩ := abs_cases.real x <;> linarith
+ abs_lt.real (x c : ℝ) : |x| < c ↔ 0 - c < x ∧ x < c
  constructor
  · intro h
    exact ⟨by linarith [neg_le_abs.real x], by linarith [le_abs_self.real x]⟩
  · intro h
    obtain ⟨e, k⟩ | ⟨e, k⟩ := abs_cases.real x <;> linarith
+ abs_le_of.real (x c : ℝ) (h : 0 - c ≤ x) (k : x ≤ c) : |x| ≤ c
  obtain ⟨e, l⟩ | ⟨e, l⟩ := abs_cases.real x <;> linarith
+ abs_lt_of.real (x c : ℝ) (h : 0 - c < x) (k : x < c) : |x| < c
  obtain ⟨e, l⟩ | ⟨e, l⟩ := abs_cases.real x <;> linarith
+ abs_neg.real (x : ℝ) : |0 - x| = |x|
  obtain ⟨e, k⟩ | ⟨e, k⟩ := abs_cases.real x <;> obtain ⟨f, l⟩ | ⟨f, l⟩ := abs_cases.real (0 - x) <;> linarith
+ abs_sub_comm.real (a b : ℝ) : |a - b| = |b - a|
  obtain ⟨e, k⟩ | ⟨e, k⟩ := abs_cases.real (a - b) <;> obtain ⟨f, l⟩ | ⟨f, l⟩ := abs_cases.real (b - a) <;> linarith
+ abs_mul.real (a b : ℝ) : |a * b| = |a| * |b|
  obtain ⟨e, h⟩ | ⟨e, h⟩ := abs_cases.real a <;> obtain ⟨f, k⟩ | ⟨f, k⟩ := abs_cases.real b <;> rw [e, f]
  · rw [abs_of_nonneg.real (a * b) (mul_nonneg.real a b h k)]
  · rw [abs_of_nonpos.real (a * b) (by linarith [mul_nonneg.real a (0 - b) h (by linarith)])]
    ring
  · rw [abs_of_nonpos.real (a * b) (by linarith [mul_nonneg.real (0 - a) b (by linarith) k])]
    ring
  · rw [abs_of_nonneg.real (a * b) (by linarith [mul_nonneg.real (0 - a) (0 - b) (by linarith) (by linarith)])]
    ring
+ abs_add.real (a b : ℝ) : |a + b| ≤ |a| + |b|
  obtain ⟨e, h⟩ | ⟨e, h⟩ := abs_cases.real (a + b) <;> linarith [le_abs_self.real a, neg_le_abs.real a, le_abs_self.real b, neg_le_abs.real b]
+ abs_sub.real (a b : ℝ) : |a - b| ≤ |a| + |b|
  obtain ⟨e, h⟩ | ⟨e, h⟩ := abs_cases.real (a - b) <;> linarith [le_abs_self.real a, neg_le_abs.real a, le_abs_self.real b, neg_le_abs.real b]
+ abs_sub_le.real (a b c : ℝ) : |a - c| ≤ |a - b| + |b - c|
  obtain ⟨e, h⟩ | ⟨e, h⟩ := abs_cases.real (a - c) <;> linarith [le_abs_self.real (a - b), neg_le_abs.real (a - b), le_abs_self.real (b - c), neg_le_abs.real (b - c)]
+ abs_sub_abs_le_abs_sub.real (a b : ℝ) : |a| - |b| ≤ |a - b|
  obtain ⟨e, h⟩ | ⟨e, h⟩ := abs_cases.real a <;> linarith [le_abs_self.real (a - b), neg_le_abs.real (a - b), le_abs_self.real b, neg_le_abs.real b]
+ abs_abs_sub_abs_le.real (a b : ℝ) : | |a| - |b| | ≤ |a - b|
  apply abs_le_of.real
  · linarith [abs_sub_abs_le_abs_sub.real b a, abs_sub_comm.real a b]
  · exact abs_sub_abs_le_abs_sub.real a b
+ abs_abs.real (x : ℝ) : | |x| | = |x|
  exact abs_of_nonneg.real (abs x) (abs_nonneg.real x)
+ abs_pos.real (x : ℝ) (h : x ≠ 0) : 0 < |x|
  obtain ⟨e, k⟩ | ⟨e, k⟩ := abs_cases.real x <;> linarith
+ abs_sq.real (x : ℝ) : |x| * |x| = x * x
  obtain ⟨e, k⟩ | ⟨e, k⟩ := abs_cases.real x <;> rw [e] <;> ring
+ sq_abs.real (x : ℝ) : |x| ^ 2 = x ^ 2
  obtain ⟨e, k⟩ | ⟨e, k⟩ := abs_cases.real x <;> rw [e] <;> ring
+ abs_le_abs.real (a b : ℝ) (h : a ≤ b) (k : 0 - b ≤ a) : |a| ≤ |b|
  obtain ⟨e, l⟩ | ⟨e, l⟩ := abs_cases.real a <;> linarith [le_abs_self.real b, neg_le_abs.real b]
+ abs_le_abs_of_nonneg.real (a b : ℝ) (h : 0 ≤ a) (k : a ≤ b) : |a| ≤ |b|
  rw [abs_of_nonneg.real a h, abs_of_nonneg.real b (by linarith)]
  exact k
+ abs_eq_zero.real (x : ℝ) : |x| = 0 ↔ x = 0
  constructor
  · intro h
    obtain ⟨e, k⟩ | ⟨e, k⟩ := abs_cases.real x <;> linarith
  · intro h
    rw [h]
    decide
+ sq_le_sq.real (a b : ℝ) : a ^ 2 ≤ b ^ 2 ↔ |a| ≤ |b|
  have e := sq_abs.real a
  have f := sq_abs.real b
  have p := abs_nonneg.real a
  have q := abs_nonneg.real b
  constructor <;> intro h <;> nlinarith
+ sq_lt_sq.real (a b : ℝ) : a ^ 2 < b ^ 2 ↔ |a| < |b|
  have e := sq_abs.real a
  have f := sq_abs.real b
  have p := abs_nonneg.real a
  have q := abs_nonneg.real b
  constructor <;> intro h <;> nlinarith
+ abs_le_of_sq_le_sq.real (a b : ℝ) (h : a ^ 2 ≤ b ^ 2) (hb : 0 ≤ b) : |a| ≤ b
  have k := (sq_le_sq.real a b).mp h
  rw [abs_of_nonneg.real b hb] at k
  exact k
+ abs_pow.real (a : ℝ) (n : ℕ) : |a ^ n| = |a| ^ n
  induction n with n ih
  · simp
  · rw [succ_eq_add_one.nat, pow_succ.real, pow_succ.real, abs_mul.real, ih]

-- ℚ
+ abs_cases.rat (x : ℚ) : (|x| = x ∧ 0 ≤ x) ∨ (|x| = 0 - x ∧ x < 0)
  by_cases h : 0 ≤ x
  · left
    exact ⟨abs_of_nonneg.rat x h, h⟩
  · right
    have e := abs_of_neg.rat x (by linarith)
    have e2 : neg x = 0 - x := by ring
    rw [e2] at e
    exact ⟨e, by linarith⟩
+ abs_of_nonpos.rat (x : ℚ) (h : x ≤ 0) : |x| = 0 - x
  obtain ⟨e, k⟩ | ⟨e, k⟩ := abs_cases.rat x <;> linarith
+ abs_of_pos.rat (x : ℚ) (h : 0 < x) : |x| = x
  obtain ⟨e, k⟩ | ⟨e, k⟩ := abs_cases.rat x <;> linarith
+ le_abs_self.rat (x : ℚ) : x ≤ |x|
  obtain ⟨e, k⟩ | ⟨e, k⟩ := abs_cases.rat x <;> linarith
+ neg_le_abs.rat (x : ℚ) : 0 - x ≤ |x|
  obtain ⟨e, k⟩ | ⟨e, k⟩ := abs_cases.rat x <;> linarith
+ neg_abs_le.rat (x : ℚ) : 0 - |x| ≤ x
  obtain ⟨e, k⟩ | ⟨e, k⟩ := abs_cases.rat x <;> linarith
+ abs_le.rat (x c : ℚ) : |x| ≤ c ↔ 0 - c ≤ x ∧ x ≤ c
  constructor
  · intro h
    exact ⟨by linarith [neg_le_abs.rat x], by linarith [le_abs_self.rat x]⟩
  · intro h
    obtain ⟨e, k⟩ | ⟨e, k⟩ := abs_cases.rat x <;> linarith
+ abs_lt.rat (x c : ℚ) : |x| < c ↔ 0 - c < x ∧ x < c
  constructor
  · intro h
    exact ⟨by linarith [neg_le_abs.rat x], by linarith [le_abs_self.rat x]⟩
  · intro h
    obtain ⟨e, k⟩ | ⟨e, k⟩ := abs_cases.rat x <;> linarith
+ abs_le_of.rat (x c : ℚ) (h : 0 - c ≤ x) (k : x ≤ c) : |x| ≤ c
  obtain ⟨e, l⟩ | ⟨e, l⟩ := abs_cases.rat x <;> linarith
+ abs_lt_of.rat (x c : ℚ) (h : 0 - c < x) (k : x < c) : |x| < c
  obtain ⟨e, l⟩ | ⟨e, l⟩ := abs_cases.rat x <;> linarith
+ abs_neg.rat (x : ℚ) : |0 - x| = |x|
  obtain ⟨e, k⟩ | ⟨e, k⟩ := abs_cases.rat x <;> obtain ⟨f, l⟩ | ⟨f, l⟩ := abs_cases.rat (0 - x) <;> linarith
+ abs_sub_comm.rat (a b : ℚ) : |a - b| = |b - a|
  obtain ⟨e, k⟩ | ⟨e, k⟩ := abs_cases.rat (a - b) <;> obtain ⟨f, l⟩ | ⟨f, l⟩ := abs_cases.rat (b - a) <;> linarith
+ abs_mul.rat (a b : ℚ) : |a * b| = |a| * |b|
  obtain ⟨e, h⟩ | ⟨e, h⟩ := abs_cases.rat a <;> obtain ⟨f, k⟩ | ⟨f, k⟩ := abs_cases.rat b <;> rw [e, f]
  · rw [abs_of_nonneg.rat (a * b) (mul_nonneg.rat a b h k)]
  · rw [abs_of_nonpos.rat (a * b) (by linarith [mul_nonneg.rat a (0 - b) h (by linarith)])]
    ring
  · rw [abs_of_nonpos.rat (a * b) (by linarith [mul_nonneg.rat (0 - a) b (by linarith) k])]
    ring
  · rw [abs_of_nonneg.rat (a * b) (by linarith [mul_nonneg.rat (0 - a) (0 - b) (by linarith) (by linarith)])]
    ring
+ abs_add.rat (a b : ℚ) : |a + b| ≤ |a| + |b|
  obtain ⟨e, h⟩ | ⟨e, h⟩ := abs_cases.rat (a + b) <;> linarith [le_abs_self.rat a, neg_le_abs.rat a, le_abs_self.rat b, neg_le_abs.rat b]
+ abs_sub.rat (a b : ℚ) : |a - b| ≤ |a| + |b|
  obtain ⟨e, h⟩ | ⟨e, h⟩ := abs_cases.rat (a - b) <;> linarith [le_abs_self.rat a, neg_le_abs.rat a, le_abs_self.rat b, neg_le_abs.rat b]
+ abs_sub_le.rat (a b c : ℚ) : |a - c| ≤ |a - b| + |b - c|
  obtain ⟨e, h⟩ | ⟨e, h⟩ := abs_cases.rat (a - c) <;> linarith [le_abs_self.rat (a - b), neg_le_abs.rat (a - b), le_abs_self.rat (b - c), neg_le_abs.rat (b - c)]
+ abs_sub_abs_le_abs_sub.rat (a b : ℚ) : |a| - |b| ≤ |a - b|
  obtain ⟨e, h⟩ | ⟨e, h⟩ := abs_cases.rat a <;> linarith [le_abs_self.rat (a - b), neg_le_abs.rat (a - b), le_abs_self.rat b, neg_le_abs.rat b]
+ abs_abs_sub_abs_le.rat (a b : ℚ) : | |a| - |b| | ≤ |a - b|
  apply abs_le_of.rat
  · linarith [abs_sub_abs_le_abs_sub.rat b a, abs_sub_comm.rat a b]
  · exact abs_sub_abs_le_abs_sub.rat a b
+ abs_abs.rat (x : ℚ) : | |x| | = |x|
  exact abs_of_nonneg.rat (abs x) (abs_nonneg.rat x)
+ abs_pos.rat (x : ℚ) (h : x ≠ 0) : 0 < |x|
  obtain ⟨e, k⟩ | ⟨e, k⟩ := abs_cases.rat x <;> linarith
+ abs_sq.rat (x : ℚ) : |x| * |x| = x * x
  obtain ⟨e, k⟩ | ⟨e, k⟩ := abs_cases.rat x <;> rw [e] <;> ring
+ sq_abs.rat (x : ℚ) : |x| ^ 2 = x ^ 2
  obtain ⟨e, k⟩ | ⟨e, k⟩ := abs_cases.rat x <;> rw [e] <;> ring
+ abs_le_abs.rat (a b : ℚ) (h : a ≤ b) (k : 0 - b ≤ a) : |a| ≤ |b|
  obtain ⟨e, l⟩ | ⟨e, l⟩ := abs_cases.rat a <;> linarith [le_abs_self.rat b, neg_le_abs.rat b]
+ abs_le_abs_of_nonneg.rat (a b : ℚ) (h : 0 ≤ a) (k : a ≤ b) : |a| ≤ |b|
  rw [abs_of_nonneg.rat a h, abs_of_nonneg.rat b (by linarith)]
  exact k
+ abs_eq_zero.rat (x : ℚ) : |x| = 0 ↔ x = 0
  constructor
  · intro h
    obtain ⟨e, k⟩ | ⟨e, k⟩ := abs_cases.rat x <;> linarith
  · intro h
    rw [h]
    decide
+ sq_le_sq.rat (a b : ℚ) : a ^ 2 ≤ b ^ 2 ↔ |a| ≤ |b|
  have e := sq_abs.rat a
  have f := sq_abs.rat b
  have p := abs_nonneg.rat a
  have q := abs_nonneg.rat b
  constructor <;> intro h <;> nlinarith
+ sq_lt_sq.rat (a b : ℚ) : a ^ 2 < b ^ 2 ↔ |a| < |b|
  have e := sq_abs.rat a
  have f := sq_abs.rat b
  have p := abs_nonneg.rat a
  have q := abs_nonneg.rat b
  constructor <;> intro h <;> nlinarith
+ abs_le_of_sq_le_sq.rat (a b : ℚ) (h : a ^ 2 ≤ b ^ 2) (hb : 0 ≤ b) : |a| ≤ b
  have k := (sq_le_sq.rat a b).mp h
  rw [abs_of_nonneg.rat b hb] at k
  exact k
+ abs_pow.rat (a : ℚ) (n : ℕ) : |a ^ n| = |a| ^ n
  induction n with n ih
  · simp
  · rw [succ_eq_add_one.nat, pow_succ.rat, pow_succ.rat, abs_mul.rat, ih]

-- ℤ
+ abs_cases.int (x : ℤ) : (|x| = x ∧ 0 ≤ x) ∨ (|x| = 0 - x ∧ x < 0)
  by_cases h : 0 ≤ x
  · left
    exact ⟨abs_of_nonneg.int x h, h⟩
  · right
    have e := abs_of_neg.int x (by linarith)
    have e2 : neg x = 0 - x := by ring
    rw [e2] at e
    exact ⟨e, by linarith⟩
+ abs_of_nonpos.int (x : ℤ) (h : x ≤ 0) : |x| = 0 - x
  obtain ⟨e, k⟩ | ⟨e, k⟩ := abs_cases.int x <;> linarith
+ abs_of_pos.int (x : ℤ) (h : 0 < x) : |x| = x
  obtain ⟨e, k⟩ | ⟨e, k⟩ := abs_cases.int x <;> linarith
+ le_abs_self.int (x : ℤ) : x ≤ |x|
  obtain ⟨e, k⟩ | ⟨e, k⟩ := abs_cases.int x <;> linarith
+ neg_le_abs.int (x : ℤ) : 0 - x ≤ |x|
  obtain ⟨e, k⟩ | ⟨e, k⟩ := abs_cases.int x <;> linarith
+ neg_abs_le.int (x : ℤ) : 0 - |x| ≤ x
  obtain ⟨e, k⟩ | ⟨e, k⟩ := abs_cases.int x <;> linarith
+ abs_le.int (x c : ℤ) : |x| ≤ c ↔ 0 - c ≤ x ∧ x ≤ c
  constructor
  · intro h
    exact ⟨by linarith [neg_le_abs.int x], by linarith [le_abs_self.int x]⟩
  · intro h
    obtain ⟨e, k⟩ | ⟨e, k⟩ := abs_cases.int x <;> linarith
+ abs_lt.int (x c : ℤ) : |x| < c ↔ 0 - c < x ∧ x < c
  constructor
  · intro h
    exact ⟨by linarith [neg_le_abs.int x], by linarith [le_abs_self.int x]⟩
  · intro h
    obtain ⟨e, k⟩ | ⟨e, k⟩ := abs_cases.int x <;> linarith
+ abs_le_of.int (x c : ℤ) (h : 0 - c ≤ x) (k : x ≤ c) : |x| ≤ c
  obtain ⟨e, l⟩ | ⟨e, l⟩ := abs_cases.int x <;> linarith
+ abs_lt_of.int (x c : ℤ) (h : 0 - c < x) (k : x < c) : |x| < c
  obtain ⟨e, l⟩ | ⟨e, l⟩ := abs_cases.int x <;> linarith
+ abs_neg.int (x : ℤ) : |0 - x| = |x|
  obtain ⟨e, k⟩ | ⟨e, k⟩ := abs_cases.int x <;> obtain ⟨f, l⟩ | ⟨f, l⟩ := abs_cases.int (0 - x) <;> linarith
+ abs_sub_comm.int (a b : ℤ) : |a - b| = |b - a|
  obtain ⟨e, k⟩ | ⟨e, k⟩ := abs_cases.int (a - b) <;> obtain ⟨f, l⟩ | ⟨f, l⟩ := abs_cases.int (b - a) <;> linarith
+ abs_mul.int (a b : ℤ) : |a * b| = |a| * |b|
  obtain ⟨e, h⟩ | ⟨e, h⟩ := abs_cases.int a <;> obtain ⟨f, k⟩ | ⟨f, k⟩ := abs_cases.int b <;> rw [e, f]
  · rw [abs_of_nonneg.int (a * b) (mul_nonneg.int a b h k)]
  · rw [abs_of_nonpos.int (a * b) (by linarith [mul_nonneg.int a (0 - b) h (by linarith)])]
    ring
  · rw [abs_of_nonpos.int (a * b) (by linarith [mul_nonneg.int (0 - a) b (by linarith) k])]
    ring
  · rw [abs_of_nonneg.int (a * b) (by linarith [mul_nonneg.int (0 - a) (0 - b) (by linarith) (by linarith)])]
    ring
+ abs_add.int (a b : ℤ) : |a + b| ≤ |a| + |b|
  obtain ⟨e, h⟩ | ⟨e, h⟩ := abs_cases.int (a + b) <;> linarith [le_abs_self.int a, neg_le_abs.int a, le_abs_self.int b, neg_le_abs.int b]
+ abs_sub.int (a b : ℤ) : |a - b| ≤ |a| + |b|
  obtain ⟨e, h⟩ | ⟨e, h⟩ := abs_cases.int (a - b) <;> linarith [le_abs_self.int a, neg_le_abs.int a, le_abs_self.int b, neg_le_abs.int b]
+ abs_sub_le.int (a b c : ℤ) : |a - c| ≤ |a - b| + |b - c|
  obtain ⟨e, h⟩ | ⟨e, h⟩ := abs_cases.int (a - c) <;> linarith [le_abs_self.int (a - b), neg_le_abs.int (a - b), le_abs_self.int (b - c), neg_le_abs.int (b - c)]
+ abs_sub_abs_le_abs_sub.int (a b : ℤ) : |a| - |b| ≤ |a - b|
  obtain ⟨e, h⟩ | ⟨e, h⟩ := abs_cases.int a <;> linarith [le_abs_self.int (a - b), neg_le_abs.int (a - b), le_abs_self.int b, neg_le_abs.int b]
+ abs_abs_sub_abs_le.int (a b : ℤ) : | |a| - |b| | ≤ |a - b|
  apply abs_le_of.int
  · linarith [abs_sub_abs_le_abs_sub.int b a, abs_sub_comm.int a b]
  · exact abs_sub_abs_le_abs_sub.int a b
+ abs_abs.int (x : ℤ) : | |x| | = |x|
  exact abs_of_nonneg.int (abs x) (abs_nonneg.int x)
+ abs_pos.int (x : ℤ) (h : x ≠ 0) : 0 < |x|
  obtain ⟨e, k⟩ | ⟨e, k⟩ := abs_cases.int x <;> linarith
+ abs_sq.int (x : ℤ) : |x| * |x| = x * x
  obtain ⟨e, k⟩ | ⟨e, k⟩ := abs_cases.int x <;> rw [e] <;> ring
+ sq_abs.int (x : ℤ) : |x| ^ 2 = x ^ 2
  obtain ⟨e, k⟩ | ⟨e, k⟩ := abs_cases.int x <;> rw [e] <;> ring
+ abs_le_abs.int (a b : ℤ) (h : a ≤ b) (k : 0 - b ≤ a) : |a| ≤ |b|
  obtain ⟨e, l⟩ | ⟨e, l⟩ := abs_cases.int a <;> linarith [le_abs_self.int b, neg_le_abs.int b]
+ abs_le_abs_of_nonneg.int (a b : ℤ) (h : 0 ≤ a) (k : a ≤ b) : |a| ≤ |b|
  rw [abs_of_nonneg.int a h, abs_of_nonneg.int b (by linarith)]
  exact k
+ abs_eq_zero.int (x : ℤ) : |x| = 0 ↔ x = 0
  constructor
  · intro h
    obtain ⟨e, k⟩ | ⟨e, k⟩ := abs_cases.int x <;> linarith
  · intro h
    rw [h]
    decide
+ sq_le_sq.int (a b : ℤ) : a ^ 2 ≤ b ^ 2 ↔ |a| ≤ |b|
  have e := sq_abs.int a
  have f := sq_abs.int b
  have p := abs_nonneg.int a
  have q := abs_nonneg.int b
  constructor <;> intro h <;> nlinarith
+ sq_lt_sq.int (a b : ℤ) : a ^ 2 < b ^ 2 ↔ |a| < |b|
  have e := sq_abs.int a
  have f := sq_abs.int b
  have p := abs_nonneg.int a
  have q := abs_nonneg.int b
  constructor <;> intro h <;> nlinarith
+ abs_le_of_sq_le_sq.int (a b : ℤ) (h : a ^ 2 ≤ b ^ 2) (hb : 0 ≤ b) : |a| ≤ b
  have k := (sq_le_sq.int a b).mp h
  rw [abs_of_nonneg.int b hb] at k
  exact k
+ abs_pow.int (a : ℤ) (n : ℕ) : |a ^ n| = |a| ^ n
  induction n with n ih
  · simp
  · rw [succ_eq_add_one.nat, pow_succ.int, pow_succ.int, abs_mul.int, ih]

-- ---- min and max (ℝ ℚ ℤ ℕ; nat.sat defines them by if) ---------------------------------------------------
-- min_cases.T / max_cases.T split a min or max into its two branches
-- ℝ
+ min_cases.real (a b : ℝ) : (min a b = a ∧ a ≤ b) ∨ (min a b = b ∧ b < a)
  by_cases h : a ≤ b
  · left; exact ⟨by simp [min, h], h⟩
  · right; exact ⟨by simp [min, h], by linarith⟩
+ max_cases.real (a b : ℝ) : (max a b = b ∧ a ≤ b) ∨ (max a b = a ∧ b < a)
  by_cases h : a ≤ b
  · left; exact ⟨by simp [max, h], h⟩
  · right; exact ⟨by simp [max, h], by linarith⟩
+ min_le_left.real (a b : ℝ) : min a b ≤ a
  obtain ⟨e, h⟩ | ⟨e, h⟩ := min_cases.real a b <;> linarith
+ min_le_right.real (a b : ℝ) : min a b ≤ b
  obtain ⟨e, h⟩ | ⟨e, h⟩ := min_cases.real a b <;> linarith
+ le_min.real (a b c : ℝ) (h : c ≤ a) (k : c ≤ b) : c ≤ min a b
  obtain ⟨e, l⟩ | ⟨e, l⟩ := min_cases.real a b <;> linarith
+ lt_min.real (a b c : ℝ) (h : c < a) (k : c < b) : c < min a b
  obtain ⟨e, l⟩ | ⟨e, l⟩ := min_cases.real a b <;> linarith
+ le_min_iff.real (a b c : ℝ) : c ≤ min a b ↔ c ≤ a ∧ c ≤ b
  constructor
  · intro h; exact ⟨by linarith [min_le_left.real a b], by linarith [min_le_right.real a b]⟩
  · intro h; exact le_min.real a b c h.1 h.2
+ min_eq_left.real (a b : ℝ) (h : a ≤ b) : min a b = a
  obtain ⟨e, l⟩ | ⟨e, l⟩ := min_cases.real a b <;> linarith
+ min_eq_right.real (a b : ℝ) (h : b ≤ a) : min a b = b
  obtain ⟨e, l⟩ | ⟨e, l⟩ := min_cases.real a b <;> linarith
+ min_comm.real (a b : ℝ) : min a b = min b a
  obtain ⟨e, h⟩ | ⟨e, h⟩ := min_cases.real a b <;> obtain ⟨f, k⟩ | ⟨f, k⟩ := min_cases.real b a <;> linarith
+ min_self.real (a : ℝ) : min a a = a
  exact min_eq_left.real a a (le_refl.real a)
+ le_max_left.real (a b : ℝ) : a ≤ max a b
  obtain ⟨e, h⟩ | ⟨e, h⟩ := max_cases.real a b <;> linarith
+ le_max_right.real (a b : ℝ) : b ≤ max a b
  obtain ⟨e, h⟩ | ⟨e, h⟩ := max_cases.real a b <;> linarith
+ max_le.real (a b c : ℝ) (h : a ≤ c) (k : b ≤ c) : max a b ≤ c
  obtain ⟨e, l⟩ | ⟨e, l⟩ := max_cases.real a b <;> linarith
+ max_lt.real (a b c : ℝ) (h : a < c) (k : b < c) : max a b < c
  obtain ⟨e, l⟩ | ⟨e, l⟩ := max_cases.real a b <;> linarith
+ max_le_iff.real (a b c : ℝ) : max a b ≤ c ↔ a ≤ c ∧ b ≤ c
  constructor
  · intro h; exact ⟨by linarith [le_max_left.real a b], by linarith [le_max_right.real a b]⟩
  · intro h; exact max_le.real a b c h.1 h.2
+ max_eq_left.real (a b : ℝ) (h : b ≤ a) : max a b = a
  obtain ⟨e, l⟩ | ⟨e, l⟩ := max_cases.real a b <;> linarith
+ max_eq_right.real (a b : ℝ) (h : a ≤ b) : max a b = b
  obtain ⟨e, l⟩ | ⟨e, l⟩ := max_cases.real a b <;> linarith
+ max_comm.real (a b : ℝ) : max a b = max b a
  obtain ⟨e, h⟩ | ⟨e, h⟩ := max_cases.real a b <;> obtain ⟨f, k⟩ | ⟨f, k⟩ := max_cases.real b a <;> linarith
+ max_self.real (a : ℝ) : max a a = a
  exact max_eq_left.real a a (le_refl.real a)
+ min_le_max.real (a b : ℝ) : min a b ≤ max a b
  linarith [min_le_left.real a b, le_max_left.real a b]
+ min_add_max.real (a b : ℝ) : min a b + max a b = a + b
  obtain ⟨e, h⟩ | ⟨e, h⟩ := min_cases.real a b <;> obtain ⟨f, k⟩ | ⟨f, k⟩ := max_cases.real a b <;> linarith

