+ le_max_right.nat (a b : ℕ) : b ≤ max a b
  obtain ⟨e, h⟩ | ⟨e, h⟩ := max_cases.nat a b <;> linarith
+ max_le.nat (a b c : ℕ) (h : a ≤ c) (k : b ≤ c) : max a b ≤ c
  obtain ⟨e, l⟩ | ⟨e, l⟩ := max_cases.nat a b <;> linarith
+ max_lt.nat (a b c : ℕ) (h : a < c) (k : b < c) : max a b < c
  obtain ⟨e, l⟩ | ⟨e, l⟩ := max_cases.nat a b <;> linarith
