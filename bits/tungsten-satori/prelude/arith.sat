+ min_le_max.rat (a b : ℚ) : min a b ≤ max a b
  linarith [min_le_left.rat a b, le_max_left.rat a b]
+ min_add_max.rat (a b : ℚ) : min a b + max a b = a + b
  obtain ⟨e, h⟩ | ⟨e, h⟩ := min_cases.rat a b <;> obtain ⟨f, k⟩ | ⟨f, k⟩ := max_cases.rat a b <;> linarith

-- ℤ
+ min_cases.int (a b : ℤ) : (min a b = a ∧ a ≤ b) ∨ (min a b = b ∧ b < a)
  by_cases h : a ≤ b
  · left; exact ⟨by simp [min, h], h⟩
  · right; exact ⟨by simp [min, h], by linarith⟩
+ max_cases.int (a b : ℤ) : (max a b = b ∧ a ≤ b) ∨ (max a b = a ∧ b < a)
  by_cases h : a ≤ b
  · left; exact ⟨by simp [max, h], h⟩
  · right; exact ⟨by simp [max, h], by linarith⟩
+ min_le_left.int (a b : ℤ) : min a b ≤ a
  obtain ⟨e, h⟩ | ⟨e, h⟩ := min_cases.int a b <;> linarith
+ min_le_right.int (a b : ℤ) : min a b ≤ b
  obtain ⟨e, h⟩ | ⟨e, h⟩ := min_cases.int a b <;> linarith
+ le_min.int (a b c : ℤ) (h : c ≤ a) (k : c ≤ b) : c ≤ min a b
  obtain ⟨e, l⟩ | ⟨e, l⟩ := min_cases.int a b <;> linarith
+ lt_min.int (a b c : ℤ) (h : c < a) (k : c < b) : c < min a b
  obtain ⟨e, l⟩ | ⟨e, l⟩ := min_cases.int a b <;> linarith
+ le_min_iff.int (a b c : ℤ) : c ≤ min a b ↔ c ≤ a ∧ c ≤ b
  constructor
  · intro h; exact ⟨by linarith [min_le_left.int a b], by linarith [min_le_right.int a b]⟩
  · intro h; exact le_min.int a b c h.1 h.2
+ min_eq_left.int (a b : ℤ) (h : a ≤ b) : min a b = a
  obtain ⟨e, l⟩ | ⟨e, l⟩ := min_cases.int a b <;> linarith
+ min_eq_right.int (a b : ℤ) (h : b ≤ a) : min a b = b
  obtain ⟨e, l⟩ | ⟨e, l⟩ := min_cases.int a b <;> linarith
+ min_comm.int (a b : ℤ) : min a b = min b a
  obtain ⟨e, h⟩ | ⟨e, h⟩ := min_cases.int a b <;> obtain ⟨f, k⟩ | ⟨f, k⟩ := min_cases.int b a <;> linarith
+ min_self.int (a : ℤ) : min a a = a
  exact min_eq_left.int a a (le_refl.int a)
+ le_max_left.int (a b : ℤ) : a ≤ max a b
  obtain ⟨e, h⟩ | ⟨e, h⟩ := max_cases.int a b <;> linarith
+ le_max_right.int (a b : ℤ) : b ≤ max a b
  obtain ⟨e, h⟩ | ⟨e, h⟩ := max_cases.int a b <;> linarith
+ max_le.int (a b c : ℤ) (h : a ≤ c) (k : b ≤ c) : max a b ≤ c
  obtain ⟨e, l⟩ | ⟨e, l⟩ := max_cases.int a b <;> linarith
+ max_lt.int (a b c : ℤ) (h : a < c) (k : b < c) : max a b < c
  obtain ⟨e, l⟩ | ⟨e, l⟩ := max_cases.int a b <;> linarith
+ max_le_iff.int (a b c : ℤ) : max a b ≤ c ↔ a ≤ c ∧ b ≤ c
  constructor
  · intro h; exact ⟨by linarith [le_max_left.int a b], by linarith [le_max_right.int a b]⟩
  · intro h; exact max_le.int a b c h.1 h.2
+ max_eq_left.int (a b : ℤ) (h : b ≤ a) : max a b = a
  obtain ⟨e, l⟩ | ⟨e, l⟩ := max_cases.int a b <;> linarith
+ max_eq_right.int (a b : ℤ) (h : a ≤ b) : max a b = b
  obtain ⟨e, l⟩ | ⟨e, l⟩ := max_cases.int a b <;> linarith
+ max_comm.int (a b : ℤ) : max a b = max b a
  obtain ⟨e, h⟩ | ⟨e, h⟩ := max_cases.int a b <;> obtain ⟨f, k⟩ | ⟨f, k⟩ := max_cases.int b a <;> linarith
+ max_self.int (a : ℤ) : max a a = a
  exact max_eq_left.int a a (le_refl.int a)
+ min_le_max.int (a b : ℤ) : min a b ≤ max a b
  linarith [min_le_left.int a b, le_max_left.int a b]
+ min_add_max.int (a b : ℤ) : min a b + max a b = a + b
  obtain ⟨e, h⟩ | ⟨e, h⟩ := min_cases.int a b <;> obtain ⟨f, k⟩ | ⟨f, k⟩ := max_cases.int a b <;> linarith

