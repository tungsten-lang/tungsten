    have hn := h n (by linarith)
    have r : ∀ i < n, 0 ≤ f i := by intro i hi; exact h i (by linarith)
    by_cases c : k < n
    · linarith [ih r c]
    · have e : k = n := by linarith
      rw [e]
      linarith [sum_nonneg.nat f n r]
