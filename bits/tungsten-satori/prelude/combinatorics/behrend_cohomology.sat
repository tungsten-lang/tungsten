+ sum_single_nat_m41 (M a : ℕ) (ha : a < M) :
    (∑ v < M, if a = v then (1 : ℕ) else 0) = 1
  induction M with ha r ihr ha
  · omega
  · rw [succ_eq_add_one.nat] at ha ⊢
    rw [sum_below_succ]
    by_cases har : a = r
    · have hz : (∑ v < r, if a = v then (1 : ℕ) else 0) = 0
        have h0 : ∀ t : ℕ, (∀ v < t, a ≠ v) → (∑ v < t, if a = v then (1 : ℕ) else 0) = 0
          intro t ht; induction t with ht s ihs ht
          · rw [sum_below_zero]
          · rw [succ_eq_add_one.nat] at ht ⊢
            rw [sum_below_succ, ihs (by intro v hv; exact ht v (by omega)), if_neg (ht s (by omega))]; omega
        exact h0 r (by intro v hv; omega)
      rw [hz, if_pos har]; omega
    · rw [if_neg har, ihr (by omega)]; omega

+ sum_indicator_unique_m41 (L : ℕ) (P : ℕ → Prop)
    (huniq : ∀ u1 u2 : ℕ, u1 < L → u2 < L → P u1 → P u2 → u1 = u2) :
    (if (∃ u < L, P u) then (1 : ℕ) else 0) = ∑ u < L, if P u then (1 : ℕ) else 0
  by_cases hex : ∃ u < L, P u
  · rw [if_pos hex]
    obtain ⟨u0, hu0, hPu0⟩ := hex
    have hcon : (∑ u < L, if P u then (1 : ℕ) else 0) = ∑ u < L, if u0 = u then (1 : ℕ) else 0
      apply sum_below.congr; intro u hu
      by_cases heq : u0 = u
      · rw [if_pos heq, ← heq, if_pos hPu0]
      · have hnp : ¬ P u := by intro hPu; exact heq (huniq u0 u hu0 hu hPu0 hPu)
        rw [if_neg heq, if_neg hnp]
    rw [hcon, sum_single_nat_m41 L u0 hu0]
  · rw [if_neg hex]
    have h0 : ∀ t ≤ L, (∑ u < t, if P u then (1 : ℕ) else 0) = 0
      intro t ht; induction t with ht s ihs ht
      · rw [sum_below_zero]
      · rw [succ_eq_add_one.nat] at ht ⊢
        have hnp : ¬ P s := by intro hPs; exact hex ⟨s, by omega, hPs⟩
        rw [sum_below_succ, ihs (by omega), if_neg hnp]; omega
    exact (h0 L (by omega)).symm

