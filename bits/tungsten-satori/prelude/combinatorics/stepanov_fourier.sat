-- Milestone 3.1: Classical Stepanov's Method Core & Alpöge's Fourier-Analytic Toy Setting
-- Reference: Levent Alpöge (with Claude), "A remark on the Riemann Hypothesis" (2026-11-20),
-- footnote 3: Fourier-analytic path-quadric counting identity `q * N = M^k + R` and sign obstruction.
--
-- ALL theorems in this file are proved unconditionally on Satori's foundational HOL kernel
-- (ZERO custom axioms; verified with `#axioms`).

import zmod
import complex_sum
import matrix
import dirichlet
import measure

-- ====================================================================================
-- PART A: Classical Stepanov's Method Core (Multiplicity Bound + Weil Parameter Balance)
-- ====================================================================================

-- Auxiliary-polynomial multiplicity bound:
-- If an auxiliary polynomial vanishes to order >= m at each of N points, and the sum of
-- vanishing orders is bounded by its degree D, then m * N <= D.
+ stepanov.multiplicity_bound (N m D : ℕ) (ord : ℕ → ℕ)
    (hord : ∀ i < N, m ≤ ord i)
    (hdeg : (∑ i < N, (ord i : ℝ)) ≤ (D : ℝ)) :
    (m : ℝ) * (N : ℝ) ≤ (D : ℝ)
  have hlow : (m : ℝ) * (N : ℝ) ≤ ∑ i < N, (ord i : ℝ)
    have hconst : (∑ i < N, (m : ℝ)) = (N : ℝ) * (m : ℝ) := sum_const.real (m : ℝ) N
    have hmono : (∑ i < N, (m : ℝ)) ≤ ∑ i < N, (ord i : ℝ)
      have hdiff : (0 : ℝ) ≤ ∑ i < N, ((ord i : ℝ) - (m : ℝ))
        apply sum_nonneg.real
        intro i hi
        have hmi : m ≤ ord i := hord i hi
        have hdiff_nat : ord i = m + (ord i - m) := by omega
        rw [hdiff_nat]
        simp
        linarith [cast_nonneg.real (ord i - m)]
      rw [sum_sub.real] at hdiff
      linarith
    linarith
  linarith

-- Stepanov's Weil-bound parameter optimization:
-- Given any real auxiliary degree budget `N - (q + 1) <= g * t + g * q / t` valid for all
-- balancing ratios `t > 0`, choosing `t = s` where `s > 0` and `s^2 = q` yields the
-- Weil upper bound `N - (q + 1) <= 2 * g * s` (i.e., `2 * g * sqrt(q)`).
+ stepanov.weil_upper_bound (N q g s : ℝ) (hs : 0 < s) (hsq : s * s = q)
    (hbudget : ∀ t : ℝ, 0 < t → N - (q + 1) ≤ g * t + g * q / t) :
    N - (q + 1) ≤ 2 * g * s
  have h1 := hbudget s hs
  have hsne : s ≠ 0 := by linarith
  have hdiv : g * q / s = g * s
    rw [← hsq]
    have hmul : (g * (s * s)) / s = (g * s) * (s / s) := by
      rw [div_def.real (g * (s * s)) s, div_def.real s s]
      ring
    have hss : s / s = 1 := by
      rw [div_def.real s s]
      have hm := mul_div_cancel.real 1 s hsne
      linarith
    rw [hmul, hss]
    ring
  linarith

-- Two-sided Stepanov-Weil bound: `|N - (q + 1)| <= 2 * g * sqrt(q)`.
+ stepanov.weil_two_sided (N q g s : ℝ) (hs : 0 < s) (hsq : s * s = q)
    (hbudget : ∀ t : ℝ, 0 < t → |N - (q + 1)| ≤ g * t + g * q / t) :
    |N - (q + 1)| ≤ 2 * g * s
  have h1 := hbudget s hs
  have hsne : s ≠ 0 := by linarith
  have hdiv : g * q / s = g * s
    rw [← hsq]
    have hmul : (g * (s * s)) / s = (g * s) * (s / s) := by
      rw [div_def.real (g * (s * s)) s, div_def.real s s]
      ring
    have hss : s / s = 1 := by
      rw [div_def.real s s]
      have hm := mul_div_cancel.real 1 s hsne
      linarith
    rw [hmul, hss]
    ring
  linarith

-- ====================================================================================
-- PART B: Primitive q-th Roots of Unity & Complete Character Orthogonality mod q
-- ====================================================================================

-> is_primitive_root (q : ℕ) (zeta : ℂ) : Prop :=
  0 < q ∧
  cpow_nat zeta q = complex.one ∧
  (∀ r : ℕ, 0 < r → r < q → cpow_nat zeta r ≠ complex.one)

-- Complete discrete Fourier indicator identity on Z/qZ for any primitive q-th root zeta:
--   sum_{h < q} zeta^(h * a) = q   if a % q = 0
--   sum_{h < q} zeta^(h * a) = 0   if a % q != 0
+ root.orthogonality (q : ℕ) (zeta : ℂ) (hprim : is_primitive_root q zeta) (a : ℕ) :
    csum q (fun h => cpow_nat zeta (h * a))
      = if a % q = 0 then complex.of_real (q : ℝ) else complex.zero
  unfold is_primitive_root at hprim
  obtain ⟨hqpos, hzq, hne_small⟩ := hprim
  by_cases hz : a % q = 0
  · simp [hz]
    have hza : cpow_nat zeta a = complex.one
      rw [cpow_nat.mod_eq q zeta hzq a, hz]
      simp [cpow_nat]
    have hcon : csum q (fun h => cpow_nat zeta (h * a)) = csum q (fun _ => complex.one)
      apply csum.congr; intro h hh
      have hcomm : h * a = a * h := by ring
      rw [hcomm, cpow_nat.mul, hza, cpow_nat.one]
    rw [hcon, csum.const]
    ring
  · simp [hz]
    have hlt : a % q < q := mod_lt.nat a q hqpos
    have hgt : 0 < a % q := by omega
    have hza_ne : cpow_nat zeta a ≠ complex.one
      rw [cpow_nat.mod_eq q zeta hzq a]
      exact hne_small (a % q) hgt hlt
    have hcon : csum q (fun h => cpow_nat zeta (h * a)) = csum q (fun h => cpow_nat (cpow_nat zeta a) h)
      apply csum.congr; intro h hh
      have hcomm : h * a = a * h := by ring
      rw [hcomm, cpow_nat.mul]
    rw [hcon]
    have hgeom := csum.geom_series q (cpow_nat zeta a)
    have hqpow : cpow_nat (cpow_nat zeta a) q = complex.one
      rw [← cpow_nat.mul]
      have hcomm : a * q = q * a := by ring
      rw [hcomm, cpow_nat.mul, hzq, cpow_nat.one]
    rw [hqpow, complex.sub_self] at hgeom
    have hne0 : complex.sub (cpow_nat zeta a) complex.one ≠ complex.zero
      intro h0
      apply hza_ne
      have hre : complex.re (complex.sub (cpow_nat zeta a) complex.one) = complex.re complex.zero := by rw [h0]
      have him : complex.im (complex.sub (cpow_nat zeta a) complex.one) = complex.im complex.zero := by rw [h0]
      simp at hre him
      apply complex.ext
      · simp; linarith
      · simp; linarith
    by_contra hsum_ne
    have hsum_ne0 : csum q (fun h => cpow_nat (cpow_nat zeta a) h) ≠ complex.zero
      intro h0
      apply hsum_ne
      rw [h0]
      apply complex.ext <;> simp
    exact complex.mul_ne_zero (complex.sub (cpow_nat zeta a) complex.one) (csum q (fun h => cpow_nat (cpow_nat zeta a) h)) hne0 hsum_ne0 hgeom

-- ====================================================================================
-- PART C: Alpöge's Toy Setting (remark.pdf fn. 3) — General k-Step Path Identity
--         q * N_k = M^k + R_k
-- ====================================================================================

-- Single-step weighted exponential sum S_h = sum_{x < q} t(x) * zeta^(h * phi(x))
-> toy.step_sum (q : ℕ) (zeta : ℂ) (phi : ℕ → ℕ) (t : ℕ → ℂ) (h : ℕ) : ℂ :=
  csum q (fun x => complex.mul (t x) (cpow_nat zeta (h * phi x)))

-- Frequency-h contribution of a k-step chain: (S_h)^k
-> toy.chain_mode (q : ℕ) (zeta : ℂ) (phi : ℕ → ℕ) (t : ℕ → ℂ) (k h : ℕ) : ℂ :=
  cpow_nat (toy.step_sum q zeta phi t h) k

-- Weighted count N_k(acc) of k-tuples (x_1, ..., x_k) in (Z/qZ)^k with
--   acc + phi(x_1) + ... + phi(x_k) == 0 (mod q), weighted by t(x_1) * ... * t(x_k).
-> toy.chain_count_at (q : ℕ) (phi : ℕ → ℕ) (t : ℕ → ℂ) : ℕ → ℕ → ℂ
  | 0 => fun acc => if acc % q = 0 then complex.one else complex.zero
  | k + 1 => fun acc => csum q (fun x => complex.mul (t x) (toy.chain_count_at q phi t k (acc + phi x)))

-> toy.chain_count (q : ℕ) (phi : ℕ → ℕ) (t : ℕ → ℂ) (k : ℕ) : ℂ :=
  toy.chain_count_at q phi t k 0

-- Main-term mass M = sum_{x < q} t(x)
-> toy.mass (q : ℕ) (t : ℕ → ℂ) : ℂ := csum q t

-- Non-zero frequency remainder R_k = sum_{1 <= h < q} (S_h)^k
-> toy.remainder (q : ℕ) (zeta : ℂ) (phi : ℕ → ℕ) (t : ℕ → ℂ) (k : ℕ) : ℂ :=
  csum (q - 1) (fun h => toy.chain_mode q zeta phi t k (h + 1))

-- Lemma 1: At frequency h = 0, the step sum equals M = sum_{x < q} t(x).
+ toy.step_sum_zero (q : ℕ) (zeta : ℂ) (phi : ℕ → ℕ) (t : ℕ → ℂ) :
    toy.step_sum q zeta phi t 0 = toy.mass q t
  unfold toy.step_sum toy.mass
  apply csum.congr
  intro x hx
  have h0 : 0 * phi x = 0 := by ring
  rw [h0]
  simp [cpow_nat]
  exact complex.mul_one (t x)

-- Lemma 2: At frequency h = 0, the k-step chain mode equals M^k.
+ toy.chain_mode_zero (q : ℕ) (zeta : ℂ) (phi : ℕ → ℕ) (t : ℕ → ℂ) (k : ℕ) :
    toy.chain_mode q zeta phi t k 0 = cpow_nat (toy.mass q t) k
  unfold toy.chain_mode
  rw [toy.step_sum_zero]

-- Lemma 3 (Recursive Fourier-to-Counting bridge for arbitrary k and phase shift acc):
--   sum_{h < q} zeta^(h * acc) * (S_h)^k = q * chain_count_at(k, acc).
+ toy.chain_fourier_bridge (q : ℕ) (zeta : ℂ) (phi : ℕ → ℕ) (t : ℕ → ℂ)
    (hprim : is_primitive_root q zeta) (k : ℕ) :
    ∀ acc : ℕ,
      csum q (fun h => complex.mul (cpow_nat zeta (h * acc)) (toy.chain_mode q zeta phi t k h))
        = complex.mul (complex.of_real (q : ℝ)) (toy.chain_count_at q phi t k acc)
  induction k with acc j ih acc
  · unfold toy.chain_mode
    simp [toy.chain_count_at, cpow_nat]
    have h1 : csum q (fun h => complex.mul (cpow_nat zeta (h * acc)) complex.one) = csum q (fun h => cpow_nat zeta (h * acc)) := by apply csum.congr; intro h hh; exact complex.mul_one (cpow_nat zeta (h * acc))
    rw [h1, root.orthogonality q zeta hprim acc]
    by_cases hz : acc % q = 0
    · simp [hz]
      ring
    · simp [hz]
      ring
  · rw [succ_eq_add_one.nat]
    have hstep : csum q (fun h => complex.mul (cpow_nat zeta (h * acc)) (toy.chain_mode q zeta phi t (j + 1) h)) = csum q (fun x => complex.mul (t x) (csum q (fun h => complex.mul (cpow_nat zeta (h * (acc + phi x))) (toy.chain_mode q zeta phi t j h))))
      have he1 : csum q (fun h => complex.mul (cpow_nat zeta (h * acc)) (toy.chain_mode q zeta phi t (j + 1) h)) = csum q (fun h => csum q (fun x => complex.mul (t x) (complex.mul (cpow_nat zeta (h * (acc + phi x))) (toy.chain_mode q zeta phi t j h))))
        apply csum.congr; intro h hh
        unfold toy.chain_mode toy.step_sum
        simp [cpow_nat]
        have hmove : complex.mul (cpow_nat zeta (h * acc)) (complex.mul (cpow_nat (csum q (fun x => complex.mul (t x) (cpow_nat zeta (h * phi x)))) j) (csum q (fun x => complex.mul (t x) (cpow_nat zeta (h * phi x))))) = complex.mul (complex.mul (cpow_nat zeta (h * acc)) (cpow_nat (csum q (fun x => complex.mul (t x) (cpow_nat zeta (h * phi x)))) j)) (csum q (fun x => complex.mul (t x) (cpow_nat zeta (h * phi x))))
          rw [complex.mul_assoc]
        rw [hmove, ← csum.scale_left]
        apply csum.congr; intro x hx
        have hdist : h * (acc + phi x) = h * acc + h * phi x := by ring
        rw [hdist, cpow_nat.add]
        apply complex.ext <;> simp <;> ring
      rw [he1, csum.swap]
      apply csum.congr; intro x hx
      rw [csum.scale_left]
    rw [hstep]
    have hcon : csum q (fun x => complex.mul (t x) (csum q (fun h => complex.mul (cpow_nat zeta (h * (acc + phi x))) (toy.chain_mode q zeta phi t j h)))) = csum q (fun x => complex.mul (t x) (complex.mul (complex.of_real (q : ℝ)) (toy.chain_count_at q phi t j (acc + phi x))))
      apply csum.congr; intro x hx
      rw [ih (acc + phi x)]
    rw [hcon]
    simp [toy.chain_count_at]
    rw [← csum.scale_left]
    apply csum.congr; intro x hx
    ring

-- MAIN THEOREM 1 (Alpöge's Toy Identity, remark.pdf fn. 3):
-- For EVERY modulus q >= 1, primitive q-th root zeta, phase phi, weight t, and chain length k:
--   q * N_k = M^k + R_k.
+ toy.fundamental_identity (q : ℕ) (zeta : ℂ) (phi : ℕ → ℕ) (t : ℕ → ℂ) (k : ℕ)
    (hprim : is_primitive_root q zeta) :
    complex.mul (complex.of_real (q : ℝ)) (toy.chain_count q phi t k)
      = complex.add (cpow_nat (toy.mass q t) k) (toy.remainder q zeta phi t k)
  unfold toy.chain_count toy.remainder
  have hbridge := toy.chain_fourier_bridge q zeta phi t hprim k 0
  have h0_eq : csum q (fun h => complex.mul (cpow_nat zeta (h * 0)) (toy.chain_mode q zeta phi t k h)) = csum q (fun h => toy.chain_mode q zeta phi t k h)
    apply csum.congr; intro h hh
    have hm0 : h * 0 = 0 := by ring
    rw [hm0]; simp [cpow_nat]; exact complex.one_mul (toy.chain_mode q zeta phi t k h)
  rw [h0_eq] at hbridge
  rw [← hbridge]
  have hqpos : 0 < q := hprim.1
  have hqsplit : q = (q - 1) + 1 := by omega
  have hsum_split : csum q (fun h => toy.chain_mode q zeta phi t k h) = complex.add (toy.chain_mode q zeta phi t k 0) (csum (q - 1) (fun h => toy.chain_mode q zeta phi t k (h + 1)))
    have htmp := csum.succ_zero (q - 1) (fun h => toy.chain_mode q zeta phi t k h)
    rw [← hqsplit] at htmp
    exact htmp
  rw [hsum_split, toy.chain_mode_zero]

-- ====================================================================================
-- PART D: General Non-Separable 2-Step Path-Quadric Identity  q * N(Q) = M^2 + R(Q)
--         (Covers bilinear/quadratic forms Q(x, y) such as x * y or x^2 + y^2)
-- ====================================================================================

-> toy.quad_mode (q : ℕ) (zeta : ℂ) (Q : ℕ → ℕ → ℕ) (t : ℕ → ℂ) (h : ℕ) : ℂ :=
  csum q (fun x => csum q (fun y => complex.mul (complex.mul (t x) (t y)) (cpow_nat zeta (h * Q x y))))

-> toy.quad_count (q : ℕ) (Q : ℕ → ℕ → ℕ) (t : ℕ → ℂ) : ℂ :=
  csum q (fun x => csum q (fun y => if Q x y % q = 0 then complex.mul (t x) (t y) else complex.zero))

-> toy.quad_remainder (q : ℕ) (zeta : ℂ) (Q : ℕ → ℕ → ℕ) (t : ℕ → ℂ) : ℂ :=
  csum (q - 1) (fun h => toy.quad_mode q zeta Q t (h + 1))

+ toy.quad_mode_zero (q : ℕ) (zeta : ℂ) (Q : ℕ → ℕ → ℕ) (t : ℕ → ℂ) :
    toy.quad_mode q zeta Q t 0 = complex.mul (toy.mass q t) (toy.mass q t)
  unfold toy.quad_mode toy.mass
  have h1 : csum q (fun x => csum q (fun y => complex.mul (complex.mul (t x) (t y)) (cpow_nat zeta (0 * Q x y))))
      = csum q (fun x => complex.mul (t x) (csum q t))
    apply csum.congr; intro x hx
    rw [← csum.scale_left]
    apply csum.congr; intro y hy
    have h0 : 0 * Q x y = 0 := by ring
    rw [h0]; simp [cpow_nat]; exact complex.mul_one (complex.mul (t x) (t y))
  rw [h1, csum.scale_right]

-- MAIN THEOREM 2 (General 2-Step Quadric Identity):
-- For ANY binary phase Q(x, y) (e.g. Q(x, y) = x * y) and ANY primitive q-th root zeta:
--   q * N(Q) = M^2 + R(Q).
+ toy.quad_identity (q : ℕ) (zeta : ℂ) (Q : ℕ → ℕ → ℕ) (t : ℕ → ℂ)
    (hprim : is_primitive_root q zeta) :
    complex.mul (complex.of_real (q : ℝ)) (toy.quad_count q Q t)
      = complex.add (complex.mul (toy.mass q t) (toy.mass q t)) (toy.quad_remainder q zeta Q t)
  unfold toy.quad_count toy.quad_remainder
  have htotal : csum q (fun h => toy.quad_mode q zeta Q t h) = complex.mul (complex.of_real (q : ℝ)) (csum q (fun x => csum q (fun y => if Q x y % q = 0 then complex.mul (t x) (t y) else complex.zero)))
    unfold toy.quad_mode
    rw [csum.swap]
    have hswap2 : csum q (fun x => csum q (fun h => csum q (fun y => complex.mul (complex.mul (t x) (t y)) (cpow_nat zeta (h * Q x y))))) = csum q (fun x => csum q (fun y => complex.mul (complex.mul (t x) (t y)) (csum q (fun h => cpow_nat zeta (h * Q x y)))))
      apply csum.congr; intro x hx
      rw [csum.swap]
      apply csum.congr; intro y hy
      rw [csum.scale_left]
    rw [hswap2, ← csum.scale_left]
    apply csum.congr; intro x hx
    rw [← csum.scale_left]
    apply csum.congr; intro y hy
    rw [root.orthogonality q zeta hprim (Q x y)]
    by_cases hz : Q x y % q = 0
    · rw [if_pos hz, if_pos hz]
      exact complex.mul_comm (complex.mul (t x) (t y)) (complex.of_real (q : ℝ))
    · simp [hz]
      apply complex.ext <;> simp <;> ring
  rw [← htotal]
  have hqpos : 0 < q := hprim.1
  have hqsplit : q = (q - 1) + 1 := by omega
  have hsplit : csum q (fun h => toy.quad_mode q zeta Q t h) = complex.add (toy.quad_mode q zeta Q t 0) (csum (q - 1) (fun h => toy.quad_mode q zeta Q t (h + 1)))
    have htmp := csum.succ_zero (q - 1) (fun h => toy.quad_mode q zeta Q t h)
    rw [← hqsplit] at htmp
    exact htmp
  rw [hsplit, toy.quad_mode_zero]

-- ====================================================================================
-- PART E: Alpöge's Non-Cancellation / Positivity Obstruction Principle
-- ====================================================================================

-- If `q * N = main + R` with `Re(q * N) >= 0` (from non-negative point counting!) and
-- `|Re(R)| <= B`, then `Re(main) >= -B` — main cannot be more negative than the error!
+ toy.positivity_lower_bound (q : ℝ) (N main R : ℂ) (B : ℝ)
    (hid : complex.mul (complex.of_real q) N = complex.add main R)
    (hq : 0 ≤ q)
    (hN_nonneg : 0 ≤ complex.re N)
    (hR_bound : |complex.re R| ≤ B) :
    -B ≤ complex.re main
  have hre : complex.re (complex.mul (complex.of_real q) N) = complex.re (complex.add main R) := by rw [hid]
  simp at hre
  have hprod : 0 ≤ q * complex.re N := mul_nonneg.real q (complex.re N) hq hN_nonneg
  have hR_le : complex.re R ≤ B := by linarith [le_abs_self.real (complex.re R)]
  linarith

-- Corollary: if a real-weighted k-step chain has non-negative weighted count `Re(N_k) >= 0`
-- (automatically true whenever all weights `t(x) >= 0`!), then
--   -Re(R_k) <= Re(M^k)   (and for `|Re(R_k)| <= B`, `-B <= Re(M^k)`).
+ toy.chain_sign_obstruction (q : ℕ) (zeta : ℂ) (phi : ℕ → ℕ) (t : ℕ → ℂ) (k : ℕ) (B : ℝ)
    (hprim : is_primitive_root q zeta)
    (hN_nonneg : 0 ≤ complex.re (toy.chain_count q phi t k))
    (hR_bound : |complex.re (toy.remainder q zeta phi t k)| ≤ B) :
    -B ≤ complex.re (cpow_nat (toy.mass q t) k)
  exact toy.positivity_lower_bound (q : ℝ) (toy.chain_count q phi t k) (cpow_nat (toy.mass q t) k) (toy.remainder q zeta phi t k) B (toy.fundamental_identity q zeta phi t k hprim) (cast_nonneg.real q) hN_nonneg hR_bound

-- ====================================================================================
-- PART F: Concrete Axiom-Free Instantiation at q = 4, zeta = i (No Hypotheses!)
-- ====================================================================================

+ root.i_is_primitive_4 : is_primitive_root 4 (complex.mk 0 1)
  unfold is_primitive_root
  constructor
  · simp [cpow_nat]
    ring
  · intro r hr0 hr4
    by_cases r1 : r = 1
    · rw [r1]; simp [cpow_nat]
      intro heq
      have hre : complex.re (complex.mul complex.one (complex.mk 0 1)) = complex.re complex.one := by rw [heq]
      simp at hre
    · by_cases r2 : r = 2
      · rw [r2]; simp [cpow_nat]
        intro heq
        have hre : complex.re (complex.mul (complex.mul complex.one (complex.mk 0 1)) (complex.mk 0 1)) = complex.re complex.one := by rw [heq]
        simp at hre
      · have r3 : r = 3 := by omega
        rw [r3]; simp [cpow_nat]
        intro heq
        have hre : complex.re (complex.mul (complex.mul (complex.mul complex.one (complex.mk 0 1)) (complex.mk 0 1)) (complex.mk 0 1)) = complex.re complex.one := by rw [heq]
        simp at hre

-- Completely unconditional concrete instance: for ANY phase phi, weights t, and chain length k,
--   4 * N_k = M^k + R_k  (with zeta = i).
+ toy.concrete_mod4_identity (phi : ℕ → ℕ) (t : ℕ → ℂ) (k : ℕ) :
    complex.mul (complex.of_real (4 : ℝ)) (toy.chain_count 4 phi t k)
      = complex.add (cpow_nat (toy.mass 4 t) k) (toy.remainder 4 (complex.mk 0 1) phi t k)
  exact toy.fundamental_identity 4 (complex.mk 0 1) phi t k root.i_is_primitive_4

-- Audit axiom footprint: EVERY theorem must use ZERO custom axioms!
