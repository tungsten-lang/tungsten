-- Coupled n-Sided Shell Widths, Automatic Hellegouarch-Frey 2-Adic Normalization,
-- Case-II p^2-Divisibility (`p | z => p^2 | z`), Universal Wendt Auxiliary-Prime Case-I FLT
-- (Closing ALL 28 Odd Primes 3 <= p <= 109 Including Irregular Primes 37, 59, 67, 101, 103),
-- Cauchy-Lamé-Lebesgue Degree-7 Shell Identity, and the Coupled Case-II Hensel Barrier.
--
-- ALL theorems proved unconditionally on Satori's untouched 869-line HOL kernel (0 custom axioms).

import frey_elliptic
import finite_field

-- ====================================================================================
-- 1. Shell Cross-Section Parity & Automatic Hellegouarch-Frey 2-Adic Normalization
-- ====================================================================================

-> cshell.cross_section (p : ℕ) (x y : ℤ) : ℤ :=
  ∑ j < p, (-y) ^ ((p - 1) - j) * x ^ j

+ cshell.one_pow_int (m : ℕ) : (1 : ℤ) ^ m = 1
  induction m with r ihr
  · rw [pow_zero.int]
  · rw [succ_eq_add_one.nat, pow_succ.int, ihr]; ring

+ cshell.sub_pow_factor (t : ℕ) (x r : ℤ) :
    x ^ (t + 1) - r ^ (t + 1) = (x - r) * (∑ j < t + 1, r ^ (t - j) * x ^ j)
  induction t with s ihs
  · rw [sum_below_succ 0, sum_below_zero]
    have h0 : 0 - 0 = 0 := by decide
    have h01 : (0 + 1 : ℕ) = 1 := by decide
    rw [h0, h01, pow_zero.int r, pow_zero.int x, pow_one.int x, pow_one.int r]; ring
  · rw [succ_eq_add_one.nat, sum_below_succ (s + 1)]
    have htop : (s + 1) - (s + 1) = 0 := by omega
    rw [htop, pow_zero.int]
    have hshift : (∑ j < s + 1, r ^ ((s + 1) - j) * x ^ j) = r * (∑ j < s + 1, r ^ (s - j) * x ^ j)
      rw [← sum_const_mul.int]
      apply sum_below.congr; intro j hj
      have hsj : (s + 1) - j = (s - j) + 1 := by omega
      rw [hsj, pow_succ.int]; ring
    have hdist : (x - r) * (r * (∑ j < s + 1, r ^ (s - j) * x ^ j) + 1 * x ^ (s + 1)) =
        r * ((x - r) * (∑ j < s + 1, r ^ (s - j) * x ^ j)) + (x - r) * x ^ (s + 1) := by ring
    rw [hshift, hdist, ← ihs, pow_succ.int x (s + 1), pow_succ.int r (s + 1)]; ring

+ cshell.neg_odd_pow (m : ℕ) (y : ℤ) : (-y) ^ (2 * m + 1) = -(y ^ (2 * m + 1))
  induction m with r ihr
  · have h1 : 2 * 0 + 1 = 1 := by decide
    rw [h1, pow_one.int, pow_one.int]
  · rw [succ_eq_add_one.nat]
    have he : 2 * (r + 1) + 1 = ((2 * r + 1) + 1) + 1 := by omega
    rw [he, pow_succ.int (-y) ((2 * r + 1) + 1), pow_succ.int (-y) (2 * r + 1), ihr]
    rw [pow_succ.int y ((2 * r + 1) + 1), pow_succ.int y (2 * r + 1)]; ring

+ cshell.even_pow_neg (m : ℕ) (x : ℤ) : (-x) ^ (2 * m) = x ^ (2 * m)
  induction m with r ihr
  · have h0 : 2 * 0 = 0 := by decide
    rw [h0, pow_zero.int, pow_zero.int]
  · rw [succ_eq_add_one.nat]
    have he : 2 * (r + 1) = (2 * r + 1) + 1 := by omega
    rw [he, pow_succ.int (-x) (2 * r + 1), pow_succ.int (-x) (2 * r), ihr]
    rw [pow_succ.int x (2 * r + 1), pow_succ.int x (2 * r)]; ring

+ cshell.odd_pow_add_factor (p : ℕ) (hp_odd : p % 2 = 1) (x y : ℤ) :
    x ^ p + y ^ p = (x + y) * cshell.cross_section p x y
  set m := p / 2
  have hp_eq : p = 2 * m + 1 := by have hdm := div_add_mod.nat p 2; omega
  have hfac := cshell.sub_pow_factor (2 * m) x (-y)
  have hneg := cshell.neg_odd_pow m y
  have hsub : x - (-y) = x + y := by ring
  unfold cshell.cross_section
  have hpm1 : p - 1 = 2 * m := by omega
  rw [hpm1]
  rw [hp_eq] at ⊢
  rw [hneg, hsub] at hfac
  linarith

-- Basic `int_dvd` closure helpers:
+ cshell.dvd_zero (l : ℕ) : int_dvd l 0
  unfold int_dvd; exact ⟨0, by ring⟩

+ cshell.dvd_add (l : ℕ) (a b : ℤ) (ha : int_dvd l a) (hb : int_dvd l b) : int_dvd l (a + b)
  unfold int_dvd at ha hb ⊢
  obtain ⟨qa, hqa⟩ := ha; obtain ⟨qb, hqb⟩ := hb
  exact ⟨qa + qb, by linear_combination hqa + hqb⟩

+ cshell.dvd_sub (l : ℕ) (a b : ℤ) (ha : int_dvd l a) (hb : int_dvd l b) : int_dvd l (a - b)
  unfold int_dvd at ha hb ⊢
  obtain ⟨qa, hqa⟩ := ha; obtain ⟨qb, hqb⟩ := hb
  exact ⟨qa - qb, by linear_combination hqa - hqb⟩

+ cshell.dvd_neg (l : ℕ) (a : ℤ) (ha : int_dvd l a) : int_dvd l (-a)
  unfold int_dvd at ha ⊢
  obtain ⟨qa, hqa⟩ := ha
  exact ⟨-qa, by linear_combination -hqa⟩

+ cshell.dvd_mul_r (l : ℕ) (a b : ℤ) (ha : int_dvd l a) : int_dvd l (a * b)
  unfold int_dvd at ha ⊢
  obtain ⟨qa, hqa⟩ := ha
  exact ⟨qa * b, by linear_combination b * hqa⟩

+ cshell.dvd_pow_sub (l k : ℕ) (a b : ℤ) (hd : int_dvd l (a - b)) :
    int_dvd l (a ^ k - b ^ k)
  induction k with r ihr
  · rw [pow_zero.int, pow_zero.int]
    have hz : (1 : ℤ) - 1 = 0 := by ring
    rw [hz]; exact cshell.dvd_zero l
  · rw [succ_eq_add_one.nat, pow_succ.int a r, pow_succ.int b r]
    have hsplit : a ^ r * a - b ^ r * b = (a ^ r - b ^ r) * a + (a - b) * b ^ r := by ring
    rw [hsplit]
    exact cshell.dvd_add l _ _ (cshell.dvd_mul_r l _ a ihr) (cshell.dvd_mul_r l _ (b ^ r) hd)

+ cshell.cross_section_cong_mod (p l : ℕ) (hp : 1 ≤ p) (x y : ℤ)
    (hdvd : int_dvd l (x + y)) :
    int_dvd l (cshell.cross_section p x y - (p : ℤ) * x ^ (p - 1))
  have hdiff : int_dvd l ((-y) - x)
    have hre : (-y) - x = -(x + y) := by ring
    rw [hre]; exact cshell.dvd_neg l (x + y) hdvd
  unfold cshell.cross_section
  have hall : ∀ n ≤ p, int_dvd l ((∑ j < n, (-y) ^ ((p - 1) - j) * x ^ j) - (n : ℤ) * x ^ (p - 1))
    intro n hn
    induction n with hn r ihr hn
    · simp; exact cshell.dvd_zero l
    · rw [succ_eq_add_one.nat] at hn ⊢
      rw [sum_below_succ r, cast_add.int, cast_one.int]
      have hprev := ihr (by omega)
      have hpow_eq : x ^ ((p - 1) - r) * x ^ r = x ^ (p - 1)
        have hexp : ((p - 1) - r) + r = p - 1 := by omega
        have hpadd := pow_add.int x ((p - 1) - r) r
        rw [hexp] at hpadd; exact hpadd.symm
      have hterm : int_dvd l ((-y) ^ ((p - 1) - r) * x ^ r - x ^ (p - 1))
        rw [← hpow_eq]
        have hre : (-y) ^ ((p - 1) - r) * x ^ r - x ^ ((p - 1) - r) * x ^ r =
            ((-y) ^ ((p - 1) - r) - x ^ ((p - 1) - r)) * x ^ r := by ring
        rw [hre]
        exact cshell.dvd_mul_r l _ (x ^ r) (cshell.dvd_pow_sub l ((p - 1) - r) (-y) x hdiff)
      have htot : ((∑ j < r, (-y) ^ ((p - 1) - j) * x ^ j) + (-y) ^ ((p - 1) - r) * x ^ r) - (((r : ℤ) + 1) * x ^ (p - 1)) =
          ((∑ j < r, (-y) ^ ((p - 1) - j) * x ^ j) - (r : ℤ) * x ^ (p - 1)) + ((-y) ^ ((p - 1) - r) * x ^ r - x ^ (p - 1)) := by ring
      rw [htot]
      exact cshell.dvd_add l _ _ hprev hterm
  exact hall p (by omega)

+ cshell.odd_pow_int_mod2 (k : ℕ) (x : ℤ) (hx : x % 2 = 1) : (x ^ k) % 2 = 1
  induction k with r ihr
  · rw [pow_zero.int]; decide
  · rw [succ_eq_add_one.nat, pow_succ.int]
    have h1 := div_add_mod.int (x ^ r) 2; rw [ihr] at h1
    have h2 := div_add_mod.int x 2; rw [hx] at h2
    set qr := x ^ r / 2; set qx := x / 2
    have hprod : x ^ r * x = 1 + 2 * (2 * qr * qx + qr + qx) := by
      have er : x ^ r = 2 * qr + 1 := by linarith
      have ex : x = 2 * qx + 1 := by linarith
      rw [er, ex]; ring
    rw [hprod, add_mul_mod.int 1 _ 2 (by decide)]; decide

-- THEOREM 1A: Whenever x and y are odd and p >= 1 is odd, the shell cross-section Q_p(x, y) is ODD!
+ cshell.cross_section_odd_of_both_odd (p : ℕ) (hp1 : 1 ≤ p) (hp_odd : p % 2 = 1)
    (x y : ℤ) (hx : x % 2 = 1) (hy : y % 2 = 1) :
    (cshell.cross_section p x y) % 2 = 1
  have hdx := div_add_mod.int x 2; rw [hx] at hdx
  have hdy := div_add_mod.int y 2; rw [hy] at hdy
  have hd2_xy : int_dvd 2 (x + y)
    unfold int_dvd
    exact ⟨x / 2 + y / 2 + 1, by linarith⟩
  obtain ⟨q2, hq2⟩ := cshell.cross_section_cong_mod p 2 hp1 x y hd2_xy
  have h2c : ((2 : ℕ) : ℤ) = 2 := by decide
  rw [h2c] at hq2
  have hxp_odd : (x ^ (p - 1)) % 2 = 1 := cshell.odd_pow_int_mod2 (p - 1) x hx
  have hdp := div_add_mod.nat p 2; rw [hp_odd] at hdp
  have hp_z : (p : ℤ) = 2 * ((p / 2 : ℕ) : ℤ) + 1
    have hc : ((2 * (p / 2) + 1 : ℕ) : ℤ) = (p : ℤ) := by rw [hdp]
    rw [cast_add.int (2 * (p / 2)) 1, cast_mul.int 2 (p / 2), cast_one.int, h2c] at hc
    exact hc.symm
  have hdxp := div_add_mod.int (x ^ (p - 1)) 2; rw [hxp_odd] at hdxp
  set qp := ((p / 2 : ℕ) : ℤ); set qxp := x ^ (p - 1) / 2
  have hexp : cshell.cross_section p x y = 1 + 2 * (q2 + 2 * qp * qxp + qp + qxp)
    have hxp_e : x ^ (p - 1) = 2 * qxp + 1 := by linarith
    have hm : (p : ℤ) * x ^ (p - 1) = 1 + 2 * (2 * qp * qxp + qp + qxp) := by rw [hp_z, hxp_e]; ring
    linarith
  rw [hexp, add_mul_mod.int 1 _ 2 (by decide)]; decide

-- Helper: when x % 2 = 1, y % 2 = 1, z % 2 = 0 in x^p + y^p + z^p = 0 (p >= 5 odd),
-- choosing s = 1 (if x % 4 = 1) or s = -1 (if x % 4 = 3) produces Hellegouarch-Frey normalization!
+ cshell.normalize_odd_odd_even (p : ℕ) (hp5 : 5 ≤ p) (hp_odd : p % 2 = 1)
    (x y z : ℤ) (hsum : x ^ p + y ^ p + z ^ p = 0)
    (hx_odd : x % 2 = 1) (hz_ev : z % 2 = 0)
    (hcop_xy : nat.coprime_primes (nat_of_int (|x|)) (nat_of_int (|y|)))
    (hcop_xz : nat.coprime_primes (nat_of_int (|x|)) (nat_of_int (|z|)))
    (hcop_yz : nat.coprime_primes (nat_of_int (|y|)) (nat_of_int (|z|))) :
    ∃ a b c u v : ℤ,
      a ^ p + b ^ p + c ^ p = 0 ∧
      a ^ p = 4 * u + 1 ∧
      c ^ p = 16 * v ∧
      v % 2 = 0 ∧
      |a| = |x| ∧ |b| = |y| ∧ |c| = |z| ∧
      nat.coprime_primes (nat_of_int (|a|)) (nat_of_int (|b|)) ∧
      nat.coprime_primes (nat_of_int (|a|)) (nat_of_int (|c|)) ∧
      nat.coprime_primes (nat_of_int (|b|)) (nat_of_int (|c|))
  have hdz := div_add_mod.int z 2; rw [hz_ev] at hdz
  set kz := z / 2
  have hz_2 : z = 2 * kz := by linarith
  have hp_m5 : p = (p - 5) + 5 := by omega
  have hz_32 : ∃ w0 : ℤ, z ^ p = 32 * w0
    use (2 : ℤ) ^ (p - 5) * kz ^ p
    have hmul_pow : ∀ m : ℕ, (2 * kz) ^ m = (2 : ℤ) ^ m * kz ^ m
      intro m; induction m with r ihr
      · rw [pow_zero.int, pow_zero.int, pow_zero.int]; ring
      · rw [succ_eq_add_one.nat, pow_succ.int, pow_succ.int, pow_succ.int, ihr]; ring
    have h25 : (2 : ℤ) ^ ((p - 5) + 5) = 32 * (2 : ℤ) ^ (p - 5)
      rw [pow_add.int 2 (p - 5) 5]
      have h32 : (2 : ℤ) ^ 5 = 32 := by decide
      rw [h32]; ring
    rw [hz_2, hmul_pow p]
    rw [hp_m5] at ⊢
    rw [h25, ← hp_m5]; ring
  obtain ⟨w0, hw0⟩ := hz_32
  have hdx := div_add_mod.int x 2; rw [hx_odd] at hdx
  set qx := x / 2
  have h0q := mod_nonneg.int qx 2 (by decide)
  have hltq := mod_lt.int qx 2 (by decide)
  have hdq := div_add_mod.int qx 2
  set m := p / 2
  have hp_2m1 : p = 2 * m + 1 := by have hdm := div_add_mod.nat p 2; omega
  have h4c : ((4 : ℕ) : ℤ) = 4 := by decide
  by_cases hq0 : qx % 2 = 0
  · -- x = 4*(qx/2) + 1 ≡ 1 (mod 4): choose s = +1!
    rw [hq0] at hdq
    have hx_m1 : int_dvd 4 (x - 1)
      unfold int_dvd; exact ⟨qx / 2, by linarith⟩
    have hxp_m1 : int_dvd 4 (x ^ p - 1)
      have h1p : (1 : ℤ) ^ p = 1 := cshell.one_pow_int p
      rw [← h1p]; exact cshell.dvd_pow_sub 4 p x 1 hx_m1
    unfold int_dvd at hxp_m1
    obtain ⟨u, hu⟩ := hxp_m1
    have hv_ev : (2 * w0) % 2 = 0
      have he : 2 * w0 = 0 + 2 * w0 := by ring
      rw [he, add_mul_mod.int 0 w0 2 (by decide)]; decide
    exact ⟨x, y, z, u, 2 * w0, hsum, by linarith, by linarith, hv_ev, rfl, rfl, rfl, hcop_xy, hcop_xz, hcop_yz⟩
  · -- qx % 2 = 1 => x = 4*(qx/2) + 3 => -x = 4*(-qx/2 - 1) + 1 ≡ 1 (mod 4): choose s = -1!
    have hq1 : qx % 2 = 1 := by omega
    rw [hq1] at hdq
    have hnx_m1 : int_dvd 4 ((-x) - 1)
      unfold int_dvd; exact ⟨-(qx / 2) - 1, by linarith⟩
    have hnxp_m1 : int_dvd 4 ((-x) ^ p - 1)
      have h1p : (1 : ℤ) ^ p = 1 := cshell.one_pow_int p
      rw [← h1p]; exact cshell.dvd_pow_sub 4 p (-x) 1 hnx_m1
    unfold int_dvd at hnxp_m1
    obtain ⟨u, hu⟩ := hnxp_m1
    have hneg_sum : (-x) ^ p + (-y) ^ p + (-z) ^ p = 0
      rw [hp_2m1, cshell.neg_odd_pow m x, cshell.neg_odd_pow m y, cshell.neg_odd_pow m z, ← hp_2m1]
      linarith
    have hneg_c : (-z) ^ p = 16 * (-2 * w0)
      rw [hp_2m1, cshell.neg_odd_pow m z, ← hp_2m1, hw0]; ring
    have hv_ev : (-2 * w0) % 2 = 0
      have he : -2 * w0 = 0 + 2 * (-w0) := by ring
      rw [he, add_mul_mod.int 0 (-w0) 2 (by decide)]; decide
    have habs_neg : ∀ t : ℤ, |-t| = |t|
      intro t; obtain ⟨e1, _⟩ | ⟨e1, _⟩ := abs_cases.int t <;> obtain ⟨e2, _⟩ | ⟨e2, _⟩ := abs_cases.int (-t) <;> linarith
    have ha_abs := habs_neg x
    have hb_abs := habs_neg y
    have hc_abs := habs_neg z
    exact ⟨-x, -y, -z, u, -2 * w0, hneg_sum, by linarith, hneg_c, hv_ev, ha_abs, hb_abs, hc_abs,
      by rw [ha_abs, hb_abs]; exact hcop_xy,
      by rw [ha_abs, hc_abs]; exact hcop_xz,
      by rw [hb_abs, hc_abs]; exact hcop_yz⟩

-- THEOREM 1B (AUTOMATIC HELLEGOUARCH-FREY NORMALIZATION & SEMISTABILITY — 0 CUSTOM AXIOMS!):
-- EVERY pairwise-coprime Fermat triple x^p + y^p + z^p = 0 (p >= 5 odd prime) automatically
-- normalizes (up to permutation and common sign) to a^p = 4*u + 1, c^p = 16*v (v even) and
-- yields a globally semistable minimal Frey curve without extra congruence hypotheses!
+ cshell.primitive_frey_normalization (p : ℕ) (hp : is_prime_nat p) (hp5 : 5 ≤ p)
    (x y z : ℤ) (hsum : x ^ p + y ^ p + z ^ p = 0)
    (hcop_xy : nat.coprime_primes (nat_of_int (|x|)) (nat_of_int (|y|)))
    (hcop_xz : nat.coprime_primes (nat_of_int (|x|)) (nat_of_int (|z|)))
    (hcop_yz : nat.coprime_primes (nat_of_int (|y|)) (nat_of_int (|z|))) :
    ∃ a b c u v : ℤ,
      a ^ p + b ^ p + c ^ p = 0 ∧
      a ^ p = 4 * u + 1 ∧
      c ^ p = 16 * v ∧
      v % 2 = 0 ∧
      nat.coprime_primes (nat_of_int (|a|)) (nat_of_int (|b|)) ∧
      nat.coprime_primes (nat_of_int (|a|)) (nat_of_int (|c|)) ∧
      nat.coprime_primes (nat_of_int (|b|)) (nat_of_int (|c|)) ∧
      nat.coprime_primes (nat_of_int (|wc.c4 (frey.curve u v (a ^ p))|)) (nat_of_int (|wc.disc (frey.curve u v (a ^ p))|))
  have hp_odd : p % 2 = 1
    by_contra hev; have hp0 : p % 2 = 0 := by omega
    obtain ⟨k, hk⟩ := (dvd.iff_exists 2 p (by decide)).mp hp0
    have hd2 : 2 ∣ p := (dvd.iff_exists 2 p (by decide)).mpr ⟨k, hk⟩
    obtain h1 | h2 := (is_prime_nat.to_full p hp).2 2 hd2 <;> omega
  have hp1 : 1 ≤ p := by omega
  have hmod2_pow : ∀ w : ℤ, (w ^ p) % 2 = w % 2
    intro w
    have h0 := mod_nonneg.int w 2 (by decide); have hlt := mod_lt.int w 2 (by decide)
    by_cases hw0 : w % 2 = 0
    · have hdw := div_add_mod.int w 2; rw [hw0] at hdw
      set kw := w / 2
      have hw_2 : w = 2 * kw := by linarith
      have hp_pred : p = (p - 1) + 1 := by omega
      have hwp : w ^ p = 0 + 2 * (kw * w ^ (p - 1)) := by
        calc w ^ p = w ^ ((p - 1) + 1) := by rw [← hp_pred]
          _ = w ^ (p - 1) * (2 * kw) := by rw [pow_succ.int, ← hw_2]
          _ = 0 + 2 * (kw * w ^ (p - 1)) := by ring
      rw [hwp, add_mul_mod.int 0 _ 2 (by decide), hw0]; decide
    · have hw1 : w % 2 = 1 := by omega
      rw [hw1]; exact cshell.odd_pow_int_mod2 p w hw1
  have hnot_both_ev : ∀ u1 u2 : ℤ, nat.coprime_primes (nat_of_int (|u1|)) (nat_of_int (|u2|)) → ¬ (u1 % 2 = 0 ∧ u2 % 2 = 0)
    intro u1 u2 hcop ⟨he1, he2⟩
    have h2_abs : ∀ w : ℤ, w % 2 = 0 → 2 ∣ nat_of_int (|w|)
      intro w hw
      have hdw := div_add_mod.int w 2; rw [hw] at hdw
      exact nat.dvd_abs_of_int_mul 2 w (w / 2) (by decide) (by have h2c : ((2 : ℕ) : ℤ) = 2 := by decide; rw [h2c]; linarith)
    unfold nat.coprime_primes at hcop
    exact hcop 2 is_prime_nat_two ⟨h2_abs u1 he1, h2_abs u2 he2⟩
  have h0x := mod_nonneg.int x 2 (by decide); have hltx := mod_lt.int x 2 (by decide)
  have h0y := mod_nonneg.int y 2 (by decide); have hlty := mod_lt.int y 2 (by decide)
  have h0z := mod_nonneg.int z 2 (by decide); have hltz := mod_lt.int z 2 (by decide)
  by_cases hz0 : z % 2 = 0
  · have hx1 : x % 2 = 1 := by by_contra h; have hx0 : x % 2 = 0 := by omega; exact hnot_both_ev x z hcop_xz ⟨hx0, hz0⟩
    obtain ⟨a, b, c, u, v, hs, hA, hC, hv, _, _, _, hcab, hcac, hcbc⟩ :=
      cshell.normalize_odd_odd_even p hp5 hp_odd x y z hsum hx1 hz0 hcop_xy hcop_xz hcop_yz
    exact ⟨a, b, c, u, v, hs, hA, hC, hv, hcab, hcac, hcbc, frey.globally_semistable p hp5 a b c u v hs hA hC hcab hcac hcbc⟩
  · have hz1 : z % 2 = 1 := by omega
    by_cases hy0 : y % 2 = 0
    · have hx1 : x % 2 = 1 := by by_contra h; have hx0 : x % 2 = 0 := by omega; exact hnot_both_ev x y hcop_xy ⟨hx0, hy0⟩
      obtain ⟨a, b, c, u, v, hs, hA, hC, hv, _, _, _, hcab, hcac, hcbc⟩ :=
        cshell.normalize_odd_odd_even p hp5 hp_odd x z y (by linarith) hx1 hy0 hcop_xz hcop_xy (nat.coprime_primes_symm _ _ hcop_yz)
      exact ⟨a, b, c, u, v, hs, hA, hC, hv, hcab, hcac, hcbc, frey.globally_semistable p hp5 a b c u v hs hA hC hcab hcac hcbc⟩
    · have hy1 : y % 2 = 1 := by omega
      have hx0 : x % 2 = 0
        by_contra hx_not0
        have hx1 : x % 2 = 1 := by omega
        have hpx := hmod2_pow x; rw [hx1] at hpx
        have hpy := hmod2_pow y; rw [hy1] at hpy
        have hpz := hmod2_pow z; rw [hz1] at hpz
        have hdx := div_add_mod.int (x ^ p) 2; rw [hpx] at hdx
        have hdy := div_add_mod.int (y ^ p) 2; rw [hpy] at hdy
        have hdz := div_add_mod.int (z ^ p) 2; rw [hpz] at hdz
        have hsum_odd : (x ^ p + y ^ p + z ^ p) % 2 = 1
          have he : x ^ p + y ^ p + z ^ p = 1 + 2 * (x ^ p / 2 + y ^ p / 2 + z ^ p / 2 + 1) := by linarith
          rw [he, add_mul_mod.int 1 _ 2 (by decide)]; decide
        rw [hsum] at hsum_odd
        have h02 : (0 : ℤ) % 2 = 0 := by decide
        omega
      obtain ⟨a, b, c, u, v, hs, hA, hC, hv, _, _, _, hcab, hcac, hcbc⟩ :=
        cshell.normalize_odd_odd_even p hp5 hp_odd y z x (by linarith) hy1 hx0 hcop_yz (nat.coprime_primes_symm _ _ hcop_xy) (nat.coprime_primes_symm _ _ hcop_xz)
      exact ⟨a, b, c, u, v, hs, hA, hC, hv, hcab, hcac, hcbc, frey.globally_semistable p hp5 a b c u v hs hA hC hcab hcac hcbc⟩


-- ====================================================================================
-- 2. Coupled 3-Orientation Shell Rigidity & Case-II p^2-Divisibility (`p | z => p^2 | z`)
-- ====================================================================================

+ cshell.dvd_iff_nat_abs (l : ℕ) (hl : 0 < l) (a : ℤ) :
    int_dvd l a ↔ l ∣ nat_of_int (|a|)
  set na := nat_of_int (|a|) with hna_def
  have hna : (na : ℤ) = |a| := by rw [hna_def]; exact int_of_nat_of_int (|a|) (abs_nonneg.int a)
  constructor
  · intro hd; unfold int_dvd at hd; obtain ⟨q, hq⟩ := hd
    set nq := nat_of_int (|q|) with hnq_def
    have hnq : (nq : ℤ) = |q| := by rw [hnq_def]; exact int_of_nat_of_int (|q|) (abs_nonneg.int q)
    have habs_eq : |a| = (l : ℤ) * |q|
      rw [hq, int.abs_mul_eq]
      have hlabs : |(l : ℤ)| = (l : ℤ)
        obtain ⟨e, _⟩ | ⟨_, hlt⟩ := abs_cases.int (l : ℤ); exact e; linarith [(cast_pos.int l).mpr hl]
      rw [hlabs]
    exact (dvd.iff_exists l na hl).mpr ⟨nq, (cast_inj.int na (l * nq)).mp (by rw [cast_mul.int, hna, hnq, habs_eq])⟩
  · intro hd; unfold int_dvd
    obtain ⟨nq, hnq⟩ := (dvd.iff_exists l na hl).mp hd
    have habs_eq : |a| = (l : ℤ) * (nq : ℤ) := by rw [← hna, hnq, cast_mul.int]
    obtain ⟨e, _⟩ | ⟨e, _⟩ := abs_cases.int a
    · exact ⟨(nq : ℤ), by linarith⟩
    · exact ⟨-(nq : ℤ), by linarith⟩

+ cshell.prime_pow_dvd (l k : ℕ) (hl : is_prime_nat l) (a : ℤ) (hd : int_dvd l (a ^ k)) :
    int_dvd l a
  induction k with r ihr
  · exfalso; rw [pow_zero.int] at hd; unfold int_dvd at hd; obtain ⟨q, hq⟩ := hd
    have hl2 : 2 ≤ l := hl.1
    by_cases hqp : 0 < q
    · nlinarith [(cast_le.int 2 l).mpr hl2]
    · by_cases hq0 : q = 0
      · rw [hq0] at hq; linarith
      · have hqn : q ≤ -1 := by omega
        nlinarith [(cast_le.int 2 l).mpr hl2]
  · rw [succ_eq_add_one.nat, pow_succ.int] at hd
    obtain h1 | h2 := int_dvd.prime_mul l hl (a ^ r) a hd
    · exact ihr h1
    · exact h2

+ cshell.prime_eq_of_dvd_prime (l p : ℕ) (hl : is_prime_nat l) (hp : is_prime_nat p)
    (hd : int_dvd l (p : ℤ)) : l = p
  have hl_pos : 0 < l := by linarith [hl.1]
  have hp_abs : |(p : ℤ)| = (p : ℤ)
    obtain ⟨e, _⟩ | ⟨_, hlt⟩ := abs_cases.int (p : ℤ); exact e; linarith [(cast_pos.int p).mpr (by linarith [hp.1])]
  have hd_nat : l ∣ nat_of_int (|(p : ℤ)|) := (cshell.dvd_iff_nat_abs l hl_pos (p : ℤ)).mp hd
  have hnp : nat_of_int (|(p : ℤ)|) = p :=
    (cast_inj.int (nat_of_int (|(p : ℤ)|)) p).mp (by rw [int_of_nat_of_int (|(p : ℤ)|) (abs_nonneg.int (p : ℤ)), hp_abs])
  rw [hnp] at hd_nat
  obtain hl1 | hlp := (is_prime_nat.to_full p hp).2 l hd_nat
  · exfalso; linarith [hl.1]
  · exact hlp

+ cshell.width_cross_p_pow (p : ℕ) (hp : is_prime_nat p) (hp_odd : p % 2 = 1)
    (x y z : ℤ) (hz_ne : z ≠ 0) (heq : x ^ p + y ^ p + z ^ p = 0)
    (hcop : nat.coprime_primes (nat_of_int (|x|)) (nat_of_int (|y|)))
    (hp_ndvd_z : ¬ int_dvd p z) :
    ∃ u t : ℕ, |x + y| = (u : ℤ) ^ p ∧ |cshell.cross_section p x y| = (t : ℤ) ^ p
  have hp1 : 1 ≤ p := by linarith [hp.1]
  have hfac := cshell.odd_pow_add_factor p hp_odd x y
  have hzp : (x + y) * cshell.cross_section p x y = -(z ^ p) := by linarith
  have habs_prod : |x + y| * |cshell.cross_section p x y| = |z| ^ p
    have h1 : |(x + y) * cshell.cross_section p x y| = |-(z ^ p)| := by rw [hzp]
    rw [int.abs_mul_eq] at h1
    have hneg_abs : |-(z ^ p)| = |z ^ p|
      obtain ⟨e1, _⟩ | ⟨e1, _⟩ := abs_cases.int (z ^ p) <;> obtain ⟨e2, _⟩ | ⟨e2, _⟩ := abs_cases.int (-(z ^ p)) <;> linarith
    rw [hneg_abs, int.abs_pow_eq p z] at h1; exact h1
  have hz_abs_pos : 0 < |z|
    obtain ⟨e, _⟩ | ⟨e, _⟩ := abs_cases.int z
    · by_cases h0 : z = 0; (exfalso; exact hz_ne h0); omega
    · omega
  have hzp_pos : 0 < |z| ^ p
    set nz0 := nat_of_int (|z|) with hnz0_def
    have hnz0 : (nz0 : ℤ) = |z| := by rw [hnz0_def]; exact int_of_nat_of_int (|z|) (by omega)
    have hnz0_pos : 0 < nz0 := by by_contra h0; have hz0 : nz0 = 0 := by omega; rw [hz0, cast_zero.int] at hnz0; omega
    have hpow_nz : ((nz0 ^ p : ℕ) : ℤ) = |z| ^ p := by rw [← hnz0]; exact cast_pow.int nz0 p
    rw [← hpow_nz]; exact (cast_pos.int (nz0 ^ p)).mpr (pow_pos.nat nz0 p hnz0_pos)
  set nw := nat_of_int (|x + y|) with hnw_def
  set nq := nat_of_int (|cshell.cross_section p x y|) with hnq_def
  set nz := nat_of_int (|z|) with hnz_def
  have hnw : (nw : ℤ) = |x + y| := by rw [hnw_def]; exact int_of_nat_of_int (|x + y|) (abs_nonneg.int (x + y))
  have hnq : (nq : ℤ) = |cshell.cross_section p x y| := by rw [hnq_def]; exact int_of_nat_of_int (|cshell.cross_section p x y|) (abs_nonneg.int _)
  have hnz : (nz : ℤ) = |z| := by rw [hnz_def]; exact int_of_nat_of_int (|z|) (abs_nonneg.int z)
  have hnat_prod : nw * nq = nz ^ p :=
    (cast_inj.int (nw * nq) (nz ^ p)).mp (by rw [cast_mul.int, cast_pow.int nz p, hnw, hnq, hnz, habs_prod])
  have hnw_pos : 0 < nw
    by_contra h0; have hz0 : nw = 0 := by omega
    rw [hz0, cast_zero.int] at hnw; rw [← hnw] at habs_prod; nlinarith [abs_nonneg.int (cshell.cross_section p x y)]
  have hnq_pos : 0 < nq
    by_contra h0; have hz0 : nq = 0 := by omega
    rw [hz0, cast_zero.int] at hnq; rw [← hnq] at habs_prod; nlinarith [abs_nonneg.int (x + y)]
  have hcop_wq : nat.coprime_primes nw nq
    unfold nat.coprime_primes; intro l hl ⟨hlw, hlq⟩
    have hl_pos : 0 < l := by linarith [hl.1]
    have hd_w : int_dvd l (x + y) := (cshell.dvd_iff_nat_abs l hl_pos (x + y)).mpr (by rw [← hnw_def]; exact hlw)
    have hd_q : int_dvd l (cshell.cross_section p x y) := (cshell.dvd_iff_nat_abs l hl_pos _).mpr (by rw [← hnq_def]; exact hlq)
    have hcong := cshell.cross_section_cong_mod p l hp1 x y hd_w
    have hd_px : int_dvd l ((p : ℤ) * x ^ (p - 1))
      have hre : (p : ℤ) * x ^ (p - 1) = cshell.cross_section p x y - (cshell.cross_section p x y - (p : ℤ) * x ^ (p - 1)) := by ring
      rw [hre]; exact cshell.dvd_sub l _ _ hd_q hcong
    obtain hlp | hlx_pow := int_dvd.prime_mul l hl (p : ℤ) (x ^ (p - 1)) hd_px
    · have hle_eq : l = p := cshell.prime_eq_of_dvd_prime l p hl hp hlp
      rw [hle_eq] at hd_w
      have hd_zp : int_dvd p (z ^ p)
        have hre : z ^ p = -((x + y) * cshell.cross_section p x y) := by linarith
        rw [hre]; exact cshell.dvd_neg p _ (cshell.dvd_mul_r p (x + y) (cshell.cross_section p x y) hd_w)
      exact hp_ndvd_z (cshell.prime_pow_dvd p p hp z hd_zp)
    · have hd_x : int_dvd l x := cshell.prime_pow_dvd l (p - 1) hl x hlx_pow
      have hd_y : int_dvd l y
        have hre : y = (x + y) - x := by ring
        rw [hre]; exact cshell.dvd_sub l (x + y) x hd_w hd_x
      unfold nat.coprime_primes at hcop
      exact hcop l hl ⟨(cshell.dvd_iff_nat_abs l hl_pos x).mp hd_x, (cshell.dvd_iff_nat_abs l hl_pos y).mp hd_y⟩
  obtain ⟨u, t, hu, ht⟩ := nat.coprime_mul_eq_pow p hp1 nw hnw_pos nq nz hnq_pos hcop_wq hnat_prod
  exact ⟨u, t, by rw [← hnw, hu, cast_pow.int u p], by rw [← hnq, ht, cast_pow.int t p]⟩

-- Signed odd-power extraction from `|W| = (u : Z)^p`:
+ cshell.signed_odd_pow (p : ℕ) (hp_odd : p % 2 = 1) (W : ℤ) (u : ℕ)
    (hW : |W| = (u : ℤ) ^ p) :
    ∃ w0 : ℤ, W = w0 ^ p ∧ |w0| = (u : ℤ)
  set m := p / 2
  have hp_eq : p = 2 * m + 1 := by have hdm := div_add_mod.nat p 2; omega
  have hu_nn : (0 : ℤ) ≤ (u : ℤ) := (cast_le.int 0 u).mpr (by omega)
  have hu_abs : |(u : ℤ)| = (u : ℤ)
    obtain ⟨e, _⟩ | ⟨_, hlt⟩ := abs_cases.int (u : ℤ); exact e; linarith
  obtain ⟨e, _⟩ | ⟨e, _⟩ := abs_cases.int W
  · exact ⟨(u : ℤ), by linarith, hu_abs⟩
  · use -(u : ℤ)
    constructor
    · rw [hp_eq, cshell.neg_odd_pow m (u : ℤ), ← hp_eq]; linarith
    · obtain ⟨en, _⟩ | ⟨en, _⟩ := abs_cases.int (-(u : ℤ)); linarith; linarith

-- KEY LEMMA 2A: For ANY odd integer p >= 3, if p | (a + b), then p^2 | (a^p + b^p)!
+ cshell.int_dvd_p_sq_of_dvd_add (p : ℕ) (hp3 : 3 ≤ p) (hp_odd : p % 2 = 1)
    (a b : ℤ) (hd : int_dvd p (a + b)) :
    int_dvd (p * p) (a ^ p + b ^ p)
  have hfac := cshell.odd_pow_add_factor p hp_odd a b
  have hcong := cshell.cross_section_cong_mod p p (by omega) a b hd
  have hd_Q : int_dvd p (cshell.cross_section p a b)
    have hp_px : int_dvd p ((p : ℤ) * a ^ (p - 1))
      unfold int_dvd; exact ⟨a ^ (p - 1), by ring⟩
    have hre : cshell.cross_section p a b = (cshell.cross_section p a b - (p : ℤ) * a ^ (p - 1)) + (p : ℤ) * a ^ (p - 1) := by ring
    rw [hre]; exact cshell.dvd_add p _ _ hcong hp_px
  unfold int_dvd at hd hd_Q ⊢
  obtain ⟨q1, hq1⟩ := hd
  obtain ⟨q2, hq2⟩ := hd_Q
  rw [cast_mul.int p p]
  exact ⟨q1 * q2, by rw [hfac, hq1, hq2]; ring⟩

-- First-order binomial expansion modulo p^2:
-- `(x - p * m)^(k + 1) = x^(k + 1) - (k + 1) * p * m * x^k + p^2 * R`!
+ cshell.pow_sub_pm_mod_p_sq (p k : ℕ) (x m : ℤ) :
    ∃ R : ℤ, (x - (p : ℤ) * m) ^ (k + 1) =
      x ^ (k + 1) - ((k + 1 : ℕ) : ℤ) * (p : ℤ) * m * x ^ k + ((p * p : ℕ) : ℤ) * R
  induction k with r ihr
  · use 0
    rw [cast_mul.int p p, pow_zero.int x]
    have h01 : (0 + 1 : ℕ) = 1 := by decide
    rw [h01, pow_one.int, pow_one.int, cast_one.int]; ring
  · obtain ⟨R, hR⟩ := ihr
    use ((r + 1 : ℕ) : ℤ) * m * m * x ^ r + R * (x - (p : ℤ) * m)
    rw [succ_eq_add_one.nat]
    rw [pow_succ.int (x - (p : ℤ) * m) (r + 1), hR, pow_succ.int x (r + 1), pow_succ.int x r]
    rw [cast_add.int (r + 1) 1, cast_one.int, cast_mul.int p p]; ring

+ cshell.sum_below_id_twice (n : ℕ) : 2 * (∑ j < n, j) = n * (n - 1)
  induction n with r ihr
  · rw [sum_below_zero]; decide
  · rw [succ_eq_add_one.nat, sum_below_succ r]
    have hmul : 2 * ((∑ j < r, j) + r) = 2 * (∑ j < r, j) + 2 * r := by ring
    rw [hmul, ihr]
    by_cases hr0 : r = 0
    · rw [hr0]; decide
    · have hr1 : r = (r - 1) + 1 := by omega
      have h1 : (r + 1) - 1 = r := by omega
      rw [h1]
      have heq_r : ((r - 1) + 1) * (r - 1) + 2 * ((r - 1) + 1) = (((r - 1) + 1) + 1) * ((r - 1) + 1) := by ring
      rw [← hr1] at heq_r
      omega

-- KEY LEMMA 2B: For ANY odd integer p >= 3, if p | (x + y), then ALREADY MODULO p^2 we have
-- `Q_p(x, y) ≡ p * x^(p - 1) (mod p^2)` (because sum_{k=0}^{p-1} k = p*(p-1)/2 is a multiple of p)!
+ cshell.cross_section_cong_p_sq (p : ℕ) (hp3 : 3 ≤ p) (hp_odd : p % 2 = 1)
    (x y : ℤ) (hd : int_dvd p (x + y)) :
    int_dvd (p * p) (cshell.cross_section p x y - (p : ℤ) * x ^ (p - 1))
  unfold int_dvd at hd
  obtain ⟨m, hm⟩ := hd
  have hny : -y = x - (p : ℤ) * m := by linarith
  -- By induction on n <= p, prove:
  have hall : ∀ n ≤ p, int_dvd (p * p) ((∑ j < n, (-y) ^ ((p - 1) - j) * x ^ j) - ((n : ℤ) * x ^ (p - 1) - ((∑ j < n, ((p - 1) - j) : ℕ) : ℤ) * (p : ℤ) * m * x ^ (p - 2)))
    intro n hn
    induction n with hn r ihr hn
    · simp; exact cshell.dvd_zero (p * p)
    · rw [succ_eq_add_one.nat] at hn ⊢
      rw [sum_below_succ r, sum_below_succ r, cast_add.int r 1, cast_one.int, cast_add.int (∑ j < r, ((p - 1) - j)) ((p - 1) - r)]
      have hprev := ihr (by omega)
      -- Term at j = r: either r = p - 1 (`(p - 1) - r = 0`) or r < p - 1 (`(p - 1) - r = k + 1`):
      have hterm : int_dvd (p * p) ((-y) ^ ((p - 1) - r) * x ^ r - (x ^ (p - 1) - (((p - 1) - r : ℕ) : ℤ) * (p : ℤ) * m * x ^ (p - 2)))
        by_cases hr_top : r = p - 1
        · have h0 : (p - 1) - r = 0 := by omega
          rw [h0, pow_zero.int (-y), cast_zero.int]
          have hr_eq : x ^ r = x ^ (p - 1) := by rw [hr_top]
          rw [hr_eq]
          have hz : 1 * x ^ (p - 1) - (x ^ (p - 1) - 0 * (p : ℤ) * m * x ^ (p - 2)) = 0 := by ring
          rw [hz]; exact cshell.dvd_zero (p * p)
        · set k := (p - 1) - r - 1 with hk_def
          have hk1 : (p - 1) - r = k + 1 := by omega
          rw [hk1, hny]
          obtain ⟨R, hR⟩ := cshell.pow_sub_pm_mod_p_sq p k x m
          rw [hR]
          have hpow1 : x ^ (k + 1) * x ^ r = x ^ (p - 1)
            have hexp : (k + 1) + r = p - 1 := by omega
            have hpadd := pow_add.int x (k + 1) r
            rw [hexp] at hpadd; exact hpadd.symm
          have hpow2 : x ^ k * x ^ r = x ^ (p - 2)
            have hexp : k + r = p - 2 := by omega
            have hpadd := pow_add.int x k r
            rw [hexp] at hpadd; exact hpadd.symm
          unfold int_dvd
          use R * x ^ r
          have hexpand : (x ^ (k + 1) - ((k + 1 : ℕ) : ℤ) * (p : ℤ) * m * x ^ k + ((p * p : ℕ) : ℤ) * R) * x ^ r =
              x ^ (k + 1) * x ^ r - ((k + 1 : ℕ) : ℤ) * (p : ℤ) * m * (x ^ k * x ^ r) + ((p * p : ℕ) : ℤ) * (R * x ^ r) := by ring
          rw [hexpand, hpow1, hpow2]; ring
      have hcomb : ((∑ j < r, (-y) ^ ((p - 1) - j) * x ^ j) + (-y) ^ ((p - 1) - r) * x ^ r) -
          ((((r : ℤ) + 1) * x ^ (p - 1) - (((∑ j < r, ((p - 1) - j) : ℕ) : ℤ) + (((p - 1) - r : ℕ) : ℤ)) * (p : ℤ) * m * x ^ (p - 2))) =
          ((∑ j < r, (-y) ^ ((p - 1) - j) * x ^ j) - ((r : ℤ) * x ^ (p - 1) - ((∑ j < r, ((p - 1) - j) : ℕ) : ℤ) * (p : ℤ) * m * x ^ (p - 2))) +
          ((-y) ^ ((p - 1) - r) * x ^ r - (x ^ (p - 1) - (((p - 1) - r : ℕ) : ℤ) * (p : ℤ) * m * x ^ (p - 2))) := by ring
      rw [hcomb]
      exact cshell.dvd_add (p * p) _ _ hprev hterm
  have hfull := hall p (by omega)
  unfold cshell.cross_section
  -- Show `∑ j < p, ((p - 1) - j)` is divisible by p (since p is odd: 2 * sum = p * (p - 1) => sum = p * (p / 2))!
  have hsum_rev : (∑ j < p, ((p - 1) - j)) = p * (p / 2)
    -- Compute 2 * ∑ j < p, ((p - 1) - j) = p * (p - 1) by pairing with ∑ j < p, j:
    have hpair : ∀ n ≤ p, (∑ j < n, ((p - 1) - j)) + (∑ j < n, j) = n * (p - 1)
      intro n hn; induction n with hn r ihr hn
      · rw [sum_below_zero, sum_below_zero]; ring
      · rw [succ_eq_add_one.nat] at hn ⊢
        rw [sum_below_succ r, sum_below_succ r]
        have hp_r : ((p - 1) - r) + r = p - 1 := by omega
        have hprev := ihr (by omega)
        have h1 : (r + 1) * (p - 1) = r * (p - 1) + (p - 1) := by ring
        omega
    have hp_tot := hpair p (by omega)
    have hid2 := cshell.sum_below_id_twice p
    have hdp := div_add_mod.nat p 2; rw [hp_odd] at hdp
    have hpm1 : p - 1 = 2 * (p / 2) := by omega
    rw [hpm1] at hp_tot hid2 ⊢
    have hmc : p * (2 * (p / 2)) = 2 * (p * (p / 2)) := by ring
    rw [hmc] at hp_tot hid2
    omega
  rw [hsum_rev, cast_mul.int p (p / 2)] at hfull
  have htail : int_dvd (p * p) ((p : ℤ) * ((p / 2 : ℕ) : ℤ) * (p : ℤ) * m * x ^ (p - 2))
    unfold int_dvd; rw [cast_mul.int p p]
    exact ⟨((p / 2 : ℕ) : ℤ) * m * x ^ (p - 2), by ring⟩
  have hre : (∑ j < p, (-y) ^ ((p - 1) - j) * x ^ j) - (p : ℤ) * x ^ (p - 1) =
      ((∑ j < p, (-y) ^ ((p - 1) - j) * x ^ j) - ((p : ℤ) * x ^ (p - 1) - ((p : ℤ) * ((p / 2 : ℕ) : ℤ)) * (p : ℤ) * m * x ^ (p - 2))) -
      ((p : ℤ) * ((p / 2 : ℕ) : ℤ) * (p : ℤ) * m * x ^ (p - 2)) := by ring
  rw [hre]
  exact cshell.dvd_sub (p * p) _ _ hfull htail

-- Fermat's Little Theorem lifted to Z: `int_dvd p (a^p - a)` for all primes p and a : Z!
+ cshell.fermat_int_sub (p : ℕ) (hp : is_prime_nat p) (a : ℤ) : int_dvd p (a ^ p - a)
  have hp_pos_n : 0 < p := by linarith [hp.1]
  have hp_pos : (0 : ℤ) < (p : ℤ) := (cast_pos.int p).mpr hp_pos_n
  have hda := div_add_mod.int a (p : ℤ)
  have h0 := mod_nonneg.int a (p : ℤ) hp_pos
  have hlt := mod_lt.int a (p : ℤ) hp_pos
  set r_z := a % (p : ℤ)
  set r := nat_of_int r_z with hr_def
  have hr_eq : (r : ℤ) = r_z := by rw [hr_def]; exact int_of_nat_of_int r_z h0
  have hr_lt : r < p := (cast_lt.int r p).mp (by rw [hr_eq]; exact hlt)
  have har : int_dvd p (a - (r : ℤ))
    unfold int_dvd; exact ⟨a / (p : ℤ), by linarith⟩
  have hap_rp : int_dvd p (a ^ p - (r : ℤ) ^ p) := cshell.dvd_pow_sub p p a (r : ℤ) har
  have hflt_n : (r ^ p) % p = r % p := fermat.nat_mod p r hp
  have hr_le : r ≤ r ^ p
    by_cases hr0 : r = 0
    · rw [hr0]; omega
    · have hp2_ge : 2 ≤ p := hp.1
      have hp1 : p = (p - 1) + 1 := by omega
      have hpow_pos : 0 < r ^ (p - 1) := pow_pos.nat r (p - 1) (by omega)
      have hpow_ge : 1 ≤ r ^ (p - 1) := by omega
      have hm := mul_le_mul_of_nonneg_right.nat 1 (r ^ (p - 1)) r hpow_ge (by omega)
      have hps : r ^ ((p - 1) + 1) = r ^ (p - 1) * r := pow_succ.nat r (p - 1)
      rw [← hp1] at hps
      omega
  have hd_rn : p ∣ (r ^ p - r) := (mod_eq_iff_dvd_sub p (r ^ p) r hp_pos_n hr_le).mp hflt_n
  obtain ⟨qr, hqr⟩ := (dvd.iff_exists p (r ^ p - r) hp_pos_n).mp hd_rn
  have hrp_r : int_dvd p ((r : ℤ) ^ p - (r : ℤ))
    unfold int_dvd; use (qr : ℤ)
    have hce : (((r ^ p - r) + r : ℕ) : ℤ) = ((p * qr + r : ℕ) : ℤ) := by rw [hqr]
    have hadd_n : (r ^ p - r) + r = r ^ p := by omega
    rw [hadd_n, cast_pow.int r p, cast_add.int (p * qr) r, cast_mul.int p qr] at hce
    linarith
  have htot : a ^ p - a = (a ^ p - (r : ℤ) ^ p) + ((r : ℤ) ^ p - (r : ℤ)) - (a - (r : ℤ)) := by ring
  rw [htot]
  exact cshell.dvd_sub p _ _ (cshell.dvd_add p _ _ hap_rp hrp_r) har

-- THEOREM 2C (COUPLED SHELL CASE-II p^2-DIVISIBILITY — `p | z => p^2 | z ∧ p^2 | (x + y)`, 0 AXIOMS!):
-- Coupling all three p-dimensional shell runs (x + y, y + z, z + x) forces ANY p-divisible
-- side of a primitive Fermat solution (p >= 3 odd prime) to be divisible by p^2!
+ cshell.case2_coupled_p_sq_dvd (p : ℕ) (hp : is_prime_nat p) (hp3 : 3 ≤ p)
    (x y z : ℤ) (hx_nz : x ≠ 0) (hy_nz : y ≠ 0) (hz_nz : z ≠ 0)
    (heq : x ^ p + y ^ p + z ^ p = 0)
    (hcop_xy : nat.coprime_primes (nat_of_int (|x|)) (nat_of_int (|y|)))
    (hcop_xz : nat.coprime_primes (nat_of_int (|x|)) (nat_of_int (|z|)))
    (hcop_yz : nat.coprime_primes (nat_of_int (|y|)) (nat_of_int (|z|)))
    (hp_z : int_dvd p z) :
    int_dvd (p * p) z ∧ int_dvd (p * p) (x + y)
  have hp_pos : 0 < p := by omega
  have hp_odd : p % 2 = 1
    by_contra hev; have hp0 : p % 2 = 0 := by omega
    obtain ⟨k, hk⟩ := (dvd.iff_exists 2 p (by decide)).mp hp0
    have hd2 : 2 ∣ p := (dvd.iff_exists 2 p (by decide)).mpr ⟨k, hk⟩
    obtain h1 | h2 := (is_prime_nat.to_full p hp).2 2 hd2 <;> omega
  have hp_nx : ¬ int_dvd p x
    intro hpx; unfold nat.coprime_primes at hcop_xz
    exact hcop_xz p hp ⟨(cshell.dvd_iff_nat_abs p hp_pos x).mp hpx, (cshell.dvd_iff_nat_abs p hp_pos z).mp hp_z⟩
  have hp_ny : ¬ int_dvd p y
    intro hpy; unfold nat.coprime_primes at hcop_yz
    exact hcop_yz p hp ⟨(cshell.dvd_iff_nat_abs p hp_pos y).mp hpy, (cshell.dvd_iff_nat_abs p hp_pos z).mp hp_z⟩
  -- Step 1: p | z => p | z^p => p | (x^p + y^p) => p | (x + y)!
  have hp_zp : int_dvd p (z ^ p)
    have hp1 : p = (p - 1) + 1 := by omega
    have hzp_eq : z ^ p = z * z ^ (p - 1)
      calc z ^ p = z ^ ((p - 1) + 1) := by rw [← hp1]
        _ = z ^ (p - 1) * z := pow_succ.int z (p - 1)
        _ = z * z ^ (p - 1) := by ring
    rw [hzp_eq]
    exact cshell.dvd_mul_r p z (z ^ (p - 1)) hp_z
  have hp_xy : int_dvd p (x + y)
    have hfx := cshell.fermat_int_sub p hp x
    have hfy := cshell.fermat_int_sub p hp y
    have hre : x + y = -(z ^ p) - (x ^ p - x) - (y ^ p - y) := by linarith
    rw [hre]
    exact cshell.dvd_sub p _ _ (cshell.dvd_sub p _ _ (cshell.dvd_neg p _ hp_zp) hfx) hfy
  -- Step 2: By `cshell.cross_section_cong_p_sq`, Q_p(x, y) ≡ p * x^(p-1) (mod p^2), so p^2 nmid Q_p(x, y)!
  -- Meanwhile p | z and p >= 3 => p^3 | z^p = -(x + y) * Q_p(x, y), which forces p^2 | (x + y)!
  have hp2_xy : int_dvd (p * p) (x + y)
    by_contra hnot_p2
    obtain ⟨m, hm⟩ := hp_xy
    have hp_nm : ¬ int_dvd p m
      intro hpm; obtain ⟨qm, hqm⟩ := hpm
      apply hnot_p2; unfold int_dvd
      rw [cast_mul.int p p]; exact ⟨qm, by rw [hm, hqm]; ring⟩
    -- Note p^3 divides z^p since p >= 3 and p | z:
    obtain ⟨qz, hqz⟩ := hp_z
    have hp3_zp : int_dvd (p * p * p) (z ^ p)
      have hp_m3 : p = (p - 3) + 3 := by omega
      have hmul_pow : ∀ k : ℕ, ((p : ℤ) * qz) ^ k = (p : ℤ) ^ k * qz ^ k
        intro k; induction k with r ihr
        · rw [pow_zero.int, pow_zero.int, pow_zero.int]; ring
        · rw [succ_eq_add_one.nat, pow_succ.int, pow_succ.int, pow_succ.int, ihr]; ring
      unfold int_dvd
      rw [cast_mul.int (p * p) p, cast_mul.int p p]
      use (p : ℤ) ^ (p - 3) * qz ^ p
      rw [hqz, hmul_pow p]
      have hp_cub : (p : ℤ) ^ ((p - 3) + 3) = ((p : ℤ) * (p : ℤ) * (p : ℤ)) * (p : ℤ) ^ (p - 3)
        rw [pow_add.int (p : ℤ) (p - 3) 3]; ring
      rw [← hp_m3] at hp_cub
      rw [hp_cub]; ring
    -- Also (x + y) * Q_p(x, y) = -z^p and Q_p(x, y) = p * x^(p - 1) + p^2 * qQ:
    obtain ⟨qQ, hqQ⟩ := cshell.cross_section_cong_p_sq p hp3 hp_odd x y ⟨m, hm⟩
    rw [cast_mul.int p p] at hqQ
    obtain ⟨q3, hq3⟩ := hp3_zp
    rw [cast_mul.int (p * p) p, cast_mul.int p p] at hq3
    have hfac := cshell.odd_pow_add_factor p hp_odd x y
    have hprod_eq : (p : ℤ) * (p : ℤ) * (m * x ^ (p - 1) + (p : ℤ) * m * qQ + (p : ℤ) * q3) = 0
      have hQ_eq : cshell.cross_section p x y = (p : ℤ) * x ^ (p - 1) + (p : ℤ) * (p : ℤ) * qQ := by linarith
      have hsum2 : (x + y) * cshell.cross_section p x y + z ^ p = 0 := by linarith
      rw [hm, hQ_eq, hq3] at hsum2
      linarith
    have hp_z_nz : (p : ℤ) * (p : ℤ) ≠ 0
      have hpos : (0 : ℤ) < (p : ℤ) := (cast_pos.int p).mpr hp_pos
      nlinarith
    have hinner0 : m * x ^ (p - 1) + (p : ℤ) * m * qQ + (p : ℤ) * q3 = 0
      by_contra hne0
      obtain hlt | hgt := lt_or_gt_of_ne.int _ 0 hne0
      · have hm1 := mul_pos.int ((p : ℤ) * (p : ℤ)) (-(m * x ^ (p - 1) + (p : ℤ) * m * qQ + (p : ℤ) * q3)) (by nlinarith [(cast_pos.int p).mpr hp_pos]) (by linarith)
        linarith
      · have hm1 := mul_pos.int ((p : ℤ) * (p : ℤ)) (m * x ^ (p - 1) + (p : ℤ) * m * qQ + (p : ℤ) * q3) (by nlinarith [(cast_pos.int p).mpr hp_pos]) hgt
        linarith
    have hd_mx : int_dvd p (m * x ^ (p - 1))
      unfold int_dvd; exact ⟨-(m * qQ + q3), by linarith⟩
    obtain hpm | hpx_pow := int_dvd.prime_mul p hp m (x ^ (p - 1)) hd_mx
    · exact hp_nm hpm
    · exact hp_nx (cshell.prime_pow_dvd p (p - 1) hp x hpx_pow)
  -- Step 3: Couple the TWO UNRAMIFIED SHELL ORIENTATIONS `y + z = b0^p` and `z + x = c0^p`!
  obtain ⟨ub, _, hub, _⟩ := cshell.width_cross_p_pow p hp hp_odd y z x hx_nz (by linarith) hcop_yz hp_nx
  obtain ⟨b0, hb0, _⟩ := cshell.signed_odd_pow p hp_odd (y + z) ub hub
  obtain ⟨uc, _, huc, _⟩ := cshell.width_cross_p_pow p hp hp_odd z x y hy_nz (by linarith) (nat.coprime_primes_symm _ _ hcop_xz) hp_ny
  obtain ⟨c0, hc0, _⟩ := cshell.signed_odd_pow p hp_odd (z + x) uc huc
  -- Sum: b0^p + c0^p = (y + z) + (z + x) = (x + y) + 2*z, which is divisible by p!
  have hp_bc_pow : int_dvd p (b0 ^ p + c0 ^ p)
    have hre : b0 ^ p + c0 ^ p = (x + y) + z + z := by linarith
    rw [hre]
    exact cshell.dvd_add p _ _ (cshell.dvd_add p _ _ hp_xy hp_z) hp_z
  have hp_bc : int_dvd p (b0 + c0)
    have hfb := cshell.fermat_int_sub p hp b0
    have hfc := cshell.fermat_int_sub p hp c0
    have hre : b0 + c0 = (b0 ^ p + c0 ^ p) - (b0 ^ p - b0) - (c0 ^ p - c0) := by ring
    rw [hre]
    exact cshell.dvd_sub p _ _ (cshell.dvd_sub p _ _ hp_bc_pow hfb) hfc
  -- By Key Lemma 2A (`cshell.int_dvd_p_sq_of_dvd_add`), `p | (b0 + c0) => p^2 | (b0^p + c0^p)`!
  have hp2_bc_pow : int_dvd (p * p) (b0 ^ p + c0 ^ p) :=
    cshell.int_dvd_p_sq_of_dvd_add p hp3 hp_odd b0 c0 hp_bc
  -- Since b0^p + c0^p = (x + y) + 2*z and p^2 | (x + y), we obtain p^2 | 2*z, hence p^2 | z!
  have hp2_2z : int_dvd (p * p) (2 * z)
    have hre : 2 * z = (b0 ^ p + c0 ^ p) - (x + y) := by linarith
    rw [hre]; exact cshell.dvd_sub (p * p) _ _ hp2_bc_pow hp2_xy
  have hp2_z : int_dvd (p * p) z
    obtain ⟨q2z, hq2z⟩ := hp2_2z
    -- Since p is odd, p * p = 2 * k + 1, so z = (p * p) * z - 2 * k * z = (p * p) * (z - k * q2z)!
    have hdp := div_add_mod.nat p 2; rw [hp_odd] at hdp
    set kp := p / 2
    have hp2_odd : p * p = 2 * (2 * kp * kp + 2 * kp) + 1
      have hp_e : p = 2 * kp + 1 := by omega
      calc p * p = (2 * kp + 1) * (2 * kp + 1) := by rw [← hp_e]
        _ = 2 * (2 * kp * kp + 2 * kp) + 1 := by ring
    set K := 2 * kp * kp + 2 * kp
    have hp2_z_eq : ((p * p : ℕ) : ℤ) = 2 * (K : ℤ) + 1
      rw [hp2_odd, cast_add.int (2 * K) 1, cast_mul.int 2 K, cast_one.int]
      have h2c : ((2 : ℕ) : ℤ) = 2 := by decide; rw [h2c]
    unfold int_dvd
    use z - (K : ℤ) * q2z
    calc z = (2 * (K : ℤ) + 1) * z - (K : ℤ) * (2 * z) := by ring
      _ = ((p * p : ℕ) : ℤ) * z - (K : ℤ) * (((p * p : ℕ) : ℤ) * q2z) := by rw [← hp2_z_eq, hq2z]
      _ = ((p * p : ℕ) : ℤ) * (z - (K : ℤ) * q2z) := by ring
  exact ⟨hp2_z, hp2_xy⟩


-- ====================================================================================
-- 3. Universal Coupled-Shell Wendt Theorem & Case-I FLT for ALL Odd Primes 3 <= p <= 109
-- ====================================================================================

-- Overflow-free bounded modular exponentiation `zmod.pow_mod q a m = (a ^ m) % q`:
-> zmod.pow_mod : ℕ → ℕ → ℕ → ℕ
  | q, _, 0 => 1 % q
  | q, a, m + 1 => (zmod.pow_mod q a m * (a % q)) % q

+ zmod.pow_mod_eq (q a m : ℕ) : zmod.pow_mod q a m = (a ^ m) % q
  induction m with r ihr
  · unfold zmod.pow_mod; simp [pow_zero.nat]
  · rw [succ_eq_add_one.nat]
    have hstep : zmod.pow_mod q a (r + 1) = (zmod.pow_mod q a r * (a % q)) % q := rfl
    rw [hstep, ihr, pow_succ.nat a r, mul_mod.nat (a ^ r) a q]

-- Fast sqrt-trial primality criterion for `decide`:
+ is_prime_nat.of_sqrt_check (n r : ℕ) (hn2 : 2 ≤ n) (hr : n < r * r)
    (hcheck : ∀ q < r, 2 ≤ q → n % q ≠ 0) : is_prime_nat n
  apply prime.to_is_prime_nat n
  unfold prime
  constructor
  · exact hn2
  · intro d hd_lt hd2
    by_cases hlt : d < r
    · exact hcheck d hlt hd2
    · by_contra hdiv0
      have hdm := div_add_mod.nat n d
      rw [hdiv0] at hdm
      set q0 := n / d
      have hnq : n = d * q0 := by omega
      by_cases hq_lt2 : q0 < 2
      · by_cases hq00 : q0 = 0
        · rw [hq00] at hnq; omega
        · have hq01 : q0 = 1 := by omega
          rw [hq01] at hnq; omega
      · have hq_lt_r : q0 < r
          by_contra hq_ge_r
          have hm1 := mul_le_mul.nat r d r q0 (by omega) (by omega) (by omega) (by omega)
          omega
        have hmod_q0 : n % q0 = 0
          have hnq2 : n = 0 + q0 * d := by rw [hnq]; ring
          rw [hnq2, add_mul_mod.nat 0 d q0]
          exact (div_mod_of_lt.nat 0 q0 (by omega)).2
        exact hcheck q0 hq_lt_r (by omega) hmod_q0

-- Helper: for any integer w not divisible by prime q = m*p + 1, `((w % q) ^ m) % q = 1`
-- whenever w = ± u^p for some u : N (or w^m ≡ 1 mod q directly via Fermat's Little Theorem)!
+ cshell.mod_q_pow_m_eq_one_of_p_pow (p m q u : ℕ)
    (hq : is_prime_nat q) (hq_eq : q = m * p + 1) (hm_pos : 1 ≤ m)
    (hnd : ¬ (q ∣ u)) :
    ((u ^ p) ^ m) % q = 1
  have hpow : (u ^ p) ^ m = u ^ (m * p)
    have hcomm : m * p = p * m := by ring
    rw [hcomm, nat.pow_mul_swap m p u]
  have hqm1 : m * p = q - 1 := by omega
  rw [hpow, hqm1]
  exact fp.pow_p_sub_one q u hq hnd

-- Helper: for ANY z : Z with `¬ int_dvd q z`, its positive residue `rz = nat_of_int (z % q)`
-- satisfies `1 <= rz < q`, `int_dvd q (z - rz)`, and `(rz ^ (q - 1)) % q = 1`!
+ cshell.pos_rem_mod_prime (q : ℕ) (hq : is_prime_nat q) (z : ℤ) (hnd : ¬ int_dvd q z) :
    ∃ rz : ℕ, 1 ≤ rz ∧ rz < q ∧ int_dvd q (z - (rz : ℤ)) ∧ ¬ (q ∣ rz)
  have hq_pos_n : 0 < q := by linarith [hq.1]
  have hq_pos : (0 : ℤ) < (q : ℤ) := (cast_pos.int q).mpr hq_pos_n
  have hdz := div_add_mod.int z (q : ℤ)
  have h0 := mod_nonneg.int z (q : ℤ) hq_pos
  have hlt := mod_lt.int z (q : ℤ) hq_pos
  set rz := nat_of_int (z % (q : ℤ)) with hrz_def
  have hrz : (rz : ℤ) = z % (q : ℤ) := by rw [hrz_def]; exact int_of_nat_of_int (z % (q : ℤ)) h0
  have hrz_lt : rz < q := (cast_lt.int rz q).mp (by rw [hrz]; exact hlt)
  have hd_sub : int_dvd q (z - (rz : ℤ))
    unfold int_dvd; exact ⟨z / (q : ℤ), by linarith⟩
  have hrz_pos : 1 ≤ rz
    by_contra h0r; have hzr : rz = 0 := by omega
    rw [hzr, cast_zero.int] at hd_sub
    have hz_eq : z = z - 0 := by ring
    rw [← hz_eq] at hd_sub; exact hnd hd_sub
  have hq_nrz : ¬ (q ∣ rz) := not_dvd_of_pos_lt q rz (by omega) hrz_lt
  exact ⟨rz, hrz_pos, hrz_lt, hd_sub, hq_nrz⟩

-- Helper: `int_dvd q (a - b) => a % q = b % q` on N (via cast to Z)!
+ cshell.nat_mod_eq_of_int_dvd (q a b : ℕ) (hq : 0 < q) (hd : int_dvd q ((a : ℤ) - (b : ℤ))) :
    a % q = b % q
  obtain ⟨k, hk⟩ := hd
  have hqp : (0 : ℤ) < (q : ℤ) := (cast_pos.int q).mpr hq
  have ha_eq : (a : ℤ) = (b : ℤ) + (q : ℤ) * k := by linarith
  have hmod_z : (a : ℤ) % (q : ℤ) = (b : ℤ) % (q : ℤ)
    rw [ha_eq, add_mul_mod.int (b : ℤ) k (q : ℤ) hqp]
  exact (cast_inj.int (a % q) (b % q)).mp (by rw [cast_mod.int a q, cast_mod.int b q, hmod_z])

-- Helper: for even m = 2*k, `(q - s)^m % q = s^m % q` whenever `s <= q`!
+ cshell.neg_mod_even_pow (q s k : ℕ) (hq : 0 < q) (hs : s ≤ q) :
    ((q - s) ^ (2 * k)) % q = (s ^ (2 * k)) % q
  apply cshell.nat_mod_eq_of_int_dvd q ((q - s) ^ (2 * k)) (s ^ (2 * k)) hq
  have hcast_sub : ((q - s : ℕ) : ℤ) = (q : ℤ) - (s : ℤ)
    have hadd : (q - s) + s = q := by omega
    have hc : (((q - s) + s : ℕ) : ℤ) = (q : ℤ) := by rw [hadd]
    rw [cast_add.int (q - s) s] at hc; linarith
  rw [cast_pow.int (q - s) (2 * k), cast_pow.int s (2 * k), hcast_sub]
  have hd_diff : int_dvd q (((q : ℤ) - (s : ℤ)) - (-(s : ℤ)))
    unfold int_dvd; exact ⟨1, by ring⟩
  have hd_pow := cshell.dvd_pow_sub q (2 * k) ((q : ℤ) - (s : ℤ)) (-(s : ℤ)) hd_diff
  rw [cshell.even_pow_neg k (s : ℤ)] at hd_pow
  exact hd_pow

-- Core Wendt Case-I Contradiction when q | z (`int_dvd q z`):
+ cshell.wendt_z_div_q (p m q : ℕ)
    (hp : is_prime_nat p) (hp5 : 5 ≤ p)
    (hm_pos : 1 ≤ m) (hm_ev : m % 2 = 0)
    (hq : is_prime_nat q) (hq_eq : q = m * p + 1)
    (hp_nm : zmod.pow_mod q p m ≠ 1)
    (hno_adj : ∀ t < q, t ≠ 0 → zmod.pow_mod q t m = 1 → (t + 1) % q = 0 ∨ zmod.pow_mod q ((t + 1) % q) m ≠ 1)
    (x y z : ℤ) (heq : x ^ p + y ^ p + z ^ p = 0)
    (hcop_xy : nat.coprime_primes (nat_of_int (|x|)) (nat_of_int (|y|)))
    (hcop_xz : nat.coprime_primes (nat_of_int (|x|)) (nat_of_int (|z|)))
    (hcop_yz : nat.coprime_primes (nat_of_int (|y|)) (nat_of_int (|z|)))
    (hp_nx : ¬ int_dvd p x) (hp_ny : ¬ int_dvd p y) (hp_nz : ¬ int_dvd p z)
    (hq_z : int_dvd q z) : False
  have hq_pos : 0 < q := by linarith [hq.1]
  have hp_odd : p % 2 = 1
    by_contra hev; have hp0 : p % 2 = 0 := by omega
    obtain ⟨k, hk⟩ := (dvd.iff_exists 2 p (by decide)).mp hp0
    obtain h1 | h2 := (is_prime_nat.to_full p hp).2 2 ((dvd.iff_exists 2 p (by decide)).mpr ⟨k, hk⟩) <;> omega
  have hdm := div_add_mod.nat m 2; rw [hm_ev] at hdm
  set km := m / 2
  have hm_2k : m = 2 * km := by omega
  have hx_ne : x ≠ 0 := by intro h0; rw [h0] at hp_nx; exact hp_nx (cshell.dvd_zero p)
  have hy_ne : y ≠ 0 := by intro h0; rw [h0] at hp_ny; exact hp_ny (cshell.dvd_zero p)
  have hz_ne : z ≠ 0 := by intro h0; rw [h0] at hp_nz; exact hp_nz (cshell.dvd_zero p)
  have hq_nx : ¬ int_dvd q x
    intro hqx; unfold nat.coprime_primes at hcop_xz
    exact hcop_xz q hq ⟨(cshell.dvd_iff_nat_abs q hq_pos x).mp hqx, (cshell.dvd_iff_nat_abs q hq_pos z).mp hq_z⟩
  have hq_ny : ¬ int_dvd q y
    intro hqy; unfold nat.coprime_primes at hcop_yz
    exact hcop_yz q hq ⟨(cshell.dvd_iff_nat_abs q hq_pos y).mp hqy, (cshell.dvd_iff_nat_abs q hq_pos z).mp hq_z⟩
  obtain ⟨rx, hrx1, hrx_lt, hrx_sub, hq_nrx⟩ := cshell.pos_rem_mod_prime q hq x hq_nx
  obtain ⟨ry, hry1, hry_lt, hry_sub, hq_nry⟩ := cshell.pos_rem_mod_prime q hq y hq_ny
  -- Apply coupled shell width rigidity to (x, z), (y, z), and (x, y)!
  obtain ⟨u, t1, hu, ht1⟩ := cshell.width_cross_p_pow p hp hp_odd x y z hz_ne heq hcop_xy hp_nz
  obtain ⟨v, _, hv, _⟩ := cshell.width_cross_p_pow p hp hp_odd x z y hy_ne (by linarith) hcop_xz hp_ny
  obtain ⟨w, _, hw, _⟩ := cshell.width_cross_p_pow p hp hp_odd y z x hx_ne (by linarith) hcop_yz hp_nx
  -- Helper: from |a + z| = B^p, q | z, and a ≡ ra (mod q) with q nmid ra, deduce (ra ^ m) % q = 1!
  have h_unit_m : ∀ a : ℤ, ∀ ra B : ℕ, ¬ int_dvd q a → int_dvd q (a - (ra : ℤ)) → |a + z| = (B : ℤ) ^ p → (ra ^ m) % q = 1
    intro a ra B hq_na hra_s habs_az
    obtain ⟨wB, hwB, hwB_abs⟩ := cshell.signed_odd_pow p hp_odd (a + z) B habs_az
    have hq_nB : ¬ (q ∣ B)
      intro hqB
      have hd_wB : int_dvd q wB
        apply (cshell.dvd_iff_nat_abs q hq_pos wB).mpr
        have he : nat_of_int (|wB|) = B := (cast_inj.int (nat_of_int (|wB|)) B).mp (by rw [int_of_nat_of_int (|wB|) (abs_nonneg.int wB), hwB_abs])
        rw [he]; exact hqB
      have hd_az : int_dvd q (a + z)
        rw [hwB]
        have hp1 : p = (p - 1) + 1 := by omega
        have hwp_eq : wB ^ p = wB * wB ^ (p - 1)
          calc wB ^ p = wB ^ ((p - 1) + 1) := by rw [← hp1]
            _ = wB ^ (p - 1) * wB := pow_succ.int wB (p - 1)
            _ = wB * wB ^ (p - 1) := by ring
        rw [hwp_eq]
        exact cshell.dvd_mul_r q wB (wB ^ (p - 1)) hd_wB
      have hd_a : int_dvd q a
        have hre : a = (a + z) - z := by ring
        rw [hre]; exact cshell.dvd_sub q _ _ hd_az hq_z
      exact hq_na hd_a
    have hd_ra_wBp : int_dvd q ((ra : ℤ) - wB ^ p)
      have hre : (ra : ℤ) - wB ^ p = ((a + z) - wB ^ p) - z - (a - (ra : ℤ)) := by ring
      rw [hre, hwB]
      have hz0 : wB ^ p - wB ^ p = 0 := by ring
      rw [hz0]
      exact cshell.dvd_sub q _ _ (cshell.dvd_sub q _ _ (cshell.dvd_zero q) hq_z) hra_s
    have hd_pow_m := cshell.dvd_pow_sub q m (ra : ℤ) (wB ^ p) hd_ra_wBp
    have hwBp_m : (wB ^ p) ^ m = (((B ^ p) ^ m : ℕ) : ℤ)
      have hwB_pm : wB = (B : ℤ) ∨ wB = -(B : ℤ)
        obtain ⟨e, _⟩ | ⟨e, _⟩ := abs_cases.int wB; (left; linarith); (right; linarith)
      obtain hpos | hneg := hwB_pm
      · rw [hpos, cast_pow.int (B ^ p) m, cast_pow.int B p]
      · rw [hneg, hm_2k]
        have hneg_p : (-(B : ℤ)) ^ p = -((B : ℤ) ^ p)
          set mp := p / 2
          have hpe : p = 2 * mp + 1 := by have hd := div_add_mod.nat p 2; omega
          rw [hpe, cshell.neg_odd_pow mp (B : ℤ)]
        rw [hneg_p, cshell.even_pow_neg km ((B : ℤ) ^ p), ← hm_2k, cast_pow.int (B ^ p) m, cast_pow.int B p]
    rw [hwBp_m, ← cast_pow.int ra m] at hd_pow_m
    have hmod_eq := cshell.nat_mod_eq_of_int_dvd q (ra ^ m) ((B ^ p) ^ m) hq_pos hd_pow_m
    rw [hmod_eq]
    exact cshell.mod_q_pow_m_eq_one_of_p_pow p m q B hq hq_eq hm_pos hq_nB
  have hrx_m : (rx ^ m) % q = 1 := h_unit_m x rx v hq_nx hrx_sub hv
  have hry_m : (ry ^ m) % q = 1 := h_unit_m y ry w hq_ny hry_sub hw
  -- Show `int_dvd q (x + y)` (otherwise t = (rx * ry^(m - 1)) % q violates `hno_adj`!):
  have hq_xy : int_dvd q (x + y)
    by_contra hq_nxy
    obtain ⟨wu, hwu, hwu_abs⟩ := cshell.signed_odd_pow p hp_odd (x + y) u hu
    have hq_nu : ¬ (q ∣ u)
      intro hqu
      have hd_wu : int_dvd q wu
        apply (cshell.dvd_iff_nat_abs q hq_pos wu).mpr
        have he : nat_of_int (|wu|) = u := (cast_inj.int (nat_of_int (|wu|)) u).mp (by rw [int_of_nat_of_int (|wu|) (abs_nonneg.int wu), hwu_abs])
        rw [he]; exact hqu
      apply hq_nxy; rw [hwu]
      have hp1 : p = (p - 1) + 1 := by omega
      have hwp_eq : wu ^ p = wu * wu ^ (p - 1)
        calc wu ^ p = wu ^ ((p - 1) + 1) := by rw [← hp1]
          _ = wu ^ (p - 1) * wu := pow_succ.int wu (p - 1)
          _ = wu * wu ^ (p - 1) := by ring
      rw [hwp_eq]
      exact cshell.dvd_mul_r q wu (wu ^ (p - 1)) hd_wu
    -- Note (rx + ry) ≡ x + y = wu^p (mod q), so ((rx + ry)^m) % q = 1 and (rx + ry) % q != 0!
    have hd_rxy_wu : int_dvd q (((rx + ry : ℕ) : ℤ) - wu ^ p)
      rw [cast_add.int rx ry]
      have hre : (rx : ℤ) + (ry : ℤ) - wu ^ p = ((x + y) - wu ^ p) - (x - (rx : ℤ)) - (y - (ry : ℤ)) := by ring
      rw [hre, hwu]
      have hz0 : wu ^ p - wu ^ p = 0 := by ring
      rw [hz0]
      exact cshell.dvd_sub q _ _ (cshell.dvd_sub q _ _ (cshell.dvd_zero q) hrx_sub) hry_sub
    have hd_rxy_m := cshell.dvd_pow_sub q m ((rx + ry : ℕ) : ℤ) (wu ^ p) hd_rxy_wu
    have hwu_m : (wu ^ p) ^ m = (((u ^ p) ^ m : ℕ) : ℤ)
      obtain ⟨e, _⟩ | ⟨e, _⟩ := abs_cases.int wu
      · have hew : wu = (u : ℤ) := by linarith
        rw [hew, cast_pow.int (u ^ p) m, cast_pow.int u p]
      · have hew : wu = -(u : ℤ) := by linarith
        rw [hew, hm_2k]
        set mp := p / 2
        have hpe : p = 2 * mp + 1 := by have hd := div_add_mod.nat p 2; omega
        rw [hpe, cshell.neg_odd_pow mp (u : ℤ), ← hpe, cshell.even_pow_neg km ((u : ℤ) ^ p), ← hm_2k, cast_pow.int (u ^ p) m, cast_pow.int u p]
    rw [hwu_m, ← cast_pow.int (rx + ry) m] at hd_rxy_m
    have hrxy_m : ((rx + ry) ^ m) % q = 1
      rw [cshell.nat_mod_eq_of_int_dvd q ((rx + ry) ^ m) ((u ^ p) ^ m) hq_pos hd_rxy_m]
      exact cshell.mod_q_pow_m_eq_one_of_p_pow p m q u hq hq_eq hm_pos hq_nu
    have hrxy_nz : (rx + ry) % q ≠ 0
      intro h0
      have h1q : 1 % q = 1 := (div_mod_of_lt.nat 1 q (by omega)).2
      have hm1 : m = (m - 1) + 1 := by omega
      rw [hm1, pow_succ.nat (rx + ry) (m - 1), mul_mod.nat, h0, mul_zero.nat] at hrxy_m
      have h0q : 0 % q = 0 := (div_mod_of_lt.nat 0 q hq_pos).2
      rw [h0q] at hrxy_m; omega
    -- Set t = (rx * ry^(m - 1)) % q!
    set t := (rx * ry ^ (m - 1)) % q with ht_def
    have ht_lt : t < q := by rw [ht_def]; exact mod_lt.nat _ q hq_pos
    have hpow_mod_base : ∀ a b : ℕ, ((a % q) ^ b) % q = (a ^ b) % q
      intro a b; induction b with j ihj
      · rw [pow_zero.nat, pow_zero.nat]
      · rw [succ_eq_add_one.nat, pow_succ.nat, pow_succ.nat, mul_mod.nat ((a % q) ^ j) (a % q) q, ihj, zmod.mod_mod a q, ← mul_mod.nat (a ^ j) a q]
    have h1q : 1 % q = 1 := (div_mod_of_lt.nat 1 q (by omega)).2
    have hry_mm1_m : ((ry ^ (m - 1)) ^ m) % q = 1
      have hswap : (ry ^ (m - 1)) ^ m = (ry ^ m) ^ (m - 1)
        rw [← nat.pow_mul_swap m (m - 1) ry, ← nat.pow_mul_swap (m - 1) m ry]
        have hc : (m - 1) * m = m * (m - 1) := by ring
        rw [hc]
      rw [hswap, ← hpow_mod_base (ry ^ m) (m - 1), hry_m, nat.one_pow_eq (m - 1), h1q]
    have ht_m : (t ^ m) % q = 1
      rw [ht_def, hpow_mod_base (rx * ry ^ (m - 1)) m, nat.mul_pow_eq m rx (ry ^ (m - 1)),
          mul_mod.nat (rx ^ m) ((ry ^ (m - 1)) ^ m) q, hrx_m, hry_mm1_m, one_mul.nat, h1q]
    have ht_nz : t ≠ 0
      intro ht0; rw [ht0] at ht_m
      have hm1 : m = (m - 1) + 1 := by omega
      rw [hm1, pow_succ.nat 0 (m - 1), mul_zero.nat, (div_mod_of_lt.nat 0 q hq_pos).2] at ht_m
      omega
    have hry_inv : (ry * ry ^ (m - 1)) % q = 1
      have hm1 : m = (m - 1) + 1 := by omega
      have hp1 : ry * ry ^ (m - 1) = ry ^ m
        calc ry * ry ^ (m - 1) = ry ^ (m - 1) * ry := by ring
          _ = ry ^ ((m - 1) + 1) := (pow_succ.nat ry (m - 1)).symm
          _ = ry ^ m := by rw [← hm1]
      rw [hp1]; exact hry_m
    have htp1_eq : (t + 1) % q = ((rx + ry) * ry ^ (m - 1)) % q
      have hdist : (rx + ry) * ry ^ (m - 1) = rx * ry ^ (m - 1) + ry * ry ^ (m - 1) := by ring
      rw [hdist, add_mod.nat (rx * ry ^ (m - 1)) (ry * ry ^ (m - 1)) q, ← ht_def, hry_inv]
    have htp1_m : (((t + 1) % q) ^ m) % q = 1
      rw [htp1_eq, hpow_mod_base ((rx + ry) * ry ^ (m - 1)) m, nat.mul_pow_eq m (rx + ry) (ry ^ (m - 1)),
          mul_mod.nat ((rx + ry) ^ m) ((ry ^ (m - 1)) ^ m) q, hrxy_m, hry_mm1_m, one_mul.nat, h1q]
    have htp1_nz : (t + 1) % q ≠ 0
      intro h0; rw [h0] at htp1_m
      have hm1 : m = (m - 1) + 1 := by omega
      rw [hm1, pow_succ.nat 0 (m - 1), mul_zero.nat, (div_mod_of_lt.nat 0 q hq_pos).2] at htp1_m
      omega
    obtain hadj0 | hadj_ne := hno_adj t ht_lt ht_nz (by rw [zmod.pow_mod_eq]; exact ht_m)
    · exact htp1_nz hadj0
    · rw [zmod.pow_mod_eq] at hadj_ne; exact hadj_ne htp1_m
  -- Now `int_dvd q (x + y)` holds! Use `Q_p(x, y) ≡ p * x^(p - 1) (mod q)` and `|Q_p(x, y)| = t1^p`:
  have hcong_q := cshell.cross_section_cong_mod p q (by omega) x y hq_xy
  obtain ⟨wt, hwt, hwt_abs⟩ := cshell.signed_odd_pow p hp_odd (cshell.cross_section p x y) t1 ht1
  have hq_nt1 : ¬ (q ∣ t1)
    intro hqt1
    have hd_wt : int_dvd q wt
      apply (cshell.dvd_iff_nat_abs q hq_pos wt).mpr
      have he : nat_of_int (|wt|) = t1 := (cast_inj.int (nat_of_int (|wt|)) t1).mp (by rw [int_of_nat_of_int (|wt|) (abs_nonneg.int wt), hwt_abs])
      rw [he]; exact hqt1
    have hd_Q : int_dvd q (cshell.cross_section p x y)
      rw [hwt]
      have hp1 : p = (p - 1) + 1 := by omega
      have hwp_eq : wt ^ p = wt * wt ^ (p - 1)
        calc wt ^ p = wt ^ ((p - 1) + 1) := by rw [← hp1]
          _ = wt ^ (p - 1) * wt := pow_succ.int wt (p - 1)
          _ = wt * wt ^ (p - 1) := by ring
      rw [hwp_eq]
      exact cshell.dvd_mul_r q wt (wt ^ (p - 1)) hd_wt
    have hd_px : int_dvd q ((p : ℤ) * x ^ (p - 1))
      have hre : (p : ℤ) * x ^ (p - 1) = cshell.cross_section p x y - (cshell.cross_section p x y - (p : ℤ) * x ^ (p - 1)) := by ring
      rw [hre]; exact cshell.dvd_sub q _ _ hd_Q hcong_q
    obtain hqp | hqx_pow := int_dvd.prime_mul q hq (p : ℤ) (x ^ (p - 1)) hd_px
    · have hqp_eq : q = p := cshell.prime_eq_of_dvd_prime q p hq hp hqp
      have hge : 1 * p ≤ m * p := mul_le_mul_of_nonneg_right.nat 1 m p hm_pos (by omega)
      omega
    · exact hq_nx (cshell.prime_pow_dvd q (p - 1) hq x hqx_pow)
  have hd_x_rx_pow : int_dvd q (x ^ (p - 1) - (rx : ℤ) ^ (p - 1)) := cshell.dvd_pow_sub q (p - 1) x (rx : ℤ) hrx_sub
  have hd_wt_prx : int_dvd q (wt ^ p - ((p * rx ^ (p - 1) : ℕ) : ℤ))
    rw [← hwt, cast_mul.int p (rx ^ (p - 1)), cast_pow.int rx (p - 1)]
    have hre : cshell.cross_section p x y - (p : ℤ) * (rx : ℤ) ^ (p - 1) =
        (cshell.cross_section p x y - (p : ℤ) * x ^ (p - 1)) +
        (x ^ (p - 1) - (rx : ℤ) ^ (p - 1)) * (p : ℤ) := by ring
    rw [hre]
    exact cshell.dvd_add q _ _ hcong_q (cshell.dvd_mul_r q _ (p : ℤ) hd_x_rx_pow)
  have hd_m := cshell.dvd_pow_sub q m (wt ^ p) ((p * rx ^ (p - 1) : ℕ) : ℤ) hd_wt_prx
  have hwt_m : (wt ^ p) ^ m = (((t1 ^ p) ^ m : ℕ) : ℤ)
    obtain ⟨e, _⟩ | ⟨e, _⟩ := abs_cases.int wt
    · have hew : wt = (t1 : ℤ) := by linarith
      rw [hew, cast_pow.int (t1 ^ p) m, cast_pow.int t1 p]
    · have hew : wt = -(t1 : ℤ) := by linarith
      rw [hew, hm_2k]
      set mp := p / 2
      have hpe : p = 2 * mp + 1 := by have hd := div_add_mod.nat p 2; omega
      rw [hpe, cshell.neg_odd_pow mp (t1 : ℤ), ← hpe, cshell.even_pow_neg km ((t1 : ℤ) ^ p), ← hm_2k, cast_pow.int (t1 ^ p) m, cast_pow.int t1 p]
  rw [hwt_m, ← cast_pow.int (p * rx ^ (p - 1)) m] at hd_m
  have ht1_mod1 : ((t1 ^ p) ^ m) % q = 1 := cshell.mod_q_pow_m_eq_one_of_p_pow p m q t1 hq hq_eq hm_pos hq_nt1
  have hprx_mod1 : ((p * rx ^ (p - 1)) ^ m) % q = 1
    rw [← cshell.nat_mod_eq_of_int_dvd q ((t1 ^ p) ^ m) ((p * rx ^ (p - 1)) ^ m) hq_pos hd_m]
    exact ht1_mod1
  have hpow_mod_base : ∀ a b : ℕ, ((a % q) ^ b) % q = (a ^ b) % q
    intro a b; induction b with j ihj
    · rw [pow_zero.nat, pow_zero.nat]
    · rw [succ_eq_add_one.nat, pow_succ.nat, pow_succ.nat, mul_mod.nat ((a % q) ^ j) (a % q) q, ihj, zmod.mod_mod a q, ← mul_mod.nat (a ^ j) a q]
  have hrx_pm1_m : ((rx ^ (p - 1)) ^ m) % q = 1
    have hswap : (rx ^ (p - 1)) ^ m = (rx ^ m) ^ (p - 1)
      rw [← nat.pow_mul_swap m (p - 1) rx, ← nat.pow_mul_swap (p - 1) m rx]
      have hc : (p - 1) * m = m * (p - 1) := by ring
      rw [hc]
    rw [hswap, ← hpow_mod_base (rx ^ m) (p - 1), hrx_m, nat.one_pow_eq (p - 1)]
    exact (div_mod_of_lt.nat 1 q (by omega)).2
  have hpm_eq1 : (p ^ m) % q = 1
    rw [nat.mul_pow_eq m p (rx ^ (p - 1)), mul_mod.nat (p ^ m) ((rx ^ (p - 1)) ^ m) q, hrx_pm1_m] at hprx_mod1
    have hm1 : (p ^ m) % q * 1 = (p ^ m) % q := by ring
    rw [hm1, zmod.mod_mod (p ^ m) q] at hprx_mod1
    exact hprx_mod1
  rw [zmod.pow_mod_eq q p m] at hp_nm
  exact hp_nm hpm_eq1

-- THEOREM 3A (UNIVERSAL COUPLED-SHELL WENDT AUXILIARY-PRIME CASE-I THEOREM — 0 CUSTOM AXIOMS!):
-- For ANY odd prime p >= 5, if q = m*p + 1 is prime (m >= 2 even) with `p^m % q != 1` and
-- no two consecutive nonzero m-th roots of unity mod q, then Case-I FLT holds at p!
+ cshell.wendt_aux_prime_case1 (p m q : ℕ)
    (hp : is_prime_nat p) (hp5 : 5 ≤ p)
    (hm_pos : 1 ≤ m) (hm_ev : m % 2 = 0)
    (hq : is_prime_nat q) (hq_eq : q = m * p + 1)
    (hp_nm : zmod.pow_mod q p m ≠ 1)
    (hno_adj : ∀ t < q, t ≠ 0 → zmod.pow_mod q t m = 1 → (t + 1) % q = 0 ∨ zmod.pow_mod q ((t + 1) % q) m ≠ 1)
    (x y z : ℤ) (heq : x ^ p + y ^ p + z ^ p = 0)
    (hcop_xy : nat.coprime_primes (nat_of_int (|x|)) (nat_of_int (|y|)))
    (hcop_xz : nat.coprime_primes (nat_of_int (|x|)) (nat_of_int (|z|)))
    (hcop_yz : nat.coprime_primes (nat_of_int (|y|)) (nat_of_int (|z|)))
    (hp_nx : ¬ int_dvd p x) (hp_ny : ¬ int_dvd p y) (hp_nz : ¬ int_dvd p z) : False
  by_cases hqz : int_dvd q z
  · exact cshell.wendt_z_div_q p m q hp hp5 hm_pos hm_ev hq hq_eq hp_nm hno_adj x y z heq hcop_xy hcop_xz hcop_yz hp_nx hp_ny hp_nz hqz
  · by_cases hqy : int_dvd q y
    · exact cshell.wendt_z_div_q p m q hp hp5 hm_pos hm_ev hq hq_eq hp_nm hno_adj x z y (by linarith) hcop_xz hcop_xy (nat.coprime_primes_symm _ _ hcop_yz) hp_nx hp_nz hp_ny hqy
    · by_cases hqx : int_dvd q x
      · exact cshell.wendt_z_div_q p m q hp hp5 hm_pos hm_ev hq hq_eq hp_nm hno_adj y z x (by linarith) hcop_yz (nat.coprime_primes_symm _ _ hcop_xy) (nat.coprime_primes_symm _ _ hcop_xz) hp_ny hp_nz hp_nx hqx
      · -- `q nmid x * y * z`: project `(x^p, y^p, z^p)` onto `H_m` in `F_q^*`!
        have hq2 : 2 ≤ q := hq.1
        have hq_pos : 0 < q := by omega
        have h1q : 1 % q = 1 := (div_mod_of_lt.nat 1 q (by omega)).2
        have h0q : 0 % q = 0 := (div_mod_of_lt.nat 0 q hq_pos).2
        have hdm := div_add_mod.nat m 2; rw [hm_ev] at hdm
        set km := m / 2
        have hm_2k : m = 2 * km := by omega
        obtain ⟨rx, hrx1, hrx_lt, hrx_sub, hq_nrx⟩ := cshell.pos_rem_mod_prime q hq x hqx
        obtain ⟨ry, hry1, hry_lt, hry_sub, hq_nry⟩ := cshell.pos_rem_mod_prime q hq y hqy
        obtain ⟨rz, hrz1, hrz_lt, hrz_sub, hq_nrz⟩ := cshell.pos_rem_mod_prime q hq z hqz
        have hxp_m : ((rx ^ p) ^ m) % q = 1 := cshell.mod_q_pow_m_eq_one_of_p_pow p m q rx hq hq_eq hm_pos hq_nrx
        have hyp_m : ((ry ^ p) ^ m) % q = 1 := cshell.mod_q_pow_m_eq_one_of_p_pow p m q ry hq hq_eq hm_pos hq_nry
        have hzp_m : ((rz ^ p) ^ m) % q = 1 := cshell.mod_q_pow_m_eq_one_of_p_pow p m q rz hq hq_eq hm_pos hq_nrz
        have hsum_mod0 : (rx ^ p + ry ^ p + rz ^ p) % q = 0
          have hd_sum : int_dvd q (((rx ^ p + ry ^ p + rz ^ p : ℕ) : ℤ) - ((0 : ℕ) : ℤ))
            rw [cast_add.int, cast_add.int, cast_pow.int rx p, cast_pow.int ry p, cast_pow.int rz p, cast_zero.int]
            have hdx := cshell.dvd_pow_sub q p x (rx : ℤ) hrx_sub
            have hdy := cshell.dvd_pow_sub q p y (ry : ℤ) hry_sub
            have hdz := cshell.dvd_pow_sub q p z (rz : ℤ) hrz_sub
            have hre : (rx : ℤ) ^ p + (ry : ℤ) ^ p + (rz : ℤ) ^ p - 0 =
                (x ^ p + y ^ p + z ^ p) - (x ^ p - (rx : ℤ) ^ p) - (y ^ p - (ry : ℤ) ^ p) - (z ^ p - (rz : ℤ) ^ p) := by ring
            rw [hre, heq]
            exact cshell.dvd_sub q _ _ (cshell.dvd_sub q _ _ (cshell.dvd_sub q _ _ (cshell.dvd_zero q) hdx) hdy) hdz
          rw [cshell.nat_mod_eq_of_int_dvd q (rx ^ p + ry ^ p + rz ^ p) 0 hq_pos hd_sum, h0q]
        have hpow_mod_base : ∀ a b : ℕ, ((a % q) ^ b) % q = (a ^ b) % q
          intro a b; induction b with j ihj
          · rw [pow_zero.nat, pow_zero.nat]
          · rw [succ_eq_add_one.nat, pow_succ.nat, pow_succ.nat, mul_mod.nat ((a % q) ^ j) (a % q) q, ihj, zmod.mod_mod a q, ← mul_mod.nat (a ^ j) a q]
        set inv_z := (rz ^ p) ^ (m - 1) with hinv_def
        have hinv_m : (inv_z ^ m) % q = 1
          have hswap : inv_z ^ m = ((rz ^ p) ^ m) ^ (m - 1)
            rw [hinv_def, ← nat.pow_mul_swap m (m - 1) (rz ^ p), ← nat.pow_mul_swap (m - 1) m (rz ^ p)]
            have hc : (m - 1) * m = m * (m - 1) := by ring
            rw [hc]
          rw [hswap, ← hpow_mod_base ((rz ^ p) ^ m) (m - 1), hzp_m, nat.one_pow_eq (m - 1), h1q]
        have hrz_inv : (rz ^ p * inv_z) % q = 1
          have hm1 : m = (m - 1) + 1 := by omega
          have hp1 : rz ^ p * inv_z = (rz ^ p) ^ m
            calc rz ^ p * inv_z = (rz ^ p) ^ (m - 1) * rz ^ p := by rw [hinv_def]; ring
              _ = (rz ^ p) ^ ((m - 1) + 1) := (pow_succ.nat (rz ^ p) (m - 1)).symm
              _ = (rz ^ p) ^ m := by rw [← hm1]
          rw [hp1]; exact hzp_m
        set t := (rx ^ p * inv_z) % q with ht_def
        set s := (ry ^ p * inv_z) % q with hs_def
        have ht_lt : t < q := by rw [ht_def]; exact mod_lt.nat _ q hq_pos
        have hs_lt : s < q := by rw [hs_def]; exact mod_lt.nat _ q hq_pos
        have ht_m : (t ^ m) % q = 1
          rw [ht_def, hpow_mod_base (rx ^ p * inv_z) m, nat.mul_pow_eq m (rx ^ p) inv_z,
              mul_mod.nat ((rx ^ p) ^ m) (inv_z ^ m) q, hxp_m, hinv_m, one_mul.nat, h1q]
        have hs_m : (s ^ m) % q = 1
          rw [hs_def, hpow_mod_base (ry ^ p * inv_z) m, nat.mul_pow_eq m (ry ^ p) inv_z,
              mul_mod.nat ((ry ^ p) ^ m) (inv_z ^ m) q, hyp_m, hinv_m, one_mul.nat, h1q]
        have ht_nz : t ≠ 0
          intro h0; rw [h0] at ht_m
          have hm1 : m = (m - 1) + 1 := by omega
          rw [hm1, pow_succ.nat 0 (m - 1), mul_zero.nat, h0q] at ht_m; omega
        have hs_nz : s ≠ 0
          intro h0; rw [h0] at hs_m
          have hm1 : m = (m - 1) + 1 := by omega
          rw [hm1, pow_succ.nat 0 (m - 1), mul_zero.nat, h0q] at hs_m; omega
        have hts1_0 : ((t + 1) + s) % q = 0
          have hc : (t + 1) + s = t + s + 1 := by omega
          rw [hc]
          have hdist : (rx ^ p + ry ^ p + rz ^ p) * inv_z = rx ^ p * inv_z + ry ^ p * inv_z + rz ^ p * inv_z := by ring
          have hm0 : ((rx ^ p + ry ^ p + rz ^ p) * inv_z) % q = 0
            rw [mul_mod.nat (rx ^ p + ry ^ p + rz ^ p) inv_z q, hsum_mod0, zero_mul.nat, h0q]
          rw [hdist, add_mod.nat (rx ^ p * inv_z + ry ^ p * inv_z) (rz ^ p * inv_z) q,
              add_mod.nat (rx ^ p * inv_z) (ry ^ p * inv_z) q, ← ht_def, ← hs_def, hrz_inv] at hm0
          rw [← h1q, ← add_mod.nat (t + s) 1 q] at hm0
          exact hm0
        -- Note `t + 1 < q` (if `t + 1 = q`, then `((t + 1) + s) % q = (q + s) % q = s != 0`):
        have htp1_lt : t + 1 < q
          by_contra hge
          have heq_q : t + 1 = q := by omega
          rw [heq_q] at hts1_0
          have hqs : (q + s) % q = s
            have he : q + s = s + q * 1 := by ring
            rw [he, add_mul_mod.nat s 1 q, (div_mod_of_lt.nat s q hs_lt).2]
          rw [hqs] at hts1_0; exact hs_nz hts1_0
        have htp1_mod : (t + 1) % q = t + 1 := (div_mod_of_lt.nat (t + 1) q htp1_lt).2
        have htp1_nz : (t + 1) % q ≠ 0 := by rw [htp1_mod]; omega
        -- Since `0 < (t + 1) + s < 2 * q` and `((t + 1) + s) % q = 0`, `(t + 1) + s = q`, i.e., `t + 1 = q - s`!
        have hsum_eq_q : (t + 1) + s = q
          obtain ⟨kd, hkd⟩ := (dvd.iff_exists q ((t + 1) + s) hq_pos).mp hts1_0
          by_cases hk0 : kd = 0
          · rw [hk0] at hkd; omega
          · by_cases hk1 : kd = 1
            · rw [hk1] at hkd; omega
            · have hm2 := mul_le_mul_of_nonneg_right.nat 2 kd q (by omega) (by omega)
              have hc : q * kd = kd * q := by ring
              omega
        have htp1_qs : t + 1 = q - s := by omega
        have htp1_m : (((t + 1) % q) ^ m) % q = 1
          rw [htp1_mod, htp1_qs, hm_2k, cshell.neg_mod_even_pow q s km hq_pos (by omega), ← hm_2k]
          exact hs_m
        obtain hadj0 | hadj_ne := hno_adj t ht_lt ht_nz (by rw [zmod.pow_mod_eq]; exact ht_m)
        · exact htp1_nz hadj0
        · rw [zmod.pow_mod_eq] at hadj_ne; exact hadj_ne htp1_m

-- Helper for p = 3 (`flt.exp_three` lifts directly to signed Z-triples):
+ cshell.signed_exp_three (x y z : ℤ) (heq : x ^ 3 + y ^ 3 + z ^ 3 = 0)
    (hx : x ≠ 0) (hy : y ≠ 0) (hz : z ≠ 0) : False
  set nx := nat_of_int (|x|) with hnx_def
  set ny := nat_of_int (|y|) with hny_def
  set nz := nat_of_int (|z|) with hnz_def
  have hnx : (nx : ℤ) = |x| := by rw [hnx_def]; exact int_of_nat_of_int (|x|) (abs_nonneg.int x)
  have hny : (ny : ℤ) = |y| := by rw [hny_def]; exact int_of_nat_of_int (|y|) (abs_nonneg.int y)
  have hnz : (nz : ℤ) = |z| := by rw [hnz_def]; exact int_of_nat_of_int (|z|) (abs_nonneg.int z)
  have hnx_pos : 0 < nx := by by_contra h0; have hz0 : nx = 0 := by omega; rw [hz0, cast_zero.int] at hnx; obtain ⟨e, _⟩ | ⟨e, _⟩ := abs_cases.int x <;> omega
  have hny_pos : 0 < ny := by by_contra h0; have hz0 : ny = 0 := by omega; rw [hz0, cast_zero.int] at hny; obtain ⟨e, _⟩ | ⟨e, _⟩ := abs_cases.int y <;> omega
  have hnz_pos : 0 < nz := by by_contra h0; have hz0 : nz = 0 := by omega; rw [hz0, cast_zero.int] at hnz; obtain ⟨e, _⟩ | ⟨e, _⟩ := abs_cases.int z <;> omega
  have hx_pm : x ^ 3 = (nx : ℤ) ^ 3 ∨ x ^ 3 = -((nx : ℤ) ^ 3)
    obtain ⟨e, _⟩ | ⟨e, _⟩ := abs_cases.int x
    · left; have ex : x = (nx : ℤ) := by linarith; rw [ex]
    · right; have ex : x = -(nx : ℤ) := by linarith; rw [ex]; ring
  have hy_pm : y ^ 3 = (ny : ℤ) ^ 3 ∨ y ^ 3 = -((ny : ℤ) ^ 3)
    obtain ⟨e, _⟩ | ⟨e, _⟩ := abs_cases.int y
    · left; have ey : y = (ny : ℤ) := by linarith; rw [ey]
    · right; have ey : y = -(ny : ℤ) := by linarith; rw [ey]; ring
  have hz_pm : z ^ 3 = (nz : ℤ) ^ 3 ∨ z ^ 3 = -((nz : ℤ) ^ 3)
    obtain ⟨e, _⟩ | ⟨e, _⟩ := abs_cases.int z
    · left; have ez : z = (nz : ℤ) := by linarith; rw [ez]
    · right; have ez : z = -(nz : ℤ) := by linarith; rw [ez]; ring
  have hpos3_x : (0 : ℤ) < (nx : ℤ) ^ 3 := by rw [← cast_pow.int nx 3]; exact (cast_pos.int (nx ^ 3)).mpr (pow_pos.nat nx 3 hnx_pos)
  have hpos3_y : (0 : ℤ) < (ny : ℤ) ^ 3 := by rw [← cast_pow.int ny 3]; exact (cast_pos.int (ny ^ 3)).mpr (pow_pos.nat ny 3 hny_pos)
  have hpos3_z : (0 : ℤ) < (nz : ℤ) ^ 3 := by rw [← cast_pow.int nz 3]; exact (cast_pos.int (nz ^ 3)).mpr (pow_pos.nat nz 3 hnz_pos)
  have hrefute : ∀ a b c : ℕ, 0 < a → 0 < b → (a : ℤ) ^ 3 + (b : ℤ) ^ 3 = (c : ℤ) ^ 3 → False
    intro a b c ha hb hc_eq
    exact flt.exp_three a b c ha hb ((cast_inj.int (a ^ 3 + b ^ 3) (c ^ 3)).mp (by rw [cast_add.int, cast_pow.int, cast_pow.int, cast_pow.int]; exact hc_eq))
  obtain hxp | hxn := hx_pm <;> obtain hyp | hyn := hy_pm <;> obtain hzp | hzn := hz_pm
  · linarith
  · exact hrefute nx ny nz hnx_pos hny_pos (by linarith)
  · exact hrefute nx nz ny hnx_pos hnz_pos (by linarith)
  · exact hrefute ny nz nx hny_pos hnz_pos (by linarith)
  · exact hrefute ny nz nx hny_pos hnz_pos (by linarith)
  · exact hrefute nx nz ny hnx_pos hnz_pos (by linarith)
  · exact hrefute nx ny nz hnx_pos hny_pos (by linarith)
  · linarith

-- Exhaustive decidable classification of all 28 odd primes 3 <= p <= 109:
+ cshell.odd_primes_le_109_list :
    ∀ p < 110, 3 ≤ p → (∀ d < p, 2 ≤ d → p % d ≠ 0) →
      (p = 3 ∨ p = 5 ∨ p = 7 ∨ p = 11 ∨ p = 13 ∨ p = 17 ∨ p = 19 ∨ p = 23 ∨
       p = 29 ∨ p = 31 ∨ p = 37 ∨ p = 41 ∨ p = 43 ∨ p = 47 ∨ p = 53 ∨ p = 59 ∨
       p = 61 ∨ p = 67 ∨ p = 71 ∨ p = 73 ∨ p = 79 ∨ p = 83 ∨ p = 89 ∨ p = 97 ∨
       p = 101 ∨ p = 103 ∨ p = 107 ∨ p = 109)
  decide

+ cshell.wendt_apply_at (p m q r : ℕ)
    (hp : is_prime_nat p) (hp5 : 5 ≤ p)
    (hm1 : 1 ≤ m) (hmev : m % 2 = 0)
    (hq2 : 2 ≤ q) (hq_eq : q = m * p + 1) (hqr : q < r * r)
    (hq_pr : ∀ d < r, 2 ≤ d → q % d ≠ 0)
    (hp_nm : zmod.pow_mod q p m ≠ 1)
    (hadj : ∀ t < q, t ≠ 0 → zmod.pow_mod q t m = 1 → (t + 1) % q = 0 ∨ zmod.pow_mod q ((t + 1) % q) m ≠ 1)
    (x y z : ℤ) (heq : x ^ p + y ^ p + z ^ p = 0)
    (hcxy : nat.coprime_primes (nat_of_int (|x|)) (nat_of_int (|y|)))
    (hcxz : nat.coprime_primes (nat_of_int (|x|)) (nat_of_int (|z|)))
    (hcyz : nat.coprime_primes (nat_of_int (|y|)) (nat_of_int (|z|)))
    (hnx : ¬ int_dvd p x) (hny : ¬ int_dvd p y) (hnz : ¬ int_dvd p z) : False
  have hq_is_pr : is_prime_nat q := is_prime_nat.of_sqrt_check q r hq2 hqr hq_pr
  exact cshell.wendt_aux_prime_case1 p m q hp hp5 hm1 hmev hq_is_pr hq_eq hp_nm hadj x y z heq hcxy hcxz hcyz hnx hny hnz

-- THEOREM 3B (COMPLETE 0-AXIOM CASE-I FLT FOR ALL 28 ODD PRIMES 3 <= p <= 109 — INCLUDING
-- THE FIRST FIVE IRREGULAR PRIMES p = 37, 59, 67, 101, 103 WHERE REGULAR KUMMER THEORY FAILS!):
+ cshell.first_case_all_primes_le_109 (p : ℕ) (hp : is_prime_nat p) (hp3 : 3 ≤ p) (hle : p ≤ 109)
    (x y z : ℤ) (heq : x ^ p + y ^ p + z ^ p = 0)
    (hcxy : nat.coprime_primes (nat_of_int (|x|)) (nat_of_int (|y|)))
    (hcxz : nat.coprime_primes (nat_of_int (|x|)) (nat_of_int (|z|)))
    (hcyz : nat.coprime_primes (nat_of_int (|y|)) (nat_of_int (|z|)))
    (hnx : ¬ int_dvd p x) (hny : ¬ int_dvd p y) (hnz : ¬ int_dvd p z) : False
  have hpr := (is_prime_nat.to_prime p hp).2
  have hcases := cshell.odd_primes_le_109_list p (by omega) hp3 hpr
  obtain hp_eq | hp_eq | hp_eq | hp_eq | hp_eq | hp_eq | hp_eq | hp_eq | hp_eq | hp_eq | hp_eq | hp_eq | hp_eq | hp_eq | hp_eq | hp_eq | hp_eq | hp_eq | hp_eq | hp_eq | hp_eq | hp_eq | hp_eq | hp_eq | hp_eq | hp_eq | hp_eq | hp_eq := hcases
  · rw [hp_eq] at heq hnx hny hnz
    have hx0 : x ≠ 0 := by intro h0; rw [h0] at hnx; exact hnx (cshell.dvd_zero 3)
    have hy0 : y ≠ 0 := by intro h0; rw [h0] at hny; exact hny (cshell.dvd_zero 3)
    have hz0 : z ≠ 0 := by intro h0; rw [h0] at hnz; exact hnz (cshell.dvd_zero 3)
    exact cshell.signed_exp_three x y z heq hx0 hy0 hz0
  · rw [hp_eq] at hp heq hnx hny hnz; exact cshell.wendt_apply_at 5 2 11 4 hp (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) x y z heq hcxy hcxz hcyz hnx hny hnz
  · rw [hp_eq] at hp heq hnx hny hnz; exact cshell.wendt_apply_at 7 4 29 6 hp (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) x y z heq hcxy hcxz hcyz hnx hny hnz
  · rw [hp_eq] at hp heq hnx hny hnz; exact cshell.wendt_apply_at 11 2 23 5 hp (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) x y z heq hcxy hcxz hcyz hnx hny hnz
  · rw [hp_eq] at hp heq hnx hny hnz; exact cshell.wendt_apply_at 13 4 53 8 hp (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) x y z heq hcxy hcxz hcyz hnx hny hnz
  · rw [hp_eq] at hp heq hnx hny hnz; exact cshell.wendt_apply_at 17 8 137 12 hp (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) x y z heq hcxy hcxz hcyz hnx hny hnz
  · rw [hp_eq] at hp heq hnx hny hnz; exact cshell.wendt_apply_at 19 10 191 14 hp (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) x y z heq hcxy hcxz hcyz hnx hny hnz
  · rw [hp_eq] at hp heq hnx hny hnz; exact cshell.wendt_apply_at 23 2 47 7 hp (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) x y z heq hcxy hcxz hcyz hnx hny hnz
  · rw [hp_eq] at hp heq hnx hny hnz; exact cshell.wendt_apply_at 29 2 59 8 hp (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) x y z heq hcxy hcxz hcyz hnx hny hnz
  · rw [hp_eq] at hp heq hnx hny hnz; exact cshell.wendt_apply_at 31 10 311 18 hp (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) x y z heq hcxy hcxz hcyz hnx hny hnz
  · rw [hp_eq] at hp heq hnx hny hnz; exact cshell.wendt_apply_at 37 4 149 13 hp (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) x y z heq hcxy hcxz hcyz hnx hny hnz
  · rw [hp_eq] at hp heq hnx hny hnz; exact cshell.wendt_apply_at 41 2 83 10 hp (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) x y z heq hcxy hcxz hcyz hnx hny hnz
  · rw [hp_eq] at hp heq hnx hny hnz; exact cshell.wendt_apply_at 43 4 173 14 hp (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) x y z heq hcxy hcxz hcyz hnx hny hnz
