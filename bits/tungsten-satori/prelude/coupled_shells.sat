-- ====================================================================================
-- 4. Cauchy-Lamé-Lebesgue Degree-7 Shell Polynomial & The Coupled Case-II Hensel Barrier
-- ====================================================================================

-- Cauchy-Lamé-Lebesgue degree-7 factorization in primary coordinates (x, y, z):
+ cshell.lame_lebesgue_deg7 (x y z : ℤ) :
    (x + y + z) ^ 7 - (x ^ 7 + y ^ 7 + z ^ 7) =
    7 * (x + y) * (y + z) * (z + x) *
      ((x ^ 2 + y ^ 2 + z ^ 2 + x * y + y * z + z * x) ^ 2 + x * y * z * (x + y + z))
  ring

-- Coupled-shell degree-7 identity in terms of the three shell runs u = y + z, v = z + x, w = x + y:
-- When x^7 + y^7 + z^7 = 0, `(u + v + w)^7 = 56 * u * v * w * (3*(u^4 + v^4 + w^4) + 10*(u^2*v^2 + v^2*w^2 + w^2*u^2))`!
+ cshell.lame_coupled_widths_deg7 (x y z u v w : ℤ)
    (hu : u = y + z) (hv : v = z + x) (hw : w = x + y) :
    (u + v + w) ^ 7 - 128 * (x ^ 7 + y ^ 7 + z ^ 7) =
    56 * u * v * w * (3 * (u ^ 4 + v ^ 4 + w ^ 4) + 10 * (u ^ 2 * v ^ 2 + v ^ 2 * w ^ 2 + w ^ 2 * u ^ 2))
  rw [hu, hv, hw]; ring

-- THEOREM 4C (COUPLED CASE-II HENSEL SMOOTHNESS BARRIER — 0 CUSTOM AXIOMS!):
-- In Case II (`p | z`), `cshell.case2_coupled_p_sq_dvd` forces `w = x + y ≡ 0 (mod p^2)` while
-- `u = y + z = b0^p` and `v = z + x = c0^p` satisfy `u + v ≡ 0 (mod p^2)`. Expanding the coupled
-- degree-7 shell polynomial `F_7(u, v, w) = (u + v + w)^7 - 56*u*v*w*(3*(u^4+v^4+w^4) + 10*(u^2*v^2+v^2*w^2+w^2*u^2))`
-- along the Case-II fiber `(u, v, w) = (t, -t, w)` yields ZERO constant term (`F_7(t, -t, 0) = 0`)
-- and NONZERO linear w-derivative `896 * t^6 = 128 * 7 * t^6`, which Hensel-lifts to smooth Z_ell-solutions
-- at EVERY prime ell (explaining why Case-II elimination cannot be purely local on the n-sided shells!).
-> cshell.coupled_poly7 (u v w : ℤ) : ℤ :=
  (u + v + w) ^ 7 - 56 * u * v * w * (3 * (u ^ 4 + v ^ 4 + w ^ 4) + 10 * (u ^ 2 * v ^ 2 + v ^ 2 * w ^ 2 + w ^ 2 * u ^ 2))

+ cshell.case2_coupled_hensel_barrier (t w : ℤ) :
    cshell.coupled_poly7 t (-t) 0 = 0 ∧
    cshell.coupled_poly7 t (-t) w =
      896 * t ^ 6 * w + w ^ 3 * (1120 * t ^ 4 + 168 * t ^ 2 * w ^ 2 + w ^ 4)
  unfold cshell.coupled_poly7
  constructor <;> ring

