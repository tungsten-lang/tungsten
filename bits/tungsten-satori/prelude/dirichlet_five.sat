      have hd := div_add_mod.nat b 2; rw [hb_odd_n] at hd
      have hc : ((2 * (b / 2) + 1 : ℕ) : ℤ) = (b : ℤ) := by rw [hd]
      rw [cast_add.int (2 * (b / 2)) 1, cast_mul.int 2 (b / 2), cast_one.int] at hc
      have h2c : ((2 : ℕ) : ℤ) = 2 := by decide; rw [h2c] at hc
      have he : (b : ℤ) = 1 + 2 * ((b / 2 : ℕ) : ℤ) := by linarith
      rw [he, add_mul_mod.int 1 _ 2 (by decide)]
      exact (div_mod_of_lt.int 1 2 (by decide) (by decide)).2
    obtain ⟨_, M, _, _, hM_eq⟩ := int.odd_quartic_div16 a (b : ℤ) ha_odd hb_odd_z
    set beta := GoldenInt.mk M ((b : ℤ) ^ 2) with hbeta_def
    have h2re_b : 2 * gi5.s5_re beta = a ^ 2 + 5 * (b : ℤ) ^ 2
      rw [hbeta_def]; unfold gi5.s5_re; simp; linarith
    have him_b : gi5.s5_im beta = (b : ℤ) ^ 2
      rw [hbeta_def]; unfold gi5.s5_im; simp
    have hnorm_b : gi5.norm beta = (t : ℤ) ^ 5
      have h4 := gi5.four_norm beta
      have h16 : 16 * gi5.norm beta = (2 * gi5.s5_re beta) ^ 2 - 20 * (gi5.s5_im beta) ^ 2 := by linarith
      rw [h2re_b, him_b] at h16
      have hid : (a ^ 2 + 5 * (b : ℤ) ^ 2) ^ 2 - 20 * ((b : ℤ) ^ 2) ^ 2 = a ^ 4 + 10 * a ^ 2 * (b : ℤ) ^ 2 + 5 * (b : ℤ) ^ 4 := by ring
      rw [hid, hquart_od] at h16; linarith
    have hb5_mod : beta.b % 5 = 0
      have hbb : beta.b = 0 + 5 * (5 * (qb5 : ℤ) * (qb5 : ℤ))
        rw [hbeta_def]; simp; rw [hqb5, cast_mul.int 5 qb5]
        have h5c : ((5 : ℕ) : ℤ) = 5 := by decide; rw [h5c]; ring
      rw [hbb, add_mul_mod.int 0 _ 5 (by decide)]
      exact (div_mod_of_lt.int 0 5 (by decide) (by decide)).2
    have hno_odd_p : ∀ p : ℕ, is_prime_nat p → 3 ≤ p → p ≠ 5 →
        ¬ (p ∣ nat_of_int (|gi5.s5_re beta|) ∧ p ∣ nat_of_int (|gi5.s5_im beta|))
      intro p hp hp3 hp5 hboth
      obtain ⟨hpre, hpim⟩ := hboth
      have him_nat : nat_of_int (|gi5.s5_im beta|) = b ^ 2
        apply (cast_inj.int (nat_of_int (|gi5.s5_im beta|)) (b ^ 2)).mp
        rw [nat_of_int_abs_eq (gi5.s5_im beta), him_b, cast_pow.int b 2]
