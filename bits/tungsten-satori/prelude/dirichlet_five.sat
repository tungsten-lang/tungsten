          have h5c : ((5 : ℕ) : ℤ) = 5 := by decide; rw [h5c]
          have ha4_nn : 0 ≤ a ^ 4 := by have s : a ^ 4 = (a ^ 2) * (a ^ 2) := by ring; rw [s]; nlinarith
          have hab_nn : 0 ≤ a ^ 2 * (b : ℤ) ^ 2 := mul_nonneg.int (a ^ 2) ((b : ℤ) ^ 2) (by nlinarith) (by nlinarith)
          linarith
        omega
      by_contra hge
      have hpow_ge := nat.pow_mono_base 5 t t' (by omega)
      omega
    have hquart_new : a2 ^ 4 + 10 * a2 ^ 2 * (b2 : ℤ) ^ 2 + 5 * (b2 : ℤ) ^ 4 = (t' : ℤ) ^ 5
      rw [hb2_eq_z, ← hQ2z_def, ← hQ2_eq_z, hQ2_split, cast_pow.int t' 5]
    use t'
    unfold dirichlet.state_at
    exact ⟨ht'_lt_t, ⟨ht'_pos, ht'_odd, ht'_nd5, ⟨a2, b2, 2 * mu + 1, 2 * nu - 1, r', ha2_odd, hb2_pos, by omega, hr'_pos, hb2_split, hcop_a2_b2, by left; exact ⟨by omega, hquart_new⟩⟩⟩⟩
  · -- ========================================================================
    -- BRANCH 2: mu = 0 (b is odd), a^4 + 10*a^2*b^2 + 5*b^4 = 16 * t^5
    -- ========================================================================
    have hb_odd_n : b % 2 = 1
      -- If b were even, since a is odd, a^4 + 10*a^2*b^2 + 5*b^4 would be ODD,
      -- which CANNOT equal 16 * t^5 (EVEN)!!
      by_contra hev
      have hb0 : b % 2 = 0 := by omega
      obtain ⟨kb, hkb⟩ := (dvd.iff_exists 2 b (by decide)).mp hb0
      have hd_a := div_add_mod.int a 2; rw [ha_odd] at hd_a
      set ka := a / 2
      have ha_2 : a = 2 * ka + 1 := by linarith
      have hb_2 : (b : ℤ) = 2 * (kb : ℤ)
        rw [hkb, cast_mul.int 2 kb]; have h2c : ((2 : ℕ) : ℤ) = 2 := by decide; rw [h2c]
      have hl_odd : (a ^ 4 + 10 * a ^ 2 * (b : ℤ) ^ 2 + 5 * (b : ℤ) ^ 4) % 2 = 1
        have hexp : a ^ 4 + 10 * a ^ 2 * (b : ℤ) ^ 2 + 5 * (b : ℤ) ^ 4 =
            1 + 2 * (8 * ka ^ 4 + 16 * ka ^ 3 + 12 * ka ^ 2 + 4 * ka + 20 * (2 * ka + 1) ^ 2 * (kb : ℤ) ^ 2 + 40 * (kb : ℤ) ^ 4)
          rw [ha_2, hb_2]; ring
        rw [hexp, add_mul_mod.int 1 _ 2 (by decide)]
        exact (div_mod_of_lt.int 1 2 (by decide) (by decide)).2
