-- Golden-Ratio Integers Z[phi] (phi^2 = phi + 1), Norm-Euclidean Division (16*|N(r)| <= 5*|N(b)|),
-- Bezout GCD, Coprime Fifth-Power Factorization, Mod-5 Pell Unit Fifth-Power Descent,
-- Dirichlet-Legendre (1825) Quartic Fifth-Power Infinite Descent, and Complete Unconditional Proof
-- of Fermat's Last Theorem for Exponent n = 5 (`flt.exp_five` + `flt.reduce_to_primes_ge_7`)!
--
-- ALL theorems proved unconditionally on Satori's untouched HOL kernel (0 custom axioms).

import eisenstein

-- ====================================================================================
-- 1. Golden-Ratio Integers Z[phi] (phi = (1 + sqrt(5))/2, phi^2 = phi + 1)
-- ====================================================================================

structure GoldenInt :=
  (a : ℤ)
  (b : ℤ)

+ gi5.eta (x : GoldenInt) : GoldenInt.mk x.a x.b = x
  induction x
  simp

+ gi5.ext (x y : GoldenInt) (ha : x.a = y.a) (hb : x.b = y.b) : x = y
  rw [← gi5.eta x, ← gi5.eta y, ha, hb]

-> gi5.zero    : GoldenInt := GoldenInt.mk 0 0
-> gi5.one     : GoldenInt := GoldenInt.mk 1 0
-> gi5.neg_one : GoldenInt := GoldenInt.mk (-1) 0
-> gi5.phi     : GoldenInt := GoldenInt.mk 0 1
-> gi5.sqrt5   : GoldenInt := GoldenInt.mk (-1) 2

-> gi5.of_int (n : ℤ) : GoldenInt := GoldenInt.mk n 0

-> gi5.add (x y : GoldenInt) : GoldenInt :=
  GoldenInt.mk (x.a + y.a) (x.b + y.b)

-> gi5.sub (x y : GoldenInt) : GoldenInt :=
  GoldenInt.mk (x.a - y.a) (x.b - y.b)

-> gi5.neg (x : GoldenInt) : GoldenInt :=
  GoldenInt.mk (-x.a) (-x.b)

-> gi5.mul (x y : GoldenInt) : GoldenInt :=
  GoldenInt.mk (x.a * y.a + x.b * y.b) (x.a * y.b + x.b * y.a + x.b * y.b)

-> gi5.conj (x : GoldenInt) : GoldenInt :=
  GoldenInt.mk (x.a + x.b) (-x.b)

-> gi5.norm (x : GoldenInt) : ℤ :=
  x.a * x.a + x.a * x.b - x.b * x.b

-- Coordinates in 2*z = s5_re(z) + s5_im(z)*sqrt(5):
-> gi5.s5_re (x : GoldenInt) : ℤ := 2 * x.a + x.b
-> gi5.s5_im (x : GoldenInt) : ℤ := x.b

-> gi5.fifth (x : GoldenInt) : GoldenInt :=
  gi5.mul x (gi5.mul (gi5.mul x x) (gi5.mul x x))

-> gi5.uinv (u : GoldenInt) : GoldenInt :=
  gi5.mul (gi5.of_int (gi5.norm u)) (gi5.conj u)

-> gi5.dvd (d x : GoldenInt) : Prop :=
  ∃ q : GoldenInt, x = gi5.mul d q

-> gi5.coprime (x y : GoldenInt) : Prop :=
  ∃ u v : GoldenInt, gi5.add (gi5.mul u x) (gi5.mul v y) = gi5.one

+ gi5.add_a (x y : GoldenInt) : (gi5.add x y).a = x.a + y.a := by unfold gi5.add; simp
+ gi5.add_b (x y : GoldenInt) : (gi5.add x y).b = x.b + y.b := by unfold gi5.add; simp
+ gi5.sub_a (x y : GoldenInt) : (gi5.sub x y).a = x.a - y.a := by unfold gi5.sub; simp
+ gi5.sub_b (x y : GoldenInt) : (gi5.sub x y).b = x.b - y.b := by unfold gi5.sub; simp
+ gi5.mul_a (x y : GoldenInt) : (gi5.mul x y).a = x.a * y.a + x.b * y.b := by unfold gi5.mul; simp
+ gi5.mul_b (x y : GoldenInt) : (gi5.mul x y).b = x.a * y.b + x.b * y.a + x.b * y.b := by unfold gi5.mul; simp
+ gi5.neg_a (x : GoldenInt) : (gi5.neg x).a = -x.a := by unfold gi5.neg; simp
+ gi5.neg_b (x : GoldenInt) : (gi5.neg x).b = -x.b := by unfold gi5.neg; simp

@[auto] + gi5.add_comm (x y : GoldenInt) : gi5.add x y = gi5.add y x
  apply gi5.ext <;> (unfold gi5.add; simp; ring)

+ gi5.add_zero_r (x : GoldenInt) : gi5.add x gi5.zero = x
  apply gi5.ext <;> (unfold gi5.add gi5.zero; simp)

@[auto] + gi5.mul_comm (x y : GoldenInt) : gi5.mul x y = gi5.mul y x
  apply gi5.ext <;> (unfold gi5.mul; simp; ring)

@[auto] + gi5.mul_assoc (x y z : GoldenInt) : gi5.mul (gi5.mul x y) z = gi5.mul x (gi5.mul y z)
  apply gi5.ext <;> (unfold gi5.mul; simp; ring)

+ gi5.mul_one_r (x : GoldenInt) : gi5.mul x gi5.one = x
  apply gi5.ext <;> (unfold gi5.mul gi5.one; simp)

@[auto] + gi5.mul_one_l (x : GoldenInt) : gi5.mul gi5.one x = x
  apply gi5.ext <;> (unfold gi5.mul gi5.one; simp)

+ gi5.mul_zero_r (x : GoldenInt) : gi5.mul x gi5.zero = gi5.zero
  apply gi5.ext <;> (unfold gi5.mul gi5.zero; simp)

@[auto] + gi5.mul_add_l (x y z : GoldenInt) : gi5.mul x (gi5.add y z) = gi5.add (gi5.mul x y) (gi5.mul x z)
  apply gi5.ext <;> (unfold gi5.mul gi5.add; simp; ring)

+ gi5.mul_sub_l (x y z : GoldenInt) : gi5.mul x (gi5.sub y z) = gi5.sub (gi5.mul x y) (gi5.mul x z)
  apply gi5.ext <;> (unfold gi5.mul gi5.sub; simp; ring)

+ gi5.mul_conj (x : GoldenInt) : gi5.mul x (gi5.conj x) = gi5.of_int (gi5.norm x)
  apply gi5.ext <;> (unfold gi5.mul gi5.conj gi5.of_int gi5.norm; simp; ring)

+ gi5.norm_mul (x y : GoldenInt) : gi5.norm (gi5.mul x y) = gi5.norm x * gi5.norm y
  unfold gi5.norm gi5.mul; simp; ring

+ gi5.norm_conj (x : GoldenInt) : gi5.norm (gi5.conj x) = gi5.norm x
  unfold gi5.norm gi5.conj; simp; ring

+ gi5.norm_neg (x : GoldenInt) : gi5.norm (gi5.neg x) = gi5.norm x
  unfold gi5.norm gi5.neg; simp; ring

+ gi5.four_norm (x : GoldenInt) :
    4 * gi5.norm x = gi5.s5_re x * gi5.s5_re x - 5 * (gi5.s5_im x * gi5.s5_im x)
  unfold gi5.norm gi5.s5_re gi5.s5_im; ring

+ gi5.fifth_mul (x y : GoldenInt) : gi5.fifth (gi5.mul x y) = gi5.mul (gi5.fifth x) (gi5.fifth y)
  apply gi5.ext <;> (unfold gi5.fifth; simp only [gi5.mul_a, gi5.mul_b]; ring)

+ gi5.fifth_neg (x : GoldenInt) : gi5.fifth (gi5.neg x) = gi5.neg (gi5.fifth x)
  apply gi5.ext <;> (unfold gi5.fifth; simp only [gi5.mul_a, gi5.mul_b, gi5.neg_a, gi5.neg_b]; ring)

+ gi5.norm_fifth (x : GoldenInt) : gi5.norm (gi5.fifth x) = (gi5.norm x) ^ 5
  unfold gi5.norm gi5.fifth; simp only [gi5.mul_a, gi5.mul_b]; ring

-- Exact sqrt(5) coordinates of z^5:
+ gi5.s5_fifth_coords (z : GoldenInt) :
    16 * gi5.s5_re (gi5.fifth z) =
      gi5.s5_re z * ((gi5.s5_re z) ^ 4 + 50 * (gi5.s5_re z) ^ 2 * (gi5.s5_im z) ^ 2 + 125 * (gi5.s5_im z) ^ 4) ∧
    16 * gi5.s5_im (gi5.fifth z) =
      5 * gi5.s5_im z * ((gi5.s5_re z) ^ 4 + 10 * (gi5.s5_re z) ^ 2 * (gi5.s5_im z) ^ 2 + 5 * (gi5.s5_im z) ^ 4)
  constructor
  · unfold gi5.s5_re gi5.s5_im gi5.fifth; simp only [gi5.mul_a, gi5.mul_b]; ring
  · unfold gi5.s5_re gi5.s5_im gi5.fifth; simp only [gi5.mul_a, gi5.mul_b]; ring

-- Irrationality of sqrt(5): A^2 = 5 * B^2 over Z forces A = 0 and B = 0!
+ int.sq_eq_five_sq_zero :
    ∀ n : ℕ, ∀ A B : ℤ, nat_of_int (|B|) = n → A * A = 5 * (B * B) → A = 0 ∧ B = 0
  apply nat.strong_induct (fun (n : ℕ) => ∀ A B : ℤ, nat_of_int (|B|) = n → A * A = 5 * (B * B) → A = 0 ∧ B = 0)
  intro n ih A B hBn heq
  by_cases hn0 : n = 0
  · have hBc : ((nat_of_int (|B|) : ℕ) : ℤ) = |B| := int_of_nat_of_int (|B|) (abs_nonneg.int B)
    rw [hBn, hn0, cast_zero.int] at hBc
    have hB0 : B = 0
      obtain ⟨e, _⟩ | ⟨e, _⟩ := abs_cases.int B <;> (rw [e] at hBc; linarith)
    rw [hB0] at heq
    have hA2 : A * A = 0 := by linarith
    have hA0 : A = 0
      by_contra hnz
      by_cases hp : 0 < A
      · have hm := mul_pos.int A A hp hp; linarith
      · have hm := mul_pos.int (-A) (-A) (by linarith) (by linarith); linarith
    exact ⟨hA0, hB0⟩
  · -- Show 5 | A by checking A % 5 in {0..4}:
    have hdA := div_add_mod.int A 5
    have hr_nn := mod_nonneg.int A 5 (by decide)
    have hr_lt := mod_lt.int A 5 (by decide)
    set qA := A / 5
    set rA := A % 5
    have hA_eq : A = 5 * qA + rA := by linarith
    have hr0 : rA = 0
      by_contra hnz
      have hrc : rA = 1 ∨ rA = 2 ∨ rA = 3 ∨ rA = 4 := by omega
      have hAA_mod : (A * A) % 5 = (5 * (B * B)) % 5 := by rw [heq]
      have hrhs0 : (5 * (B * B)) % 5 = 0
        have he : 5 * (B * B) = 0 + 5 * (B * B) := by ring
        rw [he, add_mul_mod.int 0 (B * B) 5 (by decide)]
        exact (div_mod_of_lt.int 0 5 (by decide) (by decide)).2
      rw [hrhs0] at hAA_mod
      obtain h1 | h2 | h3 | h4 := hrc
      · have hl : A * A = 1 + 5 * (5 * qA * qA + 2 * qA) := by rw [hA_eq, h1]; ring
        rw [hl, add_mul_mod.int 1 _ 5 (by decide)] at hAA_mod
        have hne : (1 : ℤ) % 5 ≠ 0 := by decide
        exact hne hAA_mod
      · have hl : A * A = 4 + 5 * (5 * qA * qA + 4 * qA) := by rw [hA_eq, h2]; ring
        rw [hl, add_mul_mod.int 4 _ 5 (by decide)] at hAA_mod
        have hne : (4 : ℤ) % 5 ≠ 0 := by decide
        exact hne hAA_mod
      · have hl : A * A = 4 + 5 * (5 * qA * qA + 6 * qA + 1) := by rw [hA_eq, h3]; ring
        rw [hl, add_mul_mod.int 4 _ 5 (by decide)] at hAA_mod
        have hne : (4 : ℤ) % 5 ≠ 0 := by decide
        exact hne hAA_mod
      · have hl : A * A = 1 + 5 * (5 * qA * qA + 8 * qA + 3) := by rw [hA_eq, h4]; ring
        rw [hl, add_mul_mod.int 1 _ 5 (by decide)] at hAA_mod
        have hne : (1 : ℤ) % 5 ≠ 0 := by decide
        exact hne hAA_mod
    have hA5 : A = 5 * qA := by linarith
    rw [hA5] at heq
    have hB_sq : B * B = 5 * (qA * qA) := by linarith
    have hBc : ((n : ℕ) : ℤ) = |B| := by rw [← hBn]; exact int_of_nat_of_int (|B|) (abs_nonneg.int B)
    have hB_abs_pos : 0 < |B|
      have hn_pos : (0 : ℤ) < (n : ℤ) := (cast_lt.int 0 n).mpr (by omega)
      linarith
    set n' := nat_of_int (|qA|) with hn'_def
    have hn'c : ((n' : ℕ) : ℤ) = |qA| := by rw [hn'_def]; exact int_of_nat_of_int (|qA|) (abs_nonneg.int qA)
    have habs_sq_B : |B| * |B| = B * B
      obtain ⟨e, _⟩ | ⟨e, _⟩ := abs_cases.int B
      · rw [e]
      · rw [e]; ring
    have habs_sq_q : |qA| * |qA| = qA * qA
      obtain ⟨e, _⟩ | ⟨e, _⟩ := abs_cases.int qA
      · rw [e]
      · rw [e]; ring
    have hn'_lt : n' < n
      by_contra hge
      have hge_z : (n : ℤ) ≤ (n' : ℤ) := (cast_le.int n n').mpr (by omega)
      rw [hBc, hn'c] at hge_z
      have hsq_le := mul_le_mul.int (|B|) (|qA|) (|B|) (|qA|) hge_z hge_z (by linarith) (abs_nonneg.int qA)
      rw [habs_sq_B, habs_sq_q] at hsq_le
      have hBB_pos : 0 < B * B := by rw [← habs_sq_B]; exact mul_pos.int (|B|) (|B|) hB_abs_pos hB_abs_pos
      linarith
    obtain ⟨hB0, hq0⟩ := ih n' hn'_lt B qA hn'_def.symm hB_sq
    exact ⟨by rw [hA5, hq0]; ring, hB0⟩

+ gi5.norm_eq_zero_iff (x : GoldenInt) : gi5.norm x = 0 ↔ x = gi5.zero
  constructor
  · intro hz
    have h4 := gi5.four_norm x
    rw [hz] at h4
    have hsq : gi5.s5_re x * gi5.s5_re x = 5 * (gi5.s5_im x * gi5.s5_im x) := by linarith
    obtain ⟨hre0, him0⟩ := int.sq_eq_five_sq_zero (nat_of_int (|gi5.s5_im x|)) (gi5.s5_re x) (gi5.s5_im x) rfl hsq
    unfold gi5.s5_re gi5.s5_im at hre0 him0
    have hxa0 : x.a = 0 := by linarith
    have hz_a : gi5.zero.a = 0 := by unfold gi5.zero; simp
    have hz_b : gi5.zero.b = 0 := by unfold gi5.zero; simp
    exact gi5.ext x gi5.zero (by linarith) (by linarith)
  · intro heq; rw [heq]; unfold gi5.norm gi5.zero; simp

+ gi5.abs_norm_pos_of_ne_zero (x : GoldenInt) (hne : x ≠ gi5.zero) : 0 < |gi5.norm x|
  have hnz : gi5.norm x ≠ 0
    intro hz; exact hne ((gi5.norm_eq_zero_iff x).mp hz)
  obtain ⟨e, _⟩ | ⟨e, _⟩ := abs_cases.int (gi5.norm x)
  · rw [e]; omega
  · rw [e]; omega

+ gi5.mul_cancel_left (c x y : GoldenInt) (hc : c ≠ gi5.zero) (heq : gi5.mul c x = gi5.mul c y) : x = y
  have hsub0 : gi5.mul c (gi5.sub x y) = gi5.zero
    rw [gi5.mul_sub_l, heq]
    apply gi5.ext <;> (unfold gi5.sub gi5.zero; simp; ring)
  have hn : gi5.norm (gi5.mul c (gi5.sub x y)) = 0 := (gi5.norm_eq_zero_iff _).mpr hsub0
  rw [gi5.norm_mul] at hn
  have hc_nz : gi5.norm c ≠ 0
    intro hz; exact hc ((gi5.norm_eq_zero_iff c).mp hz)
  have hd_nz : gi5.norm (gi5.sub x y) = 0
    by_contra hnz
    by_cases hcp : 0 < gi5.norm c
    · by_cases hdp : 0 < gi5.norm (gi5.sub x y)
      · linarith [mul_pos.int (gi5.norm c) (gi5.norm (gi5.sub x y)) hcp hdp]
      · linarith [mul_pos.int (gi5.norm c) (-gi5.norm (gi5.sub x y)) hcp (by omega)]
    · by_cases hdp : 0 < gi5.norm (gi5.sub x y)
      · linarith [mul_pos.int (-gi5.norm c) (gi5.norm (gi5.sub x y)) (by omega) hdp]
      · linarith [mul_pos.int (-gi5.norm c) (-gi5.norm (gi5.sub x y)) (by omega) (by omega)]
  have hd0 : gi5.sub x y = gi5.zero := (gi5.norm_eq_zero_iff (gi5.sub x y)).mp hd_nz
  have ha : (gi5.sub x y).a = 0 := by rw [hd0]; unfold gi5.zero; simp
  have hb : (gi5.sub x y).b = 0 := by rw [hd0]; unfold gi5.zero; simp
  unfold gi5.sub at ha hb; simp at ha hb
  exact gi5.ext x y (by linarith) (by linarith)

+ gi5.mul_uinv (u : GoldenInt) (hu : |gi5.norm u| = 1) :
    gi5.mul u (gi5.uinv u) = gi5.one ∧ gi5.mul (gi5.uinv u) u = gi5.one ∧ |gi5.norm (gi5.uinv u)| = 1
  have hsq : gi5.norm u * gi5.norm u = 1
    obtain ⟨e, _⟩ | ⟨e, _⟩ := abs_cases.int (gi5.norm u)
    · rw [e] at hu; rw [hu]; ring
    · have hnm1 : gi5.norm u = -1 := by linarith
      rw [hnm1]; ring
  have hm1 : gi5.mul u (gi5.uinv u) = gi5.one
    unfold gi5.uinv
    have hass : gi5.mul u (gi5.mul (gi5.of_int (gi5.norm u)) (gi5.conj u)) =
        gi5.mul (gi5.of_int (gi5.norm u)) (gi5.mul u (gi5.conj u))
      apply gi5.ext <;> (unfold gi5.mul gi5.of_int; simp; ring)
    rw [hass, gi5.mul_conj]
    apply gi5.ext <;> (unfold gi5.mul gi5.of_int gi5.one; simp [hsq])
  have hm2 : gi5.mul (gi5.uinv u) u = gi5.one := by rw [gi5.mul_comm]; exact hm1
  have hnu : |gi5.norm (gi5.uinv u)| = 1
    have heq : gi5.norm (gi5.uinv u) = gi5.norm u
      unfold gi5.uinv
      rw [gi5.norm_mul, gi5.norm_conj]
      have hns : gi5.norm (gi5.of_int (gi5.norm u)) = gi5.norm u * gi5.norm u := by unfold gi5.norm gi5.of_int; simp; ring
      rw [hns, hsq]; ring
    rw [heq]; exact hu
  exact ⟨hm1, hm2, hnu⟩

-- Constructive Norm-Euclidean Division in Z[phi]: 16 * |N(r)| <= 5 * |N(y)| < 16 * |N(y)|!
+ gi5.euclidean_div (x y : GoldenInt) (hy : y ≠ gi5.zero) :
    ∃ q r : GoldenInt, x = gi5.add (gi5.mul y q) r ∧ 16 * |gi5.norm r| ≤ 5 * |gi5.norm y| ∧ |gi5.norm r| < |gi5.norm y|
  have hy_pos : 0 < |gi5.norm y| := gi5.abs_norm_pos_of_ne_zero y hy
  set d := |gi5.norm y| with hd_def
  have hs_ex : ∃ s : ℤ, (s = 1 ∨ s = -1) ∧ s * gi5.norm y = d
    obtain ⟨ey, _⟩ | ⟨ey, _⟩ := abs_cases.int (gi5.norm y)
    · exact ⟨1, by left; decide, by rw [hd_def, ey]; ring⟩
    · exact ⟨-1, by right; decide, by rw [hd_def, ey]; ring⟩
  obtain ⟨s, hs_pm, hsd⟩ := hs_ex
  set cy := gi5.mul (gi5.of_int s) (gi5.conj y) with hcy_def
  set p := gi5.mul x cy with hp_def
  obtain ⟨qa, hahi, halo⟩ := int.nearest_quot p.a d hy_pos
  obtain ⟨qb, hbhi, hblo⟩ := int.nearest_quot p.b d hy_pos
  set q := GoldenInt.mk qa qb with hq_def
  set r := gi5.sub x (gi5.mul y q) with hr_def
  use q, r
  set u := p.a - qa * d with hu_def
  set v := p.b - qb * d with hv_def
  have hrc : gi5.mul r cy = GoldenInt.mk u v
    apply gi5.ext
    · rw [hr_def, hu_def, hp_def, hq_def, hcy_def, ← hsd]
      unfold gi5.mul gi5.sub gi5.conj gi5.of_int gi5.norm; simp; ring
    · rw [hr_def, hv_def, hp_def, hq_def, hcy_def, ← hsd]
      unfold gi5.mul gi5.sub gi5.conj gi5.of_int gi5.norm; simp; ring
  have hs2 : s * s = 1
    obtain h1 | hm1 := hs_pm
    · rw [h1]; ring
    · rw [hm1]; ring
  have hnm : gi5.norm r * d = s * (u * u + u * v - v * v)
    have hm := gi5.norm_mul r cy
    have hncy : gi5.norm cy = s * d
      rw [hcy_def, gi5.norm_mul, gi5.norm_conj]
      have hns : gi5.norm (gi5.of_int s) = s * s := by unfold gi5.norm gi5.of_int; simp; ring
      rw [hns]
      calc (s * s) * gi5.norm y = s * (s * gi5.norm y) := by ring
        _ = s * d := by rw [hsd]
    have hnuv : gi5.norm (GoldenInt.mk u v) = u * u + u * v - v * v := by unfold gi5.norm; simp
    rw [hncy, hrc, hnuv] at hm
    calc gi5.norm r * d = (s * s) * (gi5.norm r * d) := by rw [hs2]; ring
      _ = s * (gi5.norm r * (s * d)) := by ring
      _ = s * (u * u + u * v - v * v) := by rw [← hm]
  have hsu := int.sq_le_of_two_bounds u d hahi halo
  have hsv := int.sq_le_of_two_bounds v d hbhi hblo
  have hhi_16 : 16 * (u * u + u * v - v * v) ≤ 5 * (d * d)
    have hid : 16 * (u * u + u * v - v * v) = 5 * (4 * (u * u)) - (2 * u - 4 * v) * (2 * u - 4 * v) := by ring
    have hsq_nn : 0 ≤ (2 * u - 4 * v) * (2 * u - 4 * v) := by nlinarith
    linarith
  have hlo_16 : -16 * (u * u + u * v - v * v) ≤ 5 * (d * d)
    have hid : -16 * (u * u + u * v - v * v) = 5 * (4 * (v * v)) - (4 * u + 2 * v) * (4 * u + 2 * v) := by ring
    have hsq_nn : 0 ≤ (4 * u + 2 * v) * (4 * u + 2 * v) := by nlinarith
    linarith
  have habs_le : 16 * (|gi5.norm r| * d) ≤ 5 * (d * d)
    obtain ⟨er, _⟩ | ⟨er, _⟩ := abs_cases.int (gi5.norm r)
    · obtain hs1 | hsm1 := hs_pm
      · rw [er, hnm, hs1]; linarith
      · rw [er, hnm, hsm1]; linarith
    · obtain hs1 | hsm1 := hs_pm
      · rw [er]; have hn : (0 - gi5.norm r) * d = -(gi5.norm r * d) := by ring
        rw [hn, hnm, hs1]; linarith
      · rw [er]; have hn : (0 - gi5.norm r) * d = -(gi5.norm r * d) := by ring
        rw [hn, hnm, hsm1]; linarith
  have h16_5 : 16 * |gi5.norm r| ≤ 5 * d
    by_contra hgt
    have hm := mul_lt_mul_of_pos_right.int (5 * d) (16 * |gi5.norm r|) d (by linarith) hy_pos
    linarith
  have heq_r : x = gi5.add (gi5.mul y q) r
    rw [hr_def]; apply gi5.ext <;> (unfold gi5.add gi5.sub; simp; ring)
  have hlt_r : |gi5.norm r| < d := by linarith [abs_nonneg.int (gi5.norm r)]
  exact ⟨heq_r, h16_5, hlt_r⟩

-- ====================================================================================
-- 2. Bezout GCD & Coprime Fifth-Power Factorization in Z[phi]
-- ====================================================================================

-> gi5.bezout_at (N : ℕ) : Prop :=
  ∀ x y : GoldenInt, |gi5.norm y| ≤ (N : ℤ) →
    ∃ g u v : GoldenInt, gi5.dvd g x ∧ gi5.dvd g y ∧ g = gi5.add (gi5.mul u x) (gi5.mul v y)

+ gi5.bezout_gcd (a b : GoldenInt) :
    ∃ g u v : GoldenInt, gi5.dvd g a ∧ gi5.dvd g b ∧ g = gi5.add (gi5.mul u a) (gi5.mul v b)
  have hstrong : ∀ N : ℕ, gi5.bezout_at N
    intro N; induction N with M ihM
    · unfold gi5.bezout_at; intro x y hny
      have hy0 : y = gi5.zero
        by_contra hnz; linarith [gi5.abs_norm_pos_of_ne_zero y hnz]
      use x, gi5.one, gi5.zero
      exact ⟨⟨gi5.one, (gi5.mul_one_r x).symm⟩, ⟨gi5.zero, by rw [hy0, gi5.mul_zero_r]⟩, by rw [hy0, gi5.mul_one_l, gi5.mul_zero_r, gi5.add_zero_r]⟩
    · unfold gi5.bezout_at at ihM ⊢; intro x y hny
      rw [succ_eq_add_one.nat] at hny
      by_cases hy0 : y = gi5.zero
      · use x, gi5.one, gi5.zero
        exact ⟨⟨gi5.one, (gi5.mul_one_r x).symm⟩, ⟨gi5.zero, by rw [hy0, gi5.mul_zero_r]⟩, by rw [hy0, gi5.mul_one_l, gi5.mul_zero_r, gi5.add_zero_r]⟩
      · obtain ⟨q, r, heq, _, hrlt⟩ := gi5.euclidean_div x y hy0
        have hr_le : |gi5.norm r| ≤ (M : ℤ)
          rw [cast_add.int M 1, cast_one.int] at hny; omega
        obtain ⟨g, u1, v1, hgy, hgr, hbez⟩ := ihM y r hr_le
        use g, v1, gi5.sub u1 (gi5.mul v1 q)
        have hgx : gi5.dvd g x
          have hgy_u := hgy; have hgr_u := hgr
          unfold gi5.dvd at hgy_u hgr_u ⊢
          obtain ⟨ky, hky⟩ := hgy_u; obtain ⟨kr, hkr⟩ := hgr_u
          exact ⟨gi5.add (gi5.mul ky q) kr, by rw [heq, hky, hkr, gi5.mul_add_l, gi5.mul_assoc]⟩
        have hbez2 : g = gi5.add (gi5.mul v1 x) (gi5.mul (gi5.sub u1 (gi5.mul v1 q)) y)
          rw [hbez]
          have hra : r.a = x.a - (gi5.mul y q).a := by rw [heq]; unfold gi5.add; simp; ring
          have hrb : r.b = x.b - (gi5.mul y q).b := by rw [heq]; unfold gi5.add; simp; ring
          apply gi5.ext <;> (unfold gi5.add gi5.sub gi5.mul; simp; rw [hra, hrb]; unfold gi5.mul; simp; ring)
        exact ⟨hgx, hgy, hbez2⟩
  have hb_at := hstrong (nat_of_int (|gi5.norm b|))
  unfold gi5.bezout_at at hb_at
  exact hb_at a b (by rw [int_of_nat_of_int (|gi5.norm b|) (abs_nonneg.int (gi5.norm b))]; linarith)

+ gi5.coprime_symm (x y : GoldenInt) (h : gi5.coprime x y) : gi5.coprime y x
  unfold gi5.coprime at h ⊢
  obtain ⟨u, v, huv⟩ := h
  exact ⟨v, u, by rw [gi5.add_comm]; exact huv⟩

+ gi5.coprime_dvd_mul (a b c : GoldenInt) (hcop : gi5.coprime a b) (hdvd : gi5.dvd a (gi5.mul b c)) :
    gi5.dvd a c
  unfold gi5.coprime at hcop; unfold gi5.dvd at hdvd ⊢
  obtain ⟨u, v, huv⟩ := hcop; obtain ⟨q, hq⟩ := hdvd
  use gi5.add (gi5.mul u c) (gi5.mul v q)
  have hs1 : gi5.mul (gi5.add (gi5.mul u a) (gi5.mul v b)) c = gi5.add (gi5.mul (gi5.mul u a) c) (gi5.mul v (gi5.mul b c))
    apply gi5.ext <;> (unfold gi5.mul gi5.add; simp; ring)
  have hs2 : gi5.add (gi5.mul (gi5.mul u a) c) (gi5.mul v (gi5.mul a q)) = gi5.mul a (gi5.add (gi5.mul u c) (gi5.mul v q))
    apply gi5.ext <;> (unfold gi5.mul gi5.add; simp; ring)
  calc c = gi5.mul gi5.one c := (gi5.mul_one_l c).symm
    _ = gi5.mul (gi5.add (gi5.mul u a) (gi5.mul v b)) c := by rw [← huv]
    _ = gi5.add (gi5.mul (gi5.mul u a) c) (gi5.mul v (gi5.mul b c)) := hs1
    _ = gi5.add (gi5.mul (gi5.mul u a) c) (gi5.mul v (gi5.mul a q)) := by rw [hq]
    _ = gi5.mul a (gi5.add (gi5.mul u c) (gi5.mul v q)) := hs2

+ gi5.coprime_mul_r (a b c : GoldenInt) (hab : gi5.coprime a b) (hac : gi5.coprime a c) :
    gi5.coprime a (gi5.mul b c)
  unfold gi5.coprime at hab hac ⊢
  obtain ⟨u1, v1, h1⟩ := hab; obtain ⟨u2, v2, h2⟩ := hac
  use gi5.add (gi5.mul u1 (gi5.add (gi5.mul u2 a) (gi5.mul v2 c))) (gi5.mul (gi5.mul v1 b) u2), gi5.mul v1 v2
  have hprod : gi5.mul (gi5.add (gi5.mul u1 a) (gi5.mul v1 b)) (gi5.add (gi5.mul u2 a) (gi5.mul v2 c)) = gi5.one
    rw [h1, h2, gi5.mul_one_l]
  have hid : gi5.add (gi5.mul (gi5.add (gi5.mul u1 (gi5.add (gi5.mul u2 a) (gi5.mul v2 c))) (gi5.mul (gi5.mul v1 b) u2)) a) (gi5.mul (gi5.mul v1 v2) (gi5.mul b c))
      = gi5.mul (gi5.add (gi5.mul u1 a) (gi5.mul v1 b)) (gi5.add (gi5.mul u2 a) (gi5.mul v2 c))
    apply gi5.ext <;> (simp only [gi5.add_a, gi5.add_b, gi5.mul_a, gi5.mul_b]; ring)
  rw [hid, hprod]

+ gi5.coprime_fifth_l (p x : GoldenInt) (h : gi5.coprime p x) : gi5.coprime (gi5.fifth p) x
  apply gi5.coprime_symm
  unfold gi5.fifth
  have hs := gi5.coprime_symm p x h
  have h2 := gi5.coprime_mul_r x p p hs hs
  have h4 := gi5.coprime_mul_r x (gi5.mul p p) (gi5.mul p p) h2 h2
  exact gi5.coprime_mul_r x p _ hs h4

+ gi5.coprime_of_dvd_left (d a b : GoldenInt) (hd : gi5.dvd d a) (hcop : gi5.coprime a b) :
    gi5.coprime d b
  unfold gi5.dvd at hd; unfold gi5.coprime at hcop ⊢
  obtain ⟨q, hq⟩ := hd; obtain ⟨u, v, huv⟩ := hcop
  use gi5.mul u q, v
  rw [hq] at huv
  have hassoc : gi5.mul (gi5.mul u q) d = gi5.mul u (gi5.mul d q)
    apply gi5.ext <;> (unfold gi5.mul; simp; ring)
  rw [hassoc, huv]

-> gi5.has_proper_div_norm (g : GoldenInt) (d : ℕ) : Prop :=
  2 ≤ d ∧ ∃ pi : GoldenInt, gi5.dvd pi g ∧ |gi5.norm pi| = (d : ℤ)

+ gi5.abs_mul_eq (a b : ℤ) : |a * b| = |a| * |b|
  obtain ⟨ea, _⟩ | ⟨ea, _⟩ := abs_cases.int a
  · obtain ⟨eb, _⟩ | ⟨eb, _⟩ := abs_cases.int b
    · have hp : 0 ≤ a * b := by nlinarith
      obtain ⟨eab, _⟩ | ⟨_, hneg⟩ := abs_cases.int (a * b); (rw [eab, ea, eb]); linarith
    · have hn : a * b ≤ 0 := by nlinarith
      obtain ⟨eab, hpos⟩ | ⟨eab, _⟩ := abs_cases.int (a * b)
      · have hz : a * b = 0 := by linarith
        rw [eab, hz, ea, eb]; nlinarith
      · rw [eab, ea, eb]; ring
  · obtain ⟨eb, _⟩ | ⟨eb, _⟩ := abs_cases.int b
    · have hn : a * b ≤ 0 := by nlinarith
      obtain ⟨eab, hpos⟩ | ⟨eab, _⟩ := abs_cases.int (a * b)
      · have hz : a * b = 0 := by linarith
        rw [eab, hz, ea, eb]; nlinarith
      · rw [eab, ea, eb]; ring
    · have hp : 0 ≤ a * b := by nlinarith
      obtain ⟨eab, _⟩ | ⟨_, hneg⟩ := abs_cases.int (a * b); (rw [eab, ea, eb]; ring); linarith

-- Coprime two-factor fifth-power theorem in Z[phi]:
-- If coprime x1 x2 and x1 * x2 = u * g^5 (|N(u)| = 1, g != 0), then x1 = u1 * a1^5 with |N(u1)| = 1!
+ gi5.coprime_mul_eq_unit_fifth :
    ∀ n : ℕ, ∀ g : GoldenInt, g ≠ gi5.zero → |gi5.norm g| = (n : ℤ) →
      ∀ x1 x2 u : GoldenInt,
        |gi5.norm u| = 1 →
        gi5.coprime x1 x2 →
        gi5.mul x1 x2 = gi5.mul u (gi5.fifth g) →
        ∃ u1 a1 : GoldenInt, |gi5.norm u1| = 1 ∧ x1 = gi5.mul u1 (gi5.fifth a1)
  apply nat.strong_induct (fun (n : ℕ) => ∀ g : GoldenInt, g ≠ gi5.zero → |gi5.norm g| = (n : ℤ) → ∀ x1 x2 u : GoldenInt, |gi5.norm u| = 1 → gi5.coprime x1 x2 → gi5.mul x1 x2 = gi5.mul u (gi5.fifth g) → ∃ u1 a1 : GoldenInt, |gi5.norm u1| = 1 ∧ x1 = gi5.mul u1 (gi5.fifth a1))
  intro n ih g hgnz hng x1 x2 u hnu hcop hprod
  have hng_pos : 0 < |gi5.norm g| := gi5.abs_norm_pos_of_ne_zero g hgnz
  by_cases hn1 : n ≤ 1
  · have hn_eq1 : |gi5.norm g| = 1
      have hc : (n : ℤ) ≤ 1 := (cast_le.int n 1).mpr hn1
      linarith
    have hnx_prod : |gi5.norm x1| * |gi5.norm x2| = 1
      have h1 : |gi5.norm (gi5.mul x1 x2)| = |gi5.norm (gi5.mul u (gi5.fifth g))| := by rw [hprod]
      rw [gi5.norm_mul, gi5.abs_mul_eq, gi5.norm_mul, gi5.abs_mul_eq, hnu, gi5.norm_fifth] at h1
      have hg5_1 : |(gi5.norm g) ^ 5| = 1
        obtain ⟨eg, _⟩ | ⟨eg, _⟩ := abs_cases.int (gi5.norm g)
        · have hp : gi5.norm g = 1 := by linarith
          rw [hp]; decide
        · have hm : gi5.norm g = -1 := by linarith
          rw [hm]; decide
      rw [hg5_1] at h1; linarith
    have hx1_nn := abs_nonneg.int (gi5.norm x1)
    have hx2_nn := abs_nonneg.int (gi5.norm x2)
    have hnx1 : |gi5.norm x1| = 1
      by_contra hne
      by_cases hz : |gi5.norm x1| = 0
      · rw [hz] at hnx_prod; linarith
      · have hge2 : 2 ≤ |gi5.norm x1| := by omega
        by_cases hz2 : |gi5.norm x2| = 0
        · rw [hz2] at hnx_prod; linarith
        · have hm := mul_le_mul_of_nonneg_left.int 1 (|gi5.norm x2|) (|gi5.norm x1|) (by omega) (by omega)
          linarith
    have hf1 : gi5.fifth gi5.one = gi5.one := by apply gi5.ext <;> (unfold gi5.fifth gi5.mul gi5.one; simp)
    exact ⟨x1, gi5.one, hnx1, by rw [hf1, gi5.mul_one_r]⟩
  · have hex_d : ∃ d : ℕ, gi5.has_proper_div_norm g d
      use n; unfold gi5.has_proper_div_norm; exact ⟨by omega, ⟨g, ⟨gi5.one, (gi5.mul_one_r g).symm⟩, hng⟩⟩
    obtain ⟨d0, hd0P, hd0_min⟩ := nat.exists_least (gi5.has_proper_div_norm g) hex_d
    unfold gi5.has_proper_div_norm at hd0P
    obtain ⟨hd0_ge2, pi, hpi_dvd_g, hnpi⟩ := hd0P
    unfold gi5.dvd at hpi_dvd_g
    obtain ⟨g', hg'⟩ := hpi_dvd_g
    have hpi_nz : pi ≠ gi5.zero
      intro hz; rw [hz] at hnpi; unfold gi5.norm gi5.zero at hnpi; simp at hnpi
      have hc : (2 : ℤ) ≤ (d0 : ℤ) := (cast_le.int 2 d0).mpr hd0_ge2
      linarith
    have hg'_nz : g' ≠ gi5.zero
      intro hz; rw [hz, gi5.mul_zero_r] at hg'; exact hgnz hg'
    have hpi_cop_of_ndvd : ∀ z : GoldenInt, ¬ gi5.dvd pi z → gi5.coprime pi z
      intro z hnd
      obtain ⟨w, s, t, hwd_pi, hwd_z, hw_bez⟩ := gi5.bezout_gcd pi z
      unfold gi5.dvd at hwd_pi hwd_z
      obtain ⟨q_pi, hq_pi⟩ := hwd_pi
      have hnw_pos : 0 < |gi5.norm w|
        apply gi5.abs_norm_pos_of_ne_zero w
        intro hw0; rw [hw0, gi5.mul_comm gi5.zero q_pi, gi5.mul_zero_r] at hq_pi; exact hpi_nz hq_pi
      have hnq_pos : 0 < |gi5.norm q_pi|
        apply gi5.abs_norm_pos_of_ne_zero q_pi
        intro hq0; rw [hq0, gi5.mul_zero_r] at hq_pi; exact hpi_nz hq_pi
      have hnpi_prod : (d0 : ℤ) = |gi5.norm w| * |gi5.norm q_pi|
        rw [← hnpi, hq_pi, gi5.norm_mul, gi5.abs_mul_eq]
      have hnq_ne1 : |gi5.norm q_pi| ≠ 1
        intro hq1; apply hnd; unfold gi5.dvd
        obtain ⟨kz, hkz⟩ := hwd_z
        use gi5.mul (gi5.uinv q_pi) kz
        have hunit := (gi5.mul_uinv q_pi hq1).1
        calc z = gi5.mul w kz := hkz
          _ = gi5.mul (gi5.mul w gi5.one) kz := by rw [gi5.mul_one_r]
          _ = gi5.mul (gi5.mul w (gi5.mul q_pi (gi5.uinv q_pi))) kz := by rw [hunit]
          _ = gi5.mul pi (gi5.mul (gi5.uinv q_pi) kz) := by rw [← gi5.mul_assoc w q_pi, ← hq_pi, gi5.mul_assoc]
      have hnw_eq1 : |gi5.norm w| = 1
        by_contra hnw_ne1
        have hnw_ge2 : 2 ≤ |gi5.norm w| := by omega
        have hnq_ge2 : 2 ≤ |gi5.norm q_pi| := by omega
        have hnw_c_raw : ((nat_of_int (|gi5.norm w|) : ℕ) : ℤ) = |gi5.norm w| := int_of_nat_of_int (|gi5.norm w|) (by omega)
        set nw := nat_of_int (|gi5.norm w|)
        have hnw_lt : nw < d0
          have hm := mul_le_mul_of_nonneg_left.int 2 (|gi5.norm q_pi|) (|gi5.norm w|) hnq_ge2 (by omega)
          exact (cast_lt.int nw d0).mp (by linarith)
        apply hd0_min nw hnw_lt
        unfold gi5.has_proper_div_norm
        have hnw2 : 2 ≤ nw := (cast_le.int 2 nw).mp (by linarith)
        exact ⟨hnw2, ⟨w, ⟨gi5.mul q_pi g', by rw [hg', hq_pi, gi5.mul_assoc]⟩, hnw_c_raw.symm⟩⟩
      unfold gi5.coprime
      use gi5.mul (gi5.uinv w) s, gi5.mul (gi5.uinv w) t
      have hunit := (gi5.mul_uinv w hnw_eq1).2.1
      have hdist_bez : gi5.add (gi5.mul (gi5.mul (gi5.uinv w) s) pi) (gi5.mul (gi5.mul (gi5.uinv w) t) z)
          = gi5.mul (gi5.uinv w) (gi5.add (gi5.mul s pi) (gi5.mul t z))
        apply gi5.ext <;> (unfold gi5.mul gi5.add; simp; ring)
      rw [hdist_bez, ← hw_bez, hunit]
    have hpi_dvd_prod : gi5.dvd pi (gi5.mul x1 x2)
      unfold gi5.dvd
      use gi5.mul u (gi5.mul (gi5.mul (gi5.mul pi pi) (gi5.mul pi pi)) (gi5.fifth g'))
      rw [hprod, hg', gi5.fifth_mul]
      unfold gi5.fifth
      apply gi5.ext <;> (simp only [gi5.mul_a, gi5.mul_b]; ring)
    have hng'_c : ((nat_of_int (|gi5.norm g'|) : ℕ) : ℤ) = |gi5.norm g'| := int_of_nat_of_int (|gi5.norm g'|) (abs_nonneg.int (gi5.norm g'))
    set ng' := nat_of_int (|gi5.norm g'|)
    have hng'_lt : ng' < n
      have hm : (n : ℤ) = (d0 : ℤ) * |gi5.norm g'| := by rw [← hng, hg', gi5.norm_mul, gi5.abs_mul_eq, hnpi]
      have hd0_2 : (2 : ℤ) ≤ (d0 : ℤ) := (cast_le.int 2 d0).mpr hd0_ge2
      have hg'_pos := gi5.abs_norm_pos_of_ne_zero g' hg'_nz
      have hge := mul_le_mul_of_nonneg_right.int 2 (d0 : ℤ) (|gi5.norm g'|) hd0_2 (by linarith)
      exact (cast_lt.int ng' n).mp (by linarith)
    have hpi5_nz : gi5.fifth pi ≠ gi5.zero
      intro hz
      have hn5 : |gi5.norm (gi5.fifth pi)| = (d0 : ℤ) ^ 5
        unfold gi5.fifth
        rw [gi5.norm_mul, gi5.abs_mul_eq, gi5.norm_mul, gi5.abs_mul_eq, gi5.norm_mul, gi5.abs_mul_eq, hnpi]
        ring
      have hn0' : |gi5.norm (gi5.fifth pi)| = 0 := by rw [hz]; unfold gi5.norm gi5.zero; simp
      rw [hn5, ← cast_pow.int d0 5] at hn0'
      have hd0_5 : 0 < d0 ^ 5 := pow_pos.nat d0 5 (by omega)
      have hc0 := (cast_lt.int 0 (d0 ^ 5)).mpr hd0_5
      linarith
    by_cases hd1 : gi5.dvd pi x1
    · -- Case 1: pi | x1 => pi^5 | x1!
      have hc_pi5_x2 : gi5.coprime (gi5.fifth pi) x2 :=
        gi5.coprime_fifth_l pi x2 (gi5.coprime_of_dvd_left pi x1 x2 hd1 hcop)
      have hpi5_dvd_x2x1 : gi5.dvd (gi5.fifth pi) (gi5.mul x2 x1)
        unfold gi5.dvd; use gi5.mul u (gi5.fifth g')
        rw [gi5.mul_comm x2 x1, hprod, hg', gi5.fifth_mul]
        apply gi5.ext <;> (simp only [gi5.mul_a, gi5.mul_b]; ring)
      obtain ⟨x1', hx1'⟩ := gi5.coprime_dvd_mul (gi5.fifth pi) x2 x1 hc_pi5_x2 hpi5_dvd_x2x1
      have hprod' : gi5.mul x1' x2 = gi5.mul u (gi5.fifth g')
        apply gi5.mul_cancel_left (gi5.fifth pi) hpi5_nz
        have hl : gi5.mul (gi5.fifth pi) (gi5.mul x1' x2) = gi5.mul x1 x2
          rw [hx1']; apply gi5.ext <;> (simp only [gi5.mul_a, gi5.mul_b]; ring)
        have hr : gi5.mul (gi5.fifth pi) (gi5.mul u (gi5.fifth g')) = gi5.mul u (gi5.fifth g)
          rw [hg', gi5.fifth_mul]; apply gi5.ext <;> (simp only [gi5.mul_a, gi5.mul_b]; ring)
        rw [hl, hr, hprod]
      have hd_x1' : gi5.dvd x1' x1 := ⟨gi5.fifth pi, by rw [hx1', gi5.mul_comm]⟩
      have hc1'2 : gi5.coprime x1' x2 := gi5.coprime_of_dvd_left x1' x1 x2 hd_x1' hcop
      obtain ⟨u1, a1', hu1, he1⟩ := ih ng' hng'_lt g' hg'_nz hng'_c.symm x1' x2 u hnu hc1'2 hprod'
      use u1, gi5.mul pi a1'
      exact ⟨hu1, by rw [hx1', he1, gi5.fifth_mul]; apply gi5.ext <;> (simp only [gi5.mul_a, gi5.mul_b]; ring)⟩
    · -- Case 2: ¬(pi | x1) => pi | x2 => pi^5 | x2!
      have hc_pi_x1 : gi5.coprime pi x1 := hpi_cop_of_ndvd x1 hd1
      have hc_pi5_x1 : gi5.coprime (gi5.fifth pi) x1 := gi5.coprime_fifth_l pi x1 hc_pi_x1
      have hpi5_dvd_x1x2 : gi5.dvd (gi5.fifth pi) (gi5.mul x1 x2)
        unfold gi5.dvd; use gi5.mul u (gi5.fifth g')
        rw [hprod, hg', gi5.fifth_mul]
        apply gi5.ext <;> (simp only [gi5.mul_a, gi5.mul_b]; ring)
      obtain ⟨x2', hx2'⟩ := gi5.coprime_dvd_mul (gi5.fifth pi) x1 x2 hc_pi5_x1 hpi5_dvd_x1x2
      have hprod' : gi5.mul x1 x2' = gi5.mul u (gi5.fifth g')
        apply gi5.mul_cancel_left (gi5.fifth pi) hpi5_nz
        have hl : gi5.mul (gi5.fifth pi) (gi5.mul x1 x2') = gi5.mul x1 x2
          rw [hx2']; apply gi5.ext <;> (simp only [gi5.mul_a, gi5.mul_b]; ring)
        have hr : gi5.mul (gi5.fifth pi) (gi5.mul u (gi5.fifth g')) = gi5.mul u (gi5.fifth g)
          rw [hg', gi5.fifth_mul]; apply gi5.ext <;> (simp only [gi5.mul_a, gi5.mul_b]; ring)
        rw [hl, hr, hprod]
      have hd_x2' : gi5.dvd x2' x2 := ⟨gi5.fifth pi, by rw [hx2', gi5.mul_comm]⟩
      have hc12' : gi5.coprime x1 x2' :=
        gi5.coprime_symm x2' x1 (gi5.coprime_of_dvd_left x2' x2 x1 hd_x2' (gi5.coprime_symm x1 x2 hcop))
      exact ih ng' hng'_lt g' hg'_nz hng'_c.symm x1 x2' u hnu hc12' hprod'

-- ====================================================================================
-- 3. Mod-5 Pell Unit Fifth-Power Descent & Universal Fifth-Root Extraction
-- ====================================================================================

-- Every fifth power in Z[phi] has phi-coordinate divisible by 5!
+ gi5.fifth_b_div5 (z : GoldenInt) : ∃ k : ℤ, (gi5.fifth z).b = 5 * k
  use z.a^4 * z.b + 2 * z.a^3 * z.b^2 + 4 * z.a^2 * z.b^3 + 3 * z.a * z.b^4 + z.b^5
  unfold gi5.fifth; simp only [gi5.mul_a, gi5.mul_b]; ring

-- Helper: 0 <= x, 0 <= y, x * x < y * y => x < y!
+ int.lt_of_sq_lt_sq_nonneg (x y : ℤ) (hx : 0 ≤ x) (hy : 0 ≤ y) (hlt : x * x < y * y) : x < y
  by_contra hge
  have hle : y ≤ x := by linarith
  have hm := mul_le_mul.int y x y x hle hle hy hx
  linarith

-- Pell fifth-power step bound: for b >= 5, A >= 0, and (A^2 - 5*b^2)^2 = 16, |11*b - 5*A| < 2*b!
+ gi5.pell_step_bound (A b : ℤ) (hb5 : 5 ≤ b) (hA0 : 0 ≤ A)
    (hpell : A * A - 5 * (b * b) = 4 ∨ A * A - 5 * (b * b) = -4) :
    -2 * b < 11 * b - 5 * A ∧ 11 * b - 5 * A < 2 * b
  have hb2_25 : 25 ≤ b * b := mul_le_mul.int 5 b 5 b hb5 hb5 (by decide) (by omega)
  have hlo_sq : (9 * b) * (9 * b) < (5 * A) * (5 * A)
    obtain hp4 | hm4 := hpell <;> nlinarith
  have hhi_sq : (5 * A) * (5 * A) < (13 * b) * (13 * b)
    obtain hp4 | hm4 := hpell <;> nlinarith
  have hlo := int.lt_of_sq_lt_sq_nonneg (9 * b) (5 * A) (by omega) (by omega) hlo_sq
  have hhi := int.lt_of_sq_lt_sq_nonneg (5 * A) (13 * b) (by omega) (by omega) hhi_sq
  constructor <;> linarith

-- Every unit u in Z[phi] (|N(u)| = 1) with u.b % 5 = 0 is a fifth power v^5 in Z[phi]!
+ gi5.unit_fifth_of_mod5 :
    ∀ n : ℕ, ∀ u : GoldenInt, |gi5.norm u| = 1 → nat_of_int (|u.b|) = n → u.b % 5 = 0 →
      ∃ v : GoldenInt, |gi5.norm v| = 1 ∧ u = gi5.fifth v
  apply nat.strong_induct (fun (n : ℕ) => ∀ u : GoldenInt, |gi5.norm u| = 1 → nat_of_int (|u.b|) = n → u.b % 5 = 0 → ∃ v : GoldenInt, |gi5.norm v| = 1 ∧ u = gi5.fifth v)
  intro n ih u hu hnb hmod5
  have hnc : ((n : ℕ) : ℤ) = |u.b| := by rw [← hnb]; exact int_of_nat_of_int (|u.b|) (abs_nonneg.int u.b)
  by_cases hn0 : n = 0
  · rw [hn0, cast_zero.int] at hnc
    have hb0 : u.b = 0
      obtain ⟨e, _⟩ | ⟨e, _⟩ := abs_cases.int u.b <;> (rw [e] at hnc; linarith)
    have hnorm_a : |u.a * u.a| = 1
      have hn_eq : gi5.norm u = u.a * u.a := by unfold gi5.norm; rw [hb0]; ring
      rw [← hn_eq]; exact hu
    have ha2 : u.a * u.a = 1
      obtain ⟨e, _⟩ | ⟨e, _⟩ := abs_cases.int (u.a * u.a)
      · rw [e] at hnorm_a; exact hnorm_a
      · exfalso; nlinarith
    by_cases hap : 0 < u.a
    · have ha1 : u.a = 1
        by_contra hne; have hge2 : 2 ≤ u.a := by omega
        linarith [mul_le_mul.int 2 u.a 2 u.a hge2 hge2 (by decide) (by omega)]
      use gi5.one
      have hu1 : u = gi5.one := gi5.ext u gi5.one ha1 hb0
      have hf1 : gi5.fifth gi5.one = gi5.one := by apply gi5.ext <;> (unfold gi5.fifth gi5.mul gi5.one; simp)
      exact ⟨by rw [← hu1]; exact hu, by rw [hu1, hf1]⟩
    · have ham1 : u.a = -1
        by_contra hne
        by_cases hz : u.a = 0; (rw [hz] at ha2; linarith)
        have hge2 : 2 ≤ -u.a := by omega
        linarith [mul_le_mul.int 2 (-u.a) 2 (-u.a) hge2 hge2 (by decide) (by omega)]
      use gi5.neg_one
      have hum1 : u = gi5.neg_one := gi5.ext u gi5.neg_one ham1 hb0
      have hfm1 : gi5.fifth gi5.neg_one = gi5.neg_one := by apply gi5.ext <;> (unfold gi5.fifth gi5.mul gi5.neg_one; simp)
      exact ⟨by rw [← hum1]; exact hu, by rw [hum1, hfm1]⟩
  · -- Reduce b < 0 to b > 0 by negating u; for b > 0, |b| >= 5 since b % 5 = 0!
    have hpos_step : ∀ w : GoldenInt, |gi5.norm w| = 1 → 0 < w.b → w.b = |u.b| → w.b % 5 = 0 →
        ∃ v : GoldenInt, |gi5.norm v| = 1 ∧ w = gi5.fifth v
      intro w hw hwb_pos hwb_eq hw_mod5
      have hd5 := div_add_mod.int w.b 5
      rw [hw_mod5] at hd5
      set qw := w.b / 5
      have hwb5 : 5 ≤ w.b
        have hq_pos : 1 ≤ qw := by omega
        omega
      have hpell : gi5.s5_re w * gi5.s5_re w - 5 * (w.b * w.b) = 4 ∨ gi5.s5_re w * gi5.s5_re w - 5 * (w.b * w.b) = -4
        have h4 := gi5.four_norm w
        unfold gi5.s5_im at h4
        obtain ⟨en, _⟩ | ⟨en, _⟩ := abs_cases.int (gi5.norm w)
        · rw [en] at hw; left; linarith
        · rw [en] at hw; right; linarith
      by_cases hre_nn : 0 ≤ gi5.s5_re w
      · -- Multiply w by (1 - phi)^5 = GoldenInt.mk 8 (-5); inverse of (1 - phi) is -phi = GoldenInt.mk 0 (-1)!
        set w' := gi5.mul w (gi5.fifth (GoldenInt.mk 1 (-1))) with hw'_def
        have hf_step : gi5.fifth (GoldenInt.mk 1 (-1)) = GoldenInt.mk 8 (-5) := by decide
        have hw'_b_2 : 2 * w'.b = 11 * w.b - 5 * gi5.s5_re w
          rw [hw'_def, hf_step]; unfold gi5.mul gi5.s5_re; simp; ring
        have hw'_mod5 : w'.b % 5 = 0
          have hb_f : w'.b = 3 * w.b + 5 * (-w.a) := by rw [hw'_def, hf_step]; unfold gi5.mul; simp; ring
          have hw5 : w.b = 5 * qw := by linarith
          have hb_f2 : w'.b = 0 + 5 * (3 * qw - w.a) := by rw [hb_f, hw5]; ring
          rw [hb_f2, add_mul_mod.int 0 _ 5 (by decide)]
          exact (div_mod_of_lt.int 0 5 (by decide) (by decide)).2
        obtain ⟨hlo, hhi⟩ := gi5.pell_step_bound (gi5.s5_re w) w.b hwb5 hre_nn hpell
        have habs_lt : |w'.b| < w.b
          obtain ⟨ew, _⟩ | ⟨ew, _⟩ := abs_cases.int w'.b <;> linarith
        have hn'_lt : nat_of_int (|w'.b|) < n
          have hc' := int_of_nat_of_int (|w'.b|) (abs_nonneg.int w'.b)
          exact (cast_lt.int (nat_of_int (|w'.b|)) n).mp (by linarith)
        have hnw' : |gi5.norm w'| = 1
          rw [hw'_def, gi5.norm_mul, gi5.abs_mul_eq, hw, hf_step]
          have hn85 : |gi5.norm (GoldenInt.mk 8 (-5))| = 1 := by decide
          rw [hn85]; ring
        obtain ⟨v', hv'n, hv'eq⟩ := ih (nat_of_int (|w'.b|)) hn'_lt w' hnw' rfl hw'_mod5
        use gi5.mul v' (GoldenInt.mk 0 (-1))
        have hinv_5 : gi5.mul (gi5.fifth (GoldenInt.mk 1 (-1))) (gi5.fifth (GoldenInt.mk 0 (-1))) = gi5.one := by decide
        have hnv : |gi5.norm (gi5.mul v' (GoldenInt.mk 0 (-1)))| = 1
          rw [gi5.norm_mul, gi5.abs_mul_eq, hv'n]
          have hn01 : |gi5.norm (GoldenInt.mk 0 (-1))| = 1 := by decide
          rw [hn01]; ring
        have hweq : w = gi5.fifth (gi5.mul v' (GoldenInt.mk 0 (-1)))
          calc w = gi5.mul w gi5.one := (gi5.mul_one_r w).symm
            _ = gi5.mul w (gi5.mul (gi5.fifth (GoldenInt.mk 1 (-1))) (gi5.fifth (GoldenInt.mk 0 (-1)))) := by rw [hinv_5]
            _ = gi5.mul w' (gi5.fifth (GoldenInt.mk 0 (-1))) := by rw [← gi5.mul_assoc, ← hw'_def]
            _ = gi5.mul (gi5.fifth v') (gi5.fifth (GoldenInt.mk 0 (-1))) := by rw [hv'eq]
            _ = gi5.fifth (gi5.mul v' (GoldenInt.mk 0 (-1))) := (gi5.fifth_mul v' _).symm
        exact ⟨hnv, hweq⟩
      · -- s5_re w < 0: multiply w by phi^5 = GoldenInt.mk 3 5; inverse of phi is phi - 1 = GoldenInt.mk (-1) 1!
        set w' := gi5.mul w (gi5.fifth (GoldenInt.mk 0 1)) with hw'_def
        have hf_step : gi5.fifth (GoldenInt.mk 0 1) = GoldenInt.mk 3 5 := by decide
        have hw'_b_2 : 2 * w'.b = 11 * w.b - 5 * (-gi5.s5_re w)
          rw [hw'_def, hf_step]; unfold gi5.mul gi5.s5_re; simp; ring
        have hw'_mod5 : w'.b % 5 = 0
          have hb_f : w'.b = 8 * w.b + 5 * w.a := by rw [hw'_def, hf_step]; unfold gi5.mul; simp; ring
          have hw5 : w.b = 5 * qw := by linarith
          have hb_f2 : w'.b = 0 + 5 * (8 * qw + w.a) := by rw [hb_f, hw5]; ring
          rw [hb_f2, add_mul_mod.int 0 _ 5 (by decide)]
          exact (div_mod_of_lt.int 0 5 (by decide) (by decide)).2
        have hpell_neg : (-gi5.s5_re w) * (-gi5.s5_re w) - 5 * (w.b * w.b) = 4 ∨ (-gi5.s5_re w) * (-gi5.s5_re w) - 5 * (w.b * w.b) = -4
          have hsq : (-gi5.s5_re w) * (-gi5.s5_re w) = gi5.s5_re w * gi5.s5_re w := by ring
          rw [hsq]; exact hpell
        obtain ⟨hlo, hhi⟩ := gi5.pell_step_bound (-gi5.s5_re w) w.b hwb5 (by linarith) hpell_neg
        have habs_lt : |w'.b| < w.b
          obtain ⟨ew, _⟩ | ⟨ew, _⟩ := abs_cases.int w'.b <;> linarith
        have hn'_lt : nat_of_int (|w'.b|) < n
          have hc' := int_of_nat_of_int (|w'.b|) (abs_nonneg.int w'.b)
          exact (cast_lt.int (nat_of_int (|w'.b|)) n).mp (by linarith)
        have hnw' : |gi5.norm w'| = 1
          rw [hw'_def, gi5.norm_mul, gi5.abs_mul_eq, hw, hf_step]
          have hn35 : |gi5.norm (GoldenInt.mk 3 5)| = 1 := by decide
          rw [hn35]; ring
        obtain ⟨v', hv'n, hv'eq⟩ := ih (nat_of_int (|w'.b|)) hn'_lt w' hnw' rfl hw'_mod5
        use gi5.mul v' (GoldenInt.mk (-1) 1)
        have hinv_5 : gi5.mul (gi5.fifth (GoldenInt.mk 0 1)) (gi5.fifth (GoldenInt.mk (-1) 1)) = gi5.one := by decide
        have hnv : |gi5.norm (gi5.mul v' (GoldenInt.mk (-1) 1))| = 1
          rw [gi5.norm_mul, gi5.abs_mul_eq, hv'n]
          have hn11 : |gi5.norm (GoldenInt.mk (-1) 1)| = 1 := by decide
          rw [hn11]; ring
        have hweq : w = gi5.fifth (gi5.mul v' (GoldenInt.mk (-1) 1))
          calc w = gi5.mul w gi5.one := (gi5.mul_one_r w).symm
            _ = gi5.mul w (gi5.mul (gi5.fifth (GoldenInt.mk 0 1)) (gi5.fifth (GoldenInt.mk (-1) 1))) := by rw [hinv_5]
            _ = gi5.mul w' (gi5.fifth (GoldenInt.mk (-1) 1)) := by rw [← gi5.mul_assoc, ← hw'_def]
            _ = gi5.mul (gi5.fifth v') (gi5.fifth (GoldenInt.mk (-1) 1)) := by rw [hv'eq]
            _ = gi5.fifth (gi5.mul v' (GoldenInt.mk (-1) 1)) := (gi5.fifth_mul v' _).symm
        exact ⟨hnv, hweq⟩
    have hn_pos : (0 : ℤ) < (n : ℤ) := (cast_lt.int 0 n).mpr (by omega)
    obtain ⟨eu, hub_nn⟩ | ⟨eu, hub_neg⟩ := abs_cases.int u.b
    · exact hpos_step u hu (by linarith) eu.symm hmod5
    · have hneg_norm : |gi5.norm (gi5.neg u)| = 1 := by rw [gi5.norm_neg]; exact hu
      have hneg_b : (gi5.neg u).b = -u.b := by unfold gi5.neg; simp
      have hneg_mod5 : (gi5.neg u).b % 5 = 0
        have hd5 := div_add_mod.int u.b 5; rw [hmod5] at hd5
        have hnb5 : (gi5.neg u).b = 0 + 5 * (-(u.b / 5)) := by rw [hneg_b]; linarith
        rw [hnb5, add_mul_mod.int 0 _ 5 (by decide)]
        exact (div_mod_of_lt.int 0 5 (by decide) (by decide)).2
      obtain ⟨v, hvn, hveq⟩ := hpos_step (gi5.neg u) hneg_norm (by linarith) (by linarith) hneg_mod5
      use gi5.neg v
      have hnn_u : gi5.neg (gi5.neg u) = u := by apply gi5.ext <;> (unfold gi5.neg; simp; ring)
      exact ⟨by rw [gi5.norm_neg]; exact hvn, by rw [← hnn_u, hveq, gi5.fifth_neg]⟩

-- ====================================================================================
-- 3B. Universal Conjugate-Coprimality, Fifth-Root Extraction & 2-5-Pow5 Splitter
-- ====================================================================================

+ is_prime_nat_five : is_prime_nat 5
  apply prime.to_is_prime_nat 5; unfold prime
  intro d hd1 hd2
  have hc : d = 2 ∨ d = 3 ∨ d = 4 := by omega
  obtain h | h | h := hc <;> rw [h] <;> decide

+ nat.dvd_of_mul_eq (d m n : ℕ) (hd : 0 < d) (heq : n = d * m) : d ∣ n
  exact (dvd.iff_exists d n hd).mpr ⟨m, heq⟩

+ nat.odd_prime_ne_two (p : ℕ) (hp : is_prime_nat p) (hn : ℕ) (hodd : hn % 2 = 1) (hdvd : p ∣ hn) : 3 ≤ p
  have hp2 : 2 ≤ p := hp.1
  by_contra hlt3
  have heq2 : p = 2 := by omega
  rw [heq2] at hdvd
  unfold dvd at hdvd; omega

+ nat_of_int_abs_eq (z : ℤ) : ((nat_of_int (|z|) : ℕ) : ℤ) = |z|
  exact int_of_nat_of_int (|z|) (abs_nonneg.int z)

+ int.sq_pos_of_nz (z : ℤ) (hz : z ≠ 0) : 0 < z * z
  by_cases hp : 0 < z
  · exact mul_pos.int z z hp hp
  · have hm := mul_pos.int (-z) (-z) (by omega) (by omega)
    have hsq : (-z) * (-z) = z * z := by ring
    rw [← hsq]; exact hm

+ gi5.coprime_conj_of_odd_norm (beta : GoldenInt) (t : ℕ)
    (hnorm : gi5.norm beta = (t : ℤ) ^ 5)
    (ht_pos : 1 ≤ t) (ht_odd : t % 2 = 1) (ht_nd5 : t % 5 ≠ 0)
    (hno_odd_p : ∀ p : ℕ, is_prime_nat p → 3 ≤ p → p ≠ 5 →
      ¬ (p ∣ nat_of_int (|gi5.s5_re beta|) ∧ p ∣ nat_of_int (|gi5.s5_im beta|))) :
    gi5.coprime beta (gi5.conj beta)
  obtain ⟨w, s, v, hwb, hwc, hbez⟩ := gi5.bezout_gcd beta (gi5.conj beta)
  unfold gi5.dvd at hwb hwc
  obtain ⟨qb, hqb⟩ := hwb
  obtain ⟨qc, hqc⟩ := hwc
  have ht5_pos : 0 < t ^ 5 := pow_pos.nat t 5 (by omega)
  have hbeta_nz : beta ≠ gi5.zero
    intro hz
    have hn0 : gi5.norm beta = 0 := (gi5.norm_eq_zero_iff beta).mpr hz
    rw [hnorm, ← cast_pow.int t 5] at hn0
    have hc := (cast_lt.int 0 (t ^ 5)).mpr ht5_pos
    linarith
  have hw_nz : w ≠ gi5.zero
    intro hz; rw [hz, gi5.mul_comm gi5.zero qb, gi5.mul_zero_r] at hqb; exact hbeta_nz hqb
  have hnw_pos_z : 0 < |gi5.norm w| := gi5.abs_norm_pos_of_ne_zero w hw_nz
  set nw := nat_of_int (|gi5.norm w|) with hnw_def
  have hnw_eq : (nw : ℤ) = |gi5.norm w| := by rw [hnw_def]; exact nat_of_int_abs_eq (gi5.norm w)
  have hnw_pos : 0 < nw
    by_contra h0; have hz : nw = 0 := by omega
    rw [hz, cast_zero.int] at hnw_eq; linarith
  have hnw_eq1 : nw = 1
    by_contra hne1
    have hnw2 : 2 ≤ nw := by omega
    set p := min_fac nw with hp_def
    have hsp := min_fac.spec nw hnw2
    have hp : is_prime_nat p := by rw [hp_def]; exact prime.to_is_prime_nat (min_fac nw) (min_fac.prime nw hnw2)
    have hp2 : 2 ≤ p := by rw [hp_def]; exact hsp.1
    have hp_nw : p ∣ nw := by rw [hp_def]; exact hsp.2.2.1
    -- Show nw | t^5:
    set nqb := nat_of_int (|gi5.norm qb|) with hnqb_def
    have hnqb_eq : (nqb : ℤ) = |gi5.norm qb| := by rw [hnqb_def]; exact nat_of_int_abs_eq (gi5.norm qb)
    have hprod_t5 : nw * nqb = t ^ 5
      apply (cast_inj.int (nw * nqb) (t ^ 5)).mp
      rw [cast_mul.int, cast_pow.int t 5, hnw_eq, hnqb_eq, ← gi5.abs_mul_eq, ← gi5.norm_mul, ← hqb, hnorm]
      have ht_nn : (0 : ℤ) ≤ (t : ℤ) ^ 5
        rw [← cast_pow.int t 5]; exact (cast_le.int 0 (t ^ 5)).mpr (by omega)
      obtain ⟨et, _⟩ | ⟨_, hneg⟩ := abs_cases.int ((t : ℤ) ^ 5); exact et; linarith
    have hp_t5 : p ∣ (t ^ 5) :=
      dvd.trans_nat p nw (t ^ 5) (by omega) hnw_pos hp_nw (nat.dvd_of_mul_eq nw nqb (t ^ 5) hnw_pos hprod_t5.symm)
    have hp_t : p ∣ t := prime_dvd_of_dvd_pow.nat p t 5 (is_prime_nat.to_prime p hp) hp_t5
    have hp3 : 3 ≤ p := nat.odd_prime_ne_two p hp t ht_odd hp_t
    have hp_ne5 : p ≠ 5
      intro he5; rw [he5] at hp_t; unfold dvd at hp_t; exact ht_nd5 hp_t
    -- Show nw divides (nat_of_int |s5_re beta|)^2 and 5 * (nat_of_int |s5_im beta|)^2:
    have hsum_eq : gi5.add beta (gi5.conj beta) = gi5.of_int (gi5.s5_re beta)
      apply gi5.ext <;> (unfold gi5.add gi5.conj gi5.of_int gi5.s5_re; simp; ring)
    have hw_sum : gi5.mul w (gi5.add qb qc) = gi5.of_int (gi5.s5_re beta)
      rw [gi5.mul_add_l, ← hqb, ← hqc, hsum_eq]
    set ksum := nat_of_int (|gi5.norm (gi5.add qb qc)|) with hksum_def
    have hksum_eq : (ksum : ℤ) = |gi5.norm (gi5.add qb qc)| := by rw [hksum_def]; exact nat_of_int_abs_eq (gi5.norm (gi5.add qb qc))
    set nre := nat_of_int (|gi5.s5_re beta|) with hnre_def
    have hnre_eq : (nre : ℤ) = |gi5.s5_re beta| := by rw [hnre_def]; exact nat_of_int_abs_eq (gi5.s5_re beta)
    have hre_sq : nw * ksum = nre ^ 2
      apply (cast_inj.int (nw * ksum) (nre ^ 2)).mp
      rw [cast_mul.int, cast_pow.int nre 2, hnw_eq, hksum_eq, hnre_eq, ← gi5.abs_mul_eq, ← gi5.norm_mul, hw_sum]
      have hns : gi5.norm (gi5.of_int (gi5.s5_re beta)) = (gi5.s5_re beta) * (gi5.s5_re beta)
        unfold gi5.norm gi5.of_int; simp; ring
      rw [hns, gi5.abs_mul_eq]; ring
    have hp_re2 : p ∣ (nre ^ 2) :=
      dvd.trans_nat p nw (nre ^ 2) (by omega) hnw_pos hp_nw (nat.dvd_of_mul_eq nw ksum (nre ^ 2) hnw_pos hre_sq.symm)
    have hp_re : p ∣ nre := prime_dvd_of_dvd_pow.nat p nre 2 (is_prime_nat.to_prime p hp) hp_re2
    have hdiff_eq : gi5.sub beta (gi5.conj beta) = gi5.mul gi5.sqrt5 (gi5.of_int (gi5.s5_im beta))
      apply gi5.ext <;> (unfold gi5.sub gi5.conj gi5.mul gi5.sqrt5 gi5.of_int gi5.s5_im; simp; ring)
    have hw_diff : gi5.mul w (gi5.sub qb qc) = gi5.mul gi5.sqrt5 (gi5.of_int (gi5.s5_im beta))
      rw [gi5.mul_sub_l, ← hqb, ← hqc, hdiff_eq]
    set kdiff := nat_of_int (|gi5.norm (gi5.sub qb qc)|) with hkdiff_def
    have hkdiff_eq : (kdiff : ℤ) = |gi5.norm (gi5.sub qb qc)| := by rw [hkdiff_def]; exact nat_of_int_abs_eq (gi5.norm (gi5.sub qb qc))
    set nim := nat_of_int (|gi5.s5_im beta|) with hnim_def
    have hnim_eq : (nim : ℤ) = |gi5.s5_im beta| := by rw [hnim_def]; exact nat_of_int_abs_eq (gi5.s5_im beta)
    have him_sq : nw * kdiff = 5 * (nim ^ 2)
      apply (cast_inj.int (nw * kdiff) (5 * (nim ^ 2))).mp
      rw [cast_mul.int nw kdiff, cast_mul.int 5 (nim ^ 2), cast_pow.int nim 2, hnw_eq, hkdiff_eq, hnim_eq, ← gi5.abs_mul_eq, ← gi5.norm_mul, hw_diff]
      rw [gi5.norm_mul, gi5.abs_mul_eq]
      have hn5 : |gi5.norm gi5.sqrt5| = 5 := by decide
      have hni : gi5.norm (gi5.of_int (gi5.s5_im beta)) = (gi5.s5_im beta) * (gi5.s5_im beta)
        unfold gi5.norm gi5.of_int; simp; ring
      have h5c : ((5 : ℕ) : ℤ) = 5 := by decide
      rw [h5c, hn5, hni, gi5.abs_mul_eq]; ring
    have hp_5im2 : p ∣ (5 * (nim ^ 2)) :=
      dvd.trans_nat p nw (5 * (nim ^ 2)) (by omega) hnw_pos hp_nw (nat.dvd_of_mul_eq nw kdiff (5 * (nim ^ 2)) hnw_pos him_sq.symm)
    have hp_im2 : p ∣ (nim ^ 2)
      obtain hp5 | hpim := hp.2 5 (nim ^ 2) hp_5im2
      · exfalso
        have hf5 := is_prime_nat.to_full 5 is_prime_nat_five
        obtain hp1 | hpe5 := hf5.2 p hp5
        · omega
        · exact hp_ne5 hpe5
      · exact hpim
    have hp_im : p ∣ nim := prime_dvd_of_dvd_pow.nat p nim 2 (is_prime_nat.to_prime p hp) hp_im2
    exact hno_odd_p p hp hp3 hp_ne5 ⟨hp_re, hp_im⟩
  have hnw_abs1 : |gi5.norm w| = 1 := by rw [← hnw_eq, hnw_eq1]; decide
  unfold gi5.coprime
  use gi5.mul (gi5.uinv w) s, gi5.mul (gi5.uinv w) v
  have hunit := (gi5.mul_uinv w hnw_abs1).2.1
  have hdist : gi5.add (gi5.mul (gi5.mul (gi5.uinv w) s) beta) (gi5.mul (gi5.mul (gi5.uinv w) v) (gi5.conj beta))
      = gi5.mul (gi5.uinv w) (gi5.add (gi5.mul s beta) (gi5.mul v (gi5.conj beta)))
    apply gi5.ext <;> (unfold gi5.mul gi5.add; simp; ring)
  rw [hdist, ← hbez, hunit]

-- Strict monotonicity of z |-> z^5 on Z: x^5 = y^5 => x = y!
+ int.fifth_inj (x y : ℤ) (heq : x ^ 5 = y ^ 5) : x = y
  by_contra hne
  have hfac : x ^ 5 - y ^ 5 = (x - y) * (x ^ 4 + x ^ 3 * y + x ^ 2 * y ^ 2 + x * y ^ 3 + y ^ 4) := by ring
  have hpos_q : 0 < 2 * (x ^ 4 + x ^ 3 * y + x ^ 2 * y ^ 2 + x * y ^ 3 + y ^ 4)
    have hid : 2 * (x ^ 4 + x ^ 3 * y + x ^ 2 * y ^ 2 + x * y ^ 3 + y ^ 4) =
        (x ^ 2 + y ^ 2) * (x + y) ^ 2 + x ^ 4 + y ^ 4 := by ring
    have hs1 : 0 ≤ (x ^ 2 + y ^ 2) * (x + y) ^ 2 := mul_nonneg.int (x ^ 2 + y ^ 2) ((x + y) ^ 2) (by nlinarith) (by nlinarith)
    by_cases hx0 : x = 0
    · have hy_nz : y ≠ 0 := by omega
      have hy2 : 0 < y * y := int.sq_pos_of_nz y hy_nz
      have hy4 : 0 < y ^ 4 := by have h4 : y ^ 4 = (y * y) * (y * y) := by ring; rw [h4]; exact mul_pos.int (y * y) (y * y) hy2 hy2
      have hx4 : x ^ 4 = 0 := by rw [hx0]; ring
      linarith
    · have hx2 : 0 < x * x := int.sq_pos_of_nz x hx0
      have hx4 : 0 < x ^ 4 := by have h4 : x ^ 4 = (x * x) * (x * x) := by ring; rw [h4]; exact mul_pos.int (x * x) (x * x) hx2 hx2
      have hy4 : 0 ≤ y ^ 4 := by have h4 : y ^ 4 = (y ^ 2) * (y ^ 2) := by ring; rw [h4]; nlinarith
      linarith
  have hq_pos : 0 < x ^ 4 + x ^ 3 * y + x ^ 2 * y ^ 2 + x * y ^ 3 + y ^ 4 := by linarith
  by_cases hlt : x < y
  · have hm := mul_pos.int (y - x) (x ^ 4 + x ^ 3 * y + x ^ 2 * y ^ 2 + x * y ^ 3 + y ^ 4) (by linarith) hq_pos
    linarith
  · have hm := mul_pos.int (x - y) (x ^ 4 + x ^ 3 * y + x ^ 2 * y ^ 2 + x * y ^ 3 + y ^ 4) (by omega) hq_pos
    linarith

-- Universal Z[phi] Fifth-Root Extraction Theorem:
+ gi5.fifth_of_norm_pow5 (beta : GoldenInt) (t : ℕ)
    (hnorm : gi5.norm beta = (t : ℤ) ^ 5)
    (ht_pos : 1 ≤ t) (ht_odd : t % 2 = 1) (ht_nd5 : t % 5 ≠ 0)
    (hb5 : beta.b % 5 = 0)
    (hno_odd_p : ∀ p : ℕ, is_prime_nat p → 3 ≤ p → p ≠ 5 →
      ¬ (p ∣ nat_of_int (|gi5.s5_re beta|) ∧ p ∣ nat_of_int (|gi5.s5_im beta|))) :
    ∃ delta : GoldenInt,
      beta = gi5.fifth delta ∧
      gi5.norm delta = (t : ℤ) ∧
      (∀ p : ℕ, is_prime_nat p → 3 ≤ p →
        ¬ (p ∣ nat_of_int (|gi5.s5_re delta|) ∧ p ∣ nat_of_int (|gi5.s5_im delta|)))
  have hcop := gi5.coprime_conj_of_odd_norm beta t hnorm ht_pos ht_odd ht_nd5 hno_odd_p
  have hgt_nz : gi5.of_int (t : ℤ) ≠ gi5.zero
    intro hz; have ha : (gi5.of_int (t : ℤ)).a = 0 := by rw [hz]; unfold gi5.zero; simp
    unfold gi5.of_int at ha; simp at ha
    have hc := (cast_lt.int 0 t).mpr (by omega); linarith
  have hgt_norm : |gi5.norm (gi5.of_int (t : ℤ))| = ((t * t : ℕ) : ℤ)
    unfold gi5.norm gi5.of_int; simp
    have hsub0 : (t : ℤ) * (t : ℤ) - 0 = (t : ℤ) * (t : ℤ) := by ring
    rw [hsub0]
    have hnn : 0 ≤ (t : ℤ) * (t : ℤ) := by nlinarith
    obtain ⟨e, _⟩ | ⟨_, hneg⟩ := abs_cases.int ((t : ℤ) * (t : ℤ)); exact e; linarith
  have hprod_eq : gi5.mul beta (gi5.conj beta) = gi5.mul gi5.one (gi5.fifth (gi5.of_int (t : ℤ)))
    rw [gi5.mul_conj, hnorm, gi5.mul_one_l]
    apply gi5.ext
    · unfold gi5.of_int gi5.fifth; simp only [gi5.mul_a, gi5.mul_b]; simp; ring
    · unfold gi5.of_int gi5.fifth; simp only [gi5.mul_a, gi5.mul_b]; simp
  have hn1 : |gi5.norm gi5.one| = 1 := by decide
  obtain ⟨u1, a1, hu1, hbeta_u1⟩ :=
    gi5.coprime_mul_eq_unit_fifth (t * t) (gi5.of_int (t : ℤ)) hgt_nz hgt_norm beta (gi5.conj beta) gi5.one hn1 hcop hprod_eq
  -- Show u1.b % 5 = 0:
  obtain ⟨kb, hkb⟩ := gi5.fifth_b_div5 a1
  set A5 := (gi5.fifth a1).a with hA5_def
  have hA5_nd5 : ¬ (5 ∣ nat_of_int (|A5|))
    intro hd5
    obtain ⟨qA, hqA_n⟩ := (dvd.iff_exists 5 (nat_of_int (|A5|)) (by decide)).mp hd5
    have hA5_abs : |A5| = 5 * (qA : ℤ)
      have hc := nat_of_int_abs_eq A5
      rw [hqA_n, cast_mul.int] at hc
      have h5c : ((5 : ℕ) : ℤ) = 5 := by decide
      rw [h5c] at hc; exact hc.symm
    have hA5_div : ∃ kA : ℤ, A5 = 5 * kA
      obtain ⟨e, _⟩ | ⟨e, _⟩ := abs_cases.int A5
      · exact ⟨(qA : ℤ), by linarith⟩
      · exact ⟨-(qA : ℤ), by linarith⟩
    obtain ⟨kA, hkA⟩ := hA5_div
    have hnorm_a5 : gi5.norm (gi5.fifth a1) = 25 * (kA * kA + kA * kb - kb * kb)
      unfold gi5.norm; rw [← hA5_def, hkA, hkb]; ring
    have hnorm_b : |gi5.norm beta| = |25 * (kA * kA + kA * kb - kb * kb)|
      rw [hbeta_u1, gi5.norm_mul, gi5.abs_mul_eq, hu1, hnorm_a5]; ring
    have ht5_eq : ((t ^ 5 : ℕ) : ℤ) = (25 : ℤ) * |kA * kA + kA * kb - kb * kb|
      rw [cast_pow.int t 5, ← hnorm]
      have ht5_nn : 0 ≤ (t : ℤ) ^ 5
        rw [← cast_pow.int t 5]; exact (cast_le.int 0 (t ^ 5)).mpr (by omega)
      obtain ⟨eb, _⟩ | ⟨_, hn⟩ := abs_cases.int (gi5.norm beta)
      · rw [← eb, hnorm_b, gi5.abs_mul_eq]
        have h25 : |(25 : ℤ)| = 25 := by decide
        rw [h25]
      · rw [hnorm] at hn; linarith
    set m25 := nat_of_int (|kA * kA + kA * kb - kb * kb|) with hm25_def
    have hm25_eq : (m25 : ℤ) = |kA * kA + kA * kb - kb * kb| := by rw [hm25_def]; exact nat_of_int_abs_eq (kA * kA + kA * kb - kb * kb)
    have ht5_nat : t ^ 5 = 5 * (5 * m25)
      apply (cast_inj.int (t ^ 5) (5 * (5 * m25))).mp
      rw [cast_mul.int, cast_mul.int, hm25_eq]
      have h5c : ((5 : ℕ) : ℤ) = 5 := by decide
      rw [h5c]; linarith
    have h5_t5 : 5 ∣ (t ^ 5) := nat.dvd_of_mul_eq 5 (5 * m25) (t ^ 5) (by decide) ht5_nat
    have h5_t : 5 ∣ t := prime_dvd_of_dvd_pow.nat 5 t 5 (is_prime_nat.to_prime 5 is_prime_nat_five) h5_t5
    unfold dvd at h5_t; exact ht_nd5 h5_t
  have hu1_b_mod5 : u1.b % 5 = 0
    have hbb_eq : beta.b = u1.b * A5 + 5 * (u1.a * kb + u1.b * kb)
      rw [hbeta_u1]; unfold gi5.mul; simp; rw [← hA5_def, hkb]; ring
    have hd5_bb := div_add_mod.int beta.b 5
    rw [hb5] at hd5_bb
    set qbb := beta.b / 5
    have hprod5 : u1.b * A5 = 5 * (qbb - u1.a * kb - u1.b * kb) := by linarith
    set qr := nat_of_int (|qbb - u1.a * kb - u1.b * kb|) with hqr_def
    have hqr_eq : (qr : ℤ) = |qbb - u1.a * kb - u1.b * kb| := by rw [hqr_def]; exact nat_of_int_abs_eq (qbb - u1.a * kb - u1.b * kb)
    set nu1b := nat_of_int (|u1.b|) with hnu1b_def
    have hnu1b_eq : (nu1b : ℤ) = |u1.b| := by rw [hnu1b_def]; exact nat_of_int_abs_eq u1.b
    set nA5 := nat_of_int (|A5|) with hnA5_def
    have hnA5_eq : (nA5 : ℤ) = |A5| := by rw [hnA5_def]; exact nat_of_int_abs_eq A5
    have hmul_nat : nu1b * nA5 = 5 * qr
      apply (cast_inj.int (nu1b * nA5) (5 * qr)).mp
      rw [cast_mul.int, cast_mul.int, hnu1b_eq, hnA5_eq, hqr_eq, ← gi5.abs_mul_eq, hprod5, gi5.abs_mul_eq]
      have h5c : ((5 : ℕ) : ℤ) = 5 := by decide
      have h5a : |(5 : ℤ)| = 5 := by decide
      rw [h5c, h5a]
    have h5_mul : 5 ∣ (nu1b * nA5) := nat.dvd_of_mul_eq 5 qr (nu1b * nA5) (by decide) hmul_nat
    have h5_nu1b : 5 ∣ nu1b
      obtain h1 | h2 := is_prime_nat_five.2 nu1b nA5 h5_mul
      · exact h1
      · exfalso; exact hA5_nd5 h2
    obtain ⟨ku, hku⟩ := (dvd.iff_exists 5 nu1b (by decide)).mp h5_nu1b
    have hu1b_abs : |u1.b| = 5 * (ku : ℤ)
      rw [← hnu1b_eq, hku, cast_mul.int]
      have h5c : ((5 : ℕ) : ℤ) = 5 := by decide
      rw [h5c]
    obtain ⟨eu, _⟩ | ⟨eu, _⟩ := abs_cases.int u1.b
    · have he : u1.b = 0 + 5 * (ku : ℤ) := by linarith
      rw [he, add_mul_mod.int 0 (ku : ℤ) 5 (by decide)]
      exact (div_mod_of_lt.int 0 5 (by decide) (by decide)).2
    · have he : u1.b = 0 + 5 * (-(ku : ℤ)) := by linarith
      rw [he, add_mul_mod.int 0 (-(ku : ℤ)) 5 (by decide)]
      exact (div_mod_of_lt.int 0 5 (by decide) (by decide)).2
  obtain ⟨v1, hv1_n, hv1_eq⟩ := gi5.unit_fifth_of_mod5 (nat_of_int (|u1.b|)) u1 hu1 (by ring) hu1_b_mod5
  set delta := gi5.mul v1 a1 with hdelta_def
  have hbeta_d : beta = gi5.fifth delta
    rw [hdelta_def, gi5.fifth_mul, ← hv1_eq, ← hbeta_u1]
  have hnorm_d : gi5.norm delta = (t : ℤ)
    have h5 : (gi5.norm delta) ^ 5 = (t : ℤ) ^ 5
      rw [← gi5.norm_fifth, ← hbeta_d, hnorm]
    exact int.fifth_inj (gi5.norm delta) (t : ℤ) h5
  have hcop_d : ∀ p : ℕ, is_prime_nat p → 3 ≤ p →
      ¬ (p ∣ nat_of_int (|gi5.s5_re delta|) ∧ p ∣ nat_of_int (|gi5.s5_im delta|))
    intro p hp hp3 hboth
    obtain ⟨hpre, hpim⟩ := hboth
    -- First show p != 5 via 4 * t = s5_re(delta)^2 - 5 * s5_im(delta)^2:
    have hp_ne5 : p ≠ 5
      intro he5
      rw [he5] at hpre hpim
      obtain ⟨kre, hkre⟩ := (dvd.iff_exists 5 (nat_of_int (|gi5.s5_re delta|)) (by decide)).mp hpre
      have hre_abs : |gi5.s5_re delta| = 5 * (kre : ℤ)
        have hc := nat_of_int_abs_eq (gi5.s5_re delta)
        rw [hkre, cast_mul.int] at hc
        have h5c : ((5 : ℕ) : ℤ) = 5 := by decide; rw [h5c] at hc; exact hc.symm
      have hre_sq : gi5.s5_re delta * gi5.s5_re delta = 25 * ((kre : ℤ) * (kre : ℤ))
        obtain ⟨e, _⟩ | ⟨e, _⟩ := abs_cases.int (gi5.s5_re delta)
        · have he1 : gi5.s5_re delta = 5 * (kre : ℤ) := by linarith
          rw [he1]; ring
        · have he1 : gi5.s5_re delta = -5 * (kre : ℤ) := by linarith
          rw [he1]; ring
      have h4n := gi5.four_norm delta
      rw [hnorm_d, hre_sq] at h4n
      have h4t_div5 : 4 * (t : ℤ) = 5 * (5 * ((kre : ℤ) * (kre : ℤ)) - gi5.s5_im delta * gi5.s5_im delta) := by linarith
      have hnn_rhs : 0 ≤ 5 * ((kre : ℤ) * (kre : ℤ)) - gi5.s5_im delta * gi5.s5_im delta
        have ht_pos_z : (0 : ℤ) < (t : ℤ) := (cast_lt.int 0 t).mpr (by omega)
        linarith
      set kt := nat_of_int (5 * ((kre : ℤ) * (kre : ℤ)) - gi5.s5_im delta * gi5.s5_im delta) with hkt_def
      have hkt_eq : (kt : ℤ) = 5 * ((kre : ℤ) * (kre : ℤ)) - gi5.s5_im delta * gi5.s5_im delta := by
        rw [hkt_def]; exact int_of_nat_of_int (5 * ((kre : ℤ) * (kre : ℤ)) - gi5.s5_im delta * gi5.s5_im delta) hnn_rhs
      have h4t_nat : 4 * t = 5 * kt
        apply (cast_inj.int (4 * t) (5 * kt)).mp
        rw [cast_mul.int, cast_mul.int, hkt_eq]
        have h4c : ((4 : ℕ) : ℤ) = 4 := by decide
        have h5c : ((5 : ℕ) : ℤ) = 5 := by decide
        rw [h4c, h5c]; exact h4t_div5
      have h5_4t : 5 ∣ (4 * t) := nat.dvd_of_mul_eq 5 kt (4 * t) (by decide) h4t_nat
      obtain h54 | h5t := is_prime_nat_five.2 4 t h5_4t
      · have hnot54 : ¬ (5 ∣ 4) := by decide; exact hnot54 h54
      · unfold dvd at h5t; exact ht_nd5 h5t
    -- Next show p divides nat_of_int |s5_re beta| and nat_of_int |s5_im beta| via s5_fifth_coords!
    have hp_nd16 : ¬ (p ∣ 16)
      intro hd16
      have h24 : 16 = 2 ^ 4 := by decide
      rw [h24] at hd16
      have hp2_d := prime_dvd_of_dvd_pow.nat p 2 4 (is_prime_nat.to_prime p hp) hd16
      have hf2 := is_prime_nat.to_full 2 is_prime_nat_two
      obtain h1 | h2 := hf2.2 p hp2_d <;> omega
    have hcoords := gi5.s5_fifth_coords delta
    rw [← hbeta_d] at hcoords
    set R_fac := nat_of_int (|(gi5.s5_re delta) ^ 4 + 50 * (gi5.s5_re delta) ^ 2 * (gi5.s5_im delta) ^ 2 + 125 * (gi5.s5_im delta) ^ 4|) with hR_def
    have hR_eq : (R_fac : ℤ) = |(gi5.s5_re delta) ^ 4 + 50 * (gi5.s5_re delta) ^ 2 * (gi5.s5_im delta) ^ 2 + 125 * (gi5.s5_im delta) ^ 4| := by
      rw [hR_def]; exact nat_of_int_abs_eq ((gi5.s5_re delta) ^ 4 + 50 * (gi5.s5_re delta) ^ 2 * (gi5.s5_im delta) ^ 2 + 125 * (gi5.s5_im delta) ^ 4)
    have h16_re : 16 * nat_of_int (|gi5.s5_re beta|) = nat_of_int (|gi5.s5_re delta|) * R_fac
      apply (cast_inj.int (16 * nat_of_int (|gi5.s5_re beta|)) (nat_of_int (|gi5.s5_re delta|) * R_fac)).mp
      rw [cast_mul.int, cast_mul.int, nat_of_int_abs_eq (gi5.s5_re beta), nat_of_int_abs_eq (gi5.s5_re delta), hR_eq]
      have h16c : ((16 : ℕ) : ℤ) = 16 := by decide
      have h16a : |(16 : ℤ)| = 16 := by decide
      rw [h16c, ← h16a, ← gi5.abs_mul_eq, ← gi5.abs_mul_eq, hcoords.1]
    obtain ⟨qre, hqre⟩ := (dvd.iff_exists p (nat_of_int (|gi5.s5_re delta|)) (by omega)).mp hpre
    have hp_16re : p ∣ (16 * nat_of_int (|gi5.s5_re beta|)) :=
      nat.dvd_of_mul_eq p (qre * R_fac) (16 * nat_of_int (|gi5.s5_re beta|)) (by omega) (by rw [h16_re, hqre]; ring)
    have hp_bre : p ∣ nat_of_int (|gi5.s5_re beta|)
      obtain hd16 | hdre := hp.2 16 (nat_of_int (|gi5.s5_re beta|)) hp_16re; (exfalso; exact hp_nd16 hd16); exact hdre
    set I_fac := nat_of_int (|(gi5.s5_re delta) ^ 4 + 10 * (gi5.s5_re delta) ^ 2 * (gi5.s5_im delta) ^ 2 + 5 * (gi5.s5_im delta) ^ 4|) with hI_def
    have hI_eq : (I_fac : ℤ) = |(gi5.s5_re delta) ^ 4 + 10 * (gi5.s5_re delta) ^ 2 * (gi5.s5_im delta) ^ 2 + 5 * (gi5.s5_im delta) ^ 4| := by
      rw [hI_def]; exact nat_of_int_abs_eq ((gi5.s5_re delta) ^ 4 + 10 * (gi5.s5_re delta) ^ 2 * (gi5.s5_im delta) ^ 2 + 5 * (gi5.s5_im delta) ^ 4)
    have h16_im : 16 * nat_of_int (|gi5.s5_im beta|) = nat_of_int (|gi5.s5_im delta|) * (5 * I_fac)
      apply (cast_inj.int (16 * nat_of_int (|gi5.s5_im beta|)) (nat_of_int (|gi5.s5_im delta|) * (5 * I_fac))).mp
      rw [cast_mul.int, cast_mul.int, cast_mul.int, nat_of_int_abs_eq (gi5.s5_im beta), nat_of_int_abs_eq (gi5.s5_im delta), hI_eq]
      have h16c : ((16 : ℕ) : ℤ) = 16 := by decide
      have h16a : |(16 : ℤ)| = 16 := by decide
      have h5c : ((5 : ℕ) : ℤ) = 5 := by decide
      have h5a : |(5 : ℤ)| = 5 := by decide
      have h5m : 5 * gi5.s5_im delta * ((gi5.s5_re delta) ^ 4 + 10 * (gi5.s5_re delta) ^ 2 * (gi5.s5_im delta) ^ 2 + 5 * (gi5.s5_im delta) ^ 4) =
          gi5.s5_im delta * (5 * ((gi5.s5_re delta) ^ 4 + 10 * (gi5.s5_re delta) ^ 2 * (gi5.s5_im delta) ^ 2 + 5 * (gi5.s5_im delta) ^ 4)) := by ring
      rw [h16c, h5c, ← h16a, ← h5a, ← gi5.abs_mul_eq, ← gi5.abs_mul_eq, ← gi5.abs_mul_eq, hcoords.2, h5m, h5a]
    obtain ⟨qim, hqim⟩ := (dvd.iff_exists p (nat_of_int (|gi5.s5_im delta|)) (by omega)).mp hpim
    have hp_16im : p ∣ (16 * nat_of_int (|gi5.s5_im beta|)) :=
      nat.dvd_of_mul_eq p (qim * (5 * I_fac)) (16 * nat_of_int (|gi5.s5_im beta|)) (by omega) (by rw [h16_im, hqim]; ring)
    have hp_bim : p ∣ nat_of_int (|gi5.s5_im beta|)
      obtain hd16 | hdim := hp.2 16 (nat_of_int (|gi5.s5_im beta|)) hp_16im; (exfalso; exact hp_nd16 hd16); exact hdim
    exact hno_odd_p p hp hp3 hp_ne5 ⟨hp_bre, hp_bim⟩
  exact ⟨delta, hbeta_d, hnorm_d, hcop_d⟩

-- Universal 2-5-Pow5 Splitter (`(5 * b') * Q = 2^E2 * 5^E5 * R^5` => `b' = 2^E2 * 5^(E5-1) * r'^5`, `Q = t'^5`):
+ nat.split_two_five_pow5 (b' Q E2 E5 R : ℕ)
    (hb' : 0 < b') (hQ : 0 < Q) (hR : 0 < R) (hE5 : 2 ≤ E5)
    (hQ_odd : Q % 2 = 1) (hQ_nd5 : Q % 5 ≠ 0)
    (hcop : nat.coprime_primes b' Q)
    (heq : (5 * b') * Q = 2 ^ E2 * 5 ^ E5 * R ^ 5) :
    ∃ r' t' : ℕ, 1 ≤ r' ∧ 1 ≤ t' ∧ t' % 2 = 1 ∧ t' % 5 ≠ 0 ∧
      b' = 2 ^ E2 * 5 ^ (E5 - 1) * r' ^ 5 ∧ Q = t' ^ 5
  have h2E2_pos : 0 < 2 ^ E2 := pow_pos.nat 2 E2 (by decide)
  have h5E5_pos : 0 < 5 ^ E5 := pow_pos.nat 5 E5 (by decide)
  have hR5_pos : 0 < R ^ 5 := pow_pos.nat R 5 hR
  -- Step 1: Extract 2^E2 from b' using vp 2!
  have h2_nd5 : ¬ (2 ∣ 5) := by unfold dvd; decide
  have h2_ndQ : ¬ (2 ∣ Q) := by unfold dvd; omega
  have hvp2_lhs : vp 2 ((5 * b') * Q) = vp 2 b'
    rw [vp.mul 2 (5 * b') Q is_prime_nat_two (by omega) hQ]
    rw [vp.mul 2 5 b' is_prime_nat_two (by decide) hb']
    rw [vp.eq_zero_of_not_dvd 2 5 (by decide) (by decide) h2_nd5]
    rw [vp.eq_zero_of_not_dvd 2 Q (by decide) hQ h2_ndQ]
    omega
  have h2E2_dvd_rhs : 2 ^ E2 ∣ ((5 * b') * Q)
    rw [heq]; exact nat.dvd_of_mul_eq (2 ^ E2) (5 ^ E5 * R ^ 5) (2 ^ E2 * 5 ^ E5 * R ^ 5) h2E2_pos (by ring)
  have hE2_le : E2 ≤ vp 2 b'
    rw [← hvp2_lhs]
    exact (vp.le_iff_pow_dvd 2 ((5 * b') * Q) E2 (by decide) (mul_pos.nat (5 * b') Q (by omega) hQ)).mpr h2E2_dvd_rhs
  have h2E2_dvd_b' : 2 ^ E2 ∣ b' := (vp.le_iff_pow_dvd 2 b' E2 (by decide) hb').mp hE2_le
  obtain ⟨b1, hb1⟩ := (dvd.iff_exists (2 ^ E2) b' h2E2_pos).mp h2E2_dvd_b'
  have hb1_pos : 0 < b1 := by by_contra h0; have hz : b1 = 0 := by omega; rw [hz] at hb1; have hm0 : 2 ^ E2 * 0 = 0 := by ring; rw [hm0] at hb1; omega
  have heq1 : (5 * b1) * Q = 5 ^ E5 * R ^ 5
    apply nat.mul_cancel_left_pos (2 ^ E2) ((5 * b1) * Q) (5 ^ E5 * R ^ 5) h2E2_pos
    have hl : 2 ^ E2 * ((5 * b1) * Q) = (5 * b') * Q := by rw [hb1]; ring
    have hr : 2 ^ E2 * (5 ^ E5 * R ^ 5) = 2 ^ E2 * 5 ^ E5 * R ^ 5 := by ring
    rw [hl, hr, heq]
  -- Step 2: Extract 5^E5 from (5 * b1), i.e. 5^(E5 - 1) from b1, using vp 5!
  have h5_ndQ : ¬ (5 ∣ Q) := by unfold dvd; exact hQ_nd5
  have hvp5_lhs : vp 5 ((5 * b1) * Q) = vp 5 (5 * b1)
    rw [vp.mul 5 (5 * b1) Q is_prime_nat_five (by omega) hQ]
    rw [vp.eq_zero_of_not_dvd 5 Q (by decide) hQ h5_ndQ]
    omega
  have h5E5_dvd_rhs : 5 ^ E5 ∣ ((5 * b1) * Q)
    rw [heq1]; exact nat.dvd_of_mul_eq (5 ^ E5) (R ^ 5) (5 ^ E5 * R ^ 5) h5E5_pos (by ring)
  have hE5_le : E5 ≤ vp 5 (5 * b1)
    rw [← hvp5_lhs]
    exact (vp.le_iff_pow_dvd 5 ((5 * b1) * Q) E5 (by decide) (mul_pos.nat (5 * b1) Q (by omega) hQ)).mpr h5E5_dvd_rhs
  have h5E5_dvd_5b1 : 5 ^ E5 ∣ (5 * b1) := (vp.le_iff_pow_dvd 5 (5 * b1) E5 (by decide) (by omega)).mp hE5_le
  obtain ⟨b2, hb2_raw⟩ := (dvd.iff_exists (5 ^ E5) (5 * b1) h5E5_pos).mp h5E5_dvd_5b1
  set E5m := E5 - 1 with hE5m_def
  have hE5_pred : E5 = E5m + 1 := by omega
  have h5_pow_split : 5 ^ E5 = 5 * 5 ^ E5m
    rw [hE5_pred, pow_succ.nat 5 E5m]; ring
  have hb1_eq : b1 = 5 ^ (E5 - 1) * b2
    apply nat.mul_cancel_left_pos 5 b1 (5 ^ (E5 - 1) * b2) (by decide)
    rw [hb2_raw, h5_pow_split, ← hE5m_def]; ring
  have hb2_pos : 0 < b2
    by_contra h0; have hz : b2 = 0 := by omega
    rw [hz] at hb2_raw; have hm0 : 5 ^ E5 * 0 = 0 := by ring; rw [hm0] at hb2_raw; omega
  have heq2 : b2 * Q = R ^ 5
    apply nat.mul_cancel_left_pos (5 ^ E5) (b2 * Q) (R ^ 5) h5E5_pos
    have hl : 5 ^ E5 * (b2 * Q) = (5 * b1) * Q
      calc 5 ^ E5 * (b2 * Q) = (5 ^ E5 * b2) * Q := by ring
        _ = (5 * b1) * Q := by rw [← hb2_raw]
    rw [hl, heq1]
  have hcop_b2_Q : nat.coprime_primes b2 Q
    unfold nat.coprime_primes
    intro p hp hboth
    obtain ⟨hpb2, hpQ⟩ := hboth
    obtain ⟨wb, hwb⟩ := (dvd.iff_exists p b2 (by linarith [hp.1])).mp hpb2
    have hpb' : p ∣ b' :=
      nat.dvd_of_mul_eq p (2 ^ E2 * 5 ^ (E5 - 1) * wb) b' (by linarith [hp.1]) (by rw [hb1, hb1_eq, hwb]; ring)
    unfold nat.coprime_primes at hcop
    exact hcop p hp ⟨hpb', hpQ⟩
  obtain ⟨r', t', hr'_eq, ht'_eq⟩ := nat.coprime_mul_eq_pow 5 (by decide) b2 hb2_pos Q R hQ hcop_b2_Q heq2
  have hr'_pos : 1 ≤ r'
    by_contra h0; have hz : r' = 0 := by omega; rw [hz] at hr'_eq; have h05 : 0 ^ 5 = 0 := by decide; rw [h05] at hr'_eq; omega
  have ht'_pos : 1 ≤ t'
    by_contra h0; have hz : t' = 0 := by omega; rw [hz] at ht'_eq; have h05 : 0 ^ 5 = 0 := by decide; rw [h05] at ht'_eq; omega
  have ht'_odd : t' % 2 = 1
    by_contra hev; have h0 : t' % 2 = 0 := by omega
    obtain ⟨qt, hqt⟩ := (dvd.iff_exists 2 t' (by decide)).mp h0
    have hQ_ev : 2 ∣ Q := nat.dvd_of_mul_eq 2 (16 * qt ^ 5) Q (by decide) (by rw [ht'_eq, hqt]; ring)
    exact h2_ndQ hQ_ev
  have ht'_nd5 : t' % 5 ≠ 0
    intro hd5
    obtain ⟨qt, hqt⟩ := (dvd.iff_exists 5 t' (by decide)).mp hd5
    have hQ_5 : 5 ∣ Q := nat.dvd_of_mul_eq 5 (625 * qt ^ 5) Q (by decide) (by rw [ht'_eq, hqt]; ring)
    exact h5_ndQ hQ_5
  exact ⟨r', t', hr'_pos, ht'_pos, ht'_odd, ht'_nd5, by rw [hb1, hb1_eq, ← hE5m_def, hr'_eq]; ring, ht'_eq⟩

-- ====================================================================================
-- 4. Dirichlet-Legendre (1825) Unified Quartic Fifth-Power Infinite Descent
-- ====================================================================================

+ int.odd_sq_mod8 (u : ℤ) (hu : u % 2 = 1) : ∃ k : ℤ, u * u = 1 + 8 * k
  have hd2 := div_add_mod.int u 2
  rw [hu] at hd2
  set q := u / 2
  have hu_eq : u = 2 * q + 1 := by linarith
  have hdq := div_add_mod.int q 2
  have hr0 := mod_nonneg.int q 2 (by decide)
  have hrlt := mod_lt.int q 2 (by decide)
  set m := q / 2
  set rq := q % 2
  have hq_eq : q = 2 * m + rq := by linarith
  by_cases hrq0 : rq = 0
  · use 2 * m * m + m
    rw [hu_eq, hq_eq, hrq0]; ring
  · have hrq1 : rq = 1 := by omega
    use 2 * m * m + 3 * m + 1
    rw [hu_eq, hq_eq, hrq1]; ring

+ int.odd_quartic_div16 (a b : ℤ) (ha : a % 2 = 1) (hb : b % 2 = 1) :
    ∃ Q M : ℤ,
      a ^ 4 + 10 * a ^ 2 * b ^ 2 + 5 * b ^ 4 = 16 * Q ∧
      Q % 2 = 1 ∧
      a ^ 2 + 3 * b ^ 2 = 4 * M
  obtain ⟨ka, hka⟩ := int.odd_sq_mod8 a ha
  obtain ⟨kb, hkb⟩ := int.odd_sq_mod8 b hb
  set K := 3 * ka + 5 * kb + 2 * ka * ka + 20 * ka * kb + 10 * kb * kb with hK_def
  use 1 + 2 * K, 1 + 2 * ka + 6 * kb
  have hq_id : a ^ 4 + 10 * a ^ 2 * b ^ 2 + 5 * b ^ 4 = 16 * (1 + 2 * K)
    have ha2 : a ^ 2 = 1 + 8 * ka := by have s : a ^ 2 = a * a := by ring; rw [s, hka]
    have hb2 : b ^ 2 = 1 + 8 * kb := by have s : b ^ 2 = b * b := by ring; rw [s, hkb]
    have ha4 : a ^ 4 = (a ^ 2) * (a ^ 2) := by ring
    have hb4 : b ^ 4 = (b ^ 2) * (b ^ 2) := by ring
    rw [ha4, hb4, ha2, hb2, hK_def]; ring
  have hq_odd : (1 + 2 * K) % 2 = 1
    rw [add_mul_mod.int 1 K 2 (by decide)]
    exact (div_mod_of_lt.int 1 2 (by decide) (by decide)).2
  have hm_id : a ^ 2 + 3 * b ^ 2 = 4 * (1 + 2 * ka + 6 * kb)
    have ha2 : a ^ 2 = 1 + 8 * ka := by have s : a ^ 2 = a * a := by ring; rw [s, hka]
    have hb2 : b ^ 2 = 1 + 8 * kb := by have s : b ^ 2 = b * b := by ring; rw [s, hkb]
    rw [ha2, hb2]; ring
  exact ⟨hq_id, hq_odd, hm_id⟩

-> dirichlet.state_at (t : ℕ) : Prop :=
  1 ≤ t ∧ t % 2 = 1 ∧ t % 5 ≠ 0 ∧
  ∃ a : ℤ, ∃ b mu nu r : ℕ,
    a % 2 = 1 ∧
    0 < b ∧ 1 ≤ nu ∧ 1 ≤ r ∧
    b = 2 ^ mu * 5 ^ nu * r ^ 5 ∧
    nat.coprime_primes (nat_of_int (|a|)) b ∧
    ((1 ≤ mu ∧ a ^ 4 + 10 * a ^ 2 * (b : ℤ) ^ 2 + 5 * (b : ℤ) ^ 4 = (t : ℤ) ^ 5) ∨
     (mu = 0 ∧ a ^ 4 + 10 * a ^ 2 * (b : ℤ) ^ 2 + 5 * (b : ℤ) ^ 4 = 16 * (t : ℤ) ^ 5))

-- Helper: 5 | b for b = 2^mu * 5^nu * r^5 with 1 <= nu!
+ nat.five_dvd_state_b (b mu nu r : ℕ) (hnu : 1 ≤ nu) (hb : b = 2 ^ mu * 5 ^ nu * r ^ 5) :
    ∃ qb : ℕ, b = 5 * qb
  set num := nu - 1 with hnum_def
  have hnu_eq : nu = num + 1 := by omega
  have hp5 : 5 ^ nu = 5 * 5 ^ num := by rw [hnu_eq, pow_succ.nat 5 num]; ring
  exact ⟨2 ^ mu * 5 ^ num * r ^ 5, by rw [hb, hp5]; ring⟩

+ int.nat_abs_sq_eq (z : ℤ) : ((nat_of_int (|z|) ^ 2 : ℕ) : ℤ) = z ^ 2
  rw [cast_pow.int (nat_of_int (|z|)) 2, nat_of_int_abs_eq z]
  obtain ⟨e, _⟩ | ⟨e, _⟩ := abs_cases.int z
  · rw [e]
  · rw [e]; ring

+ int.nat_abs_pow4_eq (z : ℤ) : ((nat_of_int (|z|) ^ 4 : ℕ) : ℤ) = z ^ 4
  rw [cast_pow.int (nat_of_int (|z|)) 4, nat_of_int_abs_eq z]
  obtain ⟨e, _⟩ | ⟨e, _⟩ := abs_cases.int z
  · rw [e]
  · rw [e]; ring

+ nat.pow_mono_base (k a b : ℕ) (hle : a ≤ b) : a ^ k ≤ b ^ k
  induction k with j ihj
  · rw [pow_zero.nat, pow_zero.nat]; omega
  · rw [succ_eq_add_one.nat, pow_succ.nat a j, pow_succ.nat b j]
    have h1 := mul_le_mul_of_nonneg_right.nat (a ^ j) (b ^ j) a ihj (by omega)
    have h2 := mul_le_mul_of_nonneg_left.nat a b (b ^ j) hle (by omega)
    have hc1 : b ^ j * a = a * b ^ j := by ring
    have hc2 : b * b ^ j = b ^ j * b := by ring
    omega

+ nat.dvd_left_of_dvd_add (p A B : ℕ) (hp : 0 < p) (hsum : p ∣ (A + B)) (hB : p ∣ B) : p ∣ A
  obtain ⟨qs, hqs⟩ := (dvd.iff_exists p (A + B) hp).mp hsum
  obtain ⟨qb, hqb⟩ := (dvd.iff_exists p B hp).mp hB
  have hle : qb ≤ qs
    by_contra hgt
    have hm := mul_le_mul_of_nonneg_left.nat (qs + 1) qb p (by omega) (by omega)
    have hpq1 : p * (qs + 1) = p * qs + p := by ring
    omega
  have he : (qs - qb) + qb = qs := by omega
  have hadd : p * (qs - qb) + B = A + B
    calc p * (qs - qb) + B = p * (qs - qb) + p * qb := by rw [hqb]
      _ = p * ((qs - qb) + qb) := by ring
      _ = p * qs := by rw [he]
      _ = A + B := hqs.symm
  exact nat.dvd_of_mul_eq p (qs - qb) A hp (by omega)

-- Core extraction lemma from delta^5 = beta:
-- In BOTH branches of `dirichlet.state_at t`, extracting `delta` from `beta` produces
-- a strictly smaller `t' < t` satisfying `dirichlet.state_at t'`!
+ dirichlet.quartic_fifth_descent_step (t : ℕ) (hst : dirichlet.state_at t) :
    ∃ t' : ℕ, t' < t ∧ dirichlet.state_at t'
  unfold dirichlet.state_at at hst
  obtain ⟨ht_pos, ht_odd, ht_nd5, a, b, mu, nu, r, ha_odd, hb_pos, hnu_pos, hr_pos, hb_eq, hcop_ab, hbranch⟩ := hst
  obtain ⟨qb5, hqb5⟩ := nat.five_dvd_state_b b mu nu r hnu_pos hb_eq
  have hb_ge5 : 5 ≤ b
    have hqb5_pos : 1 ≤ qb5 := by by_contra h0; have hz : qb5 = 0 := by omega; rw [hz] at hqb5; omega
    omega
  obtain ⟨hmu1, hquart_ev⟩ | ⟨hmu0, hquart_od⟩ := hbranch
  · -- ========================================================================
    -- BRANCH 1: 1 <= mu (b is even), a^4 + 10*a^2*b^2 + 5*b^4 = t^5
    -- ========================================================================
    set beta := GoldenInt.mk (a ^ 2 + 3 * (b : ℤ) ^ 2) (4 * (b : ℤ) ^ 2) with hbeta_def
    have hre_b : gi5.s5_re beta = 2 * (a ^ 2 + 5 * (b : ℤ) ^ 2)
      rw [hbeta_def]; unfold gi5.s5_re; simp; ring
    have him_b : gi5.s5_im beta = 4 * (b : ℤ) ^ 2
      rw [hbeta_def]; unfold gi5.s5_im; simp
    have hnorm_b : gi5.norm beta = (t : ℤ) ^ 5
      have h4 := gi5.four_norm beta
      rw [hre_b, him_b] at h4
      have hid : 2 * (a ^ 2 + 5 * (b : ℤ) ^ 2) * (2 * (a ^ 2 + 5 * (b : ℤ) ^ 2)) - 5 * (4 * (b : ℤ) ^ 2 * (4 * (b : ℤ) ^ 2))
          = 4 * (a ^ 4 + 10 * a ^ 2 * (b : ℤ) ^ 2 + 5 * (b : ℤ) ^ 4) := by ring
      rw [hid, hquart_ev] at h4
      linarith
    have hb5_mod : beta.b % 5 = 0
      have hbb : beta.b = 0 + 5 * (20 * (qb5 : ℤ) * (qb5 : ℤ))
        rw [hbeta_def]; simp; rw [hqb5, cast_mul.int 5 qb5]
        have h5c : ((5 : ℕ) : ℤ) = 5 := by decide; rw [h5c]; ring
      rw [hbb, add_mul_mod.int 0 (20 * (qb5 : ℤ) * (qb5 : ℤ)) 5 (by decide)]
      exact (div_mod_of_lt.int 0 5 (by decide) (by decide)).2
    have hno_odd_p : ∀ p : ℕ, is_prime_nat p → 3 ≤ p → p ≠ 5 →
        ¬ (p ∣ nat_of_int (|gi5.s5_re beta|) ∧ p ∣ nat_of_int (|gi5.s5_im beta|))
      intro p hp hp3 hp5 hboth
      obtain ⟨hpre, hpim⟩ := hboth
      have hp_nd4 : ¬ (p ∣ 4)
        intro hd4; have h22 : 4 = 2 ^ 2 := by decide; rw [h22] at hd4
        have hp2 := prime_dvd_of_dvd_pow.nat p 2 2 (is_prime_nat.to_prime p hp) hd4
        obtain h1 | h2 := (is_prime_nat.to_full 2 is_prime_nat_two).2 p hp2 <;> omega
      have hp_nd2 : ¬ (p ∣ 2)
        intro hd2; obtain h1 | h2 := (is_prime_nat.to_full 2 is_prime_nat_two).2 p hd2 <;> omega
      have him_nat : nat_of_int (|gi5.s5_im beta|) = 4 * (b ^ 2)
        apply (cast_inj.int (nat_of_int (|gi5.s5_im beta|)) (4 * (b ^ 2))).mp
        rw [nat_of_int_abs_eq (gi5.s5_im beta), him_b, cast_mul.int 4 (b ^ 2), cast_pow.int b 2]
        have h4c : ((4 : ℕ) : ℤ) = 4 := by decide; rw [h4c]
        have hnn : 0 ≤ 4 * (b : ℤ) ^ 2 := by nlinarith
        obtain ⟨e, _⟩ | ⟨_, hn⟩ := abs_cases.int (4 * (b : ℤ) ^ 2); exact e; linarith
      rw [him_nat] at hpim
      have hp_b2 : p ∣ (b ^ 2)
        obtain hd4 | hdb2 := hp.2 4 (b ^ 2) hpim; (exfalso; exact hp_nd4 hd4); exact hdb2
      have hp_b : p ∣ b := prime_dvd_of_dvd_pow.nat p b 2 (is_prime_nat.to_prime p hp) hp_b2
      set na := nat_of_int (|a|) with hna_def
      have ha2_eq : a ^ 2 = ((na ^ 2 : ℕ) : ℤ) := by rw [hna_def]; exact (int.nat_abs_sq_eq a).symm
      have hre_nat : nat_of_int (|gi5.s5_re beta|) = 2 * (na ^ 2 + 5 * b ^ 2)
        apply (cast_inj.int (nat_of_int (|gi5.s5_re beta|)) (2 * (na ^ 2 + 5 * b ^ 2))).mp
        rw [nat_of_int_abs_eq (gi5.s5_re beta), hre_b, cast_mul.int 2 (na ^ 2 + 5 * b ^ 2), cast_add.int (na ^ 2) (5 * b ^ 2), cast_mul.int 5 (b ^ 2), cast_pow.int b 2, ← ha2_eq]
        have h2c : ((2 : ℕ) : ℤ) = 2 := by decide
        have h5c : ((5 : ℕ) : ℤ) = 5 := by decide
        rw [h2c, h5c]
        have hnn : 0 ≤ 2 * (a ^ 2 + 5 * (b : ℤ) ^ 2) := by nlinarith
        obtain ⟨e, _⟩ | ⟨_, hn⟩ := abs_cases.int (2 * (a ^ 2 + 5 * (b : ℤ) ^ 2)); exact e; linarith
      rw [hre_nat] at hpre
      have hp_sum : p ∣ (na ^ 2 + 5 * b ^ 2)
        obtain hd2 | hds := hp.2 2 (na ^ 2 + 5 * b ^ 2) hpre; (exfalso; exact hp_nd2 hd2); exact hds
      obtain ⟨qpb, hqpb⟩ := (dvd.iff_exists p b (by omega)).mp hp_b
      have hp_na2 : p ∣ (na ^ 2)
        apply nat.dvd_left_of_dvd_add p (na ^ 2) (5 * b ^ 2) (by omega)
        · exact hp_sum
        · exact nat.dvd_of_mul_eq p (5 * p * qpb * qpb) (5 * b ^ 2) (by omega) (by rw [hqpb]; ring)
      have hp_na : p ∣ na := prime_dvd_of_dvd_pow.nat p na 2 (is_prime_nat.to_prime p hp) hp_na2
      unfold nat.coprime_primes at hcop_ab
      exact hcop_ab p hp ⟨hp_na, hp_b⟩
    obtain ⟨delta, hbeta_d, hnorm_d, hcop_d⟩ := gi5.fifth_of_norm_pow5 beta t hnorm_b ht_pos ht_odd ht_nd5 hb5_mod hno_odd_p
    have hcoords := gi5.s5_fifth_coords delta
    rw [← hbeta_d, him_b] at hcoords
    -- Show delta.b is EVEN: if delta.b % 2 = 1, s5_re(delta) % 2 = 1, forcing 64*b^2 = 5*B*16*Q_odd => 4*b^2 odd!
    have hdb_even : delta.b % 2 = 0
      by_contra hodd
      have h0 : 0 ≤ delta.b % 2 := mod_nonneg.int delta.b 2 (by decide)
      have hlt : delta.b % 2 < 2 := mod_lt.int delta.b 2 (by decide)
      have hdb1 : delta.b % 2 = 1 := by omega
      have hdre1 : (gi5.s5_re delta) % 2 = 1
        have he : gi5.s5_re delta = delta.b + 2 * delta.a := by unfold gi5.s5_re; ring
        rw [he, add_mul_mod.int delta.b delta.a 2 (by decide), hdb1]
      obtain ⟨Qodd, _, hQ16, hQodd1, _⟩ := int.odd_quartic_div16 (gi5.s5_re delta) (gi5.s5_im delta) hdre1 (by unfold gi5.s5_im; exact hdb1)
      have h64 : 64 * (b : ℤ) ^ 2 = 16 * (5 * delta.b * Qodd)
        have hc2 := hcoords.2
        unfold gi5.s5_im at hc2 hQ16
        rw [hQ16] at hc2; linarith
      have h4b : 4 * (b : ℤ) ^ 2 = 5 * delta.b * Qodd := by linarith
      have hl_mod : (4 * (b : ℤ) ^ 2) % 2 = 0
        have he : 4 * (b : ℤ) ^ 2 = 0 + 2 * (2 * (b : ℤ) ^ 2) := by ring
        rw [he, add_mul_mod.int 0 (2 * (b : ℤ) ^ 2) 2 (by decide)]
        exact (div_mod_of_lt.int 0 2 (by decide) (by decide)).2
      have hr_mod : (5 * delta.b * Qodd) % 2 = 1
        have hd_b := div_add_mod.int delta.b 2; rw [hdb1] at hd_b
        have hd_q := div_add_mod.int Qodd 2; rw [hQodd1] at hd_q
        set kb := delta.b / 2; set kq := Qodd / 2
        have heb : delta.b = 2 * kb + 1 := by linarith
        have heq : Qodd = 2 * kq + 1 := by linarith
