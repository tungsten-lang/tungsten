        · exact nat.dvd_of_mul_eq p (16 * qQ) (na2 ^ 4 + b2 * (10 * na2 ^ 2 * b2 + 5 * b2 ^ 3)) (by omega) (by rw [← h16Q2_na2, hqQ]; ring)
        · exact nat.dvd_of_mul_eq p (qb_p * (10 * na2 ^ 2 * b2 + 5 * b2 ^ 3)) (b2 * (10 * na2 ^ 2 * b2 + 5 * b2 ^ 3)) (by omega) (by rw [hqb_p]; ring)
      have hp_na2 : p ∣ na2 := prime_dvd_of_dvd_pow.nat p na2 4 (is_prime_nat.to_prime p hp) hp_na2_4
      unfold nat.coprime_primes at hcop_a2_b2
      exact hcop_a2_b2 p hp ⟨hp_na2, hpb2⟩
    have heq_nat : (5 * b2) * Q2 = 2 ^ 0 * 5 ^ (2 * nu) * (r ^ 2) ^ 5
      have hl_eq : (5 * b2) * Q2 = b ^ 2
        apply (cast_inj.int ((5 * b2) * Q2) (b ^ 2)).mp
        rw [cast_mul.int (5 * b2) Q2, cast_mul.int 5 b2, cast_pow.int b 2, hb2_eq_z, hQ2_eq_z]
        have h5c : ((5 : ℕ) : ℤ) = 5 := by decide; rw [h5c]; linarith
      rw [hl_eq, hb_eq, hmu0]
      have h20 : 2 ^ 0 = 1 := by decide
      have h5n : (5 ^ nu) ^ 2 = 5 ^ (2 * nu)
        have hexp : 2 * nu = nu + nu := by omega
        rw [hexp, pow_add.nat 5 nu nu]; ring
      rw [h20]
      calc (1 * 5 ^ nu * r ^ 5) ^ 2 = (5 ^ nu) ^ 2 * (r ^ 5) ^ 2 := by ring
        _ = 1 * 5 ^ (2 * nu) * (r ^ 2) ^ 5 := by rw [h5n]; ring
    obtain ⟨r', t', hr'_pos, ht'_pos, ht'_odd, ht'_nd5, hb2_split, hQ2_split⟩ :=
      nat.split_two_five_pow5 b2 Q2 0 (2 * nu) (r ^ 2) hb2_pos hQ2_pos (pow_pos.nat r 2 (by omega)) (by omega) hQ2_odd hQ2_nd5 hcop_b2_Q2 heq_nat
    -- Strict descent t' < t: 16 * t'^5 = 16 * Q2 <= 16 * (5 * b2) * Q2 = 16 * b^2 < 5 * b^4 <= 16 * t^5!
    have ht'_lt_t : t' < t
      have ht'5_lt_t5 : t' ^ 5 < t ^ 5
        have h1 : Q2 ≤ (5 * b2) * Q2
          have hm := mul_le_mul_of_nonneg_right.nat 1 (5 * b2) Q2 (by omega) (by omega)
          omega
        have h2 : (5 * b2) * Q2 = b ^ 2
          apply (cast_inj.int ((5 * b2) * Q2) (b ^ 2)).mp
          rw [cast_mul.int (5 * b2) Q2, cast_mul.int 5 b2, cast_pow.int b 2, hb2_eq_z, hQ2_eq_z]
          have h5c : ((5 : ℕ) : ℤ) = 5 := by decide; rw [h5c]; linarith
        have h3 : (16 * b ^ 2 : ℕ) < 5 * b ^ 4
          have hb2_25 : 25 ≤ b ^ 2
            have hm := mul_le_mul_of_nonneg_left.nat 5 b b hb_ge5 (by omega)
            have hm2 := mul_le_mul_of_nonneg_right.nat 5 b 5 hb_ge5 (by decide)
            have hs : b * b = b ^ 2 := by ring
            omega
          have hb4_eq : b ^ 4 = b ^ 2 * b ^ 2 := by ring
          have hb4_ge : 25 * b ^ 2 ≤ b ^ 4
            have hm3 := mul_le_mul_of_nonneg_right.nat 25 (b ^ 2) (b ^ 2) hb2_25 (by omega)
            omega
          omega
        have h4 : (5 * b ^ 4 : ℕ) ≤ 16 * t ^ 5
          apply (cast_le.int (5 * b ^ 4) (16 * t ^ 5)).mp
          rw [cast_mul.int 5 (b ^ 4), cast_pow.int b 4, cast_mul.int 16 (t ^ 5), cast_pow.int t 5]
          have h5c : ((5 : ℕ) : ℤ) = 5 := by decide; have h16c : ((16 : ℕ) : ℤ) = 16 := by decide
          rw [h5c, h16c, ← hquart_od]
          have ha4_nn : 0 ≤ a ^ 4 := by have s : a ^ 4 = (a ^ 2) * (a ^ 2) := by ring; rw [s]; nlinarith
          have hab_nn : 0 ≤ a ^ 2 * (b : ℤ) ^ 2 := mul_nonneg.int (a ^ 2) ((b : ℤ) ^ 2) (by nlinarith) (by nlinarith)
          linarith
        omega
      by_contra hge
      have hpow_ge := nat.pow_mono_base 5 t t' (by omega)
      omega
    have hquart_new : a2 ^ 4 + 10 * a2 ^ 2 * (b2 : ℤ) ^ 2 + 5 * (b2 : ℤ) ^ 4 = 16 * (t' : ℤ) ^ 5
      rw [hb2_eq_z, hQ2_16, ← hQ2_eq_z, hQ2_split, cast_pow.int t' 5]
    use t'
    unfold dirichlet.state_at
    exact ⟨ht'_lt_t, ⟨ht'_pos, ht'_odd, ht'_nd5, ⟨a2, b2, 0, 2 * nu - 1, r', ha2_odd, hb2_pos, by omega, hr'_pos, hb2_split, hcop_a2_b2, by right; exact ⟨by ring, hquart_new⟩⟩⟩⟩

-- THEOREM 4A (DIRICHLET-LEGENDRE QUARTIC FIFTH-POWER IMPOSSIBILITY — 0 CUSTOM AXIOMS!):
+ dirichlet.quartic_fifth_descent (t : ℕ) (hst : dirichlet.state_at t) : False
  exact nat.infinite_descent dirichlet.state_at dirichlet.quartic_fifth_descent_step t hst


-- ====================================================================================
-- 5. Mod-25 Case I, Signed Case-II Step 0, Complete FLT(5), & Reduction to Primes >= 7
-- ====================================================================================

+ nat.flt5_div5_of_sum (x y z : ℕ) (heq : x ^ 5 + y ^ 5 = z ^ 5) :
    x % 5 = 0 ∨ y % 5 = 0 ∨ z % 5 = 0
  by_contra hnone
  have hx5 : x % 5 ≠ 0 := by intro h; apply hnone; left; exact h
  have hy5 : y % 5 ≠ 0 := by intro h; apply hnone; right; left; exact h
  have hz5 : z % 5 ≠ 0 := by intro h; apply hnone; right; right; exact h
  have hlt_x := mod_lt.nat x 5 (by decide)
  have hlt_y := mod_lt.nat y 5 (by decide)
  have hlt_z := mod_lt.nat z 5 (by decide)
  have hdx := div_add_mod.nat x 5
  have hdy := div_add_mod.nat y 5
  have hdz := div_add_mod.nat z 5
  set qx := x / 5; set rx := x % 5
  set qy := y / 5; set ry := y % 5
  set qz := z / 5; set rz := z % 5
  have hx_eq : x = 5 * qx + rx := by omega
  have hy_eq : y = 5 * qy + ry := by omega
  have hz_eq : z = 5 * qz + rz := by omega
  have hlhs25 : (x ^ 5 + y ^ 5) % 25 = (rx ^ 5 + ry ^ 5) % 25
    set Kxy := 125 * qx ^ 5 + 125 * qx ^ 4 * rx + 50 * qx ^ 3 * rx ^ 2 + 10 * qx ^ 2 * rx ^ 3 + qx * rx ^ 4 +
               125 * qy ^ 5 + 125 * qy ^ 4 * ry + 50 * qy ^ 3 * ry ^ 2 + 10 * qy ^ 2 * ry ^ 3 + qy * ry ^ 4 with hKxy_def
    have hexp : x ^ 5 + y ^ 5 = (rx ^ 5 + ry ^ 5) + 25 * Kxy := by rw [hx_eq, hy_eq, hKxy_def]; ring
    rw [hexp, add_mul_mod.nat (rx ^ 5 + ry ^ 5) Kxy 25]
  have hrhs25 : (z ^ 5) % 25 = (rz ^ 5) % 25
    set Kz := 125 * qz ^ 5 + 125 * qz ^ 4 * rz + 50 * qz ^ 3 * rz ^ 2 + 10 * qz ^ 2 * rz ^ 3 + qz * rz ^ 4 with hKz_def
    have hexp : z ^ 5 = rz ^ 5 + 25 * Kz := by rw [hz_eq, hKz_def]; ring
    rw [hexp, add_mul_mod.nat (rz ^ 5) Kz 25]
  have hmod25 : (rx ^ 5 + ry ^ 5) % 25 = (rz ^ 5) % 25
    rw [← hlhs25, heq, hrhs25]
  have hall : ∀ i < 5, ∀ j < 5, ∀ k < 5,
      i ≠ 0 → j ≠ 0 → k ≠ 0 → (i ^ 5 + j ^ 5) % 25 ≠ (k ^ 5) % 25 := by decide
  exact hall rx hlt_x ry hlt_y rz hlt_z hx5 hy5 hz5 hmod25

+ flt.exp_five_case1 (x y z : ℕ)
    (hx5 : x % 5 ≠ 0) (hy5 : y % 5 ≠ 0) (hz5 : z % 5 ≠ 0) :
    x ^ 5 + y ^ 5 ≠ z ^ 5
  intro heq
  obtain h1 | h2 | h3 := nat.flt5_div5_of_sum x y z heq
  · exact hx5 h1
  · exact hy5 h2
  · exact hz5 h3

+ int.odd_step0_div16 (D w : ℤ) (hD : D % 2 = 1) (hw : w % 2 = 1) :
    ∃ Q0 M0 : ℤ,
      D ^ 4 + 50 * D ^ 2 * w ^ 2 + 125 * w ^ 4 = 16 * Q0 ∧
      Q0 % 2 = 1 ∧
      D ^ 2 + 15 * w ^ 2 = 4 * M0
  obtain ⟨kD, hkD⟩ := int.odd_sq_mod8 D hD
  obtain ⟨kw, hkw⟩ := int.odd_sq_mod8 w hw
  set K0 := 5 + 13 * kD + 75 * kw + 2 * kD * kD + 100 * kD * kw + 250 * kw * kw with hK0_def
  use 1 + 2 * K0, 4 + 2 * kD + 30 * kw
  have hq_id : D ^ 4 + 50 * D ^ 2 * w ^ 2 + 125 * w ^ 4 = 16 * (1 + 2 * K0)
    have hD2 : D ^ 2 = 1 + 8 * kD := by have s : D ^ 2 = D * D := by ring; rw [s, hkD]
    have hw2 : w ^ 2 = 1 + 8 * kw := by have s : w ^ 2 = w * w := by ring; rw [s, hkw]
    have hD4 : D ^ 4 = (D ^ 2) * (D ^ 2) := by ring
    have hw4 : w ^ 4 = (w ^ 2) * (w ^ 2) := by ring
    rw [hD4, hw4, hD2, hw2, hK0_def]; ring
  have hq_odd : (1 + 2 * K0) % 2 = 1
    rw [add_mul_mod.int 1 K0 2 (by decide)]
    exact (div_mod_of_lt.int 1 2 (by decide) (by decide)).2
  have hm_id : D ^ 2 + 15 * w ^ 2 = 4 * (4 + 2 * kD + 30 * kw)
    have hD2 : D ^ 2 = 1 + 8 * kD := by have s : D ^ 2 = D * D := by ring; rw [s, hkD]
    have hw2 : w ^ 2 = 1 + 8 * kw := by have s : w ^ 2 = w * w := by ring; rw [s, hkw]
    rw [hD2, hw2]; ring
  exact ⟨hq_id, hq_odd, hm_id⟩

-- Step 0 Even Branch (Z even, m >= 1):
+ dirichlet.step0_even (v0 : ℤ) (w0 Q0 m k c : ℕ)
    (hv0_odd : v0 % 2 = 1)
    (hv0_nd5 : nat_of_int (|v0|) % 5 ≠ 0)
    (hw0_pos : 0 < w0) (hw0_even : w0 % 2 = 0)
    (hm : 1 ≤ m) (hk : 1 ≤ k) (hc_pos : 1 ≤ c)
    (hcop_vw : nat.coprime_primes (nat_of_int (|v0|)) w0)
    (hQ0_pos : 0 < Q0) (hQ0_odd : Q0 % 2 = 1)
    (hQ0_eq : (Q0 : ℤ) = v0 ^ 4 + 50 * v0 ^ 2 * (w0 : ℤ) ^ 2 + 125 * (w0 : ℤ) ^ 4)
    (heq0 : (5 * w0) * Q0 = 2 ^ (5 * m - 1) * 5 ^ (5 * k - 1) * c ^ 5) :
    False
  have hQ0_nd5 : Q0 % 5 ≠ 0
    intro hd5
    obtain ⟨k5, hk5⟩ := (dvd.iff_exists 5 Q0 (by decide)).mp hd5
    set nv0 := nat_of_int (|v0|) with hnv0_def
    have hnv0_4 : ((nv0 ^ 4 : ℕ) : ℤ) = v0 ^ 4 := by rw [hnv0_def]; exact int.nat_abs_pow4_eq v0
    have hnv0_2 : ((nv0 ^ 2 : ℕ) : ℤ) = v0 ^ 2 := by rw [hnv0_def]; exact int.nat_abs_sq_eq v0
    have hQ0_nv : Q0 = nv0 ^ 4 + 5 * (10 * nv0 ^ 2 * w0 ^ 2 + 25 * w0 ^ 4)
      apply (cast_inj.int Q0 (nv0 ^ 4 + 5 * (10 * nv0 ^ 2 * w0 ^ 2 + 25 * w0 ^ 4))).mp
      rw [hQ0_eq, cast_add.int (nv0 ^ 4) (5 * (10 * nv0 ^ 2 * w0 ^ 2 + 25 * w0 ^ 4)), hnv0_4,
          cast_mul.int 5 (10 * nv0 ^ 2 * w0 ^ 2 + 25 * w0 ^ 4),
          cast_add.int (10 * nv0 ^ 2 * w0 ^ 2) (25 * w0 ^ 4),
          cast_mul.int (10 * nv0 ^ 2) (w0 ^ 2), cast_mul.int 10 (nv0 ^ 2), hnv0_2,
          cast_mul.int 25 (w0 ^ 4), cast_pow.int w0 2, cast_pow.int w0 4]
      have h5c : ((5 : ℕ) : ℤ) = 5 := by decide
      have h10c : ((10 : ℕ) : ℤ) = 10 := by decide
      have h25c : ((25 : ℕ) : ℤ) = 25 := by decide
      rw [h5c, h10c, h25c]; ring
    have h5_nv4 : 5 ∣ (nv0 ^ 4)
      apply nat.dvd_left_of_dvd_add 5 (nv0 ^ 4) (5 * (10 * nv0 ^ 2 * w0 ^ 2 + 25 * w0 ^ 4)) (by decide)
      · rw [← hQ0_nv]; exact hd5
      · exact nat.dvd_of_mul_eq 5 (10 * nv0 ^ 2 * w0 ^ 2 + 25 * w0 ^ 4) (5 * (10 * nv0 ^ 2 * w0 ^ 2 + 25 * w0 ^ 4)) (by decide) (by ring)
    have h5_nv : 5 ∣ nv0 := prime_dvd_of_dvd_pow.nat 5 nv0 4 (is_prime_nat.to_prime 5 is_prime_nat_five) h5_nv4
    unfold dvd at h5_nv; exact hv0_nd5 h5_nv
  have hcop_w0_Q0 : nat.coprime_primes w0 Q0
    unfold nat.coprime_primes
    intro p hp hboth
    obtain ⟨hpw0, hpQ0⟩ := hboth
    set nv0 := nat_of_int (|v0|) with hnv0_def
    have hnv0_4 : ((nv0 ^ 4 : ℕ) : ℤ) = v0 ^ 4 := by rw [hnv0_def]; exact int.nat_abs_pow4_eq v0
    have hnv0_2 : ((nv0 ^ 2 : ℕ) : ℤ) = v0 ^ 2 := by rw [hnv0_def]; exact int.nat_abs_sq_eq v0
    have hQ0_nv : Q0 = nv0 ^ 4 + w0 * (50 * nv0 ^ 2 * w0 + 125 * w0 ^ 3)
      apply (cast_inj.int Q0 (nv0 ^ 4 + w0 * (50 * nv0 ^ 2 * w0 + 125 * w0 ^ 3))).mp
      rw [hQ0_eq, cast_add.int (nv0 ^ 4) (w0 * (50 * nv0 ^ 2 * w0 + 125 * w0 ^ 3)), hnv0_4,
          cast_mul.int w0 (50 * nv0 ^ 2 * w0 + 125 * w0 ^ 3),
          cast_add.int (50 * nv0 ^ 2 * w0) (125 * w0 ^ 3),
          cast_mul.int (50 * nv0 ^ 2) w0, cast_mul.int 50 (nv0 ^ 2), hnv0_2,
          cast_mul.int 125 (w0 ^ 3), cast_pow.int w0 3]
      have h50c : ((50 : ℕ) : ℤ) = 50 := by decide
      have h125c : ((125 : ℕ) : ℤ) = 125 := by decide
      rw [h50c, h125c]; ring
    obtain ⟨qw, hqw⟩ := (dvd.iff_exists p w0 (by linarith [hp.1])).mp hpw0
    have hp_nv4 : p ∣ (nv0 ^ 4)
      apply nat.dvd_left_of_dvd_add p (nv0 ^ 4) (w0 * (50 * nv0 ^ 2 * w0 + 125 * w0 ^ 3)) (by linarith [hp.1])
      · rw [← hQ0_nv]; exact hpQ0
      · exact nat.dvd_of_mul_eq p (qw * (50 * nv0 ^ 2 * w0 + 125 * w0 ^ 3)) (w0 * (50 * nv0 ^ 2 * w0 + 125 * w0 ^ 3)) (by linarith [hp.1]) (by rw [hqw]; ring)
    have hp_nv : p ∣ nv0 := prime_dvd_of_dvd_pow.nat p nv0 4 (is_prime_nat.to_prime p hp) hp_nv4
    unfold nat.coprime_primes at hcop_vw
    exact hcop_vw p hp ⟨hp_nv, hpw0⟩
  obtain ⟨r0, t0, hr0_pos, ht0_pos, ht0_odd, ht0_nd5, hw0_split, hQ0_split⟩ :=
    nat.split_two_five_pow5 w0 Q0 (5 * m - 1) (5 * k - 1) c hw0_pos hQ0_pos (by omega) (by omega) hQ0_odd hQ0_nd5 hcop_w0_Q0 heq0
  set beta0 := GoldenInt.mk (v0 ^ 2 + 15 * (w0 : ℤ) ^ 2) (20 * (w0 : ℤ) ^ 2) with hbeta0_def
  have hre0 : gi5.s5_re beta0 = 2 * (v0 ^ 2 + 25 * (w0 : ℤ) ^ 2)
    rw [hbeta0_def]; unfold gi5.s5_re; simp; ring
  have him0 : gi5.s5_im beta0 = 20 * (w0 : ℤ) ^ 2
    rw [hbeta0_def]; unfold gi5.s5_im; simp
  have hnorm0 : gi5.norm beta0 = (t0 : ℤ) ^ 5
    have h4 := gi5.four_norm beta0
    rw [hre0, him0] at h4
    have hid : 2 * (v0 ^ 2 + 25 * (w0 : ℤ) ^ 2) * (2 * (v0 ^ 2 + 25 * (w0 : ℤ) ^ 2)) - 5 * (20 * (w0 : ℤ) ^ 2 * (20 * (w0 : ℤ) ^ 2))
        = 4 * (v0 ^ 4 + 50 * v0 ^ 2 * (w0 : ℤ) ^ 2 + 125 * (w0 : ℤ) ^ 4) := by ring
    have ht0_z : (Q0 : ℤ) = (t0 : ℤ) ^ 5 := by rw [hQ0_split, cast_pow.int t0 5]
    rw [hid, ← hQ0_eq, ht0_z] at h4; linarith
  have hb0_mod5 : beta0.b % 5 = 0
    have hbb : beta0.b = 0 + 5 * (4 * (w0 : ℤ) ^ 2) := by rw [hbeta0_def]; simp; ring
    rw [hbb, add_mul_mod.int 0 (4 * (w0 : ℤ) ^ 2) 5 (by decide)]
    exact (div_mod_of_lt.int 0 5 (by decide) (by decide)).2
  have hno_odd_p0 : ∀ p : ℕ, is_prime_nat p → 3 ≤ p → p ≠ 5 →
      ¬ (p ∣ nat_of_int (|gi5.s5_re beta0|) ∧ p ∣ nat_of_int (|gi5.s5_im beta0|))
    intro p hp hp3 hp5 hboth
    obtain ⟨hpre, hpim⟩ := hboth
    have hp_nd2 : ¬ (p ∣ 2)
      intro hd2; obtain h1 | h2 := (is_prime_nat.to_full 2 is_prime_nat_two).2 p hd2 <;> omega
    have hp_nd4 : ¬ (p ∣ 4)
      intro hd4; have h22 : 4 = 2 ^ 2 := by decide; rw [h22] at hd4
      have hp2 := prime_dvd_of_dvd_pow.nat p 2 2 (is_prime_nat.to_prime p hp) hd4
      exact hp_nd2 hp2
    have hp_nd5 : ¬ (p ∣ 5)
      intro hd5; obtain h1 | h2 := (is_prime_nat.to_full 5 is_prime_nat_five).2 p hd5 <;> omega
    have hp_nd20 : ¬ (p ∣ 20)
      intro hd20; have h45 : 20 = 4 * 5 := by decide; rw [h45] at hd20
      obtain hd4 | hd5 := hp.2 4 5 hd20; exact hp_nd4 hd4; exact hp_nd5 hd5
    have him_nat : nat_of_int (|gi5.s5_im beta0|) = 20 * (w0 ^ 2)
      apply (cast_inj.int (nat_of_int (|gi5.s5_im beta0|)) (20 * (w0 ^ 2))).mp
      rw [nat_of_int_abs_eq (gi5.s5_im beta0), him0, cast_mul.int 20 (w0 ^ 2), cast_pow.int w0 2]
      have h20c : ((20 : ℕ) : ℤ) = 20 := by decide; rw [h20c]
      have hnn : 0 ≤ 20 * (w0 : ℤ) ^ 2 := by nlinarith
      obtain ⟨e, _⟩ | ⟨_, hn⟩ := abs_cases.int (20 * (w0 : ℤ) ^ 2); exact e; linarith
    rw [him_nat] at hpim
    have hp_w0_2 : p ∣ (w0 ^ 2)
      obtain hd20 | hdw2 := hp.2 20 (w0 ^ 2) hpim; (exfalso; exact hp_nd20 hd20); exact hdw2
    have hp_w0 : p ∣ w0 := prime_dvd_of_dvd_pow.nat p w0 2 (is_prime_nat.to_prime p hp) hp_w0_2
    set nv0 := nat_of_int (|v0|) with hnv0_def
    have hv02_eq : v0 ^ 2 = ((nv0 ^ 2 : ℕ) : ℤ) := by rw [hnv0_def]; exact (int.nat_abs_sq_eq v0).symm
    have hre_nat : nat_of_int (|gi5.s5_re beta0|) = 2 * (nv0 ^ 2 + 25 * w0 ^ 2)
      apply (cast_inj.int (nat_of_int (|gi5.s5_re beta0|)) (2 * (nv0 ^ 2 + 25 * w0 ^ 2))).mp
      rw [nat_of_int_abs_eq (gi5.s5_re beta0), hre0, cast_mul.int 2 (nv0 ^ 2 + 25 * w0 ^ 2),
          cast_add.int (nv0 ^ 2) (25 * w0 ^ 2), cast_mul.int 25 (w0 ^ 2), cast_pow.int w0 2, ← hv02_eq]
      have h2c : ((2 : ℕ) : ℤ) = 2 := by decide; have h25c : ((25 : ℕ) : ℤ) = 25 := by decide
      rw [h2c, h25c]
      have hnn : 0 ≤ 2 * (v0 ^ 2 + 25 * (w0 : ℤ) ^ 2) := by nlinarith
      obtain ⟨e, _⟩ | ⟨_, hn⟩ := abs_cases.int (2 * (v0 ^ 2 + 25 * (w0 : ℤ) ^ 2)); exact e; linarith
    rw [hre_nat] at hpre
    have hp_sum : p ∣ (nv0 ^ 2 + 25 * w0 ^ 2)
      obtain hd2 | hds := hp.2 2 (nv0 ^ 2 + 25 * w0 ^ 2) hpre; (exfalso; exact hp_nd2 hd2); exact hds
    obtain ⟨qpw, hqpw⟩ := (dvd.iff_exists p w0 (by omega)).mp hp_w0
    have hp_nv2 : p ∣ (nv0 ^ 2)
      apply nat.dvd_left_of_dvd_add p (nv0 ^ 2) (25 * w0 ^ 2) (by omega)
      · exact hp_sum
      · exact nat.dvd_of_mul_eq p (25 * p * qpw * qpw) (25 * w0 ^ 2) (by omega) (by rw [hqpw]; ring)
    have hp_nv : p ∣ nv0 := prime_dvd_of_dvd_pow.nat p nv0 2 (is_prime_nat.to_prime p hp) hp_nv2
    unfold nat.coprime_primes at hcop_vw
    exact hcop_vw p hp ⟨hp_nv, hp_w0⟩
  obtain ⟨delta0, hbeta_d0, hnorm_d0, hcop_d0⟩ := gi5.fifth_of_norm_pow5 beta0 t0 hnorm0 ht0_pos ht0_odd ht0_nd5 hb0_mod5 hno_odd_p0
  have hcoords0 := gi5.s5_fifth_coords delta0
  rw [← hbeta_d0, him0] at hcoords0
  have hdb_even : delta0.b % 2 = 0
    by_contra hodd
    have h0 := mod_nonneg.int delta0.b 2 (by decide)
    have hlt := mod_lt.int delta0.b 2 (by decide)
    have hdb1 : delta0.b % 2 = 1 := by omega
    have hdre1 : (gi5.s5_re delta0) % 2 = 1
      have he : gi5.s5_re delta0 = delta0.b + 2 * delta0.a := by unfold gi5.s5_re; ring
      rw [he, add_mul_mod.int delta0.b delta0.a 2 (by decide), hdb1]
    obtain ⟨Qodd, _, hQ16, hQodd1, _⟩ := int.odd_quartic_div16 (gi5.s5_re delta0) (gi5.s5_im delta0) hdre1 (by unfold gi5.s5_im; exact hdb1)
    have h20w : 20 * (w0 : ℤ) ^ 2 = 5 * delta0.b * Qodd
      have hc2 := hcoords0.2
      unfold gi5.s5_im at hc2 hQ16
