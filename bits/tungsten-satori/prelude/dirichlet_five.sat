        obtain ⟨k8, hk8⟩ := int.odd_sq_mod8 (b : ℤ) hb_odd_z
        have hs : (b : ℤ) ^ 2 = 1 + 2 * (4 * k8) := by have s2 : (b : ℤ) ^ 2 = (b : ℤ) * (b : ℤ) := by ring; rw [s2, hk8]; ring
        rw [hs, add_mul_mod.int 1 _ 2 (by decide)]
        exact (div_mod_of_lt.int 1 2 (by decide) (by decide)).2
