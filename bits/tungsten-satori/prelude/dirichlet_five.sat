        rw [hv_2, add_mul_mod.int 0 _ 2 (by decide)]; decide
      have hd_v := div_add_mod.int v0 2; rw [hv0_ev] at hd_v
      set kv := v0 / 2
      have hv_eq : v0 = 2 * kv := by linarith
      have hw_eq : (w0 : ℤ) = 2 * kw + 1 := by linarith
      have hQ0z_odd_bad : Q0_z % 2 = 1
        have hexp : Q0_z = 1 + 2 * (8 * kv ^ 4 + 100 * kv ^ 2 * (2 * kw + 1) ^ 2 + 1000 * kw ^ 4 + 2000 * kw ^ 3 + 1500 * kw ^ 2 + 500 * kw + 62)
          rw [hQ0z_def, hv_eq, hw_eq]; ring
        rw [hexp, add_mul_mod.int 1 _ 2 (by decide)]; decide
      have hQ0_odd_bad : Q0 % 2 = 1
        apply (cast_inj.int (Q0 % 2) 1).mp
        rw [cast_mod.int Q0 2, hQ0_eq_z, h2c, hQ0z_odd_bad]; decide
      have hl_odd : ((5 * w0) * Q0) % 2 = 1
        have hd_q := div_add_mod.nat Q0 2; rw [hQ0_odd_bad] at hd_q
        set qw_n := w0 / 2; set qq_n := Q0 / 2
        have hw_n : w0 = 2 * qw_n + 1 := by omega
        have hq_n : Q0 = 2 * qq_n + 1 := by omega
        have hexp : (5 * w0) * Q0 = 1 + 2 * (10 * qw_n * qq_n + 5 * qw_n + 5 * qq_n + 2) := by rw [hw_n, hq_n]; ring
        rw [hexp, add_mul_mod.nat 1 _ 2]; decide
      have hr_ev : (2 ^ (5 * m - 1) * 5 ^ (5 * k - 1) * c ^ 5) % 2 = 0
        set m2 := 5 * m - 2
        have hm2_eq : 5 * m - 1 = m2 + 1 := by omega
        have he : 2 ^ (5 * m - 1) * 5 ^ (5 * k - 1) * c ^ 5 = 0 + 2 * (2 ^ m2 * 5 ^ (5 * k - 1) * c ^ 5)
