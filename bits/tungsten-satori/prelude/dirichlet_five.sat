      set na := nat_of_int (|a|) with hna_def
      have ha2_eq : a ^ 2 = ((na ^ 2 : ℕ) : ℤ) := by rw [hna_def]; exact (int.nat_abs_sq_eq a).symm
      have h2re_nat : 2 * nat_of_int (|gi5.s5_re beta|) = na ^ 2 + 5 * b ^ 2
        apply (cast_inj.int (2 * nat_of_int (|gi5.s5_re beta|)) (na ^ 2 + 5 * b ^ 2)).mp
        rw [cast_mul.int 2 (nat_of_int (|gi5.s5_re beta|)), nat_of_int_abs_eq (gi5.s5_re beta),
            cast_add.int (na ^ 2) (5 * b ^ 2), cast_mul.int 5 (b ^ 2), cast_pow.int b 2, ← ha2_eq]
        have h2c : ((2 : ℕ) : ℤ) = 2 := by decide; have h5c : ((5 : ℕ) : ℤ) = 5 := by decide
        rw [h2c, h5c]
        have ha2_nn : 0 ≤ a ^ 2 := by nlinarith
        have hb2_nn : 0 ≤ (b : ℤ) ^ 2 := by nlinarith
        have hre_nn : 0 ≤ gi5.s5_re beta := by linarith
        obtain ⟨e, _⟩ | ⟨_, hn⟩ := abs_cases.int (gi5.s5_re beta); (rw [e]; exact h2re_b); linarith
