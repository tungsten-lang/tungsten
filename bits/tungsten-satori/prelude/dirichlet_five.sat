-- Step 0 Odd Branch (Z odd, m = 0):
+ dirichlet.step0_odd (D M0 : ℤ) (w0 Q0 k c : ℕ)
    (hD_odd : D % 2 = 1)
    (hD_nd5 : nat_of_int (|D|) % 5 ≠ 0)
    (hw0_pos : 0 < w0) (hw0_odd : w0 % 2 = 1)
    (hk : 1 ≤ k) (hc_pos : 1 ≤ c)
    (hcop_Dw : ∀ p : ℕ, is_prime_nat p → 3 ≤ p → ¬ (p ∣ nat_of_int (|D|) ∧ p ∣ w0))
    (hQ0_pos : 0 < Q0) (hQ0_odd : Q0 % 2 = 1)
    (hQ0_16 : D ^ 4 + 50 * D ^ 2 * (w0 : ℤ) ^ 2 + 125 * (w0 : ℤ) ^ 4 = 16 * (Q0 : ℤ))
    (hM0_4 : D ^ 2 + 15 * (w0 : ℤ) ^ 2 = 4 * M0)
