      have hw_eq : (w0 : ℤ) = 2 * (qw2 : ℤ)
        rw [hqw2, cast_mul.int 2 qw2]; have h2c : ((2 : ℕ) : ℤ) = 2 := by decide; rw [h2c]
      have hexp : Q0_z = 1 + 2 * (8 * kv ^ 4 + 16 * kv ^ 3 + 12 * kv ^ 2 + 4 * kv + 100 * (2 * kv + 1) ^ 2 * (qw2 : ℤ) ^ 2 + 1000 * (qw2 : ℤ) ^ 4)
