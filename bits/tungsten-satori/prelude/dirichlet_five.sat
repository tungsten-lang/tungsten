    have hb2z_odd : b2_z % 2 = 1
      by_contra hnot1
      have h0 := mod_nonneg.int b2_z 2 (by decide)
      have hlt := mod_lt.int b2_z 2 (by decide)
      have hev : b2_z % 2 = 0 := by omega
      have hd_b2 := div_add_mod.int b2_z 2; rw [hev] at hd_b2
      set kb := b2_z / 2
      have hb2_2 : b2_z = 2 * kb := by linarith
