      exact hcop_XY 2 is_prime_nat_two ⟨h2_nx, h2_ny⟩
    set v0 := X - 5 * (w0 : ℤ) with hv0_def
    have hX_uv : X = 5 * (w0 : ℤ) + v0 := by linarith
    have hY_uv : Y = 5 * (w0 : ℤ) - v0 := by linarith [hXY_10w0, hv0_def]
    have hD_2v0 : D = 2 * v0 := by linarith [hD_def, hX_uv, hY_uv]
    have hsum_50 : X ^ 5 + Y ^ 5 = 50 * (w0 : ℤ) * (v0 ^ 4 + 50 * v0 ^ 2 * (w0 : ℤ) ^ 2 + 125 * (w0 : ℤ) ^ 4)
      rw [hX_uv, hY_uv]; ring
    set Q0_z := v0 ^ 4 + 50 * v0 ^ 2 * (w0 : ℤ) ^ 2 + 125 * (w0 : ℤ) ^ 4 with hQ0z_def
    have hQ0_pos_z : 0 < Q0_z
      have hw_pos_z : (0 : ℤ) < (w0 : ℤ) := (cast_lt.int 0 w0).mpr hw0_pos
      have hw2p := mul_pos.int (w0 : ℤ) (w0 : ℤ) hw_pos_z hw_pos_z
      have hw4p : 0 < (w0 : ℤ) ^ 4 := by have s : (w0 : ℤ) ^ 4 = ((w0 : ℤ) * (w0 : ℤ)) * ((w0 : ℤ) * (w0 : ℤ)) := by ring; rw [s]; exact mul_pos.int ((w0 : ℤ) * (w0 : ℤ)) ((w0 : ℤ) * (w0 : ℤ)) hw2p hw2p
      have hv4 : 0 ≤ v0 ^ 4 := by have s : v0 ^ 4 = (v0 ^ 2) * (v0 ^ 2) := by ring; rw [s]; nlinarith
      have hvw : 0 ≤ v0 ^ 2 * (w0 : ℤ) ^ 2 := mul_nonneg.int (v0 ^ 2) ((w0 : ℤ) ^ 2) (by nlinarith) (by nlinarith)
      rw [hQ0z_def]; linarith
    set Q0 := nat_of_int Q0_z with hQ0_def
    have hQ0_eq_z : (Q0 : ℤ) = Q0_z := by rw [hQ0_def]; exact int_of_nat_of_int Q0_z (by linarith)
    have hQ0_pos : 0 < Q0
      by_contra h0; have hz : Q0 = 0 := by omega; rw [hz, cast_zero.int] at hQ0_eq_z; linarith
    have h50_nat : 50 * w0 * Q0 = Z ^ 5
      apply (cast_inj.int (50 * w0 * Q0) (Z ^ 5)).mp
      rw [cast_mul.int (50 * w0) Q0, cast_mul.int 50 w0, cast_pow.int Z 5, hQ0_eq_z]
      have h50c : ((50 : ℕ) : ℤ) = 50 := by decide; rw [h50c]; linarith
    have heq0 : (5 * w0) * Q0 = 2 ^ (5 * m - 1) * 5 ^ (5 * k - 1) * c ^ 5
      apply nat.mul_cancel_left_pos 10 ((5 * w0) * Q0) (2 ^ (5 * m - 1) * 5 ^ (5 * k - 1) * c ^ 5) (by decide)
      have hl : 10 * ((5 * w0) * Q0) = 50 * w0 * Q0 := by ring
      set m1 := 5 * m - 1; set k1 := 5 * k - 1
      have hm5 : 5 * m = m1 + 1 := by omega
      have hk5 : 5 * k = k1 + 1 := by omega
      have hp2 : 2 ^ (5 * m) = 2 * 2 ^ m1 := by rw [hm5, pow_succ.nat 2 m1]; ring
      have hp5 : 5 ^ (5 * k) = 5 * 5 ^ k1 := by rw [hk5, pow_succ.nat 5 k1]; ring
      have hr : 10 * (2 ^ m1 * 5 ^ k1 * c ^ 5) = 2 ^ (5 * m) * 5 ^ (5 * k) * c ^ 5 := by rw [hp2, hp5]; ring
      rw [hl, hr, ← hZ5_split, h50_nat]
    -- Show w0 % 2 = 0 (since 5*m - 1 >= 4 >= 1 => RHS even, whereas if w0 odd then v0 = X - 5*w0 even => Q0 odd => LHS odd!):
    have hw0_even : w0 % 2 = 0
      by_contra hodd; have hw1 : w0 % 2 = 1 := by omega
      have hd_w := div_add_mod.nat w0 2; rw [hw1] at hd_w
      have hwc : ((2 * (w0 / 2) + 1 : ℕ) : ℤ) = (w0 : ℤ) := by rw [hd_w]
      rw [cast_add.int (2 * (w0 / 2)) 1, cast_mul.int 2 (w0 / 2), cast_one.int] at hwc
      have h2c : ((2 : ℕ) : ℤ) = 2 := by decide; rw [h2c] at hwc
      set kw := ((w0 / 2 : ℕ) : ℤ)
      have hv0_ev : v0 % 2 = 0
        have hd_x := div_add_mod.int X 2; rw [hX_odd] at hd_x
        set kx := X / 2
