      have hb1_abs : nat_of_int (|b1_z|) = b1
        apply (cast_inj.int (nat_of_int (|b1_z|)) b1).mp
        rw [nat_of_int_abs_eq b1_z, hb1_eq_z]
        obtain ⟨e, _⟩ | ⟨_, hn⟩ := abs_cases.int b1_z; exact e; linarith
      rw [← hb1_abs] at hpb1
      exact hcop_d0 p hp hp3 ⟨hpa1, hpb1⟩
  have hcop_b1_Q1 : nat.coprime_primes b1 Q1
    unfold nat.coprime_primes
    intro p hp hboth
    obtain ⟨hpb1, hpQ1⟩ := hboth
    have hp3 : 3 ≤ p := nat.odd_prime_ne_two p hp Q1 hQ1_odd hpQ1
    set na1 := nat_of_int (|a1|) with hna1_def
    have hna1_4 : ((na1 ^ 4 : ℕ) : ℤ) = a1 ^ 4 := by rw [hna1_def]; exact int.nat_abs_pow4_eq a1
    have hna1_2 : ((na1 ^ 2 : ℕ) : ℤ) = a1 ^ 2 := by rw [hna1_def]; exact int.nat_abs_sq_eq a1
    have h16Q1_na1 : 16 * Q1 = na1 ^ 4 + b1 * (10 * na1 ^ 2 * b1 + 5 * b1 ^ 3)
      apply (cast_inj.int (16 * Q1) (na1 ^ 4 + b1 * (10 * na1 ^ 2 * b1 + 5 * b1 ^ 3))).mp
      rw [cast_mul.int 16 Q1, hQ1_eq_z, cast_add.int (na1 ^ 4) (b1 * (10 * na1 ^ 2 * b1 + 5 * b1 ^ 3)),
          hna1_4, cast_mul.int b1 (10 * na1 ^ 2 * b1 + 5 * b1 ^ 3),
          cast_add.int (10 * na1 ^ 2 * b1) (5 * b1 ^ 3), cast_mul.int (10 * na1 ^ 2) b1,
          cast_mul.int 10 (na1 ^ 2), hna1_2, cast_mul.int 5 (b1 ^ 3), cast_pow.int b1 3,
          hb1_eq_z]
      have h16c : ((16 : ℕ) : ℤ) = 16 := by decide; have h10c : ((10 : ℕ) : ℤ) = 10 := by decide; have h5c : ((5 : ℕ) : ℤ) = 5 := by decide
      rw [h16c, h10c, h5c, ← hQ1_16]; ring
    obtain ⟨qQ, hqQ⟩ := (dvd.iff_exists p Q1 (by omega)).mp hpQ1
    obtain ⟨qb_p, hqb_p⟩ := (dvd.iff_exists p b1 (by omega)).mp hpb1
    have hp_na1_4 : p ∣ (na1 ^ 4)
      apply nat.dvd_left_of_dvd_add p (na1 ^ 4) (b1 * (10 * na1 ^ 2 * b1 + 5 * b1 ^ 3)) (by omega)
      · exact nat.dvd_of_mul_eq p (16 * qQ) (na1 ^ 4 + b1 * (10 * na1 ^ 2 * b1 + 5 * b1 ^ 3)) (by omega) (by rw [← h16Q1_na1, hqQ]; ring)
      · exact nat.dvd_of_mul_eq p (qb_p * (10 * na1 ^ 2 * b1 + 5 * b1 ^ 3)) (b1 * (10 * na1 ^ 2 * b1 + 5 * b1 ^ 3)) (by omega) (by rw [hqb_p]; ring)
    have hp_na1 : p ∣ na1 := prime_dvd_of_dvd_pow.nat p na1 4 (is_prime_nat.to_prime p hp) hp_na1_4
    unfold nat.coprime_primes at hcop_a1_b1
    exact hcop_a1_b1 p hp ⟨hp_na1, hpb1⟩
  have heq_nat1 : (5 * b1) * Q1 = 2 ^ 0 * 5 ^ (10 * k - 3) * (r0 ^ 2) ^ 5
    have hl_eq : (5 * b1) * Q1 = 5 * (w0 ^ 2)
      apply (cast_inj.int ((5 * b1) * Q1) (5 * (w0 ^ 2))).mp
      rw [cast_mul.int (5 * b1) Q1, cast_mul.int 5 b1, cast_mul.int 5 (w0 ^ 2), cast_pow.int w0 2, hb1_eq_z, hQ1_eq_z]
      have h5c : ((5 : ℕ) : ℤ) = 5 := by decide; rw [h5c]; linarith
    rw [hl_eq, hw0_split]
    have h20 : 2 ^ 0 = 1 := by decide
    set k2 := 5 * k - 1 - 1 with hk2_def
    have h5k : 5 * (5 ^ k2) ^ 2 = 5 ^ (10 * k - 3)
      have hexp : 10 * k - 3 = (k2 + k2) + 1 := by omega
      rw [hexp, pow_succ.nat 5 (k2 + k2), pow_add.nat 5 k2 k2]; ring
    rw [h20]
    calc 5 * (1 * 5 ^ k2 * r0 ^ 5) ^ 2 = (5 * (5 ^ k2) ^ 2) * (r0 ^ 5) ^ 2 := by ring
      _ = 1 * 5 ^ (10 * k - 3) * (r0 ^ 2) ^ 5 := by rw [h5k]; ring
  obtain ⟨r1, t1, hr1_pos, ht1_pos, ht1_odd, ht1_nd5, hb1_split, hQ1_split⟩ :=
    nat.split_two_five_pow5 b1 Q1 0 (10 * k - 3) (r0 ^ 2) hb1_pos hQ1_pos (pow_pos.nat r0 2 (by omega)) (by omega) hQ1_odd hQ1_nd5 hcop_b1_Q1 heq_nat1
  have hquart1 : a1 ^ 4 + 10 * a1 ^ 2 * (b1 : ℤ) ^ 2 + 5 * (b1 : ℤ) ^ 4 = 16 * (t1 : ℤ) ^ 5
    rw [hb1_eq_z, hQ1_16, ← hQ1_eq_z, hQ1_split, cast_pow.int t1 5]
  have hst1 : dirichlet.state_at t1
    unfold dirichlet.state_at
    exact ⟨ht1_pos, ht1_odd, ht1_nd5, ⟨a1, b1, 0, 10 * k - 3 - 1, r1, ha1_odd, hb1_pos, by omega, hr1_pos, hb1_split, hcop_a1_b1, by right; exact ⟨by ring, hquart1⟩⟩⟩
  exact dirichlet.quartic_fifth_descent t1 hst1

-- Unified Signed Case-II Impossibility (`5 | Z`, `5 nmid |X|, |Y|`, `gcd(|X|, |Y|) = 1`):
+ dirichlet.no_signed_fifth_div5 (X Y : ℤ) (Z : ℕ)
    (hX_nz : X ≠ 0) (hY_nz : Y ≠ 0) (hZ_pos : 0 < Z)
    (hZ5 : Z % 5 = 0)
    (hX5 : nat_of_int (|X|) % 5 ≠ 0)
    (hY5 : nat_of_int (|Y|) % 5 ≠ 0)
    (hcop_XY : nat.coprime_primes (nat_of_int (|X|)) (nat_of_int (|Y|)))
    (hsum5 : X ^ 5 + Y ^ 5 = (Z : ℤ) ^ 5) :
    False
  -- Step A: Show 0 < X + Y and X != Y:
  set Phi5 := X ^ 4 - X ^ 3 * Y + X ^ 2 * Y ^ 2 - X * Y ^ 3 + Y ^ 4 with hPhi5_def
  have hPhi5_pos : 0 < Phi5
    have h2 : 2 * Phi5 = (X ^ 2 + Y ^ 2) * (X - Y) ^ 2 + X ^ 4 + Y ^ 4 := by rw [hPhi5_def]; ring
    have hs1 : 0 ≤ (X ^ 2 + Y ^ 2) * (X - Y) ^ 2 := mul_nonneg.int (X ^ 2 + Y ^ 2) ((X - Y) ^ 2) (by nlinarith) (by nlinarith)
    have hx2 : 0 < X * X := int.sq_pos_of_nz X hX_nz
    have hx4 : 0 < X ^ 4 := by have s : X ^ 4 = (X * X) * (X * X) := by ring; rw [s]; exact mul_pos.int (X * X) (X * X) hx2 hx2
    have hy4 : 0 ≤ Y ^ 4 := by have s : Y ^ 4 = (Y ^ 2) * (Y ^ 2) := by ring; rw [s]; nlinarith
    linarith
  have hfac_sum : (X + Y) * Phi5 = (Z : ℤ) ^ 5 := by rw [← hsum5, hPhi5_def]; ring
  have hZ5_pos_z : (0 : ℤ) < (Z : ℤ) ^ 5
    rw [← cast_pow.int Z 5]
    exact (cast_lt.int 0 (Z ^ 5)).mpr (pow_pos.nat Z 5 hZ_pos)
  have hS_pos : 0 < X + Y
    by_contra hle
    have hn := mul_nonneg.int (-(X + Y)) Phi5 (by linarith) (by linarith)
    linarith
  have hX_ne_Y : X ≠ Y
    intro heq_xy
    rw [heq_xy] at hS_pos hcop_XY hsum5
    have hY_pos : 0 < Y := by linarith
    set ny := nat_of_int (|Y|) with hny_def
    have hny_eq : (ny : ℤ) = Y
      rw [hny_def, nat_of_int_abs_eq Y]
      obtain ⟨e, _⟩ | ⟨_, hn⟩ := abs_cases.int Y; exact e; linarith
    have hny_eq1 : ny = 1
      by_contra hne1
      have hny_pos : 0 < ny := by by_contra h0; have hz : ny = 0 := by omega; rw [hz, cast_zero.int] at hny_eq; linarith
      have hny2 : 2 ≤ ny := by omega
      have hsp := min_fac.spec ny hny2
      have hp_ny : is_prime_nat (min_fac ny) := prime.to_is_prime_nat (min_fac ny) (min_fac.prime ny hny2)
      unfold nat.coprime_primes at hcop_XY
      exact hcop_XY (min_fac ny) hp_ny ⟨hsp.2.2.1, hsp.2.2.1⟩
    have hY1 : Y = 1 := by rw [← hny_eq, hny_eq1]; decide
    rw [hY1] at hsum5
    have hZ5_2 : (Z : ℤ) ^ 5 = 2 := by linarith
    obtain ⟨qz5, hqz5⟩ := (dvd.iff_exists 5 Z (by decide)).mp hZ5
    have hZ_ge5 : 5 ≤ Z
      by_cases hq0 : qz5 = 0; (rw [hq0] at hqz5; omega); omega
    have hpow_ge : 5 ^ 5 ≤ Z ^ 5 := nat.pow_mono_base 5 5 Z hZ_ge5
    have hZ5_nat : Z ^ 5 = 2
      apply (cast_inj.int (Z ^ 5) 2).mp
      rw [cast_pow.int Z 5, hZ5_2]; decide
    have h55 : 5 ^ 5 = 3125 := by decide
    omega
  -- Step B: Factor Z = 2^m * 5^k * c (1 <= k, 1 <= c, c % 2 = 1, c % 5 != 0):
  set m := vp 2 Z with hm_def
  have hsp2 := vp.spec 2 Z (by decide) hZ_pos
  rw [← hm_def] at hsp2
  obtain ⟨Z1, hZ1⟩ := (dvd.iff_exists (2 ^ m) Z (pow_pos.nat 2 m (by decide))).mp hsp2.1
  have hZ1_pos : 0 < Z1
    by_contra h0; have hz : Z1 = 0 := by omega; rw [hz] at hZ1; have hm0 : 2 ^ m * 0 = 0 := by ring; rw [hm0] at hZ1; omega
  have hZ1_odd : Z1 % 2 = 1
    by_contra hev; have h0 : Z1 % 2 = 0 := by omega
    obtain ⟨w, hw⟩ := (dvd.iff_exists 2 Z1 (by decide)).mp h0
    apply hsp2.2
    exact nat.dvd_of_mul_eq (2 ^ (m + 1)) w Z (pow_pos.nat 2 (m + 1) (by decide)) (by rw [pow_succ.nat 2 m, hZ1, hw]; ring)
  have h5_Z1 : 5 ∣ Z1
    have h5_Z : 5 ∣ Z := hZ5
    rw [hZ1] at h5_Z
    obtain h5_2m | h5_z1 := is_prime_nat_five.2 (2 ^ m) Z1 h5_Z
    · exfalso
      have h5_2 := prime_dvd_of_dvd_pow.nat 5 2 m (is_prime_nat.to_prime 5 is_prime_nat_five) h5_2m
      have hnot52 : ¬ (5 ∣ 2) := by decide; exact hnot52 h5_2
    · exact h5_z1
  set k := vp 5 Z1 with hk_def
  have hsp5 := vp.spec 5 Z1 (by decide) hZ1_pos
  rw [← hk_def] at hsp5
  have hk_ge1 : 1 ≤ k
    have h51 : 5 ^ 1 = 5 := by decide
    have hd1 : 5 ^ 1 ∣ Z1 := by rw [h51]; exact h5_Z1
    rw [hk_def]; exact (vp.le_iff_pow_dvd 5 Z1 1 (by decide) hZ1_pos).mpr hd1
  obtain ⟨c, hc_eq⟩ := (dvd.iff_exists (5 ^ k) Z1 (pow_pos.nat 5 k (by decide))).mp hsp5.1
  have hc_pos : 1 ≤ c
    by_contra h0; have hz : c = 0 := by omega; rw [hz] at hc_eq; have hm0 : 5 ^ k * 0 = 0 := by ring; rw [hm0] at hc_eq; omega
  have hc_odd : c % 2 = 1
    by_contra hev; have h0 : c % 2 = 0 := by omega
    obtain ⟨w, hw⟩ := (dvd.iff_exists 2 c (by decide)).mp h0
    have h2_z1 : 2 ∣ Z1 := nat.dvd_of_mul_eq 2 (5 ^ k * w) Z1 (by decide) (by rw [hc_eq, hw]; ring)
    unfold dvd at h2_z1; omega
  have hc_nd5 : c % 5 ≠ 0
    intro hd5
    obtain ⟨w, hw⟩ := (dvd.iff_exists 5 c (by decide)).mp hd5
    apply hsp5.2
    exact nat.dvd_of_mul_eq (5 ^ (k + 1)) w Z1 (pow_pos.nat 5 (k + 1) (by decide)) (by rw [pow_succ.nat 5 k, hc_eq, hw]; ring)
  have hZ5_split : Z ^ 5 = 2 ^ (5 * m) * 5 ^ (5 * k) * c ^ 5
    have hZ_all : Z = (2 ^ m * 5 ^ k) * c := by rw [hZ1, hc_eq]; ring
    have hp2m : (2 ^ m) ^ 5 = 2 ^ (5 * m) := by have hm5 : 5 * m = m * 5 := by ring; rw [hm5]; exact (nat.pow_mul_swap 5 m 2).symm
    have hp5k : (5 ^ k) ^ 5 = 5 ^ (5 * k) := by have hk5 : 5 * k = k * 5 := by ring; rw [hk5]; exact (nat.pow_mul_swap 5 k 5).symm
    rw [hZ_all, nat.mul_pow_eq 5 (2 ^ m * 5 ^ k) c, nat.mul_pow_eq 5 (2 ^ m) (5 ^ k), hp2m, hp5k]
  -- Step C: Show 5 | S_nat where S_nat = nat_of_int (X + Y) > 0:
  set S_nat := nat_of_int (X + Y) with hSnat_def
  have hSnat_eq : (S_nat : ℤ) = X + Y := by rw [hSnat_def]; exact int_of_nat_of_int (X + Y) (by linarith)
  have hSnat_pos : 0 < S_nat
    by_contra h0; have hz : S_nat = 0 := by omega; rw [hz, cast_zero.int] at hSnat_eq; linarith
  have h5_Snat : 5 ∣ S_nat
    obtain ⟨qz, hqz⟩ := (dvd.iff_exists 5 Z (by decide)).mp hZ5
    have hZ_5z : (Z : ℤ) = 5 * (qz : ℤ)
      rw [hqz, cast_mul.int 5 qz]; have h5c : ((5 : ℕ) : ℤ) = 5 := by decide; rw [h5c]
    have hS5_div5 : (S_nat : ℤ) ^ 5 = 5 * (625 * (qz : ℤ) ^ 5 + X * Y * (X + Y) * (X ^ 2 + X * Y + Y ^ 2))
      rw [hSnat_eq]
      have hbin : (X + Y) ^ 5 = (X ^ 5 + Y ^ 5) + 5 * (X * Y * (X + Y) * (X ^ 2 + X * Y + Y ^ 2)) := by ring
      rw [hbin, hsum5, hZ_5z]; ring
    set R5_z := 625 * (qz : ℤ) ^ 5 + X * Y * (X + Y) * (X ^ 2 + X * Y + Y ^ 2) with hR5z_def
    have hR5_nn : 0 ≤ R5_z
      have hs5_nn : (0 : ℤ) ≤ (S_nat : ℤ) ^ 5 := by rw [← cast_pow.int S_nat 5]; exact (cast_le.int 0 (S_nat ^ 5)).mpr (by omega)
      linarith
    set R5_n := nat_of_int R5_z with hR5n_def
    have hR5n_eq : (R5_n : ℤ) = R5_z := by rw [hR5n_def]; exact int_of_nat_of_int R5_z hR5_nn
    have hS5_nat : S_nat ^ 5 = 5 * R5_n
      apply (cast_inj.int (S_nat ^ 5) (5 * R5_n)).mp
      rw [cast_pow.int S_nat 5, cast_mul.int 5 R5_n, hR5n_eq]
      have h5c : ((5 : ℕ) : ℤ) = 5 := by decide; rw [h5c]; exact hS5_div5
    exact prime_dvd_of_dvd_pow.nat 5 S_nat 5 (is_prime_nat.to_prime 5 is_prime_nat_five) (nat.dvd_of_mul_eq 5 R5_n (S_nat ^ 5) (by decide) hS5_nat)
  obtain ⟨U5, hU5⟩ := (dvd.iff_exists 5 S_nat (by decide)).mp h5_Snat
  have hU5_pos : 0 < U5
    by_contra h0; have hz : U5 = 0 := by omega; rw [hz] at hU5; omega
  have hXY_5U5 : X + Y = 5 * (U5 : ℤ)
    rw [← hSnat_eq, hU5, cast_mul.int 5 U5]
    have h5c : ((5 : ℕ) : ℤ) = 5 := by decide; rw [h5c]
  -- Step D: Odd-prime coprimality between U5 and |X - Y| (and hence |X - Y| % 5 != 0):
  set D := X - Y with hD_def
  have hD_nz : D ≠ 0 := by rw [hD_def]; omega
  have hodd_cop_DU5 : ∀ p : ℕ, is_prime_nat p → 3 ≤ p → ¬ (p ∣ nat_of_int (|D|) ∧ p ∣ U5)
    intro p hp hp3 hboth
    obtain ⟨hpD, hpU5⟩ := hboth
    have hp_nd2 : ¬ (p ∣ 2)
      intro hd2; obtain h1 | h2 := (is_prime_nat.to_full 2 is_prime_nat_two).2 p hd2 <;> omega
    obtain ⟨qD, hqD⟩ := (dvd.iff_exists p (nat_of_int (|D|)) (by omega)).mp hpD
    obtain ⟨qU, hqU⟩ := (dvd.iff_exists p U5 (by omega)).mp hpU5
    have hD_abs : |D| = (p : ℤ) * (qD : ℤ)
      rw [← nat_of_int_abs_eq D, hqD, cast_mul.int p qD]
    have hD_signed : ∃ sD : ℤ, D = (p : ℤ) * sD
      obtain ⟨e, _⟩ | ⟨e, _⟩ := abs_cases.int D
      · exact ⟨(qD : ℤ), by linarith⟩
      · exact ⟨-(qD : ℤ), by linarith⟩
    obtain ⟨sD, hsD⟩ := hD_signed
    have hS_p : X + Y = (p : ℤ) * (5 * (qU : ℤ))
      rw [hXY_5U5, hqU, cast_mul.int p qU]; ring
    have h2X : 2 * X = (p : ℤ) * (5 * (qU : ℤ) + sD) := by linarith [hD_def, hsD, hS_p]
    have h2Y : 2 * Y = (p : ℤ) * (5 * (qU : ℤ) - sD) := by linarith [hD_def, hsD, hS_p]
    set kX := nat_of_int (|5 * (qU : ℤ) + sD|) with hkX_def
    have hkX_eq : (kX : ℤ) = |5 * (qU : ℤ) + sD| := by rw [hkX_def]; exact nat_of_int_abs_eq (5 * (qU : ℤ) + sD)
    have h2X_nat : 2 * nat_of_int (|X|) = p * kX
      apply (cast_inj.int (2 * nat_of_int (|X|)) (p * kX)).mp
      rw [cast_mul.int 2 (nat_of_int (|X|)), cast_mul.int p kX, nat_of_int_abs_eq X, hkX_eq]
      have h2c : ((2 : ℕ) : ℤ) = 2 := by decide; have h2a : |(2 : ℤ)| = 2 := by decide
      have hpa : |(p : ℤ)| = (p : ℤ)
        have hp0 : (0 : ℤ) ≤ (p : ℤ) := (cast_le.int 0 p).mpr (by omega)
        obtain ⟨ep, _⟩ | ⟨_, hn⟩ := abs_cases.int (p : ℤ); exact ep; linarith
      rw [h2c, ← h2a, ← gi5.abs_mul_eq, h2X, gi5.abs_mul_eq, hpa]
    have hp_X : p ∣ nat_of_int (|X|)
      obtain hd2 | hdX := hp.2 2 (nat_of_int (|X|)) (nat.dvd_of_mul_eq p kX (2 * nat_of_int (|X|)) (by omega) h2X_nat)
      · exfalso; exact hp_nd2 hd2
      · exact hdX
    set kY := nat_of_int (|5 * (qU : ℤ) - sD|) with hkY_def
    have hkY_eq : (kY : ℤ) = |5 * (qU : ℤ) - sD| := by rw [hkY_def]; exact nat_of_int_abs_eq (5 * (qU : ℤ) - sD)
    have h2Y_nat : 2 * nat_of_int (|Y|) = p * kY
      apply (cast_inj.int (2 * nat_of_int (|Y|)) (p * kY)).mp
      rw [cast_mul.int 2 (nat_of_int (|Y|)), cast_mul.int p kY, nat_of_int_abs_eq Y, hkY_eq]
      have h2c : ((2 : ℕ) : ℤ) = 2 := by decide; have h2a : |(2 : ℤ)| = 2 := by decide
      have hpa : |(p : ℤ)| = (p : ℤ)
        have hp0 : (0 : ℤ) ≤ (p : ℤ) := (cast_le.int 0 p).mpr (by omega)
        obtain ⟨ep, _⟩ | ⟨_, hn⟩ := abs_cases.int (p : ℤ); exact ep; linarith
      rw [h2c, ← h2a, ← gi5.abs_mul_eq, h2Y, gi5.abs_mul_eq, hpa]
    have hp_Y : p ∣ nat_of_int (|Y|)
      obtain hd2 | hdY := hp.2 2 (nat_of_int (|Y|)) (nat.dvd_of_mul_eq p kY (2 * nat_of_int (|Y|)) (by omega) h2Y_nat)
      · exfalso; exact hp_nd2 hd2
      · exact hdY
    unfold nat.coprime_primes at hcop_XY
    exact hcop_XY p hp ⟨hp_X, hp_Y⟩
  -- Also 5 nmid |D| (if 5 | |D|, since X + Y = 5 * U5, 5 | 2 * |X| => 5 | |X|, contradicting hX5!):
  have hD_nd5 : nat_of_int (|D|) % 5 ≠ 0
    intro hd5
    obtain ⟨qD, hqD⟩ := (dvd.iff_exists 5 (nat_of_int (|D|)) (by decide)).mp hd5
    have hD_abs : |D| = 5 * (qD : ℤ)
      rw [← nat_of_int_abs_eq D, hqD, cast_mul.int 5 qD]
      have h5c : ((5 : ℕ) : ℤ) = 5 := by decide; rw [h5c]
    have hD_signed : ∃ sD : ℤ, D = 5 * sD
      obtain ⟨e, _⟩ | ⟨e, _⟩ := abs_cases.int D
      · exact ⟨(qD : ℤ), by linarith⟩
      · exact ⟨-(qD : ℤ), by linarith⟩
    obtain ⟨sD, hsD⟩ := hD_signed
    have h2X : 2 * X = 5 * ((U5 : ℤ) + sD) := by linarith [hD_def, hsD, hXY_5U5]
    set kX := nat_of_int (|(U5 : ℤ) + sD|) with hkX_def
    have hkX_eq : (kX : ℤ) = |(U5 : ℤ) + sD| := by rw [hkX_def]; exact nat_of_int_abs_eq ((U5 : ℤ) + sD)
    have h2X_nat : 2 * nat_of_int (|X|) = 5 * kX
      apply (cast_inj.int (2 * nat_of_int (|X|)) (5 * kX)).mp
      rw [cast_mul.int 2 (nat_of_int (|X|)), cast_mul.int 5 kX, nat_of_int_abs_eq X, hkX_eq]
      have h2c : ((2 : ℕ) : ℤ) = 2 := by decide; have h2a : |(2 : ℤ)| = 2 := by decide
      have h5c : ((5 : ℕ) : ℤ) = 5 := by decide; have h5a : |(5 : ℤ)| = 5 := by decide
      rw [h2c, h5c, ← h2a, ← gi5.abs_mul_eq, h2X, gi5.abs_mul_eq, h5a]
    obtain hd2 | hdX := is_prime_nat_five.2 2 (nat_of_int (|X|)) (nat.dvd_of_mul_eq 5 kX (2 * nat_of_int (|X|)) (by decide) h2X_nat)
    · have hnot52 : ¬ (5 ∣ 2) := by decide; exact hnot52 hd2
    · unfold dvd at hdX; exact hX5 hdX
  -- Step E: Branch on m = 0 (Z odd) vs 1 <= m (Z even)!
  by_cases hm0 : m = 0
  · -- ========================================================================
    -- CASE m = 0: Z is ODD!
    -- ========================================================================
    have hZ_odd : Z % 2 = 1
      have h20 : 2 ^ 0 = 1 := by decide
      rw [hZ1, hm0, h20]
      have h1z : 1 * Z1 = Z1 := by ring
      rw [h1z]; exact hZ1_odd
    have hZ5_odd : (Z ^ 5) % 2 = 1
      have hd := div_add_mod.nat Z 2; rw [hZ_odd] at hd
      set qz2 := Z / 2
      have hZ_2 : Z = 2 * qz2 + 1 := by omega
      have hexp : Z ^ 5 = 1 + 2 * (16 * qz2 ^ 5 + 40 * qz2 ^ 4 + 40 * qz2 ^ 3 + 20 * qz2 ^ 2 + 5 * qz2) := by rw [hZ_2]; ring
      rw [hexp, add_mul_mod.nat 1 _ 2]; decide
    have hU5_odd : U5 % 2 = 1
      by_contra hev; have h0 : U5 % 2 = 0 := by omega
      obtain ⟨qu, hqu⟩ := (dvd.iff_exists 2 U5 (by decide)).mp h0
      have hS_ev : X + Y = 2 * (5 * (qu : ℤ))
        rw [hXY_5U5, hqu, cast_mul.int 2 qu]; have h2c : ((2 : ℕ) : ℤ) = 2 := by decide; rw [h2c]; ring
      have hZ5_ev_z : ((Z ^ 5 : ℕ) : ℤ) % 2 = 0
        rw [cast_pow.int Z 5, ← hfac_sum, hS_ev]
        have he : 2 * (5 * (qu : ℤ)) * Phi5 = 0 + 2 * (5 * (qu : ℤ) * Phi5) := by ring
        rw [he, add_mul_mod.int 0 _ 2 (by decide)]; decide
      have hc2 := cast_mod.int (Z ^ 5) 2
      have h2c : ((2 : ℕ) : ℤ) = 2 := by decide
      rw [h2c, hZ5_odd, hZ5_ev_z] at hc2; omega
    have hU5_odd_z : (U5 : ℤ) % 2 = 1
      have hd := div_add_mod.nat U5 2; rw [hU5_odd] at hd
      have hc : ((2 * (U5 / 2) + 1 : ℕ) : ℤ) = (U5 : ℤ) := by rw [hd]
      rw [cast_add.int (2 * (U5 / 2)) 1, cast_mul.int 2 (U5 / 2), cast_one.int] at hc
      have h2c : ((2 : ℕ) : ℤ) = 2 := by decide; rw [h2c] at hc
      have he : (U5 : ℤ) = 1 + 2 * ((U5 / 2 : ℕ) : ℤ) := by linarith
      rw [he, add_mul_mod.int 1 _ 2 (by decide)]; decide
    have hD_odd : D % 2 = 1
      have he : D = (U5 : ℤ) + 2 * (2 * (U5 : ℤ) - Y) := by linarith [hD_def, hXY_5U5]
      rw [he, add_mul_mod.int (U5 : ℤ) _ 2 (by decide), hU5_odd_z]
    obtain ⟨Q0_z, M0, hQ0_16, hQ0z_odd, hM0_4⟩ := int.odd_step0_div16 D (U5 : ℤ) hD_odd hU5_odd_z
    have hQ0_pos_z : 0 < Q0_z
      have hs2 := int.sq_pos_of_nz D hD_nz
      have hs4 : 0 < D ^ 4 := by have s : D ^ 4 = (D * D) * (D * D) := by ring; rw [s]; exact mul_pos.int (D * D) (D * D) hs2 hs2
      have hu4 : 0 ≤ (U5 : ℤ) ^ 4 := by have s : (U5 : ℤ) ^ 4 = ((U5 : ℤ) ^ 2) * ((U5 : ℤ) ^ 2) := by ring; rw [s]; nlinarith
      have hdu : 0 ≤ D ^ 2 * (U5 : ℤ) ^ 2 := mul_nonneg.int (D ^ 2) ((U5 : ℤ) ^ 2) (by nlinarith) (by nlinarith)
      linarith
    set Q0 := nat_of_int Q0_z with hQ0_def
    have hQ0_eq_z : (Q0 : ℤ) = Q0_z := by rw [hQ0_def]; exact int_of_nat_of_int Q0_z (by linarith)
    have hQ0_pos : 0 < Q0
      by_contra h0; have hz : Q0 = 0 := by omega; rw [hz, cast_zero.int] at hQ0_eq_z; linarith
    have hQ0_odd : Q0 % 2 = 1
      apply (cast_inj.int (Q0 % 2) 1).mp
      rw [cast_mod.int Q0 2, hQ0_eq_z]
      have h2c : ((2 : ℕ) : ℤ) = 2 := by decide
      rw [h2c, hQ0z_odd]; decide
    have h16_sum : 16 * (X ^ 5 + Y ^ 5) = 25 * (U5 : ℤ) * (D ^ 4 + 50 * D ^ 2 * (U5 : ℤ) ^ 2 + 125 * (U5 : ℤ) ^ 4)
      have h2X : 2 * X = 5 * (U5 : ℤ) + D := by linarith [hD_def, hXY_5U5]
      have h2Y : 2 * Y = 5 * (U5 : ℤ) - D := by linarith [hD_def, hXY_5U5]
      have h32 : 32 * (X ^ 5 + Y ^ 5) = (2 * X) ^ 5 + (2 * Y) ^ 5 := by ring
      have hrhs : (5 * (U5 : ℤ) + D) ^ 5 + (5 * (U5 : ℤ) - D) ^ 5 =
          2 * (25 * (U5 : ℤ) * (D ^ 4 + 50 * D ^ 2 * (U5 : ℤ) ^ 2 + 125 * (U5 : ℤ) ^ 4)) := by ring
      rw [h2X, h2Y, hrhs] at h32; linarith
    have h25_eq_z : 25 * (U5 : ℤ) * (Q0 : ℤ) = (Z : ℤ) ^ 5
      rw [hQ0_eq_z]; rw [hsum5, hQ0_16] at h16_sum; linarith
    have h25_eq_n : 5 * ((5 * U5) * Q0) = Z ^ 5
      apply (cast_inj.int (5 * ((5 * U5) * Q0)) (Z ^ 5)).mp
      rw [cast_mul.int 5 ((5 * U5) * Q0), cast_mul.int (5 * U5) Q0, cast_mul.int 5 U5, cast_pow.int Z 5]
      have h5c : ((5 : ℕ) : ℤ) = 5 := by decide; rw [h5c]; linarith
    have heq0 : (5 * U5) * Q0 = 2 ^ 0 * 5 ^ (5 * k - 1) * c ^ 5
      apply nat.mul_cancel_left_pos 5 ((5 * U5) * Q0) (2 ^ 0 * 5 ^ (5 * k - 1) * c ^ 5) (by decide)
      rw [h25_eq_n, hZ5_split, hm0]
      set km := 5 * k - 1 with hkm_def
      have hk5_eq : 5 * k = km + 1 := by omega
      have hp5 : 5 ^ (5 * k) = 5 * 5 ^ km := by rw [hk5_eq, pow_succ.nat 5 km]; ring
      have h20 : 2 ^ (5 * 0) = 2 ^ 0 := by decide
      rw [h20, hp5]; ring
    rw [← hQ0_eq_z] at hQ0_16
    exact dirichlet.step0_odd D M0 U5 Q0 k c hD_odd hD_nd5 hU5_pos hU5_odd hk_ge1 hc_pos hodd_cop_DU5 hQ0_pos hQ0_odd hQ0_16 hM0_4 heq0
  · -- ========================================================================
    -- CASE 1 <= m: Z is EVEN!
    -- ========================================================================
    have hm_ge1 : 1 ≤ m := by omega
    have hZ_even : Z % 2 = 0
      set mm := m - 1
      have hm_eq : m = mm + 1 := by omega
      have hZ_2 : Z = 0 + 2 * (2 ^ mm * Z1) := by rw [hZ1, hm_eq, pow_succ.nat 2 mm]; ring
      rw [hZ_2, add_mul_mod.nat 0 _ 2]; decide
    have hZ_ev_z : ((Z : ℤ) ^ 5) % 2 = 0
      obtain ⟨qz2, hqz2⟩ := (dvd.iff_exists 2 Z (by decide)).mp hZ_even
      have hZ2z : (Z : ℤ) = 2 * (qz2 : ℤ)
        rw [hqz2, cast_mul.int 2 qz2]; have h2c : ((2 : ℕ) : ℤ) = 2 := by decide; rw [h2c]
      have he : (Z : ℤ) ^ 5 = 0 + 2 * (16 * (qz2 : ℤ) ^ 5) := by rw [hZ2z]; ring
      rw [he, add_mul_mod.int 0 _ 2 (by decide)]; decide
    -- X and Y cannot have opposite parity (else X + Y odd => X^5 + Y^5 odd), nor both even (by hcop_XY), so BOTH ODD!
    have hU5_even : U5 % 2 = 0
      by_contra hodd; have h1 : U5 % 2 = 1 := by omega
      have hd_u := div_add_mod.nat U5 2; rw [h1] at hd_u
      have hc : ((2 * (U5 / 2) + 1 : ℕ) : ℤ) = (U5 : ℤ) := by rw [hd_u]
      rw [cast_add.int (2 * (U5 / 2)) 1, cast_mul.int 2 (U5 / 2), cast_one.int] at hc
      have h2c : ((2 : ℕ) : ℤ) = 2 := by decide; rw [h2c] at hc
      set qu := ((U5 / 2 : ℕ) : ℤ)
      have hS_odd : X + Y = 2 * (5 * qu + 2) + 1 := by linarith [hXY_5U5, hc]
      have hY_s : Y = 2 * (5 * qu + 2) + 1 - X := by linarith
      set ks := 5 * qu + 2
      have hsum_odd : (X ^ 5 + Y ^ 5) % 2 = 1
        have h0x := mod_nonneg.int X 2 (by decide)
        have hltx := mod_lt.int X 2 (by decide)
        have hdx := div_add_mod.int X 2
        set jx := X / 2
        by_cases hx0 : X % 2 = 0
        · rw [hx0] at hdx
          have hxe : X = 2 * jx := by linarith
          have hye : Y = 2 * (ks - jx) + 1 := by linarith
          set jy := ks - jx
          have hexp : X ^ 5 + Y ^ 5 = 1 + 2 * (16 * jx ^ 5 + 16 * jy ^ 5 + 40 * jy ^ 4 + 40 * jy ^ 3 + 20 * jy ^ 2 + 5 * jy)
            rw [hxe, hye]; ring
          rw [hexp, add_mul_mod.int 1 _ 2 (by decide)]; decide
        · have hx1 : X % 2 = 1 := by omega
          rw [hx1] at hdx
          have hxe : X = 2 * jx + 1 := by linarith
          have hye : Y = 2 * (ks - jx) := by linarith
          set jy := ks - jx
          have hexp : X ^ 5 + Y ^ 5 = 1 + 2 * (16 * jx ^ 5 + 40 * jx ^ 4 + 40 * jx ^ 3 + 20 * jx ^ 2 + 5 * jx + 16 * jy ^ 5)
            rw [hxe, hye]; ring
          rw [hexp, add_mul_mod.int 1 _ 2 (by decide)]; decide
      rw [hsum5] at hsum_odd; omega
    obtain ⟨w0, hw0_u⟩ := (dvd.iff_exists 2 U5 (by decide)).mp hU5_even
    have hw0_pos : 0 < w0
      by_contra h0; have hz : w0 = 0 := by omega; rw [hz] at hw0_u; omega
    have hXY_10w0 : X + Y = 10 * (w0 : ℤ)
      rw [hXY_5U5, hw0_u, cast_mul.int 2 w0]; have h2c : ((2 : ℕ) : ℤ) = 2 := by decide; rw [h2c]; ring
    have hX_odd : X % 2 = 1
      by_contra hnot1
      have h0 := mod_nonneg.int X 2 (by decide); have hlt := mod_lt.int X 2 (by decide)
      have hx_ev : X % 2 = 0 := by omega
      have hd_x := div_add_mod.int X 2; rw [hx_ev] at hd_x
      set kx := X / 2
      have hX_2 : X = 2 * kx := by linarith
      have hY_2 : Y = 2 * (5 * (w0 : ℤ) - kx) := by linarith
      have h2_nx : 2 ∣ nat_of_int (|X|)
        set akx := nat_of_int (|kx|) with hakx_def
        have hakx_eq : (akx : ℤ) = |kx| := by rw [hakx_def]; exact nat_of_int_abs_eq kx
        have he : nat_of_int (|X|) = 2 * akx
          apply (cast_inj.int (nat_of_int (|X|)) (2 * akx)).mp
          rw [nat_of_int_abs_eq X, cast_mul.int 2 akx, hakx_eq, hX_2, gi5.abs_mul_eq]
          have h2c : ((2 : ℕ) : ℤ) = 2 := by decide; have h2a : |(2 : ℤ)| = 2 := by decide
          rw [h2c, h2a]
        exact nat.dvd_of_mul_eq 2 akx (nat_of_int (|X|)) (by decide) he
      have h2_ny : 2 ∣ nat_of_int (|Y|)
        set aky := nat_of_int (|5 * (w0 : ℤ) - kx|) with haky_def
        have haky_eq : (aky : ℤ) = |5 * (w0 : ℤ) - kx| := by rw [haky_def]; exact nat_of_int_abs_eq (5 * (w0 : ℤ) - kx)
        have he : nat_of_int (|Y|) = 2 * aky
          apply (cast_inj.int (nat_of_int (|Y|)) (2 * aky)).mp
          rw [nat_of_int_abs_eq Y, cast_mul.int 2 aky, haky_eq, hY_2, gi5.abs_mul_eq]
          have h2c : ((2 : ℕ) : ℤ) = 2 := by decide; have h2a : |(2 : ℤ)| = 2 := by decide
