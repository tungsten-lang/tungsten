        have he : 16 * (t : ℤ) ^ 5 = 0 + 2 * (8 * (t : ℤ) ^ 5) := by ring
        rw [he, add_mul_mod.int 0 _ 2 (by decide)]
        exact (div_mod_of_lt.int 0 2 (by decide) (by decide)).2
