      have h2c : ((2 : ℕ) : ℤ) = 2 := by decide
      rw [h2c, hQ0z_odd]; decide
    have hv0_nd5 : nat_of_int (|v0|) % 5 ≠ 0
      intro hd5
      obtain ⟨qv5, hqv5⟩ := (dvd.iff_exists 5 (nat_of_int (|v0|)) (by decide)).mp hd5
      have hnD_2 : nat_of_int (|D|) = 5 * (2 * qv5)
        apply (cast_inj.int (nat_of_int (|D|)) (5 * (2 * qv5))).mp
        rw [nat_of_int_abs_eq D, hD_2v0, gi5.abs_mul_eq, ← nat_of_int_abs_eq v0, hqv5, cast_mul.int 5 qv5, cast_mul.int 5 (2 * qv5), cast_mul.int 2 qv5]
        have h2c : ((2 : ℕ) : ℤ) = 2 := by decide; have h2a : |(2 : ℤ)| = 2 := by decide
        have h5c : ((5 : ℕ) : ℤ) = 5 := by decide
        rw [h2c, h2a, h5c]; ring
      exact hD_nd5 (nat.dvd_of_mul_eq 5 (2 * qv5) (nat_of_int (|D|)) (by decide) hnD_2)
    have hcop_vw : nat.coprime_primes (nat_of_int (|v0|)) w0
      unfold nat.coprime_primes
      intro p hp hboth
      obtain ⟨hpv, hpw⟩ := hboth
      by_cases hp2 : p = 2
      · rw [hp2] at hpv
        obtain ⟨qv2, hqv2⟩ := (dvd.iff_exists 2 (nat_of_int (|v0|)) (by decide)).mp hpv
        have hv_ev : v0 % 2 = 0
          have hc := nat_of_int_abs_eq v0
          rw [hqv2, cast_mul.int 2 qv2] at hc
          have h2c : ((2 : ℕ) : ℤ) = 2 := by decide; rw [h2c] at hc
          obtain ⟨e, _⟩ | ⟨e, _⟩ := abs_cases.int v0
          · have he1 : v0 = 0 + 2 * (qv2 : ℤ) := by linarith
            rw [he1, add_mul_mod.int 0 (qv2 : ℤ) 2 (by decide)]; decide
          · have he1 : v0 = 0 + 2 * (-(qv2 : ℤ)) := by linarith
            rw [he1, add_mul_mod.int 0 (-(qv2 : ℤ)) 2 (by decide)]; decide
        omega
      · have hp3 : 3 ≤ p := by linarith [hp.1]
        obtain ⟨qv, hqv⟩ := (dvd.iff_exists p (nat_of_int (|v0|)) (by omega)).mp hpv
        obtain ⟨qw, hqw⟩ := (dvd.iff_exists p w0 (by omega)).mp hpw
        have hnD_2 : nat_of_int (|D|) = p * (2 * qv)
          apply (cast_inj.int (nat_of_int (|D|)) (p * (2 * qv))).mp
          rw [nat_of_int_abs_eq D, hD_2v0, gi5.abs_mul_eq, ← nat_of_int_abs_eq v0, hqv, cast_mul.int p qv, cast_mul.int p (2 * qv), cast_mul.int 2 qv]
          have h2c : ((2 : ℕ) : ℤ) = 2 := by decide; have h2a : |(2 : ℤ)| = 2 := by decide
          rw [h2c, h2a]; ring
        have hp_D_f : p ∣ nat_of_int (|D|) := nat.dvd_of_mul_eq p (2 * qv) (nat_of_int (|D|)) (by omega) hnD_2
        have hp_U5_f : p ∣ U5 := nat.dvd_of_mul_eq p (2 * qw) U5 (by omega) (by rw [hw0_u, hqw]; ring)
        exact hodd_cop_DU5 p hp hp3 ⟨hp_D_f, hp_U5_f⟩
    rw [hQ0z_def] at hQ0_eq_z
    exact dirichlet.step0_even v0 w0 Q0 m k c hv0_odd hv0_nd5 hw0_pos hw0_even hm_ge1 hk_ge1 hc_pos hcop_vw hQ0_pos hQ0_odd hQ0_eq_z heq0

-- Helper: minimize any positive fifth-power counterexample to a pairwise coprime one!
-> fermat5_pos_at (z : ℕ) : Prop :=
  ∃ a b : ℕ, 0 < a ∧ 0 < b ∧ a ^ 5 + b ^ 5 = z ^ 5

+ flt.exists_coprime_counterexample_5 (x y z : ℕ)
    (hx : 0 < x) (hy : 0 < y) (heq : x ^ 5 + y ^ 5 = z ^ 5) :
    ∃ a b z0 : ℕ, 0 < a ∧ 0 < b ∧ 0 < z0 ∧
      nat.coprime_primes a b ∧ nat.coprime_primes z0 b ∧ nat.coprime_primes z0 a ∧
      a ^ 5 + b ^ 5 = z0 ^ 5
  have hex : ∃ z1 : ℕ, fermat5_pos_at z1 := ⟨z, ⟨x, y, hx, hy, heq⟩⟩
  obtain ⟨z0, hz0P, hz0_min⟩ := nat.exists_least fermat5_pos_at hex
  unfold fermat5_pos_at at hz0P
  obtain ⟨a, b, ha, hb, habz⟩ := hz0P
  have hz0_pos : 0 < z0
    by_contra h0; have hzz : z0 = 0 := by omega
    have h05 : 0 ^ 5 = 0 := by decide
    have ha5 := pow_pos.nat a 5 ha
    rw [hzz, h05] at habz; omega
  have ha_le_z0 : a ≤ z0
    by_contra hgt
    have hm := nat.pow_mono_base 5 z0 a (by omega)
    have hb5 := pow_pos.nat b 5 hb
    omega
  have hb_le_z0 : b ≤ z0
    by_contra hgt
    have hm := nat.pow_mono_base 5 z0 b (by omega)
    have ha5 := pow_pos.nat a 5 ha
    omega
  have hcop_ab : nat.coprime_primes a b
    unfold nat.coprime_primes
    intro q hq hboth
    obtain ⟨hqa, hqb⟩ := hboth
    have hq2 : 2 ≤ q := hq.1
    obtain ⟨a1, ha1⟩ := (dvd.iff_exists q a (by omega)).mp hqa
    obtain ⟨b1, hb1⟩ := (dvd.iff_exists q b (by omega)).mp hqb
    have hq_z5 : q ∣ (z0 ^ 5)
      have hfac : z0 ^ 5 = q * (q ^ 4 * (a1 ^ 5 + b1 ^ 5)) := by rw [← habz, ha1, hb1]; ring
      exact nat.dvd_of_mul_eq q (q ^ 4 * (a1 ^ 5 + b1 ^ 5)) (z0 ^ 5) (by omega) hfac
    have hq_z : q ∣ z0 := prime_dvd_of_dvd_pow.nat q z0 5 (is_prime_nat.to_prime q hq) hq_z5
    obtain ⟨z1, hz1⟩ := (dvd.iff_exists q z0 (by omega)).mp hq_z
    have hz1_pos : 0 < z1 := by by_contra h0; have hz : z1 = 0 := by omega; rw [hz] at hz1; have hm0 : q * 0 = 0 := by ring; rw [hm0] at hz1; omega
    have hz1_lt : z1 < z0
      have hge := mul_le_mul_of_nonneg_right.nat 2 q z1 hq2 (by omega)
      rw [← hz1] at hge; omega
    apply hz0_min z1 hz1_lt
    unfold fermat5_pos_at
    have ha1_pos : 0 < a1 := by by_contra h0; have hz : a1 = 0 := by omega; rw [hz] at ha1; have hm0 : q * 0 = 0 := by ring; rw [hm0] at ha1; omega
    have hb1_pos : 0 < b1 := by by_contra h0; have hz : b1 = 0 := by omega; rw [hz] at hb1; have hm0 : q * 0 = 0 := by ring; rw [hm0] at hb1; omega
    have heq1 : a1 ^ 5 + b1 ^ 5 = z1 ^ 5
      apply nat.mul_cancel_left_pos (q ^ 5) (a1 ^ 5 + b1 ^ 5) (z1 ^ 5) (pow_pos.nat q 5 (by omega))
      have hl : q ^ 5 * (a1 ^ 5 + b1 ^ 5) = a ^ 5 + b ^ 5 := by rw [ha1, hb1]; ring
      have hr : q ^ 5 * z1 ^ 5 = z0 ^ 5 := by rw [hz1]; ring
      rw [hl, hr, habz]
    exact ⟨a1, b1, ha1_pos, hb1_pos, heq1⟩
  have hcop_zb : nat.coprime_primes z0 b
    unfold nat.coprime_primes
    intro p hp hboth
    obtain ⟨hpz, hpb⟩ := hboth
    obtain ⟨qz, hqz⟩ := (dvd.iff_exists p z0 (by linarith [hp.1])).mp hpz
    obtain ⟨qb, hqb⟩ := (dvd.iff_exists p b (by linarith [hp.1])).mp hpb
    have h1 : qb ≤ qz := nat.div_le_of_mul_le p qb qz (by linarith [hp.1]) (by rw [← hqb, ← hqz]; exact hb_le_z0)
    have hle5 := nat.pow_mono_base 5 qb qz h1
    have hpa5 : p ∣ (a ^ 5)
      have ha5 : a ^ 5 = z0 ^ 5 - b ^ 5 := by omega
      have he : (qz ^ 5 - qb ^ 5) + qb ^ 5 = qz ^ 5 := by omega
      have hadd : p * (p ^ 4 * (qz ^ 5 - qb ^ 5)) + (p * qb) ^ 5 = (p * qz) ^ 5
        calc p * (p ^ 4 * (qz ^ 5 - qb ^ 5)) + (p * qb) ^ 5
          = p ^ 5 * ((qz ^ 5 - qb ^ 5) + qb ^ 5) := by ring
          _ = p ^ 5 * qz ^ 5 := by rw [he]
          _ = (p * qz) ^ 5 := by ring
      rw [← hqb, ← hqz] at hadd
      exact nat.dvd_of_mul_eq p (p ^ 4 * (qz ^ 5 - qb ^ 5)) (a ^ 5) (by linarith [hp.1]) (by omega)
    have hpa : p ∣ a := prime_dvd_of_dvd_pow.nat p a 5 (is_prime_nat.to_prime p hp) hpa5
    unfold nat.coprime_primes at hcop_ab
    exact hcop_ab p hp ⟨hpa, hpb⟩
  have hcop_za : nat.coprime_primes z0 a
    unfold nat.coprime_primes
    intro p hp hboth
    obtain ⟨hpz, hpa⟩ := hboth
    obtain ⟨qz, hqz⟩ := (dvd.iff_exists p z0 (by linarith [hp.1])).mp hpz
    obtain ⟨qa, hqa⟩ := (dvd.iff_exists p a (by linarith [hp.1])).mp hpa
    have h1 : qa ≤ qz := nat.div_le_of_mul_le p qa qz (by linarith [hp.1]) (by rw [← hqa, ← hqz]; exact ha_le_z0)
    have hle5 := nat.pow_mono_base 5 qa qz h1
    have hpb5 : p ∣ (b ^ 5)
      have hb5 : b ^ 5 = z0 ^ 5 - a ^ 5 := by omega
      have he : (qz ^ 5 - qa ^ 5) + qa ^ 5 = qz ^ 5 := by omega
      have hadd : p * (p ^ 4 * (qz ^ 5 - qa ^ 5)) + (p * qa) ^ 5 = (p * qz) ^ 5
        calc p * (p ^ 4 * (qz ^ 5 - qa ^ 5)) + (p * qa) ^ 5
          = p ^ 5 * ((qz ^ 5 - qa ^ 5) + qa ^ 5) := by ring
          _ = p ^ 5 * qz ^ 5 := by rw [he]
          _ = (p * qz) ^ 5 := by ring
      rw [← hqa, ← hqz] at hadd
      exact nat.dvd_of_mul_eq p (p ^ 4 * (qz ^ 5 - qa ^ 5)) (b ^ 5) (by linarith [hp.1]) (by omega)
    have hpb : p ∣ b := prime_dvd_of_dvd_pow.nat p b 5 (is_prime_nat.to_prime p hp) hpb5
    unfold nat.coprime_primes at hcop_ab
    exact hcop_ab p hp ⟨hpa, hpb⟩
  exact ⟨a, b, z0, ha, hb, hz0_pos, hcop_ab, hcop_zb, hcop_za, habz⟩

+ nat.abs_cast_nat (n : ℕ) : nat_of_int (|(n : ℤ)|) = n
  apply (cast_inj.int (nat_of_int (|(n : ℤ)|)) n).mp
  rw [nat_of_int_abs_eq (n : ℤ)]
  have hnn : (0 : ℤ) ≤ (n : ℤ) := (cast_le.int 0 n).mpr (by omega)
  obtain ⟨e, _⟩ | ⟨_, hn⟩ := abs_cases.int (n : ℤ); exact e; linarith

+ nat.abs_neg_cast_nat (n : ℕ) : nat_of_int (|-(n : ℤ)|) = n
  apply (cast_inj.int (nat_of_int (|-(n : ℤ)|)) n).mp
  rw [nat_of_int_abs_eq (-(n : ℤ))]
  have hnn : (0 : ℤ) ≤ (n : ℤ) := (cast_le.int 0 n).mpr (by omega)
  obtain ⟨e, hp⟩ | ⟨e, _⟩ := abs_cases.int (-(n : ℤ)); linarith; linarith

-- THEOREM 5A (FERMAT'S LAST THEOREM FOR EXPONENT n = 5, DIRICHLET-LEGENDRE 1825 — 0 CUSTOM AXIOMS!):
+ flt.exp_five (x y z : ℕ) (hx : 0 < x) (hy : 0 < y) : x ^ 5 + y ^ 5 ≠ z ^ 5
  intro heq
  obtain ⟨a, b, z0, ha, hb, hz0, hcop_ab, hcop_zb, hcop_za, habz⟩ :=
    flt.exists_coprime_counterexample_5 x y z hx hy heq
  have hc_z : ((a ^ 5 + b ^ 5 : ℕ) : ℤ) = ((z0 ^ 5 : ℕ) : ℤ) := by rw [habz]
  rw [cast_add.int (a ^ 5) (b ^ 5), cast_pow.int a 5, cast_pow.int b 5, cast_pow.int z0 5] at hc_z
  obtain ha5 | hb5 | hz5 := nat.flt5_div5_of_sum a b z0 habz
  · -- Case 5 | a: rewrite as z0^5 + (-b)^5 = a^5!
    have hz_nd5 : z0 % 5 ≠ 0
      intro h; unfold nat.coprime_primes at hcop_za
      exact hcop_za 5 is_prime_nat_five ⟨h, ha5⟩
    have hb_nd5 : b % 5 ≠ 0
      intro h; unfold nat.coprime_primes at hcop_ab
      exact hcop_ab 5 is_prime_nat_five ⟨ha5, h⟩
    have hz_nz : (z0 : ℤ) ≠ 0 := by have hp := (cast_lt.int 0 z0).mpr hz0; linarith
    have hnb_nz : -(b : ℤ) ≠ 0 := by have hp := (cast_lt.int 0 b).mpr hb; linarith
    have hsum_z : (z0 : ℤ) ^ 5 + (-(b : ℤ)) ^ 5 = (a : ℤ) ^ 5 := by linarith
    have hn1 : nat_of_int (|(z0 : ℤ)|) % 5 ≠ 0 := by rw [nat.abs_cast_nat z0]; exact hz_nd5
    have hn2 : nat_of_int (|-(b : ℤ)|) % 5 ≠ 0 := by rw [nat.abs_neg_cast_nat b]; exact hb_nd5
    have hcop_s : nat.coprime_primes (nat_of_int (|(z0 : ℤ)|)) (nat_of_int (|-(b : ℤ)|))
      rw [nat.abs_cast_nat z0, nat.abs_neg_cast_nat b]; exact hcop_zb
    exact dirichlet.no_signed_fifth_div5 (z0 : ℤ) (-(b : ℤ)) a hz_nz hnb_nz ha ha5 hn1 hn2 hcop_s hsum_z
  · -- Case 5 | b: rewrite as z0^5 + (-a)^5 = b^5!
    have hz_nd5 : z0 % 5 ≠ 0
      intro h; unfold nat.coprime_primes at hcop_zb
      exact hcop_zb 5 is_prime_nat_five ⟨h, hb5⟩
    have ha_nd5 : a % 5 ≠ 0
      intro h; unfold nat.coprime_primes at hcop_ab
      exact hcop_ab 5 is_prime_nat_five ⟨h, hb5⟩
    have hz_nz : (z0 : ℤ) ≠ 0 := by have hp := (cast_lt.int 0 z0).mpr hz0; linarith
    have hna_nz : -(a : ℤ) ≠ 0 := by have hp := (cast_lt.int 0 a).mpr ha; linarith
    have hsum_z : (z0 : ℤ) ^ 5 + (-(a : ℤ)) ^ 5 = (b : ℤ) ^ 5 := by linarith
    have hn1 : nat_of_int (|(z0 : ℤ)|) % 5 ≠ 0 := by rw [nat.abs_cast_nat z0]; exact hz_nd5
    have hn2 : nat_of_int (|-(a : ℤ)|) % 5 ≠ 0 := by rw [nat.abs_neg_cast_nat a]; exact ha_nd5
    have hcop_s : nat.coprime_primes (nat_of_int (|(z0 : ℤ)|)) (nat_of_int (|-(a : ℤ)|))
      rw [nat.abs_cast_nat z0, nat.abs_neg_cast_nat a]; exact hcop_za
    exact dirichlet.no_signed_fifth_div5 (z0 : ℤ) (-(a : ℤ)) b hz_nz hna_nz hb hb5 hn1 hn2 hcop_s hsum_z
  · -- Case 5 | z0: a^5 + b^5 = z0^5 directly!
    have ha_nd5 : a % 5 ≠ 0
      intro h; unfold nat.coprime_primes at hcop_za
      exact hcop_za 5 is_prime_nat_five ⟨hz5, h⟩
    have hb_nd5 : b % 5 ≠ 0
      intro h; unfold nat.coprime_primes at hcop_zb
      exact hcop_zb 5 is_prime_nat_five ⟨hz5, h⟩
    have ha_nz : (a : ℤ) ≠ 0 := by have hp := (cast_lt.int 0 a).mpr ha; linarith
    have hb_nz : (b : ℤ) ≠ 0 := by have hp := (cast_lt.int 0 b).mpr hb; linarith
    have hn1 : nat_of_int (|(a : ℤ)|) % 5 ≠ 0 := by rw [nat.abs_cast_nat a]; exact ha_nd5
    have hn2 : nat_of_int (|(b : ℤ)|) % 5 ≠ 0 := by rw [nat.abs_cast_nat b]; exact hb_nd5
    have hcop_s : nat.coprime_primes (nat_of_int (|(a : ℤ)|)) (nat_of_int (|(b : ℤ)|))
      rw [nat.abs_cast_nat a, nat.abs_cast_nat b]; exact hcop_ab
    exact dirichlet.no_signed_fifth_div5 (a : ℤ) (b : ℤ) z0 ha_nz hb_nz hz0 hz5 hn1 hn2 hcop_s hc_z

-- COROLLARY 5B (ALL-EXPONENT REDUCTION TO PRIMES p >= 7 — 0 CUSTOM AXIOMS!):
-- Combining `flt.exp_three`, `flt.exp_four`, and `flt.exp_five` reduces Fermat's Last Theorem
-- for ALL integer exponents n >= 3 unconditionally (0 custom axioms!) to odd primes p >= 7!
+ flt.reduce_to_primes_ge_7
    (hp7 : ∀ p : ℕ, is_prime_nat p → 7 ≤ p → flt_at p) :
    ∀ n : ℕ, 3 ≤ n → flt_at n
  apply flt.reduce_to_primes_ge_5
  intro p hp hp5
  by_cases heq5 : p = 5
  · rw [heq5]; unfold flt_at; exact flt.exp_five
  · by_cases heq6 : p = 6
    · exfalso
      have h6 : 6 ∣ (2 * 3) := (dvd.iff_exists 6 (2 * 3) (by decide)).mpr ⟨1, by decide⟩
      rw [← heq6] at h6
      obtain hd2 | hd3 := hp.2 2 3 h6
      · rw [heq6] at hd2; have hnot62 : ¬ (6 ∣ 2) := by decide; exact hnot62 hd2
      · rw [heq6] at hd3; have hnot63 : ¬ (6 ∣ 3) := by decide; exact hnot63 hd3
    · exact hp7 p hp (by omega)
