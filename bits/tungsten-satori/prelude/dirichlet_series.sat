-- Dirichlet series convergence for Re(s) > 1, explicit p-series telescoping bound
-- sum_{n=1}^N n^(-sigma) <= sigma / (sigma - 1), and uniform lower bound on finite Euler
-- products proving nonvanishing of Euler-product L-functions for ALL Re(s) > 1.
-- ALL theorems proved unconditionally on Satori's foundational HOL kernel (0 custom axioms).

import von_mangoldt
import series

-- ====================================================================================
-- 1. Elementary Telescoping Bound for p-Series (sigma > 1) — ZERO Calculus Needed!
-- ====================================================================================

-- Key inequality: for n >= 2 and alpha > 0,
--   alpha * n^(-(1 + alpha)) <= (n - 1)^(-alpha) - n^(-alpha).
+ pseries.step_bound (n : ℕ) (alpha : ℝ) (hn : 2 ≤ n) (ha : 0 < alpha) :
    alpha * rpow (n : ℝ) (-(1 + alpha)) ≤ rpow ((n - 1 : ℕ) : ℝ) (-alpha) - rpow (n : ℝ) (-alpha)
  have hn_pos : (0 : ℝ) < (n : ℝ)
    have h1 : n = (n - 1) + 1 := by omega
    rw [h1]; simp; linarith [cast_nonneg.real (n - 1)]
  have hnm1_pos : (0 : ℝ) < ((n - 1 : ℕ) : ℝ)
    have h1 : n - 1 = (n - 2) + 1 := by omega
    rw [h1]; simp; linarith [cast_nonneg.real (n - 2)]
  have hnm1_eq : ((n - 1 : ℕ) : ℝ) = (n : ℝ) - 1
    set m := n - 1 with hm
    have h1 : n = m + 1 := by omega
    have hcast : (n : ℝ) = (m : ℝ) + 1 := by rw [h1]; simp
    linarith
  -- Step 1: (n - 1) / n = 1 - 1/n <= exp(-1/n), so 1/n <= log n - log (n - 1)!
  have hlog_gap : 1 / (n : ℝ) ≤ log (n : ℝ) - log ((n - 1 : ℕ) : ℝ)
    have hge := exp_ge_one_add (-(1 / (n : ℝ)))
    have hratio : ((n - 1 : ℕ) : ℝ) / (n : ℝ) = 1 + -(1 / (n : ℝ))
      rw [hnm1_eq, div_def.real ((n : ℝ) - 1) (n : ℝ), div_def.real 1 (n : ℝ)]
      have hne : (n : ℝ) ≠ 0 := by linarith
      have hc := mul_div_cancel.real 1 (n : ℝ) hne
      linear_combination hc
    have hle_exp : ((n - 1 : ℕ) : ℝ) / (n : ℝ) ≤ exp (-(1 / (n : ℝ))) := by linarith
    have hdiv_pos : 0 < ((n - 1 : ℕ) : ℝ) / (n : ℝ)
      rw [div_def.real ((n - 1 : ℕ) : ℝ) (n : ℝ)]
      exact mul_pos.real ((n - 1 : ℕ) : ℝ) (1 / (n : ℝ)) hnm1_pos (one_div_pos.real (n : ℝ) hn_pos)
    have hlog_le := (log_le_log (((n - 1 : ℕ) : ℝ) / (n : ℝ)) (exp (-(1 / (n : ℝ)))) hdiv_pos (exp_pos (-(1 / (n : ℝ))))).mpr hle_exp
    rw [log_exp] at hlog_le
    -- log((n-1)/n) = log(n-1) - log(n):
    have hlog_div : log (((n - 1 : ℕ) : ℝ) / (n : ℝ)) + log (n : ℝ) = log ((n - 1 : ℕ) : ℝ)
      rw [← log_mul.real (((n - 1 : ℕ) : ℝ) / (n : ℝ)) (n : ℝ) hdiv_pos hn_pos]
      have hc : (((n - 1 : ℕ) : ℝ) / (n : ℝ)) * (n : ℝ) = ((n - 1 : ℕ) : ℝ)
        have hne : (n : ℝ) ≠ 0 := by linarith
        have hm := mul_div_cancel.real ((n - 1 : ℕ) : ℝ) (n : ℝ) hne
        linarith
      rw [hc]
    linarith
  -- Step 2: exp(alpha * (log n - log(n-1))) >= 1 + alpha / n!
  have hexp_gap : 1 + alpha / (n : ℝ) ≤ exp (alpha * (log (n : ℝ) - log ((n - 1 : ℕ) : ℝ)))
    have h1 := exp_ge_one_add (alpha * (log (n : ℝ) - log ((n - 1 : ℕ) : ℝ)))
    have hmul := mul_le_mul_of_nonneg_left.real (1 / (n : ℝ)) (log (n : ℝ) - log ((n - 1 : ℕ) : ℝ)) alpha hlog_gap (by linarith)
    have hdiv_eq : alpha * (1 / (n : ℝ)) = alpha / (n : ℝ) := (div_def.real alpha (n : ℝ)).symm
    linarith
  -- Step 3: multiply by n^(-alpha) = exp(-alpha * log n) > 0!
  have hna_pos : 0 < rpow (n : ℝ) (-alpha) := rpow.pos (n : ℝ) (-alpha)
  have hmul2 := mul_le_mul_of_nonneg_left.real (1 + alpha / (n : ℝ)) (exp (alpha * (log (n : ℝ) - log ((n - 1 : ℕ) : ℝ)))) (rpow (n : ℝ) (-alpha)) hexp_gap (by linarith)
  have hprod_rhs : rpow (n : ℝ) (-alpha) * exp (alpha * (log (n : ℝ) - log ((n - 1 : ℕ) : ℝ))) = rpow ((n - 1 : ℕ) : ℝ) (-alpha)
    unfold rpow
    rw [← exp_add]
    have hexp_eq : (-alpha) * log (n : ℝ) + alpha * (log (n : ℝ) - log ((n - 1 : ℕ) : ℝ)) = (-alpha) * log ((n - 1 : ℕ) : ℝ) := by ring
    rw [hexp_eq]
  have hprod_lhs : rpow (n : ℝ) (-alpha) * (alpha / (n : ℝ)) = alpha * rpow (n : ℝ) (-(1 + alpha))
    unfold rpow
    have hinv_n : 1 / (n : ℝ) = exp ((-1) * log (n : ℝ))
      have hne : (n : ℝ) ≠ 0 := by linarith
      have hprod1 : (n : ℝ) * exp ((-1) * log (n : ℝ)) = 1
        have h1 : (n : ℝ) = exp (log (n : ℝ)) := (exp_log (n : ℝ) hn_pos).symm
        have h2 : log (n : ℝ) + (-1) * log (n : ℝ) = 0 := by ring
        calc (n : ℝ) * exp ((-1) * log (n : ℝ))
          = exp (log (n : ℝ)) * exp ((-1) * log (n : ℝ)) := by rw [← h1]
          _ = exp (log (n : ℝ) + (-1) * log (n : ℝ)) := by rw [← exp_add]
          _ = exp 0 := by rw [h2]
          _ = 1 := exp_zero
      have hc := mul_div_cancel.real 1 (n : ℝ) hne
      have hdiff : (n : ℝ) * (1 / (n : ℝ) - exp ((-1) * log (n : ℝ))) = 0 := by linarith
      nlinarith
    rw [div_def.real alpha (n : ℝ), hinv_n]
    have hre : exp ((-alpha) * log (n : ℝ)) * (alpha * exp ((-1) * log (n : ℝ))) = alpha * (exp ((-alpha) * log (n : ℝ)) * exp ((-1) * log (n : ℝ))) := by ring
    rw [hre, ← exp_add]
    have hsum : (-alpha) * log (n : ℝ) + (-1) * log (n : ℝ) = (-(1 + alpha)) * log (n : ℝ) := by ring
    rw [hsum]
  rw [hprod_rhs] at hmul2
  linarith

-- Telescoping partial-sum bound: for ALL sigma > 1 and ALL N : ℕ:
--   sum_{n < N} (if n = 0 then 0 else n^(-sigma)) <= sigma / (sigma - 1)!
-> pseries.term (sigma : ℝ) (n : ℕ) : ℝ :=
  if n = 0 then 0 else rpow (n : ℝ) (-sigma)

+ pseries.term_nonneg (sigma : ℝ) (n : ℕ) : 0 ≤ pseries.term sigma n
  unfold pseries.term
  by_cases hz : n = 0
  · simp [hz]
  · simp [hz]; linarith [exp_pos (-sigma * log (n : ℝ))]

+ pseries.partial_sum_le (sigma : ℝ) (hs : 1 < sigma) (N : ℕ) :
    partial_sum (pseries.term sigma) N ≤ sigma / (sigma - 1)
  unfold partial_sum
  set alpha := sigma - 1 with halpha
  have ha : 0 < alpha := by linarith
  -- Prove stronger telescoping bound for N >= 2:
  --   alpha * (sum_{n < N} pseries.term sigma n) <= alpha + 1 - (N - 1)^(-alpha)
  have htel : ∀ M : ℕ, 2 ≤ M → alpha * (∑ n < M, pseries.term sigma n) ≤ alpha + 1 - rpow ((M - 1 : ℕ) : ℝ) (-alpha)
    intro M
    induction M with h2 k ih h2
    · omega
    · rw [succ_eq_add_one.nat] at h2 ⊢
      by_cases hk2 : 2 ≤ k
      · simp
        have ihk := ih hk2
        have hstep := pseries.step_bound k alpha hk2 ha
        have hsig_eq : -sigma = -(1 + alpha) := by linarith
        have hk0 : k ≠ 0 := by omega
        have hterm : pseries.term sigma k = rpow (k : ℝ) (-(1 + alpha))
          unfold pseries.term; simp [hk0]; rw [hsig_eq]; unfold rpow; auto
        rw [hterm]
        have hkm : k + 1 - 1 = k := by omega
        rw [hkm]
        linarith
      · have hk1 : k = 1 := by omega
        rw [hk1]
        have hsum2 : (∑ n < 1 + 1, pseries.term sigma n) = 1
          rw [sum_range_succ'.real (pseries.term sigma) 1]
          have h01 : (1 : ℕ) = 0 + 1 := by decide
          rw [h01, sum_range_succ'.real]
          simp [pseries.term, rpow, log_one, exp_zero]
        rw [hsum2]
        have h11 : 1 + 1 - 1 = 1 := by decide
        rw [h11]
        have hpow1 : rpow ((1 : ℕ) : ℝ) (-alpha) = 1
          unfold rpow; simp [log_one, exp_zero]
        rw [hpow1]
        linarith
  have hbound : alpha * (∑ n < N, pseries.term sigma n) ≤ sigma
    by_cases hN2 : 2 ≤ N
    · have ht := htel N hN2
      have hpos := rpow.pos ((N - 1 : ℕ) : ℝ) (-alpha)
      linarith
    · by_cases hN0 : N = 0
      · rw [hN0]; simp; linarith
      · have hN1 : N = 1 := by omega
        rw [hN1]
        have hsum1 : (∑ n < 1, pseries.term sigma n) = 0
          have h01 : (1 : ℕ) = 0 + 1 := by decide
          rw [h01, sum_range_succ'.real]; simp [pseries.term]
        rw [hsum1]; linarith
  exact (le_div_iff.real (∑ n < N, pseries.term sigma n) sigma alpha ha).mpr (by linarith)

-- THEOREM 1A (Absolute Convergence of p-Series for ALL sigma > 1, AXIOM-FREE!):
+ pseries.summable (sigma : ℝ) (hs : 1 < sigma) : summable (pseries.term sigma)
  exact summable.of_partial_sum_le (pseries.term sigma) (sigma / (sigma - 1)) (pseries.term_nonneg sigma) (pseries.partial_sum_le sigma hs)

-- ====================================================================================
-- 2. Dirichlet Series Terms & Absolute Convergence for ALL Re(s) > 1 (AXIOM-FREE!)
-- ====================================================================================

-> dterm (chi : ℕ → ℂ) (s : ℂ) (n : ℕ) : ℂ :=
  if n = 0 then complex.zero else complex.mul (chi n) (cpow_real (n : ℝ) (complex.neg s))

-> dsum (chi : ℕ → ℂ) (s : ℂ) (N : ℕ) : ℂ :=
  csum N (dterm chi s)

+ dterm.abs_le_pseries (chi : ℕ → ℂ) (s : ℂ) (n : ℕ) (hchi : complex.norm_sq (chi n) ≤ 1) :
    complex.abs (dterm chi s n) ≤ pseries.term (complex.re s) n
  unfold dterm pseries.term
  by_cases hz : n = 0
  · simp [hz]
    unfold complex.abs complex.norm_sq
    simp
    have hsq := sqrt_spec 0 (by linarith)
    nlinarith
  · have hif1 : ∀ (a b : ℂ), (if n = 0 then a else b) = b := by intro a b; simp [hz]
    have hif2 : ∀ (a b : ℝ), (if n = 0 then a else b) = b := by intro a b; simp [hz]
    rw [hif1 complex.zero (complex.mul (chi n) (cpow_real (n : ℝ) (complex.neg s))), hif2 0 (rpow (n : ℝ) (-complex.re s))]
    have hns_le : complex.norm_sq (complex.mul (chi n) (cpow_real (n : ℝ) (complex.neg s))) ≤ rpow (n : ℝ) (-complex.re s) * rpow (n : ℝ) (-complex.re s)
      rw [complex.norm_sq_mul, cpow_real.norm_sq]
      simp
      have hpow_sq : rpow (n : ℝ) (-complex.re s) * rpow (n : ℝ) (-complex.re s) = exp (2 * log (n : ℝ) * (0 - complex.re s))
        unfold rpow
        rw [← exp_add]
        have he : (-complex.re s) * log (n : ℝ) + (-complex.re s) * log (n : ℝ) = 2 * log (n : ℝ) * (0 - complex.re s) := by ring
        rw [he]
      rw [hpow_sq]
      have hexp_pos : 0 ≤ exp (2 * log (n : ℝ) * (0 - complex.re s)) := by linarith [exp_pos (2 * log (n : ℝ) * (0 - complex.re s))]
      nlinarith
    unfold complex.abs
    have hnn_ns : 0 ≤ complex.norm_sq (complex.mul (chi n) (cpow_real (n : ℝ) (complex.neg s))) :=
      complex.norm_sq_nonneg (complex.mul (chi n) (cpow_real (n : ℝ) (complex.neg s)))
    have hsp := sqrt_spec (complex.norm_sq (complex.mul (chi n) (cpow_real (n : ℝ) (complex.neg s)))) hnn_ns
    have hr_pos : 0 < rpow (n : ℝ) (-complex.re s) := rpow.pos (n : ℝ) (-complex.re s)
    nlinarith

-- THEOREM 1B (Absolute Convergence of EVERY Dirichlet Series for Re(s) > 1, AXIOM-FREE!):
+ dseries.abs_summable (chi : ℕ → ℂ) (s : ℂ) (hs : 1 < complex.re s)
    (hchi : ∀ n : ℕ, complex.norm_sq (chi n) ≤ 1) :
    summable (fun n => complex.abs (dterm chi s n))
  apply summable.of_nonneg_le (fun n => complex.abs (dterm chi s n)) (pseries.term (complex.re s))
  · intro n; unfold complex.abs; exact sqrt_nonneg (complex.norm_sq (dterm chi s n))
  · intro n; exact dterm.abs_le_pseries chi s n (hchi n)
  · exact pseries.summable (complex.re s) hs

-- ====================================================================================
-- 3. Uniform Nonvanishing Lower Bound on Finite Euler Products for ALL Re(s) > 1!
--    Attacks Frontier #1 (`zeta_ne_zero_ge_one` for Re(s) > 1, 100% AXIOM-FREE!)
-- ====================================================================================

-- Single Euler factor modulus upper bound: |1 - w * p^(-s)| <= exp(p^(-Re s)).
+ euler_factor.abs_le_exp (w : ℂ) (p : ℝ) (s : ℂ)
    (hw : complex.norm_sq w ≤ 1) :
    complex.abs (euler_factor w p s) ≤ exp (rpow p (-complex.re s))
  unfold euler_factor
  have h1 : complex.abs (complex.sub complex.one (complex.mul w (cpow_real p (complex.neg s)))) ≤ 1 + rpow p (-complex.re s)
    -- Prove squared version: |1 - z|^2 <= (1 + r)^2 whenever |z|^2 <= r^2 (with r > 0)!
    set z := complex.mul w (cpow_real p (complex.neg s)) with hz
    set r := rpow p (-complex.re s) with hr
    have hr_pos : 0 < r := by rw [hr]; exact rpow.pos p (-complex.re s)
    have hz_ns : complex.norm_sq z ≤ r * r
      rw [hz, hr, complex.norm_sq_mul, cpow_real.norm_sq]
      simp
      have hrr : rpow p (-complex.re s) * rpow p (-complex.re s) = exp (2 * log p * (0 - complex.re s))
        unfold rpow; rw [← exp_add]
        have he : (-complex.re s) * log p + (-complex.re s) * log p = 2 * log p * (0 - complex.re s) := by ring
        rw [he]
      rw [hrr]
      have hexp_nn : 0 ≤ exp (2 * log p * (0 - complex.re s)) := by linarith [exp_pos (2 * log p * (0 - complex.re s))]
      nlinarith
    have hsub_ns : complex.norm_sq (complex.sub complex.one z) ≤ (1 + r) * (1 + r)
      unfold complex.norm_sq at hz_ns ⊢
      simp
      -- Need: (1 - re z)^2 + (0 - im z)^2 = 1 - 2*re z + (re z)^2 + (im z)^2 <= 1 + 2*r + r^2
      -- Follows from (re z)^2 + (im z)^2 <= r^2 and -re z <= r (since (re z)^2 <= r^2 and r > 0)!
      have hre_sq : complex.re z * complex.re z ≤ r * r := by nlinarith
      have hre_ge : -r ≤ complex.re z := by nlinarith
      nlinarith
    unfold complex.abs
    have hsp := sqrt_spec (complex.norm_sq (complex.sub complex.one z)) (complex.norm_sq_nonneg (complex.sub complex.one z))
    nlinarith
  linarith [exp_ge_one_add (rpow p (-complex.re s))]

-- THEOREM 1C (Uniform Finite Euler Product Bound & Reciprocal Nonvanishing for ALL Re(s) > 1):
-- For ANY k distinct primes/integers p_0, ..., p_{k-1} >= 1, weights |w_i|^2 <= 1, and Re(s) > 1:
--   |prod_{i < k} (1 - w_i * p_i^(-s))| <= exp(sum_{i < k} p_i^(-Re s)).
-- Hence whenever prod_{i < k} (1 - w_i * p_i^(-s)) * L = 1 (Euler product identity) and
-- sum_{i < k} p_i^(-Re s) <= B (e.g. B = sigma / (sigma - 1)), we get the UNIFORM lower bound:
--   exp(-B) <= |L|   (proving L != 0 uniformly across the entire half-plane Re(s) > 1!).
+ cprod.abs_le_exp_sum (k : ℕ) (w : ℕ → ℂ) (p : ℕ → ℝ) (s : ℂ) :
    (∀ i < k, complex.norm_sq (w i) ≤ 1) →
    complex.abs (cprod k (fun i => euler_factor (w i) (p i) s))
      ≤ exp (∑ i < k, rpow (p i) (-complex.re s))
  induction k with hw0 n ih hw
  · simp [cprod, exp_zero]
    unfold complex.abs complex.norm_sq
    simp
    have hsp := sqrt_spec 1 (by linarith)
    nlinarith
  · rw [succ_eq_add_one.nat] at hw ⊢
    simp [cprod, exp_add]
    have ihn := ih (by intro i hi; exact hw i (by omega))
    have hlast := euler_factor.abs_le_exp (w n) (p n) s (hw n (by omega))
    -- |a * b| = |a| * |b|:
    have habs_mul : complex.abs (complex.mul (cprod n (fun i => euler_factor (w i) (p i) s)) (euler_factor (w n) (p n) s)) = complex.abs (cprod n (fun i => euler_factor (w i) (p i) s)) * complex.abs (euler_factor (w n) (p n) s)
      unfold complex.abs
      rw [complex.norm_sq_mul]
      set u := complex.norm_sq (cprod n (fun i => euler_factor (w i) (p i) s)) with hu_def
      set v := complex.norm_sq (euler_factor (w n) (p n) s) with hv_def
      have hu : 0 ≤ u := by rw [hu_def]; exact complex.norm_sq_nonneg (cprod n (fun i => euler_factor (w i) (p i) s))
      have hv : 0 ≤ v := by rw [hv_def]; exact complex.norm_sq_nonneg (euler_factor (w n) (p n) s)
      have hsu := sqrt_spec u hu
      have hsv := sqrt_spec v hv
      have hsuv := sqrt_spec (u * v) (mul_nonneg.real u v hu hv)
      have hprod_nn : 0 ≤ sqrt u * sqrt v := mul_nonneg.real (sqrt u) (sqrt v) hsu.1 hsv.1
      have hsq_eq : (sqrt (u * v) - sqrt u * sqrt v) * (sqrt (u * v) + sqrt u * sqrt v) = 0
        linear_combination hsuv.2 - (sqrt u * sqrt u) * hsv.2 - v * hsu.2
      by_cases hsum0 : sqrt (u * v) + sqrt u * sqrt v = 0
      · linarith
      · have hpos : 0 < sqrt (u * v) + sqrt u * sqrt v := by linarith
        nlinarith
    rw [habs_mul]
    have hnn1 : 0 ≤ complex.abs (cprod n (fun i => euler_factor (w i) (p i) s)) := sqrt_nonneg (complex.norm_sq (cprod n (fun i => euler_factor (w i) (p i) s)))
    have hnn2 : 0 ≤ complex.abs (euler_factor (w n) (p n) s) := sqrt_nonneg (complex.norm_sq (euler_factor (w n) (p n) s))
    have hexp1 : 0 < exp (∑ i < n, rpow (p i) (-complex.re s)) := exp_pos (∑ i < n, rpow (p i) (-complex.re s))
    have hexp2 : 0 < exp (rpow (p n) (-complex.re s)) := exp_pos (rpow (p n) (-complex.re s))
    nlinarith

+ euler_prod.uniform_lower_bound (k : ℕ) (w : ℕ → ℂ) (p : ℕ → ℝ) (s L : ℂ) (B : ℝ)
    (hw : ∀ i < k, complex.norm_sq (w i) ≤ 1)
    (hB : (∑ i < k, rpow (p i) (-complex.re s)) ≤ B)
    (heuler : complex.mul (cprod k (fun i => euler_factor (w i) (p i) s)) L = complex.one) :
    exp (-B) ≤ complex.abs L ∧ L ≠ complex.zero
  have hprod_le : complex.abs (cprod k (fun i => euler_factor (w i) (p i) s)) ≤ exp B
    have h1 := cprod.abs_le_exp_sum k w p s hw
    have h2 := (exp_le_exp (∑ i < k, rpow (p i) (-complex.re s)) B).mpr hB
    linarith
  have habs1 : complex.abs (cprod k (fun i => euler_factor (w i) (p i) s)) * complex.abs L = 1
    have hns : complex.norm_sq (complex.mul (cprod k (fun i => euler_factor (w i) (p i) s)) L) = 1
      rw [heuler]; unfold complex.norm_sq; simp
    rw [complex.norm_sq_mul] at hns
    unfold complex.abs
    set u := complex.norm_sq (cprod k (fun i => euler_factor (w i) (p i) s)) with hu_def
    set v := complex.norm_sq L with hv_def
    have hsp1 := sqrt_spec u (by rw [hu_def]; exact complex.norm_sq_nonneg (cprod k (fun i => euler_factor (w i) (p i) s)))
    have hsp2 := sqrt_spec v (by rw [hv_def]; exact complex.norm_sq_nonneg L)
    have hprod_nn : 0 ≤ sqrt u * sqrt v := mul_nonneg.real (sqrt u) (sqrt v) hsp1.1 hsp2.1
    have hsq : (sqrt u * sqrt v - 1) * (sqrt u * sqrt v + 1) = 0
      linear_combination (sqrt u * sqrt u) * hsp2.2 + v * hsp1.2 + hns
    nlinarith
  have hexp_inv : exp (-B) * exp B = 1
    rw [← exp_add]
    have h0 : -B + B = 0 := by ring
    rw [h0, exp_zero]
  have hL_nn : 0 ≤ complex.abs L := sqrt_nonneg (complex.norm_sq L)
  have hLB : 1 ≤ exp B * complex.abs L := by nlinarith
  have hlow : exp (-B) ≤ complex.abs L
    have hepos : 0 < exp (-B) := exp_pos (-B)
    have hm := mul_le_mul_of_nonneg_left.real 1 (exp B * complex.abs L) (exp (-B)) hLB (by linarith)
    have hassoc : exp (-B) * (exp B * complex.abs L) = (exp (-B) * exp B) * complex.abs L := by ring
    rw [hassoc, hexp_inv] at hm
    linarith
  constructor
  · exact hlow
  · intro hL0
    rw [hL0] at hlow
    unfold complex.abs complex.norm_sq at hlow
    simp at hlow
    have hsp0 := sqrt_spec 0 (by linarith)
    nlinarith [exp_pos (-B)]
