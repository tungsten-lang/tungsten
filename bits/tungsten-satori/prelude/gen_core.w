# Generates prelude/core.sat: the foundational axioms fixing the arithmetic of
# ℕ, ℤ, ℚ and ℝ. Each family is stated once per type from a template so the
# four copies cannot drift apart. These axioms are true in the standard models
# (with the conventions x / 0 = 0, x % 0 = x, truncated ℕ subtraction), which is
# exactly what the kernel evaluator computes on literals; spec/core_axioms_spec.w
# tests every axiom on random literal instances.
#
#   cd ~/tungsten && bin/tungsten bits/tungsten-satori/prelude/gen_core.w

SIMP = ["add_zero", "zero_add", "mul_one", "one_mul", "mul_zero", "zero_mul", "pow_zero", "le_refl", "lt_irrefl", "zero_le", "succ_eq_add_one"]

TYPES = [["nat", "ℕ"], ["int", "ℤ"], ["rat", "ℚ"], ["real", "ℝ"]]

ALL = [
  "add_comm (a b : T) : a + b = b + a",
  "add_assoc (a b c : T) : a + b + c = a + (b + c)",
  "add_zero (a : T) : a + 0 = a",
  "zero_add (a : T) : 0 + a = a",
  "mul_comm (a b : T) : a * b = b * a",
  "mul_assoc (a b c : T) : a * b * c = a * (b * c)",
  "mul_one (a : T) : a * 1 = a",
  "one_mul (a : T) : 1 * a = a",
  "mul_zero (a : T) : a * 0 = 0",
  "zero_mul (a : T) : 0 * a = 0",
  "left_distrib (a b c : T) : a * (b + c) = a * b + a * c",
  "right_distrib (a b c : T) : (a + b) * c = a * c + b * c",
  "pow_zero (a : T) : a ^ 0 = 1",
  "pow_succ (a : T) (n : ℕ) : a ^ (n + 1) = a ^ n * a",
  "le_refl (a : T) : a ≤ a",
  "le_trans (a b c : T) : a ≤ b → b ≤ c → a ≤ c",
  "le_antisymm (a b : T) : a ≤ b → b ≤ a → a = b",
  "le_total (a b : T) : a ≤ b ∨ b ≤ a",
  "lt_iff_le_not_le (a b : T) : a < b ↔ a ≤ b ∧ ¬ b ≤ a",
  "not_le (a b : T) : ¬ a ≤ b → b < a",
  "not_lt (a b : T) : ¬ a < b → b ≤ a",
  "lt_irrefl (a : T) : ¬ a < a",
  "lt_trans (a b c : T) : a < b → b < c → a < c",
  "lt_of_lt_of_le (a b c : T) : a < b → b ≤ c → a < c",
  "lt_of_le_of_lt (a b c : T) : a ≤ b → b < c → a < c",
  "le_of_lt (a b : T) : a < b → a ≤ b",
  "add_le_add_left (a b c : T) : a ≤ b → c + a ≤ c + b",
  "add_lt_add_left (a b c : T) : a < b → c + a < c + b",
  "mul_nonneg (a b : T) : 0 ≤ a → 0 ≤ b → 0 ≤ a * b",
  "mul_pos (a b : T) : 0 < a → 0 < b → 0 < a * b",
  "zero_lt_one : (0 : T) < 1",
  "abs_nonneg (a : T) : 0 ≤ abs a",
  "abs_of_nonneg (a : T) : 0 ≤ a → abs a = a",
  "lt_or_gt_of_ne (a b : T) : ¬ a = b → a < b ∨ b < a"
]

RING = [
  "add_neg (a : T) : a + neg a = 0",
  "sub_def (a b : T) : a - b = a + neg b",
  "abs_of_neg (a : T) : a < 0 → abs a = neg a",
  "neg_mul (a b : T) : neg a * b = neg (a * b)"
]

DISCRETE = [
  "lt_iff_add_one_le (a b : T) : a < b ↔ a + 1 ≤ b",
  "div_add_mod (a b : T) : b * (a / b) + a % b = a",
  "div_zero (a : T) : a / 0 = 0",
  "mod_nonneg (a b : T) : 0 < b → 0 ≤ a % b",
  "mod_lt (a b : T) : 0 < b → a % b < b"
]

FIELD = [
  "mul_inv_cancel (a : T) : ¬ a = 0 → a * (1 / a) = 1",
  "div_def (a b : T) : a / b = a * (1 / b)",
  "div_zero (a : T) : a / 0 = 0"
]

NAT = [
  "zero_le (n : ℕ) : 0 ≤ n",
  "succ_eq_add_one (n : ℕ) : succ n = n + 1",
  "sub_add_cancel (a b : ℕ) : b ≤ a → a - b + b = a",
  "sub_eq_zero (a b : ℕ) : a ≤ b → a - b = 0"
]

CASTS = [
  "int_of_nat_add (m n : ℕ) : int_of_nat (m + n) = int_of_nat m + int_of_nat n",
  "int_of_nat_mul (m n : ℕ) : int_of_nat (m * n) = int_of_nat m * int_of_nat n",
  "int_of_nat_le (m n : ℕ) : int_of_nat m ≤ int_of_nat n ↔ m ≤ n",
  "int_of_nat_nonneg (n : ℕ) : 0 ≤ int_of_nat n",
  "rat_of_int_add (m n : ℤ) : rat_of_int (m + n) = rat_of_int m + rat_of_int n",
  "rat_of_int_mul (m n : ℤ) : rat_of_int (m * n) = rat_of_int m * rat_of_int n",
  "rat_of_int_le (m n : ℤ) : rat_of_int m ≤ rat_of_int n ↔ m ≤ n",
  "real_of_rat_add (m n : ℚ) : real_of_rat (m + n) = real_of_rat m + real_of_rat n",
  "real_of_rat_mul (m n : ℚ) : real_of_rat (m * n) = real_of_rat m * real_of_rat n",
  "real_of_rat_le (m n : ℚ) : real_of_rat m ≤ real_of_rat n ↔ m ≤ n",
  "nat_of_int_of_nat (n : ℕ) : nat_of_int (int_of_nat n) = n",
  "int_of_nat_of_int (z : ℤ) : 0 ≤ z → int_of_nat (nat_of_int z) = z",
  "nat_of_int_nonpos (z : ℤ) : z ≤ 0 → nat_of_int z = 0",
  "floor_le (q : ℚ) : rat_of_int (floor q) ≤ q",
  "lt_floor_add_one (q : ℚ) : q < rat_of_int (floor q) + 1"
]

-> emit(sb, family, ty)
  family.each -> (line)
    sp = line.index(" ")
    name = line.slice(0, sp)
    rest = line.slice(sp, line.size - sp)
    if SIMP.include?(name)
      sb.append("@\[simp\] ")
    sb.append("axiom " + name + "." + ty[0] + rest.gsub("T)", ty[1] + ")") + "\n")

sb = StringBuffer()
sb.append("-- GENERATED by prelude/gen_core.w — do not edit by hand.\n")
sb.append("-- Foundational arithmetic axioms (true in the standard models; tested by\n")
sb.append("-- spec/core_axioms_spec.w against the kernel evaluator).\n\n")
TYPES.each -> (ty)
  sb.append("-- " + ty[1] + "\n")
  emit(sb, ALL, ty)
  if ty[0] != "nat"
    emit(sb, RING, ty)
  if ty[0] == "nat" || ty[0] == "int"
    emit(sb, DISCRETE, ty)
  if ty[0] == "rat" || ty[0] == "real"
    emit(sb, FIELD, ty)
  sb.append("\n")
sb.append("-- ℕ specifics\n")
NAT.each -> (line)
  sp = line.index(" ")
  if SIMP.include?(line.slice(0, sp))
    sb.append("@\[simp\] ")
  sb.append("axiom " + line.slice(0, sp) + ".nat" + line.slice(sp, line.size - sp) + "\n")
sb.append("\n-- casts\n")
CASTS.each -> (line)
  sb.append("axiom " + line + "\n")
File.write("bits/tungsten-satori/prelude/core.sat", sb.to_s)
<< "wrote prelude/core.sat"
