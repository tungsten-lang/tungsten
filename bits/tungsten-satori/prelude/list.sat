-- Lists: length, append, map, sum, range.

def length : list α → ℕ
  | [] => 0
  | x :: xs => length xs + 1

def append : list α → list α → list α
  | [] => fun ys => ys
  | x :: xs => fun ys => x :: append xs ys

def map (f : α → β) : list α → list β
  | [] => []
  | x :: xs => f x :: map f xs

def sum : list ℕ → ℕ
  | [] => 0
  | x :: xs => x + sum xs

def iota : ℕ → ℕ → list ℕ
  | 0, k => []
  | n + 1, k => k :: iota n (k + 1)

def range (n : ℕ) : list ℕ := iota n 0

def filter (p : α → Prop) : list α → list α
  | [] => []
  | x :: xs => if p x then x :: filter p xs else filter p xs

def all (p : α → Prop) : list α → Prop
  | [] => True
  | x :: xs => p x ∧ all p xs

theorem length_append (xs ys : list α) : length (xs ++ ys) = length xs + length ys
  induction xs with x xs ih
  · simp [append, length]
  · simp [append, length, ih]
    ring
