-- Lists: length, append, map, sum, range.

def length : list α → ℕ
  | [] => 0
  | x :: xs => length xs + 1

def append : list α → list α → list α
  | [] => fun ys => ys
  | x :: xs => fun ys => x :: append xs ys

def map (f : α → β) : list α → list β
  | [] => []
  | x :: xs => f x :: map f xs

def sum : list ℕ → ℕ
  | [] => 0
  | x :: xs => x + sum xs

def iota : ℕ → ℕ → list ℕ
  | 0, k => []
  | n + 1, k => k :: iota n (k + 1)

def range (n : ℕ) : list ℕ := iota n 0

def filter (p : α → Prop) : list α → list α
  | [] => []
  | x :: xs => if p x then x :: filter p xs else filter p xs

def all (p : α → Prop) : list α → Prop
  | [] => True
  | x :: xs => p x ∧ all p xs

+ list.all_nil (p : α → Prop) : all p [] := by unfold all; trivial
+ list.all_cons (p : α → Prop) (x : α) (xs : list α) (head : p x) (tail : all p xs) :
    all p (x :: xs) := by unfold all; exact ⟨head,tail⟩

theorem length_append (xs ys : list α) : length (xs ++ ys) = length xs + length ys
  induction xs with x xs ih
  · simp [append, length]
  · simp [append, length, ih]
    ring

-- big operators: ∑ i < n, f i  and  ∑ x ∈ l, f x  (∏ likewise)
-> sum_below : ℕ → (ℕ → α) → α
  | 0, f => 0
  | n + 1, f => sum_below n f + f n

-> prod_below : ℕ → (ℕ → α) → α
  | 0, f => 1
  | n + 1, f => prod_below n f * f n

-> sum_list : list β → (β → α) → α
  | [], f => 0
  | x :: xs, f => f x + sum_list xs f

-> prod_list : list β → (β → α) → α
  | [], f => 1
  | x :: xs, f => f x * prod_list xs f

-- membership unfolds under simp: x ∈ y :: ys ↔ x = y ∨ x ∈ ys, and x ∈ [] ↔ False
@[simp] + mem_cons (x y : α) (ys : list α) : (x ∈ y :: ys) = (x = y ∨ x ∈ ys)
  rfl
@[simp] + mem_nil (x : α) : (x ∈ ([] : list α)) = False
  rfl

-- Transfer predicates between recursive `all` and memberwise statements.
+ list.all_mem (p : α → Prop) (xs : list α) : ∀ x, x ∈ xs → all p xs → p x
  induction xs with x0 hx0 h0 y ys ih x hx hall
  · simp at hx0
  · simp [all] at hall
    simp at hx
    obtain e | e := hx
    · rw [e]; exact hall.1
    · exact ih x e hall.2

+ list.all_of_mem (p : α → Prop) (xs : list α) : (∀ x ∈ xs, p x) → all p xs
  induction xs with h0 y ys ih h
  · simp [all]
  · have head : p y := h y (by simp)
    have tail : ∀ x ∈ ys, p x
      intro x hx
      exact h x (by simp [hx])
    simp [all]
    exact ⟨head, ih tail⟩

+ list.all_iff (p : α → Prop) (xs : list α) : all p xs ↔ ∀ x ∈ xs, p x
  constructor
  · intro h x hx; exact list.all_mem p xs x hx h
  · exact list.all_of_mem p xs

+ list.all_imp (p q : α → Prop) (xs : list α) (h : ∀ x ∈ xs, p x → q x) (hp : all p xs) : all q xs
  apply list.all_of_mem q xs
  intro x hx
  exact h x hx (list.all_mem p xs x hx hp)

+ list.all_map (p : β → Prop) (f : α → β) (xs : list α) : all p (map f xs) ↔ all (fun x => p (f x)) xs
  induction xs with x xs ih
  · simp [all, map]
  · simp [all, map, ih]

+ list.all_append (p : α → Prop) (xs ys : list α) : all p (xs ++ ys) ↔ all p xs ∧ all p ys
  induction xs with x xs ih
  · simp [all, append]
  · simp [all, append, ih]
    auto

-- Numeric folds can be compared by their empty value and one checked cell.
+ list.recursive_identity (f g : list α → β) (base : f [] = g [])
    (step : ∀ x xs, f xs = g xs → f (x :: xs) = g (x :: xs)) (xs : list α) : f xs = g xs
  induction xs with x xs ih
  · exact base
  · exact step x xs ih

-- A memberwise condition gives precisely the head fact and the tail condition.
@[simp] + list.forall_cons (p : α → Prop) (x : α) (xs : list α) :
    (∀ y ∈ x :: xs, p y) = (p x ∧ ∀ y ∈ xs, p y)
  constructor
  · intro h
    constructor
    · exact h x (by simp)
    · intro y hy; exact h y (by simp [hy])
  · intro h y hy
    obtain ⟨hx, ht⟩ := h
    simp at hy
    obtain e | e := hy
    · rw [e]; exact hx
    · exact ht y e
