  have hrpow_p : (rpow (p : ℝ) (1 / ((p - 1 : ℕ) : ℝ))) ^ (p - 1) = (p : ℝ) := by unfold rpow; rw [sernau.m81a_exp_pow_eq ((1 / ((p - 1 : ℕ) : ℝ)) * log (p : ℝ)) (p - 1)]; have hc : ((p - 1 : ℕ) : ℝ) * ((1 / ((p - 1 : ℕ) : ℝ)) * log (p : ℝ)) = log (p : ℝ) := (by field_simp); rw [hc, exp_log (p : ℝ) hp_pos]
  have hbase_eq : (((p ^ k : ℕ) : ℝ) ^ (p - 1)) / (p : ℝ) = (((p ^ k : ℕ) : ℝ) / rpow (p : ℝ) (1 / ((p - 1 : ℕ) : ℝ))) ^ (p - 1) := by have hdiv_pow : ∀ (a b : ℝ) (m : ℕ), b ≠ 0 → (a ^ m) / (b ^ m) = (a / b) ^ m := (by intro a b m hb; induction m with t iht; (rw [pow_zero.real, pow_zero.real, pow_zero.real]; field_simp); (rw [succ_eq_add_one.nat, pow_succ.real, pow_succ.real, pow_succ.real, ← iht]; field_simp)); have hdp := hdiv_pow ((p ^ k : ℕ) : ℝ) (rpow (p : ℝ) (1 / ((p - 1 : ℕ) : ℝ))) (p - 1) (by unfold rpow; linarith [exp_pos ((1 / ((p - 1 : ℕ) : ℝ)) * log (p : ℝ))]); rw [hrpow_p] at hdp; exact hdp
