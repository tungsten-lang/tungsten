-- Milestone 3.81a (Part 0): Cyclotomic-Quadratic Root Discriminant (`New/Data/Different.lean`),
--                           2-Torsion Cubic Discriminant (`Lib/CM/Sigma/CurveTheta.lean`),
--                           and Reduced Binary Quadratic Forms & Epstein-Dedekind Zeta Identity
--                           (`Lib/CM/Genus/QuadraticZeta.lean`)
--
-- Proved unconditionally on Satori's untouched HOL kernel (ZERO custom axioms).

import determinant
import number_theory.dirichlet_conductor
import padic.kummer_artin_hasse
import algebra.vandermonde_siegel
import number_theory.quadratic_reciprocity

-- ====================================================================================
-- 1. Cyclotomic Derivative Norm Product & `rad_exp_prod` (`New/Data/Different.lean`)
-- ====================================================================================

+ sernau.m81a_dvd_cases (p g : ℕ) (hp : is_prime_nat p) (hg : 0 < g) (hgd : g ∣ p) : g = 1 ∨ g = p
  have hp2 : 2 ≤ p := hp.1
  obtain ⟨k, hk⟩ := (dvd.iff_exists g p hg).mp hgd
  obtain h1 | h2 := hp.2 g k ((dvd.iff_exists p (g * k) (by omega)).mpr ⟨1, by omega⟩)
  · right; have hle1 := le_of_dvd.nat g p hg h1; have hle2 := le_of_dvd.nat p g (by omega) hgd; omega
  · left; have hk_pos : 0 < k := by by_contra h0; have hz : k = 0 := by omega; rw [hz] at hk; omega
    have hpk := le_of_dvd.nat k p hk_pos h2
    by_contra hne1; have hm := mul_le_mul_of_nonneg_left.nat p k g hpk (by omega); nlinarith

+ sernau.m81a_prime_iff (p : ℕ) : prime p ↔ is_prime_nat p
  constructor
  · intro hp; exact ⟨hp.1, by intro a b hd; exact prime.dvd_mul_or p a b hp hd⟩
  · intro hp; constructor; exact hp.1; (intro d hdp hd2 hmod; obtain h1 | h2 := sernau.m81a_dvd_cases p d hp (by omega) hmod; omega; omega)

+ sernau.m81a_prime_dvd_pow (p M : ℕ) (hp : prime p) : ∀ k : ℕ, 1 ≤ k → p ∣ (M ^ k) → p ∣ M
  have hall : ∀ k : ℕ, True ∧ (1 ≤ k → p ∣ (M ^ k) → p ∣ M)
    intro k; induction k with m ihm
    · exact ⟨trivial, by intro hk1 _; omega⟩
    · constructor; trivial; intro hk1 hd; rw [succ_eq_add_one.nat] at hk1 hd
      by_cases hm0 : m = 0; (rw [hm0, pow_succ.nat, pow_zero.nat, one_mul.nat] at hd; exact hd)
      rw [pow_succ.nat] at hd; obtain h1 | h2 := prime.dvd_mul_or p (M ^ m) M hp hd; exact ihm.2 (by omega) h1; exact h2
  intro k; exact (hall k).2

+ sernau.m81a_exp_pow_eq (x : ℝ) (n : ℕ) : (exp x) ^ n = exp ((n : ℝ) * x)
  induction n with k ihk; (rw [pow_zero.real, cast_zero.real, zero_mul.real, exp_zero])
  rw [succ_eq_add_one.nat, pow_succ.real, ihk, cast_add.real, cast_one.real]
  have hr : ((k : ℝ) + 1) * x = (k : ℝ) * x + x := by ring
  rw [hr, exp_add]

-> sernau.rad_exp_prod (N0 : ℕ) : ℝ :=
  ∏ p < N0 + 1, if is_prime_nat p ∧ p ∣ N0 then rpow (p : ℝ) (1 / ((p - 1 : ℕ) : ℝ)) else 1

+ sernau.rad_exp_prod_eq_of_same_primes (M N : ℕ) (hM : 1 ≤ M) (hN : 1 ≤ N)
    (hsame : ∀ p : ℕ, is_prime_nat p → (p ∣ M ↔ p ∣ N)) : sernau.rad_exp_prod M = sernau.rad_exp_prod N
  have htrunc : ∀ (A K : ℕ), 1 ≤ A → A < K → (∏ p < K, if is_prime_nat p ∧ p ∣ A then rpow (p : ℝ) (1 / ((p - 1 : ℕ) : ℝ)) else 1) = sernau.rad_exp_prod A
    intro A K hA1 hlt; induction K with _ k ihk hlt; omega; rw [succ_eq_add_one.nat] at hlt ⊢
    by_cases hk : k = A; (rw [hk]; unfold sernau.rad_exp_prod; trivial)
    rw [prod_below_succ, ihk (by omega), if_neg (by intro ⟨_, hd⟩; have hle := le_of_dvd.nat A k (by omega) hd; omega)]; ring
  rw [← htrunc M (M + N + 1) hM (by omega), ← htrunc N (M + N + 1) hN (by omega)]
  apply prod_below.congr_real (M + N + 1); intro p _
  by_cases hp : is_prime_nat p
  · by_cases hdM : p ∣ M; (rw [if_pos ⟨hp, hdM⟩, if_pos ⟨hp, (hsame p hp).mp hdM⟩])
    rw [if_neg (by intro h; exact hdM h.2), if_neg (by intro h; exact hdM ((hsame p hp).mpr h.2))]
  · rw [if_neg (by intro h; exact hp h.1), if_neg (by intro h; exact hp h.1)]

+ sernau.rad_exp_prod_bounds (N0 : ℕ) (hN0 : 1 ≤ N0) :
    1 ≤ sernau.rad_exp_prod N0 ∧ sernau.rad_exp_prod N0 ≤ (N0 : ℝ)
  set rad_nat : ℕ → ℕ := fun K => ∏ p < K, if is_prime_nat p ∧ p ∣ N0 then p else 1 with hrad_def
  have hrad_prop : ∀ K : ℕ, 1 ≤ rad_nat K ∧ rad_nat K ∣ N0 ∧ (∀ q : ℕ, is_prime_nat q → q ∣ rad_nat K → q < K)
    intro K; induction K with k ihk; (rw [hrad_def, prod_below_zero]; exact ⟨by omega, dvd.one_left N0, by intro q hq hd; exfalso; exact not_dvd_one_of_ge_two q hq.1 hd⟩)
    obtain ⟨hr1, hrd, hrp⟩ := ihk; have hstep : rad_nat (k + 1) = rad_nat k * (if is_prime_nat k ∧ k ∣ N0 then k else 1) := by rw [hrad_def, prod_below_succ]
    rw [succ_eq_add_one.nat, hstep]; by_cases hc : is_prime_nat k ∧ k ∣ N0
    · rw [if_pos hc]; have hk2 : 2 ≤ k := hc.1.1; have hnd_rk : ¬ (k ∣ rad_nat k) := by intro hd; have hlt := hrp k hc.1 hd; omega
      obtain ⟨qr, hqr⟩ := (dvd.iff_exists (rad_nat k) N0 (by omega)).mp hrd
      have hk_qr : k ∣ qr := by obtain h1 | h2 := prime.dvd_mul_or k (rad_nat k) qr ((sernau.m81a_prime_iff k).mpr hc.1) (by rw [← hqr]; exact hc.2); (exfalso; exact hnd_rk h1); exact h2
      obtain ⟨w, hw⟩ := (dvd.iff_exists k qr (by omega)).mp hk_qr; have hpos_rk : 0 < rad_nat k * k := mul_pos.nat (rad_nat k) k (by omega) (by omega)
      exact ⟨by omega, (dvd.iff_exists (rad_nat k * k) N0 hpos_rk).mpr ⟨w, by rw [hqr, hw]; ring⟩, by intro q hq hqd; obtain h1 | h2 := prime.dvd_mul_or q (rad_nat k) k ((sernau.m81a_prime_iff q).mpr hq) hqd; (have hlt := hrp q hq h1; omega); (have hle := le_of_dvd.nat k q (by omega) h2; omega)⟩
    · rw [if_neg hc, mul_one.nat]; exact ⟨hr1, hrd, by intro q hq hd; have hlt := hrp q hq hd; omega⟩
  have hterm : ∀ p : ℕ, 1 ≤ (if is_prime_nat p ∧ p ∣ N0 then rpow (p : ℝ) (1 / ((p - 1 : ℕ) : ℝ)) else 1) ∧
      (if is_prime_nat p ∧ p ∣ N0 then rpow (p : ℝ) (1 / ((p - 1 : ℕ) : ℝ)) else 1) ≤ ((if is_prime_nat p ∧ p ∣ N0 then p else 1 : ℕ) : ℝ)
    intro p; by_cases hc : is_prime_nat p ∧ p ∣ N0
    · rw [if_pos hc, if_pos hc]; have hp2 : 2 ≤ p := hc.1.1; have hp_pos : (0 : ℝ) < (p : ℝ) := (cast_pos.real p).mpr (by omega)
      have hlog_nn : 0 ≤ log (p : ℝ) := by have h := (log_le_log 1 (p : ℝ) (by decide) hp_pos).mpr ((cast_le.real 1 p).mpr (by omega)); rw [log_one] at h; exact h
      have hpm1_ge1 : (1 : ℝ) ≤ ((p - 1 : ℕ) : ℝ) := (cast_le.real 1 (p - 1)).mpr (by omega)
      have hexp_0 : 0 ≤ 1 / ((p - 1 : ℕ) : ℝ) := div_nonneg.real 1 ((p - 1 : ℕ) : ℝ) (by decide) (by linarith)
      have hexp_1 : 1 / ((p - 1 : ℕ) : ℝ) ≤ 1 := (div_le_iff.real 1 1 ((p - 1 : ℕ) : ℝ) (by linarith)).mpr (by linarith)
      unfold rpow
      have hlo : 1 ≤ exp ((1 / ((p - 1 : ℕ) : ℝ)) * log (p : ℝ)) := by linarith [exp_ge_one_add ((1 / ((p - 1 : ℕ) : ℝ)) * log (p : ℝ)), mul_nonneg.real _ (log (p : ℝ)) hexp_0 hlog_nn]
      have hm := mul_le_mul_of_nonneg_right.real (1 / ((p - 1 : ℕ) : ℝ)) 1 (log (p : ℝ)) hexp_1 hlog_nn
      have he := (exp_le_exp ((1 / ((p - 1 : ℕ) : ℝ)) * log (p : ℝ)) (log (p : ℝ))).mpr (by linarith)
      rw [exp_log (p : ℝ) hp_pos] at he; exact ⟨hlo, he⟩
    · rw [if_neg hc, if_neg hc, cast_one.real]; exact ⟨by linarith, by linarith⟩
  have hprod_le : ∀ K : ℕ, 1 ≤ (∏ p < K, if is_prime_nat p ∧ p ∣ N0 then rpow (p : ℝ) (1 / ((p - 1 : ℕ) : ℝ)) else 1) ∧
      (∏ p < K, if is_prime_nat p ∧ p ∣ N0 then rpow (p : ℝ) (1 / ((p - 1 : ℕ) : ℝ)) else 1) ≤ (rad_nat K : ℝ)
    intro K; induction K with k ihk; (rw [prod_below_zero, hrad_def, prod_below_zero, cast_one.real]; exact ⟨by linarith, by linarith⟩)
    rw [succ_eq_add_one.nat, prod_below_succ]; have hrad_s : rad_nat (k + 1) = rad_nat k * (if is_prime_nat k ∧ k ∣ N0 then k else 1) := by rw [hrad_def, prod_below_succ]
    rw [hrad_s, cast_mul.real]; obtain ⟨h1, h2⟩ := ihk; obtain ⟨t1, t2⟩ := hterm k
    set fk := (if is_prime_nat k ∧ k ∣ N0 then rpow (k : ℝ) (1 / ((k - 1 : ℕ) : ℝ)) else 1)
    set pk := (∏ i < k, if is_prime_nat i ∧ i ∣ N0 then rpow (i : ℝ) (1 / ((i - 1 : ℕ) : ℝ)) else 1)
    have hm_lo := mul_le_mul_of_nonneg_left.real 1 fk pk t1 (by linarith)
    have hm_0 := mul_le_mul_of_nonneg_right.real 1 pk 1 h1 (by decide)
    have hm_1 := mul_le_mul_of_nonneg_right.real pk (rad_nat k : ℝ) fk h2 (by linarith)
    have hm_2 := mul_le_mul_of_nonneg_left.real fk ((if is_prime_nat k ∧ k ∣ N0 then k else 1 : ℕ) : ℝ) (rad_nat k : ℝ) t2 (cast_nonneg.real (rad_nat k))
    exact ⟨by linarith, by linarith⟩
  obtain ⟨hlo, hhi⟩ := hprod_le (N0 + 1)
  have hrad_le : rad_nat (N0 + 1) ≤ N0 := le_of_dvd.nat N0 (rad_nat (N0 + 1)) (by omega) (hrad_prop (N0 + 1)).2.1
  have hrad_le_r : (rad_nat (N0 + 1) : ℝ) ≤ (N0 : ℝ) := (cast_le.real (rad_nat (N0 + 1)) N0).mpr hrad_le
  unfold sernau.rad_exp_prod; exact ⟨hlo, by linarith⟩

+ sernau.m81a_abs_one_eq : complex.abs complex.one = 1
  exact eq_of_sq_eq_nonneg (complex.abs complex.one) 1 (complex.abs_nonneg complex.one) (by decide) (by rw [complex.abs_sq]; unfold complex.norm_sq; simp)

+ sernau.m81a_abs_of_real (x : ℝ) : complex.abs (complex.of_real x) = |x|
  exact eq_of_sq_eq_nonneg (complex.abs (complex.of_real x)) (|x|) (complex.abs_nonneg (complex.of_real x)) (abs_nonneg.real x) (by rw [complex.abs_sq]; unfold complex.norm_sq complex.of_real; simp; by_cases hx : 0 ≤ x; (rw [abs_of_nonneg.real x hx]); (rw [abs_of_neg.real x (by linarith)]; ring))

+ sernau.m81a_cpow_mod_eq (q : ℕ) (z : ℂ) (n : ℕ) (hq : cpow_nat z q = complex.one) :
    cpow_nat z n = cpow_nat z (n % q)
  exact (cpow_nat.pow_mod z q n hq).symm

+ sernau.m81a_zeta_pow_eq_exp (M k : ℕ) :
    cpow_nat (zeta_q M) k = complex.exp (complex.mk 0 (2 * pi * (k : ℝ) / (M : ℝ)))
  have hrec : ∀ n : ℕ, cpow_nat (zeta_q M) n = complex.exp (complex.mk 0 (2 * pi * (n : ℝ) / (M : ℝ)))
    intro n; induction n with m ihm
    · simp [cpow_nat]; exact complex.exp_zero.symm
    · rw [succ_eq_add_one.nat]
      have hs : cpow_nat (zeta_q M) (m + 1) = complex.mul (cpow_nat (zeta_q M) m) (zeta_q M) := by rfl
      rw [hs, ihm]; unfold zeta_q; rw [← complex.exp_add]
      have harg : complex.add (complex.mk 0 (2 * pi * (m : ℝ) / (M : ℝ))) (complex.mk 0 (2 * pi / (M : ℝ))) = complex.mk 0 (2 * pi * ((m + 1 : ℕ) : ℝ) / (M : ℝ))
        apply complex.ext; simp; (simp; rw [div_def.real (2 * pi * (m : ℝ)) (M : ℝ), div_def.real (2 * pi) (M : ℝ), div_def.real (2 * pi * ((m : ℝ) + 1)) (M : ℝ)]; ring)
      rw [harg]
  exact hrec k

-> sernau.m81a_diag_real (lam : ℕ → ℝ) (i j : ℕ) : ℂ :=
  if i = j then complex.of_real (lam i) else complex.zero

+ sernau.m81a_det_diag_real (n : ℕ) (lam : ℕ → ℝ) :
    cmat.det n (sernau.m81a_diag_real lam) = complex.of_real (∏ k < n, lam k)
  induction n with m ihm
  · rw [cmat.det_zero_eq, prod_below_zero, complex.of_real_one]
  · have hcol0 : ∀ i < m, sernau.m81a_diag_real lam i m = complex.zero
      intro i hi; unfold sernau.m81a_diag_real; have hne : i ≠ m := by omega; rw [if_neg hne]
    rw [succ_eq_add_one.nat, prod_below_succ, cmat.det_block_lower m (sernau.m81a_diag_real lam) hcol0]
    have hm : sernau.m81a_diag_real lam m m = complex.of_real (lam m) := by rfl
    rw [hm, ihm, complex.mul_of_real]
    have hcomm : lam m * (∏ k < m, lam k) = (∏ k < m, lam k) * lam m := by ring
    rw [hcomm]

+ sernau.prod_abs_one_sub_zeta_q (q : ℕ) (hq : 1 ≤ q) :
    (∏ d < q - 1, complex.abs (complex.sub complex.one (cpow_nat (zeta_q q) (d + 1)))) = (q : ℝ)
  have hupr : is_unitary_prim_root q (zeta_q q) := by unfold zeta_q; exact uproot.cexp_is_unitary_prim q (by omega)
  have hzq1 : cpow_nat (zeta_q q) q = complex.one := hupr.2.2.1; have hz_ns : complex.norm_sq (zeta_q q) = 1 := hupr.2.1
  set V := vander_T (fun j => cpow_nat (zeta_q q) j) with hV
  have hV_entry : ∀ i j : ℕ, V i j = cpow_nat (zeta_q q) (j * i) := by intro i j; rw [hV]; unfold vander_T; exact (cpow_nat.mul (zeta_q q) j i).symm
  have hgram : ∀ a < q, ∀ b < q, cmat.mul q (cmat.adj V) V a b = sernau.m81a_diag_real (fun _ => (q : ℝ)) a b
    intro a ha b hb; unfold cmat.mul cmat.adj sernau.m81a_diag_real; by_cases hab : a = b
    · rw [hab, if_pos (by rfl)]
      have hp_ns : ∀ m : ℕ, complex.norm_sq (cpow_nat (zeta_q q) m) = 1 := by intro m; induction m with t iht; (rw [cpow_nat.zero_eq]; unfold complex.norm_sq; simp); (rw [succ_eq_add_one.nat, cpow_nat.succ_eq, complex.norm_sq_mul, iht, hz_ns]; ring)
      have h1 : ∀ i < q, complex.mul (complex.conj (V i b)) (V i b) = complex.one := by intro i _; rw [hV_entry i b]; exact complex.conj_mul_self_of_unit _ (hp_ns (b * i))
      rw [csum.congr q _ _ h1]
      have hsum1 : ∀ m : ℕ, csum m (fun _ => complex.one) = complex.of_real (m : ℝ) := by intro m; induction m with t iht; (rw [csum.zero]; unfold complex.of_real; apply complex.ext <;> simp); (rw [succ_eq_add_one.nat, csum.succ, iht, cast_add.real, cast_one.real]; unfold complex.of_real; apply complex.ext <;> simp)
      exact hsum1 q
    · rw [if_neg hab]; set d := (b + q - a) % q with hd_def
      have hd_pos : 0 < d := by rw [hd_def]; by_cases hba : a < b; (have he : b + q - a = (b - a) + q * 1 := (by omega); rw [he, add_mul_mod.nat, (div_mod_of_lt.nat (b - a) q (by omega)).2]; omega); (rw [(div_mod_of_lt.nat (b + q - a) q (by omega)).2]; omega)
      have hd_lt : d < q := by rw [hd_def]; exact mod_lt.nat (b + q - a) q (by omega)
      set r := cpow_nat (zeta_q q) d with hr_def; have hr_ne1 : r ≠ complex.one := by rw [hr_def]; exact hupr.2.2.2 d hd_pos hd_lt
      have hr_q : cpow_nat r q = complex.one := by rw [hr_def, ← cpow_nat.mul (zeta_q q) d q]; have hper : ∀ k : ℕ, cpow_nat (zeta_q q) (k * q) = complex.one := (by intro k; induction k with t iht; (rw [zero_mul.nat, cpow_nat.zero_eq]); (rw [succ_eq_add_one.nat]; have hm : (t + 1) * q = t * q + q := (by ring); rw [hm, cpow_nat.add, iht, hzq1, complex.mul_one])); exact hper d
      have hterm : ∀ i < q, complex.mul (complex.conj (V i a)) (V i b) = cpow_nat r i
        intro i _; rw [hV_entry i a, hV_entry i b, sernau.m81a_cpow_mod_eq q (zeta_q q) (a * i) hzq1, cpow_nat.conj_eq_pow_neg q (zeta_q q) ((a * i) % q) hz_ns hzq1 (by have h := mod_lt.nat (a * i) q (by omega); omega), ← cpow_nat.add, hr_def, ← cpow_nat.mul]
        rw [sernau.m81a_cpow_mod_eq q (zeta_q q) _ hzq1, sernau.m81a_cpow_mod_eq q (zeta_q q) (d * i) hzq1]
        have hdm := div_add_mod.nat (a * i) q; have hlt_ai := mod_lt.nat (a * i) q (by omega)
        have h1 : (a * i + ((q - (a * i) % q) + b * i)) % q = (b * i) % q := by have he : a * i + ((q - (a * i) % q) + b * i) = b * i + q * ((a * i) / q + 1) := (by have hm : q * ((a * i) / q + 1) = q * ((a * i) / q) + q := (by ring); omega); rw [he, add_mul_mod.nat]
        have h2 : (a * i + (d * i)) % q = (b * i) % q
          set qd := (b + q - a) / q with hqd_def
          have hd_dm := div_add_mod.nat (b + q - a) q; rw [← hd_def, ← hqd_def] at hd_dm
          have he1 : a * i + (b + q - a) * i = (a * i + (d * i)) + q * (qd * i) := by rw [← hd_dm]; ring
          have he2 : a * i + (b + q - a) * i = b * i + q * i := by have hs : a + (b + q - a) = b + q := (by omega); have hl : (a + (b + q - a)) * i = a * i + (b + q - a) * i := (by ring); rw [← hl, hs]; ring
          have hm1 : (a * i + (b + q - a) * i) % q = (a * i + (d * i)) % q := by rw [he1, add_mul_mod.nat]
          rw [← hm1, he2, add_mul_mod.nat]
        set neg_ai := (q - (a * i) % q) % q with hneg_def
        have hz0 : (neg_ai + a * i) % q = 0 := by by_cases hr0 : (a * i) % q = 0; (have hn0 : neg_ai = 0 := (by rw [hneg_def, hr0]; have hq1 : q - 0 = 0 + q * 1 := (by omega); rw [hq1, add_mul_mod.nat, (div_mod_of_lt.nat 0 q (by omega)).2]); rw [hn0]; simp [hr0]); (have hn : neg_ai = q - (a * i) % q := (by rw [hneg_def]; exact (div_mod_of_lt.nat _ q (by omega)).2); rw [hn]; have he : (q - (a * i) % q) + a * i = 0 + q * ((a * i) / q + 1) := (by have hm : q * ((a * i) / q + 1) = q * ((a * i) / q) + q := (by ring); omega); rw [he, add_mul_mod.nat, (div_mod_of_lt.nat 0 q (by omega)).2])
        have hL : (neg_ai + (a * i + ((q - (a * i) % q) + b * i))) % q = ((q - (a * i) % q) + b * i) % q := by have ha1 : neg_ai + (a * i + ((q - (a * i) % q) + b * i)) = (neg_ai + a * i) + ((q - (a * i) % q) + b * i) := (by omega); rw [ha1, add_mod.nat (neg_ai + a * i) _ q, hz0]; simp [zmod.mod_mod]
        have hR : (neg_ai + (a * i + (d * i))) % q = (d * i) % q := by have ha1 : neg_ai + (a * i + (d * i)) = (neg_ai + a * i) + (d * i) := (by omega); rw [ha1, add_mod.nat (neg_ai + a * i) _ q, hz0]; simp [zmod.mod_mod]
        have hmod_eq : ((q - (a * i) % q) + b * i) % q = (d * i) % q := by rw [← hL, ← hR, add_mod.nat neg_ai (a * i + ((q - (a * i) % q) + b * i)) q, h1, ← h2, ← add_mod.nat neg_ai (a * i + (d * i)) q]
        rw [hmod_eq]
      rw [csum.congr q _ _ hterm]
      have htel : ∀ m : ℕ, complex.mul (complex.sub r complex.one) (csum m (fun i => cpow_nat r i)) = complex.sub (cpow_nat r m) complex.one := by intro m; induction m with t iht; (rw [csum.zero, cpow_nat.zero_eq]; apply complex.ext <;> simp); (rw [succ_eq_add_one.nat, csum.succ, cpow_nat.succ_eq]; have hd : complex.mul (complex.sub r complex.one) (complex.add (csum t (fun i => cpow_nat r i)) (cpow_nat r t)) = complex.add (complex.mul (complex.sub r complex.one) (csum t (fun i => cpow_nat r i))) (complex.mul (complex.sub r complex.one) (cpow_nat r t)) := (by apply complex.ext <;> simp <;> ring); rw [hd, iht]; apply complex.ext <;> simp <;> ring)
      have hq_tel := htel q; rw [hr_q] at hq_tel; have h0 : complex.sub complex.one complex.one = complex.zero := (by apply complex.ext <;> simp); rw [h0] at hq_tel
      have hne_sub : complex.sub r complex.one ≠ complex.zero := by intro hz; apply hr_ne1; apply complex.ext; (have hr1 : complex.re (complex.sub r complex.one) = complex.re complex.zero := (by rw [hz]); simp at hr1 ⊢; linarith); (have hi1 : complex.im (complex.sub r complex.one) = complex.im complex.zero := (by rw [hz]); simp at hi1 ⊢; linarith)
      by_contra hs_ne; exact complex.mul_ne_zero _ _ hne_sub hs_ne hq_tel
  have hdet_eq : cmat.det q (cmat.mul q (cmat.adj V) V) = cmat.det q (sernau.m81a_diag_real (fun _ => (q : ℝ))) := by apply cmat.det_congr; intro i hi j hj; exact hgram i hi j hj
  rw [cmat.det_mul, cmat.det_adj, sernau.m81a_det_diag_real] at hdet_eq
  have hconj_self : complex.mul (complex.conj (cmat.det q V)) (cmat.det q V) = complex.of_real (complex.norm_sq (cmat.det q V)) := by unfold complex.conj complex.norm_sq complex.of_real; apply complex.ext <;> simp <;> ring
  have hprod_qq : (∏ _ < q, (q : ℝ)) = (q : ℝ) ^ q := by have hrec : ∀ m : ℕ, (∏ _ < m, (q : ℝ)) = (q : ℝ) ^ m := (by intro m; induction m with t iht; (rw [prod_below_zero, pow_zero.real]); (rw [succ_eq_add_one.nat, prod_below_succ, pow_succ.real, iht])); exact hrec q
  rw [hconj_self, hprod_qq] at hdet_eq
  have hns_det : (complex.abs (cmat.det q V)) * (complex.abs (cmat.det q V)) = (q : ℝ) ^ q := by rw [complex.abs_sq]; have hr : complex.re (complex.of_real (complex.norm_sq (cmat.det q V))) = complex.re (complex.of_real ((q : ℝ) ^ q)) := (by rw [hdet_eq]); unfold complex.of_real at hr; simp at hr; exact hr
  set P1 := ∏ d < q - 1, complex.abs (complex.sub complex.one (cpow_nat (zeta_q q) (d + 1))) with hP1
  have habs_cprod : ∀ (m : ℕ) (f : ℕ → ℂ), complex.abs (cprod_c m f) = ∏ k < m, complex.abs (f k) := by intro m f; induction m with t iht; (rw [cprod_c.zero_eq, prod_below_zero]; exact sernau.m81a_abs_one_eq); (rw [succ_eq_add_one.nat, cprod_c.succ_eq, prod_below_succ, complex.abs_mul, iht])
  have hv_abs : complex.abs (cmat.det q V) = ∏ i < q, ∏ j < i, complex.abs (complex.sub (cpow_nat (zeta_q q) i) (cpow_nat (zeta_q q) j)) := by rw [hV, cmat.det_vandermonde, habs_cprod]; apply prod_below.congr_real; intro i _; exact habs_cprod i _
  set D_fn : ℕ → ℕ → ℝ := fun i j => if j = i then 1 else complex.abs (complex.sub (cpow_nat (zeta_q q) i) (cpow_nat (zeta_q q) j)) with hD_def
  have hD_symm : ∀ i j : ℕ, D_fn i j = D_fn j i := by intro i j; rw [hD_def]; by_cases hij : j = i; (rw [hij, if_pos (by rfl)]); rw [if_neg hij, if_neg (by omega)]; have hneg : complex.sub (cpow_nat (zeta_q q) i) (cpow_nat (zeta_q q) j) = complex.neg (complex.sub (cpow_nat (zeta_q q) j) (cpow_nat (zeta_q q) i)) := (by apply complex.ext <;> simp <;> ring); rw [hneg, complex.abs_neg]
  have hsq_eq_box : ∀ n : ℕ, (∏ i < n, ∏ j < n, D_fn i j) = (∏ i < n, ∏ j < i, complex.abs (complex.sub (cpow_nat (zeta_q q) i) (cpow_nat (zeta_q q) j))) * (∏ i < n, ∏ j < i, complex.abs (complex.sub (cpow_nat (zeta_q q) i) (cpow_nat (zeta_q q) j)))
    intro n; induction n with k ihk; (rw [prod_below_zero, prod_below_zero]; ring)
    rw [succ_eq_add_one.nat, prod_below_succ k (fun i => ∏ j < k + 1, D_fn i j), prod_below_succ k (fun i => ∏ j < i, complex.abs (complex.sub (cpow_nat (zeta_q q) i) (cpow_nat (zeta_q q) j)))]
    have hcol : (∏ i < k, ∏ j < k + 1, D_fn i j) = (∏ i < k, ∏ j < k, D_fn i j) * (∏ i < k, D_fn i k) := by have hc : ∀ m ≤ k, (∏ i < m, ∏ j < k + 1, D_fn i j) = (∏ i < m, ∏ j < k, D_fn i j) * (∏ i < m, D_fn i k) := (by intro m; induction m with _ t iht hle; (rw [prod_below_zero, prod_below_zero, prod_below_zero]; ring); (rw [succ_eq_add_one.nat] at hle ⊢; rw [prod_below_succ t, prod_below_succ t, prod_below_succ t, prod_below_succ k (D_fn t), iht (by omega)]; ring)); exact hc k (by omega)
    have hrow_k : (∏ j < k + 1, D_fn k j) = ∏ j < k, complex.abs (complex.sub (cpow_nat (zeta_q q) k) (cpow_nat (zeta_q q) j)) := by rw [prod_below_succ]; have hkk : D_fn k k = 1 := (by rw [hD_def, if_pos (by rfl)]); rw [hkk, mul_one.real]; apply prod_below.congr_real; intro j hj; rw [hD_def, if_neg (by omega)]
    have hcol_k : (∏ i < k, D_fn i k) = ∏ j < k, complex.abs (complex.sub (cpow_nat (zeta_q q) k) (cpow_nat (zeta_q q) j)) := by apply prod_below.congr_real; intro j hj; rw [hD_symm j k, hD_def, if_neg (by omega)]
    rw [hcol, ihk, hrow_k, hcol_k]; ring
  have hrow_eq_P1 : ∀ i < q, (∏ j < q, D_fn i j) = P1
    intro i hi
    have hunit_abs : ∀ m : ℕ, complex.abs (cpow_nat (zeta_q q) m) = 1 := by intro m; induction m with t iht; (rw [cpow_nat.zero_eq]; exact sernau.m81a_abs_one_eq); (rw [succ_eq_add_one.nat, cpow_nat.succ_eq, complex.abs_mul, iht, one_mul.real]; exact eq_of_sq_eq_nonneg (complex.abs (zeta_q q)) 1 (complex.abs_nonneg (zeta_q q)) (by decide) (by rw [complex.abs_sq, hz_ns]; ring))
    have hfac : ∀ j < q, D_fn i j = (if j = i then 1 else complex.abs (complex.sub complex.one (cpow_nat (zeta_q q) ((j + q - i) % q))))
      intro j hj; rw [hD_def]; by_cases hij : j = i; (rw [if_pos hij, if_pos hij]); rw [if_neg hij, if_neg hij]
      have hd : complex.mul (cpow_nat (zeta_q q) i) (complex.sub complex.one (cpow_nat (zeta_q q) ((j + q - i) % q))) = complex.sub (cpow_nat (zeta_q q) i) (complex.mul (cpow_nat (zeta_q q) i) (cpow_nat (zeta_q q) ((j + q - i) % q))) := by apply complex.ext <;> simp <;> ring
      have hm : (i + (j + q - i) % q) % q = j := by set r_ji := (j + q - i) % q with hrji_def; set q_ji := (j + q - i) / q with hqji_def; have hdm := div_add_mod.nat (j + q - i) q; rw [← hqji_def, ← hrji_def] at hdm; have he : (i + r_ji) + q * q_ji = j + q * 1 := (by omega); have hm1 := add_mul_mod.nat (i + r_ji) q_ji q; rw [he, add_mul_mod.nat, (div_mod_of_lt.nat j q hj).2] at hm1; exact hm1.symm
      have heq_sub : complex.sub (cpow_nat (zeta_q q) i) (cpow_nat (zeta_q q) j) = complex.mul (cpow_nat (zeta_q q) i) (complex.sub complex.one (cpow_nat (zeta_q q) ((j + q - i) % q))) := by rw [hd, ← cpow_nat.add, sernau.m81a_cpow_mod_eq q (zeta_q q) (i + (j + q - i) % q) hzq1, hm]
      rw [heq_sub, complex.abs_mul, hunit_abs i, one_mul.real]
    rw [prod_below.congr_real q _ _ hfac]
    have hsplit_p : ∀ (a b : ℕ) (g : ℕ → ℝ), (∏ x < a + b, g x) = (∏ x < a, g x) * (∏ y < b, g (a + y)) := by intro a b g; induction b with t iht; (have hz : a + 0 = a := (by omega); rw [hz, prod_below_zero]; ring); (rw [succ_eq_add_one.nat]; have hs : a + (t + 1) = (a + t) + 1 := (by omega); rw [hs, prod_below_succ, iht, prod_below_succ]; ring)
    have hqi : i + (1 + (q - 1 - i)) = q := (by omega)
    have hsp1 := hsplit_p i (1 + (q - 1 - i)) (fun j => if j = i then 1 else complex.abs (complex.sub complex.one (cpow_nat (zeta_q q) ((j + q - i) % q))))
    rw [hqi] at hsp1; rw [hsp1, hsplit_p 1 (q - 1 - i)]
    have hmid : (∏ y < 1, if i + y = i then (1 : ℝ) else complex.abs (complex.sub complex.one (cpow_nat (zeta_q q) (((i + y) + q - i) % q)))) = 1 := by have h1 : (1 : ℕ) = 0 + 1 := (by rfl); rw [h1, prod_below_succ, prod_below_zero, if_pos (by omega)]; ring
    rw [hmid, one_mul.real]
    have hL : (∏ x < i, if x = i then (1 : ℝ) else complex.abs (complex.sub complex.one (cpow_nat (zeta_q q) ((x + q - i) % q)))) = ∏ x < i, complex.abs (complex.sub complex.one (cpow_nat (zeta_q q) ((q - 1 - i) + x + 1))) := by apply prod_below.congr_real; intro x hx; rw [if_neg (by omega), (div_mod_of_lt.nat (x + q - i) q (by omega)).2]; have he : x + q - i = (q - 1 - i) + x + 1 := (by omega); rw [he]
    have hR : (∏ y < q - 1 - i, if i + (1 + y) = i then (1 : ℝ) else complex.abs (complex.sub complex.one (cpow_nat (zeta_q q) (((i + (1 + y)) + q - i) % q)))) = ∏ y < q - 1 - i, complex.abs (complex.sub complex.one (cpow_nat (zeta_q q) (y + 1))) := by apply prod_below.congr_real; intro y hy; rw [if_neg (by omega)]; have he : (i + (1 + y)) + q - i = (y + 1) + q * 1 := (by omega); rw [he, add_mul_mod.nat, (div_mod_of_lt.nat (y + 1) q (by omega)).2]
    rw [hL, hR]; have hq1_split : (q - 1 - i) + i = q - 1 := by omega
    have hP1_sp := hsplit_p (q - 1 - i) i (fun d => complex.abs (complex.sub complex.one (cpow_nat (zeta_q q) (d + 1))))
    rw [hq1_split, ← hP1] at hP1_sp; rw [hP1_sp]; ring
  have hbox_P1 : (∏ i < q, ∏ j < q, D_fn i j) = P1 ^ q := by have hrec : ∀ m ≤ q, (∏ i < m, ∏ j < q, D_fn i j) = P1 ^ m := (by intro m; induction m with _ t iht hle; (rw [prod_below_zero, pow_zero.real]); (rw [succ_eq_add_one.nat] at hle ⊢; rw [prod_below_succ, pow_succ.real, iht (by omega), hrow_eq_P1 t (by omega)])); exact hrec q (by omega)
  have hP1_pow_eq : P1 ^ q = (q : ℝ) ^ q := by rw [← hbox_P1, hsq_eq_box q, ← hv_abs, hns_det]
  have hP1_nn : 0 ≤ P1 := by rw [hP1]; have hrec : ∀ m : ℕ, 0 ≤ ∏ d < m, complex.abs (complex.sub complex.one (cpow_nat (zeta_q q) (d + 1))) := (by intro m; induction m with t iht; (rw [prod_below_zero]; decide); (rw [succ_eq_add_one.nat, prod_below_succ]; exact mul_nonneg.real _ _ iht (complex.abs_nonneg (complex.sub complex.one (cpow_nat (zeta_q q) (t + 1)))))); exact hrec (q - 1)
  have hstrict_pow : ∀ (a b : ℝ), 0 ≤ a → a < b → ∀ m : ℕ, 1 ≤ m → a ^ m < b ^ m
    intro a b ha hab m hm1; induction m with _ t iht hm1; omega; rw [succ_eq_add_one.nat] at hm1 ⊢
    by_cases ht0 : t = 0; (rw [ht0, pow_succ.real, pow_zero.real, pow_succ.real, pow_zero.real]; linarith)
    rw [pow_succ.real, pow_succ.real]; have hip := iht (by omega)
    linarith [mul_le_mul_of_nonneg_right.real (a ^ t) (b ^ t) a (by linarith) ha, mul_lt_mul_of_pos_left.real a b (b ^ t) hab (pow_pos.real b t (by linarith))]
  by_contra hne; by_cases hlt : P1 < (q : ℝ); linarith [hstrict_pow P1 (q : ℝ) hP1_nn hlt q hq]; linarith [hstrict_pow (q : ℝ) P1 (cast_nonneg.real q) (by linarith) q hq]

-> sernau.cyclo_ppow (p k : ℕ) (z : ℂ) : ℂ := csum p (fun j => cpow_nat z (j * (p ^ (k - 1))))
-> sernau.cyclo_ppow_deriv (p k : ℕ) (z : ℂ) : ℂ := csum p (fun j => if j = 0 then complex.zero else complex.mul (complex.of_real ((j * (p ^ (k - 1)) : ℕ) : ℝ)) (cpow_nat z (j * (p ^ (k - 1)) - 1)))

+ sernau.cyclotomic_deriv_norm_prod (p k : ℕ) (hp : is_prime_nat p) (hk : 1 ≤ k) :
    (∀ z : ℂ, complex.mul (complex.sub (cpow_nat z (p ^ (k - 1))) complex.one) (sernau.cyclo_ppow p k z) = complex.sub (cpow_nat z (p ^ k)) complex.one) ∧
    (∏ sig < p ^ k, if zmod.is_unit (p ^ k) sig then complex.abs (sernau.cyclo_ppow_deriv p k (cpow_nat (zeta_q (p ^ k)) sig)) else 1) =
    (((p ^ k : ℕ) : ℝ) / rpow (p : ℝ) (1 / ((p - 1 : ℕ) : ℝ))) ^ ((p - 1) * (p ^ (k - 1)))
  have hp2 : 2 ≤ p := hp.1; set pk1 := p ^ (k - 1) with hpk1
  have hpk1_pos : 0 < pk1 := by rw [hpk1]; exact pow_pos.nat p (k - 1) (by omega)
  have hpk_eq : p ^ k = pk1 * p := by have hk1 : k = (k - 1) + 1 := (by omega); rw [hk1, pow_succ.nat, ← hpk1]
  have hpk_pos : 0 < p ^ k := by rw [hpk_eq]; exact mul_pos.nat pk1 p hpk1_pos (by omega)
  have hid1 : ∀ z : ℂ, complex.mul (complex.sub (cpow_nat z pk1) complex.one) (sernau.cyclo_ppow p k z) = complex.sub (cpow_nat z (p ^ k)) complex.one
    intro z; unfold sernau.cyclo_ppow; rw [← hpk1, hpk_eq, cpow_nat.mul z pk1 p]; set w := cpow_nat z pk1 with hw_def
    have hcongr : csum p (fun j => cpow_nat z (j * pk1)) = csum p (fun j => cpow_nat w j) := by apply csum.congr; intro j _; have hc : j * pk1 = pk1 * j := (by ring); rw [hc, cpow_nat.mul z pk1 j, ← hw_def]
    rw [hcongr]
    have htel : ∀ m : ℕ, complex.mul (complex.sub w complex.one) (csum m (fun j => cpow_nat w j)) = complex.sub (cpow_nat w m) complex.one := by intro m; induction m with t iht; (rw [csum.zero, cpow_nat.zero_eq]; apply complex.ext <;> simp); (rw [succ_eq_add_one.nat, csum.succ, cpow_nat.succ_eq]; have hd : complex.mul (complex.sub w complex.one) (complex.add (csum t (fun j => cpow_nat w j)) (cpow_nat w t)) = complex.add (complex.mul (complex.sub w complex.one) (csum t (fun j => cpow_nat w j))) (complex.mul (complex.sub w complex.one) (cpow_nat w t)) := (by apply complex.ext <;> simp <;> ring); rw [hd, iht]; apply complex.ext <;> simp <;> ring)
    exact htel p
  constructor; exact hid1
  have hupr_pk : is_unitary_prim_root (p ^ k) (zeta_q (p ^ k)) := by unfold zeta_q; exact uproot.cexp_is_unitary_prim (p ^ k) hpk_pos
  have hupr_p : is_unitary_prim_root p (zeta_q p) := by unfold zeta_q; exact uproot.cexp_is_unitary_prim p (by omega)
  have hderiv_id : ∀ sig < p ^ k, zmod.is_unit (p ^ k) sig → complex.abs (sernau.cyclo_ppow_deriv p k (cpow_nat (zeta_q (p ^ k)) sig)) = ((p ^ k : ℕ) : ℝ) / complex.abs (complex.sub complex.one (cpow_nat (zeta_q p) (sig % p)))
    intro sig hsig hu; set ζ := cpow_nat (zeta_q (p ^ k)) sig with hζ_def
    have hnd_p : ¬ (p ∣ sig) := by intro hd; exact (zmod.is_unit_iff_no_common_prime (p ^ k) sig hpk_pos).mp hu p ((sernau.m81a_prime_iff p).mpr hp) ((dvd.iff_exists p (p ^ k) (by omega)).mpr ⟨pk1, by rw [hpk_eq]; ring⟩) hd
    have hζ_pk1 : cpow_nat ζ pk1 = cpow_nat (zeta_q p) (sig % p)
      rw [hζ_def, ← cpow_nat.mul (zeta_q (p ^ k)) sig pk1, sernau.m81a_zeta_pow_eq_exp (p ^ k) (sig * pk1)]
      have harg : 2 * pi * ((sig * pk1 : ℕ) : ℝ) / ((p ^ k : ℕ) : ℝ) = 2 * pi * (sig : ℝ) / (p : ℝ) := by rw [hpk_eq, cast_mul.real sig pk1, cast_mul.real pk1 p]; have hpk1_r : (0 : ℝ) < (pk1 : ℝ) := (cast_pos.real pk1).mpr hpk1_pos; have hp_r : (0 : ℝ) < (p : ℝ) := (cast_pos.real p).mpr (by omega); field_simp
      rw [harg, ← sernau.m81a_zeta_pow_eq_exp p sig, sernau.m81a_cpow_mod_eq p (zeta_q p) sig hupr_p.2.2.1]
    have hrm_pos : 0 < sig % p := by by_contra h0; have hz : sig % p = 0 := (by omega); exact hnd_p hz
    have hden_ne : complex.sub (cpow_nat (zeta_q p) (sig % p)) complex.one ≠ complex.zero := by intro hz; apply hupr_p.2.2.2 (sig % p) hrm_pos (mod_lt.nat sig p (by omega)); apply complex.ext; (have hr : complex.re (complex.sub (cpow_nat (zeta_q p) (sig % p)) complex.one) = complex.re complex.zero := (by rw [hz]); simp at hr ⊢; linarith); (have hi : complex.im (complex.sub (cpow_nat (zeta_q p) (sig % p)) complex.one) = complex.im complex.zero := (by rw [hz]); simp at hi ⊢; linarith)
    have halg_deriv : complex.mul ζ (complex.mul (complex.sub (cpow_nat ζ pk1) complex.one) (sernau.cyclo_ppow_deriv p k ζ)) =
        complex.sub (complex.mul (complex.of_real ((p ^ k : ℕ) : ℝ)) (cpow_nat ζ (p ^ k))) (complex.mul (complex.of_real (pk1 : ℝ)) (complex.mul (cpow_nat ζ pk1) (sernau.cyclo_ppow p k ζ)))
      unfold sernau.cyclo_ppow_deriv sernau.cyclo_ppow; rw [← hpk1]
      have hmul_in : ∀ m : ℕ, complex.mul ζ (csum m (fun j => if j = 0 then complex.zero else complex.mul (complex.of_real ((j * pk1 : ℕ) : ℝ)) (cpow_nat ζ (j * pk1 - 1)))) = csum m (fun j => complex.mul (complex.of_real ((j * pk1 : ℕ) : ℝ)) (cpow_nat ζ (j * pk1)))
        intro m; induction m with t iht; (rw [csum.zero, csum.zero, complex.mul_zero]); rw [succ_eq_add_one.nat, csum.succ, csum.succ]
        have hd : complex.mul ζ (complex.add (csum t (fun j => if j = 0 then complex.zero else complex.mul (complex.of_real ((j * pk1 : ℕ) : ℝ)) (cpow_nat ζ (j * pk1 - 1)))) (if t = 0 then complex.zero else complex.mul (complex.of_real ((t * pk1 : ℕ) : ℝ)) (cpow_nat ζ (t * pk1 - 1)))) = complex.add (complex.mul ζ (csum t (fun j => if j = 0 then complex.zero else complex.mul (complex.of_real ((j * pk1 : ℕ) : ℝ)) (cpow_nat ζ (j * pk1 - 1))))) (complex.mul ζ (if t = 0 then complex.zero else complex.mul (complex.of_real ((t * pk1 : ℕ) : ℝ)) (cpow_nat ζ (t * pk1 - 1)))) := by apply complex.ext <;> simp <;> ring
        rw [hd, iht]; by_cases ht0 : t = 0; (rw [ht0, if_pos (by rfl), zero_mul.nat, complex.mul_zero]; have hc0 : complex.of_real ((0 : ℕ) : ℝ) = complex.zero := (by unfold complex.of_real; apply complex.ext <;> simp); rw [hc0, complex.zero_mul])
        rw [if_neg ht0]; have hpos_tp : 0 < t * pk1 := mul_pos.nat t pk1 (by omega) hpk1_pos; have hsub1 : (t * pk1 - 1) + 1 = t * pk1 := by omega
        have hp_step : cpow_nat ζ ((t * pk1 - 1) + 1) = complex.mul ζ (cpow_nat ζ (t * pk1 - 1)) := by rw [cpow_nat.succ_eq]; apply complex.ext <;> simp <;> ring
        rw [hsub1] at hp_step
        have hassoc : complex.mul ζ (complex.mul (complex.of_real ((t * pk1 : ℕ) : ℝ)) (cpow_nat ζ (t * pk1 - 1))) = complex.mul (complex.of_real ((t * pk1 : ℕ) : ℝ)) (complex.mul ζ (cpow_nat ζ (t * pk1 - 1))) := by apply complex.ext <;> simp <;> ring
        rw [hassoc, ← hp_step]
      have hcomm1 : complex.mul ζ (complex.mul (complex.sub (cpow_nat ζ pk1) complex.one) (csum p (fun j => if j = 0 then complex.zero else complex.mul (complex.of_real ((j * pk1 : ℕ) : ℝ)) (cpow_nat ζ (j * pk1 - 1))))) = complex.mul (complex.sub (cpow_nat ζ pk1) complex.one) (complex.mul ζ (csum p (fun j => if j = 0 then complex.zero else complex.mul (complex.of_real ((j * pk1 : ℕ) : ℝ)) (cpow_nat ζ (j * pk1 - 1))))) := by apply complex.ext <;> simp <;> ring
      rw [hcomm1, hmul_in p, hpk_eq]; set w := cpow_nat ζ pk1 with hw_def
