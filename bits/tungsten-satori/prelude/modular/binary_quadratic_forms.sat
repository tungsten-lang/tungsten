  have hprod_blocks : ∀ (M K : ℕ) (g : ℕ → ℝ), (∏ x < M * K, g x) = ∏ q < K, ∏ r < M, g (r + M * q) := by intro M K g; induction K with q ihq; (have hz : M * 0 = 0 := (by ring); rw [hz, prod_below_zero, prod_below_zero]); rw [succ_eq_add_one.nat]; have hmk : M * (q + 1) = M * q + M := (by ring); have hadd : ∀ n : ℕ, (∏ x < M * q + n, g x) = (∏ x < M * q, g x) * ∏ r < n, g (r + M * q) := (by intro n; induction n with j ihj; (have hz : M * q + 0 = M * q := (by omega); rw [hz, prod_below_zero]; ring); (rw [succ_eq_add_one.nat]; have hs : M * q + (j + 1) = (M * q + j) + 1 := (by omega); have hr : j + M * q = M * q + j := (by omega); rw [hs, prod_below_succ, ihj, prod_below_succ, hr]; ring)); rw [hmk, hadd M, prod_below_succ, ihq]
