    have hexp_d_gen : ∀ (c : ℂ) (t : ℝ), has_deriv_within (fun x => complex.re (complex.exp (complex.smul x c))) (fun z0 => 0 ≤ z0 ∧ z0 ≤ 1 / 2) t (complex.re (complex.mul c (complex.exp (complex.smul t c)))) ∧ has_deriv_within (fun x => complex.im (complex.exp (complex.smul x c))) (fun z0 => 0 ≤ z0 ∧ z0 ≤ 1 / 2) t (complex.im (complex.mul c (complex.exp (complex.smul t c)))) := by intro c t; set uc := complex.re c with huc; set vc := complex.im c with hvc; set S := (fun (z0 : ℝ) => 0 ≤ z0 ∧ z0 ≤ 1 / 2); have he_d := has_deriv_within.exp_comp (fun x => x * uc) S t uc (by have h := has_deriv_within.scale_id uc S t; have hf : (fun y => uc * y) = (fun x => x * uc) := (by funext y; ring); rw [hf] at h; exact h); have hc_d := has_deriv_within.comp cos (fun x => x * vc) S (fun _ => True) t (-sin (t * vc)) vc (has_deriv_within.cos (fun _ => True) (t * vc)) (by have h := has_deriv_within.scale_id vc S t; have hf : (fun y => vc * y) = (fun x => x * vc) := (by funext y; ring); rw [hf] at h; exact h) (by intro _ _; trivial); have hs_d := has_deriv_within.comp sin (fun x => x * vc) S (fun _ => True) t (cos (t * vc)) vc (has_deriv_within.sin (fun _ => True) (t * vc)) (by have h := has_deriv_within.scale_id vc S t; have hf : (fun y => vc * y) = (fun x => x * vc) := (by funext y; ring); rw [hf] at h; exact h) (by intro _ _; trivial); have hm_re := has_deriv_within.mul _ _ S t _ _ he_d hc_d; have hm_im := has_deriv_within.mul _ _ S t _ _ he_d hs_d; have hfre : (fun x => exp (x * uc) * cos (x * vc)) = (fun x => complex.re (complex.exp (complex.smul x c))) := (by funext x; rw [huc, hvc]; unfold complex.exp; simp); have hfim : (fun x => exp (x * uc) * sin (x * vc)) = (fun x => complex.im (complex.exp (complex.smul x c))) := (by funext x; rw [huc, hvc]; unfold complex.exp; simp); have hvre : (exp (t * uc) * uc) * cos (t * vc) + exp (t * uc) * (-sin (t * vc) * vc) = complex.re (complex.mul c (complex.exp (complex.smul t c))) := (by rw [huc, hvc]; unfold complex.exp; simp; ring); have hv