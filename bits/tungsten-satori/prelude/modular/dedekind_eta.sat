_; obtain ⟨dr, di⟩ := hexp_d_gen c t; have hs := has_deriv_within.add _ _ S t _ _ (has_deriv_within.scale (complex.re (complex.inv c)) _ S t _ di) (has_deriv_within.scale (complex.im (complex.inv c)) _ S t _ dr); have hf : (fun x => complex.re (complex.inv c) * complex.im (complex.exp (complex.smul x c)) + complex.im (complex.inv c) * complex.re (complex.exp (complex.smul x c))) = (fun x => complex.im (Pc x)) := (by funext x; rw [hPc]; simp); have hv_c : complex.mul (complex.inv c) (complex.mul c (complex.exp (complex.smul t c))) = complex.exp (complex.smul t c) := (by have ha : complex.mul (complex.inv c) (complex.mul c (complex.exp (complex.smul t c))) = complex.mul (complex.mul c (complex.inv c)) (complex.exp (complex.smul t c)) := (by apply complex.ext <;> simp <;> ring); rw [ha, hic, complex.one_mul]); have hv : complex.re (complex.inv c) * complex.im (complex.mul c (complex.exp (complex.smul t c))) + complex.im (complex.inv c) * complex.re (complex.mul c (complex.exp (complex.smul t c))) = complex.im (complex.exp (complex.smul t c)) := (by have hi : complex.im (complex.mul (complex.inv c) (complex.mul c (complex.exp (complex.smul t c)))) = complex.im (complex.exp (complex.smul t c)) := (by rw [hv_c]); simp at hi; exact hi); rw [hf, hv] at hs; exact hs); rw [S_def] at hPc_re hPc_im; have hir := darboux.fundamental (fun x => complex.re (Pc x)) (fun x => complex.re (complex.exp (complex.smul x c))) 0 (1 / 2) (by decide) (by intro t _ _; unfold complex.exp; simp; continuity) hPc_re; have hii := darboux.fundamental (fun x => complex.im (Pc x)) (fun x => complex.im (complex.exp (complex.smul x c))) 0 (1 / 2) (by decide) (by intro t _ _; unfold complex.exp; simp; continuity) hPc_im; have hP0 : Pc 0 = complex.mul (complex.inv c) complex.one := (by rw [hPc]; have h0 : complex.smul 0 c = complex.zero := (by apply complex.ext <;> simp); have he0 : complex.exp complex.zero = complex.one := (by unfold complex.exp; apply complex.ext <;> simp [exp_zero, cos_zero, sin_zero]);