      have hCw_pos : 0 < Cw := by rw [hCw]; linarith [complex.abs_nonneg (complex.inv (complex.sub complex.one wz))]
      obtain ⟨R0, hR0⟩ := hSg (e / (2 * Cw)) (div_pos.real e (2 * Cw) he (by linarith)); use R0; intro R hR
      have h1 := hR0 (R + 1) (by omega); have h2 := hR0 (R + 2) (by omega); unfold partial_sum at h1 h2
      have hstep_g : (∑ k < R + 2, (exp (-(2 * pi * beta))) ^ k) - (∑ k < R + 1, (exp (-(2 * pi * beta))) ^ k) = (exp (-2 * pi * beta)) ^ (R + 1)
        have hR2 : R + 2 = (R + 1) + 1 := by omega
        rw [hR2, sum_below_succ]; have he2 : -(2 * pi * beta) = -2 * pi * beta := (by ring); rw [he2]; ring
      have hi2Cw := mul_inv_cancel.real (2 * Cw) (by linarith)
      have hiCw := mul_inv_cancel.real Cw (by linarith)
      have he2Cw : e / (2 * Cw) + e / (2 * Cw) = e / Cw := by rw [div_def.real e (2 * Cw), div_def.real e Cw]; linear_combination -(2 * e * (1 / (2 * Cw))) * hiCw + (e * (1 / Cw)) * hi2Cw
      have hpow_lt : (exp (-2 * pi * beta)) ^ (R + 1) < e / Cw := by linarith [le_abs_self.real ((∑ k < R + 2, (exp (-(2 * pi * beta))) ^ k) - Sg), neg_le_abs.real ((∑ k < R + 1, (exp (-(2 * pi * beta))) ^ k) - Sg), he2Cw]
      change abs ((∑ r < R, exp (-2 * pi * ((r + 1 : ℕ) : ℝ) * beta) * cos (2 * pi * ((r + 1 : ℕ) : ℝ) * alpha)) - complex.re (complex.mul wz (complex.inv (complex.sub complex.one wz)))) < e
      rw [hsum_re R, htel_wz R]
      have hdiff_c : complex.re (complex.mul (complex.sub wz (cpow_nat wz (R + 1))) (complex.inv (complex.sub complex.one wz))) - complex.re (complex.mul wz (complex.inv (complex.sub complex.one wz))) = complex.re (complex.neg (complex.mul (cpow_nat wz (R + 1)) (complex.inv (complex.sub complex.one wz)))) := by simp; ring
      rw [hdiff_c]; have hle_r := complex.re_abs_le (complex.neg (complex.mul (cpow_nat wz (R + 1)) (complex.inv (complex.sub complex.one wz))))
      rw [complex.abs_neg, complex.abs_mul, (hpow_wz R).2] at hle_r
      have hm := mul_le_mul_of_nonneg_left.real (complex.abs (complex.inv (complex.sub complex.one wz))) Cw ((exp (-2 * pi * beta)) ^ (R + 1)) (by rw [hCw]; linarith) (pow_nonneg.real (exp (-2 * pi * beta)) (by linarith [exp_pos (-2 * pi * beta)]) (R + 1))
      have hm2 := mul_lt_mul_of_pos_right.real ((exp (-2 * pi * beta)) ^ (R + 1)) (e / Cw) Cw hpow_lt hCw_pos
      have heCw : (e / Cw) * Cw = e := (by rw [div_def.real e Cw]; linear_combination e * hiCw); linarith [heCw]
    have hrhs_match : -(1 / beta) * complex.im (complex.mul fac (complex.add complex.one wz)) = (pi / beta) + (2 * pi / beta) * rlim (fun R => ∑ r < R, exp (-2 * pi * ((r + 1 : ℕ) : ℝ) * beta) * cos (2 * pi * ((r + 1 : ℕ) : ℝ) * alpha))
      rw [rlim.eq_of_tends_to _ _ hgeom_wz, hfac]
      have hinv_sw : complex.inv (complex.sub wz complex.one) = complex.neg (complex.inv (complex.sub complex.one wz))
        have h3 : complex.mul (complex.sub wz complex.one) (complex.neg (complex.inv (complex.sub complex.one wz))) = complex.one
          have he : complex.mul (complex.sub wz complex.one) (complex.neg (complex.inv (complex.sub complex.one wz))) = complex.mul (complex.sub complex.one wz) (complex.inv (complex.sub complex.one wz)) := by apply complex.ext <;> simp <;> ring
          rw [he, hi1w]
        have h4 : complex.mul (complex.inv (complex.sub wz complex.one)) (complex.mul (complex.sub wz complex.one) (complex.neg (complex.inv (complex.sub complex.one wz)))) = complex.mul (complex.inv (complex.sub wz complex.one)) complex.one := by rw [h3]
        have hl : complex.mul (complex.inv (complex.sub wz complex.one)) (complex.mul (complex.sub wz complex.one) (complex.neg (complex.inv (complex.sub complex.one wz)))) = complex.mul (complex.mul (complex.sub wz complex.one) (complex.inv (complex.sub wz complex.one))) (complex.neg (complex.inv (complex.sub complex.one wz))) := by apply complex.ext <;> simp <;> ring
        rw [hl, hi_wz, complex.one_mul, complex.mul_one] at h4; exact h4.symm
      have halg_w : complex.mul (complex.add complex.one wz) (complex.neg (complex.inv (complex.sub complex.one wz))) = complex.neg (complex.add complex.one (complex.smul 2 (complex.mul wz (complex.inv (complex.sub complex.one wz)))))
        have hadd_id : complex.add complex.one wz = complex.add (complex.sub complex.one wz) (complex.smul 2 wz) := by apply complex.ext <;> simp <;> ring
        rw [hadd_id]
        have hd : complex.mul (complex.add (complex.sub complex.one wz) (complex.smul 2 wz)) (complex.neg (complex.inv (complex.sub complex.one wz))) = complex.neg (complex.add (complex.mul (complex.sub complex.one wz) (complex.inv (complex.sub complex.one wz))) (complex.smul 2 (complex.mul wz (complex.inv (complex.sub complex.one wz))))) := by apply complex.ext <;> simp <;> ring
        rw [hd, hi1w]
      have hassoc_f : complex.mul (complex.mul (complex.mk 0 pi) (complex.inv (complex.sub wz complex.one))) (complex.add complex.one wz) = complex.mul (complex.mk 0 pi) (complex.mul (complex.add complex.one wz) (complex.inv (complex.sub wz complex.one))) := by apply complex.ext <;> simp <;> ring
      rw [hassoc_f, hinv_sw, halg_w]; simp; rw [div_def.real pi beta, div_def.real (2 * pi) beta]; ring
    unfold tends_to; intro e he; unfold ctends_to at hscaled_lim; obtain ⟨M0, hM0⟩ := hscaled_lim (e * beta) (mul_pos.real e beta he hbeta); use M0; intro M hM
    change abs ((∑ ix < 2 * M + 1, 1 / (((((ix : ℤ) - (M : ℤ) : ℤ) : ℝ) + alpha) ^ 2 + beta ^ 2)) - ((pi / beta) + (2 * pi / beta) * rlim (fun R => ∑ r < R, exp (-2 * pi * ((r + 1 : ℕ) : ℝ) * beta) * cos (2 * pi * ((r + 1 : ℕ) : ℝ) * alpha)))) < e
    rw [← hbox_eq M, ← hcot_seq_eq M, ← hrhs_match]
    set dz := complex.sub (complex.mul fac (complex.add (complex.smul 2 (ck 0)) (complex.smul 4 (csum M (fun k => ck (k + 1)))))) (complex.mul fac (complex.add complex.one wz)) with hdz
    have him_le := complex.im_abs_le dz
    have hdiff_r : -(1 / beta) * complex.im (complex.mul fac (complex.add (complex.smul 2 (ck 0)) (complex.smul 4 (csum M (fun k => ck (k + 1)))))) - -(1 / beta) * complex.im (complex.mul fac (complex.add complex.one wz)) = -(1 / beta) * complex.im dz := by rw [hdz]; simp; ring
    have h1b_pos := one_div_pos.real beta hbeta
    have h1b_nn : 0 ≤ 1 / beta := by linarith
    have ha_eq : |-(1 / beta) * complex.im dz| = (1 / beta) * |complex.im dz| := by rw [abs_mul.real, abs_neg_eq, abs_of_pos.real (1 / beta) h1b_pos]
    have hM0_dz : complex.abs dz < e * beta := by rw [hdz]; exact hM0 M hM
    rw [hdiff_r, ha_eq]; have hm1 := mul_le_mul_of_nonneg_left.real (|complex.im dz|) (complex.abs dz) (1 / beta) him_le h1b_nn; have hm2 := mul_lt_mul_of_pos_left.real (complex.abs dz) (e * beta) (1 / beta) hM0_dz h1b_pos
    have heb : (1 / beta) * (e * beta) = e := by linear_combination e * hibeta
    linarith [heb]
