-- Milestone 3.81a (Part 3): Dedekind Eta Product, Modular Discriminant `modular_disc`,
--                           and Kronecker's First Limit Formula (`Lib/CM/KroneckerLimit/LogTheta.lean`)
--
-- Proved unconditionally on Satori's untouched HOL kernel (ZERO custom axioms).

import modular.epstein_zeta

-> sernau.q_param (tau : ℂ) : ℂ := complex.exp (complex.mul (complex.mk 0 (2 * pi)) tau)
-> sernau.eta_prod (tau : ℂ) : ℂ := clim (fun N => cprod N (fun k => complex.sub complex.one (cpow_nat (sernau.q_param tau) (k + 1))))
-> sernau.mod_disc_norm (tau : ℂ) : ℂ := complex.mul (sernau.q_param tau) (cpow_nat (sernau.eta_prod tau) 24)
-> sernau.modular_disc (tau : ℂ) : ℂ := complex.mul (complex.of_real ((2 * pi) ^ 12)) (sernau.mod_disc_norm tau)
-> sernau.epstein_lat_box (tau : ℂ) (k s : ℝ) (R : ℕ) : ℝ :=
  ∑ ix < 2 * R + 1, ∑ iy < 2 * R + 1,
    if ix = R ∧ iy = R then 0
    else rpow (complex.norm_sq (complex.add (c_of_int ((ix : ℤ) - (R : ℤ))) (complex.mul (c_of_int ((iy : ℤ) - (R : ℤ))) tau)) / (k * complex.im tau)) (-s)
-> sernau.epstein_lat (tau : ℂ) (k s : ℝ) : ℝ := (s - 1) * rlim (sernau.epstein_lat_box tau k s)
-> sernau.row_int_val (s : ℝ) : ℝ := rlim (fun K => 2 * rint (fun th => rpow (cos th) (2 * (s - 1))) 0 (pi / 2 - 1 / ((K + 2 : ℕ) : ℝ)))
-> sernau.row_defect_term (tau : ℂ) (n : ℕ) (m : ℤ) (s : ℝ) : ℝ :=
  rint (fun t => rpow (((m : ℝ) + (n : ℝ) * complex.re tau) ^ 2 + ((n : ℝ) * complex.im tau) ^ 2) (-s) -
                 rpow ((((m : ℝ) + t) + (n : ℝ) * complex.re tau) ^ 2 + ((n : ℝ) * complex.im tau) ^ 2) (-s)) 0 1

+ sernau.modular_disc_ne_zero_and_log (tau : ℂ) (htau : 0 < complex.im tau) :
    complex.abs (sernau.q_param tau) = exp (-2 * pi * complex.im tau) ∧
    complex.abs (sernau.q_param tau) < 1 ∧
    sernau.eta_prod tau ≠ complex.zero ∧
    sernau.mod_disc_norm tau ≠ complex.zero ∧
    sernau.modular_disc tau ≠ complex.zero ∧
    ctends_to (fun N => cprod N (fun k => complex.sub complex.one (cpow_nat (sernau.q_param tau) (k + 1)))) (sernau.eta_prod tau) ∧
    ctends_to (fun N => cprod N (fun k => cpow_nat (complex.sub complex.one (cpow_nat (sernau.q_param tau) (k + 1))) 24)) (cpow_nat (sernau.eta_prod tau) 24) ∧
    tends_to (fun N => ∑ k < N, log (complex.abs (complex.sub complex.one (cpow_nat (sernau.q_param tau) (k + 1))))) (log (complex.abs (sernau.eta_prod tau))) ∧
    log (complex.abs (sernau.mod_disc_norm tau)) = -2 * pi * complex.im tau + 24 * log (complex.abs (sernau.eta_prod tau)) ∧
    complex.abs (sernau.modular_disc tau) / ((2 * pi) ^ 12) = complex.abs (sernau.mod_disc_norm tau) ∧
    log (complex.abs (sernau.modular_disc tau)) = 12 * log (2 * pi) + log (complex.abs (sernau.mod_disc_norm tau)) ∧
    (∀ w : ℂ, complex.abs w < 1 → tends_to (fun R => ∑ r < R, complex.re (cpow_nat w (r + 1)) / ((r + 1 : ℕ) : ℝ)) (-log (complex.abs (complex.sub complex.one w))))
  have hpi_pos : 0 < pi := by linarith [pi_bounds.1]
  have habs1 : complex.abs complex.one = 1 := by apply eq_of_sq_eq_nonneg (complex.abs complex.one) 1 (complex.abs_nonneg complex.one) (by decide); rw [complex.abs_sq]; unfold complex.norm_sq; simp
  have habs_pos_of_ne : ∀ z : ℂ, z ≠ complex.zero → 0 < complex.abs z := by intro z hz; by_contra hle; exact hz ((complex.abs_eq_zero z).mp (by linarith [complex.abs_nonneg z]))
  have habs_exp : ∀ z : ℂ, complex.abs (complex.exp z) = exp (complex.re z) := by intro z; apply eq_of_sq_eq_nonneg (complex.abs (complex.exp z)) (exp (complex.re z)) (complex.abs_nonneg (complex.exp z)) (by linarith [exp_pos (complex.re z)]); rw [complex.abs_sq]; unfold complex.exp complex.norm_sq; simp; linear_combination (exp (complex.re z) * exp (complex.re z)) * sin_sq_add_cos_sq (complex.im z)
  have habs_cpow : ∀ (z : ℂ) (m : ℕ), complex.abs (cpow_nat z m) = (complex.abs z) ^ m := by intro z m; induction m with j ihj; (rw [cpow_nat.zero_eq, pow_zero.real]; exact habs1); (rw [succ_eq_add_one.nat, cpow_nat.succ_eq, pow_succ.real, complex.abs_mul, ihj])
  set c := 2 * pi * complex.im tau with hc_def
  have hc_pos : 0 < c := by rw [hc_def]; exact mul_pos.real (2 * pi) (complex.im tau) (by linarith) htau
  have hq_abs : complex.abs (sernau.q_param tau) = exp (-c) := by unfold sernau.q_param; rw [habs_exp]; have hr : complex.re (complex.mul (complex.mk 0 (2 * pi)) tau) = -c := (by rw [hc_def]; simp; ring); rw [hr]
  have hq_lt1 : complex.abs (sernau.q_param tau) < 1 := by rw [hq_abs]; have he : exp (-c) * exp c = 1 := (by rw [← exp_add]; have h0 : -c + c = 0 := (by ring); rw [h0, exp_zero]); by_contra hge; have hm := mul_le_mul_of_nonneg_left.real 1 (exp (-c)) (exp c) (by linarith) (by linarith [exp_pos c]); linarith [exp_ge_one_add c]
  set q := sernau.q_param tau with hq_def
  set u : ℕ → ℂ := fun k => complex.neg (cpow_nat q (k + 1)) with hu_def
  have hu_sum : summable (fun k => complex.abs (u k)) := summable.of_nonneg_le _ (fun k => exp (-c) * ((exp (-c)) ^ k)) (by intro k; exact complex.abs_nonneg _) (by intro k; rw [hu_def, complex.abs_neg, habs_cpow, hq_abs, pow_succ.real]; linarith) (summable.scale_real (exp (-c)) (fun k => (exp (-c)) ^ k) (summable.exp_neg_geom c hc_pos))
  have hpow_lt1 : ∀ (r : ℝ) (m : ℕ), 0 ≤ r → r < 1 → r ^ (m + 1) ≤ r := by intro r m hr0 hr1; induction m with j ihj; (rw [pow_succ.real, pow_zero.real]; linarith); (rw [succ_eq_add_one.nat, pow_succ.real r (j + 1)]; linarith [mul_le_mul_of_nonneg_right.real (r ^ (j + 1)) 1 r (by linarith) hr0])
  have hu_ne : ∀ k : ℕ, complex.add complex.one (u k) ≠ complex.zero := by intro k hz; have h1 : complex.one = cpow_nat q (k + 1) := (by rw [hu_def] at hz; apply complex.ext <;> (have hr : complex.re (complex.add complex.one (complex.neg (cpow_nat q (k + 1)))) = 0 := (by rw [hz]; simp); have hi : complex.im (complex.add complex.one (complex.neg (cpow_nat q (k + 1)))) = 0 := (by rw [hz]; simp); simp at hr hi ⊢; linarith)); have ha2 : complex.abs complex.one = (complex.abs q) ^ (k + 1) := (by rw [h1, habs_cpow]); linarith [hpow_lt1 (complex.abs q) k (complex.abs_nonneg q) hq_lt1]
  obtain ⟨P, hP_ne, hP_lim⟩ := cprod.converges_and_ne_zero u hu_sum hu_ne
  have hf_eq : (fun k => complex.add complex.one (u k)) = (fun k => complex.sub complex.one (cpow_nat q (k + 1))) := by funext k; rw [hu_def]; apply complex.ext <;> simp <;> ring
  rw [hf_eq] at hP_lim
  have heta_eq : sernau.eta_prod tau = P := by unfold sernau.eta_prod; rw [← hq_def]; exact clim.eq_of_tends_to _ P hP_lim
  rw [← heta_eq] at hP_ne hP_lim
  have hcpow_ne : ∀ (z : ℂ) (m : ℕ), z ≠ complex.zero → cpow_nat z m ≠ complex.zero := by intro z m hz h0; have ha := habs_cpow z m; rw [h0, complex.abs_zero] at ha; linarith [pow_pos.real (complex.abs z) (habs_pos_of_ne z hz) m]
  have hq_ne : q ≠ complex.zero := by intro hz; rw [hz, complex.abs_zero] at hq_abs; linarith [exp_pos (-c)]
  have hmdn_ne : sernau.mod_disc_norm tau ≠ complex.zero := by unfold sernau.mod_disc_norm; rw [← hq_def]; exact complex.mul_ne_zero q _ hq_ne (hcpow_ne _ 24 hP_ne)
  have h2pi12_pos : 0 < (2 * pi) ^ 12 := pow_pos.real (2 * pi) (by linarith) 12
  have hmd_ne : sernau.modular_disc tau ≠ complex.zero := by unfold sernau.modular_disc; exact complex.mul_ne_zero _ _ (by intro hz; have hr : complex.re (complex.of_real ((2 * pi) ^ 12)) = 0 := (by rw [hz]; simp); simp at hr; linarith) hmdn_ne
  have hcpow_mul : ∀ (m : ℕ) (a b : ℂ), cpow_nat (complex.mul a b) m = complex.mul (cpow_nat a m) (cpow_nat b m) := by intro m a b; induction m with j ihj; (rw [cpow_nat.zero_eq, cpow_nat.zero_eq, cpow_nat.zero_eq, complex.mul_one]); (rw [succ_eq_add_one.nat, cpow_nat.succ_eq, cpow_nat.succ_eq, cpow_nat.succ_eq, ihj]; apply complex.ext <;> simp <;> ring)
  set fq : ℕ → ℂ := fun k => complex.sub complex.one (cpow_nat q (k + 1)) with hfq_def
  have hcprod_pow : ∀ N : ℕ, cprod N (fun k => cpow_nat (fq k) 24) = cpow_nat (cprod N fq) 24 := by intro N; induction N with j ihj; (have h0 : cprod 0 (fun k => cpow_nat (fq k) 24) = complex.one := (by rfl); have h0' : cprod 0 fq = complex.one := (by rfl); have h1_m : ∀ m : ℕ, cpow_nat complex.one m = complex.one := (by intro m; induction m with l ihl; rw [cpow_nat.zero_eq]; (rw [succ_eq_add_one.nat, cpow_nat.succ_eq, ihl, complex.mul_one])); rw [h0, h0', h1_m 24]); (rw [succ_eq_add_one.nat]; have hs1 : cprod (j + 1) (fun k => cpow_nat (fq k) 24) = complex.mul (cprod j (fun k => cpow_nat (fq k) 24)) (cpow_nat (fq j) 24) := (by rfl); have hs2 : cprod (j + 1) fq = complex.mul (cprod j fq) (fq j) := (by rfl); rw [hs1, hs2, ihj, hcpow_mul])
  have hlim_pow : ∀ m : ℕ, ctends_to (fun N => cpow_nat (cprod N fq) m) (cpow_nat (sernau.eta_prod tau) m) := by intro m; induction m with j ihj; (have hf0 : (fun (_ : ℕ) => cpow_nat (cprod _ fq) 0) = (fun _ => complex.one) := (by funext N; rw [cpow_nat.zero_eq]); rw [hf0, cpow_nat.zero_eq]; exact ctends_to.const complex.one); (rw [succ_eq_add_one.nat]; have hm := ctends_to.mul (fun N => cpow_nat (cprod N fq) j) (fun N => cprod N fq) (cpow_nat (sernau.eta_prod tau) j) (sernau.eta_prod tau) ihj hP_lim; unfold ctends_to at hm ⊢; intro e he; obtain ⟨N0, hN0⟩ := hm e he; use N0; intro N hN; rw [cpow_nat.succ_eq, cpow_nat.succ_eq]; exact hN0 N hN)
  have hlim_24 : ctends_to (fun N => cprod N (fun k => cpow_nat (fq k) 24)) (cpow_nat (sernau.eta_prod tau) 24) := by have h24 := hlim_pow 24; unfold ctends_to at h24 ⊢; intro e he; obtain ⟨N0, hN0⟩ := h24 e he; use N0; intro N hN; rw [hcprod_pow N]; exact hN0 N hN
  have hfq_ne : ∀ k : ℕ, fq k ≠ complex.zero := by intro k; rw [← hf_eq]; exact hu_ne k
  have hlog_sum : ∀ N : ℕ, (∑ k < N, log (complex.abs (fq k))) = log (complex.abs (cprod N fq)) := by intro N; induction N with j ihj; (rw [sum_below_zero]; have h0 : cprod 0 fq = complex.one := (by rfl); rw [h0, habs1, log_one]); (rw [succ_eq_add_one.nat, sum_below_succ, ihj]; have hs1 : cprod (j + 1) fq = complex.mul (cprod j fq) (fq j) := (by rfl); have hp1 := habs_pos_of_ne (cprod j fq) (cprod.ne_zero j fq (by intro i _; exact hfq_ne i)); have hp2 := habs_pos_of_ne (fq j) (hfq_ne j); rw [hs1, complex.abs_mul, log_mul (complex.abs (cprod j fq)) (complex.abs (fq j)) hp1 hp2])
  have hlog_eta_lim : tends_to (fun N => ∑ k < N, log (complex.abs (fq k))) (log (complex.abs (sernau.eta_prod tau))) := by have hcl := has_deriv_within.continuous_at_of_pos_log (complex.abs (sernau.eta_prod tau)) (habs_pos_of_ne _ hP_ne); unfold continuous_at at hcl; unfold tends_to; intro e he; obtain ⟨d, hd, hcd⟩ := hcl e he; unfold ctends_to at hP_lim; obtain ⟨N0, hN0⟩ := hP_lim d hd; use N0; intro N hN; rw [hlog_sum N]; apply hcd; have ht1 := complex.abs_add_le (complex.sub (cprod N fq) (sernau.eta_prod tau)) (sernau.eta_prod tau); have ht2 := complex.abs_add_le (complex.sub (sernau.eta_prod tau) (cprod N fq)) (cprod N fq); have hs1 : complex.add (complex.sub (cprod N fq) (sernau.eta_prod tau)) (sernau.eta_prod tau) = cprod N fq := (by apply complex.ext <;> simp <;> ring); have hs2 : complex.add (complex.sub (sernau.eta_prod tau) (cprod N fq)) (cprod N fq) = sernau.eta_prod tau := (by apply complex.ext <;> simp <;> ring); have hn_eq : complex.sub (sernau.eta_prod tau) (cprod N fq) = complex.neg (complex.sub (cprod N fq) (sernau.eta_prod tau)) := (by apply complex.ext <;> simp <;> ring); rw [hs1] at ht1; rw [hs2, hn_eq, complex.abs_neg] at ht2; exact abs_lt_of.real _ d (by linarith [hN0 N hN]) (by linarith [hN0 N hN])
  have hlog_pow : ∀ (x : ℝ) (m : ℕ), 0 < x → log (x ^ m) = (m : ℝ) * log x := by intro x m hx; induction m with j ihj; (rw [pow_zero.real, log_one, cast_zero.real]; ring); (rw [succ_eq_add_one.nat, pow_succ.real, log_mul _ x (pow_pos.real x hx j) hx, ihj, cast_add.real, cast_one.real]; ring)
  have hlog_mdn : log (complex.abs (sernau.mod_disc_norm tau)) = -2 * pi * complex.im tau + 24 * log (complex.abs (sernau.eta_prod tau)) := by unfold sernau.mod_disc_norm; rw [← hq_def, complex.abs_mul, habs_cpow, hq_abs, log_mul _ _ (exp_pos (-c)) (pow_pos.real _ (habs_pos_of_ne _ hP_ne) 24), log_exp, hlog_pow _ 24 (habs_pos_of_ne _ hP_ne), hc_def]; simp; ring
  have hmd_abs_div : complex.abs (sernau.modular_disc tau) / ((2 * pi) ^ 12) = complex.abs (sernau.mod_disc_norm tau) := by unfold sernau.modular_disc; rw [complex.abs_mul, complex.abs_of_real, abs_of_pos.real _ h2pi12_pos, div_def.real]; have hi := mul_inv_cancel.real ((2 * pi) ^ 12) (by linarith); linear_combination (complex.abs (sernau.mod_disc_norm tau)) * hi
  have hlog_md : log (complex.abs (sernau.modular_disc tau)) = 12 * log (2 * pi) + log (complex.abs (sernau.mod_disc_norm tau)) := by unfold sernau.modular_disc; rw [complex.abs_mul, complex.abs_of_real, abs_of_pos.real _ h2pi12_pos, log_mul _ _ h2pi12_pos (habs_pos_of_ne _ hmdn_ne), hlog_pow (2 * pi) 12 (by linarith)]; simp
  have hneg_log_w : ∀ w : ℂ, complex.abs w < 1 → tends_to (fun R => ∑ r < R, complex.re (cpow_nat w (r + 1)) / ((r + 1 : ℕ) : ℝ)) (-log (complex.abs (complex.sub complex.one w)))
    intro w hw; set rw0 := complex.abs w with hrw_def; set aw := complex.re w with haw_def; set bw := complex.im w with hbw_def; have hrw_nn : 0 ≤ rw0 := by rw [hrw_def]; exact complex.abs_nonneg w
    set Q : ℝ → ℝ := fun t => (1 - t * aw) * (1 - t * aw) + (t * bw) * (t * bw) with hQ_def
    have hQ_eq : ∀ t : ℝ, Q t = complex.abs (complex.sub complex.one (complex.smul t w)) * complex.abs (complex.sub complex.one (complex.smul t w)) := by intro t; rw [complex.abs_sq, hQ_def, haw_def, hbw_def]; unfold complex.norm_sq; simp; ring
    have hz_ge : ∀ t : ℝ, 0 ≤ t → t ≤ 1 → 1 - rw0 ≤ complex.abs (complex.sub complex.one (complex.smul t w)) := by intro t ht0 ht1; have htr := complex.abs_add_le (complex.sub complex.one (complex.smul t w)) (complex.smul t w); have hs : complex.add (complex.sub complex.one (complex.smul t w)) (complex.smul t w) = complex.one := (by apply complex.ext <;> simp <;> ring); rw [hs, habs1, complex.abs_smul, abs_of_nonneg.real t ht0, ← hrw_def] at htr; linarith [mul_le_mul_of_nonneg_right.real t 1 rw0 ht1 hrw_nn]
    have hQ_pos : ∀ t : ℝ, 0 ≤ t → t ≤ 1 → 0 < Q t := by intro t ht0 ht1; rw [hQ_eq t]; have h1 := hz_ge t ht0 ht1; nlinarith
    set g_w : ℝ → ℝ := fun t => (aw - (aw * aw + bw * bw) * t) / Q t with hgw_def; set phi_w : ℝ → ℝ := fun t => -(1 / 2) * log (Q t) with hphi_def
    have hgw_cont : ∀ t, 0 ≤ t → t ≤ 1 → continuous_at g_w t := by intro t ht0 ht1; have hQi := continuous_at.inv_of_pos Q t (by rw [hQ_def]; continuity) (hQ_pos t ht0 ht1); have hf : g_w = (fun x => (aw - (aw * aw + bw * bw) * x) * (1 / Q x)) := (by funext x; rw [hgw_def, div_def.real (aw - (aw * aw + bw * bw) * x) (Q x)]); rw [hf]; continuity [hQi]
    have hphi_d : ∀ t, 0 ≤ t → t ≤ 1 → has_deriv_within phi_w (fun z => 0 ≤ z ∧ z ≤ 1) t (g_w t) := by intro t ht0 ht1; set S := (fun (z : ℝ) => 0 ≤ z ∧ z ≤ 1) with hS; have hlin := has_deriv_within.sub (fun _ => (1 : ℝ)) (fun x => aw * x) S t 0 aw (has_deriv_within.const 1 S t) (has_deriv_within.scale_id aw S t); have hsq1 := has_deriv_within.sq (fun x => 1 - aw * x) S t (0 - aw) hlin; have hsq2 := has_deriv_within.sq (fun x => bw * x) S t bw (has_deriv_within.scale_id bw S t); have hQd0 := has_deriv_within.add _ _ S t _ _ hsq1 hsq2; have hfQ : (fun x => (1 - aw * x) ^ 2 + (bw * x) ^ 2) = Q := (by funext x; rw [hQ_def]; ring); have hvQ : 2 * (1 - aw * t) * (0 - aw) + 2 * (bw * t) * bw = -2 * aw + 2 * (aw * aw + bw * bw) * t := (by ring); rw [hfQ, hvQ] at hQd0; have hld := has_deriv_within.comp log Q S (fun y => 0 < y) t (1 / Q t) (-2 * aw + 2 * (aw * aw + bw * bw) * t) (has_deriv_within.log (fun y => 0 < y) (Q t) (hQ_pos t ht0 ht1) (by intro y hy; exact hy)) hQd0 (by intro y hy; rw [hS] at hy; exact hQ_pos y hy.1 hy.2); have hsc := has_deriv_within.scale (-(1 / 2)) (fun x => log (Q x)) S t ((1 / Q t) * (-2 * aw + 2 * (aw * aw + bw * bw) * t)) hld; have hfp : (fun x => -(1 / 2) * log (Q x)) = phi_w := (by rw [hphi_def]); have hvp : -(1 / 2) * ((1 / Q t) * (-2 * aw + 2 * (aw * aw + bw * bw) * t)) = g_w t := (by rw [hgw_def, div_def.real (aw - (aw * aw + bw * bw) * t) (Q t)]; ring); rw [hfp, hvp] at hsc; exact hsc
    have hgw_int := darboux.fundamental phi_w g_w 0 1 (by decide) hgw_cont hphi_d
    have hphi_val : phi_w 1 - phi_w 0 = -log (complex.abs (complex.sub complex.one w)) := by have hQ0 : Q 0 = 1 := (by rw [hQ_def]; ring); have h1w_eq : complex.sub complex.one (complex.smul 1 w) = complex.sub complex.one w := (by apply complex.ext <;> simp); have h1w_pos : 0 < complex.abs (complex.sub complex.one w) := (by have h := hz_ge 1 (by decide) (by decide); rw [h1w_eq] at h; linarith); rw [hphi_def, hQ0, log_one, hQ_eq 1, h1w_eq, log_mul _ _ h1w_pos h1w_pos]; ring
    rw [hphi_val] at hgw_int
    have hgeom_c : ∀ (R : ℕ) (t : ℝ), complex.mul (complex.sub complex.one (complex.smul t w)) (csum R (fun r => complex.smul (t ^ r) (cpow_nat w (r + 1)))) = complex.sub w (complex.smul (t ^ R) (cpow_nat w (R + 1))) := by intro R t; induction R with j ihj; (rw [csum.zero, pow_zero.real, cpow_nat.succ_eq, cpow_nat.zero_eq, complex.mul_zero, complex.one_mul]; apply complex.ext <;> simp <;> ring); (rw [succ_eq_add_one.nat, csum.succ, complex.left_distrib, ihj, pow_succ.real t j, cpow_nat.succ_eq w (j + 1)]; apply complex.ext <;> simp <;> ring)
    have hre_csum : ∀ (R : ℕ) (t : ℝ), complex.re (csum R (fun r => complex.smul (t ^ r) (cpow_nat w (r + 1)))) = ∑ r < R, complex.re (cpow_nat w (r + 1)) * (t ^ r) := by intro R t; induction R with j ihj; (rw [csum.zero, sum_below_zero]; simp); (rw [succ_eq_add_one.nat, csum.succ, sum_below_succ, ← ihj]; simp; ring)
    have hrpow_zero : tends_to (fun R => rw0 ^ (R + 1)) 0
      by_cases hr0 : rw0 = 0; (unfold tends_to; intro eps heps; use 0; intro R _; rw [hr0, pow_succ.real, mul_zero.real]; have h0 : (0 : ℝ) - 0 = 0 := (by ring); rw [h0, abs_of_nonneg.real 0 (by decide)]; exact heps)
      have hr_pos : 0 < rw0 := by by_contra hle; exact hr0 (by linarith)
      set d_r := 1 / rw0 - 1 with hdr_def; have hdr_pos : 0 < d_r := by rw [hdr_def]; linarith [(lt_div_iff.real 1 1 rw0 hr_pos).mpr (by linarith)]
      have hbern : ∀ m : ℕ, 1 + (m : ℝ) * d_r ≤ (1 + d_r) ^ m := by intro m; induction m with j ihj; (rw [pow_zero.real, cast_zero.real]; linarith); (rw [succ_eq_add_one.nat, pow_succ.real, cast_add.real, cast_one.real]; have hm := mul_le_mul_of_nonneg_right.real (1 + (j : ℝ) * d_r) ((1 + d_r) ^ j) (1 + d_r) ihj (by linarith); linarith [mul_nonneg.real ((j : ℝ) * d_r) d_r (mul_nonneg.real (j : ℝ) d_r (cast_nonneg.real j) (by linarith)) (by linarith)])
      unfold tends_to; intro eps heps; obtain ⟨R0, hR0⟩ := exists_nat_gt.real ((1 / eps) / d_r); use R0; intro R hR
      have hprod1 : rw0 ^ (R + 1) * ((1 + d_r) ^ (R + 1)) = 1 := by have h1d : 1 + d_r = 1 / rw0 := (by rw [hdr_def]; ring); rw [h1d]; have hp_m : ∀ m : ℕ, rw0 ^ m * ((1 / rw0) ^ m) = 1 := (by intro m; induction m with j ihj; (rw [pow_zero.real, pow_zero.real]; ring); (rw [succ_eq_add_one.nat, pow_succ.real, pow_succ.real]; have hi := mul_inv_cancel.real rw0 (by linarith); linear_combination (rw0 * (1 / rw0)) * ihj + hi)); exact hp_m (R + 1)
      have hgt : 1 / eps < ((R + 1 : ℕ) : ℝ) * d_r := by have h1 : (R0 : ℝ) < ((R + 1 : ℕ) : ℝ) := (cast_lt.real R0 (R + 1)).mpr (by omega); have h2 := (div_lt_iff.real (1 / eps) (R0 : ℝ) d_r hdr_pos).mp hR0; nlinarith
      have hrp_pos : 0 < rw0 ^ (R + 1) := pow_pos.real rw0 hr_pos (R + 1)
      have hm := mul_lt_mul_of_pos_left.real (1 / eps) ((1 + d_r) ^ (R + 1)) (rw0 ^ (R + 1)) (by linarith [hbern (R + 1)]) hrp_pos
      rw [hprod1] at hm; have hi := mul_inv_cancel.real eps (by linarith); have hm2 := mul_lt_mul_of_pos_right.real (rw0 ^ (R + 1) * (1 / eps)) 1 eps hm heps; have hs0 : rw0 ^ (R + 1) - 0 = rw0 ^ (R + 1) := (by ring); have hlhs : rw0 ^ (R + 1) * (1 / eps) * eps = rw0 ^ (R + 1) := (by linear_combination (rw0 ^ (R + 1)) * hi); rw [hs0, abs_of_pos.real _ hrp_pos]; linarith [hm2, hlhs]
    unfold tends_to; intro e he; have h1mr_pos : 0 < 1 - rw0 := by linarith
    unfold tends_to at hrpow_zero; obtain ⟨R0, hR0⟩ := hrpow_zero (e * (1 - rw0)) (mul_pos.real e (1 - rw0) he h1mr_pos); use R0; intro R hR
    have hpoly := darboux.polynomial 0 1 (fun r => complex.re (cpow_nat w (r + 1))) R (by decide)
    have hval_p : (∑ r < R, complex.re (cpow_nat w (r + 1)) * ((1 ^ (r + 1) - 0 ^ (r + 1)) / ((r : ℝ) + 1))) = ∑ r < R, complex.re (cpow_nat w (r + 1)) / ((r + 1 : ℕ) : ℝ) := by apply sum_congr.real; intro r _; have h1p : ∀ m : ℕ, (1 : ℝ) ^ m = 1 := (by intro m; induction m with l ihl; rw [pow_zero.real]; (rw [succ_eq_add_one.nat, pow_succ.real, ihl]; ring)); rw [h1p (r + 1), pow_succ.real 0 r, mul_zero.real, cast_add.real r 1, cast_one.real, div_def.real (1 - 0) ((r : ℝ) + 1), div_def.real (complex.re (cpow_nat w (r + 1))) ((r : ℝ) + 1)]; ring
    rw [hval_p] at hpoly; have hdiff_int := darboux.sub _ g_w 0 1 _ _ hpoly hgw_int
    have hpt_bd : ∀ t, 0 ≤ t → t ≤ 1 → |(∑ r < R, complex.re (cpow_nat w (r + 1)) * (t ^ r)) - g_w t| ≤ (rw0 ^ (R + 1)) / (1 - rw0)
      intro t ht0 ht1; set zt := complex.sub complex.one (complex.smul t w) with hzt_def
      have hmul_c : complex.re (complex.mul (complex.mul zt (csum R (fun r => complex.smul (t ^ r) (cpow_nat w (r + 1))))) (complex.conj zt)) = complex.re (complex.mul (complex.sub w (complex.smul (t ^ R) (cpow_nat w (R + 1)))) (complex.conj zt)) := by have hg_zt := hgeom_c R t; rw [← hzt_def] at hg_zt; rw [hg_zt]
      have hl_c : complex.re (complex.mul (complex.mul zt (csum R (fun r => complex.smul (t ^ r) (cpow_nat w (r + 1))))) (complex.conj zt)) = Q t * (∑ r < R, complex.re (cpow_nat w (r + 1)) * (t ^ r)) := by have h1 : complex.mul (complex.mul zt (csum R (fun r => complex.smul (t ^ r) (cpow_nat w (r + 1))))) (complex.conj zt) = complex.mul (complex.mul zt (complex.conj zt)) (csum R (fun r => complex.smul (t ^ r) (cpow_nat w (r + 1)))) := (by apply complex.ext <;> simp <;> ring); have h2 : complex.mul zt (complex.conj zt) = complex.of_real (Q t) := (by rw [hQ_def, hzt_def, haw_def, hbw_def]; unfold complex.conj complex.of_real; apply complex.ext <;> simp <;> ring); rw [h1, h2, complex.mul_re, complex.of_real_re, complex.of_real_im, hre_csum R t]; ring
      have hr_c : complex.re (complex.mul (complex.sub w (complex.smul (t ^ R) (cpow_nat w (R + 1)))) (complex.conj zt)) = (aw - (aw * aw + bw * bw) * t) - (t ^ R) * complex.re (complex.mul (cpow_nat w (R + 1)) (complex.conj zt)) := by rw [hzt_def, haw_def, hbw_def]; unfold complex.conj; simp; ring
      rw [hl_c, hr_c] at hmul_c; have hQp := hQ_pos t ht0 ht1; have hiQ := mul_inv_cancel.real (Q t) (by linarith)
      have hrem_eq : (∑ r < R, complex.re (cpow_nat w (r + 1)) * (t ^ r)) - g_w t = -((t ^ R) * complex.re (complex.mul (cpow_nat w (R + 1)) (complex.conj zt))) * (1 / Q t) := by rw [hgw_def, div_def.real (aw - (aw * aw + bw * bw) * t) (Q t)]; linear_combination (1 / Q t) * hmul_c - (∑ r < R, complex.re (cpow_nat w (r + 1)) * (t ^ r)) * hiQ
      have ht_le1 : ∀ m : ℕ, t ^ m ≤ 1 := by intro m; induction m with l ihl; (rw [pow_zero.real]; linarith); (rw [succ_eq_add_one.nat, pow_succ.real]; linarith [mul_le_mul_of_nonneg_right.real (t ^ l) 1 t ihl ht0])
      have htR_le1 : t ^ R ≤ 1 := ht_le1 R
      have htR_nn : 0 ≤ t ^ R := pow_nonneg.real t ht0 R
      have habs_conj : complex.abs (complex.conj zt) = complex.abs zt := by apply eq_of_sq_eq_nonneg (complex.abs (complex.conj zt)) (complex.abs zt) (complex.abs_nonneg (complex.conj zt)) (complex.abs_nonneg zt); rw [complex.abs_sq, complex.abs_sq]; unfold complex.conj complex.norm_sq; simp; ring
      have hre_le : |complex.re (complex.mul (cpow_nat w (R + 1)) (complex.conj zt))| ≤ (rw0 ^ (R + 1)) * complex.abs zt := by have h1 := complex.re_abs_le (complex.mul (cpow_nat w (R + 1)) (complex.conj zt)); rw [complex.abs_mul, habs_cpow, ← hrw_def, habs_conj] at h1; exact h1
      have hzt_ge : 1 - rw0 ≤ complex.abs zt := by rw [hzt_def]; exact hz_ge t ht0 ht1
      have hzt_pos : 0 < complex.abs zt := by linarith
      have hQ_zt : Q t = complex.abs zt * complex.abs zt := by rw [hzt_def]; exact hQ_eq t
      have hiz := mul_inv_cancel.real (complex.abs zt) (by linarith)
      have hsimp_z : ((rw0 ^ (R + 1)) * complex.abs zt) * (1 / Q t) = (rw0 ^ (R + 1)) * (1 / complex.abs zt) := by rw [hQ_zt]; field_simp
      have hinv_z_le : 1 / complex.abs zt ≤ 1 / (1 - rw0) := (div_le_iff.real 1 (1 / (1 - rw0)) (complex.abs zt) hzt_pos).mpr (by have hm := mul_le_mul_of_nonneg_right.real (1 - rw0) (complex.abs zt) (1 / (1 - rw0)) hzt_ge (by linarith [one_div_pos.real (1 - rw0) h1mr_pos]); linarith [mul_inv_cancel.real (1 - rw0) (by linarith)])
      have hm1 := mul_le_mul_of_nonneg_left.real (|complex.re (complex.mul (cpow_nat w (R + 1)) (complex.conj zt))|) ((rw0 ^ (R + 1)) * complex.abs zt) (t ^ R) hre_le htR_nn
      have hm2 := mul_le_mul_of_nonneg_right.real (t ^ R) 1 ((rw0 ^ (R + 1)) * complex.abs zt) htR_le1 (mul_nonneg.real (rw0 ^ (R + 1)) (complex.abs zt) (pow_nonneg.real rw0 hrw_nn (R + 1)) (complex.abs_nonneg zt))
      have hm3 := mul_le_mul_of_nonneg_right.real ((t ^ R) * |complex.re (complex.mul (cpow_nat w (R + 1)) (complex.conj zt))|) ((rw0 ^ (R + 1)) * complex.abs zt) (1 / Q t) (by linarith) (by linarith [one_div_pos.real (Q t) hQp])
      have hm4 := mul_le_mul_of_nonneg_left.real (1 / complex.abs zt) (1 / (1 - rw0)) (rw0 ^ (R + 1)) hinv_z_le (pow_nonneg.real rw0 hrw_nn (R + 1))
      have ha_eq : |-(t ^ R * complex.re (complex.mul (cpow_nat w (R + 1)) (complex.conj zt))) * (1 / Q t)| = (t ^ R * |complex.re (complex.mul (cpow_nat w (R + 1)) (complex.conj zt))|) * (1 / Q t) := by rw [abs_mul.real, abs_neg_eq, abs_mul.real, abs_of_nonneg.real (t ^ R) htR_nn, abs_of_pos.real (1 / Q t) (one_div_pos.real (Q t) hQp)]
      rw [hrem_eq, ha_eq, div_def.real (rw0 ^ (R + 1)) (1 - rw0)]; linarith
    have hint_bd := darboux.abs_le_const _ 0 1 _ ((rw0 ^ (R + 1)) / (1 - rw0)) hdiff_int hpt_bd
    have hR_lt := hR0 R hR; have hs0 : rw0 ^ (R + 1) - 0 = rw0 ^ (R + 1) := by ring
    rw [hs0, abs_of_nonneg.real _ (pow_nonneg.real rw0 hrw_nn (R + 1))] at hR_lt; linarith [(div_lt_iff.real (rw0 ^ (R + 1)) e (1 - rw0) h1mr_pos).mpr hR_lt]
  rw [hfq_def] at hlim_24 hlog_eta_lim
  rw [hc_def] at hq_abs; have hc_neg : -(2 * pi * complex.im tau) = -2 * pi * complex.im tau := by ring
  rw [hc_neg] at hq_abs
  exact ⟨hq_abs, hq_lt1, hP_ne, hmdn_ne, hmd_ne, hP_lim, hlim_24, hlog_eta_lim, hlog_mdn, hmd_abs_div, hlog_md, hneg_log_w⟩

+ sernau.fourier_c1_at_zero (F Fp : ℝ → ℝ) (c : ℕ → ℝ) (L : ℝ)
    (hL : 0 ≤ L) (hcont_F : ∀ t, 0 ≤ t → t ≤ 1 / 2 → continuous_at F t)
    (hderiv : ∀ t, 0 ≤ t → t ≤ 1 / 2 → has_deriv_within F (fun z => 0 ≤ z ∧ z ≤ 1 / 2) t (Fp t))
    (hcont_Fp : ∀ t, 0 ≤ t → t ≤ 1 / 2 → continuous_at Fp t) (hbd_Fp : ∀ t, 0 ≤ t → t ≤ 1 / 2 → |Fp t| ≤ L)
    (hc : ∀ k : ℕ, darboux.has_integral (fun x => F x * cos (2 * pi * (k : ℝ) * x)) 0 (1 / 2) (c k)) :
    tends_to (fun (N : ℕ) => 2 * c 0 + 4 * (∑ k < N, c (k + 1))) (F 0)
  have hpi_pos : 0 < pi := by linarith [pi_bounds.1]
  have hlip : ∀ x, 0 ≤ x → x ≤ 1 / 2 → |F x - F 0| ≤ L * x := by intro x hx0 hx1; have hd_sub : ∀ t, 0 ≤ t → t ≤ x → has_deriv_within F (fun z => 0 ≤ z ∧ z ≤ x) t (Fp t) := (by intro t ht0 _; exact has_deriv_within.restrict F (fun z => 0 ≤ z ∧ z ≤ 1 / 2) (fun z => 0 ≤ z ∧ z ≤ x) t (Fp t) (hderiv t ht0 (by linarith)) (by intro z hz; exact ⟨hz.1, by linarith [hz.2]⟩)); exact abs_le_of.real (F x - F 0) (L * x) (by linarith [interval.increment_ge_of_deriv_ge F Fp 0 x (-L) hx0 hd_sub (by intro t ht0 _; linarith [neg_le_abs.real (Fp t), hbd_Fp t ht0 (by linarith)])]) (by linarith [interval.increment_le_of_deriv_le F Fp 0 x L hx0 hd_sub (by intro t ht0 _; linarith [le_abs_self.real (Fp t), hbd_Fp t ht0 (by linarith)])])
  have hS_int : ∀ N : ℕ, darboux.has_integral (fun x => (F x - F 0) * dirichlet_kernel N x) 0 (1 / 2) ((2 * c 0 + 4 * (∑ k < N, c (k + 1)) - F 0) / 2)
    intro N; have hsum_int : ∀ M : ℕ, darboux.has_integral (fun x => F x * (∑ k < M, cos (2 * pi * ((k + 1 : ℕ) : ℝ) * x))) 0 (1 / 2) (∑ k < M, c (k + 1)) := by intro M; induction M with j ihj; (have hf : (fun x => F x * (∑ k < 0, cos (2 * pi * ((k + 1 : ℕ) : ℝ) * x))) = (fun _ => (0 : ℝ)) := (by funext x; rw [sum_below_zero]; ring); have h0 := darboux.const 0 (1 / 2) 0 (by decide); have hv : (0 : ℝ) * (1 / 2 - 0) = 0 := (by ring); rw [hv] at h0; rw [hf, sum_below_zero]; exact h0); (rw [succ_eq_add_one.nat, sum_below_succ]; have hadd := darboux.add _ _ 0 (1 / 2) _ _ ihj (hc (j + 1)); have hf : (fun x => F x * (∑ k < j, cos (2 * pi * ((k + 1 : ℕ) : ℝ) * x)) + F x * cos (2 * pi * ((j + 1 : ℕ) : ℝ) * x)) = (fun x => F x * (∑ k < j + 1, cos (2 * pi * ((k + 1 : ℕ) : ℝ) * x))) := (by funext x; rw [sum_below_succ]; ring); rw [hf] at hadd; exact hadd)
    have hc0 : darboux.has_integral F 0 (1 / 2) (c 0) := by have h := hc 0; have hf : (fun x => F x * cos (2 * pi * ((0 : ℕ) : ℝ) * x)) = F := (by funext x; simp [cos_zero]); rw [hf] at h; exact h
    have hFD := darboux.add F _ 0 (1 / 2) (c 0) _ hc0 (darboux.scale _ 0 (1 / 2) _ 2 (hsum_int N))
    have hFD_eq : darboux.has_integral (fun x => F x * dirichlet_kernel N x) 0 (1 / 2) (c 0 + 2 * (∑ k < N, c (k + 1))) := by have hf : (fun x => F x + 2 * (F x * (∑ k < N, cos (2 * pi * ((k + 1 : ℕ) : ℝ) * x)))) = (fun x => F x * dirichlet_kernel N x) := (by funext x; unfold dirichlet_kernel; ring); rw [hf] at hFD; exact hFD
    have hdiff := darboux.sub _ _ 0 (1 / 2) _ _ hFD_eq (darboux.scale (dirichlet_kernel N) 0 (1 / 2) (1 / 2) (F 0) (dirichlet_kernel.integral_half N))
    have hf : (fun x => F x * dirichlet_kernel N x - F 0 * dirichlet_kernel N x) = (fun x => (F x - F 0) * dirichlet_kernel N x) := by funext x; ring
    have hv : (c 0 + 2 * (∑ k < N, c (k + 1))) - F 0 * (1 / 2) = (2 * c 0 + 4 * (∑ k < N, c (k + 1)) - F 0) / 2 := by ring
    rw [hf, hv] at hdiff; exact hdiff
  have hcont_D : ∀ N : ℕ, ∀ t : ℝ, continuous_at (dirichlet_kernel N) t := by intro N t; unfold dirichlet_kernel; have hsc : ∀ M : ℕ, continuous_at (fun x => ∑ k < M, cos (2 * pi * ((k + 1 : ℕ) : ℝ) * x)) t := (by intro M; induction M with j ihj; (have hf : (fun (_ : ℝ) => ∑ k < 0, cos (2 * pi * ((k + 1 : ℕ) : ℝ) * _)) = (fun _ => (0 : ℝ)) := (by funext x; rw [sum_below_zero]); rw [hf]; continuity); (rw [succ_eq_add_one.nat]; have hf : (fun x => ∑ k < j + 1, cos (2 * pi * ((k + 1 : ℕ) : ℝ) * x)) = (fun x => (∑ k < j, cos (2 * pi * ((k + 1 : ℕ) : ℝ) * x)) + cos (2 * pi * ((j + 1 : ℕ) : ℝ) * x)) := (by funext x; rw [sum_below_succ]); rw [hf]; continuity [ihj])); have hsN := hsc N; continuity [hsN]
  unfold tends_to; intro e he; set delta := min (1 / 4) (e / (8 * (L + 1))) with hdelta
  have hd_pos : 0 < delta := by rw [hdelta]; exact lt_min.real (1 / 4) (e / (8 * (L + 1))) 0 (by decide) (div_pos.real e (8 * (L + 1)) he (by linarith))
  have hd_le4 : delta ≤ 1 / 4 := by rw [hdelta]; exact min_le_left.real _ _
  have h2Ld_lt : 2 * (L * delta) < e / 2 := by have h1 := (le_div_iff.real delta e (8 * (L + 1)) (by linarith)).mp (by rw [hdelta]; exact min_le_right.real _ _); nlinarith
  set g := (fun x => (F x - F 0) / sin (pi * x)) with hg
  set gp := (fun x => (Fp x * sin (pi * x) - (F x - F 0) * (pi * cos (pi * x))) / (sin (pi * x) * sin (pi * x))) with hgp
  set B_g := L / delta with hBg; set M_g := (L + pi * L) / (delta * delta) with hMg
  have hBg_nn : 0 ≤ B_g := by rw [hBg]; exact div_nonneg.real L delta hL (by linarith)
  have hMg_nn : 0 ≤ M_g := by rw [hMg]; exact div_nonneg.real (L + pi * L) (delta * delta) (by nlinarith) (by nlinarith)
  have hsin_ge : ∀ x, delta ≤ x → x ≤ 1 / 2 → delta ≤ sin (pi * x) := by intro x hx1 hx2; linarith [sin_pi_ge_self x (by linarith) hx2]
  have hsin_pos : ∀ x, delta ≤ x → x ≤ 1 / 2 → 0 < sin (pi * x) := by intro x hx1 hx2; linarith [hsin_ge x hx1 hx2]
  have hg_bd : ∀ x, delta ≤ x → x ≤ 1 / 2 → |g x| ≤ B_g := by intro x hx1 hx2; have hsp := hsin_pos x hx1 hx2; have h1s_pos := one_div_pos.real (sin (pi * x)) hsp; have hF_le : |F x - F 0| ≤ L := (by have hl := hlip x (by linarith) hx2; nlinarith); have hinv_le : 1 / sin (pi * x) ≤ 1 / delta := (div_le_iff.real 1 (1 / delta) (sin (pi * x)) hsp).mpr (by have hm := mul_le_mul_of_nonneg_right.real delta (sin (pi * x)) (1 / delta) (hsin_ge x hx1 hx2) (by linarith [one_div_pos.real delta hd_pos]); linarith [mul_inv_cancel.real delta (by linarith)]); have hm1 := mul_le_mul_of_nonneg_right.real (|F x - F 0|) L (1 / sin (pi * x)) hF_le (by linarith); have hm2 := mul_le_mul_of_nonneg_left.real (1 / sin (pi * x)) (1 / delta) L hinv_le hL; have ha_eq : |g x| = |F x - F 0| * (1 / sin (pi * x)) := (by rw [hg, div_def.real (F x - F 0) (sin (pi * x)), abs_mul.real, abs_of_pos.real (1 / sin (pi * x)) h1s_pos]); rw [ha_eq, hBg, div_def.real L delta]; linarith
  have hgp_bd : ∀ x, delta ≤ x → x ≤ 1 / 2 → |gp x| ≤ M_g
    intro x hx1 hx2; have hs2_pos : 0 < sin (pi * x) * sin (pi * x) := by nlinarith [hsin_pos x hx1 hx2]
    have h1s2_pos := one_div_pos.real (sin (pi * x) * sin (pi * x)) hs2_pos
    have htri := abs_add_le (Fp x * sin (pi * x)) (-((F x - F 0) * (pi * cos (pi * x))))
    have hsub : Fp x * sin (pi * x) + -((F x - F 0) * (pi * cos (pi * x))) = Fp x * sin (pi * x) - (F x - F 0) * (pi * cos (pi * x)) := by ring
    rw [hsub, abs_neg_eq, abs_mul.real, abs_mul.real, abs_mul.real, abs_of_pos.real pi hpi_pos] at htri
    have h1 : |Fp x| * |sin (pi * x)| ≤ L := by have m1 := mul_le_mul_of_nonneg_right.real (|Fp x|) L (|sin (pi * x)|) (hbd_Fp x (by linarith) hx2) (abs_nonneg.real _); linarith [mul_le_mul_of_nonneg_left.real (|sin (pi * x)|) 1 L (sin_abs_le_one (pi * x)) hL]
    have hF_le : |F x - F 0| ≤ L := by have hl := hlip x (by linarith) hx2; nlinarith
    have hpc : pi * |cos (pi * x)| ≤ pi := by linarith [mul_le_mul_of_nonneg_left.real (|cos (pi * x)|) 1 pi (cos_abs_le_one (pi * x)) (by linarith)]
    have h2 : |F x - F 0| * (pi * |cos (pi * x)|) ≤ pi * L := by have m1 := mul_le_mul_of_nonneg_right.real (|F x - F 0|) L (pi * |cos (pi * x)|) hF_le (by nlinarith [abs_nonneg.real (cos (pi * x))]); linarith [mul_le_mul_of_nonneg_left.real (pi * |cos (pi * x)|) pi L hpc hL]
    have hinv_le : 1 / (sin (pi * x) * sin (pi * x)) ≤ 1 / (delta * delta) := (div_le_iff.real 1 (1 / (delta * delta)) (sin (pi * x) * sin (pi * x)) hs2_pos).mpr (by have hs2_ge : delta * delta ≤ sin (pi * x) * sin (pi * x) := (by nlinarith [hsin_ge x hx1 hx2]); have hm := mul_le_mul_of_nonneg_right.real (delta * delta) (sin (pi * x) * sin (pi * x)) (1 / (delta * delta)) hs2_ge (by linarith [one_div_pos.real (delta * delta) (by nlinarith)]); linarith [mul_inv_cancel.real (delta * delta) (by nlinarith)])
    have hm1 := mul_le_mul_of_nonneg_right.real (|Fp x * sin (pi * x) - (F x - F 0) * (pi * cos (pi * x))|) (L + pi * L) (1 / (sin (pi * x) * sin (pi * x))) (by linarith) (by linarith)
    have hm2 := mul_le_mul_of_nonneg_left.real (1 / (sin (pi * x) * sin (pi * x))) (1 / (delta * delta)) (L + pi * L) hinv_le (by nlinarith)
    have ha_eq : |gp x| = |Fp x * sin (pi * x) - (F x - F 0) * (pi * cos (pi * x))| * (1 / (sin (pi * x) * sin (pi * x))) := by rw [hgp, div_def.real _ (sin (pi * x) * sin (pi * x)), abs_mul.real, abs_of_pos.real (1 / (sin (pi * x) * sin (pi * x))) h1s2_pos]
    rw [ha_eq, hMg, div_def.real (L + pi * L) (delta * delta)]; linarith
