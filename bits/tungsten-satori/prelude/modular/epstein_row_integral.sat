    have hrpow_eq : rpow (cos th) (2 * h) = exp (-2 * h * a) := by unfold rpow; rw [ha_def]; have h1 : 2 * h * log (cos th) = -2 * h * -log (cos th) := (by ring); rw [h1]; rfl
    rw [hrpow_eq]
