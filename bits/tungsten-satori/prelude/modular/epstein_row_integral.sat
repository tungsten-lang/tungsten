      have h2 : -(2 * a) / (1 + 2 * h * a) + 2 * a = (4 * h * (a * a)) / (1 + 2 * h * a) := by field_simp
      have hnn_4 : 0 ≤ 4 * h * (a * a) := by have ha2 : 0 ≤ a * a := (by nlinarith); nlinarith
      have h3 : (4 * h * (a * a)) / (1 + 2 * h * a) ≤ 4 * h * (a * a) := (div_le_iff.real _ _ _ hden_pos).mpr (by nlinarith)
      linarith
    rw [ha_def] at hq1 hq2 hq3 ⊢
    have hr : 4 * h * (-log (cos th) * -log (cos th)) = 4 * h * (log (cos th) * log (cos th)) := by ring
    exact ⟨by linarith, by linarith, by linarith⟩
  -- Pass K -> infty in 2 * int_0^{pi/2 - 1/(K+2)} [ (cos^(2h) - 1)/h - 2 log cos ] dth!
  have hlim_q : tends_to (fun K => 2 * rint (fun th => (rpow (cos th) (2 * h) - 1) / h - 2 * log (cos th)) 0 (pi / 2 - 1 / ((K + 2 : ℕ) : ℝ))) ((sernau.row_int_val (1 + h) - pi) / h - (-2 * pi * log 2))
    have hl1 := hrow_lim (1 + h) (by linarith)
    unfold tends_to at hl1 hlim_lc ⊢; intro e2 he2
    obtain ⟨K1, hK1⟩ := hl1 (e2 * h / 4) (by nlinarith)
    obtain ⟨K2, hK2⟩ := hlim_lc (e2 / 16) (by linarith)
    obtain ⟨K3, hK3⟩ := exists_nat_gt.real (8 / (e2 * h))
    use K1 + K2 + K3; intro K hK
    have hk_pos : 0 < ((K + 2 : ℕ) : ℝ) := (cast_pos.real (K + 2)).mpr (by omega)
    have hk_le : 1 / ((K + 2 : ℕ) : ℝ) ≤ 1 / 2 := sernau.one_div_le_one_div_pos 2 ((K + 2 : ℕ) : ℝ) (by decide) hk_pos ((cast_le.real 2 (K + 2)).mpr (by omega))
    set dK := 1 / ((K + 2 : ℕ) : ℝ) with hdK
    have hc_r : ∀ t, 0 ≤ t → t ≤ pi / 2 - dK → continuous_at (fun th => rpow (cos th) (2 * h)) t
      intro t ht1 ht2; have hct := (sernau.sin_cos_quarter_bounds t ht1 (by linarith [one_div_pos.real _ hk_pos])).2.2.2.1 (by linarith [one_div_pos.real _ hk_pos]); have hl := continuous_at.comp log cos t (sernau.log_cont_and_deriv (cos t) hct).1 (continuous_at.cos t); unfold rpow; continuity
    obtain ⟨Ia, hIa⟩ := darboux.continuous (fun th => rpow (cos th) (2 * h)) 0 (pi / 2 - dK) (by linarith) hc_r
    obtain ⟨Ib, hIb⟩ := darboux.continuous (fun th => log (cos th)) 0 (pi / 2 - dK) (by linarith) (by intro t ht1 ht2; exact continuous_at.comp log cos t (sernau.log_cont_and_deriv (cos t) ((sernau.sin_cos_quarter_bounds t ht1 (by linarith [one_div_pos.real _ hk_pos])).2.2.2.1 (by linarith [one_div_pos.real _ hk_pos]))).1 (continuous_at.cos t))
    have hIc := darboux.const 0 (pi / 2 - dK) 1 (by linarith)
    have hsub1 := darboux.sub _ _ 0 (pi / 2 - dK) Ia (1 * (pi / 2 - dK - 0)) hIa hIc
    have hsc1 := darboux.scale _ 0 (pi / 2 - dK) _ (1 / h) hsub1
    have hsc2 := darboux.scale _ 0 (pi / 2 - dK) Ib 2 hIb
    have hcomb := darboux.sub _ _ 0 (pi / 2 - dK) _ _ hsc1 hsc2
    have hcg := darboux.congr _ (fun th => (rpow (cos th) (2 * h) - 1) / h - 2 * log (cos th)) 0 (pi / 2 - dK) _ hcomb (by intro th _ _; rw [div_def.real (rpow (cos th) (2 * h) - 1) h]; ring)
    rw [rint.eq_of_has_integral _ _ _ _ hcg]
    have hIa_eq : Ia = rint (fun th => rpow (cos th) (2 * (1 + h - 1))) 0 (pi / 2 - dK)
      have hfn : (fun th => rpow (cos th) (2 * (1 + h - 1))) = (fun th => rpow (cos th) (2 * h)) := by funext th; have heq : 2 * (1 + h - 1) = 2 * h := (by ring); rw [heq]
      rw [hfn, rint.eq_of_has_integral _ _ _ Ia hIa]
    have hIb_eq : Ib = rint (fun th => log (cos th)) 0 (pi / 2 - dK) := (rint.eq_of_has_integral _ _ _ Ib hIb).symm
    have ha1 := hK1 K (by omega); rw [← hdK, ← hIa_eq] at ha1
    have ha2 := hK2 K (by omega); rw [← hdK, ← hIb_eq] at ha2
    have hdK_lt : 2 * dK / h < e2 / 4
      have hgt : 8 / (e2 * h) < ((K + 2 : ℕ) : ℝ) := by have hc := (cast_lt.real K3 (K + 2)).mpr (by omega); linarith
      have hm := (div_lt_iff.real 8 ((K + 2 : ℕ) : ℝ) (e2 * h) (by nlinarith)).mp hgt
      have h1 : 2 / ((K + 2 : ℕ) : ℝ) < e2 * h / 4 := (div_lt_iff.real 2 (e2 * h / 4) ((K + 2 : ℕ) : ℝ) hk_pos).mpr (by linarith)
      have h2 := (div_lt_iff.real (2 / ((K + 2 : ℕ) : ℝ)) (e2 / 4) h hh0).mpr (by linarith)
      rw [hdK]; have hq : 2 * (1 / ((K + 2 : ℕ) : ℝ)) / h = 2 / ((K + 2 : ℕ) : ℝ) / h := (by field_simp); linarith
    have halg : 2 * (1 / h * (Ia - 1 * (pi / 2 - dK - 0)) - 2 * Ib) - ((sernau.row_int_val (1 + h) - pi) / h - (-2 * pi * log 2)) =
        (2 * Ia - sernau.row_int_val (1 + h)) / h + 2 * dK / h - 4 * (Ib - -(pi / 2) * log 2) := by field_simp
    have hd1 : |(2 * Ia - sernau.row_int_val (1 + h)) / h| < e2 / 4
      rw [div_def.real (2 * Ia - sernau.row_int_val (1 + h)) h, abs_mul.real, abs_of_pos.real (1 / h) (one_div_pos.real h hh0), ← div_def.real (|2 * Ia - sernau.row_int_val (1 + h)|) h]
      exact (div_lt_iff.real (|2 * Ia - sernau.row_int_val (1 + h)|) (e2 / 4) h hh0).mpr (by linarith)
    have ht1 := abs_add_le ((2 * Ia - sernau.row_int_val (1 + h)) / h + 2 * dK / h) (-(4 * (Ib - -(pi / 2) * log 2)))
    have ht2 := abs_add_le ((2 * Ia - sernau.row_int_val (1 + h)) / h) (2 * dK / h)
    have hneg_4 : |-(4 * (Ib - -(pi / 2) * log 2))| = 4 * |Ib - -(pi / 2) * log 2| := by rw [abs_neg_eq, abs_mul.real, abs_of_pos.real 4 (by decide)]
    have hpos_2 : |2 * dK / h| = 2 * dK / h := abs_of_pos.real (2 * dK / h) (div_pos.real (2 * dK) h (by linarith [one_div_pos.real ((K + 2 : ℕ) : ℝ) hk_pos]) hh0)
    have hB_lt : |((2 * Ia - sernau.row_int_val (1 + h)) / h + 2 * dK / h) + -(4 * (Ib - -(pi / 2) * log 2))| < e2 := by linarith
    exact abs_lt_of.real _ e2 (by linarith [neg_le_abs.real (((2 * Ia - sernau.row_int_val (1 + h)) / h + 2 * dK / h) + -(4 * (Ib - -(pi / 2) * log 2)))]) (by linarith [le_abs_self.real (((2 * Ia - sernau.row_int_val (1 + h)) / h + 2 * dK / h) + -(4 * (Ib - -(pi / 2) * log 2)))])
  -- Bound the sequence for every K with 1 / (K + 2) <= d0 by [0, e / 2]!
  have hseq_bd : ∀ K : ℕ, 1 / ((K + 2 : ℕ) : ℝ) ≤ d0 →
      0 ≤ 2 * rint (fun th => (rpow (cos th) (2 * h) - 1) / h - 2 * log (cos th)) 0 (pi / 2 - 1 / ((K + 2 : ℕ) : ℝ)) ∧
      2 * rint (fun th => (rpow (cos th) (2 * h) - 1) / h - 2 * log (cos th)) 0 (pi / 2 - 1 / ((K + 2 : ℕ) : ℝ)) ≤ e / 2
    intro K hKd0
    set dK := 1 / ((K + 2 : ℕ) : ℝ) with hdK
    have hk_pos : 0 < ((K + 2 : ℕ) : ℝ) := (cast_pos.real (K + 2)).mpr (by omega)
    have hdK_pos : 0 < dK := by rw [hdK]; exact one_div_pos.real _ hk_pos
    set g := fun th => (rpow (cos th) (2 * h) - 1) / h - 2 * log (cos th) with hg_def
    have hcg : ∀ t, 0 ≤ t → t ≤ pi / 2 - dK → continuous_at g t
      intro t ht1 ht2; have hct := (sernau.sin_cos_quarter_bounds t ht1 (by linarith)).2.2.2.1 (by linarith)
      have hl := continuous_at.comp log cos t (sernau.log_cont_and_deriv (cos t) hct).1 (continuous_at.cos t)
      rw [hg_def]; unfold rpow; continuity
    obtain ⟨I1, hI1⟩ := darboux.continuous g 0 (pi / 2 - d0) (by linarith) (by intro t h1 h2; exact hcg t h1 (by linarith))
    obtain ⟨I2, hI2⟩ := darboux.continuous g (pi / 2 - d0) (pi / 2 - dK) (by linarith) (by intro t h1 h2; exact hcg t (by linarith) h2)
    have hI12 := darboux.adjacent g 0 (pi / 2 - d0) (pi / 2 - dK) I1 I2 hI1 hI2
    rw [rint.eq_of_has_integral g 0 (pi / 2 - dK) (I1 + I2) hI12]
    have hI1_nn := darboux.nonneg g 0 (pi / 2 - d0) I1 hI1 (by intro th h1 h2; rw [hg_def]; exact (hpt_sw th h1 (by linarith)).1)
    have hI2_nn := darboux.nonneg g (pi / 2 - d0) (pi / 2 - dK) I2 hI2 (by intro th h1 h2; rw [hg_def]; exact (hpt_sw th (by linarith) (by linarith)).1)
    -- On [0, pi/2 - d0]: cos th >= cos(pi/2 - d0) so |log cos th| <= M_d, giving I1 <= 4 * h * M_d^2 * (pi / 2)!
    have hI1_le : I1 ≤ 4 * h * (M_d * M_d) * (pi / 2)
      have hg_bd1 : ∀ th, 0 ≤ th → th ≤ pi / 2 - d0 → g th ≤ 4 * h * (M_d * M_d)
        intro th h1 h2
        have hcos_dec : cos (pi / 2 - d0) ≤ cos th
          have hinc := interval.increment_ge_of_deriv_ge (fun x => -cos x) sin th (pi / 2 - d0) 0 h2 (by intro t ht1 ht2; have hc := has_deriv_within.neg cos (fun z => th ≤ z ∧ z ≤ pi / 2 - d0) t (-sin t) (has_deriv_within.cos (fun z => th ≤ z ∧ z ≤ pi / 2 - d0) t); have hnn : -(-sin t) = sin t := (by ring); rw [hnn] at hc; exact hc) (by intro t ht1 ht2; linarith [(sernau.sin_cos_quarter_bounds t (by linarith) (by linarith)).1])
          linarith
        have hct : 0 < cos th := by linarith
        have hl_ge : log (cos (pi / 2 - d0)) ≤ log (cos th) := (log_le_log (cos (pi / 2 - d0)) (cos th) hcd0_pos hct).mpr hcos_dec
        have hl_le0 : log (cos th) ≤ 0 := by have h := (log_le_log (cos th) 1 hct (by decide)).mpr (by linarith [le_abs_self.real (cos th), cos_abs_le_one th]); rw [log_one] at h; exact h
        have hsq : log (cos th) * log (cos th) ≤ M_d * M_d := by rw [hMd_def]; nlinarith
        have hpt := (hpt_sw th h1 (by linarith)).2.2
        have h4m := mul_le_mul_of_nonneg_left.real (log (cos th) * log (cos th)) (M_d * M_d) (4 * h) hsq (by linarith)
        rw [hg_def]; linarith
      have hbd := darboux.le_const g 0 (pi / 2 - d0) I1 (4 * h * (M_d * M_d)) hI1 hg_bd1
      have hMd2_nn : 0 ≤ M_d * M_d := by nlinarith
      have hc_nn : 0 ≤ 4 * h * (M_d * M_d) := by nlinarith
      nlinarith
    -- On [pi/2 - d0, pi/2 - dK]: g th <= 2 * (-log cos th), so I2 <= 2 * (e / 32) = e / 16!
    obtain ⟨It, hIt⟩ := darboux.continuous (fun th => -log (cos th)) (pi / 2 - d0) (pi / 2 - dK) (by linarith) (by intro t ht1 ht2; have hc := continuous_at.comp log cos t (sernau.log_cont_and_deriv (cos t) ((sernau.sin_cos_quarter_bounds t (by linarith) (by linarith)).2.2.2.1 (by linarith))).1 (continuous_at.cos t); continuity)
    have hI2_le := darboux.mono g (fun th => 2 * (-log (cos th))) (pi / 2 - d0) (pi / 2 - dK) I2 (2 * It) hI2 (darboux.scale _ _ _ It 2 hIt) (by intro th h1 h2; rw [hg_def]; linarith [(hpt_sw th (by linarith) (by linarith)).2.1])
    have hIt_le := htail_d0 dK hdK_pos hKd0; rw [rint.eq_of_has_integral _ _ _ It hIt] at hIt_le
    have hI1_e : 2 * I1 ≤ e / 4
      have hpm : 0 < 4 * pi * M_d := by nlinarith
      have hm := mul_lt_mul_of_pos_right.real h delta (4 * pi * M_d * M_d) hhd (by nlinarith)
      have hc : delta * (4 * pi * M_d * M_d) = e / 4 := by rw [hdel_def]; field_simp
      have hr : 2 * (4 * h * (M_d * M_d) * (pi / 2)) = h * (4 * pi * M_d * M_d) := by ring
      linarith
    exact ⟨by linarith, by linarith⟩
  obtain ⟨N0, hN0⟩ := exists_nat_gt.real (1 / d0)
  have hlo_all : ∀ K : ℕ, 0 ≤ 2 * rint (fun th => (rpow (cos th) (2 * h) - 1) / h - 2 * log (cos th)) 0 (pi / 2 - 1 / ((K + N0 + 2 : ℕ) : ℝ)) ∧ 2 * rint (fun th => (rpow (cos th) (2 * h) - 1) / h - 2 * log (cos th)) 0 (pi / 2 - 1 / ((K + N0 + 2 : ℕ) : ℝ)) ≤ e / 2
    intro K
    have hk_pos : 0 < ((K + N0 + 2 : ℕ) : ℝ) := (cast_pos.real (K + N0 + 2)).mpr (by omega)
    have hgt : 1 / d0 < ((K + N0 + 2 : ℕ) : ℝ) := by have hc := (cast_lt.real N0 (K + N0 + 2)).mpr (by omega); linarith
    have hle : 1 / ((K + N0 + 2 : ℕ) : ℝ) ≤ d0 := (div_le_iff.real 1 d0 _ hk_pos).mpr (by linarith [(div_lt_iff.real 1 ((K + N0 + 2 : ℕ) : ℝ) d0 hd0_pos).mp hgt])
    exact hseq_bd (K + N0) hle
  have hsh : tends_to (fun K => 2 * rint (fun th => (rpow (cos th) (2 * h) - 1) / h - 2 * log (cos th)) 0 (pi / 2 - 1 / ((K + N0 + 2 : ℕ) : ℝ))) ((sernau.row_int_val (1 + h) - pi) / h - (-2 * pi * log 2))
    unfold tends_to at hlim_q ⊢; intro e2 he2; obtain ⟨M0, hM0⟩ := hlim_q e2 he2; use M0; intro K hK
    exact hM0 (K + N0) (by omega)
  have hge0 := tends_to.ge_of_ge _ _ 0 hsh (by intro K; exact (hlo_all K).1)
  have hle_e2 : (sernau.row_int_val (1 + h) - pi) / h - (-2 * pi * log 2) ≤ e / 2
    by_contra hgt
    set Lq := (sernau.row_int_val (1 + h) - pi) / h - (-2 * pi * log 2) with hLq
    unfold tends_to at hsh
    obtain ⟨M, hM⟩ := hsh (Lq - e / 2) (by linarith)
    have h1 := hM M (by omega)
    have h2 := (hlo_all M).2
    linarith [neg_le_abs.real (2 * rint (fun th => (rpow (cos th) (2 * h) - 1) / h - 2 * log (cos th)) 0 (pi / 2 - 1 / ((M + N0 + 2 : ℕ) : ℝ)) - Lq)]
  exact abs_lt_of.real _ e (by linarith) (by linarith)
