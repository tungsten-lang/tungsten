    have hq2 : (exp (-2 * h * a) - 1) / h ≤ 0 := by have h := (div_le_iff.real (exp (-2 * h * a) - 1) 0 h hh0).mpr (by linarith); exact h
    have hq3 : (exp (-2 * h * a) - 1) / h + 2 * a ≤ 4 * h * (a * a)
