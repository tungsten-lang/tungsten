    use M0; intro M hM; rw [hscale_eq M]
    have hfac : rpow beta (1 - 2 * s) * (2 * rint (fun v => rpow (v * v + 1) (-s)) 0 ((M : ℝ) / beta)) - rpow beta (1 - 2 * s) * sernau.row_int_val s = rpow beta (1 - 2 * s) * (2 * rint (fun v => rpow (v * v + 1) (-s)) 0 ((M : ℝ) / beta) - sernau.row_int_val s) := by ring
