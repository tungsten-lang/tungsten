    have hm := mul_lt_mul_of_pos_left.real _ (e / rpow beta (1 - 2 * s)) (rpow beta (1 - 2 * s)) (hM0 M hM) hrb_pos
    have hc : rpow beta (1 - 2 * s) * (e / rpow beta (1 - 2 * s)) = e := by field_simp
    linarith
  -- Step 3: Right-derivative of `sernau.row_int_val` at `1+` equals `-2 * pi * log 2`!
  constructor; exact hrow1; constructor; exact himp_u
  intro e he
  obtain ⟨htail_lc, hlim_lc⟩ := sernau.int_log_cos_eq
  -- Choose cutoff d0 in (0, 1/2] with tail integral 4 * int_{pi/2 - d0}^{pi/2} (-log cos) < e / 4!
  set C_t := 1 + log 4 + 2 with hCt
  have hCt_pos : 0 < C_t := by rw [hCt]; linarith [log_nonneg 4 (by decide)]
  set d0 := min (1 / 2) ((e / (32 * C_t)) * (e / (32 * C_t))) with hd0_def
  have hd0_pos : 0 < d0 := by rw [hd0_def]; exact lt_min.real (1 / 2) _ 0 (by decide) (mul_pos.real _ _ (div_pos.real e (32 * C_t) he (by linarith)) (div_pos.real e (32 * C_t) he (by linarith)))
  have hd0_le : d0 ≤ 1 / 2 := by rw [hd0_def]; exact min_le_left.real (1 / 2) _
  have hsd0_le : sqrt d0 ≤ e / (32 * C_t)
    have hsq_le : d0 ≤ (e / (32 * C_t)) * (e / (32 * C_t)) := by rw [hd0_def]; exact min_le_right.real (1 / 2) _
    have h1 := sqrt_le_sqrt d0 ((e / (32 * C_t)) * (e / (32 * C_t))) (by linarith) hsq_le
    have h2 : sqrt ((e / (32 * C_t)) * (e / (32 * C_t))) = e / (32 * C_t)
      have hpos := div_pos.real e (32 * C_t) he (by linarith)
      have hsq := sq_sqrt ((e / (32 * C_t)) * (e / (32 * C_t))) (by nlinarith)
      nlinarith [sqrt_nonneg ((e / (32 * C_t)) * (e / (32 * C_t)))]
    linarith
  have hd0_le_sd0 : d0 ≤ sqrt d0 := by have hsq := sq_sqrt d0 (by linarith); nlinarith [sqrt_nonneg d0]
  have htail_d0 : ∀ d1 : ℝ, 0 < d1 → d1 ≤ d0 → rint (fun th => -log (cos th)) (pi / 2 - d0) (pi / 2 - d1) ≤ e / 32
    intro d1 hd1 hd10
    have ht := (htail_lc d1 d0 hd1 hd10 hd0_le).2
    have h1 : d0 * (1 + log 4) + 2 * sqrt d0 ≤ C_t * sqrt d0 := by rw [hCt]; nlinarith [log_nonneg 4 (by decide)]
    have h2 : C_t * sqrt d0 ≤ C_t * (e / (32 * C_t)) := mul_le_mul_of_nonneg_left.real _ _ C_t hsd0_le (by linarith)
    have h3 : C_t * (e / (32 * C_t)) = e / 32 := by field_simp
    linarith
  -- Choose delta for h > 0 so that on [0, pi/2 - d0], 4 * h * (log cos(pi/2 - d0))^2 * (pi/2) < e / 4!
  set M_d := -log (cos (pi / 2 - d0)) + 1 with hMd_def
  have hcd0_pos : 0 < cos (pi / 2 - d0) := (sernau.sin_cos_quarter_bounds (pi / 2 - d0) (by linarith) (by linarith)).2.2.2.1 (by linarith)
  have hMd_ge1 : 1 ≤ M_d
    have hle1 : cos (pi / 2 - d0) ≤ 1 := by linarith [le_abs_self.real (cos (pi / 2 - d0)), cos_abs_le_one (pi / 2 - d0)]
    have hl0 : log (cos (pi / 2 - d0)) ≤ 0 := by have h := (log_le_log _ 1 hcd0_pos (by decide)).mpr hle1; rw [log_one] at h; exact h
    rw [hMd_def]; linarith
  set delta := e / (16 * pi * M_d * M_d) with hdel_def
  have hdel_pos : 0 < delta := by rw [hdel_def]; have hpm : 0 < 16 * pi * M_d := (by nlinarith); exact div_pos.real e _ he (by nlinarith)
  use delta; constructor; exact hdel_pos
  intro h hh0 hhd
  -- Pointwise exponential sandwich for t = 2*h > 0 and y = log(cos th) <= 0:
  --   0 <= (rpow (cos th) (2*h) - 1) / h - 2 * log(cos th) <= min(-2 * log(cos th), 4 * h * (log(cos th))^2)!
  have hpt_sw : ∀ th : ℝ, 0 ≤ th → th < pi / 2 →
      0 ≤ (rpow (cos th) (2 * h) - 1) / h - 2 * log (cos th) ∧
      (rpow (cos th) (2 * h) - 1) / h - 2 * log (cos th) ≤ -2 * log (cos th) ∧
      (rpow (cos th) (2 * h) - 1) / h - 2 * log (cos th) ≤ 4 * h * (log (cos th) * log (cos th))
    intro th ht0 ht1
    have hct : 0 < cos th := (sernau.sin_cos_quarter_bounds th ht0 (by linarith)).2.2.2.1 ht1
    have hle1 : cos th ≤ 1 := by linarith [le_abs_self.real (cos th), cos_abs_le_one th]
    have hy0 : log (cos th) ≤ 0 := by have hl := (log_le_log (cos th) 1 hct (by decide)).mpr hle1; rw [log_one] at hl; exact hl
    set a := -log (cos th) with ha_def
    have ha_nn : 0 ≤ a := by rw [ha_def]; linarith
    have he_lo : 1 - 2 * h * a ≤ exp (-2 * h * a) := by have h1 := exp_ge_one_add (-2 * h * a); linarith
    have he_hi1 : exp (-2 * h * a) ≤ 1 := by have h1 := (exp_le_exp (-2 * h * a) 0).mpr (by nlinarith); rw [exp_zero] at h1; exact h1
    have he_hi2 : exp (-2 * h * a) * (1 + 2 * h * a) ≤ 1
      have h1 := exp_ge_one_add (2 * h * a)
      have hm := mul_le_mul_of_nonneg_left.real (1 + 2 * h * a) (exp (2 * h * a)) (exp (-2 * h * a)) h1 (exp_nonneg _)
      have hp : exp (-2 * h * a) * exp (2 * h * a) = 1 := by rw [← exp_add]; have h0 : -2 * h * a + 2 * h * a = 0 := (by ring); rw [h0, exp_zero]
      linarith
    have hden_pos : 0 < 1 + 2 * h * a := by nlinarith
    have hsub_le : exp (-2 * h * a) - 1 ≤ -(2 * h * a) / (1 + 2 * h * a)
