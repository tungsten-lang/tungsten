      intro j _
      rw [complex.abs_mul, complex.abs_of_real, abs_of_nonneg.real _ (cast_nonneg.real (sernau.epstein_box_cnt d R (R + j + 1))), cpow_real.abs_neg, habs_C_eq (R + j)]
