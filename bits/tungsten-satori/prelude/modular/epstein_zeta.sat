      · rw [succ_eq_add_one.nat]; have hs0 : R + (u + 1) = (R + u) + 1 := (by omega)
        rw [sum_below_succ, hs0, sum_below_succ, ihu]; ring
    have h1 := hN0 R (by omega)
    unfold partial_sum at h1
    change abs ((∑ m < R, complex.abs (C_tm m)) - S_abs) < e / 2 at h1
    have h2 := neg_le_abs.real ((∑ m < R, complex.abs (C_tm m)) - S_abs)
    have h3 := hps_le_Sabs U
    have h4 := htail_r (U - R)
    rw [← hU_sp] at h4
