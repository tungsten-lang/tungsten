  have hLC_eq := dseries.dirichlet_mul_re_gt_one (fun _ => complex.of_real 2) chi_d.val (fun m => complex.of_real (sernau.qf_rep_count d m : ℝ)) s (complex.mul (complex.of_real 2) (zeta_em2 s)) (classical_L_fn chi_d s) LC habs_A habs_B hLA hLB (by rw [hCtm_def] at hLC; exact hLC) hconv
