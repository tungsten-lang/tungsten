        csum (U - R) (fun j => complex.mul (complex.of_real (sernau.epstein_box_cnt d R (R + j + 1) : ℝ)) (cpow_real ((R + j + 1 : ℕ) : ℝ) (complex.neg s)))
      have hc0 : ∀ z : ℂ, complex.sub z complex.zero = z := by intro z; apply complex.ext <;> simp <;> ring
