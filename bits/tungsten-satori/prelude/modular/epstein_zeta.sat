  have hsum_lim := ctends_to.add (fun R => complex.sub (sernau.epstein_class_box d s R) (csum R C_tm)) (fun R => csum R C_tm) complex.zero LC hdiff_zero hLC
  have hf : (fun R => complex.add (complex.sub (sernau.epstein_class_box d s R) (csum R C_tm)) (csum R C_tm)) = sernau.epstein_class_box d s := by funext R; apply complex.ext <;> simp <;> ring
  rw [hf, complex.zero_add] at hsum_lim; exact hsum_lim
