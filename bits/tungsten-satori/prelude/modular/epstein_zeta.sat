  unfold tends_to at hS_abs
  have hps_le_Sabs : ∀ N : ℕ, (∑ m < N, complex.abs (C_tm m)) ≤ S_abs
    intro N
    have hsh : tends_to (fun k => (∑ m < N + k, complex.abs (C_tm m)) - (∑ m < N, complex.abs (C_tm m))) (S_abs - ∑ m < N, complex.abs (C_tm m))
      unfold tends_to; intro e he; obtain ⟨N0, hN0⟩ := hS_abs e he; use N0; intro k hk
      have hr : ((∑ m < N + k, complex.abs (C_tm m)) - (∑ m < N, complex.abs (C_tm m))) - (S_abs - ∑ m < N, complex.abs (C_tm m)) = (∑ m < N + k, complex.abs (C_tm m)) - S_abs := by ring
      rw [hr]; exact hN0 (N + k) (by omega)
