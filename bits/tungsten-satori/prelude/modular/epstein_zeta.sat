    change complex.abs (csum (U - R) (fun j => complex.mul (complex.of_real (sernau.epstein_box_cnt d R (R + j + 1) : ℝ)) (cpow_real ((R + j + 1 : ℕ) : ℝ) (complex.neg s)))) ≤ ∑ j < U - R, complex.abs (complex.mul (complex.of_real (sernau.epstein_box_cnt d R (R + j + 1) : ℝ)) (cpow_real ((R + j + 1 : ℕ) : ℝ) (complex.neg s))) at habs1
    have hle_tm : ∀ j < U - R,
