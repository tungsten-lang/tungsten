-- Milestone 3.81a (Part 1): Arithmetic Representation Formula `qf_rep_count = 2 * (1 * chi_{-d})`
--                           via CRT, Hensel Lifting, and Gauss Quadratic Reciprocity
--                           (`Lib/CM/Genus/QuadraticZeta.lean`)
--
-- Proved unconditionally on Satori's untouched HOL kernel (ZERO custom axioms).

import modular.binary_quadratic_forms

-- ====================================================================================
-- 1. Coprime Bézout, CRT Bijection, and Prime-Power Factorization of `ok_sq_sum`
-- ====================================================================================

-> sernau.ok_sq_sum (d n : ℕ) : ℕ :=
  ∑ g < n + 1, if 1 ≤ g ∧ (g * g) ∣ n then sernau.ok_roots d (n / (g * g)) else 0

-> sernau.quad_conv_int (d n : ℕ) : ℤ :=
  ∑ k < n + 1, if 1 ≤ k ∧ k ∣ n then legendre_sym d k else 0

+ sernau.coprime_ppow_bezout (p e R : ℕ) (hp : is_prime_nat p) (hR : 1 ≤ R) (hnd : ¬ (p ∣ R)) :
    ∃ u v : ℤ, ((p ^ e : ℕ) : ℤ) * u + (R : ℤ) * v = 1
  have hp2 : 2 ≤ p := hp.1
  obtain ⟨gz, uz, vz, hgz_nn, ⟨qp, hqp⟩, ⟨qR, hqR⟩, hbez⟩ := int.bezout_gcd ((p ^ e : ℕ) : ℤ) (R : ℤ)
  have hgz_pos : 1 ≤ gz
    by_contra h0; have hz : gz = 0 := (by omega); rw [hz] at hqR; simp at hqR
    have hR1 : (1 : ℤ) ≤ (R : ℤ) := (cast_le.int 1 R).mpr hR; omega
  set g := nat_of_int gz with hg_def
  have hg_eq : (g : ℤ) = gz := by rw [hg_def]; exact int_of_nat_of_int gz hgz_nn
  have hg_ge1 : 1 ≤ g := (cast_le.int 1 g).mp (by omega)
  have hg_dvd_pe : g ∣ (p ^ e)
    have hqp_nn : 0 ≤ qp := by by_contra hn; have hm := mul_le_mul_of_nonneg_left.int qp (-1) gz (by omega) (by omega); have hpe_nn := cast_nonneg.int (p ^ e); omega
    set qpn := nat_of_int qp with hqpn_def; have hqpn_eq : (qpn : ℤ) = qp := by rw [hqpn_def]; exact int_of_nat_of_int qp hqp_nn
    exact (dvd.iff_exists g (p ^ e) (by omega)).mpr ⟨qpn, (cast_inj.int (p ^ e) (g * qpn)).mp (by rw [cast_mul.int, hg_eq, hqpn_eq]; exact hqp)⟩
  have hg_dvd_R : g ∣ R
    have hqR_nn : 0 ≤ qR := by by_contra hn; have hm := mul_le_mul_of_nonneg_left.int qR (-1) gz (by omega) (by omega); have hR_nn := cast_nonneg.int R; omega
    set qRn := nat_of_int qR with hqRn_def; have hqRn_eq : (qRn : ℤ) = qR := by rw [hqRn_def]; exact int_of_nat_of_int qR hqR_nn
    exact (dvd.iff_exists g R (by omega)).mpr ⟨qRn, (cast_inj.int R (g * qRn)).mp (by rw [cast_mul.int, hg_eq, hqRn_eq]; exact hqR)⟩
  have hg1 : g = 1
    by_contra hne1; have hg2 : 2 ≤ g := by omega
    set q := min_fac g with hq_def
    have hq_pr : is_prime_nat q := (sernau.m81a_prime_iff q).mp (by rw [hq_def]; exact min_fac.prime g hg2)
    have hq2 : 2 ≤ q := hq_pr.1
    have hqg : q ∣ g := by rw [hq_def]; exact (min_fac.spec g hg2).2.2.1
    obtain ⟨kg, hkg⟩ := (dvd.iff_exists q g (by omega)).mp hqg
    obtain ⟨kpe, hkpe⟩ := (dvd.iff_exists g (p ^ e) (by omega)).mp hg_dvd_pe
    obtain ⟨kR, hkR⟩ := (dvd.iff_exists g R (by omega)).mp hg_dvd_R
    have hq_pe : q ∣ (p ^ e) := (dvd.iff_exists q (p ^ e) (by omega)).mpr ⟨kg * kpe, by rw [hkpe, hkg]; ring⟩
    have hq_R : q ∣ R := (dvd.iff_exists q R (by omega)).mpr ⟨kg * kR, by rw [hkR, hkg]; ring⟩
    by_cases he0 : e = 0
    · rw [he0, pow_zero.nat] at hq_pe; exact not_dvd_one_of_ge_two q hq2 hq_pe
    · have hqp0 := sernau.m81a_prime_dvd_pow q p ((sernau.m81a_prime_iff q).mpr hq_pr) e (by omega) hq_pe
      obtain h1 | h2 := sernau.m81a_dvd_cases p q hp (by omega) hqp0; omega
      rw [h2] at hq_R; exact hnd hq_R
  have hgz1 : gz = 1 := by rw [← hg_eq, hg1]; decide
  exact ⟨uz, vz, by rw [hgz1] at hbez; linear_combination hbez⟩

+ sernau.ok_roots_mul_coprime (d A B : ℕ) (hA : 1 ≤ A) (hB : 1 ≤ B)
    (hbez : ∃ u v : ℤ, (A : ℤ) * u + (B : ℤ) * v = 1) :
    sernau.ok_roots d (A * B) = sernau.ok_roots d A * sernau.ok_roots d B
  obtain ⟨u, v, huv⟩ := hbez
  have hAB_pos : 0 < A * B := mul_pos.nat A B (by omega) (by omega)
  have hpoly_mod : ∀ (M t : ℕ), 1 ≤ M → sernau.ok_poly d t % M = sernau.ok_poly d (t % M) % M
    intro M t hM1
    set qt := t / M with hqt_def; set rt := t % M with hrt_def
    have hdm := div_add_mod.nat t M; rw [← hqt_def, ← hrt_def] at hdm
    have hexp : sernau.ok_poly d t = sernau.ok_poly d rt + M * (qt * (M * qt + 2 * rt + 1)) := by unfold sernau.ok_poly; rw [← hdm]; ring
    rw [hexp, add_mul_mod.nat]
  have hcop_dvd : ∀ x : ℕ, (A * B) ∣ x ↔ (A ∣ x ∧ B ∣ x)
    intro x; constructor
    · intro hab; obtain ⟨k, hk⟩ := (dvd.iff_exists (A * B) x hAB_pos).mp hab
      exact ⟨(dvd.iff_exists A x (by omega)).mpr ⟨B * k, by rw [hk]; ring⟩, (dvd.iff_exists B x (by omega)).mpr ⟨A * k, by rw [hk]; ring⟩⟩
    · intro ⟨ha, hb⟩
      obtain ⟨qa, hqa⟩ := (dvd.iff_exists A x (by omega)).mp ha
      obtain ⟨qb, hqb⟩ := (dvd.iff_exists B x (by omega)).mp hb
      have hz_eq : (A : ℤ) * (qa : ℤ) = (B : ℤ) * (qb : ℤ) := by rw [← cast_mul.int A qa, ← hqa, ← cast_mul.int B qb, ← hqb]
      have hqb_z : (qb : ℤ) = (A : ℤ) * ((qb : ℤ) * u + (qa : ℤ) * v) := by linear_combination -(qb : ℤ) * huv - v * hz_eq
      set w_z := (qb : ℤ) * u + (qa : ℤ) * v with hwz_def
      have hwz_nn : 0 ≤ w_z := by by_contra hn; have hm := mul_le_mul_of_nonneg_left.int w_z (-1) (A : ℤ) (by omega) (cast_nonneg.int A); have hA1 : (1 : ℤ) ≤ (A : ℤ) := (cast_le.int 1 A).mpr hA; have hqb_nn := cast_nonneg.int qb; omega
      set w := nat_of_int w_z with hw_def; have hw_eq : (w : ℤ) = w_z := by rw [hw_def]; exact int_of_nat_of_int _ hwz_nn
      have hqb_nat : qb = A * w := (cast_inj.int qb (A * w)).mp (by rw [cast_mul.int, hw_eq]; exact hqb_z)
      exact (dvd.iff_exists (A * B) x hAB_pos).mpr ⟨w, by rw [hqb, hqb_nat]; ring⟩
  have hcrt_uniq : ∀ t1 < A * B, ∀ t2 < A * B, t1 % A = t2 % A → t1 % B = t2 % B → t1 = t2
    intro t1 ht1 t2 ht2 hmA hmB
    have hle_case : ∀ x y : ℕ, x < A * B → y < A * B → y ≤ x → x % A = y % A → x % B = y % B → x = y
      intro x y hx hy hyx eA eB
      have hdA : A ∣ (x - y) := (mod_eq_iff_dvd_sub A x y (by omega) hyx).mp eA
      have hdB : B ∣ (x - y) := (mod_eq_iff_dvd_sub B x y (by omega) hyx).mp eB
      have hdAB : (A * B) ∣ (x - y) := (hcop_dvd (x - y)).mpr ⟨hdA, hdB⟩
      by_cases he : x = y; exact he
      have hle := le_of_dvd.nat (x - y) (A * B) (by omega) hdAB; omega
    by_cases h12 : t2 ≤ t1; exact hle_case t1 t2 ht1 ht2 h12 hmA hmB
    exact (hle_case t2 t1 ht2 ht1 (by omega) hmA.symm hmB.symm).symm
  have hcrt_ex : ∀ a < A, ∀ b < B, ∃ t < A * B, t % A = a ∧ t % B = b
    intro a ha b hb
    set z0 : ℤ := (b : ℤ) * (A : ℤ) * u + (a : ℤ) * (B : ℤ) * v with hz0_def
    set abs_z := nat_of_int (if 0 ≤ z0 then z0 else -z0) with habsz_def
    have habsz_ge : -(abs_z : ℤ) ≤ z0 := by by_cases h0 : 0 ≤ z0; (have he : (abs_z : ℤ) = z0 := (by rw [habsz_def, if_pos h0]; exact int_of_nat_of_int _ h0); omega); (have he : (abs_z : ℤ) = -z0 := (by rw [habsz_def, if_neg h0]; exact int_of_nat_of_int _ (by omega)); omega)
    set sh := nat_of_int (z0 + ((A * B : ℕ) : ℤ) * ((abs_z + 1 : ℕ) : ℤ)) with hsh_def
    have hsh_nn : 0 ≤ z0 + ((A * B : ℕ) : ℤ) * ((abs_z + 1 : ℕ) : ℤ) := by have hAB1 : (1 : ℤ) ≤ ((A * B : ℕ) : ℤ) := (cast_le.int 1 (A * B)).mpr (by omega); have hm := mul_le_mul_of_nonneg_right.int 1 ((A * B : ℕ) : ℤ) ((abs_z + 1 : ℕ) : ℤ) hAB1 (cast_nonneg.int _); rw [cast_add.int, cast_one.int] at hm ⊢; omega
    have hsh_eq : (sh : ℤ) = z0 + ((A * B : ℕ) : ℤ) * ((abs_z + 1 : ℕ) : ℤ) := by rw [hsh_def]; exact int_of_nat_of_int _ hsh_nn
    set t0 := sh % (A * B) with ht0_def; set q0 := sh / (A * B) with hq0_def
    have hdm := div_add_mod.nat sh (A * B); have ht0_lt := mod_lt.nat sh (A * B) hAB_pos
    rw [← hq0_def, ← ht0_def] at hdm; rw [← ht0_def] at ht0_lt
    have hsh_z : (sh : ℤ) = ((A * B : ℕ) : ℤ) * (q0 : ℤ) + (t0 : ℤ) := by have hc : ((sh : ℕ) : ℤ) = (((A * B) * q0 + t0 : ℕ) : ℤ) := (by rw [hdm]); rw [cast_add.int, cast_mul.int] at hc; exact hc
    have hmod_from_z : ∀ (M r : ℕ) (k_z : ℤ), 1 ≤ M → r < M → (t0 : ℤ) - (r : ℤ) = (M : ℤ) * k_z → t0 % M = r
      intro M r k_z hM1 hr hk
      set qt := t0 / M with hqt; set rt := t0 % M with hrt
      have hd_M := div_add_mod.nat t0 M; have hrt_lt := mod_lt.nat t0 M (by omega)
      rw [← hqt, ← hrt] at hd_M; rw [← hrt] at hrt_lt
      have ht0_M : (t0 : ℤ) = (M : ℤ) * (qt : ℤ) + (rt : ℤ) := by have hc : ((t0 : ℕ) : ℤ) = ((M * qt + rt : ℕ) : ℤ) := (by rw [hd_M]); rw [cast_add.int, cast_mul.int] at hc; exact hc
      have hdiff : (rt : ℤ) - (r : ℤ) = (M : ℤ) * (k_z - (qt : ℤ)) := by linear_combination hk - ht0_M
      have hk0 : k_z - (qt : ℤ) = 0 := by
        have hr_lo := cast_nonneg.int r; have hr_hi : (r : ℤ) < (M : ℤ) := (cast_lt.int r M).mpr hr
        have hrt_lo := cast_nonneg.int rt; have hrt_hi : (rt : ℤ) < (M : ℤ) := (cast_lt.int rt M).mpr hrt_lt
        by_contra hne; by_cases hp : 1 ≤ k_z - (qt : ℤ); (have hm := mul_le_mul_of_nonneg_left.int 1 (k_z - (qt : ℤ)) (M : ℤ) hp (cast_nonneg.int M); omega); (have hm := mul_le_mul_of_nonneg_left.int (k_z - (qt : ℤ)) (-1) (M : ℤ) (by omega) (cast_nonneg.int M); omega)
      rw [hk0] at hdiff; exact (cast_inj.int rt r).mp (by omega)
    have ht0_A : t0 % A = a
      apply hmod_from_z A a (((b : ℤ) - (a : ℤ)) * u + (B : ℤ) * (((abs_z + 1 : ℕ) : ℤ) - (q0 : ℤ))) hA ha
      rw [cast_mul.int A B] at hsh_eq hsh_z; linear_combination hsh_eq - hsh_z + hz0_def + (a : ℤ) * huv
    have ht0_B : t0 % B = b
      apply hmod_from_z B b (((a : ℤ) - (b : ℤ)) * v + (A : ℤ) * (((abs_z + 1 : ℕ) : ℤ) - (q0 : ℤ))) hB hb
      rw [cast_mul.int A B] at hsh_eq hsh_z; linear_combination hsh_eq - hsh_z + hz0_def + (b : ℤ) * huv
    exact ⟨t0, ht0_lt, ht0_A, ht0_B⟩
  have hzero_fn : ∀ (N : ℕ) (f : ℕ → ℕ), (∀ k < N, f k = 0) → (∑ k < N, f k) = 0 := by intro N f; induction N with _ k ihk hall; (rw [sum_below_zero]); (rw [succ_eq_add_one.nat, sum_below_succ, ihk (by intro j hj; exact hall j (by omega)), hall k (by omega)]; omega)
  have hsingle : ∀ (N a : ℕ) (f : ℕ → ℕ), a < N → (∀ k < N, k ≠ a → f k = 0) → (∑ k < N, f k) = f a
    intro N a f; induction N with _ _ k ihk ha hall; omega; rw [succ_eq_add_one.nat] at ha hall ⊢; rw [sum_below_succ]
    by_cases hlt : a < k; (rw [ihk hlt (by intro j hj hne; exact hall j (by omega) hne), hall k (by omega) (by omega)]; omega)
    have he : k = a := (by omega); rw [he, hzero_fn a f (by intro j hj; exact hall j (by omega) (by omega))]; omega
  have hmul_sum : ∀ (N c : ℕ) (f : ℕ → ℕ), (∑ k < N, f k * c) = (∑ k < N, f k) * c := by intro N c f; induction N with k ihk; simp [sum_below_zero]; (rw [succ_eq_add_one.nat, sum_below_succ, sum_below_succ, ihk]; ring)
  have hmul_sum_l : ∀ (N c : ℕ) (f : ℕ → ℕ), (∑ k < N, c * f k) = c * (∑ k < N, f k) := by intro N c f; induction N with k ihk; simp [sum_below_zero]; (rw [succ_eq_add_one.nat, sum_below_succ, sum_below_succ, ihk]; ring)
  unfold sernau.ok_roots
  have hrow_t : ∀ t < A * B, (if sernau.ok_poly d t % (A * B) = 0 then 1 else 0) =
      ∑ a < A, ∑ b < B, if t % A = a ∧ t % B = b ∧ sernau.ok_poly d a % A = 0 ∧ sernau.ok_poly d b % B = 0 then 1 else 0
    intro t ht
    have hiff : sernau.ok_poly d t % (A * B) = 0 ↔ sernau.ok_poly d (t % A) % A = 0 ∧ sernau.ok_poly d (t % B) % B = 0
      have hc := hcop_dvd (sernau.ok_poly d t); unfold dvd at hc
      rw [← hpoly_mod A t hA, ← hpoly_mod B t hB]; exact hc
    symm
    rw [hsingle A (t % A) _ (mod_lt.nat t A (by omega)) (by intro a _ hne; apply hzero_fn; intro b _; rw [if_neg (by intro h; exact hne h.1.symm)])]
    rw [hsingle B (t % B) _ (mod_lt.nat t B (by omega)) (by intro b _ hne; rw [if_neg (by intro h; exact hne h.2.1.symm)])]
    by_cases hr : sernau.ok_poly d t % (A * B) = 0
    · obtain ⟨h1, h2⟩ := hiff.mp hr
      have hp_ab : t % A = t % A ∧ t % B = t % B ∧ sernau.ok_poly d (t % A) % A = 0 ∧ sernau.ok_poly d (t % B) % B = 0 := ⟨by rfl, by rfl, h1, h2⟩
      rw [if_pos hp_ab, if_pos hr]
    · rw [if_neg (by intro h; exact hr (hiff.mpr ⟨h.2.2.1, h.2.2.2⟩)), if_neg hr]
  have hcol_ab : ∀ a < A, ∀ b < B, (∑ t < A * B, if t % A = a ∧ t % B = b ∧ sernau.ok_poly d a % A = 0 ∧ sernau.ok_poly d b % B = 0 then 1 else 0) =
      (if sernau.ok_poly d a % A = 0 then 1 else 0) * (if sernau.ok_poly d b % B = 0 then 1 else 0)
    intro a ha b hb; obtain ⟨t0, ht0_lt, ht0A, ht0B⟩ := hcrt_ex a ha b hb
    rw [hsingle (A * B) t0 _ ht0_lt (by intro t ht hne; rw [if_neg (by intro h; exact hne (hcrt_uniq t ht t0 ht0_lt (by rw [h.1, ht0A]) (by rw [h.2.1, ht0B])))])]
    by_cases h1 : sernau.ok_poly d a % A = 0
    · by_cases h2 : sernau.ok_poly d b % B = 0
      · rw [if_pos ⟨ht0A, ht0B, h1, h2⟩, if_pos h1, if_pos h2]; omega
      · rw [if_neg (by intro h; exact h2 h.2.2.2), if_pos h1, if_neg h2]; omega
    · rw [if_neg (by intro h; exact h1 h.2.2.1), if_neg h1]; omega
  rw [sum_congr.nat _ _ (A * B) hrow_t, sum_swap.nat]
  have hsw2 : (∑ a < A, ∑ t < A * B, ∑ b < B, if t % A = a ∧ t % B = b ∧ sernau.ok_poly d a % A = 0 ∧ sernau.ok_poly d b % B = 0 then 1 else 0) =
      ∑ a < A, ∑ b < B, ∑ t < A * B, if t % A = a ∧ t % B = b ∧ sernau.ok_poly d a % A = 0 ∧ sernau.ok_poly d b % B = 0 then 1 else 0 :=
    sum_congr.nat _ _ A (by intro a _; exact sum_swap.nat _ (A * B) B)
  rw [hsw2]
  have heval : (∑ a < A, ∑ b < B, ∑ t < A * B, if t % A = a ∧ t % B = b ∧ sernau.ok_poly d a % A = 0 ∧ sernau.ok_poly d b % B = 0 then 1 else 0) =
      ∑ a < A, (if sernau.ok_poly d a % A = 0 then 1 else 0) * (∑ b < B, if sernau.ok_poly d b % B = 0 then 1 else 0)
    apply sum_congr.nat; intro a ha
    rw [sum_congr.nat _ _ B (hcol_ab a ha), hmul_sum_l]
  rw [heval, hmul_sum]

+ sernau.ppow_coprime_decomp (d p e R : ℕ) (hd_pr : is_prime_nat d) (hd8 : d % 8 = 7)
    (hp : is_prime_nat p) (he : 1 ≤ e) (hR : 1 ≤ R) (hnd : ¬ (p ∣ R)) :
    sernau.ok_sq_sum d ((p ^ e) * R) = (∑ j < e / 2 + 1, sernau.ok_roots d (p ^ (e - 2 * j))) * sernau.ok_sq_sum d R ∧
    sernau.quad_conv_int d ((p ^ e) * R) = (∑ i < e + 1, legendre_sym d (p ^ i)) * sernau.quad_conv_int d R
  have hp2 : 2 ≤ p := hp.1; have hd_odd : d % 2 = 1 := by have h := div_add_mod.nat d 8; omega
  have hpe_pos : 0 < p ^ e := pow_pos.nat p e (by omega)
  have hN_pos : 0 < (p ^ e) * R := mul_pos.nat (p ^ e) R hpe_pos (by omega)
  have hpow_add : ∀ a b : ℕ, p ^ (a + b) = (p ^ a) * (p ^ b) := by intro a b; exact pow_add.nat p a b
  have hvp_pp : vp p p = 1
    have hge1 : 1 ≤ vp p p := (vp.le_iff_pow_dvd p p 1 hp2 (by omega)).mpr (by have hp1 : p ^ 1 = p := (by have e1 : (1 : ℕ) = 0 + 1 := (by rfl); rw [e1, pow_succ.nat, pow_zero.nat]; ring); rw [hp1]; exact (dvd.iff_exists p p (by omega)).mpr ⟨1, by ring⟩)
    by_contra hgt1; have hd2 := (vp.le_iff_pow_dvd p p 2 hp2 (by omega)).mp (by omega)
    have hp_sq : p ^ 2 = p * p := (by have e2 : (2 : ℕ) = (0 + 1) + 1 := (by rfl); rw [e2, pow_succ.nat, pow_succ.nat, pow_zero.nat]; ring)
    rw [hp_sq] at hd2; have hle := le_of_dvd.nat p (p * p) (by omega) hd2
    have hm := mul_le_mul_of_nonneg_left.nat 2 p p hp2 (by omega); omega
  have hvp_R : vp p R = 0 := vp.eq_zero_of_not_dvd p R hp2 (by omega) hnd
  have hvp_N : vp p ((p ^ e) * R) = e := by rw [vp.mul p (p ^ e) R hp hpe_pos (by omega), vp.pow p p e hp (by omega), hvp_pp, hvp_R]; ring
  have hcop_dvd_pe : ∀ (a x y : ℕ), 1 ≤ y → ¬ (p ∣ y) → y ∣ ((p ^ a) * x) → y ∣ x
    intro a x y hy1 hndy hdy
    obtain ⟨u, v, huv⟩ := sernau.coprime_ppow_bezout p a y hp hy1 hndy
    obtain ⟨q, hq⟩ := (dvd.iff_exists y ((p ^ a) * x) (by omega)).mp hdy
    have hxz : (x : ℤ) = (y : ℤ) * ((q : ℤ) * u + (x : ℤ) * v) := by
      have hz : ((p ^ a : ℕ) : ℤ) * (x : ℤ) = (y : ℤ) * (q : ℤ) := by rw [← cast_mul.int (p ^ a) x, hq, cast_mul.int y q]
      linear_combination -(x : ℤ) * huv + u * hz
    set wz := (q : ℤ) * u + (x : ℤ) * v with hwz
    have hwz_nn : 0 ≤ wz := by by_contra hn; have hm := mul_le_mul_of_nonneg_left.int wz (-1) (y : ℤ) (by omega) (cast_nonneg.int y); have hy_z : (1 : ℤ) ≤ (y : ℤ) := (cast_le.int 1 y).mpr hy1; have hx_nn := cast_nonneg.int x; omega
