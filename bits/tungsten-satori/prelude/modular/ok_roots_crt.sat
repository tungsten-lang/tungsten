            rw [hN_def, hpe_sp, hl0_eq] at hc1
            simp [cast_mul.int] at hc1 ⊢; linear_combination -hc1
          have hpi_pos : (1 : ℤ) ≤ ((p ^ i0 : ℕ) : ℤ) := (cast_le.int 1 (p ^ i0)).mpr (by have hp0 := pow_pos.nat p i0 (by omega); omega)
          have hcan_nat : l0 * qn = (p ^ (e - i0)) * R
            apply (cast_inj.int (l0 * qn) ((p ^ (e - i0)) * R)).mp
            by_contra hne; by_cases hlt : ((l0 * qn : ℕ) : ℤ) < (((p ^ (e - i0)) * R : ℕ) : ℤ)
            · have hm := mul_le_mul_of_nonneg_left.int (((l0 * qn : ℕ) : ℤ) + 1) (((p ^ (e - i0)) * R : ℕ) : ℤ) ((p ^ i0 : ℕ) : ℤ) (by omega) (by omega); omega
            · have hm := mul_le_mul_of_nonneg_left.int ((((p ^ (e - i0)) * R : ℕ) : ℤ) + 1) ((l0 * qn : ℕ) : ℤ) ((p ^ i0 : ℕ) : ℤ) (by omega) (by omega); omega
          exact hcop_dvd_pe (e - i0) R l0 hl0_ge1 hnd_l0 ((dvd.iff_exists l0 ((p ^ (e - i0)) * R) (by omega)).mpr ⟨qn, hcan_nat.symm⟩)
        have hl0_lt : l0 < R + 1 := by have hle := le_of_dvd.nat R l0 (by omega) hl0_dvd_R; omega
        have hun_il : ∀ i < e + 1, ∀ l < R + 1, (1 ≤ l ∧ l ∣ R ∧ k = (p ^ i) * l) → i = i0 ∧ l = l0
          intro i _ l _ ⟨hl1, hlR, hki⟩
          have hnd_l : ¬ (p ∣ l) := by intro hpl; obtain ⟨u1, hu1⟩ := (dvd.iff_exists p l (by omega)).mp hpl; obtain ⟨u2, hu2⟩ := (dvd.iff_exists l R (by omega)).mp hlR; exact hnd ((dvd.iff_exists p R (by omega)).mpr ⟨u1 * u2, by rw [hu2, hu1]; ring⟩)
          have hvp_k : vp p k = i := by rw [hki, vp.mul p (p ^ i) l hp (pow_pos.nat p i (by omega)) (by omega), vp.pow p p i hp (by omega), hvp_pp, vp.eq_zero_of_not_dvd p l hp2 (by omega) hnd_l]; ring
          have hieq : i = i0 := by rw [hi0_def, hvp_k]
          rw [hieq, hl0_eq] at hki
          have hleq : l = l0
            apply (cast_inj.int l l0).mp
            have hz : ((p ^ i0 : ℕ) : ℤ) * ((l : ℤ) - (l0 : ℤ)) = 0 := by have hc : (((p ^ i0) * l0 : ℕ) : ℤ) = (((p ^ i0) * l : ℕ) : ℤ) := (by rw [← hki]); rw [cast_mul.int, cast_mul.int] at hc; linear_combination -hc
            have hp0_z : (1 : ℤ) ≤ ((p ^ i0 : ℕ) : ℤ) := (cast_le.int 1 (p ^ i0)).mpr (by have hp0 := pow_pos.nat p i0 (by omega); omega)
            by_contra hne; by_cases hp_d : 1 ≤ (l : ℤ) - (l0 : ℤ); (have hm := mul_le_mul_of_nonneg_left.int 1 ((l : ℤ) - (l0 : ℤ)) ((p ^ i0 : ℕ) : ℤ) hp_d (by omega); omega); (have hm := mul_le_mul_of_nonneg_left.int ((l : ℤ) - (l0 : ℤ)) (-1) ((p ^ i0 : ℕ) : ℤ) (by omega) (by omega); omega)
          exact ⟨hieq, hleq⟩
        symm
        rw [hsingle_z (e + 1) i0 _ (by omega) (by intro i hi hne; apply hzero_z; intro l hl; rw [if_neg (by intro hr; exact hne (hun_il i hi l hl hr).1)])]
        rw [hsingle_z (R + 1) l0 _ hl0_lt (by intro l hl hne; rw [if_neg (by intro hr; exact hne (hun_il i0 (by omega) l hl hr).2)])]
        rw [if_pos ⟨hl0_ge1, hl0_dvd_R, hl0_eq⟩, hl0_eq, legendre_sym.mul d (p ^ i0) l0 hd_pr hd_odd]
      · rw [if_neg hcond]; symm; apply hzero_z; intro i hi; apply hzero_z; intro l hl
        rw [if_neg (by intro ⟨hl1, hlR, hki⟩; apply hcond; have hpi_pos := pow_pos.nat p i (by omega); have hk1 : 1 ≤ k := (by rw [hki]; have hp0 := mul_pos.nat (p ^ i) l hpi_pos (by omega); omega); obtain ⟨qR0, hqR0⟩ := (dvd.iff_exists l R (by omega)).mp hlR; have he_sp : i + (e - i) = e := (by omega); have hpe_sp : p ^ e = (p ^ i) * (p ^ (e - i)) := (by rw [← hpow_add i (e - i), he_sp]); exact ⟨hk1, (dvd.iff_exists k N (by omega)).mpr ⟨(p ^ (e - i)) * qR0, by rw [hN_def, hpe_sp, hqR0, hki]; ring⟩⟩)]
    have hcol_il : ∀ i < e + 1, ∀ l < R + 1,
        (∑ k < N + 1, if 1 ≤ l ∧ l ∣ R ∧ k = (p ^ i) * l then legendre_sym d (p ^ i) * legendre_sym d l else 0) =
        legendre_sym d (p ^ i) * (if 1 ≤ l ∧ l ∣ R then legendre_sym d l else 0)
      intro i hi l hl
      by_cases hc : 1 ≤ l ∧ l ∣ R
      · rw [if_pos hc]
        have hle_pe : p ^ i ≤ p ^ e
          have hrec : ∀ a b : ℕ, a ≤ b → p ^ a ≤ p ^ b := by intro a b; induction b with _ u ihu hab; (have ha0 : a = 0 := (by omega); rw [ha0]; omega); (rw [succ_eq_add_one.nat] at hab ⊢; by_cases hau : a ≤ u; (rw [pow_succ.nat]; have hm := mul_le_mul_of_nonneg_left.nat 1 p (p ^ u) (by omega) (by omega); have ih := ihu hau; omega); (have hae : a = u + 1 := (by omega); rw [hae]; omega))
          exact hrec i e (by omega)
        have hk_lt : (p ^ i) * l < N + 1
          rw [hN_def]; have hm1 := mul_le_mul_of_nonneg_right.nat (p ^ i) (p ^ e) l hle_pe (by omega)
          have hm2 := mul_le_mul_of_nonneg_left.nat l R (p ^ e) (by omega) (by omega); omega
        have hp_hc : 1 ≤ l ∧ l ∣ R ∧ (p ^ i) * l = (p ^ i) * l := ⟨hc.1, hc.2, by rfl⟩
        rw [hsingle_z (N + 1) ((p ^ i) * l) _ hk_lt (by intro k _ hne; rw [if_neg (by intro hr; exact hne hr.2.2)]), if_pos hp_hc]
      · rw [if_neg hc]; have hm0 : legendre_sym d (p ^ i) * 0 = 0 := (by ring); rw [hm0]; apply hzero_z; intro k _; rw [if_neg (by intro hr; exact hc ⟨hr.1, hr.2.1⟩)]
    unfold sernau.quad_conv_int; rw [hcongr_z (N + 1) _ _ hrow_k, hswap_z (N + 1) (e + 1)]
    have hsw : (∑ i < e + 1, ∑ k < N + 1, ∑ l < R + 1, if 1 ≤ l ∧ l ∣ R ∧ k = (p ^ i) * l then legendre_sym d (p ^ i) * legendre_sym d l else 0) =
        ∑ i < e + 1, ∑ l < R + 1, ∑ k < N + 1, if 1 ≤ l ∧ l ∣ R ∧ k = (p ^ i) * l then legendre_sym d (p ^ i) * legendre_sym d l else 0 :=
      hcongr_z (e + 1) _ _ (by intro i _; exact hswap_z (N + 1) (R + 1) _)
    rw [hsw]
    have hev : (∑ i < e + 1, ∑ l < R + 1, ∑ k < N + 1, if 1 ≤ l ∧ l ∣ R ∧ k = (p ^ i) * l then legendre_sym d (p ^ i) * legendre_sym d l else 0) =
        ∑ i < e + 1, legendre_sym d (p ^ i) * (∑ l < R + 1, if 1 ≤ l ∧ l ∣ R then legendre_sym d l else 0)
      apply hcongr_z; intro i hi; rw [hcongr_z (R + 1) _ _ (hcol_il i hi), hmul_z_l]
    rw [hev, hmul_z_r]

-- ====================================================================================
-- 2. Prime-Power Evaluation `ppow_ok_eq_quad_conv` (Hensel + Quadratic Reciprocity)
--    and Global Identity `qf_rep_count d n = 2 * quad_conv_int d n`
-- ====================================================================================

+ sernau.ok_roots_hensel_eq (d p k : ℕ) (hd_pr : is_prime_nat d) (hd8 : d % 8 = 7)
    (hp : is_prime_nat p) (hpd : p ≠ d) (hk1 : 1 ≤ k) :
    sernau.ok_roots d (p ^ k) = sernau.ok_roots d p
  have hp2 : 2 ≤ p := hp.1; have hd2 : 2 ≤ d := hd_pr.1
  have h4cd : 4 * ((d + 1) / 4) = d + 1
    have h := div_add_mod.nat d 8
    have hm : (d + 1) % 4 = 0 := (div_mod_unique.nat (d + 1) 4 (2 * (d / 8) + 2) 0 (by omega) (by decide)).2.symm
    have h2 := div_add_mod.nat (d + 1) 4; omega
  have hok_id : ∀ t : ℕ, 4 * sernau.ok_poly d t = (2 * t + 1) * (2 * t + 1) + d := by intro t; unfold sernau.ok_poly; linear_combination h4cd
  have hzero_fn : ∀ (N : ℕ) (f : ℕ → ℕ), (∀ u < N, f u = 0) → (∑ u < N, f u) = 0 := by intro N f; induction N with _ u ihu hall; (rw [sum_below_zero]); (rw [succ_eq_add_one.nat, sum_below_succ, ihu (by intro j hj; exact hall j (by omega)), hall u (by omega)]; omega)
  have hsingle : ∀ (N a : ℕ) (f : ℕ → ℕ), a < N → (∀ u < N, u ≠ a → f u = 0) → (∑ u < N, f u) = f a
    intro N a f; induction N with _ _ u ihu ha hall; omega; rw [succ_eq_add_one.nat] at ha hall ⊢; rw [sum_below_succ]
    by_cases hlt : a < u; (rw [ihu hlt (by intro j hj hne; exact hall j (by omega) hne), hall u (by omega) (by omega)]; omega)
    have he0 : u = a := (by omega); rw [he0, hzero_fn a f (by intro j hj; exact hall j (by omega) (by omega))]; omega
  have hnd_pd : ¬ (p ∣ d) := by intro h; obtain h1 | h2 := sernau.m81a_dvd_cases d p hd_pr (by omega) h; omega; exact hpd h2
  have hhensel : ∀ m : ℕ, 1 ≤ m → sernau.ok_roots d (p ^ (m + 1)) = sernau.ok_roots d (p ^ m)
    intro m hm1
    set P := p ^ m with hP_def
    have hP_pos : 0 < P := by rw [hP_def]; exact pow_pos.nat p m (by omega)
    have hp_dvd_P : p ∣ P := by rw [hP_def]; set mm1 := m - 1; have hm_sp : m = mm1 + 1 := (by omega); exact (dvd.iff_exists p (p ^ m) (by omega)).mpr ⟨p ^ mm1, by rw [hm_sp, pow_succ.nat]; ring⟩
    obtain ⟨qP, hqP⟩ := (dvd.iff_exists p P (by omega)).mp hp_dvd_P
    have hpk1 : p ^ (m + 1) = P * p := by rw [pow_succ.nat, ← hP_def]
    unfold sernau.ok_roots; rw [hpk1]
    have hrow_t : ∀ t < P * p, (if sernau.ok_poly d t % (P * p) = 0 then 1 else 0) =
        ∑ t0 < P, ∑ s < p, if t = P * s + t0 ∧ sernau.ok_poly d (P * s + t0) % (P * p) = 0 then 1 else 0
      intro t ht
      have hdm := div_add_mod.nat t P; have ht0_lt := mod_lt.nat t P hP_pos
      have hs_lt : t / P < p := by by_contra hge; have hm := mul_le_mul_of_nonneg_left.nat p (t / P) P (by omega) (by omega); omega
      symm
      rw [hsingle P (t % P) (fun t0 => ∑ s < p, if t = P * s + t0 ∧ sernau.ok_poly d (P * s + t0) % (P * p) = 0 then (1 : ℕ) else 0) ht0_lt (by intro t0 ht0 hne; apply hzero_fn; intro s _; exact if_neg (by intro hr; have hmd := (div_mod_unique.nat t P s t0 hr.1 ht0).2; exact hne hmd))]
      rw [hsingle p (t / P) (fun s => if t = P * s + t % P ∧ sernau.ok_poly d (P * s + t % P) % (P * p) = 0 then (1 : ℕ) else 0) hs_lt (by intro s _ hne; exact if_neg (by intro hr; have hdv := (div_mod_unique.nat t P s (t % P) hr.1 ht0_lt).1; exact hne hdv))]
      by_cases hok : sernau.ok_poly d t % (P * p) = 0
      · have hp_hok : t = P * (t / P) + t % P ∧ sernau.ok_poly d (P * (t / P) + t % P) % (P * p) = 0 := ⟨hdm.symm, by rw [hdm]; exact hok⟩
        rw [if_pos hp_hok, if_pos hok]
      · have hn_hok : ¬ (t = P * (t / P) + t % P ∧ sernau.ok_poly d (P * (t / P) + t % P) % (P * p) = 0) := by intro hr; rw [← hdm] at hok; exact hok hr.2
        rw [if_neg hn_hok, if_neg hok]
    have hcol_t0 : ∀ t0 < P, (∑ s < p, ∑ t < P * p, if t = P * s + t0 ∧ sernau.ok_poly d (P * s + t0) % (P * p) = 0 then 1 else 0) =
        if sernau.ok_poly d t0 % P = 0 then 1 else 0
      intro t0 ht0
      have heval_s : ∀ s < p, (∑ t < P * p, if t = P * s + t0 ∧ sernau.ok_poly d (P * s + t0) % (P * p) = 0 then 1 else 0) =
          if sernau.ok_poly d (P * s + t0) % (P * p) = 0 then 1 else 0
        intro s hs
        have hlt_Pp : P * s + t0 < P * p := by have hm := mul_le_mul_of_nonneg_left.nat (s + 1) p P (by omega) (by omega); have hr : P * (s + 1) = P * s + P := (by ring); omega
        rw [hsingle (P * p) (P * s + t0) (fun t => if t = P * s + t0 ∧ sernau.ok_poly d (P * s + t0) % (P * p) = 0 then (1 : ℕ) else 0) hlt_Pp (by intro t _ hne; exact if_neg (by intro hr; exact hne hr.1))]
        by_cases hc : sernau.ok_poly d (P * s + t0) % (P * p) = 0
        · have hp_hc : P * s + t0 = P * s + t0 ∧ sernau.ok_poly d (P * s + t0) % (P * p) = 0 := ⟨by rfl, hc⟩
          rw [if_pos hp_hc, if_pos hc]
        · have hn_hc : ¬ (P * s + t0 = P * s + t0 ∧ sernau.ok_poly d (P * s + t0) % (P * p) = 0) := by intro hr; exact hc hr.2
          rw [if_neg hn_hc, if_neg hc]
      rw [sum_congr.nat _ _ p heval_s]
      have hpoly_s : ∀ s : ℕ, sernau.ok_poly d (P * s + t0) = sernau.ok_poly d t0 + P * (s * (2 * t0 + 1) + P * s * s) := by intro s; unfold sernau.ok_poly; ring
      by_cases hmodP : sernau.ok_poly d t0 % P = 0
      · rw [if_pos hmodP]
        obtain ⟨q0, hq0⟩ := (dvd.iff_exists P (sernau.ok_poly d t0) hP_pos).mp hmodP
        have hnd_u : ¬ (p ∣ (2 * t0 + 1))
          intro hpu
          by_cases hp_eq2 : p = 2
          · rw [hp_eq2] at hpu; unfold dvd at hpu; have hm := add_mul_mod.nat 1 t0 2; simp at hm; rw [add_comm.nat (2 * t0) 1] at hpu; omega
          · obtain ⟨qu, hqu⟩ := (dvd.iff_exists p (2 * t0 + 1) (by omega)).mp hpu
            have hp_ok : p ∣ (4 * sernau.ok_poly d t0) := (dvd.iff_exists p (4 * sernau.ok_poly d t0) (by omega)).mpr ⟨4 * qP * q0, by rw [hq0, hqP]; ring⟩
            rw [hok_id t0, hqu] at hp_ok
            obtain ⟨qd, hqd⟩ := (dvd.iff_exists p ((p * qu) * (p * qu) + d) (by omega)).mp hp_ok
            have hr2 : p * (p * qu * qu) = (p * qu) * (p * qu) := by ring
            have hle_qu : p * qu * qu ≤ qd
              by_contra hgt; have hm := mul_le_mul_of_nonneg_left.nat (qd + 1) (p * qu * qu) p (by omega) (by omega)
              have hr : p * (qd + 1) = p * qd + p := (by ring); rw [hr, hr2] at hm; omega
            exact hnd_pd ((dvd.iff_exists p d (by omega)).mpr ⟨qd - p * qu * qu, by have hm : p * (p * qu * qu + (qd - p * qu * qu)) = p * (p * qu * qu) + p * (qd - p * qu * qu) := (by ring); have hs : p * qu * qu + (qd - p * qu * qu) = qd := (by omega); rw [hs, hr2] at hm; omega⟩)
        have hp1_eq : p ^ 1 = p := by have e1 : (1 : ℕ) = 0 + 1 := (by rfl); rw [e1, pow_succ.nat, pow_zero.nat]; ring
        obtain ⟨uz, vz, huv⟩ := sernau.coprime_ppow_bezout p 1 (2 * t0 + 1) hp (by omega) hnd_u
        rw [hp1_eq] at huv
        have hiff_s : ∀ s : ℕ, sernau.ok_poly d (P * s + t0) % (P * p) = 0 ↔ (q0 + s * (2 * t0 + 1)) % p = 0
          intro s; rw [hpoly_s s, hq0]
          have hfac : P * q0 + P * (s * (2 * t0 + 1) + P * s * s) = P * (q0 + s * (2 * t0 + 1)) + (P * p) * (qP * s * s) := by rw [hqP]; ring
          rw [hfac, add_mul_mod.nat]
          constructor
          · intro hmPp; obtain ⟨qs, hqs⟩ := (dvd.iff_exists (P * p) (P * (q0 + s * (2 * t0 + 1))) (mul_pos.nat P p hP_pos (by omega))).mp hmPp
            have hcan : q0 + s * (2 * t0 + 1) = p * qs
              apply (cast_inj.int (q0 + s * (2 * t0 + 1)) (p * qs)).mp
              have hz : (P : ℤ) * (((q0 + s * (2 * t0 + 1) : ℕ) : ℤ) - ((p * qs : ℕ) : ℤ)) = 0
                have hc : ((P * (q0 + s * (2 * t0 + 1)) : ℕ) : ℤ) = (((P * p) * qs : ℕ) : ℤ) := by rw [hqs]
                simp [cast_mul.int] at hc ⊢; linear_combination hc
              have hPz : (1 : ℤ) ≤ (P : ℤ) := (cast_le.int 1 P).mpr (by omega)
              set df_s := ((q0 + s * (2 * t0 + 1) : ℕ) : ℤ) - ((p * qs : ℕ) : ℤ)
              by_contra hne; by_cases hp_d : 1 ≤ df_s; (have hm := mul_le_mul_of_nonneg_left.int 1 df_s (P : ℤ) hp_d (by omega); omega); (have hm := mul_le_mul_of_nonneg_left.int df_s (-1) (P : ℤ) (by omega) (by omega); omega)
            exact (div_mod_unique.nat (q0 + s * (2 * t0 + 1)) p qs 0 (by omega) (by omega)).2.symm
          · intro hmp; obtain ⟨qs, hqs⟩ := (dvd.iff_exists p (q0 + s * (2 * t0 + 1)) (by omega)).mp hmp
            exact (div_mod_unique.nat (P * (q0 + s * (2 * t0 + 1))) (P * p) qs 0 (by rw [hqs]; ring) (mul_pos.nat P p hP_pos (by omega))).2.symm
        set z0 : ℤ := -(q0 : ℤ) * vz with hz0_def
        set abs_z := nat_of_int (if 0 ≤ z0 then z0 else -z0) with habsz_def
        have habsz_ge : -(abs_z : ℤ) ≤ z0 := by by_cases h0 : 0 ≤ z0; (have he : (abs_z : ℤ) = z0 := (by rw [habsz_def, if_pos h0]; exact int_of_nat_of_int _ h0); omega); (have he : (abs_z : ℤ) = -z0 := (by rw [habsz_def, if_neg h0]; exact int_of_nat_of_int _ (by omega)); omega)
        set sh := nat_of_int (z0 + (p : ℤ) * ((abs_z + 1 : ℕ) : ℤ)) with hsh_def
        have hsh_nn : 0 ≤ z0 + (p : ℤ) * ((abs_z + 1 : ℕ) : ℤ) := by have hp1_z : (1 : ℤ) ≤ (p : ℤ) := (cast_le.int 1 p).mpr (by omega); have hm := mul_le_mul_of_nonneg_right.int 1 (p : ℤ) ((abs_z + 1 : ℕ) : ℤ) hp1_z (cast_nonneg.int _); rw [cast_add.int, cast_one.int] at hm ⊢; omega
        have hsh_eq : (sh : ℤ) = z0 + (p : ℤ) * ((abs_z + 1 : ℕ) : ℤ) := by rw [hsh_def]; exact int_of_nat_of_int _ hsh_nn
        set s0 := sh % p with hs0_def; set qs0 := sh / p with hqs0_def
        have hd_sh := div_add_mod.nat sh p; have hs0_lt := mod_lt.nat sh p (by omega)
        rw [← hs0_def, ← hqs0_def] at hd_sh; rw [← hs0_def] at hs0_lt
        have hsh_z : (sh : ℤ) = (p : ℤ) * (qs0 : ℤ) + (s0 : ℤ) := by have hc : (sh : ℤ) = ((p * qs0 + s0 : ℕ) : ℤ) := (by rw [hd_sh]); rw [cast_add.int, cast_mul.int] at hc; exact hc
        have hs0_sol : (q0 + s0 * (2 * t0 + 1)) % p = 0
          set kw_z := (q0 : ℤ) * uz + ((2 * t0 + 1 : ℕ) : ℤ) * (((abs_z + 1 : ℕ) : ℤ) - (qs0 : ℤ)) with hkw_def
          have hz_sol : ((q0 + s0 * (2 * t0 + 1) : ℕ) : ℤ) = (p : ℤ) * kw_z
            rw [cast_add.int, cast_mul.int, hkw_def]
            linear_combination -(q0 : ℤ) * huv + ((2 * t0 + 1 : ℕ) : ℤ) * (hsh_eq - hsh_z + hz0_def)
          have hkw_nn : 0 ≤ kw_z := by by_contra hn; have hm := mul_le_mul_of_nonneg_left.int kw_z (-1) (p : ℤ) (by omega) (cast_nonneg.int p); have hp1_z : (1 : ℤ) ≤ (p : ℤ) := (cast_le.int 1 p).mpr (by omega); have hnn := cast_nonneg.int (q0 + s0 * (2 * t0 + 1)); omega
          set kw := nat_of_int kw_z with hkw_n; have hkw_eq : (kw : ℤ) = kw_z := by rw [hkw_n]; exact int_of_nat_of_int _ hkw_nn
          have hnat_sol : q0 + s0 * (2 * t0 + 1) = p * kw := (cast_inj.int _ (p * kw)).mp (by rw [cast_mul.int, hkw_eq]; exact hz_sol)
          exact (div_mod_unique.nat (q0 + s0 * (2 * t0 + 1)) p kw 0 (by omega) (by omega)).2.symm
        have hun_s : ∀ s < p, (q0 + s * (2 * t0 + 1)) % p = 0 → s = s0
          intro s hs hms
          obtain ⟨k1, hk1_eq⟩ := (dvd.iff_exists p (q0 + s * (2 * t0 + 1)) (by omega)).mp hms
          obtain ⟨k2, hk2_eq⟩ := (dvd.iff_exists p (q0 + s0 * (2 * t0 + 1)) (by omega)).mp hs0_sol
          have hz_diff : (s : ℤ) - (s0 : ℤ) = (p : ℤ) * (((s : ℤ) - (s0 : ℤ)) * uz + ((k1 : ℤ) - (k2 : ℤ)) * vz)
            have hc1 : ((q0 + s * (2 * t0 + 1) : ℕ) : ℤ) = ((p * k1 : ℕ) : ℤ) := by rw [hk1_eq]
            have hc2 : ((q0 + s0 * (2 * t0 + 1) : ℕ) : ℤ) = ((p * k2 : ℕ) : ℤ) := by rw [hk2_eq]
            rw [cast_add.int, cast_mul.int, cast_mul.int] at hc1 hc2
            linear_combination -((s : ℤ) - (s0 : ℤ)) * huv + vz * (hc1 - hc2)
          set dw := ((s : ℤ) - (s0 : ℤ)) * uz + ((k1 : ℤ) - (k2 : ℤ)) * vz
          have hdw0 : dw = 0
            have hs_lo := cast_nonneg.int s; have hs_hi : (s : ℤ) < (p : ℤ) := (cast_lt.int s p).mpr hs
            have hs0_lo := cast_nonneg.int s0; have hs0_hi : (s0 : ℤ) < (p : ℤ) := (cast_lt.int s0 p).mpr hs0_lt
            by_contra hne; by_cases hp_d : 1 ≤ dw; (have hm := mul_le_mul_of_nonneg_left.int 1 dw (p : ℤ) hp_d (cast_nonneg.int p); omega); (have hm := mul_le_mul_of_nonneg_left.int dw (-1) (p : ℤ) (by omega) (cast_nonneg.int p); omega)
          rw [hdw0] at hz_diff; exact (cast_inj.int s s0).mp (by omega)
        rw [hsingle p s0 (fun s => if sernau.ok_poly d (P * s + t0) % (P * p) = 0 then (1 : ℕ) else 0) hs0_lt (by intro s hs hne; exact if_neg (by intro hc; exact hne (hun_s s hs ((hiff_s s).mp hc)))), if_pos ((hiff_s s0).mpr hs0_sol)]
      · rw [if_neg hmodP]; apply hzero_fn; intro s _
        exact if_neg (by intro hc; obtain ⟨qs, hqs⟩ := (dvd.iff_exists (P * p) (sernau.ok_poly d (P * s + t0)) (mul_pos.nat P p hP_pos (by omega))).mp hc; rw [hpoly_s s] at hqs; apply hmodP; have hmd_eq : (sernau.ok_poly d t0 + P * (s * (2 * t0 + 1) + P * s * s)) % P = sernau.ok_poly d t0 % P := add_mul_mod.nat _ _ P; have hmd0 : ((P * p) * qs) % P = 0 := (div_mod_unique.nat ((P * p) * qs) P (p * qs) 0 (by ring) hP_pos).2.symm; rw [hqs, hmd0] at hmd_eq; exact hmd_eq.symm)
    rw [sum_congr.nat _ _ (P * p) hrow_t, sum_swap.nat]
    have hsw2 : (∑ t0 < P, ∑ t < P * p, ∑ s < p, if t = P * s + t0 ∧ sernau.ok_poly d (P * s + t0) % (P * p) = 0 then 1 else 0) =
        ∑ t0 < P, ∑ s < p, ∑ t < P * p, if t = P * s + t0 ∧ sernau.ok_poly d (P * s + t0) % (P * p) = 0 then 1 else 0 :=
      sum_congr.nat _ _ P (by intro t0 _; exact sum_swap.nat _ (P * p) p)
    rw [hsw2, sum_congr.nat _ _ P hcol_t0]
  induction k with _ j ihj hk1; omega
  rw [succ_eq_add_one.nat] at hk1 ⊢
  by_cases hj0 : j = 0
  · rw [hj0]; have hp1 : p ^ (0 + 1) = p := (by rw [pow_succ.nat, pow_zero.nat]; ring); rw [hp1]
  · rw [hhensel j (by omega), ihj (by omega)]
