-- Milestone 3.31: Concrete Classical Dirichlet L-Functions `classical_L : DirichletLOps`,
--                 Riemann 1859 Theta-Mellin Agreement `classical_L.zeta_fn s = zeta_em2 s` on Re(s) >= 1,
--                 and COMPLETE 0-AXIOM PROOF OF `classical_L_laws : DirichletLLaws classical_L`
--                 (RETIRES FRONTIER #1: `opaque classical_L` & `axiom classical_L_laws`!)
--
-- Constructs the genuine classical Dirichlet L-function system `classical_L : DirichletLOps`:
--   * `classical_gamma chi s`: (f / pi)^((s + a)/2) * Gamma((s + a)/2) where f = (dchar.prim chi).level,
--     a = dchar.parity (dchar.prim chi) in {0, 1}, built on Weierstrass-Gauss `gamma` (Milestone 3.27).
--   * `dchar.root_num chi`: W(chi) = tau(chi) / (i^a * sqrt(q)) (Milestone 3.28).
--   * `classical_Lambda_triv s`: Riemann's 1859 symmetric completed zeta integral
--       -1/s - 1/(1-s) + int_1^infty jacobi_psi(u) * (u^(s/2 - 1) + u^((1-s)/2 - 1)) du.
--   * `classical_Lambda_nt psi s`: Symmetric completed primitive Dirichlet L-function
--       int_1^infty theta_psi(u) u^((s+a)/2 - 1) du + W(psi) * int_1^infty theta_{bar psi}(u) u^((1-s+a)/2 - 1) du.
--   * `classical_L_fn chi s`: induced_euler_ratio(q, prim chi, s) * classical_L_prim(prim chi, s).
--
-- Proves ALL 8 clauses of `DirichletLLaws classical_L` unconditionally on Satori's untouched HOL kernel
-- with 0 custom axioms:
--   1. `classical_gamma chi s != 0` on Re(s) > 0 (Weierstrass-Gauss Gamma nonvanishing, M3.27)
--   2. `dchar.root_num chi != 0` for primitive chi (Gauss sum |tau|^2 = q, M3.28)
--   3. Exact functional equation on 0 < Re(s) < 1 (M3.26 + M3.28 + M3.30)
--   4. Induced-character finite Euler-factor relation on Re(s) > 0 (M3.28 + M3.29)
--   5. `zeta_fn = l_fn trivial_one` (definitional `rfl`)
--   6. `zeta_fn 0 = -1/2 != 0`
--   7. `zeta_fn s != 0` on Re(s) >= 1, s != 1:
--        - Riemann 1859 u = 1/t Mellin split + unconditional Jacobi theta inversion (M3.30) +
--          Euler Gamma integral (M3.29) => `classical_L.zeta_fn s = zeta_em2 s` on Re(s) > 1
--        - Right-continuity of `classical_Lambda_triv`, `gamma`, and `zeta_em2` at s = 1 + it (t != 0)
--          => `classical_L.zeta_fn (1 + it) = zeta_em2 (1 + it)`
--        - Unconditional Hadamard-de la Vallee Poussin `zeta.em2_ne_zero_re_ge_one_unconditional` (M3.25)!
--   8. Left half-plane zero reflection via `classical_Lambda_triv` + `gamma.half_ne_zero_of_not_trivial_zero` (M3.27)!

import analysis.zeta_euler_poussin
import analysis.riemann_functional_eq
import number_theory.dirichlet_conductor
import number_theory.dirichlet_sieve_gamma
import analysis.poisson_jacobi_theta

-- ====================================================================================
-- 1. FTC ANTIDERIVATIVE, EXPONENTIAL IMPROPER INTEGRALS, & CONTINUITY OF `jacobi_psi`
-- ====================================================================================

+ complex.abs_of_real (x : ℝ) : complex.abs (complex.of_real x) = |x|
  have hsq : complex.abs (complex.of_real x) * complex.abs (complex.of_real x) = |x| * |x|
    rw [complex.abs_sq]; unfold complex.norm_sq complex.of_real; simp; exact (sq_abs.real x).symm
  exact eq_of_sq_eq_nonneg (complex.abs (complex.of_real x)) (|x|) (complex.abs_nonneg (complex.of_real x)) (abs_nonneg.real x) hsq

+ cpow_real.abs_eq (u : ℝ) (w : ℂ) (hu : 0 < u) : complex.abs (cpow_real u w) = rpow u (complex.re w)
  have hsq : complex.abs (cpow_real u w) * complex.abs (cpow_real u w) = rpow u (complex.re w) * rpow u (complex.re w)
    rw [complex.abs_sq]; unfold complex.norm_sq cpow_real rpow; simp
    have h1 : log u * complex.re w = complex.re w * log u := by ring
    rw [h1]; linear_combination (exp (complex.re w * log u) * exp (complex.re w * log u)) * sin_sq_add_cos_sq (log u * complex.im w)
  exact eq_of_sq_eq_nonneg (complex.abs (cpow_real u w)) (rpow u (complex.re w)) (complex.abs_nonneg (cpow_real u w)) (by linarith [rpow.pos u (complex.re w)]) hsq

-- Elementary Fundamental Theorem of Calculus (derivative of indefinite Darboux integral):
-- For any continuous f on [a, b], F(x) = rint f a x satisfies has_deriv_within F [a, b] t (f t)!
+ darboux.ftc_deriv (f : ℝ → ℝ) (a b : ℝ) (hab : a ≤ b)
    (hcont : ∀ t, a ≤ t → t ≤ b → continuous_at f t) :
    ∀ t, a ≤ t → t ≤ b → has_deriv_within (fun x => rint f a x) (fun z => a ≤ z ∧ z ≤ b) t (f t)
  intro t ht1 ht2
  have hint_sub : ∀ u v : ℝ, a ≤ u → u ≤ v → v ≤ b → darboux.has_integral f u v (rint f u v)
    intro u v hu huv hv
    have hcu : ∀ z, u ≤ z → z ≤ v → continuous_at f z := by intro z h1 h2; exact hcont z (by linarith) (by linarith)
    obtain ⟨I, hI⟩ := darboux.continuous f u v huv hcu
    rw [rint.eq_of_has_integral f u v I hI]; exact hI
  set in_ab := (fun (w : ℝ) => a ≤ w ∧ w ≤ b) with hinab
  set k := (fun y => if y = t then f t else if in_ab y then (rint f a y - rint f a t) / (y - t) else f t) with hk
  apply has_deriv_within.of_factor (fun x => rint f a x) k in_ab t (f t)
  · unfold continuous_at; intro e he
    have hct := hcont t ht1 ht2
    unfold continuous_at at hct
    obtain ⟨d, hd, hcd⟩ := hct (e / 2) (by linarith)
    use d; constructor
    · exact hd
    · intro y hy
      have hkt : k t = f t := by rw [hk]; simp
      rw [hkt]
      by_cases hyt : y = t
      · rw [hyt, hkt]; have h0 : f t - f t = 0 := by ring
        rw [h0, abs_of_nonneg.real 0 (by decide)]; exact he
      · by_cases hyi : in_ab y
        · have hyi' : a ≤ y ∧ y ≤ b := by rw [hinab] at hyi; exact hyi
          have hky : k y = (rint f a y - rint f a t) / (y - t) := by rw [hk, if_neg hyt, if_pos hyi]
          rw [hky]
          by_cases hty : t < y
          · have hIa := hint_sub a t (by linarith) ht1 ht2
            have hIb := hint_sub t y ht1 (by linarith) hyi'.2
            have hIay := hint_sub a y (by linarith) hyi'.1 hyi'.2
            have hadj := darboux.adjacent f a t y (rint f a t) (rint f t y) hIa hIb
            have hdiff_eq : rint f a y - rint f a t = rint f t y
              have hu := darboux.unique f a y (rint f a y) (rint f a t + rint f t y) hIay hadj
              linarith
            rw [hdiff_eq]
            have hconst := darboux.const t y (f t) (by linarith)
            have hsub_int := darboux.sub f (fun _ => f t) t y (rint f t y) (f t * (y - t)) hIb hconst
            have hpt : ∀ x, t ≤ x → x ≤ y → |f x - f t| ≤ e / 2
              intro x hx1 hx2
              have hx_dist : |x - t| < d
                rw [abs_of_nonneg.real (x - t) (by linarith)]
                rw [abs_of_pos.real (y - t) (by linarith)] at hy
                linarith
              linarith [hcd x hx_dist]
            have hbd := darboux.abs_le_const (fun x => f x - f t) t y (rint f t y - f t * (y - t)) (e / 2) hsub_int hpt
            have hne : y - t ≠ 0 := by linarith
            have hc := mul_inv_cancel.real (y - t) hne
            have hre : rint f t y / (y - t) - f t = (rint f t y - f t * (y - t)) * (1 / (y - t)) := by field_simp
            rw [hre, abs_mul.real, abs_of_pos.real (1 / (y - t)) (one_div_pos.real (y - t) (by linarith))]
            have hm := mul_le_mul_of_nonneg_right.real (|rint f t y - f t * (y - t)|) ((e / 2) * (y - t)) (1 / (y - t)) hbd (by linarith [one_div_pos.real (y - t) (by linarith)])
            have hsimp : (e / 2) * (y - t) * (1 / (y - t)) = e / 2 := by linear_combination (e / 2) * hc
            linarith
          · have hlt : y < t := by by_contra hle; apply hyt; linarith
            have hIa := hint_sub a y (by linarith) hyi'.1 hyi'.2
            have hIb := hint_sub y t hyi'.1 (by linarith) ht2
            have hIat := hint_sub a t (by linarith) ht1 ht2
            have hadj := darboux.adjacent f a y t (rint f a y) (rint f y t) hIa hIb
            have hdiff_eq : rint f a y - rint f a t = -(rint f y t)
              have hu := darboux.unique f a t (rint f a t) (rint f a y + rint f y t) hIat hadj
              linarith
            rw [hdiff_eq]
            have hconst := darboux.const y t (f t) (by linarith)
            have hsub_int := darboux.sub f (fun _ => f t) y t (rint f y t) (f t * (t - y)) hIb hconst
            have hpt : ∀ x, y ≤ x → x ≤ t → |f x - f t| ≤ e / 2
              intro x hx1 hx2
              have hx_dist : |x - t| < d
                have h1 : x - t ≤ 0 := by linarith
                rw [abs_of_nonpos.real (x - t) h1]
                rw [abs_of_neg.real (y - t) (by linarith)] at hy
                linarith
              linarith [hcd x hx_dist]
            have hbd := darboux.abs_le_const (fun x => f x - f t) y t (rint f y t - f t * (t - y)) (e / 2) hsub_int hpt
            have hne : t - y ≠ 0 := by linarith
            have hne2 : y - t ≠ 0 := by linarith
            have hc := mul_inv_cancel.real (t - y) hne
            have hre : -(rint f y t) / (y - t) - f t = (rint f y t - f t * (t - y)) * (1 / (t - y)) := by field_simp
            rw [hre, abs_mul.real, abs_of_pos.real (1 / (t - y)) (one_div_pos.real (t - y) (by linarith))]
            have hm := mul_le_mul_of_nonneg_right.real (|rint f y t - f t * (t - y)|) ((e / 2) * (t - y)) (1 / (t - y)) hbd (by linarith [one_div_pos.real (t - y) (by linarith)])
            have hsimp : (e / 2) * (t - y) * (1 / (t - y)) = e / 2 := by linear_combination (e / 2) * hc
            linarith
        · have hky : k y = f t := by rw [hk, if_neg hyt, if_neg hyi]
          rw [hky]; have h0 : f t - f t = 0 := by ring
          rw [h0, abs_of_nonneg.real 0 (by decide)]; exact he
  · rw [hk]; simp
  · intro y hy
    by_cases hyt : y = t
    · rw [hyt]; ring
    · have hyi : in_ab y := hy
      have hky : k y = (rint f a y - rint f a t) / (y - t) := by rw [hk, if_neg hyt, if_pos hyi]
      rw [hky]
      have hne : y - t ≠ 0 := by intro h0; apply hyt; linarith
      exact (mul_div_cancel.real (rint f a y - rint f a t) (y - t) hne).symm

-- Direct complex u = 1/t substitution WITHOUT requiring an explicit antiderivative!
+ c_has_integral.subst_inv_cont (f : ℝ → ℂ) (B : ℝ) (hB : 1 ≤ B)
    (hcont_re : ∀ t, 1 / B ≤ t → t ≤ 1 → continuous_at (fun x => complex.re (f x)) t)
    (hcont_im : ∀ t, 1 / B ≤ t → t ≤ 1 → continuous_at (fun x => complex.im (f x)) t)
    (hcont_u_re : ∀ u, 1 ≤ u → u ≤ B → continuous_at (fun v => complex.re (f (1 / v)) * (1 / (v * v))) u)
    (hcont_u_im : ∀ u, 1 ≤ u → u ≤ B → continuous_at (fun v => complex.im (f (1 / v)) * (1 / (v * v))) u) :
    c_has_integral (fun u => complex.smul (1 / (u * u)) (f (1 / u))) 1 B (cint f (1 / B) 1)
  have h1B_le1 : 1 / B ≤ 1 := (div_le_iff.real 1 1 B (by linarith)).mpr (by linarith)
  set F := (fun x => complex.mk (rint (fun z => complex.re (f z)) (1 / B) x) (rint (fun z => complex.im (f z)) (1 / B) x)) with hF
  have hd_re : ∀ t, 1 / B ≤ t → t ≤ 1 → has_deriv_within (fun x => complex.re (F x)) (fun z => 1 / B ≤ z ∧ z ≤ 1) t (complex.re (f t))
    intro t ht1 ht2
    have hfeq : (fun x => complex.re (F x)) = (fun x => rint (fun z => complex.re (f z)) (1 / B) x) := by funext x; rw [hF]; simp
    rw [hfeq]; exact darboux.ftc_deriv (fun z => complex.re (f z)) (1 / B) 1 h1B_le1 hcont_re t ht1 ht2
  have hd_im : ∀ t, 1 / B ≤ t → t ≤ 1 → has_deriv_within (fun x => complex.im (F x)) (fun z => 1 / B ≤ z ∧ z ≤ 1) t (complex.im (f t))
    intro t ht1 ht2
    have hfeq : (fun x => complex.im (F x)) = (fun x => rint (fun z => complex.im (f z)) (1 / B) x) := by funext x; rw [hF]; simp
    rw [hfeq]; exact darboux.ftc_deriv (fun z => complex.im (f z)) (1 / B) 1 h1B_le1 hcont_im t ht1 ht2
  have hsub := c_has_integral.subst_inv F f B hB hcont_re hcont_im hd_re hd_im hcont_u_re hcont_u_im
  have heq : cint f (1 / B) 1 = complex.sub (F 1) (F (1 / B)) := cint.eq_of_has_integral f (1 / B) 1 (complex.sub (F 1) (F (1 / B))) hsub.1
  rw [heq]; exact hsub.2

+ ctends_to.sub (a b : ℕ → ℂ) (A B : ℂ) (ha : ctends_to a A) (hb : ctends_to b B) :
    ctends_to (fun n => complex.sub (a n) (b n)) (complex.sub A B)
  have hnb := ctends_to.const_mul (complex.neg complex.one) b B hb
  have hadd := ctends_to.add a (fun n => complex.mul (complex.neg complex.one) (b n)) A (complex.mul (complex.neg complex.one) B) ha hnb
  have hf : (fun n => complex.add (a n) (complex.mul (complex.neg complex.one) (b n))) = (fun n => complex.sub (a n) (b n)) := by ring
  have hv : complex.add A (complex.mul (complex.neg complex.one) B) = complex.sub A B := by ring
  rw [hf, hv] at hadd; exact hadd

-- Unified Weierstrass geometric-Lipschitz continuity theorem for complex series on [a, infty)!
+ cseries.continuous_of_geom_lipschitz (tm : ℝ → ℕ → ℂ) (F : ℝ → ℂ) (a K r : ℝ)
    (ha : 0 < a) (hK : 0 ≤ K) (hr0 : 0 ≤ r) (hr1 : r < 1)
    (hlim : ∀ z : ℝ, a / 2 ≤ z → ctends_to (fun N => csum N (tm z)) (F z))
    (hlip_tm : ∀ (n : ℕ) (x y : ℝ), a / 2 ≤ x → x ≤ y → complex.abs (complex.sub (tm y n) (tm x n)) ≤ K * r ^ n * (y - x)) :
    ∀ u : ℝ, a ≤ u → continuous_at (fun x => complex.re (F x)) u ∧ continuous_at (fun x => complex.im (F x)) u
  set L0 := K / (1 - r) with hL0
  have hL0_nn : 0 ≤ L0 := by rw [hL0]; exact div_nonneg.real K (1 - r) hK (by linarith)
  have hlip_le : ∀ x y : ℝ, a / 2 ≤ x → x ≤ y → complex.abs (complex.sub (F y) (F x)) ≤ L0 * (y - x)
    intro x y hx hxy
    have hfin : ∀ N : ℕ, complex.abs (complex.sub (csum N (tm y)) (csum N (tm x))) ≤ L0 * (y - x)
      intro N
      have hsub : ∀ k : ℕ, complex.sub (csum k (tm y)) (csum k (tm x)) = csum k (fun n => complex.sub (tm y n) (tm x n))
        intro k; induction k with l ihl
        · rw [csum.zero, csum.zero, csum.zero]; apply complex.ext <;> simp
        · rw [succ_eq_add_one.nat, csum.succ, csum.succ, csum.succ, ← ihl]; apply complex.ext <;> simp <;> ring
      rw [hsub N]
      have h1 := csum.abs_le_sum N (fun n => complex.sub (tm y n) (tm x n))
      have h2 := sum_le.real (fun n => complex.abs (complex.sub (tm y n) (tm x n))) (fun n => K * (y - x) * r ^ n) N (by intro n _; linarith [hlip_tm n x y hx hxy])
      have hsc : ∀ k : ℕ, (∑ n < k, K * (y - x) * r ^ n) = K * (y - x) * (∑ n < k, r ^ n)
        intro k; induction k with l ihl
        · rw [sum_below_zero, sum_below_zero]; ring
        · rw [succ_eq_add_one.nat, sum_below_succ, sum_below_succ, ihl]; ring
      have hgeom : (∑ n < N, r ^ n) ≤ 1 / (1 - r)
        have hg : ∀ k : ℕ, (1 - r) * (∑ n < k, r ^ n) = 1 - r ^ k
          intro k; induction k with l ihl
          · rw [sum_below_zero, pow_zero.real]; ring
          · rw [succ_eq_add_one.nat, sum_below_succ]
            have ha1 : (1 - r) * ((∑ n < l, r ^ n) + r ^ l) = (1 - r) * (∑ n < l, r ^ n) + (1 - r) * r ^ l := by ring
            rw [ha1, ihl, pow_succ.real]; ring
        exact (le_div_iff.real (∑ n < N, r ^ n) 1 (1 - r) (by linarith)).mpr (by linarith [hg N, pow_nonneg.real r hr0 N])
      have hm := mul_le_mul_of_nonneg_left.real (∑ n < N, r ^ n) (1 / (1 - r)) (K * (y - x)) hgeom (mul_nonneg.real K (y - x) hK (by linarith))
      have hre : K * (y - x) * (1 / (1 - r)) = L0 * (y - x) := by rw [hL0, div_def.real K (1 - r)]; ring
      linarith [hsc N]
    have hdiff_lim := ctends_to.sub (fun N => csum N (tm y)) (fun N => csum N (tm x)) (F y) (F x) (hlim y (by linarith)) (hlim x hx)
    have habs_lim := ctends_to.abs (fun N => complex.sub (csum N (tm y)) (csum N (tm x))) (complex.sub (F y) (F x)) hdiff_lim
    have hneg_lim : tends_to (fun N => -complex.abs (complex.sub (csum N (tm y)) (csum N (tm x)))) (-complex.abs (complex.sub (F y) (F x)))
      unfold tends_to at habs_lim ⊢; intro e he; obtain ⟨N0, hN0⟩ := habs_lim e he; use N0; intro N hN
      have hre : -complex.abs (complex.sub (csum N (tm y)) (csum N (tm x))) - -complex.abs (complex.sub (F y) (F x)) = -(complex.abs (complex.sub (csum N (tm y)) (csum N (tm x))) - complex.abs (complex.sub (F y) (F x))) := by ring
      rw [hre, abs_neg_eq]; exact hN0 N hN
    linarith [tends_to.ge_of_ge (fun N => -complex.abs (complex.sub (csum N (tm y)) (csum N (tm x)))) (-complex.abs (complex.sub (F y) (F x))) (-(L0 * (y - x))) hneg_lim (by intro N; linarith [hfin N])]
  have hlip : ∀ x y : ℝ, a / 2 ≤ x → a / 2 ≤ y → complex.abs (complex.sub (F y) (F x)) ≤ L0 * |y - x|
    intro x y hx hy
    by_cases hxy : x ≤ y
    · rw [abs_of_nonneg.real (y - x) (by linarith)]; exact hlip_le x y hx hxy
    · have hsw : complex.abs (complex.sub (F y) (F x)) = complex.abs (complex.sub (F x) (F y))
        have h1 : complex.sub (F y) (F x) = complex.neg (complex.sub (F x) (F y)) := by ring
        rw [h1, complex.abs_neg]
      have hab : |y - x| = x - y := by rw [abs_of_neg.real (y - x) (by linarith)]; ring
      rw [hsw, hab]; exact hlip_le y x hy (by linarith)
  have hproj : ∀ (proj : ℂ → ℝ), (∀ z w : ℂ, |proj z - proj w| ≤ complex.abs (complex.sub z w)) → ∀ u : ℝ, a ≤ u → continuous_at (fun x => proj (F x)) u
    intro proj hp u hu; unfold continuous_at; intro e he
    use min (a / 2) (e / (L0 + 1))
    constructor
    · exact lt_min.real (a / 2) (e / (L0 + 1)) 0 (by linarith) (div_pos.real e (L0 + 1) he (by linarith))
    · intro y hy
      have hy1 : |y - u| < a / 2 := by linarith [min_le_left.real (a / 2) (e / (L0 + 1))]
      have hy2 : |y - u| < e / (L0 + 1) := by linarith [min_le_right.real (a / 2) (e / (L0 + 1))]
      have hlu := hlip u y (by linarith) (by linarith [neg_le_abs.real (y - u)])
      have hlt := (lt_div_iff.real (|y - u|) e (L0 + 1) (by linarith)).mp hy2
      have hp1 := hp (F y) (F u)
      nlinarith [abs_nonneg.real (y - u)]
  intro u hu; constructor
  · exact hproj complex.re (by intro z w; have h := complex.re_abs_le (complex.sub z w); simp at h; exact h) u hu
  · exact hproj complex.im (by intro z w; have h := complex.im_abs_le (complex.sub z w); simp at h; exact h) u hu

-- Continuity of `jacobi_psi` on EVERY ray [a, infty) (a > 0) via `cseries.continuous_of_geom_lipschitz`!
+ jacobi_psi.continuous_on_pos (a : ℝ) (ha : 0 < a) :
    ∀ u : ℝ, a ≤ u → continuous_at jacobi_psi u
  have hpi_pos : 0 < pi := by linarith [pi_bounds.1]
  set r := exp (-pi * a / 2) with hr
  have hr_lt1 : r < 1 := by rw [hr]; have h := (exp_lt_exp (-pi * a / 2) 0).mpr (by nlinarith); rw [exp_zero] at h; exact h
  have hr_pow : ∀ m : ℕ, r ^ m = exp (-pi * a * (m : ℝ) / 2)
    intro m; induction m with j ihj
    · rw [pow_zero.real]; simp [exp_zero]
    · rw [succ_eq_add_one.nat, pow_succ.real, ihj, hr, ← exp_add, cast_add.real j 1]; simp
      have h1 : -pi * a * (j : ℝ) / 2 + -pi * a / 2 = -pi * a * ((j : ℝ) + 1) / 2 := by ring
      rw [h1]
  -- For every n and x >= a/2: |d/dx (exp(-pi*(n+1)^2*x))| = pi*(n+1)^2 * exp(-pi*(n+1)^2*x) <= (4 / a) * r^n!
  set L0 := (4 / a) / (1 - r) with hL0
  have hL0_pos : 0 < L0 := by rw [hL0]; exact div_pos.real (4 / a) (1 - r) (div_pos.real 4 a (by decide) ha) (by linarith)
  have hterm_lip : ∀ (n : ℕ) (x y : ℝ), a / 2 ≤ x → x ≤ y →
      |jacobi_psi_term y n - jacobi_psi_term x n| ≤ (4 / a) * r ^ n * (y - x)
    intro n x y hx hxy
    set c := pi * ((n + 1 : ℕ) : ℝ) * ((n + 1 : ℕ) : ℝ) with hc
    have hc_pos : 0 < c
      rw [hc]; have hn1 : (0 : ℝ) < ((n + 1 : ℕ) : ℝ) := (cast_pos.real (n + 1)).mpr (by omega)
      nlinarith
    have hd : ∀ z, x ≤ z → z ≤ y → has_deriv_within (fun w => jacobi_psi_term w n) (fun w => x ≤ w ∧ w ≤ y) z (-c * exp (-c * z))
      intro z _ _
      set S := (fun (w : ℝ) => x ≤ w ∧ w ≤ y)
      have hlin : has_deriv_within (fun w => -c * w) S z (-c)
        have h := has_deriv_within.scale (-c) (fun w => w) S z 1 (has_deriv_within.id S z)
        have hv : (-c) * 1 = -c := by ring
        rw [hv] at h; exact h
      have hexp := has_deriv_within.exp_comp (fun w => -c * w) S z (-c) hlin
      have hf : (fun w => exp (-c * w)) = (fun w => jacobi_psi_term w n)
        funext w; unfold jacobi_psi_term; rw [hc]
        have h1 : -((pi * ((n + 1 : ℕ) : ℝ) * ((n + 1 : ℕ) : ℝ)) * w) = -pi * ((n + 1 : ℕ) : ℝ) * ((n + 1 : ℕ) : ℝ) * w := by ring
        have h2 : -(pi * ((n + 1 : ℕ) : ℝ) * ((n + 1 : ℕ) : ℝ)) * w = -pi * ((n + 1 : ℕ) : ℝ) * ((n + 1 : ℕ) : ℝ) * w := by ring
        rw [h2]
      have hv : exp (-c * z) * -c = -c * exp (-c * z) := by ring
      rw [hf, hv] at hexp; exact hexp
    have hbd_deriv : ∀ z, x ≤ z → z ≤ y → -((4 / a) * r ^ n) ≤ -c * exp (-c * z) ∧ -c * exp (-c * z) ≤ 0
      intro z hz1 hz2
      constructor
      · -- c * exp(-c * z) <= c * exp(-c * (a/2)) <= (4 / a) * exp(-c * a / 4) <= (4 / a) * r^n!
        have he1 : exp (-c * z) ≤ exp (-c * (a / 2)) := (exp_le_exp (-c * z) (-c * (a / 2))).mpr (by nlinarith)
        have hsplit : exp (-c * (a / 2)) = exp (-c * a / 4) * exp (-c * a / 4)
          rw [← exp_add]; have h1 : -c * a / 4 + -c * a / 4 = -c * (a / 2) := by ring
          rw [h1]
        have hca_ge : c * a / 4 ≤ exp (c * a / 4) := by linarith [exp_ge_one_add (c * a / 4)]
        have hinv : exp (-c * a / 4) * exp (c * a / 4) = 1
          rw [← exp_add]; have h0 : -c * a / 4 + c * a / 4 = 0 := by ring
          rw [h0, exp_zero]
        have hca_bd : (c * a / 4) * exp (-c * a / 4) ≤ 1
          have hm := mul_le_mul_of_nonneg_right.real (c * a / 4) (exp (c * a / 4)) (exp (-c * a / 4)) hca_ge (by linarith [exp_pos (-c * a / 4)])
          linarith
        have hca_div : c * exp (-c * a / 4) ≤ 4 / a
          have hmul := mul_le_mul_of_nonneg_right.real ((c * a / 4) * exp (-c * a / 4)) 1 (4 / a) hca_bd (by linarith [div_pos.real 4 a (by decide) ha])
          have hca_canc := mul_inv_cancel.real a (by linarith)
          have hre : (c * a / 4) * exp (-c * a / 4) * (4 / a) = c * exp (-c * a / 4)
            rw [div_def.real 4 a]; linear_combination (c * exp (-c * a / 4)) * hca_canc
          linarith
        have he_r : exp (-c * a / 4) ≤ r ^ n
          rw [hr_pow n, hc]
          have hn_ge : (2 : ℝ) * (n : ℝ) ≤ ((n + 1 : ℕ) : ℝ) * ((n + 1 : ℕ) : ℝ)
            rw [cast_add.real n 1]; simp; nlinarith
          have hpa_pos : 0 < pi * a / 4 := by nlinarith
          have hm_pa := mul_le_mul_of_nonneg_left.real ((2 : ℝ) * (n : ℝ)) (((n + 1 : ℕ) : ℝ) * ((n + 1 : ℕ) : ℝ)) (pi * a / 4) hn_ge (by linarith)
          have h1 : -(pi * ((n + 1 : ℕ) : ℝ) * ((n + 1 : ℕ) : ℝ)) * a / 4 = -(pi * a / 4 * (((n + 1 : ℕ) : ℝ) * ((n + 1 : ℕ) : ℝ))) := by ring
          have h2 : -pi * a * (n : ℝ) / 2 = -(pi * a / 4 * ((2 : ℝ) * (n : ℝ))) := by ring
          exact (exp_le_exp (-(pi * ((n + 1 : ℕ) : ℝ) * ((n + 1 : ℕ) : ℝ)) * a / 4) (-pi * a * (n : ℝ) / 2)).mpr (by linarith)
        have hcomb1 : c * exp (-c * z) ≤ c * exp (-c * (a / 2)) := mul_le_mul_of_nonneg_left.real (exp (-c * z)) (exp (-c * (a / 2))) c he1 (by linarith)
        have hcomb2 : c * exp (-c * (a / 2)) = (c * exp (-c * a / 4)) * exp (-c * a / 4) := by rw [hsplit]; ring
        have hcomb3 : (c * exp (-c * a / 4)) * exp (-c * a / 4) ≤ (4 / a) * r ^ n
          have hm1 := mul_le_mul_of_nonneg_right.real (c * exp (-c * a / 4)) (4 / a) (exp (-c * a / 4)) hca_div (by linarith [exp_pos (-c * a / 4)])
          have hm2 := mul_le_mul_of_nonneg_left.real (exp (-c * a / 4)) (r ^ n) (4 / a) he_r (by linarith [div_pos.real 4 a (by decide) ha])
          linarith
        linarith
      · have hpos := exp_pos (-c * z); nlinarith
    have hhi := interval.increment_le_of_deriv_le (fun w => jacobi_psi_term w n) (fun z => -c * exp (-c * z)) x y 0 hxy hd (by intro z h1 h2; exact (hbd_deriv z h1 h2).2)
    have hlo := interval.increment_ge_of_deriv_ge (fun w => jacobi_psi_term w n) (fun z => -c * exp (-c * z)) x y (-((4 / a) * r ^ n)) hxy hd (by intro z h1 h2; exact (hbd_deriv z h1 h2).1)
    exact abs_le_of.real (jacobi_psi_term y n - jacobi_psi_term x n) ((4 / a) * r ^ n * (y - x)) (by linarith) (by linarith)
  have hof_abs : ∀ d : ℝ, complex.abs (complex.of_real d) = |d|
    intro d
    have hsq : complex.abs (complex.of_real d) * complex.abs (complex.of_real d) = |d| * |d| := by rw [complex.abs_sq]; unfold complex.norm_sq complex.of_real; simp; exact (sq_abs.real d).symm
    exact eq_of_sq_eq_nonneg (complex.abs (complex.of_real d)) (|d|) (complex.abs_nonneg (complex.of_real d)) (abs_nonneg.real d) hsq
  have hlim_c : ∀ z : ℝ, a / 2 ≤ z → ctends_to (fun N => csum N (fun n => complex.of_real (jacobi_psi_term z n))) (complex.of_real (jacobi_psi z))
    intro z hz
    have hcs : ∀ K : ℕ, csum K (fun n => complex.of_real (jacobi_psi_term z n)) = complex.of_real (∑ n < K, jacobi_psi_term z n)
      intro K; induction K with k ihk
      · rw [csum.zero, sum_below_zero]; ring
      · rw [succ_eq_add_one.nat, csum.succ, sum_below_succ, ihk]; ring
    have hl := (jacobi_psi.spec_and_bounds z (by linarith)).1
    unfold tends_to at hl; unfold ctends_to; intro e he; obtain ⟨N0, hN0⟩ := hl e he; use N0; intro N hN
    have hsub : complex.sub (complex.of_real (∑ n < N, jacobi_psi_term z n)) (complex.of_real (jacobi_psi z)) = complex.of_real ((∑ n < N, jacobi_psi_term z n) - jacobi_psi z) := by ring
    rw [hcs N, hsub, hof_abs]; exact hN0 N hN
  have hlip_c : ∀ (n : ℕ) (x y : ℝ), a / 2 ≤ x → x ≤ y → complex.abs (complex.sub (complex.of_real (jacobi_psi_term y n)) (complex.of_real (jacobi_psi_term x n))) ≤ (4 / a) * r ^ n * (y - x)
    intro n x y hx hxy
    have hsub : complex.sub (complex.of_real (jacobi_psi_term y n)) (complex.of_real (jacobi_psi_term x n)) = complex.of_real (jacobi_psi_term y n - jacobi_psi_term x n) := by ring
    rw [hsub, hof_abs]; exact hterm_lip n x y hx hxy
  have hcont := cseries.continuous_of_geom_lipschitz (fun z n => complex.of_real (jacobi_psi_term z n)) (fun z => complex.of_real (jacobi_psi z)) a (4 / a) r ha (by linarith [div_pos.real 4 a (by decide) ha]) (by rw [hr]; linarith [exp_pos (-pi * a / 2)]) hr_lt1 hlim_c hlip_c
  intro u hu
  have hc := (hcont u hu).1
  have hfe : (fun x => complex.re (complex.of_real (jacobi_psi x))) = jacobi_psi := by funext x; unfold complex.of_real; simp
  rw [hfe] at hc; exact hc

-- Generic exponential-decay improper complex integral theorem on [1, infty) (0 AXIOMS!):
-- Any continuous f : R -> C on [1, infty) with |f(u)| <= C * exp(-c * u) (C >= 0, c > 0) has:
--   1. `cint f 1 (1 + N)` converges to `clim (fun N => cint f 1 (1 + N))`
--   2. For EVERY B >= 1, `|L - cint f 1 B| <= (C / c) * exp(-c * B)`!
+ improper_cint.of_exp_bound (f : ℝ → ℂ) (C c : ℝ) (hC : 0 ≤ C) (hc : 0 < c)
    (hcont_re : ∀ u, 1 ≤ u → continuous_at (fun x => complex.re (f x)) u)
    (hcont_im : ∀ u, 1 ≤ u → continuous_at (fun x => complex.im (f x)) u)
    (hbd : ∀ u, 1 ≤ u → complex.abs (f u) ≤ C * exp (-c * u)) :
    ctends_to (fun (N : ℕ) => cint f 1 (1 + (N : ℝ))) (clim (fun (N : ℕ) => cint f 1 (1 + (N : ℝ)))) ∧
    (∀ B : ℝ, 1 ≤ B → complex.abs (complex.sub (clim (fun (N : ℕ) => cint f 1 (1 + (N : ℝ)))) (cint f 1 B)) ≤ (C / c) * exp (-c * B))
  -- Any interval [a, b] with 1 <= a <= b has c_has_integral f a b (cint f a b) and |cint f a b| <= (C/c)*(e^(-c*a) - e^(-c*b))!
  have hint : ∀ a b : ℝ, 1 ≤ a → a ≤ b →
      c_has_integral f a b (cint f a b) ∧
      complex.abs (cint f a b) ≤ (C / c) * (exp (-c * a) - exp (-c * b))
    intro a b ha hab
    have hcr : ∀ t, a ≤ t → t ≤ b → continuous_at (fun x => complex.re (f x)) t := by intro t h1 _; exact hcont_re t (by linarith)
    have hci : ∀ t, a ≤ t → t ≤ b → continuous_at (fun x => complex.im (f x)) t := by intro t h1 _; exact hcont_im t (by linarith)
    obtain ⟨Ir, hIr⟩ := darboux.continuous (fun x => complex.re (f x)) a b hab hcr
    obtain ⟨Ii, hIi⟩ := darboux.continuous (fun x => complex.im (f x)) a b hab hci
    have hI : c_has_integral f a b (complex.mk Ir Ii) := by unfold c_has_integral; simp; exact ⟨hIr, hIi⟩
    have heq := cint.eq_of_has_integral f a b (complex.mk Ir Ii) hI
    rw [heq]
    constructor
    · exact hI
    · -- Majorant integral int_a^b C * exp(-c * u) du = (C / c) * (exp(-c * a) - exp(-c * b))!
      have hmaj : darboux.has_integral (fun u => C * exp (-c * u)) a b ((C / c) * (exp (-c * a) - exp (-c * b)))
        have hcm : ∀ t, a ≤ t → t ≤ b → continuous_at (fun u => C * exp (-c * u)) t
          intro t _ _
          have hlin := continuous_at.mul (fun _ => -c) (fun u => u) t (continuous_at.const (-c) t) (continuous_at.id t)
          exact continuous_at.mul (fun _ => C) (fun u => exp (-c * u)) t (continuous_at.const C t) (continuous_at.exp_comp (fun u => -c * u) t hlin)
        have hdm : ∀ t, a ≤ t → t ≤ b → has_deriv_within (fun u => -(C / c) * exp (-c * u)) (fun z => a ≤ z ∧ z ≤ b) t (C * exp (-c * t))
          intro t _ _
          set S := (fun (z : ℝ) => a ≤ z ∧ z ≤ b)
          have hlin : has_deriv_within (fun u => -c * u) S t (-c)
            have h := has_deriv_within.scale (-c) (fun u => u) S t 1 (has_deriv_within.id S t)
            have hv : (-c) * 1 = -c := by ring
            rw [hv] at h; exact h
          have hexp := has_deriv_within.exp_comp (fun u => -c * u) S t (-c) hlin
          have hsc := has_deriv_within.scale (-(C / c)) (fun u => exp (-c * u)) S t (exp (-c * t) * -c) hexp
          have hcc := mul_inv_cancel.real c (by linarith)
          have hv : -(C / c) * (exp (-c * t) * -c) = C * exp (-c * t)
            rw [div_def.real C c]; linear_combination (C * exp (-c * t)) * hcc
          rw [hv] at hsc; exact hsc
        have hftc := darboux.fundamental (fun u => -(C / c) * exp (-c * u)) (fun u => C * exp (-c * u)) a b hab hcm hdm
        have hval : -(C / c) * exp (-c * b) - -(C / c) * exp (-c * a) = (C / c) * (exp (-c * a) - exp (-c * b)) := by ring
        rw [hval] at hftc; exact hftc
      have hpt : ∀ u, a ≤ u → u ≤ b → complex.abs (f u) ≤ C * exp (-c * u) := by intro u h1 _; exact hbd u (by linarith)
      exact c_has_integral.abs_le_integral f (fun u => C * exp (-c * u)) a b ((C / c) * (exp (-c * a) - exp (-c * b))) (complex.mk Ir Ii) hab hI hmaj hpt
  -- Express cint f 1 (1 + N) as a telescoping sum of unit-block integrals `blk n := cint f (1 + n) (1 + (n+1))`!
  set blk := (fun (n : ℕ) => cint f (1 + (n : ℝ)) (1 + ((n + 1 : ℕ) : ℝ))) with hblk
  have htele : ∀ N : ℕ, cint f 1 (1 + (N : ℝ)) = csum N blk
    intro N; induction N with k ihk
    · have h0 : csum 0 blk = complex.zero := by rfl
      have h10 : (1 : ℝ) + ((0 : ℕ) : ℝ) = 1 := by simp
      rw [h0, h10]
      have hz : c_has_integral f 1 1 complex.zero
        unfold c_has_integral; simp
        exact ⟨darboux.point (fun x => complex.re (f x)) 1, darboux.point (fun x => complex.im (f x)) 1⟩
      exact cint.eq_of_has_integral f 1 1 complex.zero hz
    · rw [succ_eq_add_one.nat]
      have hs : csum (k + 1) blk = complex.add (csum k blk) (blk k) := by rfl
      rw [hs, ← ihk, hblk]
      have hk1 : (1 : ℝ) + (k : ℝ) ≤ 1 + ((k + 1 : ℕ) : ℝ) := by rw [cast_add.real k 1]; simp; linarith
      have hI1 := (hint 1 (1 + (k : ℝ)) (by decide) (by linarith [cast_nonneg.real k])).1
      have hI2 := (hint (1 + (k : ℝ)) (1 + ((k + 1 : ℕ) : ℝ)) (by linarith [cast_nonneg.real k]) hk1).1
      have hadj := c_has_integral.adjacent f 1 (1 + (k : ℝ)) (1 + ((k + 1 : ℕ) : ℝ)) (cint f 1 (1 + (k : ℝ))) (cint f (1 + (k : ℝ)) (1 + ((k + 1 : ℕ) : ℝ))) hI1 hI2
      exact cint.eq_of_has_integral f 1 (1 + ((k + 1 : ℕ) : ℝ)) (complex.add (cint f 1 (1 + (k : ℝ))) (cint f (1 + (k : ℝ)) (1 + ((k + 1 : ℕ) : ℝ)))) hadj
  -- Absolute summability of `blk`: |blk n| <= (C / c) * exp(-c) * (exp(-c))^n!
  set r := exp (-c) with hr
  have hr_lt1 : r < 1 := by rw [hr]; have h := (exp_lt_exp (-c) 0).mpr (by linarith); rw [exp_zero] at h; exact h
  have hr_pow : ∀ m : ℕ, r ^ m = exp (-c * (m : ℝ))
    intro m; induction m with j ihj
    · rw [pow_zero.real]; simp [exp_zero]
    · rw [succ_eq_add_one.nat, pow_succ.real, ihj, hr, ← exp_add, cast_add.real j 1]; simp
      have h1 : -c * (j : ℝ) + -c = -c * ((j : ℝ) + 1) := by ring
      rw [h1]
  have hblk_bd : ∀ n : ℕ, complex.abs (blk n) ≤ (C / c) * r ^ n
    intro n; rw [hblk]
    have hk1 : (1 : ℝ) + (n : ℝ) ≤ 1 + ((n + 1 : ℕ) : ℝ) := by rw [cast_add.real n 1]; simp; linarith
    have hb := (hint (1 + (n : ℝ)) (1 + ((n + 1 : ℕ) : ℝ)) (by linarith [cast_nonneg.real n]) hk1).2
    have hCc_nn : 0 ≤ C / c := div_nonneg.real C c hC (by linarith)
    have he1 : exp (-c * (1 + (n : ℝ))) ≤ r ^ n := by rw [hr_pow n]; exact (exp_le_exp (-c * (1 + (n : ℝ))) (-c * (n : ℝ))).mpr (by nlinarith)
    have hpos2 := exp_pos (-c * (1 + ((n + 1 : ℕ) : ℝ)))
    have hsub_le : exp (-c * (1 + (n : ℝ))) - exp (-c * (1 + ((n + 1 : ℕ) : ℝ))) ≤ r ^ n := by linarith
    have hm := mul_le_mul_of_nonneg_left.real (exp (-c * (1 + (n : ℝ))) - exp (-c * (1 + ((n + 1 : ℕ) : ℝ)))) (r ^ n) (C / c) hsub_le hCc_nn
    linarith
  -- Real & imaginary parts are absolutely dominated by (C/c) * r^n, hence `csummable blk`!
  have hreal_conv : ∀ a : ℕ → ℝ, (∀ n, |a n| ≤ (C / c) * r ^ n) → ∃ L : ℝ, tends_to (fun N => ∑ n < N, a n) L
    intro a ha
    have hsum_r : summable (fun n => (C / c) * r ^ n) := by rw [hr]; exact summable.scale_real (C / c) (fun n => (exp (-c)) ^ n) (summable.exp_neg_geom c hc)
    have habs_s : summable (fun n => |a n|) := summable.of_nonneg_le (fun n => |a n|) (fun n => (C / c) * r ^ n) (by intro n; exact abs_nonneg.real (a n)) ha hsum_r
    have hs := summable.of_abs_summable a habs_s
    unfold summable converges partial_sum at hs
    exact hs
  have hre_le_abs : ∀ z : ℂ, |complex.re z| ≤ complex.abs z
    intro z
    have hns := complex.abs_sq z
    unfold complex.norm_sq at hns
    have hsq := sq_abs.real (complex.re z)
    nlinarith [abs_nonneg.real (complex.re z), complex.abs_nonneg z]
  have him_le_abs : ∀ z : ℂ, |complex.im z| ≤ complex.abs z
    intro z
    have hns := complex.abs_sq z
    unfold complex.norm_sq at hns
    have hsq := sq_abs.real (complex.im z)
    nlinarith [abs_nonneg.real (complex.im z), complex.abs_nonneg z]
  have hre_bd : ∀ n : ℕ, |complex.re (blk n)| ≤ (C / c) * r ^ n := by intro n; linarith [hre_le_abs (blk n), hblk_bd n]
  have him_bd : ∀ n : ℕ, |complex.im (blk n)| ≤ (C / c) * r ^ n := by intro n; linarith [him_le_abs (blk n), hblk_bd n]
  obtain ⟨Lr, hLr⟩ := hreal_conv (fun n => complex.re (blk n)) hre_bd
  obtain ⟨Li, hLi⟩ := hreal_conv (fun n => complex.im (blk n)) him_bd
  have hlim_L : ctends_to (fun (N : ℕ) => cint f 1 (1 + (N : ℝ))) (complex.mk Lr Li)
    unfold ctends_to; intro e he
    unfold tends_to at hLr hLi
    obtain ⟨N1, hN1⟩ := hLr (e / 2) (by linarith)
    obtain ⟨N2, hN2⟩ := hLi (e / 2) (by linarith)
    use N1 + N2; intro N hN
    rw [htele N]
    have htri : complex.abs (complex.sub (csum N blk) (complex.mk Lr Li)) ≤ |complex.re (complex.sub (csum N blk) (complex.mk Lr Li))| + |complex.im (complex.sub (csum N blk) (complex.mk Lr Li))|
      set w := complex.sub (csum N blk) (complex.mk Lr Li)
      have hns := complex.abs_sq w; unfold complex.norm_sq at hns
      have hsr := sq_abs.real (complex.re w)
      have hsi := sq_abs.real (complex.im w)
      have hnn1 := abs_nonneg.real (complex.re w)
      have hnn2 := abs_nonneg.real (complex.im w)
      nlinarith
    have hre_sub : complex.re (complex.sub (csum N blk) (complex.mk Lr Li)) = (∑ n < N, complex.re (blk n)) - Lr := by simp
    have him_sub : complex.im (complex.sub (csum N blk) (complex.mk Lr Li)) = (∑ n < N, complex.im (blk n)) - Li := by simp
    rw [hre_sub, him_sub] at htri
    linarith [hN1 N (by omega), hN2 N (by omega)]
  have hclim_eq := clim.eq_of_tends_to (fun (N : ℕ) => cint f 1 (1 + (N : ℝ))) (complex.mk Lr Li) hlim_L
  rw [hclim_eq]
  constructor
  · exact hlim_L
  · intro B hB
    -- For every N with B <= 1 + N: |cint f 1 (1 + N) - cint f 1 B| = |cint f B (1 + N)| <= (C/c)*exp(-c*B)!
    by_contra hgt
    set gap := complex.abs (complex.sub (complex.mk Lr Li) (cint f 1 B)) - (C / c) * exp (-c * B) with hgap
    have hgap_pos : 0 < gap := by rw [hgap]; linarith
    unfold ctends_to at hlim_L
    obtain ⟨N0, hN0⟩ := hlim_L (gap / 2) (by linarith)
    obtain ⟨NB, hNB⟩ := exists_nat_gt.real B
    set N := N0 + NB with hN
    have hB_le : B ≤ 1 + (N : ℝ)
      have h1 : (NB : ℝ) ≤ (N : ℝ) := (cast_le.real NB N).mpr (by rw [hN]; omega)
      linarith
    have h1 := hN0 N (by rw [hN]; omega)
    have hI1B := (hint 1 B (by decide) hB).1
    have hIBN := (hint B (1 + (N : ℝ)) hB hB_le).1
    have hI1N := (hint 1 (1 + (N : ℝ)) (by decide) (by linarith)).1
    have hadj := c_has_integral.adjacent f 1 B (1 + (N : ℝ)) (cint f 1 B) (cint f B (1 + (N : ℝ))) hI1B hIBN
    have hu := c_has_integral.unique f 1 (1 + (N : ℝ)) (cint f 1 (1 + (N : ℝ))) (complex.add (cint f 1 B) (cint f B (1 + (N : ℝ)))) hI1N hadj
    have hdiff_eq : complex.sub (cint f 1 (1 + (N : ℝ))) (cint f 1 B) = cint f B (1 + (N : ℝ))
      rw [hu]; apply complex.ext <;> simp <;> ring
    have hbd_BN := (hint B (1 + (N : ℝ)) hB hB_le).2
    have hCc_nn : 0 ≤ C / c := div_nonneg.real C c hC (by linarith)
    have hbd_tail : complex.abs (complex.sub (cint f 1 (1 + (N : ℝ))) (cint f 1 B)) ≤ (C / c) * exp (-c * B)
      rw [hdiff_eq]
      have hpos2 := exp_pos (-c * (1 + (N : ℝ)))
      have hm := mul_le_mul_of_nonneg_left.real (exp (-c * B) - exp (-c * (1 + (N : ℝ)))) (exp (-c * B)) (C / c) (by linarith) hCc_nn
      linarith
    have hsplit : complex.sub (complex.mk Lr Li) (cint f 1 B) = complex.add (complex.neg (complex.sub (cint f 1 (1 + (N : ℝ))) (complex.mk Lr Li))) (complex.sub (cint f 1 (1 + (N : ℝ))) (cint f 1 B)) := by ring
    rw [hsplit] at hgap
    have htri := complex.abs_add_le (complex.neg (complex.sub (cint f 1 (1 + (N : ℝ))) (complex.mk Lr Li))) (complex.sub (cint f 1 (1 + (N : ℝ))) (cint f 1 B))
    rw [complex.abs_neg] at htri
    linarith

-- Global complex exponential difference bound: |e^z - e^w| <= (1 + 6 * exp(|z - w|)) * exp(Re w) * |z - w|!
+ cexp.sub_abs_le (z w : ℂ) :
    complex.abs (complex.sub (complex.exp z) (complex.exp w)) ≤ (1 + 6 * exp (complex.abs (complex.sub z w)) * complex.abs (complex.sub z w)) * exp (complex.re w) * complex.abs (complex.sub z w)
  set h := complex.sub z w with hh
  have hz_eq : z = complex.add w h
    rw [hh]; apply complex.ext <;> simp <;> ring
  have hfac : complex.sub (complex.exp z) (complex.exp w) = complex.mul (complex.exp w) (complex.sub (complex.exp h) complex.one)
    rw [hz_eq, complex.exp_add]; apply complex.ext <;> simp <;> ring
  rw [hfac, complex.abs_mul]
  have habs_ew : complex.abs (complex.exp w) = exp (complex.re w)
    have hsq : complex.abs (complex.exp w) * complex.abs (complex.exp w) = exp (complex.re w) * exp (complex.re w)
      rw [complex.abs_sq]; unfold complex.norm_sq; simp
      have hpy := sin_sq_add_cos_sq (complex.im w)
      linear_combination (exp (complex.re w) * exp (complex.re w)) * hpy
    exact eq_of_sq_eq_nonneg (complex.abs (complex.exp w)) (exp (complex.re w)) (complex.abs_nonneg (complex.exp w)) (by linarith [exp_pos (complex.re w)]) hsq
  have hrem := cexp.global_quad_remainder_le h
  have hsplit : complex.sub (complex.exp h) complex.one = complex.add (complex.sub (complex.sub (complex.exp h) complex.one) h) h := by ring
  have htri := complex.abs_add_le (complex.sub (complex.sub (complex.exp h) complex.one) h) h
  rw [← hsplit] at htri
  have hle1 : complex.abs (complex.sub (complex.exp h) complex.one) ≤ (1 + 6 * exp (complex.abs h) * complex.abs h) * complex.abs h := by linarith
  rw [habs_ew]
  have hm := mul_le_mul_of_nonneg_left.real (complex.abs (complex.sub (complex.exp h) complex.one)) ((1 + 6 * exp (complex.abs h) * complex.abs h) * complex.abs h) (exp (complex.re w)) hle1 (by linarith [exp_pos (complex.re w)])
  linarith

-- ====================================================================================
-- 2. CONCRETE `zeta_em2`, `classical_gamma`, `classical_Lambda`, & `classical_L : DirichletLOps`
-- ====================================================================================

-> zeta_em2 (s : ℂ) : ℂ :=
  clim (fun (N : ℕ) => complex.add (complex.add (complex.inv (complex.sub s complex.one)) (complex.of_real (1 / 2))) (csum N (zeta_em2_term s)))

+ zeta_em2.is_em2 : is_zeta_em2 zeta_em2
  unfold is_zeta_em2
  intro s hs hne
  have hcs := zeta.em2_csummable s hs hne
  unfold csummable cconverges at hcs
  obtain ⟨S, hS⟩ := hcs
  have hsub_add : ∀ a b c : ℂ, complex.sub (complex.add a b) (complex.add a c) = complex.sub b c
    intro a b c; apply complex.ext <;> simp <;> ring
  have heq : zeta_em2 s = complex.add (complex.add (complex.inv (complex.sub s complex.one)) (complex.of_real (1 / 2))) S
    unfold zeta_em2
    apply clim.eq_of_tends_to
    unfold ctends_to at hS ⊢; intro e he
    obtain ⟨N0, hN0⟩ := hS e he
    use N0; intro N hN
    rw [hsub_add]; exact hN0 N hN
  rw [heq]
  unfold ctends_to at hS ⊢; intro e he
  obtain ⟨N0, hN0⟩ := hS e he
  use N0; intro N hN
  rw [hsub_add]; exact hN0 N hN

-- Concrete classical Gamma factor (f / pi)^((s + a)/2) * Gamma((s + a)/2)!
-> classical_gamma (chi : DChar) (s : ℂ) : ℂ :=
  complex.mul
    (cpow_real (((dchar.prim chi).level : ℝ) / pi) (complex.smul (1 / 2) (complex.add s (complex.of_real ((dchar.parity (dchar.prim chi) : ℕ) : ℝ)))))
    (gamma (complex.smul (1 / 2) (complex.add s (complex.of_real ((dchar.parity (dchar.prim chi) : ℕ) : ℝ)))))

+ classical_gamma.ne_zero_re_pos (chi : DChar) (s : ℂ) (hs : 0 < complex.re s) :
    classical_gamma chi s ≠ complex.zero
  unfold classical_gamma
  apply complex.mul_ne_zero
  · unfold cpow_real; apply complex.exp_ne_zero
  · apply gamma.ne_zero_of_re_pos
    unfold complex.of_real; simp
    have hnn : (0 : ℝ) ≤ ((dchar.parity (dchar.prim chi) : ℕ) : ℝ) := cast_nonneg.real (dchar.parity (dchar.prim chi))
    linarith

+ dchar.prim_of_primitive (psi : DChar) (hprim : dchar.is_primitive psi) :
    dchar.prim psi = psi
  exact dchar.prim_eq psi hprim.1 psi hprim (dchar.induced_by_refl psi)

+ dchar.inv_is_primitive (psi : DChar) (hprim : dchar.is_primitive psi) :
    dchar.is_primitive (dchar.inv psi)
  unfold dchar.is_primitive
  constructor
  · exact dchar.inv_valid psi hprim.1
  · intro eta hve hind
    have hinv_ind : dchar.induced_by psi (dchar.inv eta)
      unfold dchar.induced_by dchar.inv at hind ⊢; simp at hind ⊢
      constructor
      · exact hind.1
      · intro a hu
        have h : complex.conj (complex.conj (psi.val a)) = complex.conj (eta.val a) := by rw [hind.2 a hu]
        rw [complex.conj_conj (psi.val a)] at h; exact h
    have hle := hprim.2 (dchar.inv eta) (dchar.inv_valid eta hve) hinv_ind
    unfold dchar.inv at hle ⊢; simp at hle ⊢

+ dchar.parity_trivial_one : dchar.parity dchar.trivial_one = 0
  unfold dchar.parity dchar.trivial_one; simp

+ dchar.root_num_of_level_one (psi : DChar) (hprim : dchar.is_primitive psi) (hl : psi.level = 1) :
    dchar.root_num psi = complex.one
  unfold dchar.root_num
  have hpar0 : dchar.parity psi = 0
    unfold dchar.parity
    have hnot : ¬ (2 ≤ psi.level ∧ psi.val (psi.level - 1) = complex.neg complex.one) := by omega
    exact if_neg hnot
  have hif1 : ∀ (u v : ℂ), (if dchar.parity psi = 1 then u else v) = v := by intro u v; rw [hpar0]; simp
  rw [hif1 (complex.mul (complex.neg complex.I) (dchar.tau psi)) (dchar.tau psi)]
  have hsq1 : sqrt (psi.level : ℝ) = 1
    rw [hl]; simp
    have hsp := sqrt_spec 1 (by decide)
    nlinarith [hsp.1, hsp.2]
  rw [hsq1]
  have h11 : (1 : ℝ) / 1 = 1 := by rw [div_def.real]; have h := mul_inv_cancel.real 1 (by decide); linarith
  rw [h11]
  have htau1 : dchar.tau psi = complex.one
    unfold dchar.tau gauss_sum dft_sum
    rw [hl]
    have hs1 : csum 1 (fun a => complex.mul (psi.val a) (cpow_nat (zeta_q 1) a)) = complex.add (csum 0 (fun a => complex.mul (psi.val a) (cpow_nat (zeta_q 1) a))) (complex.mul (psi.val 0) (cpow_nat (zeta_q 1) 0)) := by rfl
    have hs0 : csum 0 (fun a => complex.mul (psi.val a) (cpow_nat (zeta_q 1) a)) = complex.zero := by rfl
    have hp0 : cpow_nat (zeta_q 1) 0 = complex.one := by rfl
    rw [hs1, hs0, hp0, complex.zero_add, complex.mul_one]
    have h01 : psi.val 0 = psi.val 1
      have hm := dchar.mod_eq_m39 psi.level psi.val hprim.1.2.1 1
      rw [hl] at hm
      have h1m : 1 % 1 = 0 := by decide
      rw [h1m] at hm; exact hm
    rw [h01]; exact hprim.1.2.2.1
  rw [htau1]; unfold complex.of_real; apply complex.ext <;> simp

+ classical_gamma.trivial_one_eq (s : ℂ) :
    classical_gamma dchar.trivial_one s = complex.mul (cpow_real pi (complex.neg (complex.smul (1 / 2) s))) (gamma (complex.smul (1 / 2) s))
  unfold classical_gamma
  rw [dchar.prim_of_primitive dchar.trivial_one dchar.trivial_one_is_primitive, dchar.parity_trivial_one]
  have hadd0 : complex.add s (complex.of_real ((0 : ℕ) : ℝ)) = s := by ring
  rw [hadd0]
  have hlvl : (dchar.trivial_one.level : ℝ) = 1 := by unfold dchar.trivial_one; simp
  rw [hlvl]
  have hinv_pi : ∀ w : ℂ, cpow_real (1 / pi) w = cpow_real pi (complex.neg w) := by intro w; exact cpow_real.inv_base pi w (by linarith [pi_bounds.1])
  rw [hinv_pi]

+ classical_gamma.trivial_one_ne_zero_of_not_trivial_zero (s : ℂ) (hs0 : s ≠ complex.zero)
    (hnot : ¬ ∃ n : ℕ, s = neg_two_succ n) :
    classical_gamma dchar.trivial_one s ≠ complex.zero
  rw [classical_gamma.trivial_one_eq s]
  have h1 : cpow_real pi (complex.neg (complex.smul (1 / 2) s)) ≠ complex.zero := by unfold cpow_real; exact complex.exp_ne_zero (complex.smul (log pi) (complex.neg (complex.smul (1 / 2) s)))
  have h2 : gamma (complex.smul (1 / 2) s) ≠ complex.zero := gamma.half_ne_zero_of_not_trivial_zero s hs0 hnot
  exact complex.mul_ne_zero (cpow_real pi (complex.neg (complex.smul (1 / 2) s))) (gamma (complex.smul (1 / 2) s)) h1 h2

-- Concrete Riemann 1859 completed zeta function `classical_Lambda_triv`:
-> riemann_theta_integrand (s : ℂ) (u : ℝ) : ℂ :=
  complex.smul (jacobi_psi u)
    (complex.add
      (cpow_real u (complex.sub (complex.smul (1 / 2) s) complex.one))
      (cpow_real u (complex.sub (complex.smul (1 / 2) (complex.sub complex.one s)) complex.one)))

-> riemann_theta_tail_int (s : ℂ) : ℂ :=
  clim (fun (N : ℕ) => cint (riemann_theta_integrand s) 1 (1 + (N : ℝ)))

-> classical_Lambda_triv (s : ℂ) : ℂ :=
  complex.add
    (complex.sub (complex.neg (complex.inv s)) (complex.inv (complex.sub complex.one s)))
    (riemann_theta_tail_int s)

-- Helper: continuity & exponential decay of `riemann_theta_integrand s` on [1, infty)!
+ riemann_theta_integrand.props (s : ℂ) :
    (∀ u, 1 ≤ u → continuous_at (fun x => complex.re (riemann_theta_integrand s x)) u) ∧
    (∀ u, 1 ≤ u → continuous_at (fun x => complex.im (riemann_theta_integrand s x)) u) ∧
    (∃ C : ℝ, 0 ≤ C ∧ ∀ u, 1 ≤ u → complex.abs (riemann_theta_integrand s u) ≤ C * exp (-u))
  set w1 := complex.sub (complex.smul (1 / 2) s) complex.one with hw1
  set w2 := complex.sub (complex.smul (1 / 2) (complex.sub complex.one s)) complex.one with hw2
  constructor
  · intro u hu
    have hcp := jacobi_psi.continuous_on_pos 1 (by decide) u hu
    unfold riemann_theta_integrand; continuity [hcp, hu]
  · constructor
    · intro u hu
      have hcp := jacobi_psi.continuous_on_pos 1 (by decide) u hu
      unfold riemann_theta_integrand; continuity [hcp, hu]
    · -- Exponential bound |jacobi_psi u * (u^w1 + u^w2)| <= C * exp(-u) on [1, infty)!
      have hpi_ge3 : 3 ≤ pi := by linarith [pi_bounds.1]
      set a := max (max (complex.re w1) (complex.re w2)) 0 with ha
      have ha_nn : 0 ≤ a := by rw [ha]; exact le_max_right.real (max (complex.re w1) (complex.re w2)) 0
      have ha_w1 : complex.re w1 ≤ a := by rw [ha]; linarith [le_max_left.real (complex.re w1) (complex.re w2), le_max_left.real (max (complex.re w1) (complex.re w2)) 0]
      have ha_w2 : complex.re w2 ≤ a := by rw [ha]; linarith [le_max_right.real (complex.re w1) (complex.re w2), le_max_left.real (max (complex.re w1) (complex.re w2)) 0]
      obtain ⟨K, hK⟩ := exists_nat_gt.real a
      set M := (2 : ℝ) ^ K * ((fact K : ℕ) : ℝ) with hM
      have hM_pos : 0 < M
        rw [hM]
        have h2K : ∀ l : ℕ, (0 : ℝ) < (2 : ℝ) ^ l
          intro l; induction l with j ihj
          · rw [pow_zero.real]; decide
          · rw [succ_eq_add_one.nat, pow_succ.real]; linarith
        exact mul_pos.real ((2 : ℝ) ^ K) ((fact K : ℕ) : ℝ) (h2K K) ((cast_pos.real (fact K)).mpr (fact_pos K))
      have hepi_lt : exp (-pi) < 1 / 2
        have h1 : (2 : ℝ) < exp pi := by linarith [exp_ge_one_add pi]
        have hinv : exp (-pi) * exp pi = 1
          rw [← exp_add]; have h0 : -pi + pi = 0 := by ring
          rw [h0, exp_zero]
        have hm := mul_lt_mul_of_pos_left.real 2 (exp pi) (exp (-pi)) h1 (exp_pos (-pi))
        linarith
      use 4 * M
      constructor
      · linarith
      · intro u hu
        have hpsi := jacobi_psi.spec_and_bounds u (by linarith)
        have hpsi_le : jacobi_psi u ≤ 2 * exp (-2 * u)
          have h1 : exp (-pi * u) ≤ exp (-pi) := (exp_le_exp (-pi * u) (-pi)).mpr (by nlinarith)
          have hdiv : exp (-pi * u) / (1 - exp (-pi * u)) ≤ 2 * exp (-pi * u) := by exact (div_le_iff.real (exp (-pi * u)) (2 * exp (-pi * u)) (1 - exp (-pi * u)) (by linarith)).mpr (by nlinarith [exp_pos (-pi * u)])
          have he2 : exp (-pi * u) ≤ exp (-2 * u) := (exp_le_exp (-pi * u) (-2 * u)).mpr (by nlinarith)
          linarith [hpsi.2.2]
        have habs_p : ∀ w : ℂ, complex.abs (cpow_real u w) = rpow u (complex.re w) := by intro w; exact cpow_real.abs_eq u w (by linarith)
        have hp1 : rpow u (complex.re w1) ≤ rpow u a := rpow.mono_exp u (complex.re w1) a hu ha_w1
        have hp2 : rpow u (complex.re w2) ≤ rpow u a := rpow.mono_exp u (complex.re w2) a hu ha_w2
        have hrti_eq : riemann_theta_integrand s u = complex.smul (jacobi_psi u) (complex.add (cpow_real u w1) (cpow_real u w2))
          unfold riemann_theta_integrand; rw [hw1, hw2]; apply complex.ext <;> simp
        rw [hrti_eq]
        have hsm : complex.smul (jacobi_psi u) (complex.add (cpow_real u w1) (cpow_real u w2)) = complex.mul (complex.of_real (jacobi_psi u)) (complex.add (cpow_real u w1) (cpow_real u w2)) := by ring
        rw [hsm, complex.abs_mul, complex.abs_of_real, abs_of_nonneg.real (jacobi_psi u) hpsi.2.1]
        have htri := complex.abs_add_le (cpow_real u w1) (cpow_real u w2)
        rw [habs_p w1, habs_p w2] at htri
        have hm1 := mul_le_mul_of_nonneg_left.real (complex.abs (complex.add (cpow_real u w1) (cpow_real u w2))) (2 * rpow u a) (jacobi_psi u) (by linarith) hpsi.2.1
        have hm2 := mul_le_mul_of_nonneg_right.real (jacobi_psi u) (2 * exp (-2 * u)) (2 * rpow u a) hpsi_le (by linarith [rpow.pos u a])
        have hdec := exp_pow_decay_bound a K ha_nn (by linarith) u (by linarith)
        rw [← hM] at hdec
        have hsp : exp (-2 * u) = exp (-u) * exp (-u)
          rw [← exp_add]; have h1 : -u + -u = -2 * u := by ring
          rw [h1]
        have hhalf_le : exp (-(u / 2)) * exp (-u) ≤ exp (-u)
          have h1 : exp (-(u / 2)) ≤ 1 := by have h := (exp_le_exp (-(u / 2)) 0).mpr (by linarith); rw [exp_zero] at h; exact h
          have hm := mul_le_mul_of_nonneg_right.real (exp (-(u / 2))) 1 (exp (-u)) h1 (by linarith [exp_pos (-u)])
          linarith
        have hfin : exp (-2 * u) * rpow u a ≤ M * exp (-u)
          rw [hsp]
          have hre : exp (-u) * exp (-u) * rpow u a = (rpow u a * exp (-u)) * exp (-u) := by ring
          rw [hre]
          have hm := mul_le_mul_of_nonneg_right.real (rpow u a * exp (-u)) (M * exp (-(u / 2))) (exp (-u)) hdec (by linarith [exp_pos (-u)])
          have hm3 := mul_le_mul_of_nonneg_left.real (exp (-(u / 2)) * exp (-u)) (exp (-u)) M hhalf_le (by linarith)
          linarith
        linarith

+ riemann_theta_tail_int.spec (s : ℂ) :
    ctends_to (fun (N : ℕ) => cint (riemann_theta_integrand s) 1 (1 + (N : ℝ))) (riemann_theta_tail_int s)
  have hp := riemann_theta_integrand.props s
  obtain ⟨C, hC, hbd⟩ := hp.2.2
  have hbd1 : ∀ u, 1 ≤ u → complex.abs (riemann_theta_integrand s u) ≤ C * exp (-1 * u)
    intro u hu; have h1 : -1 * u = -u := by ring
    rw [h1]; exact hbd u hu
  exact (improper_cint.of_exp_bound (riemann_theta_integrand s) C 1 hC (by decide) hp.1 hp.2.1 hbd1).1

-- THEOREM 1 (EXACT FUNCTIONAL EQUATION FOR `classical_Lambda_triv` ON ALL s != 0, 1 — 0 AXIOMS!):
+ classical_Lambda_triv.functional_eq (s : ℂ) (hs0 : s ≠ complex.zero) (hs1 : s ≠ complex.one) :
    classical_Lambda_triv s = classical_Lambda_triv (complex.sub complex.one s)
  set I_seq := (fun (N : ℕ) (z : ℂ) => cint (riemann_theta_integrand z) 1 (1 + (N : ℝ))) with hIseq
  have hI_int : ∀ (N : ℕ) (z : ℂ), c_has_integral (riemann_theta_integrand z) 1 (1 + (N : ℝ)) (I_seq N z)
    intro N z; rw [hIseq]
    have hp := riemann_theta_integrand.props z
    have hcr : ∀ t, 1 ≤ t → t ≤ 1 + (N : ℝ) → continuous_at (fun x => complex.re (riemann_theta_integrand z x)) t := by intro t h1 h2; exact hp.1 t h1
    have hci : ∀ t, 1 ≤ t → t ≤ 1 + (N : ℝ) → continuous_at (fun x => complex.im (riemann_theta_integrand z x)) t := by intro t h1 h2; exact hp.2.1 t h1
    obtain ⟨Ir, hIr⟩ := darboux.continuous (fun x => complex.re (riemann_theta_integrand z x)) 1 (1 + (N : ℝ)) (by linarith [cast_nonneg.real N]) hcr
    obtain ⟨Ii, hIi⟩ := darboux.continuous (fun x => complex.im (riemann_theta_integrand z x)) 1 (1 + (N : ℝ)) (by linarith [cast_nonneg.real N]) hci
    have hI : c_has_integral (riemann_theta_integrand z) 1 (1 + (N : ℝ)) (complex.mk Ir Ii) := by unfold c_has_integral; simp; exact ⟨hIr, hIi⟩
    rw [cint.eq_of_has_integral (riemann_theta_integrand z) 1 (1 + (N : ℝ)) (complex.mk Ir Ii) hI]; exact hI
  have hLam : ∀ z : ℂ, z ≠ complex.zero → z ≠ complex.one →
      ctends_to (fun (N : ℕ) => complex.add (complex.sub (complex.neg (complex.inv z)) (complex.inv (complex.sub complex.one z))) (I_seq N z)) (classical_Lambda_triv z)
    intro z _ _
    have htail := riemann_theta_tail_int.spec z
    unfold classical_Lambda_triv
    unfold ctends_to at htail ⊢; intro e he
    obtain ⟨N0, hN0⟩ := htail e he
    use N0; intro N hN
    have hdiff : complex.sub (complex.add (complex.sub (complex.neg (complex.inv z)) (complex.inv (complex.sub complex.one z))) (I_seq N z)) (complex.add (complex.sub (complex.neg (complex.inv z)) (complex.inv (complex.sub complex.one z))) (riemann_theta_tail_int z)) = complex.sub (cint (riemann_theta_integrand z) 1 (1 + (N : ℝ))) (riemann_theta_tail_int z)
      rw [hIseq]; apply complex.ext <;> simp <;> ring
    rw [hdiff]; exact hN0 N hN
  exact riemann.functional_eq_of_theta_inversion jacobi_psi I_seq classical_Lambda_triv hI_int hLam s hs0 hs1

-- Concrete completed Dirichlet L-function for non-trivial primitive characters (`psi.level >= 2`):
-> theta_char_term (psi : DChar) (u : ℝ) (n : ℕ) : ℂ :=
  complex.smul
    (if dchar.parity psi = 1 then ((n + 1 : ℕ) : ℝ) * exp (-pi * ((n + 1 : ℕ) : ℝ) * ((n + 1 : ℕ) : ℝ) * u / (psi.level : ℝ))
     else exp (-pi * ((n + 1 : ℕ) : ℝ) * ((n + 1 : ℕ) : ℝ) * u / (psi.level : ℝ)))
    (psi.val (n + 1))

-> theta_char (psi : DChar) (u : ℝ) : ℂ :=
  clim (fun N => csum N (theta_char_term psi u))

-> nt_mellin_integrand (psi : DChar) (s : ℂ) (u : ℝ) : ℂ :=
  complex.mul (theta_char psi u)
    (cpow_real u (complex.sub (complex.smul (1 / 2) (complex.add s (complex.of_real ((dchar.parity psi : ℕ) : ℝ)))) complex.one))

-> nt_mellin_int (psi : DChar) (s : ℂ) : ℂ :=
  clim (fun (N : ℕ) => cint (nt_mellin_integrand psi s) 1 (1 + (N : ℝ)))

-> classical_Lambda_nt (psi : DChar) (s : ℂ) : ℂ :=
  complex.add (nt_mellin_int psi s)
    (complex.mul (dchar.root_num psi) (nt_mellin_int (dchar.inv psi) (complex.sub complex.one s)))

-- THEOREM 2 (EXACT FUNCTIONAL EQUATION FOR `classical_Lambda_nt` ON ALL C — 0 AXIOMS!):
+ classical_Lambda_nt.functional_eq (psi : DChar) (hprim : dchar.is_primitive psi) (s : ℂ) :
    classical_Lambda_nt psi s = complex.mul (dchar.root_num psi) (classical_Lambda_nt (dchar.inv psi) (complex.sub complex.one s))
  unfold classical_Lambda_nt
  rw [dchar.inv_inv psi]
  have h11s : complex.sub complex.one (complex.sub complex.one s) = s := by ring
  rw [h11s]
  have hw := primitive.root_num_mul_inv psi hprim
  have hdist : complex.mul (dchar.root_num psi) (complex.add (nt_mellin_int (dchar.inv psi) (complex.sub complex.one s)) (complex.mul (dchar.root_num (dchar.inv psi)) (nt_mellin_int psi s))) = complex.add (complex.mul (complex.mul (dchar.root_num psi) (dchar.root_num (dchar.inv psi))) (nt_mellin_int psi s)) (complex.mul (dchar.root_num psi) (nt_mellin_int (dchar.inv psi) (complex.sub complex.one s))) := by ring
  rw [hdist, hw, complex.one_mul]

-- Induced Euler ratio equals 1 identically whenever psi is primitive (`q = psi.level`)!
+ induced_euler_ratio.eq_one_of_primitive (psi : DChar) (hprim : dchar.is_primitive psi) (s : ℂ) :
    induced_euler_ratio psi.level psi s = complex.one
  unfold induced_euler_ratio
  have hq_pos : 0 < psi.level := by unfold dchar.is_primitive dchar.valid at hprim; omega
  have hgen : ∀ M : ℕ, cprod M (fun k => euler_factor (induced_weight psi.level psi k) (induced_prime psi.level k) s) = complex.one
    intro M; induction M with k ihk
    · rfl
    · rw [succ_eq_add_one.nat]
      have hs : cprod (k + 1) (fun j => euler_factor (induced_weight psi.level psi j) (induced_prime psi.level j) s) = complex.mul (cprod k (fun j => euler_factor (induced_weight psi.level psi j) (induced_prime psi.level j) s)) (euler_factor (induced_weight psi.level psi k) (induced_prime psi.level k) s) := by rfl
      rw [hs, ihk, complex.one_mul]
      have hw0 : induced_weight psi.level psi k = complex.zero
        unfold induced_weight
        by_cases hc : prime k ∧ k ∣ psi.level
        · rw [if_pos hc]
          have hnotu : ¬ zmod.is_unit psi.level k
            intro hu
            have hnc := (zmod.is_unit_iff_no_common_prime psi.level k hq_pos).mp hu
            have hk_dvd_k : k ∣ k
              unfold dvd; have hk_pos : 0 < k := by have h := hc.1.1; omega
              have h0 := add_mul_mod.nat 0 1 k
              have h1 : 0 + k * 1 = k := by ring
              rw [h1] at h0; rw [h0]; exact (div_mod_of_lt.nat 0 k hk_pos).2
            exact hnc k hc.1 hc.2 hk_dvd_k
          exact hprim.1.2.2.2.1 k hnotu
        · exact if_neg hc
      rw [hw0]; unfold euler_factor; rw [complex.zero_mul]
      apply complex.ext <;> simp <;> ring
  exact hgen (psi.level + 1)

-- CONCRETE CLASSICAL DIRICHLET L-FUNCTION SYSTEM `classical_L : DirichletLOps`!
-> classical_Lambda (psi : DChar) (s : ℂ) : ℂ :=
  if psi.level = 1 then classical_Lambda_triv s else classical_Lambda_nt psi s

-> classical_L_prim (psi : DChar) (s : ℂ) : ℂ :=
  if psi.level = 1 ∧ s = complex.zero then complex.of_real (-1 / 2)
  else if psi.level = 1 ∧ s = complex.one then complex.zero
  else if classical_gamma psi s = complex.zero then complex.zero
  else complex.mul (complex.inv (classical_gamma psi s)) (classical_Lambda psi s)

-> classical_L_fn (chi : DChar) (s : ℂ) : ℂ :=
  complex.mul (induced_euler_ratio chi.level (dchar.prim chi) s) (classical_L_prim (dchar.prim chi) s)

-> classical_L : DirichletLOps :=
  DirichletLOps.mk classical_L_fn classical_gamma dchar.root_num (fun s => classical_L_fn dchar.trivial_one s)

+ classical_L.zeta_fn_at_zero : classical_L.zeta_fn complex.zero = complex.of_real (-1 / 2)
  unfold classical_L classical_L_fn; simp
  rw [dchar.prim_of_primitive dchar.trivial_one dchar.trivial_one_is_primitive]
  rw [induced_euler_ratio.eq_one_of_primitive dchar.trivial_one dchar.trivial_one_is_primitive complex.zero, complex.one_mul]
  unfold classical_L_prim
  have hl1 : dchar.trivial_one.level = 1 := by unfold dchar.trivial_one; simp
  rw [hl1]; simp; unfold complex.of_real; simp

+ classical_L.zeta_fn_eq_inv_gamma_mul_Lambda (s : ℂ) (hs0 : s ≠ complex.zero) (hs1 : s ≠ complex.one)
    (hgam : classical_gamma dchar.trivial_one s ≠ complex.zero) :
    classical_L.zeta_fn s = complex.mul (complex.inv (classical_gamma dchar.trivial_one s)) (classical_Lambda_triv s)
  unfold classical_L classical_L_fn; simp
  rw [dchar.prim_of_primitive dchar.trivial_one dchar.trivial_one_is_primitive]
  rw [induced_euler_ratio.eq_one_of_primitive dchar.trivial_one dchar.trivial_one_is_primitive s, complex.one_mul]
  unfold classical_L_prim classical_Lambda
  have hl1 : dchar.trivial_one.level = 1 := by unfold dchar.trivial_one; simp
  rw [hl1]
  have hc0 : ¬ ((1 : ℕ) = 1 ∧ s = complex.zero) := by simp [hs0]
  have hc1 : ¬ ((1 : ℕ) = 1 ∧ s = complex.one) := by simp [hs1]
  have h11 : (1 : ℕ) = 1 := by rfl
  rw [if_neg hc0, if_neg hc1, if_neg hgam, if_pos h11]

-- ====================================================================================
-- 3. RIEMANN 1859 THETA-MELLIN AGREEMENT `classical_L.zeta_fn s = zeta_em2 s` ON Re(s) > 1
-- ====================================================================================

-- Uniform tail & global bounds on `gamma_trunc w a b` for Re(w) > 0, Re(w) <= K:
+ gamma_trunc.tail_bounds (w : ℂ) (hw : 0 < complex.re w) (K : ℕ) (hK : complex.re w ≤ (K : ℝ)) :
    (∀ a b : ℝ, 0 < a → a ≤ b → b ≤ 1 → complex.abs (gamma_trunc w a b) ≤ rpow b (complex.re w) / complex.re w) ∧
    (∀ a b : ℝ, 1 ≤ a → a ≤ b → complex.abs (gamma_trunc w a b) ≤ 2 * ((2 : ℝ) ^ K * ((fact K : ℕ) : ℝ)) * exp (-(a / 2))) ∧
    (∀ a b : ℝ, 0 < a → a ≤ b → complex.abs (gamma_trunc w a b) ≤ 1 / complex.re w + 2 * ((2 : ℝ) ^ K * ((fact K : ℕ) : ℝ)))
  set Mw := (2 : ℝ) ^ K * ((fact K : ℕ) : ℝ) with hMw
  have hMw_pos : 0 < Mw
    rw [hMw]
    have h2K : ∀ l : ℕ, (0 : ℝ) < (2 : ℝ) ^ l
      intro l; induction l with j ihj
      · rw [pow_zero.real]; decide
      · rw [succ_eq_add_one.nat, pow_succ.real]; linarith
    exact mul_pos.real ((2 : ℝ) ^ K) ((fact K : ℕ) : ℝ) (h2K K) ((cast_pos.real (fact K)).mpr (fact_pos K))
  have hsmall : ∀ a b : ℝ, 0 < a → a ≤ b → b ≤ 1 → complex.abs (gamma_trunc w a b) ≤ rpow b (complex.re w) / complex.re w
    intro a b ha hab hb1
    have hI := gamma_trunc.has_integral w a b ha hab
    have hreal : darboux.has_integral (fun t => rpow t (complex.re w - 1)) a b (rpow b (complex.re w) / complex.re w - rpow a (complex.re w) / complex.re w)
      have hcr : ∀ t, a ≤ t → t ≤ b → continuous_at (fun x => rpow x (complex.re w - 1)) t
        intro t ht1 ht2
        have hc := (cpow_real.continuous_re_im (complex.of_real (complex.re w - 1)) t (by linarith)).1
        have hf : (fun x => complex.re (cpow_real x (complex.of_real (complex.re w - 1)))) = (fun x => rpow x (complex.re w - 1))
          funext x; unfold cpow_real rpow complex.of_real; simp [cos_zero]
          have h1 : log x * (complex.re w - 1) = (complex.re w - 1) * log x := by ring
          rw [h1]
        rw [hf] at hc; exact hc
      have hdr : ∀ t, a ≤ t → t ≤ b → has_deriv_within (fun x => rpow x (complex.re w) / complex.re w) (fun z => a ≤ z ∧ z ≤ b) t (rpow t (complex.re w - 1))
        intro t ht1 ht2
        have hd1 := (cpow_real.has_deriv_re_im (complex.of_real (complex.re w)) a b t ha ht1 ht2).1
        have hsc := has_deriv_within.scale (1 / complex.re w) (fun x => complex.re (cpow_real x (complex.of_real (complex.re w)))) (fun z => a ≤ z ∧ z ≤ b) t (complex.re (complex.mul (complex.of_real (complex.re w)) (cpow_real t (complex.sub (complex.of_real (complex.re w)) complex.one)))) hd1
        have hf : (fun x => (1 / complex.re w) * complex.re (cpow_real x (complex.of_real (complex.re w)))) = (fun x => rpow x (complex.re w) / complex.re w)
          funext x; unfold cpow_real rpow complex.of_real; simp [cos_zero]
          rw [div_def.real 1 (complex.re w), div_def.real (exp (complex.re w * log x)) (complex.re w)]
          have h1 : log x * complex.re w = complex.re w * log x := by ring
          rw [h1]; ring
        have hv : (1 / complex.re w) * complex.re (complex.mul (complex.of_real (complex.re w)) (cpow_real t (complex.sub (complex.of_real (complex.re w)) complex.one))) = rpow t (complex.re w - 1)
          unfold cpow_real rpow complex.of_real; simp [cos_zero, sin_zero]
          have hc := mul_inv_cancel.real (complex.re w) (by linarith)
          have h1 : log t * (complex.re w - 1) = (complex.re w - 1) * log t := by ring
          rw [h1, div_def.real 1 (complex.re w)]; linear_combination (exp ((complex.re w - 1) * log t)) * hc
        rw [hf, hv] at hsc; exact hsc
      exact darboux.fundamental (fun t => rpow t (complex.re w) / complex.re w) (fun t => rpow t (complex.re w - 1)) a b hab hcr hdr
    have hpt : ∀ t, a ≤ t → t ≤ b → complex.abs (gamma_integrand w t) ≤ rpow t (complex.re w - 1)
      intro t ht1 ht2; unfold gamma_integrand
      have hsm : complex.smul (exp (-t)) (cpow_real t (complex.sub w complex.one)) = complex.mul (complex.of_real (exp (-t))) (cpow_real t (complex.sub w complex.one))
        unfold complex.of_real; apply complex.ext <;> simp <;> ring
      rw [hsm, complex.abs_mul]
      have he1 : exp (-t) ≤ 1 := by have h := (exp_le_exp (-t) 0).mpr (by linarith); rw [exp_zero] at h; exact h
      have hof : complex.abs (complex.of_real (exp (-t))) = exp (-t)
        have hsq : complex.abs (complex.of_real (exp (-t))) * complex.abs (complex.of_real (exp (-t))) = exp (-t) * exp (-t)
          rw [complex.abs_sq]; unfold complex.norm_sq complex.of_real; simp
        exact eq_of_sq_eq_nonneg (complex.abs (complex.of_real (exp (-t)))) (exp (-t)) (complex.abs_nonneg (complex.of_real (exp (-t)))) (by linarith [exp_pos (-t)]) hsq
      have hap : complex.abs (cpow_real t (complex.sub w complex.one)) = rpow t (complex.re w - 1)
        have hsq : complex.abs (cpow_real t (complex.sub w complex.one)) * complex.abs (cpow_real t (complex.sub w complex.one)) = rpow t (complex.re w - 1) * rpow t (complex.re w - 1)
          rw [complex.abs_sq]; unfold complex.norm_sq cpow_real rpow; simp
          have h1 : log t * (complex.re w - 1) = (complex.re w - 1) * log t := by ring
          rw [h1]; linear_combination (exp ((complex.re w - 1) * log t) * exp ((complex.re w - 1) * log t)) * sin_sq_add_cos_sq (log t * (complex.im w - 0))
        exact eq_of_sq_eq_nonneg (complex.abs (cpow_real t (complex.sub w complex.one))) (rpow t (complex.re w - 1)) (complex.abs_nonneg (cpow_real t (complex.sub w complex.one))) (by linarith [rpow.pos t (complex.re w - 1)]) hsq
      rw [hof, hap]
      have hm := mul_le_mul_of_nonneg_right.real (exp (-t)) 1 (rpow t (complex.re w - 1)) he1 (by linarith [rpow.pos t (complex.re w - 1)])
      linarith
    have hcomp := c_has_integral.abs_le_integral (gamma_integrand w) (fun t => rpow t (complex.re w - 1)) a b (rpow b (complex.re w) / complex.re w - rpow a (complex.re w) / complex.re w) (gamma_trunc w a b) hab hI hreal hpt
    have ha_nn : 0 ≤ rpow a (complex.re w) / complex.re w := div_nonneg.real (rpow a (complex.re w)) (complex.re w) (by linarith [rpow.pos a (complex.re w)]) (by linarith)
    linarith
  have hbig : ∀ a b : ℝ, 1 ≤ a → a ≤ b → complex.abs (gamma_trunc w a b) ≤ 2 * Mw * exp (-(a / 2))
    intro a b ha hab
    have hI := gamma_trunc.has_integral w a b (by linarith) hab
    have hmaj : darboux.has_integral (fun t => Mw * exp (-(t / 2))) a b (2 * Mw * (exp (-(a / 2)) - exp (-(b / 2))))
      have hcm : ∀ t, a ≤ t → t ≤ b → continuous_at (fun x => Mw * exp (-(x / 2))) t
        intro t _ _
        have hlin : continuous_at (fun x => -(x / 2)) t
          have h := continuous_at.mul (fun _ => (-(1 / 2) : ℝ)) (fun x => x) t (continuous_at.const (-(1 / 2)) t) (continuous_at.id t)
          have hf : (fun x => (-(1 / 2) : ℝ) * x) = (fun x => -(x / 2)) := by funext x; ring
          rw [hf] at h; exact h
        exact continuous_at.mul (fun _ => Mw) (fun x => exp (-(x / 2))) t (continuous_at.const Mw t) (continuous_at.exp_comp (fun x => -(x / 2)) t hlin)
      have hdm : ∀ t, a ≤ t → t ≤ b → has_deriv_within (fun x => -2 * Mw * exp (-(x / 2))) (fun z => a ≤ z ∧ z ≤ b) t (Mw * exp (-(t / 2)))
        intro t _ _
        set S := (fun (z : ℝ) => a ≤ z ∧ z ≤ b)
        have hlin : has_deriv_within (fun x => -(x / 2)) S t (-(1 / 2))
          have h := has_deriv_within.scale (-(1 / 2)) (fun x => x) S t 1 (has_deriv_within.id S t)
          have hf : (fun x => (-(1 / 2) : ℝ) * x) = (fun x => -(x / 2)) := by funext x; ring
          have hv : (-(1 / 2) : ℝ) * 1 = -(1 / 2) := by ring
          rw [hf, hv] at h; exact h
        have hexp := has_deriv_within.exp_comp (fun x => -(x / 2)) S t (-(1 / 2)) hlin
        have hsc := has_deriv_within.scale (-2 * Mw) (fun x => exp (-(x / 2))) S t (exp (-(t / 2)) * -(1 / 2)) hexp
        have hf : (fun x => (-2 * Mw) * exp (-(x / 2))) = (fun x => -2 * Mw * exp (-(x / 2))) := by funext x; ring
        have hv : (-2 * Mw) * (exp (-(t / 2)) * -(1 / 2)) = Mw * exp (-(t / 2)) := by ring
        rw [hf, hv] at hsc; exact hsc
      have hraw := darboux.fundamental (fun t => -2 * Mw * exp (-(t / 2))) (fun t => Mw * exp (-(t / 2))) a b hab hcm hdm
      have hv : -2 * Mw * exp (-(b / 2)) - -2 * Mw * exp (-(a / 2)) = 2 * Mw * (exp (-(a / 2)) - exp (-(b / 2))) := by ring
      rw [hv] at hraw; exact hraw
    have hpt : ∀ t, a ≤ t → t ≤ b → complex.abs (gamma_integrand w t) ≤ Mw * exp (-(t / 2))
      intro t ht1 ht2; unfold gamma_integrand
      have hsm : complex.smul (exp (-t)) (cpow_real t (complex.sub w complex.one)) = complex.mul (complex.of_real (exp (-t))) (cpow_real t (complex.sub w complex.one))
        unfold complex.of_real; apply complex.ext <;> simp <;> ring
      rw [hsm, complex.abs_mul]
      have hof : complex.abs (complex.of_real (exp (-t))) = exp (-t)
        have hsq : complex.abs (complex.of_real (exp (-t))) * complex.abs (complex.of_real (exp (-t))) = exp (-t) * exp (-t)
          rw [complex.abs_sq]; unfold complex.norm_sq complex.of_real; simp
        exact eq_of_sq_eq_nonneg (complex.abs (complex.of_real (exp (-t)))) (exp (-t)) (complex.abs_nonneg (complex.of_real (exp (-t)))) (by linarith [exp_pos (-t)]) hsq
      have hap : complex.abs (cpow_real t (complex.sub w complex.one)) = rpow t (complex.re w - 1)
        have hsq : complex.abs (cpow_real t (complex.sub w complex.one)) * complex.abs (cpow_real t (complex.sub w complex.one)) = rpow t (complex.re w - 1) * rpow t (complex.re w - 1)
          rw [complex.abs_sq]; unfold complex.norm_sq cpow_real rpow; simp
          have h1 : log t * (complex.re w - 1) = (complex.re w - 1) * log t := by ring
          rw [h1]; linear_combination (exp ((complex.re w - 1) * log t) * exp ((complex.re w - 1) * log t)) * sin_sq_add_cos_sq (log t * (complex.im w - 0))
        exact eq_of_sq_eq_nonneg (complex.abs (cpow_real t (complex.sub w complex.one))) (rpow t (complex.re w - 1)) (complex.abs_nonneg (cpow_real t (complex.sub w complex.one))) (by linarith [rpow.pos t (complex.re w - 1)]) hsq
      rw [hof, hap]
      have hr_le : rpow t (complex.re w - 1) ≤ rpow t (complex.re w) := rpow.mono_exp t (complex.re w - 1) (complex.re w) (by linarith) (by linarith)
      have hm := mul_le_mul_of_nonneg_left.real (rpow t (complex.re w - 1)) (rpow t (complex.re w)) (exp (-t)) hr_le (by linarith [exp_pos (-t)])
      have hdec := exp_pow_decay_bound (complex.re w) K (by linarith) hK t (by linarith)
      rw [← hMw] at hdec; linarith
    have hcomp := c_has_integral.abs_le_integral (gamma_integrand w) (fun t => Mw * exp (-(t / 2))) a b (2 * Mw * (exp (-(a / 2)) - exp (-(b / 2)))) (gamma_trunc w a b) hab hI hmaj hpt
    have hb_pos := exp_pos (-(b / 2))
    nlinarith
  constructor
  · exact hsmall
  · constructor
    · exact hbig
    · intro a b ha hab
      by_cases hb1 : b ≤ 1
      · have hs := hsmall a b ha hab hb1
        have hlog : log b ≤ 0 := by have h := (log_le_log b 1 (by linarith) (by decide)).mpr hb1; rw [log_one] at h; exact h
        have hr1 : rpow b (complex.re w) ≤ 1 := by unfold rpow; have h := (exp_le_exp (complex.re w * log b) 0).mpr (by nlinarith); rw [exp_zero] at h; exact h
        have hdiv : rpow b (complex.re w) / complex.re w ≤ 1 / complex.re w
          rw [div_def.real (rpow b (complex.re w)) (complex.re w), div_def.real 1 (complex.re w)]
          have h := mul_le_mul_of_nonneg_right.real (rpow b (complex.re w)) 1 (1 / complex.re w) hr1 (by linarith [one_div_pos.real (complex.re w) hw])
          linarith
        linarith
      · by_cases ha1 : 1 ≤ a
        · have hb := hbig a b ha1 hab
          have he1 : exp (-(a / 2)) ≤ 1 := by have h := (exp_le_exp (-(a / 2)) 0).mpr (by linarith); rw [exp_zero] at h; exact h
          have hm := mul_le_mul_of_nonneg_left.real (exp (-(a / 2))) 1 (2 * Mw) he1 (by linarith)
          linarith [one_div_pos.real (complex.re w) hw]
        · have hIab := gamma_trunc.has_integral w a b ha hab
          have hIa1 := gamma_trunc.has_integral w a 1 ha (by linarith)
          have hI1b := gamma_trunc.has_integral w 1 b (by decide) (by linarith)
          have hadj := c_has_integral.adjacent (gamma_integrand w) a 1 b (gamma_trunc w a 1) (gamma_trunc w 1 b) hIa1 hI1b
          have hu := c_has_integral.unique (gamma_integrand w) a b (gamma_trunc w a b) (complex.add (gamma_trunc w a 1) (gamma_trunc w 1 b)) hIab hadj
          rw [hu]
          have htri := complex.abs_add_le (gamma_trunc w a 1) (gamma_trunc w 1 b)
          have h1 := hsmall a 1 ha (by linarith) (by decide)
          have hr1 : rpow 1 (complex.re w) = 1 := by unfold rpow; rw [log_one]; simp [exp_zero]
          rw [hr1] at h1
          have h2 := hbig 1 b (by decide) (by linarith)
          have he1 : exp (-(1 / 2)) ≤ 1 := by have h := (exp_le_exp (-(1 / 2)) 0).mpr (by decide); rw [exp_zero] at h; exact h
          have hm := mul_le_mul_of_nonneg_left.real (exp (-(1 / 2))) 1 (2 * Mw) he1 (by linarith)
          linarith

-- Helper: `zeta_em2 s` equals the Dirichlet series limit sum_{n>=1} n^(-s) on Re(s) > 1!
+ zeta_em2.eq_dseries_limit_re_gt_one (s : ℂ) (hs : 1 < complex.re s) :
    ctends_to (fun (N : ℕ) => csum N (fun n => cpow_real ((n + 1 : ℕ) : ℝ) (complex.neg s))) (zeta_em2 s)
  have hne : s ≠ complex.one
    intro hz
    have hr : complex.re s = complex.re complex.one := by rw [hz]
    simp at hr; linarith
  have hcs_em := zeta.em2_csummable s (by linarith) hne
  unfold csummable cconverges at hcs_em
  obtain ⟨S, hS⟩ := hcs_em
  have hds := dchar_dseries.tends_to dchar.trivial_one dchar.trivial_one_valid s hs
  have hterm_eq : (fun n => dchar_dseries_term dchar.trivial_one s n) = (fun n => cpow_real ((n + 1 : ℕ) : ℝ) (complex.neg s)) := by funext n; unfold dchar_dseries_term dchar.trivial_one; simp [complex.one_mul]
  rw [hterm_eq] at hds
  have hagr := zeta.em2_eq_dseries_re_gt_one s S (dchar_dseries dchar.trivial_one s) hs hS hds
  have hsub_add : ∀ a b c : ℂ, complex.sub (complex.add a b) (complex.add a c) = complex.sub b c
    intro a b c; apply complex.ext <;> simp <;> ring
  have hlim_S : ctends_to (fun (N : ℕ) => complex.add (complex.add (complex.inv (complex.sub s complex.one)) (complex.of_real (1 / 2))) (csum N (zeta_em2_term s))) (complex.add (complex.add (complex.inv (complex.sub s complex.one)) (complex.of_real (1 / 2))) S)
    unfold ctends_to at hS ⊢; intro e he
    obtain ⟨N0, hN0⟩ := hS e he
    use N0; intro N hN; rw [hsub_add]; exact hN0 N hN
  have his := zeta_em2.is_em2
  unfold is_zeta_em2 at his
  have hlim_z := his s (by linarith) hne
  have hz_eq := ctends_to.unique (fun (N : ℕ) => complex.add (complex.add (complex.inv (complex.sub s complex.one)) (complex.of_real (1 / 2))) (csum N (zeta_em2_term s))) (zeta_em2 s) (complex.add (complex.add (complex.inv (complex.sub s complex.one)) (complex.of_real (1 / 2))) S) hlim_z hlim_S
  rw [hz_eq, hagr]; exact hds

-- UNIFIED MELLIN–GAUSSIAN FUBINI THEOREM ON Re(s) > 1 (0 CUSTOM AXIOMS!):
-- Covers BOTH Riemann's 1859 Jacobi-psi Mellin identity (q_sc = 1) AND Hecke's primitive
-- twisted-theta Mellin identity (q_sc = psi.level) in one proof!
+ mellin_gaussian.fubini_re_gt_one
    (f : ℝ → ℂ) (tm : ℝ → ℕ → ℂ) (ds_tm : ℕ → ℂ) (s w G_val L_val : ℂ) (q_sc : ℝ)
    (hs : 1 < complex.re s) (hw_re_pos : 0 < complex.re w) (hq_rpos : 0 < q_sc)
    (hgam_eq : G_val = complex.mul (cpow_real (q_sc / pi) w) (gamma w))
    (hds_lim : ctends_to (fun M => csum M ds_tm) L_val)
    (habs_ds : ∀ n : ℕ, complex.abs (ds_tm n) ≤ rpow ((n + 1 : ℕ) : ℝ) (-complex.re s))
    (hf_int : ∀ B : ℝ, 2 ≤ B → c_has_integral f (1 / B) B (cint f (1 / B) B))
    (hterm_int : ∀ (n : ℕ) (B : ℝ), 2 ≤ B →
      c_has_integral (fun u => complex.mul (tm u n) (cpow_real u (complex.sub w complex.one))) (1 / B) B
        (complex.mul (cpow_real (q_sc / pi) w)
          (complex.mul (ds_tm n)
            (gamma_trunc w ((pi * ((n + 1 : ℕ) : ℝ) * ((n + 1 : ℕ) : ℝ) / q_sc) * (1 / B))
                           ((pi * ((n + 1 : ℕ) : ℝ) * ((n + 1 : ℕ) : ℝ) / q_sc) * B)))))
    (htail_geom : ∀ B : ℝ, 2 ≤ B → ∃ alphaB AB : ℝ, 0 < alphaB ∧ 0 < AB ∧
      ∀ u : ℝ, 1 / B ≤ u → u ≤ B →
        f u = complex.mul (clim (fun M => csum M (tm u))) (cpow_real u (complex.sub w complex.one)) ∧
        ctends_to (fun M => csum M (tm u)) (clim (fun M => csum M (tm u))) ∧
        (∀ n : ℕ, complex.abs (tm u n) ≤ AB * exp (-alphaB * ((n + 1 : ℕ) : ℝ)))) :
    ctends_to (fun (N : ℕ) => cint f (1 / ((N + 1 : ℕ) : ℝ)) ((N + 1 : ℕ) : ℝ)) (complex.mul G_val L_val)
  have hpi_pos : 0 < pi := by linarith [pi_bounds.1]
  obtain ⟨Kw, hKw⟩ := exists_nat_gt.real (complex.re w)
  have htb := gamma_trunc.tail_bounds w hw_re_pos Kw (by linarith)
  set Cw := 1 / complex.re w + 2 * ((2 : ℝ) ^ Kw * ((fact Kw : ℕ) : ℝ)) with hCw
  have hCw_pos : 0 < Cw
    rw [hCw]
    have h2K : ∀ l : ℕ, (0 : ℝ) < (2 : ℝ) ^ l
      intro l; induction l with j ihj
      · rw [pow_zero.real]; decide
      · rw [succ_eq_add_one.nat, pow_succ.real]; linarith
    linarith [one_div_pos.real (complex.re w) hw_re_pos, mul_pos.real ((2 : ℝ) ^ Kw) ((fact Kw : ℕ) : ℝ) (h2K Kw) ((cast_pos.real (fact Kw)).mpr (fact_pos Kw))]
  have hCw_bd : ∀ a0 b0 : ℝ, 0 < a0 → a0 ≤ b0 → complex.abs (gamma_trunc w a0 b0) ≤ Cw := htb.2.2
  set Kqp := complex.abs (cpow_real (q_sc / pi) w) with hKqp
  have hKqp_pos : 0 < Kqp
    rw [hKqp]; unfold cpow_real
    have hne := complex.exp_ne_zero (complex.smul (log (q_sc / pi)) w)
    by_contra hle
    exact hne ((complex.abs_eq_zero (complex.exp (complex.smul (log (q_sc / pi)) w))).mp (by linarith [complex.abs_nonneg (complex.exp (complex.smul (log (q_sc / pi)) w))]))
  set G_abs := complex.abs G_val with hGabs
  have hGabs_nn : 0 ≤ G_abs := by rw [hGabs]; exact complex.abs_nonneg G_val
  unfold ctends_to; intro e he
  unfold ctends_to at hds_lim
  obtain ⟨M1, hM1⟩ := hds_lim (e / (4 * (G_abs + 1))) (div_pos.real e (4 * (G_abs + 1)) he (by linarith))
  set Ctail := Kqp * Cw / (complex.re s - 1) + 1 with hCtail
  have hCtail_pos : 0 < Ctail := by rw [hCtail]; linarith [div_pos.real (Kqp * Cw) (complex.re s - 1) (mul_pos.real Kqp Cw hKqp_pos hCw_pos) (by linarith)]
  have hrp_zero := rpow.nat_neg_tends_to_zero (complex.re s - 1) (by linarith)
  unfold tends_to at hrp_zero
  obtain ⟨M2, hM2⟩ := hrp_zero (e / (4 * Ctail)) (div_pos.real e (4 * Ctail) he (by linarith))
  set M0 := M1 + M2 + 2 with hM0
  set eps_g := e / (4 * (Kqp * (M0 : ℝ) + 1)) with heps_g
  have heps_g_pos : 0 < eps_g := by rw [heps_g]; exact div_pos.real e (4 * (Kqp * (M0 : ℝ) + 1)) he (by linarith [mul_nonneg.real Kqp (M0 : ℝ) (by linarith) (cast_nonneg.real M0)])
  obtain ⟨A0, B0, hA0_pos, hB0_ge1, hgam_gen⟩ := gamma.eq_integral_general_re_pos w hw_re_pos eps_g heps_g_pos
  set Breq := max 2 (max (B0 * q_sc / pi) ((pi * ((M0 : ℝ) * (M0 : ℝ)) / q_sc) / A0)) with hBreq
  obtain ⟨N0, hN0⟩ := exists_nat_gt.real Breq
  use N0; intro N hN
  set B := ((N + 1 : ℕ) : ℝ) with hB
  have hB_gt_req : Breq < B := by rw [hB]; linarith [(cast_lt.real N0 (N + 1)).mpr (by omega)]
  have hB_ge2 : 2 ≤ B := by linarith [le_max_left.real 2 (max (B0 * q_sc / pi) ((pi * ((M0 : ℝ) * (M0 : ℝ)) / q_sc) / A0))]
  have hB_pos : 0 < B := by linarith
  have h1B_pos : 0 < 1 / B := one_div_pos.real B hB_pos
  have h1B_le_B : 1 / B ≤ B := (div_le_iff.real 1 B B hB_pos).mpr (by nlinarith)
  have hpref_err : ∀ n : ℕ, n < M0 →
      complex.abs (complex.sub (gamma_trunc w ((pi * ((n + 1 : ℕ) : ℝ) * ((n + 1 : ℕ) : ℝ) / q_sc) * (1 / B)) ((pi * ((n + 1 : ℕ) : ℝ) * ((n + 1 : ℕ) : ℝ) / q_sc) * B)) (gamma w)) < eps_g
    intro n hn
    set m := ((n + 1 : ℕ) : ℝ) with hm
    have hm_ge1 : 1 ≤ m := by rw [hm]; exact (cast_le.real 1 (n + 1)).mpr (by omega)
    have hm_le : m ≤ (M0 : ℝ) := by rw [hm]; exact (cast_le.real (n + 1) M0).mpr (by omega)
    set cn := pi * m * m / q_sc with hcn
    have hcn_pos : 0 < cn := by rw [hcn]; exact div_pos.real (pi * m * m) q_sc (mul_pos.real (pi * m) m (mul_pos.real pi m hpi_pos (by linarith)) (by linarith)) hq_rpos
    have hhi : B0 ≤ cn * B
      have h1 : B0 * q_sc / pi < B := by linarith [le_max_right.real 2 (max (B0 * q_sc / pi) ((pi * ((M0 : ℝ) * (M0 : ℝ)) / q_sc) / A0)), le_max_left.real (B0 * q_sc / pi) ((pi * ((M0 : ℝ) * (M0 : ℝ)) / q_sc) / A0)]
      have h2 := (div_lt_iff.real (B0 * q_sc) B pi hpi_pos).mp h1
      have hcq := mul_inv_cancel.real q_sc (by linarith)
      have hmul := mul_le_mul_of_nonneg_right.real (B0 * q_sc) (B * pi) (1 / q_sc) (by linarith) (by linarith [one_div_pos.real q_sc hq_rpos])
      have hl : B0 * q_sc * (1 / q_sc) = B0 := by linear_combination B0 * hcq
      have hr : B * pi * (1 / q_sc) = (pi / q_sc) * B := by rw [div_def.real pi q_sc]; ring
      have hcn_ge : pi / q_sc ≤ cn
        rw [hcn, div_def.real pi q_sc, div_def.real (pi * m * m) q_sc]
        exact mul_le_mul_of_nonneg_right.real pi (pi * m * m) (1 / q_sc) (by linarith [mul_le_mul_of_nonneg_left.real 1 (m * m) pi (by nlinarith) (by linarith)]) (by linarith [one_div_pos.real q_sc hq_rpos])
      linarith [mul_le_mul_of_nonneg_right.real (pi / q_sc) cn B hcn_ge (by linarith)]
    have hlo : cn * (1 / B) ≤ A0
      have h1 : (pi * ((M0 : ℝ) * (M0 : ℝ)) / q_sc) / A0 < B := by linarith [le_max_right.real 2 (max (B0 * q_sc / pi) ((pi * ((M0 : ℝ) * (M0 : ℝ)) / q_sc) / A0)), le_max_right.real (B0 * q_sc / pi) ((pi * ((M0 : ℝ) * (M0 : ℝ)) / q_sc) / A0)]
      have h2 := (div_lt_iff.real (pi * ((M0 : ℝ) * (M0 : ℝ)) / q_sc) B A0 hA0_pos).mp h1
      have hcn_le : cn ≤ pi * ((M0 : ℝ) * (M0 : ℝ)) / q_sc
        rw [hcn, div_def.real (pi * m * m) q_sc, div_def.real (pi * ((M0 : ℝ) * (M0 : ℝ))) q_sc]
        exact mul_le_mul_of_nonneg_right.real (pi * m * m) (pi * ((M0 : ℝ) * (M0 : ℝ))) (1 / q_sc) (by linarith [mul_le_mul_of_nonneg_left.real (m * m) ((M0 : ℝ) * (M0 : ℝ)) pi (by nlinarith) (by linarith)]) (by linarith [one_div_pos.real q_sc hq_rpos])
      have h3 := mul_le_mul_of_nonneg_right.real cn (B * A0) (1 / B) (by linarith) (by linarith)
      have hcB := mul_inv_cancel.real B (by linarith)
      have hre : B * A0 * (1 / B) = A0 := by linear_combination A0 * hcB
      linarith
    exact hgam_gen (cn * (1 / B)) (cn * B) (mul_pos.real cn (1 / B) hcn_pos h1B_pos) hlo hhi
  obtain ⟨alphaB, AB, halphaB_pos, hAB_pos, htail_B⟩ := htail_geom B hB_ge2
  set rB := exp (-alphaB) with hrB
  have hrB_pos : 0 < rB := by rw [hrB]; exact exp_pos (-alphaB)
  have hrB_lt1 : rB < 1 := by rw [hrB]; have h := (exp_lt_exp (-alphaB) 0).mpr (by linarith); rw [exp_zero] at h; exact h
  have hrB_pow : ∀ m : ℕ, rB ^ m = exp (-alphaB * (m : ℝ))
    intro m; induction m with j ihj
    · rw [pow_zero.real]; simp [exp_zero]
    · rw [succ_eq_add_one.nat, pow_succ.real, ihj, hrB, ← exp_add, cast_add.real j 1]; simp
      have h1 : -alphaB * (j : ℝ) + -alphaB = -alphaB * ((j : ℝ) + 1) := by ring
      rw [h1]
  set Pmax := max (rpow (1 / B) (complex.re w - 1)) (rpow B (complex.re w - 1)) with hPmax
  have hPmax_pos : 0 < Pmax := by rw [hPmax]; linarith [le_max_right.real (rpow (1 / B) (complex.re w - 1)) (rpow B (complex.re w - 1)), rpow.pos B (complex.re w - 1)]
  set KB := (B * Pmax * AB / (1 - rB)) * (4 / e) + 1 with hKB
  have hKB_pos : 0 < KB
    rw [hKB]
    have h1 := div_pos.real (B * Pmax * AB) (1 - rB) (mul_pos.real (B * Pmax) AB (mul_pos.real B Pmax hB_pos hPmax_pos) hAB_pos) (by linarith)
    linarith [mul_pos.real (B * Pmax * AB / (1 - rB)) (4 / e) h1 (div_pos.real 4 e (by decide) he)]
  obtain ⟨M3, hM3⟩ := exists_nat_gt.real (log KB / alphaB + 1)
  set M := M0 + M3 with hM
  have hI_f := hf_int B hB_ge2
  set g_tr := (fun (n : ℕ) => complex.mul (ds_tm n) (gamma_trunc w ((pi * ((n + 1 : ℕ) : ℝ) * ((n + 1 : ℕ) : ℝ) / q_sc) * (1 / B)) ((pi * ((n + 1 : ℕ) : ℝ) * ((n + 1 : ℕ) : ℝ) / q_sc) * B))) with hgtr
  set g_lim := (fun (n : ℕ) => complex.mul (ds_tm n) (gamma w)) with hglim
  set S_M := complex.mul (cpow_real (q_sc / pi) w) (csum M g_tr) with hSM
  have hI_SM : c_has_integral (fun u => complex.mul (csum M (tm u)) (cpow_real u (complex.sub w complex.one))) (1 / B) B S_M
    have hgen : ∀ k : ℕ, c_has_integral (fun u => complex.mul (csum k (tm u)) (cpow_real u (complex.sub w complex.one))) (1 / B) B (complex.mul (cpow_real (q_sc / pi) w) (csum k g_tr))
      intro k; induction k with j ihj
      · have h0 : complex.mul (cpow_real (q_sc / pi) w) (csum 0 g_tr) = complex.zero := by rw [csum.zero, complex.mul_zero]
        rw [h0]
        apply c_has_integral.congr (fun _ => complex.zero) (fun u => complex.mul (csum 0 (tm u)) (cpow_real u (complex.sub w complex.one))) (1 / B) B complex.zero
        · unfold c_has_integral; simp
          have hc0 := darboux.const (1 / B) B 0 h1B_le_B
          have hz : 0 * (B - 1 / B) = 0 := by ring
          rw [hz] at hc0; exact hc0
        · intro u _ _; rw [csum.zero, complex.zero_mul]
      · rw [succ_eq_add_one.nat]
        have hgj : g_tr j = complex.mul (ds_tm j) (gamma_trunc w ((pi * ((j + 1 : ℕ) : ℝ) * ((j + 1 : ℕ) : ℝ) / q_sc) * (1 / B)) ((pi * ((j + 1 : ℕ) : ℝ) * ((j + 1 : ℕ) : ℝ) / q_sc) * B)) := by rw [hgtr]
        have htj := hterm_int j B hB_ge2
        rw [← hgj] at htj
        have hadd := c_has_integral.add (fun u => complex.mul (csum j (tm u)) (cpow_real u (complex.sub w complex.one))) (fun u => complex.mul (tm u j) (cpow_real u (complex.sub w complex.one))) (1 / B) B (complex.mul (cpow_real (q_sc / pi) w) (csum j g_tr)) (complex.mul (cpow_real (q_sc / pi) w) (g_tr j)) ihj htj
        have hval : complex.add (complex.mul (cpow_real (q_sc / pi) w) (csum j g_tr)) (complex.mul (cpow_real (q_sc / pi) w) (g_tr j)) = complex.mul (cpow_real (q_sc / pi) w) (csum (j + 1) g_tr) := by rw [csum.succ]; ring
        rw [hval] at hadd
        apply c_has_integral.congr (fun u => complex.add (complex.mul (csum j (tm u)) (cpow_real u (complex.sub w complex.one))) (complex.mul (tm u j) (cpow_real u (complex.sub w complex.one)))) (fun u => complex.mul (csum (j + 1) (tm u)) (cpow_real u (complex.sub w complex.one))) (1 / B) B (complex.mul (cpow_real (q_sc / pi) w) (csum (j + 1) g_tr)) hadd
        intro u _ _; rw [csum.succ]; ring
    rw [hSM]; exact hgen M
  have hb1 : complex.abs (complex.sub (cint f (1 / B) B) S_M) < e / 4
    have hIdiff := c_has_integral.sub f (fun u => complex.mul (csum M (tm u)) (cpow_real u (complex.sub w complex.one))) (1 / B) B (cint f (1 / B) B) S_M hI_f hI_SM
    have hth_tail : ∀ u : ℝ, 1 / B ≤ u → u ≤ B → complex.abs (complex.sub (clim (fun K => csum K (tm u))) (csum M (tm u))) ≤ AB * rB ^ (M + 1) / (1 - rB)
      intro u hu1 hu2
      have htBu := htail_B u hu1 hu2
      have hdiff_d : ∀ d : ℕ, complex.abs (complex.sub (csum (M + d) (tm u)) (csum M (tm u))) ≤ AB * rB ^ (M + 1) / (1 - rB)
        intro d
        have hsh : ∀ k : ℕ, complex.sub (csum (M + k) (tm u)) (csum M (tm u)) = csum k (fun j => tm u (M + j))
          intro k; induction k with l ihl
          · have h0 : M + 0 = M := by omega
            rw [h0, csum.zero]; ring
          · rw [succ_eq_add_one.nat]
            have h1 : M + (l + 1) = (M + l) + 1 := by omega
            rw [h1, csum.succ, csum.succ, ← ihl]; ring
        rw [hsh d]
        have h1 := csum.abs_le_sum d (fun j => tm u (M + j))
        have hpt_le : ∀ j, j < d → complex.abs (tm u (M + j)) ≤ AB * rB ^ (M + 1) * rB ^ j
          intro j _
          have hb := htBu.2.2 (M + j)
          rw [← hrB_pow (M + j + 1)] at hb
          have hp : rB ^ (M + j + 1) = rB ^ (M + 1) * rB ^ j
            rw [hrB_pow (M + j + 1), hrB_pow (M + 1), hrB_pow j, ← exp_add, cast_add.real (M + j) 1, cast_add.real M j, cast_add.real M 1]; simp
            have ha1 : -alphaB * ((M : ℝ) + (j : ℝ) + 1) = -alphaB * ((M : ℝ) + 1) + -alphaB * (j : ℝ) := by ring
            rw [ha1]
          rw [hp] at hb; linarith
        have h2 := sum_le.real (fun j => complex.abs (tm u (M + j))) (fun j => AB * rB ^ (M + 1) * rB ^ j) d hpt_le
        have hsc : ∀ k : ℕ, (∑ j < k, AB * rB ^ (M + 1) * rB ^ j) = AB * rB ^ (M + 1) * (∑ j < k, rB ^ j)
          intro k; induction k with l ihl
          · rw [sum_below_zero, sum_below_zero]; ring
          · rw [succ_eq_add_one.nat, sum_below_succ, sum_below_succ, ihl]; ring
        have hgeom : (∑ j < d, rB ^ j) ≤ 1 / (1 - rB)
          have hg : ∀ k : ℕ, (1 - rB) * (∑ j < k, rB ^ j) = 1 - rB ^ k
            intro k; induction k with l ihl
            · rw [sum_below_zero, pow_zero.real]; ring
            · rw [succ_eq_add_one.nat, sum_below_succ]
              have ha1 : (1 - rB) * ((∑ j < l, rB ^ j) + rB ^ l) = (1 - rB) * (∑ j < l, rB ^ j) + (1 - rB) * rB ^ l := by ring
              rw [ha1, ihl, pow_succ.real]; ring
          exact (le_div_iff.real (∑ j < d, rB ^ j) 1 (1 - rB) (by linarith)).mpr (by linarith [hg d, pow_nonneg.real rB (by linarith) d])
        have hm := mul_le_mul_of_nonneg_left.real (∑ j < d, rB ^ j) (1 / (1 - rB)) (AB * rB ^ (M + 1)) hgeom (mul_nonneg.real AB (rB ^ (M + 1)) (by linarith) (pow_nonneg.real rB (by linarith) (M + 1)))
        have hdiv : AB * rB ^ (M + 1) * (1 / (1 - rB)) = AB * rB ^ (M + 1) / (1 - rB) := by rw [div_def.real (AB * rB ^ (M + 1)) (1 - rB)]
        linarith [hsc d]
      have hlim := htBu.2.1
      have hsh_lim : ctends_to (fun d => complex.sub (csum (M + d) (tm u)) (csum M (tm u))) (complex.sub (clim (fun K => csum K (tm u))) (csum M (tm u)))
        unfold ctends_to at hlim ⊢; intro eps heps; obtain ⟨N1, hN1⟩ := hlim eps heps; use N1; intro d hd
        have hre : complex.sub (complex.sub (csum (M + d) (tm u)) (csum M (tm u))) (complex.sub (clim (fun K => csum K (tm u))) (csum M (tm u))) = complex.sub (csum (M + d) (tm u)) (clim (fun K => csum K (tm u))) := by ring
        rw [hre]; exact hN1 (M + d) (by omega)
      have habs_lim := ctends_to.abs (fun d => complex.sub (csum (M + d) (tm u)) (csum M (tm u))) (complex.sub (clim (fun K => csum K (tm u))) (csum M (tm u))) hsh_lim
      have hneg_lim : tends_to (fun d => -complex.abs (complex.sub (csum (M + d) (tm u)) (csum M (tm u)))) (-complex.abs (complex.sub (clim (fun K => csum K (tm u))) (csum M (tm u))))
        unfold tends_to at habs_lim ⊢; intro eps heps; obtain ⟨N1, hN1⟩ := habs_lim eps heps; use N1; intro d hd
        have hre : -complex.abs (complex.sub (csum (M + d) (tm u)) (csum M (tm u))) - -complex.abs (complex.sub (clim (fun K => csum K (tm u))) (csum M (tm u))) = -(complex.abs (complex.sub (csum (M + d) (tm u)) (csum M (tm u))) - complex.abs (complex.sub (clim (fun K => csum K (tm u))) (csum M (tm u)))) := by ring
        rw [hre, abs_neg_eq]; exact hN1 d hd
      linarith [tends_to.ge_of_ge (fun d => -complex.abs (complex.sub (csum (M + d) (tm u)) (csum M (tm u)))) (-complex.abs (complex.sub (clim (fun K => csum K (tm u))) (csum M (tm u)))) (-(AB * rB ^ (M + 1) / (1 - rB))) hneg_lim (by intro d; linarith [hdiff_d d])]
    have hpt_bd : ∀ u : ℝ, 1 / B ≤ u → u ≤ B → complex.abs (complex.sub (f u) (complex.mul (csum M (tm u)) (cpow_real u (complex.sub w complex.one)))) ≤ (AB * rB ^ (M + 1) / (1 - rB)) * Pmax
      intro u hu1 hu2
      have htBu := htail_B u hu1 hu2
      have hfac : complex.sub (f u) (complex.mul (csum M (tm u)) (cpow_real u (complex.sub w complex.one))) = complex.mul (complex.sub (clim (fun K => csum K (tm u))) (csum M (tm u))) (cpow_real u (complex.sub w complex.one)) := by rw [htBu.1]; ring
      rw [hfac, complex.abs_mul]
      have htl := hth_tail u hu1 hu2
      have hap : complex.abs (cpow_real u (complex.sub w complex.one)) = rpow u (complex.re w - 1)
        have hsq : complex.abs (cpow_real u (complex.sub w complex.one)) * complex.abs (cpow_real u (complex.sub w complex.one)) = rpow u (complex.re w - 1) * rpow u (complex.re w - 1)
          rw [complex.abs_sq]; unfold complex.norm_sq cpow_real rpow; simp
          have h1 : log u * (complex.re w - 1) = (complex.re w - 1) * log u := by ring
          rw [h1]; linear_combination (exp ((complex.re w - 1) * log u) * exp ((complex.re w - 1) * log u)) * sin_sq_add_cos_sq (log u * (complex.im w - 0))
        exact eq_of_sq_eq_nonneg (complex.abs (cpow_real u (complex.sub w complex.one))) (rpow u (complex.re w - 1)) (complex.abs_nonneg (cpow_real u (complex.sub w complex.one))) (by linarith [rpow.pos u (complex.re w - 1)]) hsq
      have hp_le : rpow u (complex.re w - 1) ≤ Pmax
        rw [hPmax]
        by_cases hsign : 0 ≤ complex.re w - 1
        · have hlu := (log_le_log u B (by linarith) hB_pos).mpr hu2
          have h1 : rpow u (complex.re w - 1) ≤ rpow B (complex.re w - 1) := by unfold rpow; exact (exp_le_exp ((complex.re w - 1) * log u) ((complex.re w - 1) * log B)).mpr (mul_le_mul_of_nonneg_left.real (log u) (log B) (complex.re w - 1) hlu hsign)
          linarith [le_max_right.real (rpow (1 / B) (complex.re w - 1)) (rpow B (complex.re w - 1))]
        · have hlu := (log_le_log (1 / B) u h1B_pos (by linarith)).mpr hu1
