-- THEOREM 3A (RIEMANN 1859 MELLIN INTEGRAL = Gamma_triv(s) * zeta_em2(s) ON Re(s) > 1 — 0 AXIOMS!):
+ riemann_theta.mellin_eq_gamma_zeta_re_gt_one (s : ℂ) (hs : 1 < complex.re s) :
    ctends_to (fun (N : ℕ) => cint (fun u => complex.smul (jacobi_psi u) (cpow_real u (complex.sub (complex.smul (1 / 2) s) complex.one))) (1 / ((N + 1 : ℕ) : ℝ)) ((N + 1 : ℕ) : ℝ)) (complex.mul (classical_gamma dchar.trivial_one s) (zeta_em2 s))
  set w := complex.smul (1 / 2) s with hw
  set f_s := (fun (u : ℝ) => complex.smul (jacobi_psi u) (cpow_real u (complex.sub w complex.one))) with hfs
  have hpi_pos : 0 < pi := by linarith [pi_bounds.1]
  have hw_pos : 0 < complex.re w := by rw [hw]; simp; linarith
  have hG : classical_gamma dchar.trivial_one s = complex.mul (cpow_real (1 / pi) w) (gamma w) := by rw [classical_gamma.trivial_one_eq s, ← hw, cpow_real.inv_base pi w hpi_pos]
  apply mellin_gaussian.fubini_re_gt_one f_s (fun u n => complex.of_real (jacobi_psi_term u n)) (fun n => cpow_real ((n + 1 : ℕ) : ℝ) (complex.neg s)) s w (classical_gamma dchar.trivial_one s) (zeta_em2 s) 1 hs hw_pos (by decide) hG (zeta_em2.eq_dseries_limit_re_gt_one s hs)
  · intro n
    set u := ((n + 1 : ℕ) : ℝ)
    have hsq : complex.abs (cpow_real u (complex.neg s)) * complex.abs (cpow_real u (complex.neg s)) = rpow u (-complex.re s) * rpow u (-complex.re s)
      rw [complex.abs_sq]; unfold complex.norm_sq cpow_real rpow; simp
      have h1 : log u * (0 - complex.re s) = -complex.re s * log u := by ring
      rw [h1]; linear_combination (exp (-complex.re s * log u) * exp (-complex.re s * log u)) * sin_sq_add_cos_sq (log u * (0 - complex.im s))
    exact (by linarith [eq_of_sq_eq_nonneg (complex.abs (cpow_real u (complex.neg s))) (rpow u (-complex.re s)) (complex.abs_nonneg (cpow_real u (complex.neg s))) (by linarith [rpow.pos u (-complex.re s)]) hsq])
  · intro B hB2
    have h1B_pos : 0 < 1 / B := one_div_pos.real B (by linarith)
    have h1B_le_B : 1 / B ≤ B := (div_le_iff.real 1 B B (by linarith)).mpr (by nlinarith)
    obtain ⟨Ir, hIr⟩ := darboux.continuous (fun x => complex.re (f_s x)) (1 / B) B h1B_le_B (by intro t ht1 _; rw [hfs]; have hc1 := jacobi_psi.continuous_on_pos (1 / B) h1B_pos t ht1; have hc2 := cpow_real.continuous_re_im (complex.sub w complex.one) t (by linarith); continuity)
    obtain ⟨Ii, hIi⟩ := darboux.continuous (fun x => complex.im (f_s x)) (1 / B) B h1B_le_B (by intro t ht1 _; rw [hfs]; have hc1 := jacobi_psi.continuous_on_pos (1 / B) h1B_pos t ht1; have hc2 := cpow_real.continuous_re_im (complex.sub w complex.one) t (by linarith); continuity)
    have hI : c_has_integral f_s (1 / B) B (complex.mk Ir Ii) := by unfold c_has_integral; simp; exact ⟨hIr, hIi⟩
    rw [cint.eq_of_has_integral f_s (1 / B) B (complex.mk Ir Ii) hI]; exact hI
  · intro n B hB2
    set m := ((n + 1 : ℕ) : ℝ) with hm
    have hm_pos : 0 < m := by rw [hm]; exact (cast_pos.real (n + 1)).mpr (by omega)
    set c := pi * m * m with hc
    have hc_pos : 0 < c := by rw [hc]; nlinarith
    have h1B_pos : 0 < 1 / B := one_div_pos.real B (by linarith)
    have h1B_le_B : 1 / B ≤ B := (div_le_iff.real 1 B B (by linarith)).mpr (by nlinarith)
    have hterm := gamma.scaled_trunc_eq c w (1 / B) B hc_pos h1B_pos h1B_le_B
    have hcpow_split : cpow_real c (complex.neg w) = complex.mul (cpow_real (1 / pi) w) (cpow_real m (complex.neg s))
      rw [cpow_real.inv_base pi w hpi_pos]; unfold cpow_real
      have hlogc : log c = log pi + 2 * log m := by rw [hc, log_mul.real (pi * m) m (by nlinarith) hm_pos, log_mul.real pi m hpi_pos hm_pos]; ring
      rw [hlogc, ← complex.exp_add]
      have harg : complex.smul (log pi + 2 * log m) (complex.neg w) = complex.add (complex.smul (log pi) (complex.neg w)) (complex.smul (log m) (complex.neg s)) := by rw [hw]; apply complex.ext <;> simp <;> ring
      rw [harg]
    have hd1 : c / 1 = c := by field_simp
    rw [hd1]
    have hval : complex.mul (cpow_real c (complex.neg w)) (gamma_trunc w (c * (1 / B)) (c * B)) = complex.mul (cpow_real (1 / pi) w) (complex.mul (cpow_real m (complex.neg s)) (gamma_trunc w (c * (1 / B)) (c * B))) := by rw [hcpow_split]; ring
    rw [← hval]
    apply c_has_integral.congr (fun u => complex.smul (exp (-(c * u))) (cpow_real u (complex.sub w complex.one))) (fun u => complex.mul (complex.of_real (jacobi_psi_term u n)) (cpow_real u (complex.sub w complex.one))) (1 / B) B (complex.mul (cpow_real c (complex.neg w)) (gamma_trunc w (c * (1 / B)) (c * B))) hterm
    intro u _ _; unfold jacobi_psi_term complex.of_real; rw [hc, hm]
    have he : -(pi * ((n + 1 : ℕ) : ℝ) * ((n + 1 : ℕ) : ℝ) * u) = -pi * ((n + 1 : ℕ) : ℝ) * ((n + 1 : ℕ) : ℝ) * u := by ring
    rw [he]; apply complex.ext <;> simp <;> ring
  · intro B hB2
    use pi / B; use 1
    constructor; exact div_pos.real pi B hpi_pos (by linarith)
    constructor; decide
    intro u hu1 hu2
    have h1B_pos : 0 < 1 / B := one_div_pos.real B (by linarith)
    have hof_abs : ∀ d : ℝ, complex.abs (complex.of_real d) = |d|
      intro d
      have hsq : complex.abs (complex.of_real d) * complex.abs (complex.of_real d) = |d| * |d| := by rw [complex.abs_sq]; unfold complex.norm_sq complex.of_real; simp; exact (sq_abs.real d).symm
      exact eq_of_sq_eq_nonneg (complex.abs (complex.of_real d)) (|d|) (complex.abs_nonneg (complex.of_real d)) (abs_nonneg.real d) hsq
    have hlim_u : ctends_to (fun M => csum M (fun n => complex.of_real (jacobi_psi_term u n))) (complex.of_real (jacobi_psi u))
      have hcs : ∀ K : ℕ, csum K (fun n => complex.of_real (jacobi_psi_term u n)) = complex.of_real (∑ n < K, jacobi_psi_term u n)
        intro K; induction K with k ihk
        · rw [csum.zero, sum_below_zero]; ring
        · rw [succ_eq_add_one.nat, csum.succ, sum_below_succ, ihk]; ring
      have hl := (jacobi_psi.spec_and_bounds u (by linarith)).1
      unfold tends_to at hl; unfold ctends_to; intro e he; obtain ⟨N0, hN0⟩ := hl e he; use N0; intro M hM
      have hsub : complex.sub (complex.of_real (∑ n < M, jacobi_psi_term u n)) (complex.of_real (jacobi_psi u)) = complex.of_real ((∑ n < M, jacobi_psi_term u n) - jacobi_psi u) := by ring
      rw [hcs M, hsub, hof_abs]; exact hN0 M hM
    have hclim_u := clim.eq_of_tends_to (fun M => csum M (fun n => complex.of_real (jacobi_psi_term u n))) (complex.of_real (jacobi_psi u)) hlim_u
    constructor
    · rw [hclim_u, hfs]; unfold complex.of_real; apply complex.ext <;> simp <;> ring
    · constructor
      · rw [hclim_u]; exact hlim_u
      · intro n; rw [hof_abs]; unfold jacobi_psi_term
        rw [abs_of_pos.real (exp (-pi * ((n + 1 : ℕ) : ℝ) * ((n + 1 : ℕ) : ℝ) * u)) (exp_pos (-pi * ((n + 1 : ℕ) : ℝ) * ((n + 1 : ℕ) : ℝ) * u))]
        have hn1 : (1 : ℝ) ≤ ((n + 1 : ℕ) : ℝ) := (cast_le.real 1 (n + 1)).mpr (by omega)
        have h3 := mul_le_mul_of_nonneg_left.real (1 / B) u (pi * ((n + 1 : ℕ) : ℝ)) hu1 (mul_nonneg.real pi ((n + 1 : ℕ) : ℝ) (by linarith) (by linarith))
        have h4 := mul_le_mul_of_nonneg_left.real 1 ((n + 1 : ℕ) : ℝ) (pi * ((n + 1 : ℕ) : ℝ) * u) hn1 (mul_nonneg.real (pi * ((n + 1 : ℕ) : ℝ)) u (mul_nonneg.real pi ((n + 1 : ℕ) : ℝ) (by linarith) (by linarith)) (by linarith))
        have heq_a : -(pi / B) * ((n + 1 : ℕ) : ℝ) = -(pi * ((n + 1 : ℕ) : ℝ) * (1 / B)) := by rw [div_def.real pi B]; ring
        have hle_e := (exp_le_exp (-pi * ((n + 1 : ℕ) : ℝ) * ((n + 1 : ℕ) : ℝ) * u) (-(pi / B) * ((n + 1 : ℕ) : ℝ))).mpr (by linarith)
        linarith

-- THEOREM 3B (RIEMANN 1859 u = 1/t SPLIT => MELLIN INTEGRAL = classical_Lambda_triv s ON Re(s) > 1 — 0 AXIOMS!):
+ riemann_theta.mellin_eq_Lambda_triv_re_gt_one (s : ℂ) (hs : 1 < complex.re s) :
    ctends_to (fun (N : ℕ) => cint (fun u => complex.smul (jacobi_psi u) (cpow_real u (complex.sub (complex.smul (1 / 2) s) complex.one))) (1 / ((N + 1 : ℕ) : ℝ)) ((N + 1 : ℕ) : ℝ)) (classical_Lambda_triv s)
  set w1 := complex.sub (complex.smul (1 / 2) s) complex.one with hw1
  set w2 := complex.sub (complex.smul (1 / 2) (complex.sub complex.one s)) complex.one with hw2
  set w3 := complex.sub (complex.smul (1 / 2) (complex.neg s)) complex.one with hw3
  set f_s := (fun (u : ℝ) => complex.smul (jacobi_psi u) (cpow_real u w1)) with hfs
  have hs0 : s ≠ complex.zero
    intro hz
    have hr : complex.re s = complex.re complex.zero := by rw [hz]
    simp at hr; linarith
  have hs1 : s ≠ complex.one
    intro hz
    have hr : complex.re s = complex.re complex.one := by rw [hz]
    simp at hr; linarith
  have h1s0 : complex.sub complex.one s ≠ complex.zero
    intro hz; apply hs1
    have hr : complex.re (complex.sub complex.one s) = complex.re complex.zero := by rw [hz]
    have hi : complex.im (complex.sub complex.one s) = complex.im complex.zero := by rw [hz]
    simp at hr hi; apply complex.ext <;> simp <;> linarith
  -- Exact identity for every N: cint f_s (1/(N+1)) (N+1) = (-1/s - 1/(1-s)) + cint (riemann_theta_integrand s) 1 (1 + N) + B^((1-s)/2)/(1-s) + B^(-s/2)/s!
  have hsplit_N : ∀ N : ℕ, cint f_s (1 / ((N + 1 : ℕ) : ℝ)) ((N + 1 : ℕ) : ℝ) = complex.add (complex.add (complex.sub (complex.neg (complex.inv s)) (complex.inv (complex.sub complex.one s))) (cint (riemann_theta_integrand s) 1 (1 + (N : ℝ)))) (complex.add (complex.mul (complex.inv (complex.sub complex.one s)) (cpow_real ((N + 1 : ℕ) : ℝ) (complex.smul (1 / 2) (complex.sub complex.one s)))) (complex.mul (complex.inv s) (cpow_real ((N + 1 : ℕ) : ℝ) (complex.smul (1 / 2) (complex.neg s)))))
    intro N
    set B := ((N + 1 : ℕ) : ℝ) with hB
    have hB_ge1 : 1 ≤ B := by rw [hB]; exact (cast_le.real 1 (N + 1)).mpr (by omega)
    have hB_eq1N : B = 1 + (N : ℝ) := by rw [hB, cast_add.real N 1]; simp; ring
    have h1B_pos : 0 < 1 / B := one_div_pos.real B (by linarith)
    have h1B_le1 : 1 / B ≤ 1 := (div_le_iff.real 1 1 B (by linarith)).mpr (by linarith)
    -- Continuity of f_s on [1/B, B]:
    have hcont_fs : ∀ t, 1 / B ≤ t → t ≤ B → continuous_at (fun x => complex.re (f_s x)) t ∧ continuous_at (fun x => complex.im (f_s x)) t
      intro t ht1 ht2
      have hcp := jacobi_psi.continuous_on_pos (1 / B) h1B_pos t ht1
      have hcw := cpow_real.continuous_re_im w1 t (by linarith)
      constructor
      · have hm := continuous_at.mul jacobi_psi (fun x => complex.re (cpow_real x w1)) t hcp hcw.1
        have hf : (fun x => jacobi_psi x * complex.re (cpow_real x w1)) = (fun x => complex.re (f_s x)) := by funext x; rw [hfs]; simp
        rw [hf] at hm; exact hm
      · have hm := continuous_at.mul jacobi_psi (fun x => complex.im (cpow_real x w1)) t hcp hcw.2
        have hf : (fun x => jacobi_psi x * complex.im (cpow_real x w1)) = (fun x => complex.im (f_s x)) := by funext x; rw [hfs]; simp
        rw [hf] at hm; exact hm
    have hI_1B_1 : c_has_integral f_s (1 / B) 1 (cint f_s (1 / B) 1)
      obtain ⟨Ir, hIr⟩ := darboux.continuous (fun x => complex.re (f_s x)) (1 / B) 1 h1B_le1 (by intro t h1 h2; exact (hcont_fs t h1 (by linarith)).1)
      obtain ⟨Ii, hIi⟩ := darboux.continuous (fun x => complex.im (f_s x)) (1 / B) 1 h1B_le1 (by intro t h1 h2; exact (hcont_fs t h1 (by linarith)).2)
      have hI : c_has_integral f_s (1 / B) 1 (complex.mk Ir Ii) := by unfold c_has_integral; simp; exact ⟨hIr, hIi⟩
      rw [cint.eq_of_has_integral f_s (1 / B) 1 (complex.mk Ir Ii) hI]; exact hI
    have hI_1_B : c_has_integral f_s 1 B (cint f_s 1 B)
      obtain ⟨Ir, hIr⟩ := darboux.continuous (fun x => complex.re (f_s x)) 1 B hB_ge1 (by intro t h1 h2; exact (hcont_fs t (by linarith) h2).1)
      obtain ⟨Ii, hIi⟩ := darboux.continuous (fun x => complex.im (f_s x)) 1 B hB_ge1 (by intro t h1 h2; exact (hcont_fs t (by linarith) h2).2)
      have hI : c_has_integral f_s 1 B (complex.mk Ir Ii) := by unfold c_has_integral; simp; exact ⟨hIr, hIi⟩
      rw [cint.eq_of_has_integral f_s 1 B (complex.mk Ir Ii) hI]; exact hI
    have hI_all := c_has_integral.adjacent f_s (1 / B) 1 B (cint f_s (1 / B) 1) (cint f_s 1 B) hI_1B_1 hI_1_B
    have hsplit_int : cint f_s (1 / B) B = complex.add (cint f_s (1 / B) 1) (cint f_s 1 B) :=
      cint.eq_of_has_integral f_s (1 / B) B (complex.add (cint f_s (1 / B) 1) (cint f_s 1 B)) hI_all
    -- Unconditional Jacobi theta inversion gives exact transformed integrand on [1, B]!
    have hjac : ∀ u : ℝ, 0 < u → 1 + 2 * jacobi_psi (1 / u) = rpow u (1 / 2) * (1 + 2 * jacobi_psi u)
      intro u hu
      have hinv_j := jacobi_theta.modular_inversion_unconditional.2 (1 / u) (one_div_pos.real u hu)
      have h11u : 1 / (1 / u) = u := by field_simp
      rw [h11u] at hinv_j
      have hsq_eq : 1 / sqrt (1 / u) = rpow u (1 / 2)
        have hsp1 := sqrt_spec (1 / u) (by linarith [one_div_pos.real u hu])
        have hs1_pos : 0 < sqrt (1 / u) := by nlinarith [hsp1.1, hsp1.2, one_div_pos.real u hu]
        have hr_sq : rpow u (1 / 2) * rpow u (1 / 2) = u
          rw [← rpow.add]; have h1 : (1 / 2 : ℝ) + 1 / 2 = 1 := by ring
          rw [h1]; unfold rpow; simp [exp_log u hu]
        have hsq_sq : (1 / sqrt (1 / u)) * (1 / sqrt (1 / u)) = u
          have h1 : (1 / sqrt (1 / u)) * (1 / sqrt (1 / u)) = 1 / (sqrt (1 / u) * sqrt (1 / u)) := by field_simp
          rw [h1, hsp1.2]; field_simp
        exact eq_of_sq_eq_nonneg (1 / sqrt (1 / u)) (rpow u (1 / 2)) (by linarith [one_div_pos.real (sqrt (1 / u)) hs1_pos]) (by linarith [rpow.pos u (1 / 2)]) (by linarith)
      rw [hsq_eq] at hinv_j; exact hinv_j
    have hpt_inv : ∀ u : ℝ, 1 ≤ u → u ≤ B →
        complex.smul (1 / (u * u)) (f_s (1 / u)) =
          complex.add (complex.smul (jacobi_psi u) (cpow_real u w2)) (complex.smul (1 / 2) (complex.sub (cpow_real u w2) (cpow_real u w3)))
      intro u hu1 hu2
      rw [hfs, hw1, hw2, hw3]
      exact riemann.complex_theta_inv_integrand_eq jacobi_psi s u (by linarith) (hjac u (by linarith))
    -- Continuity of transformed integrand on [1, B] (from equality with RHS on u > 0!):
    have hcont_u : ∀ u, 1 ≤ u → u ≤ B →
        continuous_at (fun v => complex.re (f_s (1 / v)) * (1 / (v * v))) u ∧
        continuous_at (fun v => complex.im (f_s (1 / v)) * (1 / (v * v))) u
      intro u hu1 hu2
      have hinv_c : continuous_at (fun v => 1 / v) u := continuous_at.inv_of_pos (fun v => v) u (continuous_at.id u) (by linarith)
      have hinv2_c : continuous_at (fun v => 1 / (v * v)) u := continuous_at.inv_of_pos (fun v => v * v) u (continuous_at.mul (fun v => v) (fun v => v) u (continuous_at.id u) (continuous_at.id u)) (by nlinarith)
      have h1u_ge : 1 / B ≤ 1 / u
        have h1 := mul_le_mul_of_nonneg_left.real u B (1 / B) hu2 (by linarith)
        have hcB := mul_inv_cancel.real B (by linarith)
        exact (le_div_iff.real (1 / B) 1 u (by linarith)).mpr (by linarith)
      have h1u_le : 1 / u ≤ B := by have h := (div_le_iff.real 1 B u (by linarith)).mpr (by nlinarith); exact h
      have hcf := hcont_fs (1 / u) h1u_ge h1u_le
      constructor
      · exact continuous_at.mul (fun v => complex.re (f_s (1 / v))) (fun v => 1 / (v * v)) u (continuous_at.comp (fun x => complex.re (f_s x)) (fun v => 1 / v) u hcf.1 hinv_c) hinv2_c
      · exact continuous_at.mul (fun v => complex.im (f_s (1 / v))) (fun v => 1 / (v * v)) u (continuous_at.comp (fun x => complex.im (f_s x)) (fun v => 1 / v) u hcf.2 hinv_c) hinv2_c
    have hsub_inv := c_has_integral.subst_inv_cont f_s B hB_ge1 (by intro t h1 h2; exact (hcont_fs t h1 (by linarith)).1) (by intro t h1 h2; exact (hcont_fs t h1 (by linarith)).2) (by intro u h1 h2; exact (hcont_u u h1 h2).1) (by intro u h1 h2; exact (hcont_u u h1 h2).2)
    have hsub_congr := c_has_integral.congr (fun u => complex.smul (1 / (u * u)) (f_s (1 / u))) (fun u => complex.add (complex.smul (jacobi_psi u) (cpow_real u w2)) (complex.smul (1 / 2) (complex.sub (cpow_real u w2) (cpow_real u w3)))) 1 B (cint f_s (1 / B) 1) hsub_inv hpt_inv
    -- Add cint f_s 1 B to get cint (riemann_theta_integrand s) 1 B + (1/2) * int_1^B (u^w2 - u^w3) du!
    have hcomb := c_has_integral.add (fun u => complex.add (complex.smul (jacobi_psi u) (cpow_real u w2)) (complex.smul (1 / 2) (complex.sub (cpow_real u w2) (cpow_real u w3)))) f_s 1 B (cint f_s (1 / B) 1) (cint f_s 1 B) hsub_congr hI_1_B
    -- Evaluate elementary power integrals int_1^B u^w2 du and int_1^B u^w3 du via `zeta.complex_power_integral`!
    set z2 := complex.neg w2 with hz2
    set z3 := complex.neg w3 with hz3
    have hz2_ne1 : z2 ≠ complex.one
      intro hz; apply hs1
      have hr : complex.re z2 = complex.re complex.one := by rw [hz]
      have hi : complex.im z2 = complex.im complex.one := by rw [hz]
      rw [hz2, hw2] at hr hi; simp at hr hi; apply complex.ext <;> simp <;> linarith
    have hz3_ne1 : z3 ≠ complex.one
      intro hz; apply hs0
      have hr : complex.re z3 = complex.re complex.one := by rw [hz]
      have hi : complex.im z3 = complex.im complex.one := by rw [hz]
      rw [hz3, hw3] at hr hi; simp at hr hi; apply complex.ext <;> simp <;> linarith
    have hpow2 := zeta.complex_power_integral z2 1 B (by decide) hB_ge1 hz2_ne1
    have hpow3 := zeta.complex_power_integral z3 1 B (by decide) hB_ge1 hz3_ne1
    have hneg_z2 : complex.neg z2 = w2
      rw [hz2]; apply complex.ext <;> simp <;> ring
    have hneg_z3 : complex.neg z3 = w3
      rw [hz3]; apply complex.ext <;> simp <;> ring
    have h1mz2 : complex.sub complex.one z2 = complex.smul (1 / 2) (complex.sub complex.one s)
      rw [hz2, hw2]; apply complex.ext <;> simp <;> ring
    have h1mz3 : complex.sub complex.one z3 = complex.smul (1 / 2) (complex.neg s)
      rw [hz3, hw3]; apply complex.ext <;> simp <;> ring
    have hcp1 : ∀ z : ℂ, cpow_real 1 z = complex.one
      intro z; unfold cpow_real; apply complex.ext
      · simp [log_one, exp_zero, cos_zero]
      · simp [log_one, exp_zero, sin_zero]
    rw [hneg_z2, h1mz2, hcp1] at hpow2
    rw [hneg_z3, h1mz3, hcp1] at hpow3
    have hpow_diff := c_has_integral.sub (fun x => cpow_real x w2) (fun x => cpow_real x w3) 1 B (complex.mul (complex.inv (complex.smul (1 / 2) (complex.sub complex.one s))) (complex.sub (cpow_real B (complex.smul (1 / 2) (complex.sub complex.one s))) complex.one)) (complex.mul (complex.inv (complex.smul (1 / 2) (complex.neg s))) (complex.sub (cpow_real B (complex.smul (1 / 2) (complex.neg s))) complex.one)) hpow2 hpow3
    have hpow_half := c_has_integral.scale_real (fun x => complex.sub (cpow_real x w2) (cpow_real x w3)) 1 B (1 / 2) (complex.sub (complex.mul (complex.inv (complex.smul (1 / 2) (complex.sub complex.one s))) (complex.sub (cpow_real B (complex.smul (1 / 2) (complex.sub complex.one s))) complex.one)) (complex.mul (complex.inv (complex.smul (1 / 2) (complex.neg s))) (complex.sub (cpow_real B (complex.smul (1 / 2) (complex.neg s))) complex.one))) hpow_diff
    -- Simplify (1/2) * inv((1/2)*a) = inv(a) for a = 1 - s and a = -s!
    have hhalf_inv : ∀ a : ℂ, a ≠ complex.zero → complex.smul (1 / 2) (complex.inv (complex.smul (1 / 2) a)) = complex.inv a
      intro a ha
      have ha2 : complex.smul (1 / 2) a ≠ complex.zero
        intro hz; apply ha
        have hr : complex.re (complex.smul (1 / 2) a) = complex.re complex.zero := by rw [hz]
        have hi : complex.im (complex.smul (1 / 2) a) = complex.im complex.zero := by rw [hz]
        simp at hr hi; apply complex.ext <;> simp <;> linarith
      have hc1 := complex.mul_inv_cancel a ha
      have hc2 := complex.mul_inv_cancel (complex.smul (1 / 2) a) ha2
      have hprod : complex.mul a (complex.smul (1 / 2) (complex.inv (complex.smul (1 / 2) a))) = complex.one
        have h1 : complex.mul a (complex.smul (1 / 2) (complex.inv (complex.smul (1 / 2) a))) = complex.mul (complex.smul (1 / 2) a) (complex.inv (complex.smul (1 / 2) a))
          apply complex.ext <;> simp <;> ring
        rw [h1, hc2]
      have hfin : complex.mul (complex.inv a) (complex.mul a (complex.smul (1 / 2) (complex.inv (complex.smul (1 / 2) a)))) = complex.mul (complex.inv a) complex.one := by rw [hprod]
      have hre : complex.mul (complex.inv a) (complex.mul a (complex.smul (1 / 2) (complex.inv (complex.smul (1 / 2) a)))) = complex.mul (complex.mul a (complex.inv a)) (complex.smul (1 / 2) (complex.inv (complex.smul (1 / 2) a)))
        apply complex.ext <;> simp <;> ring
      rw [hre, hc1, complex.one_mul, complex.mul_one] at hfin; exact hfin
    have hinv_neg_s : complex.inv (complex.neg s) = complex.neg (complex.inv s)
      have hns0 : complex.neg s ≠ complex.zero
        intro hz; apply hs0
        have hr : complex.re (complex.neg s) = complex.re complex.zero := by rw [hz]
        have hi : complex.im (complex.neg s) = complex.im complex.zero := by rw [hz]
        simp at hr hi; apply complex.ext <;> simp <;> linarith
      have hc1 := complex.mul_inv_cancel s hs0
      have hc2 := complex.mul_inv_cancel (complex.neg s) hns0
      have hp : complex.mul (complex.neg s) (complex.neg (complex.inv s)) = complex.one
        have h1 : complex.mul (complex.neg s) (complex.neg (complex.inv s)) = complex.mul s (complex.inv s)
          apply complex.ext <;> simp <;> ring
        rw [h1, hc1]
      have hfin : complex.mul (complex.inv (complex.neg s)) (complex.mul (complex.neg s) (complex.neg (complex.inv s))) = complex.mul (complex.inv (complex.neg s)) complex.one := by rw [hp]
      have hre : complex.mul (complex.inv (complex.neg s)) (complex.mul (complex.neg s) (complex.neg (complex.inv s))) = complex.mul (complex.mul (complex.neg s) (complex.inv (complex.neg s))) (complex.neg (complex.inv s))
        apply complex.ext <;> simp <;> ring
      rw [hre, hc2, complex.one_mul, complex.mul_one] at hfin; exact hfin.symm
    have hpow_val : complex.smul (1 / 2) (complex.sub (complex.mul (complex.inv (complex.smul (1 / 2) (complex.sub complex.one s))) (complex.sub (cpow_real B (complex.smul (1 / 2) (complex.sub complex.one s))) complex.one)) (complex.mul (complex.inv (complex.smul (1 / 2) (complex.neg s))) (complex.sub (cpow_real B (complex.smul (1 / 2) (complex.neg s))) complex.one))) = complex.add (complex.sub (complex.neg (complex.inv s)) (complex.inv (complex.sub complex.one s))) (complex.add (complex.mul (complex.inv (complex.sub complex.one s)) (cpow_real B (complex.smul (1 / 2) (complex.sub complex.one s)))) (complex.mul (complex.inv s) (cpow_real B (complex.smul (1 / 2) (complex.neg s)))))
      have hns0 : complex.neg s ≠ complex.zero
        intro hz; apply hs0
        have hr : complex.re (complex.neg s) = complex.re complex.zero := by rw [hz]
        have hi : complex.im (complex.neg s) = complex.im complex.zero := by rw [hz]
        simp at hr hi; apply complex.ext <;> simp <;> linarith
      have ha1 := hhalf_inv (complex.sub complex.one s) h1s0
      have ha2 := hhalf_inv (complex.neg s) hns0
      rw [hinv_neg_s] at ha2
      have hdist : complex.smul (1 / 2) (complex.sub (complex.mul (complex.inv (complex.smul (1 / 2) (complex.sub complex.one s))) (complex.sub (cpow_real B (complex.smul (1 / 2) (complex.sub complex.one s))) complex.one)) (complex.mul (complex.inv (complex.smul (1 / 2) (complex.neg s))) (complex.sub (cpow_real B (complex.smul (1 / 2) (complex.neg s))) complex.one))) = complex.sub (complex.mul (complex.smul (1 / 2) (complex.inv (complex.smul (1 / 2) (complex.sub complex.one s)))) (complex.sub (cpow_real B (complex.smul (1 / 2) (complex.sub complex.one s))) complex.one)) (complex.mul (complex.smul (1 / 2) (complex.inv (complex.smul (1 / 2) (complex.neg s)))) (complex.sub (cpow_real B (complex.smul (1 / 2) (complex.neg s))) complex.one))
        apply complex.ext <;> simp <;> ring
      rw [hdist, ha1, ha2]; apply complex.ext <;> simp <;> ring
    rw [hpow_val] at hpow_half
    -- Integral of `riemann_theta_integrand s` on [1, B]:
    have hp_rti := riemann_theta_integrand.props s
    have hI_rti : c_has_integral (riemann_theta_integrand s) 1 B (cint (riemann_theta_integrand s) 1 B)
      obtain ⟨Ir, hIr⟩ := darboux.continuous (fun x => complex.re (riemann_theta_integrand s x)) 1 B hB_ge1 (by intro t h1 h2; exact hp_rti.1 t h1)
      obtain ⟨Ii, hIi⟩ := darboux.continuous (fun x => complex.im (riemann_theta_integrand s x)) 1 B hB_ge1 (by intro t h1 h2; exact hp_rti.2.1 t h1)
      have hI : c_has_integral (riemann_theta_integrand s) 1 B (complex.mk Ir Ii) := by unfold c_has_integral; simp; exact ⟨hIr, hIi⟩
      rw [cint.eq_of_has_integral (riemann_theta_integrand s) 1 B (complex.mk Ir Ii) hI]; exact hI
    have hsum_rhs := c_has_integral.add (riemann_theta_integrand s) (fun x => complex.smul (1 / 2) (complex.sub (cpow_real x w2) (cpow_real x w3))) 1 B (cint (riemann_theta_integrand s) 1 B) (complex.add (complex.sub (complex.neg (complex.inv s)) (complex.inv (complex.sub complex.one s))) (complex.add (complex.mul (complex.inv (complex.sub complex.one s)) (cpow_real B (complex.smul (1 / 2) (complex.sub complex.one s)))) (complex.mul (complex.inv s) (cpow_real B (complex.smul (1 / 2) (complex.neg s)))))) hI_rti hpow_half
    have hcongr_lr := c_has_integral.congr (fun u => complex.add (complex.add (complex.smul (jacobi_psi u) (cpow_real u w2)) (complex.smul (1 / 2) (complex.sub (cpow_real u w2) (cpow_real u w3)))) (f_s u)) (fun x => complex.add (riemann_theta_integrand s x) (complex.smul (1 / 2) (complex.sub (cpow_real x w2) (cpow_real x w3)))) 1 B (complex.add (cint f_s (1 / B) 1) (cint f_s 1 B)) hcomb (by
      intro u _ _; unfold riemann_theta_integrand; rw [hfs, hw1, hw2]; apply complex.ext <;> simp <;> ring)
    have hu := c_has_integral.unique (fun x => complex.add (riemann_theta_integrand s x) (complex.smul (1 / 2) (complex.sub (cpow_real x w2) (cpow_real x w3)))) 1 B (complex.add (cint f_s (1 / B) 1) (cint f_s 1 B)) (complex.add (cint (riemann_theta_integrand s) 1 B) (complex.add (complex.sub (complex.neg (complex.inv s)) (complex.inv (complex.sub complex.one s))) (complex.add (complex.mul (complex.inv (complex.sub complex.one s)) (cpow_real B (complex.smul (1 / 2) (complex.sub complex.one s)))) (complex.mul (complex.inv s) (cpow_real B (complex.smul (1 / 2) (complex.neg s))))))) hcongr_lr hsum_rhs
    rw [hsplit_int, hu, hB_eq1N]; apply complex.ext <;> simp <;> ring
  -- Now pass N -> infty! Both boundary power terms -> 0 since Re((1-s)/2) < 0 and Re(-s/2) < 0!
  have htail := riemann_theta_tail_int.spec s
  have ht1 := rpow.nat_neg_tends_to_zero ((complex.re s - 1) / 2) (by linarith)
  have ht2 := rpow.nat_neg_tends_to_zero (complex.re s / 2) (by linarith)
  unfold ctends_to at htail ⊢
  unfold tends_to at ht1 ht2
  intro e he
  set C1 := complex.abs (complex.inv (complex.sub complex.one s)) + 1 with hC1
  set C2 := complex.abs (complex.inv s) + 1 with hC2
  have hC1_pos : 0 < C1 := by rw [hC1]; linarith [complex.abs_nonneg (complex.inv (complex.sub complex.one s))]
  have hC2_pos : 0 < C2 := by rw [hC2]; linarith [complex.abs_nonneg (complex.inv s)]
  obtain ⟨N1, hN1⟩ := htail (e / 3) (by linarith)
  obtain ⟨N2, hN2⟩ := ht1 (e / (3 * C1)) (div_pos.real e (3 * C1) he (by linarith))
  obtain ⟨N3, hN3⟩ := ht2 (e / (3 * C2)) (div_pos.real e (3 * C2) he (by linarith))
  use N1 + N2 + N3; intro N hN
  rw [hsplit_N N]
  unfold classical_Lambda_triv
  have hdiff : ∀ p q r t : ℂ, complex.sub (complex.add (complex.add p q) r) (complex.add p t) = complex.add (complex.sub q t) r
    intro p q r t; apply complex.ext <;> simp <;> ring
  rw [hdiff]
  have htr1 := complex.abs_add_le (complex.sub (cint (riemann_theta_integrand s) 1 (1 + (N : ℝ))) (riemann_theta_tail_int s)) (complex.add (complex.mul (complex.inv (complex.sub complex.one s)) (cpow_real ((N + 1 : ℕ) : ℝ) (complex.smul (1 / 2) (complex.sub complex.one s)))) (complex.mul (complex.inv s) (cpow_real ((N + 1 : ℕ) : ℝ) (complex.smul (1 / 2) (complex.neg s)))))
  have htr2 := complex.abs_add_le (complex.mul (complex.inv (complex.sub complex.one s)) (cpow_real ((N + 1 : ℕ) : ℝ) (complex.smul (1 / 2) (complex.sub complex.one s)))) (complex.mul (complex.inv s) (cpow_real ((N + 1 : ℕ) : ℝ) (complex.smul (1 / 2) (complex.neg s))))
  have habs_cpow : ∀ (u : ℝ) (z : ℂ), 0 < u → complex.abs (cpow_real u z) = rpow u (complex.re z)
    intro u z hu
    have hsq : complex.abs (cpow_real u z) * complex.abs (cpow_real u z) = rpow u (complex.re z) * rpow u (complex.re z)
      rw [complex.abs_sq]; unfold complex.norm_sq cpow_real rpow; simp
      have h1 : log u * complex.re z = complex.re z * log u := by ring
      rw [h1]; linear_combination (exp (complex.re z * log u) * exp (complex.re z * log u)) * sin_sq_add_cos_sq (log u * complex.im z)
    exact eq_of_sq_eq_nonneg (complex.abs (cpow_real u z)) (rpow u (complex.re z)) (complex.abs_nonneg (cpow_real u z)) (by linarith [rpow.pos u (complex.re z)]) hsq
  have ha1 : complex.abs (cpow_real ((N + 1 : ℕ) : ℝ) (complex.smul (1 / 2) (complex.sub complex.one s))) = rpow ((N + 1 : ℕ) : ℝ) (-((complex.re s - 1) / 2))
    rw [habs_cpow ((N + 1 : ℕ) : ℝ) (complex.smul (1 / 2) (complex.sub complex.one s)) ((cast_pos.real (N + 1)).mpr (by omega))]
    have hre_eq : complex.re (complex.smul (1 / 2) (complex.sub complex.one s)) = -((complex.re s - 1) / 2) := by simp; ring
    rw [hre_eq]
  have ha2 : complex.abs (cpow_real ((N + 1 : ℕ) : ℝ) (complex.smul (1 / 2) (complex.neg s))) = rpow ((N + 1 : ℕ) : ℝ) (-(complex.re s / 2))
    rw [habs_cpow ((N + 1 : ℕ) : ℝ) (complex.smul (1 / 2) (complex.neg s)) ((cast_pos.real (N + 1)).mpr (by omega))]
    have hre_eq : complex.re (complex.smul (1 / 2) (complex.neg s)) = -(complex.re s / 2) := by simp; ring
    rw [hre_eq]
  have hb_t := hN1 N (by omega)
  have hb_1 := hN2 N (by omega)
  have hb_2 := hN3 N (by omega)
  have hs01 : rpow ((N + 1 : ℕ) : ℝ) (-((complex.re s - 1) / 2)) - 0 = rpow ((N + 1 : ℕ) : ℝ) (-((complex.re s - 1) / 2)) := by ring
  have hs02 : rpow ((N + 1 : ℕ) : ℝ) (-(complex.re s / 2)) - 0 = rpow ((N + 1 : ℕ) : ℝ) (-(complex.re s / 2)) := by ring
  rw [hs01, abs_of_pos.real (rpow ((N + 1 : ℕ) : ℝ) (-((complex.re s - 1) / 2))) (rpow.pos ((N + 1 : ℕ) : ℝ) (-((complex.re s - 1) / 2)))] at hb_1
  rw [hs02, abs_of_pos.real (rpow ((N + 1 : ℕ) : ℝ) (-(complex.re s / 2))) (rpow.pos ((N + 1 : ℕ) : ℝ) (-(complex.re s / 2)))] at hb_2
  rw [complex.abs_mul, complex.abs_mul, ha1, ha2] at htr2
  have hm1 := (lt_div_iff.real (rpow ((N + 1 : ℕ) : ℝ) (-((complex.re s - 1) / 2))) e (3 * C1) (by linarith)).mp hb_1
  have hm2 := (lt_div_iff.real (rpow ((N + 1 : ℕ) : ℝ) (-(complex.re s / 2))) e (3 * C2) (by linarith)).mp hb_2
  rw [hC1] at hm1; rw [hC2] at hm2
  nlinarith [rpow.pos ((N + 1 : ℕ) : ℝ) (-((complex.re s - 1) / 2)), rpow.pos ((N + 1 : ℕ) : ℝ) (-(complex.re s / 2))]

-- COROLLARY 3 (EXACT AGREEMENT `classical_L.zeta_fn s = zeta_em2 s` FOR ALL Re(s) > 1 — 0 AXIOMS!):
+ classical_L.zeta_fn_eq_em2_re_gt_one (s : ℂ) (hs : 1 < complex.re s) :
    classical_L.zeta_fn s = zeta_em2 s
  have h1 := riemann_theta.mellin_eq_gamma_zeta_re_gt_one s hs
  have h2 := riemann_theta.mellin_eq_Lambda_triv_re_gt_one s hs
  have hLam_eq := ctends_to.unique (fun (N : ℕ) => cint (fun u => complex.smul (jacobi_psi u) (cpow_real u (complex.sub (complex.smul (1 / 2) s) complex.one))) (1 / ((N + 1 : ℕ) : ℝ)) ((N + 1 : ℕ) : ℝ)) (classical_Lambda_triv s) (complex.mul (classical_gamma dchar.trivial_one s) (zeta_em2 s)) h2 h1
  have hs0 : s ≠ complex.zero
    intro hz
    have hr : complex.re s = complex.re complex.zero := by rw [hz]
    simp at hr; linarith
  have hs1 : s ≠ complex.one
    intro hz
    have hr : complex.re s = complex.re complex.one := by rw [hz]
    simp at hr; linarith
  have hgam : classical_gamma dchar.trivial_one s ≠ complex.zero := classical_gamma.ne_zero_re_pos dchar.trivial_one s (by linarith)
  rw [classical_L.zeta_fn_eq_inv_gamma_mul_Lambda s hs0 hs1 hgam, hLam_eq]
  have hc := complex.mul_inv_cancel (classical_gamma dchar.trivial_one s) hgam
  have hre : complex.mul (complex.inv (classical_gamma dchar.trivial_one s)) (complex.mul (classical_gamma dchar.trivial_one s) (zeta_em2 s)) = complex.mul (complex.mul (classical_gamma dchar.trivial_one s) (complex.inv (classical_gamma dchar.trivial_one s))) (zeta_em2 s) := by ring
  rw [hre, hc, complex.one_mul]

-- ====================================================================================
-- 4. RIGHT-CONTINUITY AT Re(s) = 1 & HADAMARD-DE LA VALLEE POUSSIN NONVANISHING (CLAUSE 7)
-- ====================================================================================

-- Sequential continuity of `gamma` on the strip 1/2 <= Re(w) <= 1!
+ gamma.continuous_seq_half_to_one (w_seq : ℕ → ℂ) (w0 : ℂ)
    (hw0_lo : 1 / 2 ≤ complex.re w0) (hw0_hi : complex.re w0 ≤ 1)
    (hseq_lo : ∀ n : ℕ, 1 / 2 ≤ complex.re (w_seq n)) (hseq_hi : ∀ n : ℕ, complex.re (w_seq n) ≤ 1)
    (hlim : ctends_to w_seq w0) :
    ctends_to (fun n => gamma (w_seq n)) (gamma w0)
  -- Helper: uniform tail bound |gamma w - gamma_trunc w a b| <= 2 * rpow a (1/2) + 4 * exp(-(b/2)) for ALL 1/2 <= Re w <= 1, 0 < a <= 1 <= b!
  have htail_unif : ∀ (w : ℂ) (a b : ℝ), 1 / 2 ≤ complex.re w → complex.re w ≤ 1 → 0 < a → a ≤ 1 → 1 ≤ b →
      complex.abs (complex.sub (gamma w) (gamma_trunc w a b)) ≤ 2 * rpow a (1 / 2) + 4 * exp (-(b / 2))
    intro w a b hw1 hw2 ha ha1 hb1
    by_contra hgt
    set gap := complex.abs (complex.sub (gamma w) (gamma_trunc w a b)) - (2 * rpow a (1 / 2) + 4 * exp (-(b / 2))) with hgap
    have hgap_pos : 0 < gap := by rw [hgap]; linarith
    obtain ⟨A0, B0, hA0_pos, hB0_ge1, hgen⟩ := gamma.eq_integral_general_re_pos w (by linarith) (gap / 2) (by linarith)
    set a' := min a A0 with ha'
    set b' := max b B0 with hb'
    have ha'_pos : 0 < a' := by rw [ha']; exact lt_min.real a A0 0 ha hA0_pos
    have ha'_le_a : a' ≤ a := by rw [ha']; exact min_le_left.real a A0
    have ha'_le_A0 : a' ≤ A0 := by rw [ha']; exact min_le_right.real a A0
    have hb_le_b' : b ≤ b' := by rw [hb']; exact le_max_left.real b B0
    have hB0_le_b' : B0 ≤ b' := by rw [hb']; exact le_max_right.real b B0
    have hnear := hgen a' b' ha'_pos ha'_le_A0 hB0_le_b'
    have hI_all := gamma_trunc.has_integral w a' b' ha'_pos (by linarith)
    have hI_1 := gamma_trunc.has_integral w a' a ha'_pos ha'_le_a
    have hI_2 := gamma_trunc.has_integral w a b ha (by linarith)
    have hI_3 := gamma_trunc.has_integral w b b' (by linarith) hb_le_b'
    have hadj1 := c_has_integral.adjacent (gamma_integrand w) a' a b (gamma_trunc w a' a) (gamma_trunc w a b) hI_1 hI_2
    have hadj2 := c_has_integral.adjacent (gamma_integrand w) a' b b' (complex.add (gamma_trunc w a' a) (gamma_trunc w a b)) (gamma_trunc w b b') hadj1 hI_3
    have hu := c_has_integral.unique (gamma_integrand w) a' b' (gamma_trunc w a' b') (complex.add (complex.add (gamma_trunc w a' a) (gamma_trunc w a b)) (gamma_trunc w b b')) hI_all hadj2
    have htb := gamma_trunc.tail_bounds w (by linarith) 1 (by simp)
    have hs1 := htb.1 a' a ha'_pos ha'_le_a ha1
    have hs2 := htb.2.1 b b' hb1 hb_le_b'
    have h2K1 : 2 * ((2 : ℝ) ^ 1 * ((fact 1 : ℕ) : ℝ)) = 4 := by rw [pow_one.real]; unfold fact; simp
    rw [h2K1] at hs2
    have ha_pow : rpow a (complex.re w) / complex.re w ≤ 2 * rpow a (1 / 2)
      have hlog : log a ≤ 0 := by have h := (log_le_log a 1 ha (by decide)).mpr ha1; rw [log_one] at h; exact h
      have hr_le : rpow a (complex.re w) ≤ rpow a (1 / 2) := by unfold rpow; exact (exp_le_exp (complex.re w * log a) ((1 / 2) * log a)).mpr (by nlinarith)
      exact (div_le_iff.real (rpow a (complex.re w)) (2 * rpow a (1 / 2)) (complex.re w) (by linarith)).mpr (by nlinarith [rpow.pos a (1 / 2)])
    have hsplit : complex.sub (gamma w) (gamma_trunc w a b) = complex.add (complex.neg (complex.sub (gamma_trunc w a' b') (gamma w))) (complex.add (gamma_trunc w a' a) (gamma_trunc w b b'))
      rw [hu]; apply complex.ext <;> simp <;> ring
    rw [hsplit] at hgap
    have ht1 := complex.abs_add_le (complex.neg (complex.sub (gamma_trunc w a' b') (gamma w))) (complex.add (gamma_trunc w a' a) (gamma_trunc w b b'))
    have ht2 := complex.abs_add_le (gamma_trunc w a' a) (gamma_trunc w b b')
    rw [complex.abs_neg] at ht1; linarith
  unfold ctends_to at hlim ⊢; intro e he
  -- Pick a in (0, 1] with 2 * rpow a (1/2) < e / 6 and b >= 1 with 4 * exp(-(b/2)) < e / 6!
  set a := min 1 ((e / 14) * (e / 14)) with ha_def
  have ha_pos : 0 < a := by rw [ha_def]; exact lt_min.real 1 ((e / 14) * (e / 14)) 0 (by decide) (by nlinarith)
  have ha_le1 : a ≤ 1 := by rw [ha_def]; exact min_le_left.real 1 ((e / 14) * (e / 14))
  have ha_sq : a ≤ (e / 14) * (e / 14) := by rw [ha_def]; exact min_le_right.real 1 ((e / 14) * (e / 14))
  have ha_small : 2 * rpow a (1 / 2) < e / 6
    have hr_sq : rpow a (1 / 2) * rpow a (1 / 2) = a
      rw [← rpow.add]; have h1 : (1 / 2 : ℝ) + 1 / 2 = 1 := by ring
      rw [h1]; unfold rpow; simp [exp_log a ha_pos]
    have hpos := rpow.pos a (1 / 2)
    have hle : rpow a (1 / 2) ≤ e / 14 := by nlinarith
    linarith
  set b := max 1 (2 * log (25 / e + 1)) with hb_def
  have hb_ge1 : 1 ≤ b := by rw [hb_def]; exact le_max_left.real 1 (2 * log (25 / e + 1))
  have hb_small : 4 * exp (-(b / 2)) < e / 6
    have h1 : log (25 / e + 1) ≤ b / 2 := by rw [hb_def]; linarith [le_max_right.real 1 (2 * log (25 / e + 1))]
    have h2 : 25 / e + 1 ≤ exp (b / 2)
      have hpos : 0 < 25 / e + 1 := by have hd := div_pos.real 25 e (by decide) he; linarith
      have h := (exp_le_exp (log (25 / e + 1)) (b / 2)).mpr h1
      rw [exp_log (25 / e + 1) hpos] at h; exact h
    have hinv : exp (-(b / 2)) * exp (b / 2) = 1
      rw [← exp_add]; have h0 : -(b / 2) + b / 2 = 0 := by ring
      rw [h0, exp_zero]
    have hm1 := mul_le_mul_of_nonneg_left.real (25 / e + 1) (exp (b / 2)) (exp (-(b / 2))) h2 (by linarith [exp_pos (-(b / 2))])
    have hm2 := mul_le_mul_of_nonneg_right.real (exp (-(b / 2)) * (25 / e + 1)) 1 e (by linarith) (by linarith)
    have hce := mul_inv_cancel.real e (by linarith)
    have hre : exp (-(b / 2)) * (25 / e + 1) * e = (25 + e) * exp (-(b / 2))
      rw [div_def.real 25 e]; linear_combination (25 * exp (-(b / 2))) * hce
    nlinarith [exp_pos (-(b / 2))]
  -- On compact [a, b], |gamma_integrand w_n t - gamma_integrand w0 t| <= K_ab * |w_n - w0| for |w_n - w0| <= 1/(L+1)!
  set L := max (|log a|) (|log b|) + 1 with hL
  have hL_pos : 0 < L := by rw [hL]; linarith [le_max_left.real (|log a|) (|log b|), abs_nonneg.real (log a)]
  set K_ab := (1 + 6 * exp 1) * (1 / a) * L * b + 1 with hKab
  have h1a_pos : 0 < 1 / a := one_div_pos.real a ha_pos
  have hC1_pos : 0 < (1 + 6 * exp 1) * (1 / a) * L
    have h1 := mul_pos.real (1 + 6 * exp 1) (1 / a) (by linarith [exp_pos 1]) h1a_pos
    exact mul_pos.real ((1 + 6 * exp 1) * (1 / a)) L h1 hL_pos
  have hKab_pos : 0 < K_ab
    rw [hKab]; have h2 := mul_pos.real ((1 + 6 * exp 1) * (1 / a) * L) b hC1_pos (by linarith); linarith
  set delta := min (1 / L) (e / (3 * K_ab)) with hdelta
  have hdelta_pos : 0 < delta := by rw [hdelta]; exact lt_min.real (1 / L) (e / (3 * K_ab)) 0 (one_div_pos.real L hL_pos) (div_pos.real e (3 * K_ab) he (by linarith))
  obtain ⟨N0, hN0⟩ := hlim delta hdelta_pos
  use N0; intro n hn
  have hwn := hN0 n hn
  have hwn_L : complex.abs (complex.sub (w_seq n) w0) < 1 / L := by linarith [min_le_left.real (1 / L) (e / (3 * K_ab))]
  have hwn_e : complex.abs (complex.sub (w_seq n) w0) < e / (3 * K_ab) := by linarith [min_le_right.real (1 / L) (e / (3 * K_ab))]
  have htd0 := htail_unif w0 a b hw0_lo hw0_hi ha_pos ha_le1 hb_ge1
  have htdn := htail_unif (w_seq n) a b (hseq_lo n) (hseq_hi n) ha_pos ha_le1 hb_ge1
  -- Compact integral diff |gamma_trunc (w_seq n) a b - gamma_trunc w0 a b| < e / 3!
  have hcomp_lt : complex.abs (complex.sub (gamma_trunc (w_seq n) a b) (gamma_trunc w0 a b)) < e / 3
    have hI1 := gamma_trunc.has_integral (w_seq n) a b ha_pos (by linarith)
    have hI0 := gamma_trunc.has_integral w0 a b ha_pos (by linarith)
    have hId := c_has_integral.sub (gamma_integrand (w_seq n)) (gamma_integrand w0) a b (gamma_trunc (w_seq n) a b) (gamma_trunc w0 a b) hI1 hI0
    have hpt : ∀ t : ℝ, a ≤ t → t ≤ b → complex.abs (complex.sub (gamma_integrand (w_seq n) t) (gamma_integrand w0 t)) ≤ (1 + 6 * exp 1) * (1 / a) * L * complex.abs (complex.sub (w_seq n) w0)
      intro t ht1 ht2
      unfold gamma_integrand
      have hfac : complex.sub (complex.smul (exp (-t)) (cpow_real t (complex.sub (w_seq n) complex.one))) (complex.smul (exp (-t)) (cpow_real t (complex.sub w0 complex.one))) = complex.mul (complex.of_real (exp (-t))) (complex.sub (cpow_real t (complex.sub (w_seq n) complex.one)) (cpow_real t (complex.sub w0 complex.one)))
        unfold complex.of_real; apply complex.ext <;> simp <;> ring
      rw [hfac, complex.abs_mul]
      have hof : complex.abs (complex.of_real (exp (-t))) = exp (-t)
        have hsq : complex.abs (complex.of_real (exp (-t))) * complex.abs (complex.of_real (exp (-t))) = exp (-t) * exp (-t)
          rw [complex.abs_sq]; unfold complex.norm_sq complex.of_real; simp
        exact eq_of_sq_eq_nonneg (complex.abs (complex.of_real (exp (-t)))) (exp (-t)) (complex.abs_nonneg (complex.of_real (exp (-t)))) (by linarith [exp_pos (-t)]) hsq
      have he1 : exp (-t) ≤ 1 := by have h := (exp_le_exp (-t) 0).mpr (by linarith); rw [exp_zero] at h; exact h
      rw [hof]
      have hlog_bd : |log t| ≤ L
        have h1 : log a ≤ log t := (log_le_log a t ha_pos (by linarith)).mpr ht1
        have h2 : log t ≤ log b := (log_le_log t b (by linarith) (by linarith)).mpr ht2
        have h3 := abs_le_of.real (log t) (max (|log a|) (|log b|)) (by linarith [neg_le_abs.real (log a), le_max_left.real (|log a|) (|log b|)]) (by linarith [le_abs_self.real (log b), le_max_right.real (|log a|) (|log b|)])
        rw [hL]; linarith
      unfold cpow_real
      have hsub_exp := cexp.sub_abs_le (complex.smul (log t) (complex.sub (w_seq n) complex.one)) (complex.smul (log t) (complex.sub w0 complex.one))
      have harg_diff : complex.sub (complex.smul (log t) (complex.sub (w_seq n) complex.one)) (complex.smul (log t) (complex.sub w0 complex.one)) = complex.mul (complex.of_real (log t)) (complex.sub (w_seq n) w0)
        unfold complex.of_real; apply complex.ext <;> simp <;> ring
      rw [harg_diff, complex.abs_mul] at hsub_exp
      have hof_l : complex.abs (complex.of_real (log t)) = |log t|
        have hsq : complex.abs (complex.of_real (log t)) * complex.abs (complex.of_real (log t)) = |log t| * |log t|
          rw [complex.abs_sq]; unfold complex.norm_sq complex.of_real; simp; exact (sq_abs.real (log t)).symm
        exact eq_of_sq_eq_nonneg (complex.abs (complex.of_real (log t))) (|log t|) (complex.abs_nonneg (complex.of_real (log t))) (abs_nonneg.real (log t)) hsq
      rw [hof_l] at hsub_exp
      have harg_le1 : |log t| * complex.abs (complex.sub (w_seq n) w0) ≤ 1
        have h1 := (lt_div_iff.real (complex.abs (complex.sub (w_seq n) w0)) 1 L hL_pos).mp hwn_L
        have h2 := mul_le_mul_of_nonneg_right.real (|log t|) L (complex.abs (complex.sub (w_seq n) w0)) hlog_bd (complex.abs_nonneg (complex.sub (w_seq n) w0))
        linarith
      have hexp_le_e : exp (|log t| * complex.abs (complex.sub (w_seq n) w0)) ≤ exp 1 := (exp_le_exp (|log t| * complex.abs (complex.sub (w_seq n) w0)) 1).mpr harg_le1
      have hfac1 : 1 + 6 * exp (|log t| * complex.abs (complex.sub (w_seq n) w0)) * (|log t| * complex.abs (complex.sub (w_seq n) w0)) ≤ 1 + 6 * exp 1
        have h1 := mul_le_mul_of_nonneg_left.real (|log t| * complex.abs (complex.sub (w_seq n) w0)) 1 (exp (|log t| * complex.abs (complex.sub (w_seq n) w0))) harg_le1 (by linarith [exp_pos (|log t| * complex.abs (complex.sub (w_seq n) w0))])
        linarith
      have hrew_le : exp (complex.re (complex.smul (log t) (complex.sub w0 complex.one))) ≤ 1 / a
        simp
        have h1 : log t * (complex.re w0 - 1) ≤ -log a
          by_cases ht_ge1 : 1 ≤ t
          · have hlt_nn := log_nonneg t ht_ge1
            have hla_np : log a ≤ 0 := by have h := (log_le_log a 1 ha_pos (by decide)).mpr ha_le1; rw [log_one] at h; exact h
            have hnn := mul_nonneg.real (log t) (1 - complex.re w0) hlt_nn (by linarith)
            linarith
          · have hlt_np : log t ≤ 0 := by have h := (log_le_log t 1 (by linarith) (by decide)).mpr (by linarith); rw [log_one] at h; exact h
            have hla_le : log a ≤ log t := (log_le_log a t ha_pos (by linarith)).mpr ht1
            have hm1 := mul_le_mul_of_nonneg_left.real (1 - complex.re w0) 1 (-log t) (by linarith) (by linarith)
            linarith
        have h2 := (exp_le_exp (log t * (complex.re w0 - 1)) (-log a)).mpr h1
        have hexp_inv : exp (-log a) = 1 / a
          have hp : exp (-log a) * a = 1
            have h := (exp_log a ha_pos).symm
            have h0 : -log a + log a = 0 := by ring
            calc exp (-log a) * a = exp (-log a) * exp (log a) := by rw [← h]
              _ = exp (-log a + log a) := (exp_add (-log a) (log a)).symm
              _ = exp 0 := by rw [h0]
              _ = 1 := exp_zero
          exact (eq_div_iff.real (exp (-log a)) 1 a (by linarith)).mpr hp
        rw [hexp_inv] at h2; exact h2
      have hM_nn : 0 ≤ (1 + 6 * exp 1) * (1 / a) * L * complex.abs (complex.sub (w_seq n) w0) :=
        mul_nonneg.real ((1 + 6 * exp 1) * (1 / a) * L) (complex.abs (complex.sub (w_seq n) w0)) (by linarith) (complex.abs_nonneg (complex.sub (w_seq n) w0))
      have hprod_le : (1 + 6 * exp (|log t| * complex.abs (complex.sub (w_seq n) w0)) * (|log t| * complex.abs (complex.sub (w_seq n) w0))) * exp (complex.re (complex.smul (log t) (complex.sub w0 complex.one))) * (|log t| * complex.abs (complex.sub (w_seq n) w0)) ≤ (1 + 6 * exp 1) * (1 / a) * L * complex.abs (complex.sub (w_seq n) w0)
        have harg_nn : 0 ≤ |log t| * complex.abs (complex.sub (w_seq n) w0) := mul_nonneg.real (|log t|) (complex.abs (complex.sub (w_seq n) w0)) (abs_nonneg.real (log t)) (complex.abs_nonneg (complex.sub (w_seq n) w0))
        have hm1 := mul_le_mul_of_nonneg_right.real (1 + 6 * exp (|log t| * complex.abs (complex.sub (w_seq n) w0)) * (|log t| * complex.abs (complex.sub (w_seq n) w0))) (1 + 6 * exp 1) (exp (complex.re (complex.smul (log t) (complex.sub w0 complex.one)))) hfac1 (by linarith [exp_pos (complex.re (complex.smul (log t) (complex.sub w0 complex.one)))])
        have hm2 := mul_le_mul_of_nonneg_left.real (exp (complex.re (complex.smul (log t) (complex.sub w0 complex.one)))) (1 / a) (1 + 6 * exp 1) hrew_le (by linarith [exp_pos 1])
        have hm3 := mul_le_mul_of_nonneg_right.real ((1 + 6 * exp (|log t| * complex.abs (complex.sub (w_seq n) w0)) * (|log t| * complex.abs (complex.sub (w_seq n) w0))) * exp (complex.re (complex.smul (log t) (complex.sub w0 complex.one)))) ((1 + 6 * exp 1) * (1 / a)) (|log t| * complex.abs (complex.sub (w_seq n) w0)) (by linarith) harg_nn
        have hm4 := mul_le_mul_of_nonneg_left.real (|log t|) L ((1 + 6 * exp 1) * (1 / a)) hlog_bd (by linarith [mul_pos.real (1 + 6 * exp 1) (1 / a) (by linarith [exp_pos 1]) h1a_pos])
        have hm5 := mul_le_mul_of_nonneg_right.real ((1 + 6 * exp 1) * (1 / a) * |log t|) ((1 + 6 * exp 1) * (1 / a) * L) (complex.abs (complex.sub (w_seq n) w0)) hm4 (complex.abs_nonneg (complex.sub (w_seq n) w0))
        linarith
      have hmul_e := mul_le_mul_of_nonneg_right.real (exp (-t)) 1 ((1 + 6 * exp 1) * (1 / a) * L * complex.abs (complex.sub (w_seq n) w0)) he1 hM_nn
      have hmul_c := mul_le_mul_of_nonneg_left.real (complex.abs (complex.sub (complex.exp (complex.smul (log t) (complex.sub (w_seq n) complex.one))) (complex.exp (complex.smul (log t) (complex.sub w0 complex.one))))) ((1 + 6 * exp 1) * (1 / a) * L * complex.abs (complex.sub (w_seq n) w0)) (exp (-t)) (by linarith) (by linarith [exp_pos (-t)])
      linarith
    have hM_nn : 0 ≤ (1 + 6 * exp 1) * (1 / a) * L * complex.abs (complex.sub (w_seq n) w0) :=
      mul_nonneg.real ((1 + 6 * exp 1) * (1 / a) * L) (complex.abs (complex.sub (w_seq n) w0)) (by linarith) (complex.abs_nonneg (complex.sub (w_seq n) w0))
    have hml := c_has_integral.abs_le (fun t => complex.sub (gamma_integrand (w_seq n) t) (gamma_integrand w0 t)) a b ((1 + 6 * exp 1) * (1 / a) * L * complex.abs (complex.sub (w_seq n) w0)) (complex.sub (gamma_trunc (w_seq n) a b) (gamma_trunc w0 a b)) (by linarith) hM_nn hId hpt
    have hlen := mul_le_mul_of_nonneg_left.real (b - a) b ((1 + 6 * exp 1) * (1 / a) * L * complex.abs (complex.sub (w_seq n) w0)) (by linarith) hM_nn
    have hlt1 := (lt_div_iff.real (complex.abs (complex.sub (w_seq n) w0)) e (3 * K_ab) (by linarith)).mp hwn_e
    rw [hKab] at hlt1
    have hre : (1 + 6 * exp 1) * (1 / a) * L * complex.abs (complex.sub (w_seq n) w0) * b = ((1 + 6 * exp 1) * (1 / a) * L * b) * complex.abs (complex.sub (w_seq n) w0) := by ring
    nlinarith [complex.abs_nonneg (complex.sub (w_seq n) w0)]
  have hsplit : complex.sub (gamma (w_seq n)) (gamma w0) = complex.add (complex.sub (gamma (w_seq n)) (gamma_trunc (w_seq n) a b)) (complex.add (complex.sub (gamma_trunc (w_seq n) a b) (gamma_trunc w0 a b)) (complex.neg (complex.sub (gamma w0) (gamma_trunc w0 a b)))) := by ring
  rw [hsplit]
  have ht1 := complex.abs_add_le (complex.sub (gamma (w_seq n)) (gamma_trunc (w_seq n) a b)) (complex.add (complex.sub (gamma_trunc (w_seq n) a b) (gamma_trunc w0 a b)) (complex.neg (complex.sub (gamma w0) (gamma_trunc w0 a b))))
  have ht2 := complex.abs_add_le (complex.sub (gamma_trunc (w_seq n) a b) (gamma_trunc w0 a b)) (complex.neg (complex.sub (gamma w0) (gamma_trunc w0 a b)))
  rw [complex.abs_neg] at ht2; linarith

-- Sequential continuity of `classical_Lambda_triv` on the strip 1 <= Re(s) <= 2, s != 1!
+ classical_Lambda_triv.continuous_seq_strip (s_seq : ℕ → ℂ) (s0 : ℂ)
    (hs0_lo : 1 ≤ complex.re s0) (hs0_hi : complex.re s0 ≤ 2) (hs0_ne1 : s0 ≠ complex.one)
    (hseq_lo : ∀ n : ℕ, 1 ≤ complex.re (s_seq n)) (hseq_hi : ∀ n : ℕ, complex.re (s_seq n) ≤ 2)
    (hlim : ctends_to s_seq s0) :
    ctends_to (fun n => classical_Lambda_triv (s_seq n)) (classical_Lambda_triv s0)
  -- Uniform exponential bound |riemann_theta_integrand s u| <= 4 * exp(-u) for ALL 1 <= Re s <= 2, u >= 1!
  have hunif_tail : ∀ (s : ℂ) (B : ℝ), 1 ≤ complex.re s → complex.re s ≤ 2 → 1 ≤ B →
      complex.abs (complex.sub (riemann_theta_tail_int s) (cint (riemann_theta_integrand s) 1 B)) ≤ 4 * exp (-B)
    intro s B hs1 hs2 hB
    have hp := riemann_theta_integrand.props s
    have hbd4 : ∀ u : ℝ, 1 ≤ u → complex.abs (riemann_theta_integrand s u) ≤ 4 * exp (-1 * u)
      intro u hu
      have hpsi := jacobi_psi.spec_and_bounds u (by linarith)
      have hpi_ge3 : 3 ≤ pi := by linarith [pi_bounds.1]
      have hepi_lt : exp (-pi) < 1 / 2
        have h1 : (2 : ℝ) < exp pi := by linarith [exp_ge_one_add pi]
        have hinv : exp (-pi) * exp pi = 1
          rw [← exp_add]; have h0 : -pi + pi = 0 := by ring
          rw [h0, exp_zero]
        have hm := mul_lt_mul_of_pos_left.real 2 (exp pi) (exp (-pi)) h1 (exp_pos (-pi))
        linarith
      have hpsi_le : jacobi_psi u ≤ 2 * exp (-u)
        have h1 : exp (-pi * u) ≤ exp (-pi) := (exp_le_exp (-pi * u) (-pi)).mpr (by nlinarith)
        have hdiv : exp (-pi * u) / (1 - exp (-pi * u)) ≤ 2 * exp (-pi * u) :=
          (div_le_iff.real (exp (-pi * u)) (2 * exp (-pi * u)) (1 - exp (-pi * u)) (by linarith)).mpr (by nlinarith [exp_pos (-pi * u)])
        have he2 : exp (-pi * u) ≤ exp (-u) := (exp_le_exp (-pi * u) (-u)).mpr (by nlinarith)
        linarith [hpsi.2.2]
      have habs_p_le1 : ∀ w : ℂ, complex.re w ≤ 0 → complex.abs (cpow_real u w) ≤ 1
        intro w hw
        have hsq : complex.abs (cpow_real u w) * complex.abs (cpow_real u w) = rpow u (complex.re w) * rpow u (complex.re w)
          rw [complex.abs_sq]; unfold complex.norm_sq cpow_real rpow; simp
          have h1 : log u * complex.re w = complex.re w * log u := by ring
          rw [h1]; linear_combination (exp (complex.re w * log u) * exp (complex.re w * log u)) * sin_sq_add_cos_sq (log u * complex.im w)
        have heq := eq_of_sq_eq_nonneg (complex.abs (cpow_real u w)) (rpow u (complex.re w)) (complex.abs_nonneg (cpow_real u w)) (by linarith [rpow.pos u (complex.re w)]) hsq
        rw [heq]; unfold rpow
        have h := (exp_le_exp (complex.re w * log u) 0).mpr (by nlinarith [log_nonneg u hu])
        rw [exp_zero] at h; exact h
      set w1 := complex.sub (complex.smul (1 / 2) s) complex.one with hw1
      set w2 := complex.sub (complex.smul (1 / 2) (complex.sub complex.one s)) complex.one with hw2
      have hrti : riemann_theta_integrand s u = complex.mul (complex.of_real (jacobi_psi u)) (complex.add (cpow_real u w1) (cpow_real u w2))
        unfold riemann_theta_integrand complex.of_real; rw [hw1, hw2]; apply complex.ext <;> simp <;> ring
      rw [hrti, complex.abs_mul]
      have hof : complex.abs (complex.of_real (jacobi_psi u)) = jacobi_psi u
        have hsq : complex.abs (complex.of_real (jacobi_psi u)) * complex.abs (complex.of_real (jacobi_psi u)) = jacobi_psi u * jacobi_psi u
          rw [complex.abs_sq]; unfold complex.norm_sq complex.of_real; simp
        exact eq_of_sq_eq_nonneg (complex.abs (complex.of_real (jacobi_psi u))) (jacobi_psi u) (complex.abs_nonneg (complex.of_real (jacobi_psi u))) hpsi.2.1 hsq
      rw [hof]
      have htri := complex.abs_add_le (cpow_real u w1) (cpow_real u w2)
      have hp1 : complex.abs (cpow_real u w1) ≤ 1 := habs_p_le1 w1 (by rw [hw1]; simp; linarith)
      have hp2 : complex.abs (cpow_real u w2) ≤ 1 := habs_p_le1 w2 (by rw [hw2]; simp; linarith)
      have hm := mul_le_mul_of_nonneg_left.real (complex.abs (complex.add (cpow_real u w1) (cpow_real u w2))) 2 (jacobi_psi u) (by linarith) hpsi.2.1
      have h1u : -1 * u = -u := by ring
      rw [h1u]; linarith
    have himp := (improper_cint.of_exp_bound (riemann_theta_integrand s) 4 1 (by decide) (by decide) hp.1 hp.2.1 hbd4).2 B hB
    have h41 : (4 : ℝ) / 1 = 4 := by rw [div_def.real]; have h := mul_inv_cancel.real 1 (by decide); linarith
    have h1B : -1 * B = -B := by ring
    rw [h41, h1B] at himp; exact himp
  -- Continuity of `riemann_theta_tail_int (s_seq n) -> riemann_theta_tail_int s0`:
  have htail_lim : ctends_to (fun n => riemann_theta_tail_int (s_seq n)) (riemann_theta_tail_int s0)
    unfold ctends_to; intro e he
    set B := max 1 (log (13 / e + 1)) with hB_def
    have hB_ge1 : 1 ≤ B := by rw [hB_def]; exact le_max_left.real 1 (log (13 / e + 1))
    have htail_lt : 4 * exp (-B) < e / 3
      have h1 : log (13 / e + 1) ≤ B := by rw [hB_def]; exact le_max_right.real 1 (log (13 / e + 1))
      have h2 : 13 / e + 1 ≤ exp B
        have hpos : 0 < 13 / e + 1 := by have hd := div_pos.real 13 e (by decide) he; linarith
        have h := (exp_le_exp (log (13 / e + 1)) B).mpr h1
        rw [exp_log (13 / e + 1) hpos] at h; exact h
      have hinv : exp (-B) * exp B = 1
        rw [← exp_add]; have h0 : -B + B = 0 := by ring
        rw [h0, exp_zero]
      have hm1 := mul_le_mul_of_nonneg_left.real (13 / e + 1) (exp B) (exp (-B)) h2 (by linarith [exp_pos (-B)])
      have hm2 := mul_le_mul_of_nonneg_right.real (exp (-B) * (13 / e + 1)) 1 e (by linarith) (by linarith)
      have hce := mul_inv_cancel.real e (by linarith)
      have hre : exp (-B) * (13 / e + 1) * e = (13 + e) * exp (-B)
        rw [div_def.real 13 e]; linear_combination (13 * exp (-B)) * hce
      nlinarith [exp_pos (-B)]
    set L := log B + 1 with hL
    have hL_pos : 0 < L := by rw [hL]; linarith [log_nonneg B hB_ge1]
    set KB := 4 * (1 + 6 * exp 1) * L * B + 1 with hKB
    have hKB_pos : 0 < KB := by rw [hKB]; nlinarith [exp_pos 1]
    set delta := min (1 / L) (e / (3 * KB)) with hdelta
    have hdelta_pos : 0 < delta := by rw [hdelta]; exact lt_min.real (1 / L) (e / (3 * KB)) 0 (one_div_pos.real L hL_pos) (div_pos.real e (3 * KB) he (by linarith))
    unfold ctends_to at hlim
    obtain ⟨N0, hN0⟩ := hlim delta hdelta_pos
    use N0; intro n hn
    have hsn := hN0 n hn
    have hsn_L : complex.abs (complex.sub (s_seq n) s0) < 1 / L := by linarith [min_le_left.real (1 / L) (e / (3 * KB))]
    have hsn_e : complex.abs (complex.sub (s_seq n) s0) < e / (3 * KB) := by linarith [min_le_right.real (1 / L) (e / (3 * KB))]
    have ht0 := hunif_tail s0 B hs0_lo hs0_hi hB_ge1
    have htn := hunif_tail (s_seq n) B (hseq_lo n) (hseq_hi n) hB_ge1
    -- Compact integral diff on [1, B] < e / 3!
    have hcomp_lt : complex.abs (complex.sub (cint (riemann_theta_integrand (s_seq n)) 1 B) (cint (riemann_theta_integrand s0) 1 B)) < e / 3
      have hpn := riemann_theta_integrand.props (s_seq n)
      have hp0 := riemann_theta_integrand.props s0
      have hIn : c_has_integral (riemann_theta_integrand (s_seq n)) 1 B (cint (riemann_theta_integrand (s_seq n)) 1 B)
        obtain ⟨Ir, hIr⟩ := darboux.continuous (fun x => complex.re (riemann_theta_integrand (s_seq n) x)) 1 B hB_ge1 (by intro t h1 h2; exact hpn.1 t h1)
        obtain ⟨Ii, hIi⟩ := darboux.continuous (fun x => complex.im (riemann_theta_integrand (s_seq n) x)) 1 B hB_ge1 (by intro t h1 h2; exact hpn.2.1 t h1)
        have hI : c_has_integral (riemann_theta_integrand (s_seq n)) 1 B (complex.mk Ir Ii) := by unfold c_has_integral; simp; exact ⟨hIr, hIi⟩
        rw [cint.eq_of_has_integral (riemann_theta_integrand (s_seq n)) 1 B (complex.mk Ir Ii) hI]; exact hI
      have hI0 : c_has_integral (riemann_theta_integrand s0) 1 B (cint (riemann_theta_integrand s0) 1 B)
        obtain ⟨Ir, hIr⟩ := darboux.continuous (fun x => complex.re (riemann_theta_integrand s0 x)) 1 B hB_ge1 (by intro t h1 h2; exact hp0.1 t h1)
        obtain ⟨Ii, hIi⟩ := darboux.continuous (fun x => complex.im (riemann_theta_integrand s0 x)) 1 B hB_ge1 (by intro t h1 h2; exact hp0.2.1 t h1)
        have hI : c_has_integral (riemann_theta_integrand s0) 1 B (complex.mk Ir Ii) := by unfold c_has_integral; simp; exact ⟨hIr, hIi⟩
        rw [cint.eq_of_has_integral (riemann_theta_integrand s0) 1 B (complex.mk Ir Ii) hI]; exact hI
      have hId := c_has_integral.sub (riemann_theta_integrand (s_seq n)) (riemann_theta_integrand s0) 1 B (cint (riemann_theta_integrand (s_seq n)) 1 B) (cint (riemann_theta_integrand s0) 1 B) hIn hI0
      have hpt : ∀ u : ℝ, 1 ≤ u → u ≤ B → complex.abs (complex.sub (riemann_theta_integrand (s_seq n) u) (riemann_theta_integrand s0 u)) ≤ 4 * (1 + 6 * exp 1) * L * complex.abs (complex.sub (s_seq n) s0)
        intro u hu1 hu2
        have hpsi := jacobi_psi.spec_and_bounds u (by linarith)
        have hpi_ge3 : 3 ≤ pi := by linarith [pi_bounds.1]
        have hepi_lt : exp (-pi) < 1 / 2
          have h1 : (2 : ℝ) < exp pi := by linarith [exp_ge_one_add pi]
          have hinv : exp (-pi) * exp pi = 1
            rw [← exp_add]; have h0 : -pi + pi = 0 := by ring
            rw [h0, exp_zero]
          have hm := mul_lt_mul_of_pos_left.real 2 (exp pi) (exp (-pi)) h1 (exp_pos (-pi))
          linarith
        have hpsi_le2 : jacobi_psi u ≤ 2
          have h1 : exp (-pi * u) ≤ exp (-pi) := (exp_le_exp (-pi * u) (-pi)).mpr (by nlinarith)
          have hdiv : exp (-pi * u) / (1 - exp (-pi * u)) ≤ 2 * exp (-pi * u) :=
            (div_le_iff.real (exp (-pi * u)) (2 * exp (-pi * u)) (1 - exp (-pi * u)) (by linarith)).mpr (by nlinarith [exp_pos (-pi * u)])
          linarith [hpsi.2.2]
        have hlu_nn : 0 ≤ log u := log_nonneg u hu1
        have hlu_le : log u ≤ L := by have h := (log_le_log u B (by linarith) (by linarith)).mpr hu2; rw [hL]; linarith
        -- Helper bound for |u^z - u^w| when Re w <= 0 and |z - w| <= |s_n - s0|!
        have hcp_diff : ∀ z w : ℂ, complex.re w ≤ 0 → complex.abs (complex.sub z w) ≤ complex.abs (complex.sub (s_seq n) s0) →
            complex.abs (complex.sub (cpow_real u z) (cpow_real u w)) ≤ (1 + 6 * exp 1) * L * complex.abs (complex.sub (s_seq n) s0)
          intro z w hrew hzw
          unfold cpow_real
          have hse := cexp.sub_abs_le (complex.smul (log u) z) (complex.smul (log u) w)
          have had : complex.sub (complex.smul (log u) z) (complex.smul (log u) w) = complex.mul (complex.of_real (log u)) (complex.sub z w)
            unfold complex.of_real; apply complex.ext <;> simp <;> ring
          rw [had, complex.abs_mul] at hse
          have hofl : complex.abs (complex.of_real (log u)) = log u
            have hsq : complex.abs (complex.of_real (log u)) * complex.abs (complex.of_real (log u)) = log u * log u
              rw [complex.abs_sq]; unfold complex.norm_sq complex.of_real; simp
            exact eq_of_sq_eq_nonneg (complex.abs (complex.of_real (log u))) (log u) (complex.abs_nonneg (complex.of_real (log u))) hlu_nn hsq
          rw [hofl] at hse
          have harg_le1 : log u * complex.abs (complex.sub z w) ≤ 1
            have h1 := (lt_div_iff.real (complex.abs (complex.sub (s_seq n) s0)) 1 L hL_pos).mp hsn_L
            have hm1 := mul_le_mul_of_nonneg_left.real (complex.abs (complex.sub z w)) (complex.abs (complex.sub (s_seq n) s0)) (log u) hzw hlu_nn
            have hm2 := mul_le_mul_of_nonneg_right.real (log u) L (complex.abs (complex.sub (s_seq n) s0)) hlu_le (complex.abs_nonneg (complex.sub (s_seq n) s0))
            linarith
          have he1 : exp (log u * complex.abs (complex.sub z w)) ≤ exp 1 := (exp_le_exp (log u * complex.abs (complex.sub z w)) 1).mpr harg_le1
          have hfac1 : 1 + 6 * exp (log u * complex.abs (complex.sub z w)) * (log u * complex.abs (complex.sub z w)) ≤ 1 + 6 * exp 1
            have hm := mul_le_mul_of_nonneg_left.real (log u * complex.abs (complex.sub z w)) 1 (exp (log u * complex.abs (complex.sub z w))) harg_le1 (by linarith [exp_pos (log u * complex.abs (complex.sub z w))])
            linarith
          have hrew_le1 : exp (complex.re (complex.smul (log u) w)) ≤ 1
            simp; have h := (exp_le_exp (log u * complex.re w) 0).mpr (by nlinarith); rw [exp_zero] at h; exact h
          have hm1 := mul_le_mul_of_nonneg_right.real (1 + 6 * exp (log u * complex.abs (complex.sub z w)) * (log u * complex.abs (complex.sub z w))) (1 + 6 * exp 1) (exp (complex.re (complex.smul (log u) w))) hfac1 (by linarith [exp_pos (complex.re (complex.smul (log u) w))])
          have hm2 := mul_le_mul_of_nonneg_left.real (exp (complex.re (complex.smul (log u) w))) 1 (1 + 6 * exp 1) hrew_le1 (by linarith [exp_pos 1])
          have hm3 := mul_le_mul_of_nonneg_right.real ((1 + 6 * exp (log u * complex.abs (complex.sub z w)) * (log u * complex.abs (complex.sub z w))) * exp (complex.re (complex.smul (log u) w))) (1 + 6 * exp 1) (log u * complex.abs (complex.sub z w)) (by linarith) (mul_nonneg.real (log u) (complex.abs (complex.sub z w)) hlu_nn (complex.abs_nonneg (complex.sub z w)))
          have hm4 := mul_le_mul_of_nonneg_left.real (complex.abs (complex.sub z w)) (complex.abs (complex.sub (s_seq n) s0)) (log u) hzw hlu_nn
          have hm5 := mul_le_mul_of_nonneg_right.real (log u) L (complex.abs (complex.sub (s_seq n) s0)) hlu_le (complex.abs_nonneg (complex.sub (s_seq n) s0))
          have hm6 := mul_le_mul_of_nonneg_left.real (log u * complex.abs (complex.sub z w)) (L * complex.abs (complex.sub (s_seq n) s0)) (1 + 6 * exp 1) (by linarith) (by linarith [exp_pos 1])
          linarith
        set z1 := complex.sub (complex.smul (1 / 2) (s_seq n)) complex.one with hz1
        set w1 := complex.sub (complex.smul (1 / 2) s0) complex.one with hw1
        set z2 := complex.sub (complex.smul (1 / 2) (complex.sub complex.one (s_seq n))) complex.one with hz2
        set w2 := complex.sub (complex.smul (1 / 2) (complex.sub complex.one s0)) complex.one with hw2
        have hfac : complex.sub (riemann_theta_integrand (s_seq n) u) (riemann_theta_integrand s0 u) = complex.mul (complex.of_real (jacobi_psi u)) (complex.add (complex.sub (cpow_real u z1) (cpow_real u w1)) (complex.sub (cpow_real u z2) (cpow_real u w2)))
          unfold riemann_theta_integrand complex.of_real; rw [hz1, hw1, hz2, hw2]; apply complex.ext <;> simp <;> ring
        rw [hfac, complex.abs_mul]
        have hofp : complex.abs (complex.of_real (jacobi_psi u)) = jacobi_psi u
          have hsq : complex.abs (complex.of_real (jacobi_psi u)) * complex.abs (complex.of_real (jacobi_psi u)) = jacobi_psi u * jacobi_psi u
            rw [complex.abs_sq]; unfold complex.norm_sq complex.of_real; simp
          exact eq_of_sq_eq_nonneg (complex.abs (complex.of_real (jacobi_psi u))) (jacobi_psi u) (complex.abs_nonneg (complex.of_real (jacobi_psi u))) hpsi.2.1 hsq
        rw [hofp]
        have habs_smul : ∀ (c : ℝ) (x : ℂ), 0 ≤ c → complex.abs (complex.smul c x) = c * complex.abs x
          intro c x hc
          have hsq : complex.abs (complex.smul c x) * complex.abs (complex.smul c x) = (c * complex.abs x) * (c * complex.abs x)
            have h1 := complex.abs_sq (complex.smul c x)
            have h2 := complex.abs_sq x
            unfold complex.norm_sq at h1 h2; simp at h1 h2
            linear_combination h1 - (c * c) * h2
          exact eq_of_sq_eq_nonneg (complex.abs (complex.smul c x)) (c * complex.abs x) (complex.abs_nonneg (complex.smul c x)) (mul_nonneg.real c (complex.abs x) hc (complex.abs_nonneg x)) hsq
        have hd1 : complex.abs (complex.sub z1 w1) ≤ complex.abs (complex.sub (s_seq n) s0)
          have hsub_eq : complex.sub z1 w1 = complex.smul (1 / 2) (complex.sub (s_seq n) s0)
            rw [hz1, hw1]; apply complex.ext <;> simp <;> ring
          rw [hsub_eq, habs_smul (1 / 2) (complex.sub (s_seq n) s0) (by decide)]; linarith [complex.abs_nonneg (complex.sub (s_seq n) s0)]
        have hd2 : complex.abs (complex.sub z2 w2) ≤ complex.abs (complex.sub (s_seq n) s0)
          have hsub_eq : complex.sub z2 w2 = complex.neg (complex.smul (1 / 2) (complex.sub (s_seq n) s0))
            rw [hz2, hw2]; apply complex.ext <;> simp <;> ring
          rw [hsub_eq, complex.abs_neg, habs_smul (1 / 2) (complex.sub (s_seq n) s0) (by decide)]; linarith [complex.abs_nonneg (complex.sub (s_seq n) s0)]
        have hb_1 := hcp_diff z1 w1 (by rw [hw1]; simp; linarith) hd1
        have hb_2 := hcp_diff z2 w2 (by rw [hw2]; simp; linarith) hd2
        have htri := complex.abs_add_le (complex.sub (cpow_real u z1) (cpow_real u w1)) (complex.sub (cpow_real u z2) (cpow_real u w2))
        have hm1 := mul_le_mul_of_nonneg_left.real (complex.abs (complex.add (complex.sub (cpow_real u z1) (cpow_real u w1)) (complex.sub (cpow_real u z2) (cpow_real u w2)))) (2 * (1 + 6 * exp 1) * L * complex.abs (complex.sub (s_seq n) s0)) (jacobi_psi u) (by linarith) hpsi.2.1
        have h2C_nn : 0 ≤ 2 * (1 + 6 * exp 1) * L * complex.abs (complex.sub (s_seq n) s0)
          have h1 := mul_pos.real (2 * (1 + 6 * exp 1)) L (by linarith [exp_pos 1]) hL_pos
          exact mul_nonneg.real (2 * (1 + 6 * exp 1) * L) (complex.abs (complex.sub (s_seq n) s0)) (by linarith) (complex.abs_nonneg (complex.sub (s_seq n) s0))
        have hm2 := mul_le_mul_of_nonneg_right.real (jacobi_psi u) 2 (2 * (1 + 6 * exp 1) * L * complex.abs (complex.sub (s_seq n) s0)) hpsi_le2 h2C_nn
        linarith
      have hM_nn : 0 ≤ 4 * (1 + 6 * exp 1) * L * complex.abs (complex.sub (s_seq n) s0)
        have h1 := mul_pos.real (4 * (1 + 6 * exp 1)) L (by linarith [exp_pos 1]) hL_pos
        exact mul_nonneg.real (4 * (1 + 6 * exp 1) * L) (complex.abs (complex.sub (s_seq n) s0)) (by linarith) (complex.abs_nonneg (complex.sub (s_seq n) s0))
      have hml := c_has_integral.abs_le (fun u => complex.sub (riemann_theta_integrand (s_seq n) u) (riemann_theta_integrand s0 u)) 1 B (4 * (1 + 6 * exp 1) * L * complex.abs (complex.sub (s_seq n) s0)) (complex.sub (cint (riemann_theta_integrand (s_seq n)) 1 B) (cint (riemann_theta_integrand s0) 1 B)) hB_ge1 hM_nn hId hpt
      have hlen := mul_le_mul_of_nonneg_left.real (B - 1) B (4 * (1 + 6 * exp 1) * L * complex.abs (complex.sub (s_seq n) s0)) (by linarith) hM_nn
      have hlt1 := (lt_div_iff.real (complex.abs (complex.sub (s_seq n) s0)) e (3 * KB) (by linarith)).mp hsn_e
      rw [hKB] at hlt1
      have hre : 4 * (1 + 6 * exp 1) * L * complex.abs (complex.sub (s_seq n) s0) * B = (4 * (1 + 6 * exp 1) * L * B) * complex.abs (complex.sub (s_seq n) s0) := by ring
      nlinarith [complex.abs_nonneg (complex.sub (s_seq n) s0)]
    have hsplit : complex.sub (riemann_theta_tail_int (s_seq n)) (riemann_theta_tail_int s0) = complex.add (complex.sub (riemann_theta_tail_int (s_seq n)) (cint (riemann_theta_integrand (s_seq n)) 1 B)) (complex.add (complex.sub (cint (riemann_theta_integrand (s_seq n)) 1 B) (cint (riemann_theta_integrand s0) 1 B)) (complex.neg (complex.sub (riemann_theta_tail_int s0) (cint (riemann_theta_integrand s0) 1 B))))
      apply complex.ext <;> simp <;> ring
    rw [hsplit]
    have ht1 := complex.abs_add_le (complex.sub (riemann_theta_tail_int (s_seq n)) (cint (riemann_theta_integrand (s_seq n)) 1 B)) (complex.add (complex.sub (cint (riemann_theta_integrand (s_seq n)) 1 B) (cint (riemann_theta_integrand s0) 1 B)) (complex.neg (complex.sub (riemann_theta_tail_int s0) (cint (riemann_theta_integrand s0) 1 B))))
    have ht2 := complex.abs_add_le (complex.sub (cint (riemann_theta_integrand (s_seq n)) 1 B) (cint (riemann_theta_integrand s0) 1 B)) (complex.neg (complex.sub (riemann_theta_tail_int s0) (cint (riemann_theta_integrand s0) 1 B)))
    rw [complex.abs_neg] at ht2; linarith
  -- Add pole terms -1/s_n - 1/(1 - s_n) -> -1/s0 - 1/(1 - s0)!
  have hs0_ne0 : s0 ≠ complex.zero
    intro hz
    have hr : complex.re s0 = complex.re complex.zero := by rw [hz]
    simp at hr; linarith
  have h1s0_ne0 : complex.sub complex.one s0 ≠ complex.zero
    intro hz; apply hs0_ne1
    have hr : complex.re (complex.sub complex.one s0) = complex.re complex.zero := by rw [hz]
    have hi : complex.im (complex.sub complex.one s0) = complex.im complex.zero := by rw [hz]
    simp at hr hi; apply complex.ext <;> simp <;> linarith
  have hinv_s := ctends_to.inv s_seq s0 hlim hs0_ne0
  have h1ms_lim : ctends_to (fun n => complex.sub complex.one (s_seq n)) (complex.sub complex.one s0)
    unfold ctends_to at hlim ⊢; intro e he
    obtain ⟨N0, hN0⟩ := hlim e he
    use N0; intro n hn
    have heq : complex.sub (complex.sub complex.one (s_seq n)) (complex.sub complex.one s0) = complex.neg (complex.sub (s_seq n) s0)
      apply complex.ext <;> simp <;> ring
    rw [heq, complex.abs_neg]; exact hN0 n hn
  have hinv_1ms := ctends_to.inv (fun n => complex.sub complex.one (s_seq n)) (complex.sub complex.one s0) h1ms_lim h1s0_ne0
  unfold classical_Lambda_triv
  unfold ctends_to at hinv_s hinv_1ms htail_lim ⊢
  intro e he
  obtain ⟨N1, hN1⟩ := hinv_s (e / 3) (by linarith)
  obtain ⟨N2, hN2⟩ := hinv_1ms (e / 3) (by linarith)
  obtain ⟨N3, hN3⟩ := htail_lim (e / 3) (by linarith)
  use N1 + N2 + N3; intro n hn
  have hre : complex.sub (complex.add (complex.sub (complex.neg (complex.inv (s_seq n))) (complex.inv (complex.sub complex.one (s_seq n)))) (riemann_theta_tail_int (s_seq n))) (complex.add (complex.sub (complex.neg (complex.inv s0)) (complex.inv (complex.sub complex.one s0))) (riemann_theta_tail_int s0)) = complex.add (complex.neg (complex.sub (complex.inv (s_seq n)) (complex.inv s0))) (complex.add (complex.neg (complex.sub (complex.inv (complex.sub complex.one (s_seq n))) (complex.inv (complex.sub complex.one s0)))) (complex.sub (riemann_theta_tail_int (s_seq n)) (riemann_theta_tail_int s0))) := by ring
  rw [hre]
  have ht1 := complex.abs_add_le (complex.neg (complex.sub (complex.inv (s_seq n)) (complex.inv s0))) (complex.add (complex.neg (complex.sub (complex.inv (complex.sub complex.one (s_seq n))) (complex.inv (complex.sub complex.one s0)))) (complex.sub (riemann_theta_tail_int (s_seq n)) (riemann_theta_tail_int s0)))
  have ht2 := complex.abs_add_le (complex.neg (complex.sub (complex.inv (complex.sub complex.one (s_seq n))) (complex.inv (complex.sub complex.one s0)))) (complex.sub (riemann_theta_tail_int (s_seq n)) (riemann_theta_tail_int s0))
  rw [complex.abs_neg] at ht1 ht2
  linarith [hN1 n (by omega), hN2 n (by omega), hN3 n (by omega)]

-- THEOREM 4 (EXACT BOUNDARY AGREEMENT `classical_L.zeta_fn s = zeta_em2 s` ON Re(s) = 1, s != 1 — 0 AXIOMS!):
+ classical_L.zeta_fn_eq_em2_re_eq_one (s0 : ℂ) (hre : complex.re s0 = 1) (hne : s0 ≠ complex.one) :
    classical_L.zeta_fn s0 = zeta_em2 s0
  set s_seq := (fun (n : ℕ) => complex.mk (1 + 1 / ((n + 1 : ℕ) : ℝ)) (complex.im s0)) with hs_seq
  have hlim_s : ctends_to s_seq s0
    unfold ctends_to; intro e he
    obtain ⟨N0, hN0⟩ := exists_nat_gt.real (1 / e)
    use N0; intro n hn
    have hn1_pos : (0 : ℝ) < ((n + 1 : ℕ) : ℝ) := (cast_pos.real (n + 1)).mpr (by omega)
    have hdiff : complex.sub (s_seq n) s0 = complex.of_real (1 / ((n + 1 : ℕ) : ℝ))
      rw [hs_seq]; unfold complex.of_real; apply complex.ext
      · simp; linarith
      · simp; ring
    rw [hdiff]
    have hof : complex.abs (complex.of_real (1 / ((n + 1 : ℕ) : ℝ))) = 1 / ((n + 1 : ℕ) : ℝ)
      have hsq : complex.abs (complex.of_real (1 / ((n + 1 : ℕ) : ℝ))) * complex.abs (complex.of_real (1 / ((n + 1 : ℕ) : ℝ))) = (1 / ((n + 1 : ℕ) : ℝ)) * (1 / ((n + 1 : ℕ) : ℝ))
        rw [complex.abs_sq]; unfold complex.norm_sq complex.of_real; simp
      exact eq_of_sq_eq_nonneg (complex.abs (complex.of_real (1 / ((n + 1 : ℕ) : ℝ)))) (1 / ((n + 1 : ℕ) : ℝ)) (complex.abs_nonneg (complex.of_real (1 / ((n + 1 : ℕ) : ℝ)))) (by linarith [one_div_pos.real ((n + 1 : ℕ) : ℝ) hn1_pos]) hsq
    rw [hof]
    have h1 := (div_lt_iff.real 1 ((n + 1 : ℕ) : ℝ) e he).mp (by linarith)
    exact (div_lt_iff.real 1 e ((n + 1 : ℕ) : ℝ) hn1_pos).mpr (by linarith)
  have hre_gt1 : ∀ n : ℕ, 1 < complex.re (s_seq n)
    intro n; rw [hs_seq]; simp
    have h := one_div_pos.real ((n + 1 : ℕ) : ℝ) ((cast_pos.real (n + 1)).mpr (by omega))
    rw [cast_add.real n 1] at h; simp at h; linarith
  have hre_le2 : ∀ n : ℕ, complex.re (s_seq n) ≤ 2
    intro n; rw [hs_seq]; simp
    have h1 : (1 : ℝ) ≤ ((n + 1 : ℕ) : ℝ) := (cast_le.real 1 (n + 1)).mpr (by omega)
    have h2 : 1 / ((n + 1 : ℕ) : ℝ) ≤ 1 := (div_le_iff.real 1 1 ((n + 1 : ℕ) : ℝ) (by linarith)).mpr (by linarith)
    rw [cast_add.real n 1] at h2; simp at h2; linarith
  -- Limit 1: zeta_em2 (s_seq n) -> zeta_em2 s0 via `zeta.em2_has_cderiv_at`!
  have hlim_em2 : ctends_to (fun n => zeta_em2 (s_seq n)) (zeta_em2 s0)
    obtain ⟨v, hv⟩ := zeta.em2_has_cderiv_at zeta_em2 zeta_em2.is_em2 s0 (by linarith) hne
    -- Use shifted function g z := zeta_em2 z - zeta_em2 s0 (g s0 = 0) with `has_cderiv_at.linear_bound_of_zero`!
    set g := (fun z => complex.sub (zeta_em2 z) (zeta_em2 s0)) with hg
    have hgv : has_cderiv_at g s0 v
      unfold has_cderiv_at at hv ⊢; intro e he
      obtain ⟨d, hd, hcd⟩ := hv e he
      use d; constructor; exact hd
      intro z hz
      have hfeq : complex.sub (g z) (g s0) = complex.sub (zeta_em2 z) (zeta_em2 s0)
        rw [hg]; apply complex.ext <;> simp <;> ring
      rw [hfeq]; exact hcd z hz
    have hg0 : g s0 = complex.zero
      rw [hg]; apply complex.ext <;> simp <;> ring
    obtain ⟨d, hd, hlin⟩ := has_cderiv_at.linear_bound_of_zero g s0 v hgv hg0
    unfold ctends_to at hlim_s ⊢; intro e he
    set d1 := min d (e / (complex.abs v + 2)) with hd1
    have hd1_pos : 0 < d1 := by rw [hd1]; exact lt_min.real d (e / (complex.abs v + 2)) 0 hd (div_pos.real e (complex.abs v + 2) he (by linarith [complex.abs_nonneg v]))
    obtain ⟨N0, hN0⟩ := hlim_s d1 hd1_pos
    use N0; intro n hn
    have hsn := hN0 n hn
    have h1 := hlin (s_seq n) (by linarith [min_le_left.real d (e / (complex.abs v + 2))])
    rw [hg] at h1
    have h2 := (lt_div_iff.real (complex.abs (complex.sub (s_seq n) s0)) e (complex.abs v + 2) (by linarith [complex.abs_nonneg v])).mp (by linarith [min_le_right.real d (e / (complex.abs v + 2))])
    nlinarith [complex.abs_nonneg (complex.sub (s_seq n) s0)]
  -- Limit 2: classical_L.zeta_fn (s_seq n) -> classical_L.zeta_fn s0!
  have hlim_cl : ctends_to (fun n => classical_L.zeta_fn (s_seq n)) (classical_L.zeta_fn s0)
    have hLam_lim := classical_Lambda_triv.continuous_seq_strip s_seq s0 (by linarith) (by linarith) hne (by intro n; linarith [hre_gt1 n]) hre_le2 hlim_s
    have hhalf_lim : ctends_to (fun n => complex.smul (1 / 2) (s_seq n)) (complex.smul (1 / 2) s0)
      have hconst := ctends_to.const (complex.of_real (1 / 2))
      have hm := ctends_to.mul (fun _ => complex.of_real (1 / 2)) s_seq (complex.of_real (1 / 2)) s0 hconst hlim_s
      have hf : (fun n => complex.mul (complex.of_real (1 / 2)) (s_seq n)) = (fun n => complex.smul (1 / 2) (s_seq n))
        funext n; unfold complex.of_real; apply complex.ext <;> simp <;> ring
      have hv : complex.mul (complex.of_real (1 / 2)) s0 = complex.smul (1 / 2) s0
        unfold complex.of_real; apply complex.ext <;> simp <;> ring
      rw [hf, hv] at hm; exact hm
    have hgam_lim := gamma.continuous_seq_half_to_one (fun n => complex.smul (1 / 2) (s_seq n)) (complex.smul (1 / 2) s0) (by simp; linarith) (by simp; linarith) (by intro n; simp; linarith [hre_gt1 n]) (by intro n; simp; linarith [hre_le2 n]) hhalf_lim
    have hpi_lim : ctends_to (fun n => cpow_real pi (complex.neg (complex.smul (1 / 2) (s_seq n)))) (cpow_real pi (complex.neg (complex.smul (1 / 2) s0)))
      unfold cpow_real
      apply ctends_to.cexp
      have hconst := ctends_to.const (complex.of_real (-log pi))
      have hm := ctends_to.mul (fun _ => complex.of_real (-log pi)) (fun n => complex.smul (1 / 2) (s_seq n)) (complex.of_real (-log pi)) (complex.smul (1 / 2) s0) hconst hhalf_lim
      have hf1 : (fun n => complex.mul (complex.of_real (-log pi)) (complex.smul (1 / 2) (s_seq n))) = (fun n => complex.smul (log pi) (complex.neg (complex.smul (1 / 2) (s_seq n))))
        funext n; unfold complex.of_real; apply complex.ext <;> simp <;> ring
      have hv1 : complex.mul (complex.of_real (-log pi)) (complex.smul (1 / 2) s0) = complex.smul (log pi) (complex.neg (complex.smul (1 / 2) s0))
        unfold complex.of_real; apply complex.ext <;> simp <;> ring
      rw [hf1, hv1] at hm; exact hm
    have hcg_lim : ctends_to (fun n => classical_gamma dchar.trivial_one (s_seq n)) (classical_gamma dchar.trivial_one s0)
      have hm := ctends_to.mul (fun n => cpow_real pi (complex.neg (complex.smul (1 / 2) (s_seq n)))) (fun n => gamma (complex.smul (1 / 2) (s_seq n))) (cpow_real pi (complex.neg (complex.smul (1 / 2) s0))) (gamma (complex.smul (1 / 2) s0)) hpi_lim hgam_lim
      have hf : (fun n => complex.mul (cpow_real pi (complex.neg (complex.smul (1 / 2) (s_seq n)))) (gamma (complex.smul (1 / 2) (s_seq n)))) = (fun n => classical_gamma dchar.trivial_one (s_seq n))
        funext n; exact (classical_gamma.trivial_one_eq (s_seq n)).symm
      rw [hf, ← classical_gamma.trivial_one_eq s0] at hm; exact hm
    have hgam0_ne : classical_gamma dchar.trivial_one s0 ≠ complex.zero := classical_gamma.ne_zero_re_pos dchar.trivial_one s0 (by linarith)
    have hinv_cg := ctends_to.inv (fun n => classical_gamma dchar.trivial_one (s_seq n)) (classical_gamma dchar.trivial_one s0) hcg_lim hgam0_ne
    have hprod := ctends_to.mul (fun n => complex.inv (classical_gamma dchar.trivial_one (s_seq n))) (fun n => classical_Lambda_triv (s_seq n)) (complex.inv (classical_gamma dchar.trivial_one s0)) (classical_Lambda_triv s0) hinv_cg hLam_lim
    have hs0_ne0 : s0 ≠ complex.zero
      intro hz
      have hr : complex.re s0 = complex.re complex.zero := by rw [hz]
      simp at hr; linarith
    have hf : (fun n => complex.mul (complex.inv (classical_gamma dchar.trivial_one (s_seq n))) (classical_Lambda_triv (s_seq n))) = (fun n => classical_L.zeta_fn (s_seq n))
      funext n
      have hn0 : s_seq n ≠ complex.zero
        intro hz
        have hr : complex.re (s_seq n) = complex.re complex.zero := by rw [hz]
        simp at hr; linarith [hre_gt1 n]
      have hn1 : s_seq n ≠ complex.one
        intro hz
        have hr : complex.re (s_seq n) = complex.re complex.one := by rw [hz]
        simp at hr; linarith [hre_gt1 n]
      have hgn : classical_gamma dchar.trivial_one (s_seq n) ≠ complex.zero := classical_gamma.ne_zero_re_pos dchar.trivial_one (s_seq n) (by linarith [hre_gt1 n])
      exact (classical_L.zeta_fn_eq_inv_gamma_mul_Lambda (s_seq n) hn0 hn1 hgn).symm
    rw [hf, ← classical_L.zeta_fn_eq_inv_gamma_mul_Lambda s0 hs0_ne0 hne hgam0_ne] at hprod; exact hprod
  -- Agree for every n since Re(s_seq n) > 1!
  have hagree : (fun n => classical_L.zeta_fn (s_seq n)) = (fun n => zeta_em2 (s_seq n)) := by funext n; exact classical_L.zeta_fn_eq_em2_re_gt_one (s_seq n) (hre_gt1 n)
  rw [hagree] at hlim_cl
  exact ctends_to.unique (fun n => zeta_em2 (s_seq n)) (DirichletLOps.zeta_fn classical_L s0) (zeta_em2 s0) hlim_cl hlim_em2

-- COROLLARY 4 (UNCONDITIONAL CLAUSE 7: `classical_L.zeta_fn s != 0` FOR ALL Re(s) >= 1, s != 1 — 0 AXIOMS!):
+ classical_L.zeta_fn_ne_zero_re_ge_one (s : ℂ) (hs : 1 ≤ complex.re s) (hne : s ≠ complex.one) :
    classical_L.zeta_fn s ≠ complex.zero
  have heq : classical_L.zeta_fn s = zeta_em2 s
    by_cases hgt : 1 < complex.re s
    · exact classical_L.zeta_fn_eq_em2_re_gt_one s hgt
    · exact classical_L.zeta_fn_eq_em2_re_eq_one s (by linarith) hne
  rw [heq]
  exact zeta.em2_ne_zero_re_ge_one_unconditional zeta_em2 zeta_em2.is_em2 s hs hne

-- ====================================================================================
-- 5. GRAND FINALE: COMPLETE 0-AXIOM PROOF OF `classical_L_laws : DirichletLLaws classical_L`!
--    RETIRES FRONTIER #1 (`opaque classical_L` & `axiom classical_L_laws`)!
-- ====================================================================================

+ classical_L_laws : DirichletLLaws classical_L
  unfold DirichletLLaws
  -- Clause 1: gamma_fn chi s != 0 for Re(s) > 0
  constructor
  · intro chi s hs; unfold classical_L; simp; exact classical_gamma.ne_zero_re_pos chi s hs
  -- Clause 2: root_num chi != 0 for primitive chi
  · constructor
    · intro chi hprim; unfold classical_L; simp; exact (primitive.root_num_unit_and_ne_zero chi hprim).2
    -- Clause 3: Functional equation for primitive chi on 0 < Re(s) < 1
    · constructor
      · intro chi s hprim hs0 hs1
        unfold classical_L; simp
        have hinv_prim := dchar.inv_is_primitive chi hprim
        have hs_ne0 : s ≠ complex.zero
          intro hz
          have hr : complex.re s = complex.re complex.zero := by rw [hz]
          simp at hr; linarith
        have hs_ne1 : s ≠ complex.one
          intro hz
          have hr : complex.re s = complex.re complex.one := by rw [hz]
          simp at hr; linarith
        have h1s_ne0 : complex.sub complex.one s ≠ complex.zero
          intro hz
          have hr : complex.re (complex.sub complex.one s) = complex.re complex.zero := by rw [hz]
          simp at hr; linarith
        have h1s_ne1 : complex.sub complex.one s ≠ complex.one
          intro hz
          have hr : complex.re (complex.sub complex.one s) = complex.re complex.one := by rw [hz]
          simp at hr; linarith
        have hgam1 := classical_gamma.ne_zero_re_pos chi s hs0
        have hgam2 := classical_gamma.ne_zero_re_pos (dchar.inv chi) (complex.sub complex.one s) (by simp; linarith)
        -- Helper: for any primitive psi and z != 0, 1 with classical_gamma psi z != 0:
        --   classical_gamma psi z * classical_L_fn psi z = classical_Lambda psi z!
        have hcomp : ∀ (psi : DChar) (z : ℂ), dchar.is_primitive psi → z ≠ complex.zero → z ≠ complex.one → classical_gamma psi z ≠ complex.zero →
            complex.mul (classical_gamma psi z) (classical_L_fn psi z) = classical_Lambda psi z
          intro psi z hp hz0 hz1 hgz
          unfold classical_L_fn
          rw [dchar.prim_of_primitive psi hp, induced_euler_ratio.eq_one_of_primitive psi hp z, complex.one_mul]
          unfold classical_L_prim
          have hnc0 : ¬ (psi.level = 1 ∧ z = complex.zero) := by intro h; exact hz0 h.2
          have hnc1 : ¬ (psi.level = 1 ∧ z = complex.one) := by intro h; exact hz1 h.2
          rw [if_neg hnc0, if_neg hnc1, if_neg hgz]
          have hc := complex.mul_inv_cancel (classical_gamma psi z) hgz
          have hre : complex.mul (classical_gamma psi z) (complex.mul (complex.inv (classical_gamma psi z)) (classical_Lambda psi z)) = complex.mul (complex.mul (classical_gamma psi z) (complex.inv (classical_gamma psi z))) (classical_Lambda psi z) := by ring
          rw [hre, hc, complex.one_mul]
        rw [hcomp chi s hprim hs_ne0 hs_ne1 hgam1, hcomp (dchar.inv chi) (complex.sub complex.one s) hinv_prim h1s_ne0 h1s_ne1 hgam2]
        unfold classical_Lambda
        have hinv_lvl : (dchar.inv chi).level = chi.level := by unfold dchar.inv; simp
        rw [hinv_lvl]
        by_cases hl1 : chi.level = 1
        · rw [if_pos hl1, if_pos hl1, dchar.root_num_of_level_one chi hprim hl1, complex.one_mul]
          exact classical_Lambda_triv.functional_eq s hs_ne0 hs_ne1
        · rw [if_neg hl1, if_neg hl1]
          exact classical_Lambda_nt.functional_eq chi hprim s
      -- Clause 4: Induced-character finite Euler-factor relation on Re(s) > 0
      · constructor
        · intro chi psi s hval hprim hind hs
          unfold classical_L; simp
          use chi.level + 1
          use induced_weight chi.level psi
          use induced_prime chi.level
          constructor
          · intro i _; exact induced_prime.gt_one chi.level i
          · constructor
            · intro i _; exact induced_weight.norm_sq_le_one chi.level psi hprim.1 i
            · unfold classical_L_fn
              rw [dchar.prim_eq chi hval psi hprim hind, dchar.prim_of_primitive psi hprim]
              rw [induced_euler_ratio.eq_one_of_primitive psi hprim s, complex.one_mul]
              unfold induced_euler_ratio; simp
        -- Clause 5: zeta_fn s = l_fn trivial_one s
        · constructor
          · intro s; rfl
          -- Clause 6: zeta_fn 0 != 0
          · constructor
            · rw [classical_L.zeta_fn_at_zero]
              intro hz
              have hr : complex.re (complex.of_real (-1 / 2)) = complex.re complex.zero := by rw [hz]
              unfold complex.of_real at hr; simp at hr
            -- Clause 7: zeta_fn s != 0 on Re(s) >= 1, s != 1
            · constructor
              · exact classical_L.zeta_fn_ne_zero_re_ge_one
              -- Clause 8: Left half-plane zero reflection (Re(s) <= 0, not trivial zero -2(n+1))
              · intro s hre hzero hnot
                have hs0 : s ≠ complex.zero
                  intro hz; rw [hz] at hzero
                  rw [classical_L.zeta_fn_at_zero] at hzero
                  have hr : complex.re (complex.of_real (-1 / 2)) = complex.re complex.zero := by rw [hzero]
                  unfold complex.of_real at hr; simp at hr
                have hs1 : s ≠ complex.one
                  intro hz
                  have hr : complex.re s = complex.re complex.one := by rw [hz]
                  simp at hr; linarith
                have hgam := classical_gamma.trivial_one_ne_zero_of_not_trivial_zero s hs0 hnot
                rw [classical_L.zeta_fn_eq_inv_gamma_mul_Lambda s hs0 hs1 hgam] at hzero
                have hLam0 : classical_Lambda_triv s = complex.zero
                  have hmul : complex.mul (classical_gamma dchar.trivial_one s) (complex.mul (complex.inv (classical_gamma dchar.trivial_one s)) (classical_Lambda_triv s)) = complex.mul (classical_gamma dchar.trivial_one s) complex.zero := by rw [hzero]
                  have hc := complex.mul_inv_cancel (classical_gamma dchar.trivial_one s) hgam
                  have hre1 : complex.mul (classical_gamma dchar.trivial_one s) (complex.mul (complex.inv (classical_gamma dchar.trivial_one s)) (classical_Lambda_triv s)) = complex.mul (complex.mul (classical_gamma dchar.trivial_one s) (complex.inv (classical_gamma dchar.trivial_one s))) (classical_Lambda_triv s)
                    apply complex.ext <;> simp <;> ring
                  rw [hre1, hc, complex.one_mul, complex.mul_zero] at hmul; exact hmul
                have hLam1 : classical_Lambda_triv (complex.sub complex.one s) = complex.zero := by rw [← classical_Lambda_triv.functional_eq s hs0 hs1]; exact hLam0
                have h1s0 : complex.sub complex.one s ≠ complex.zero
                  intro hz; apply hs1
                  have hr : complex.re (complex.sub complex.one s) = complex.re complex.zero := by rw [hz]
                  have hi : complex.im (complex.sub complex.one s) = complex.im complex.zero := by rw [hz]
                  simp at hr hi; apply complex.ext <;> simp <;> linarith
                have h1s1 : complex.sub complex.one s ≠ complex.one
                  intro hz; apply hs0
                  have hr : complex.re (complex.sub complex.one s) = complex.re complex.one := by rw [hz]
                  have hi : complex.im (complex.sub complex.one s) = complex.im complex.one := by rw [hz]
                  simp at hr hi; apply complex.ext <;> simp <;> linarith
                have hgam1 := classical_gamma.ne_zero_re_pos dchar.trivial_one (complex.sub complex.one s) (by simp; linarith)
                rw [classical_L.zeta_fn_eq_inv_gamma_mul_Lambda (complex.sub complex.one s) h1s0 h1s1 hgam1, hLam1, complex.mul_zero]
