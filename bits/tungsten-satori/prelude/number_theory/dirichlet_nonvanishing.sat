              have hm3 := mul_le_mul_of_nonneg_right.real (((K : ℝ) / sqrt ((b + 1 : ℕ) : ℝ) - sqrt (M_b : ℝ)) * (K : ℝ)) (sqrt ((b + 1 : ℕ) : ℝ)) (1 / (K : ℝ)) hK_le (by linarith [one_div_pos.real (K : ℝ) hK_pos])
              have hcK2 := mul_inv_cancel.real (K : ℝ) (by linarith)
              have hlK : (((K : ℝ) / sqrt ((b + 1 : ℕ) : ℝ) - sqrt (M_b : ℝ)) * (K : ℝ)) * (1 / (K : ℝ)) = (K : ℝ) / sqrt ((b + 1 : ℕ) : ℝ) - sqrt (M_b : ℝ) := by linear_combination ((K : ℝ) / sqrt ((b + 1 : ℕ) : ℝ) - sqrt (M_b : ℝ)) * hcK2
              rw [div_def.real (sqrt ((b + 1 : ℕ) : ℝ)) (K : ℝ)]; linarith
          have herr_abs : |err_b b| ≤ 4 * sqrt ((b + 1 : ℕ) : ℝ) / (K : ℝ)
            rw [herr_b, ← hMb]
            have hsplit_e : (∑ a < M_b, 1 / sqrt ((a + 1 : ℕ) : ℝ)) - (2 * (K : ℝ) / sqrt ((b + 1 : ℕ) : ℝ) - C_sq) =
                ((∑ a < M_b, 1 / sqrt ((a + 1 : ℕ) : ℝ)) - (2 * sqrt (M_b : ℝ) - C_sq)) - 2 * ((K : ℝ) / sqrt ((b + 1 : ℕ) : ℝ) - sqrt (M_b : ℝ))
              rw [div_def.real (2 * (K : ℝ)) (sqrt ((b + 1 : ℕ) : ℝ)), div_def.real (K : ℝ) (sqrt ((b + 1 : ℕ) : ℝ))]; ring
            rw [hsplit_e]
            have ht := abs_add.real ((∑ a < M_b, 1 / sqrt ((a + 1 : ℕ) : ℝ)) - (2 * sqrt (M_b : ℝ) - C_sq)) (-(2 * ((K : ℝ) / sqrt ((b + 1 : ℕ) : ℝ) - sqrt (M_b : ℝ))))
            have hn : ((∑ a < M_b, 1 / sqrt ((a + 1 : ℕ) : ℝ)) - (2 * sqrt (M_b : ℝ) - C_sq)) + -(2 * ((K : ℝ) / sqrt ((b + 1 : ℕ) : ℝ) - sqrt (M_b : ℝ))) =
                ((∑ a < M_b, 1 / sqrt ((a + 1 : ℕ) : ℝ)) - (2 * sqrt (M_b : ℝ) - C_sq)) - 2 * ((K : ℝ) / sqrt ((b + 1 : ℕ) : ℝ) - sqrt (M_b : ℝ)) := by ring
            rw [hn, abs_neg_eq, abs_of_nonneg.real (2 * ((K : ℝ) / sqrt ((b + 1 : ℕ) : ℝ) - sqrt (M_b : ℝ))) (by linarith [hdiff_sq.1])] at ht
            rw [div_def.real (2 * sqrt ((b + 1 : ℕ) : ℝ)) (K : ℝ)] at hinv_Mb
            have hd2 := hdiff_sq.2; rw [div_def.real (sqrt ((b + 1 : ℕ) : ℝ)) (K : ℝ)] at hd2
            rw [div_def.real (4 * sqrt ((b + 1 : ℕ) : ℝ)) (K : ℝ)]; linarith
          have hprod_le : (g (b + 1) / sqrt ((b + 1 : ℕ) : ℝ)) * err_b b ≤ |(g (b + 1) / sqrt ((b + 1 : ℕ) : ℝ)) * err_b b| := le_abs_self.real _
          rw [abs_mul.real, div_def.real (g (b + 1)) (sqrt ((b + 1 : ℕ) : ℝ)), abs_mul.real, abs_of_pos.real (1 / sqrt ((b + 1 : ℕ) : ℝ)) (one_div_pos.real _ hsb1_pos)] at hprod_le
          have hg1 := hg_abs (b + 1)
          have hm1 := mul_le_mul_of_nonneg_right.real (|g (b + 1)|) 1 (1 / sqrt ((b + 1 : ℕ) : ℝ)) hg1 (by linarith [one_div_pos.real _ hsb1_pos])
          have hm2 := mul_le_mul_of_nonneg_right.real (|g (b + 1)| * (1 / sqrt ((b + 1 : ℕ) : ℝ))) (1 / sqrt ((b + 1 : ℕ) : ℝ)) (|err_b b|) (by linarith) (abs_nonneg.real _)
          have hm3 := mul_le_mul_of_nonneg_left.real (|err_b b|) (4 * sqrt ((b + 1 : ℕ) : ℝ) / (K : ℝ)) (1 / sqrt ((b + 1 : ℕ) : ℝ)) herr_abs (by linarith [one_div_pos.real _ hsb1_pos])
          have hcb := mul_inv_cancel.real (sqrt ((b + 1 : ℕ) : ℝ)) (by linarith)
          have hcan : (1 / sqrt ((b + 1 : ℕ) : ℝ)) * (4 * sqrt ((b + 1 : ℕ) : ℝ) / (K : ℝ)) = 4 / (K : ℝ)
            rw [div_def.real (4 * sqrt ((b + 1 : ℕ) : ℝ)) (K : ℝ), div_def.real 4 (K : ℝ)]
            linear_combination 4 * (1 / (K : ℝ)) * hcb
          rw [div_def.real (g (b + 1)) (sqrt ((b + 1 : ℕ) : ℝ))]; linarith
        have hsum_e := sum_le.real _ _ K herr_term
        rw [sum_const.real (4 / (K : ℝ)) K] at hsum_e
        have hcK := mul_inv_cancel.real (K : ℝ) (by linarith)
        have hcan : (K : ℝ) * (4 / (K : ℝ)) = 4 := by rw [div_def.real 4 (K : ℝ)]; linear_combination 4 * hcK
        linarith
      linarith
    linarith
  linarith


+ ctends_to_zero_of_symm_eq (seq : ℕ → ℂ) (a b : ℂ) (ht : ctends_to seq a) (hba : b = a) (hb0 : b = complex.zero) :
    ctends_to seq complex.zero
  rw [← hba, hb0] at ht; exact ht

+ classical_L_reg.real_at_one_ne_zero_72b (chi : DChar) (hval : dchar.valid chi)
    (hnt : ¬ dchar.is_trivial chi) (hsq_triv : dchar.is_trivial (sernau.dchar_sq chi)) :
    classical_L_reg chi complex.one ≠ complex.zero
  intro hL1_zero
  exact dchar_dseries.real_at_one_not_zero chi hval hnt hsq_triv (ctends_to_zero_of_symm_eq (fun N => csum N (dchar_dseries_term chi complex.one)) (classical_L.l_fn chi complex.one) (classical_L_reg chi complex.one) (classical_L.tends_to_dseries_re_pos chi hval hnt complex.one (by simp)) (classical_L_reg.eq_nt_all chi hval hnt complex.one) hL1_zero)

+ at_one_ne_zero_complex_abstract (L_fn reg_fn : DChar → ℂ → ℂ)
    (hana : ∀ xi z, dchar.valid xi → 0 < complex.re z → is_canalytic_at (reg_fn xi) z)
    (heq_triv : ∀ xi z, dchar.valid xi → 0 < complex.re z → z ≠ complex.one → dchar.is_trivial xi → reg_fn xi z = complex.mul (complex.sub z complex.one) (L_fn xi z))
    (heq_nt : ∀ xi z, dchar.valid xi → ¬ dchar.is_trivial xi → reg_fn xi z = L_fn xi z)
    (h341_fn : ∀ xi sig, dchar.valid xi → 1 < sig → 1 ≤ complex.abs (L_fn (dchar.change_level dchar.trivial_one xi.level) (complex.of_real sig)) ^ 3 * complex.abs (L_fn xi (complex.of_real sig)) ^ 4 * complex.abs (L_fn (sernau.dchar_sq xi) (complex.of_real sig)))
    (chi : DChar) (hval : dchar.valid chi)
    (htriv : ¬ dchar.is_trivial chi) (hsq : ¬ dchar.is_trivial (sernau.dchar_sq chi)) :
    reg_fn chi complex.one ≠ complex.zero
  intro hL1_zero
  have hval' : 1 ≤ chi.level ∧ is_dirichlet_char chi.level chi.val := hval
  set q := chi.level with hq_def
  set chi0 := dchar.change_level dchar.trivial_one q with hchi0_def
  set chi2 := sernau.dchar_sq chi with hchi2_def
  have hdvd1 : dchar.trivial_one.level ∣ q
    have hl1 : dchar.trivial_one.level = 1 := by unfold dchar.trivial_one; simp
    rw [hl1]; exact dvd.one_left q
  have hval0 : dchar.valid chi0 := by rw [hchi0_def]; exact dchar.change_level_valid dchar.trivial_one q dchar.trivial_one_valid hval'.1 hdvd1
  have htriv0 : dchar.is_trivial chi0 := by rw [hchi0_def]; exact (dchar.change_level_trivial_iff dchar.trivial_one q dchar.trivial_one_valid hval'.1 hdvd1).mpr dchar.trivial_one_is_trivial
  have hval2 : dchar.valid chi2 := by rw [hchi2_def]; exact sernau.dchar_sq_valid chi hval
  have h1re : 0 < complex.re complex.one := by simp
  have hc0 := canalytic.continuous_at (reg_fn chi0) complex.one (hana chi0 complex.one hval0 h1re)
  have hc2 := canalytic.continuous_at (reg_fn chi2) complex.one (hana chi2 complex.one hval2 h1re)
  have hd1 := (is_canalytic_at.cderiv_at (reg_fn chi) complex.one (hana chi complex.one hval h1re)).1
  obtain ⟨d0, hd0_pos, hd0⟩ := hc0 1 (by decide)
  obtain ⟨d2, hd2_pos, hd2⟩ := hc2 1 (by decide)
  unfold has_cderiv_at at hd1
  obtain ⟨d1, hd1_pos, hd1_lip⟩ := hd1 1 (by decide)
  set K0 := complex.abs (reg_fn chi0 complex.one) + 1 with hK0
  set K1 := complex.abs (cderiv_at (reg_fn chi) complex.one) + 1 with hK1
  set K2 := complex.abs (reg_fn chi2 complex.one) + 1 with hK2
  have hK0_pos : 0 < K0 := by rw [hK0]; linarith [complex.abs_nonneg (reg_fn chi0 complex.one)]
  have hK1_pos : 0 < K1 := by rw [hK1]; linarith [complex.abs_nonneg (cderiv_at (reg_fn chi) complex.one)]
  have hK2_pos : 0 < K2 := by rw [hK2]; linarith [complex.abs_nonneg (reg_fn chi2 complex.one)]
  set B_tot := r341_term K0 K1 K2 + 1 with hBtot
  have hBtot_pos : 0 < B_tot
    rw [hBtot]; linarith [r341_term_pos K0 K1 K2 hK0_pos hK1_pos hK2_pos]
  set t := (min (min d0 d2) (min d1 (1 / B_tot))) / 2 with ht_def
  have ht_pos : 0 < t
    rw [ht_def]
    have hm1 := lt_min.real d0 d2 0 hd0_pos hd2_pos
    have hm2 := lt_min.real d1 (1 / B_tot) 0 hd1_pos (one_div_pos.real B_tot hBtot_pos)
    have hm := lt_min.real (min d0 d2) (min d1 (1 / B_tot)) 0 hm1 hm2
    linarith
  have ht_lt_d0 : t < d0 := by rw [ht_def]; linarith [min_le_left.real (min d0 d2) (min d1 (1 / B_tot)), min_le_left.real d0 d2]
  have ht_lt_d2 : t < d2 := by rw [ht_def]; linarith [min_le_left.real (min d0 d2) (min d1 (1 / B_tot)), min_le_right.real d0 d2]
  have ht_lt_d1 : t < d1 := by rw [ht_def]; linarith [min_le_right.real (min d0 d2) (min d1 (1 / B_tot)), min_le_left.real d1 (1 / B_tot)]
  have ht_lt_B : t < 1 / B_tot := by rw [ht_def]; linarith [min_le_right.real (min d0 d2) (min d1 (1 / B_tot)), min_le_right.real d1 (1 / B_tot)]
  set s := complex.of_real (1 + t) with hs_def
  have hs_sub : complex.sub s complex.one = complex.of_real t
    rw [hs_def]; unfold complex.of_real; apply complex.ext <;> simp <;> ring
  have hs_dist : complex.abs (complex.sub s complex.one) = t
    rw [hs_sub, complex.abs_of_real_nonneg t (by linarith)]
  have hs_ne1 : s ≠ complex.one
    intro heq; rw [heq, complex.sub_self, complex.abs_zero] at hs_dist; linarith
  have hs_re : 0 < complex.re s := by rw [hs_def]; unfold complex.of_real; simp; linarith
  have h341 : 1 ≤ r341_term (complex.abs (L_fn chi0 s)) (complex.abs (L_fn chi s)) (complex.abs (L_fn chi2 s))
    unfold r341_term; rw [hchi0_def, hchi2_def, hq_def, hs_def]
    exact h341_fn chi (1 + t) hval (by linarith)
  have ht3_pos : 0 < t ^ 3 := pow_pos.real t ht_pos 3
  have hm_341 := mul_le_mul_of_nonneg_left.real 1 _ (t ^ 3) h341 (by linarith)
  have htL0 : t * complex.abs (L_fn chi0 s) = complex.abs (reg_fn chi0 s)
    have hreg0 := heq_triv chi0 s hval0 hs_re hs_ne1 htriv0
    rw [hreg0, complex.abs_mul, hs_dist]
  have hL1_eq : L_fn chi s = reg_fn chi s := (heq_nt chi hval htriv s).symm
  have hL2_eq : L_fn chi2 s = reg_fn chi2 s := (heq_nt chi2 hval2 hsq s).symm
  rw [r341_term_scale_left, htL0, hL1_eq, hL2_eq] at hm_341
  have hb0 : complex.abs (reg_fn chi0 s) ≤ K0
    have h1 := hd0 s (by rw [hs_dist]; exact ht_lt_d0)
    have ht0 := complex.abs_sub_abs_le (reg_fn chi0 s) (reg_fn chi0 complex.one)
    rw [hK0]; linarith
  have hb2 : complex.abs (reg_fn chi2 s) ≤ K2
    have h1 := hd2 s (by rw [hs_dist]; exact ht_lt_d2)
    have ht2 := complex.abs_sub_abs_le (reg_fn chi2 s) (reg_fn chi2 complex.one)
    rw [hK2]; linarith
  have hb1 : complex.abs (reg_fn chi s) ≤ K1 * t
    have h1 := hd1_lip s (by rw [hs_dist]; exact ht_lt_d1)
    rw [hL1_zero] at h1
    have hsub0 : complex.sub (reg_fn chi s) complex.zero = reg_fn chi s := by ring
    rw [hsub0, hs_dist] at h1
    have ht1 := complex.abs_sub_abs_le (reg_fn chi s) (complex.mul (cderiv_at (reg_fn chi) complex.one) (complex.sub s complex.one))
    rw [complex.abs_mul, hs_dist] at ht1
    rw [hK1]; linarith
  have hprod_ub := r341_term_mono _ _ _ K0 (K1 * t) K2 (complex.abs_nonneg (reg_fn chi0 s)) (complex.abs_nonneg (reg_fn chi s)) (complex.abs_nonneg (reg_fn chi2 s)) hb0 hb1 hb2
  rw [r341_term_scale_mid t K0 K1 K2] at hprod_ub
  have ht3_le : t ^ 3 ≤ B_tot * t ^ 4
    have h1 : r341_term K0 K1 K2 * t ^ 4 ≤ B_tot * t ^ 4
      rw [hBtot]; linarith [pow_nonneg.real t (by linarith) 4]
    linarith
  have htB_lt1 : B_tot * t < 1
    have hm := mul_lt_mul_of_pos_left.real t (1 / B_tot) B_tot ht_lt_B hBtot_pos
    have hcB := mul_inv_cancel.real B_tot (by linarith)
    linarith
  have hcontra : t ^ 3 * (1 - B_tot * t) ≤ 0
    have he : t ^ 3 * (1 - B_tot * t) = t ^ 3 - B_tot * t ^ 4 := by ring
    linarith
  exact r_false_of_pos_mul_le_zero (t ^ 3) (1 - B_tot * t) ht3_pos (by linarith) hcontra

+ classical_L_reg.eq_triv_re_pos (xi : DChar) (z : ℂ) (hv : dchar.valid xi) (hz : 0 < complex.re z) (hne : z ≠ complex.one) (htr : dchar.is_trivial xi) :
    classical_L_reg xi z = complex.mul (complex.sub z complex.one) (classical_L.l_fn xi z)
  have h := classical_L_reg.eq_re_pos xi hv z hz hne
  have hpick : ∀ (a b c : ℂ), a = (if dchar.is_trivial xi then b else c) → a = b
    intro a b c heq; rw [if_pos htr] at heq; exact heq
  exact hpick (classical_L_reg xi z) (complex.mul (complex.sub z complex.one) (classical_L.l_fn xi z)) (classical_L.l_fn xi z) h

+ classical_L_reg.at_one_ne_zero_all (chi : DChar) (hval : dchar.valid chi) :
    classical_L_reg chi complex.one ≠ complex.zero
  by_cases htriv : dchar.is_trivial chi
  · exact classical_L_reg.at_one_ne_zero chi hval htriv
  · by_cases hsq : dchar.is_trivial (sernau.dchar_sq chi)
    · exact classical_L_reg.real_at_one_ne_zero_72b chi hval htriv hsq
    · exact at_one_ne_zero_complex_abstract classical_L.l_fn classical_L_reg chi classical_L_reg.is_canalytic_at_re_pos classical_L_reg.eq_triv_re_pos classical_L_reg.eq_nt_all classical_L.three_four_one_real hval htriv hsq
