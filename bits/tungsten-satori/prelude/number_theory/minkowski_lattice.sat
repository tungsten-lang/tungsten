-- Exact rpow natural power law: (rpow x a)^n = rpow x (n * a) for x > 0.
+ rpow.pow_nat_m44 (x a : ℝ) (hx : 0 < x) (n : ℕ) : (rpow x a) ^ n = rpow x ((n : ℝ) * a)
  induction n with r ihr
  · rw [pow_zero.real, cast_zero.real]
    unfold rpow
    have h0 : (0 : ℝ) * a * log x = 0 := by ring
    rw [h0, exp_zero]
  · rw [succ_eq_add_one.nat, pow_succ.real, ihr, cast_add.real r 1, cast_one.real]
    rw [← rpow.add x ((r : ℝ) * a) a]
    have h1 : (r : ℝ) * a + a = ((r : ℝ) + 1) * a := by ring
    rw [h1]

+ rpow.one_eq_m44 (x : ℝ) (hx : 0 < x) : rpow x 1 = x
  unfold rpow
  have h1 : (1 : ℝ) * log x = log x := by ring
  rw [h1, exp_log x hx]

+ rpow.root_pow_eq_m44 (x : ℝ) (hx : 0 < x) (N : ℕ) (hN : 1 ≤ N) :
    (rpow x (1 / (N : ℝ))) ^ N = x
  rw [rpow.pow_nat_m44 x (1 / (N : ℝ)) hx N]
  have hcn := mul_inv_cancel.real (N : ℝ) (by linarith)
  rw [hcn, rpow.one_eq_m44 x hx]

+ real_pow_lt_of_lt_m44 (a b : ℝ) (ha : 0 < a) (hab : a < b) (n : ℕ) (hn : 1 ≤ n) :
    a ^ n < b ^ n
  have hgen : ∀ k : ℕ, a ^ (k + 1) < b ^ (k + 1)
    intro k; induction k with r ihr
    · have h1 : (0 + 1 : ℕ) = 1 := by decide
      rw [h1, pow_one.real, pow_one.real]; exact hab
    · rw [succ_eq_add_one.nat, pow_succ.real a (r + 1), pow_succ.real b (r + 1)]
      have hbp : 0 < b ^ (r + 1) := pow_pos.real b (r + 1) (by linarith)
      have h1 := mul_lt_mul_of_pos_right.real (a ^ (r + 1)) (b ^ (r + 1)) a ihr ha
      have h2 := mul_lt_mul_of_pos_left.real a b (b ^ (r + 1)) hab hbp
      linarith
  have hn1 : n = (n - 1) + 1 := by omega
  rw [hn1]; exact hgen (n - 1)

+ real_pow_le_of_le_m44 (a b : ℝ) (ha : 0 ≤ a) (hab : a ≤ b) (n : ℕ) :
    a ^ n ≤ b ^ n
  induction n with r ihr
  · rw [pow_zero.real, pow_zero.real]; linarith
  · rw [succ_eq_add_one.nat, pow_succ.real, pow_succ.real]
    have h1 := mul_le_mul_of_nonneg_right.real (a ^ r) (b ^ r) a ihr ha
    have h2 := mul_le_mul_of_nonneg_left.real a b (b ^ r) hab (pow_nonneg.real b (by linarith) r)
    linarith

-- Sublattice index predicate: Lambda subset Z^N has index <= D if there is a coset map
-- coset : (N -> Z) -> N into [0, D) such that coset(u) = coset(v) -> Lambda(u - v).
-> is_sublattice_index (N D : ℕ) (Lambda : (ℕ → ℤ) → Prop) : Prop :=
  ∃ coset : (ℕ → ℤ) → ℕ,
    (∀ u : ℕ → ℤ, coset u < D) ∧
    (∀ u v : ℕ → ℤ, coset u = coset v → Lambda (fun j => u j - v j))

-- THEOREM 1A: Discrete Minkowski First Theorem on Z^N (0 CUSTOM AXIOMS!):
-- Any sublattice Lambda <= Z^N of index <= D with D < (B + 1)^N contains a nonzero vector
-- x in Lambda with |x_j| <= B for all j < N and sum_{j < N} (x_j)^2 <= N * B^2!
+ minkowski.sublattice_short_vector (N D B : ℕ) (Lambda : (ℕ → ℤ) → Prop)
    (hidx : is_sublattice_index N D Lambda)
    (hbox : D < (B + 1) ^ N) :
    ∃ x : ℕ → ℤ,
      Lambda x ∧
      (∃ j < N, x j ≠ 0) ∧
      (∀ j < N, |x j| ≤ (B : ℤ)) ∧
      (∑ j < N, x j * x j) ≤ (N : ℤ) * ((B : ℤ) * (B : ℤ))
  unfold is_sublattice_index at hidx
  obtain ⟨coset, hcos_lt, hcos_diff⟩ := hidx
  set vec : ℕ → ℕ → ℤ := fun u j => ((decode_box B u j : ℕ) : ℤ) with hvec_def
  set F : ℕ → ℕ := fun u => coset (vec u) with hF_def
  have hF_lt : ∀ u < (B + 1) ^ N, F u < D := by intro u _; rw [hF_def]; exact hcos_lt (vec u)
  obtain ⟨u1, u2, h12, h2L, hFeq⟩ := pigeonhole.nat_map D ((B + 1) ^ N) hbox F hF_lt
  set x : ℕ → ℤ := fun j => vec u1 j - vec u2 j with hx_def
  have hlam : Lambda x := by rw [hx_def]; exact hcos_diff (vec u1) (vec u2) (by rw [hF_def] at hFeq; exact hFeq)
  have hnz : ∃ j < N, x j ≠ 0
    obtain ⟨j0, hj0, hne⟩ := decode_box.inj B N u1 u2 (by omega) h2L (by omega)
    use j0; constructor; exact hj0
    intro hz; apply hne
    rw [hx_def, hvec_def] at hz
    have hcast : ((decode_box B u1 j0 : ℕ) : ℤ) = ((decode_box B u2 j0 : ℕ) : ℤ) := by linarith
    exact (cast_inj.int (decode_box B u1 j0) (decode_box B u2 j0)).mp hcast
  have hlinf : ∀ j < N, |x j| ≤ (B : ℤ)
    intro j hj
    rw [hx_def, hvec_def]
    have h1 : ((decode_box B u1 j : ℕ) : ℤ) ≤ (B : ℤ) := (cast_le.int (decode_box B u1 j) B).mpr (decode_box.le B u1 j)
    have h2 : ((decode_box B u2 j : ℕ) : ℤ) ≤ (B : ℤ) := (cast_le.int (decode_box B u2 j) B).mpr (decode_box.le B u2 j)
    have h1nn : (0 : ℤ) ≤ ((decode_box B u1 j : ℕ) : ℤ) := (cast_le.int 0 (decode_box B u1 j)).mpr (by omega)
    have h2nn : (0 : ℤ) ≤ ((decode_box B u2 j : ℕ) : ℤ) := (cast_le.int 0 (decode_box B u2 j)).mpr (by omega)
    exact abs_le_of.int (((decode_box B u1 j : ℕ) : ℤ) - ((decode_box B u2 j : ℕ) : ℤ)) (B : ℤ) (by linarith) (by linarith)
  have hl2 : (∑ j < N, x j * x j) ≤ (N : ℤ) * ((B : ℤ) * (B : ℤ))
    have hgen : ∀ t ≤ N, (∑ j < t, x j * x j) ≤ (t : ℤ) * ((B : ℤ) * (B : ℤ))
      intro t ht; induction t with ht r ihr ht
      · rw [sum_below_zero, cast_zero.int]; linarith
      · rw [succ_eq_add_one.nat] at ht ⊢
        rw [sum_below_succ, cast_add.int r 1, cast_one.int]
        have hprev := ihr (by omega)
        have hxr := hlinf r (by omega)
        have hlo : -(B : ℤ) ≤ x r := by linarith [neg_le_abs.int (x r)]
        have hhi : x r ≤ (B : ℤ) := by linarith [le_abs_self.int (x r)]
        have hsq : x r * x r ≤ (B : ℤ) * (B : ℤ)
          have hd : ((B : ℤ) - x r) * ((B : ℤ) + x r) = (B : ℤ) * (B : ℤ) - x r * x r := by ring
          have hnn := mul_nonneg.int ((B : ℤ) - x r) ((B : ℤ) + x r) (by linarith) (by linarith)
          linarith
        linarith
    exact hgen N (by omega)
  exact ⟨x, hlam, hnz, hlinf, hl2⟩

-- THEOREM 1B: Exact Minkowski Covolume D^(1/N) Root Bound (0 CUSTOM AXIOMS!):
-- For EVERY sublattice of Z^N of index <= D (N >= 1, D >= 1), setting B = floor(D^(1/N))
-- yields nonzero x in Lambda with |x_j| <= floor(D^(1/N)) <= D^(1/N) and ||x||_2^2 <= N * D^(2/N)!
+ minkowski.covolume_root_bound (N D : ℕ) (Lambda : (ℕ → ℤ) → Prop)
    (hN : 1 ≤ N) (hD : 1 ≤ D)
    (hidx : is_sublattice_index N D Lambda) :
    ∃ x : ℕ → ℤ,
      Lambda x ∧
      (∃ j < N, x j ≠ 0) ∧
      (∀ j < N, |x j| ≤ (nat_floor (rpow (D : ℝ) (1 / (N : ℝ))) : ℤ)) ∧
      ((nat_floor (rpow (D : ℝ) (1 / (N : ℝ))) : ℕ) : ℝ) ≤ rpow (D : ℝ) (1 / (N : ℝ)) ∧
      ((∑ j < N, x j * x j : ℤ) : ℝ) ≤ (N : ℝ) * rpow (D : ℝ) (2 / (N : ℝ))
  set rho := rpow (D : ℝ) (1 / (N : ℝ)) with hrho_def
  set B := nat_floor rho with hB_def
  have hDpos : (0 : ℝ) < (D : ℝ) := (cast_pos.real D).mpr (by omega)
  have hrho_pos : 0 < rho := by rw [hrho_def]; exact rpow.pos (D : ℝ) (1 / (N : ℝ))
  have hsp := nat_floor.spec rho (by linarith)
  rw [← hB_def] at hsp
  have hrho_pow : rho ^ N = (D : ℝ) := by rw [hrho_def]; exact rpow.root_pow_eq_m44 (D : ℝ) hDpos N hN
  have hlt_r : (D : ℝ) < ((B + 1 : ℕ) : ℝ) ^ N
    have hsp2 : rho < (B : ℝ) + 1
      have hc := cast_add.real B 1
      rw [cast_one.real] at hc; linarith [hsp.2]
    rw [← hrho_pow, cast_add.real B 1, cast_one.real]
    exact real_pow_lt_of_lt_m44 rho ((B : ℝ) + 1) hrho_pos hsp2 N hN
  have hbox : D < (B + 1) ^ N
    rw [← cast_pow.real (B + 1) N] at hlt_r
    exact (cast_lt.real D ((B + 1) ^ N)).mp hlt_r
  obtain ⟨x, hlam, hnz, hlinf, hl2⟩ := minkowski.sublattice_short_vector N D B Lambda hidx hbox
  have hl2_r : ((∑ j < N, x j * x j : ℤ) : ℝ) ≤ (N : ℝ) * (rho * rho)
    have hcast_le : ((∑ j < N, x j * x j : ℤ) : ℝ) ≤ (((N : ℤ) * ((B : ℤ) * (B : ℤ)) : ℤ) : ℝ) := by exact int_cast_le_m44 (∑ j < N, x j * x j) ((N : ℤ) * ((B : ℤ) * (B : ℤ))) hl2
    have hNBB : (((N : ℤ) * ((B : ℤ) * (B : ℤ)) : ℤ) : ℝ) = (N : ℝ) * ((B : ℝ) * (B : ℝ)) := by rw [int_cast_mul.real, int_cast_mul.real]
    rw [hNBB] at hcast_le
    have hB_nn : (0 : ℝ) ≤ (B : ℝ) := cast_nonneg.real B
    have hBB1 := mul_le_mul_of_nonneg_right.real (B : ℝ) rho (B : ℝ) hsp.1 hB_nn
    have hBB2 := mul_le_mul_of_nonneg_left.real (B : ℝ) rho rho hsp.1 (by linarith)
    have hN_nn : (0 : ℝ) ≤ (N : ℝ) := cast_nonneg.real N
    have hmulN := mul_le_mul_of_nonneg_left.real ((B : ℝ) * (B : ℝ)) (rho * rho) (N : ℝ) (by linarith) hN_nn
    linarith
  have hrho2 : rho * rho = rpow (D : ℝ) (2 / (N : ℝ))
    rw [hrho_def, ← rpow.add (D : ℝ) (1 / (N : ℝ)) (1 / (N : ℝ))]
    have hadd : 1 / (N : ℝ) + 1 / (N : ℝ) = 2 / (N : ℝ)
      rw [div_def.real 1 (N : ℝ), div_def.real 2 (N : ℝ)]; ring
    rw [hadd]
  rw [hrho2] at hl2_r
  exact ⟨x, hlam, hnz, hlinf, hsp.1, hl2_r⟩

-- Constructive integer floor function: int_floor x <= x < int_floor x + 1 for EVERY x : R!
-> int_floor (x : ℝ) : ℤ :=
  if 0 ≤ x then ((nat_floor x : ℕ) : ℤ)
  else if ((nat_floor (-x) : ℕ) : ℝ) = -x then -((nat_floor (-x) : ℕ) : ℤ)
  else -((nat_floor (-x) + 1 : ℕ) : ℤ)

+ int_floor.spec (x : ℝ) :
    ((int_floor x : ℤ) : ℝ) ≤ x ∧ x < ((int_floor x : ℤ) : ℝ) + 1
  unfold int_floor
  by_cases hx : 0 ≤ x
  · have hsp := nat_floor.spec x hx
    rw [if_pos hx]
    have h1 : ((nat_floor x + 1 : ℕ) : ℝ) = (nat_floor x : ℝ) + 1 := by rw [cast_add.real, cast_one.real]
    linarith [hsp.1, hsp.2]
  · have hsp := nat_floor.spec (-x) (by linarith)
    have h1 : ((nat_floor (-x) + 1 : ℕ) : ℝ) = (nat_floor (-x) : ℝ) + 1 := by rw [cast_add.real, cast_one.real]
    rw [if_neg hx]
    by_cases heq : ((nat_floor (-x) : ℕ) : ℝ) = -x
    · rw [if_pos heq, int_cast_neg_m44]; exact ⟨by linarith, by linarith⟩
    · rw [if_neg heq, int_cast_neg_m44, h1]
      exact ⟨by linarith [hsp.2], by linarith⟩

-- THEOREM 1C: Dirichlet's Simultaneous Diophantine Approximation Theorem (0 CUSTOM AXIOMS!):
-- For all d >= 1, alpha : N -> R, and integer Q >= 1, there exist q in [1, Q^d] and
-- integer vector p : N -> Z such that |q * alpha_i - p_i| < 1 / Q for every i < d!
+ minkowski.simultaneous_diophantine (d Q : ℕ) (alpha : ℕ → ℝ) (hd : 1 ≤ d) (hQ : 1 ≤ Q) :
    ∃ (q : ℕ) (p : ℕ → ℤ),
      1 ≤ q ∧ q ≤ Q ^ d ∧
      ∀ i < d, |(q : ℝ) * alpha i - ((p i : ℤ) : ℝ)| < 1 / (Q : ℝ)
  have hQpos : (0 : ℝ) < (Q : ℝ) := (cast_pos.real Q).mpr (by omega)
  have hcQ := mul_inv_cancel.real (Q : ℝ) (by linarith)
  -- Fractional-part bucket b(k, i) = floor(Q * frac(k * alpha_i)) in [0, Q):
  set frac : ℕ → ℕ → ℝ := fun k i => (k : ℝ) * alpha i - ((int_floor ((k : ℝ) * alpha i) : ℤ) : ℝ) with hfrac_def
  set bkt : ℕ → ℕ → ℕ := fun k i => nat_floor ((Q : ℝ) * frac k i) with hbkt_def
  have hfrac_spec : ∀ k i : ℕ, 0 ≤ frac k i ∧ frac k i < 1
    intro k i; rw [hfrac_def]
    have hsp := int_floor.spec ((k : ℝ) * alpha i)
    exact ⟨by linarith, by linarith⟩
  have hbkt_lt : ∀ k i : ℕ, bkt k i < Q
    intro k i; rw [hbkt_def]
    have hf := hfrac_spec k i
    have hnn : 0 ≤ (Q : ℝ) * frac k i := mul_nonneg.real (Q : ℝ) (frac k i) (by linarith) hf.1
    have hlt : (Q : ℝ) * frac k i < (Q : ℝ)
      have hm := mul_lt_mul_of_pos_left.real (frac k i) 1 (Q : ℝ) hf.2 hQpos
      linarith
    have hsp := nat_floor.spec ((Q : ℝ) * frac k i) hnn
    have hcast_lt : ((nat_floor ((Q : ℝ) * frac k i) : ℕ) : ℝ) < (Q : ℝ) := by linarith
    exact (cast_lt.real (nat_floor ((Q : ℝ) * frac k i)) Q).mp hcast_lt
  set F : ℕ → ℕ := fun k => encode_vec Q d (bkt k) with hF_def
  have hF_lt : ∀ k < Q ^ d + 1, F k < Q ^ d
    intro k _; rw [hF_def]
    exact encode_vec.lt Q d hQ (bkt k) (by intro i _; exact hbkt_lt k i)
  obtain ⟨k1, k2, h12, h2L, hFeq⟩ := pigeonhole.nat_map (Q ^ d) (Q ^ d + 1) (by omega) F hF_lt
  have hbkt_eq : ∀ i < d, bkt k1 i = bkt k2 i
    rw [hF_def] at hFeq
    exact encode_vec.inj Q d hQ (bkt k1) (bkt k2) (by intro i _; exact hbkt_lt k1 i) (by intro i _; exact hbkt_lt k2 i) hFeq
  use k2 - k1
  use (fun i => int_floor ((k2 : ℝ) * alpha i) - int_floor ((k1 : ℝ) * alpha i))
  constructor; omega
  constructor; omega
  intro i hi
  have hf1 := hfrac_spec k1 i
  have hf2 := hfrac_spec k2 i
  have hsp1 := nat_floor.spec ((Q : ℝ) * frac k1 i) (mul_nonneg.real (Q : ℝ) (frac k1 i) (by linarith) hf1.1)
  have hsp2 := nat_floor.spec ((Q : ℝ) * frac k2 i) (mul_nonneg.real (Q : ℝ) (frac k2 i) (by linarith) hf2.1)
  have hbeq := hbkt_eq i hi
  rw [hbkt_def] at hbeq
  rw [← hbeq] at hsp2
  have h1c : ((nat_floor ((Q : ℝ) * frac k1 i) + 1 : ℕ) : ℝ) = (nat_floor ((Q : ℝ) * frac k1 i) : ℝ) + 1 := by rw [cast_add.real, cast_one.real]
  rw [h1c] at hsp1 hsp2
  have hQdiff_hi : (Q : ℝ) * (frac k2 i - frac k1 i) < 1 := by linarith [hsp1.1, hsp2.2]
  have hQdiff_lo : -1 < (Q : ℝ) * (frac k2 i - frac k1 i) := by linarith [hsp1.2, hsp2.1]
  have hdiff_eq : ((k2 - k1 : ℕ) : ℝ) * alpha i - (((int_floor ((k2 : ℝ) * alpha i) - int_floor ((k1 : ℝ) * alpha i) : ℤ) : ℝ)) = frac k2 i - frac k1 i
    have hk : k1 + (k2 - k1) = k2 := by omega
    have hkc : (k1 : ℝ) + ((k2 - k1 : ℕ) : ℝ) = (k2 : ℝ) := by rw [← cast_add.real k1 (k2 - k1), hk]
    rw [int_cast_sub.real, hfrac_def]
    linear_combination (alpha i) * hkc
  rw [hdiff_eq]
  have hinv_pos : 0 < 1 / (Q : ℝ) := one_div_pos.real (Q : ℝ) hQpos
  have hhi_m := mul_lt_mul_of_pos_right.real ((Q : ℝ) * (frac k2 i - frac k1 i)) 1 (1 / (Q : ℝ)) hQdiff_hi hinv_pos
  have hlo_m := mul_lt_mul_of_pos_right.real (-1) ((Q : ℝ) * (frac k2 i - frac k1 i)) (1 / (Q : ℝ)) hQdiff_lo hinv_pos
  have hrew : (Q : ℝ) * (frac k2 i - frac k1 i) * (1 / (Q : ℝ)) = (frac k2 i - frac k1 i) * ((Q : ℝ) * (1 / (Q : ℝ))) := by ring
  rw [hrew, hcQ] at hhi_m hlo_m
  exact (abs_lt.real (frac k2 i - frac k1 i) (1 / (Q : ℝ))).mpr ⟨by linarith, by linarith⟩

-- THEOREM 1D: Hermite / Hadamard Basis Minimum-Norm Lower Bound (0 CUSTOM AXIOMS!):
-- For any rank-r PD Gram matrix G with max diagonal <= M:
--   Re(det G) <= M^r  and  (Re(det G))^(1/r) <= M!
+ minkowski.hermite_basis_min_norm (r : ℕ) (hr : 1 ≤ r) (G : ℕ → ℕ → ℂ) (M : ℝ)
    (hG : cmat.is_pd r G) (hM : 0 ≤ M)
    (hdiag : ∀ i < r, complex.re (G i i) ≤ M) :
    complex.re (cmat.det r G) ≤ M ^ r ∧ rpow (complex.re (cmat.det r G)) (1 / (r : ℝ)) ≤ M
  have hhad := cmat.hadamard_det_le_prod_diag r G (cmat.pd_implies_psd r G hG)
  have hdet_pos := (cmat.pd_det_pos r G hG).2
  have hprod_le : (∏ i < r, complex.re (G i i)) ≤ M ^ r
    have hgen : ∀ k ≤ r, (∏ i < k, complex.re (G i i)) ≤ M ^ k ∧ 0 ≤ ∏ i < k, complex.re (G i i)
      intro k hk; induction k with hk m ihm hk
      · rw [prod_below_zero, pow_zero.real]; exact ⟨by linarith, by linarith⟩
      · rw [succ_eq_add_one.nat] at hk ⊢
        rw [prod_below_succ, pow_succ.real]
        have hprev := ihm (by omega)
        have hgi_nn := (cmat.psd_diag_nonneg r G (cmat.pd_implies_psd r G hG) m (by omega)).2
        have hgi_le := hdiag m (by omega)
        have hm1 := mul_le_mul_of_nonneg_right.real (∏ i < m, complex.re (G i i)) (M ^ m) (complex.re (G m m)) hprev.1 hgi_nn
        have hm2 := mul_le_mul_of_nonneg_left.real (complex.re (G m m)) M (M ^ m) hgi_le (pow_nonneg.real M hM m)
        exact ⟨by linarith, mul_nonneg.real (∏ i < m, complex.re (G i i)) (complex.re (G m m)) hprev.2 hgi_nn⟩
    exact (hgen r (by omega)).1
  have hdet_le : complex.re (cmat.det r G) ≤ M ^ r := by linarith
  constructor; exact hdet_le
  by_contra hgt
  have hlt : M < rpow (complex.re (cmat.det r G)) (1 / (r : ℝ)) := by linarith
  have hrho_pos : 0 < rpow (complex.re (cmat.det r G)) (1 / (r : ℝ)) := rpow.pos (complex.re (cmat.det r G)) (1 / (r : ℝ))
  have hpow_lt : M ^ r < (rpow (complex.re (cmat.det r G)) (1 / (r : ℝ))) ^ r
    by_cases hM0 : M = 0
    · rw [hM0]
      have h0p : (0 : ℝ) ^ r = 0
        have hr1 : r = (r - 1) + 1 := by omega
        rw [hr1, pow_succ.real]; ring
      rw [h0p]; exact pow_pos.real (rpow (complex.re (cmat.det r G)) (1 / (r : ℝ))) r hrho_pos
    · exact real_pow_lt_of_lt_m44 M (rpow (complex.re (cmat.det r G)) (1 / (r : ℝ))) (by linarith) hlt r hr
  rw [rpow.root_pow_eq_m44 (complex.re (cmat.det r G)) hdet_pos r hr] at hpow_lt
  linarith

-- ====================================================================================
-- 2. Canonical Harder-Narasimhan Polygon & Destabilizing Morphism Vanishing
--    (`Formalism/BostSlope/`, `remark.pdf` items 13-14)
-- ====================================================================================

-- THEOREM 2A: Existence of the Canonical Maximal Destabilizing Subbundle (0 CUSTOM AXIOMS!):
-- Among ANY nonempty finite family of nonzero subbundles (rk_i, deg_i)_{i < K}, there exists
-- a canonical maximal destabilizing index i* < K maximizing slope mu(i) = deg_i / rk_i,
-- and among all slope maximizers, maximizing the rank rk_i!
+ hn_poly.max_destabilizing_exists (K : ℕ) (hK : 1 ≤ K) (E : ℕ → ArakelovBundle)
    (hrk : ∀ i < K, 0 < (E i).rk) :
    ∃ istar < K,
      (∀ i < K, slope (E i) ≤ slope (E istar)) ∧
      (∀ i < K, slope (E i) = slope (E istar) → (E i).rk ≤ (E istar).rk)
  have hgen : ∀ m : ℕ, 1 ≤ m → (∀ i < m, 0 < (E i).rk) →
      ∃ istar < m, (∀ i < m, slope (E i) ≤ slope (E istar)) ∧
        (∀ i < m, slope (E i) = slope (E istar) → (E i).rk ≤ (E istar).rk)
    intro m hm hrm
    induction m with hm hrm r ihr hm hrm
    · omega
    · rw [succ_eq_add_one.nat] at hm hrm ⊢
      by_cases hr0 : r = 0
      · rw [hr0]
        use 0; constructor; omega
        constructor
        · intro i hi; have hi0 : i = 0 := by omega
          rw [hi0]; linarith
        · intro i hi _; have hi0 : i = 0 := by omega
          rw [hi0]; linarith
      · obtain ⟨j0, hj0, hmax_s, hmax_r⟩ := ihr (by omega) (by intro i hi; exact hrm i (by omega))
        by_cases hwin : slope (E j0) < slope (E r) ∨ (slope (E r) = slope (E j0) ∧ (E j0).rk < (E r).rk)
        · use r; constructor; omega
          constructor
          · intro i hi; by_cases hir : i = r; (rw [hir]; linarith)
            obtain hs | ⟨he, _⟩ := hwin <;> linarith [hmax_s i (by omega)]
          · intro i hi heqi; by_cases hir : i = r; (rw [hir]; linarith)
            obtain hs | ⟨he, hrg⟩ := hwin
            · linarith [hmax_s i (by omega)]
            · linarith [hmax_r i (by omega) (by linarith)]
        · use j0; constructor; omega
          constructor
          · intro i hi; by_cases hir : i = r
            · rw [hir]; by_contra hgt; apply hwin; left; linarith
            · exact hmax_s i (by omega)
          · intro i hi heqi; by_cases hir : i = r
            · rw [hir] at heqi ⊢; by_contra hgt; apply hwin; right; exact ⟨heqi, by linarith⟩
            · exact hmax_r i (by omega) heqi
  exact hgen K hK hrk

-- Prefix rank and degree of a filtration with quotient blocks (rk_k, deg_k):
-> hn_poly.prefix_rk (q : ℕ → ArakelovBundle) (j : ℕ) : ℝ := ∑ k < j, (q k).rk
-> hn_poly.prefix_deg (q : ℕ → ArakelovBundle) (j : ℕ) : ℝ := ∑ k < j, (q k).deg
-> hn_poly.prefix_slope (q : ℕ → ArakelovBundle) (j : ℕ) : ℝ :=
  hn_poly.prefix_deg q j / hn_poly.prefix_rk q j

+ hn_poly.prefix_rk_pos (q : ℕ → ArakelovBundle) (j : ℕ) (hj : 1 ≤ j)
    (hrk : ∀ k < j, 0 < (q k).rk) : 0 < hn_poly.prefix_rk q j
  unfold hn_poly.prefix_rk
  induction j with hj hrk r ihr hj hrk
  · omega
  · rw [succ_eq_add_one.nat] at hj hrk ⊢
    rw [sum_below_succ]
    by_cases hr0 : r = 0
    · rw [hr0, sum_below_zero]; linarith [hrk 0 (by omega)]
    · linarith [ihr (by omega) (by intro k hk; exact hrk k (by omega)), hrk r (by omega)]

-- THEOREM 2B: Strict Concavity & Monotonicity of the Harder-Narasimhan Polygon (0 CUSTOM AXIOMS!):
-- For any HN filtration with m >= 2 blocks of positive ranks and strictly decreasing slopes
-- mu(q_0) > mu(q_1) > ... > mu(q_{m-1}):
--   1. Prefix slopes strictly decrease: mu(E_j) > mu(E_{j+1}) for all 1 <= j < m.
--   2. Every proper prefix (R_j, D_j) (1 <= j < m) lies STRICTLY above the global secant:
--      D_j * R_m > D_m * R_j, i.e., mu(E_j) > mu(E_m)!
+ hn_poly.concave_slope_monotone (m : ℕ) (q : ℕ → ArakelovBundle)
    (hrk : ∀ k < m, 0 < (q k).rk)
    (hdec : ∀ k, k + 1 < m → slope (q (k + 1)) < slope (q k)) :
    (∀ j, 1 ≤ j → j < m → hn_poly.prefix_slope q (j + 1) < hn_poly.prefix_slope q j) ∧
    (∀ j, 1 ≤ j → j < m → hn_poly.prefix_deg q m * hn_poly.prefix_rk q j < hn_poly.prefix_deg q j * hn_poly.prefix_rk q m)
  -- First prove monotone order: for a < b < m, slope (q b) < slope (q a)!
  have hdec_all : ∀ a b : ℕ, a < b → b < m → slope (q b) < slope (q a)
    intro a b hab hbm
    have hgen : ∀ d : ℕ, a + d + 1 < m → slope (q (a + d + 1)) < slope (q a)
      intro d hd; induction d with hd r ihr hd
      · have h0 : a + 0 + 1 = a + 1 := by omega
        rw [h0]; exact hdec a (by omega)
      · rw [succ_eq_add_one.nat] at hd ⊢
        have hstep := hdec (a + r + 1) (by omega)
        have hprev := ihr (by omega)
        have ha : a + (r + 1) + 1 = (a + r + 1) + 1 := by omega
        rw [ha]; linarith
    have hb : b = a + (b - a - 1) + 1 := by omega
    rw [hb]; exact hgen (b - a - 1) (by omega)
  -- Key lemma: for every 1 <= j < m, slope(q j) < prefix_slope q j!
  have hq_lt_pref : ∀ j, 1 ≤ j → j < m → slope (q j) * hn_poly.prefix_rk q j < hn_poly.prefix_deg q j
    intro j hj hjm
    unfold hn_poly.prefix_rk hn_poly.prefix_deg
    rw [← sum_const_mul.real]
    have hgen : ∀ t : ℕ, 1 ≤ t → t ≤ j → (∑ k < t, slope (q j) * (q k).rk) < ∑ k < t, (q k).deg
      intro t ht htj; induction t with ht htj r ihr ht htj
      · omega
      · rw [succ_eq_add_one.nat] at ht htj ⊢
        rw [sum_below_succ, sum_below_succ]
        have hsr : slope (q j) < slope (q r) := hdec_all r j (by omega) hjm
        have hrr : 0 < (q r).rk := hrk r (by omega)
        have hdeg_r : slope (q r) * (q r).rk = (q r).deg := by unfold slope; exact mul_div_cancel.real (ArakelovBundle.deg (q r)) (ArakelovBundle.rk (q r)) (by linarith)
        have hm := mul_lt_mul_of_pos_right.real (slope (q j)) (slope (q r)) (ArakelovBundle.rk (q r)) hsr hrr
        by_cases hr0 : r = 0
        · rw [hr0] at hm hdeg_r; rw [hr0, sum_below_zero, sum_below_zero]; linarith
        · linarith [ihr (by omega) (by omega)]
    exact hgen j hj (by omega)
  -- Step 1: strict decrease of prefix slopes mu(E_{j+1}) < mu(E_j) for 1 <= j < m!
  have hstep_dec : ∀ j, 1 ≤ j → j < m → hn_poly.prefix_slope q (j + 1) < hn_poly.prefix_slope q j
    intro j hj hjm
    have hRj := hn_poly.prefix_rk_pos q j hj (by intro k hk; exact hrk k (by omega))
    have hRjp1 := hn_poly.prefix_rk_pos q (j + 1) (by omega) (by intro k hk; exact hrk k (by omega))
    have hRj_step : hn_poly.prefix_rk q (j + 1) = hn_poly.prefix_rk q j + (q j).rk := by unfold hn_poly.prefix_rk; rw [sum_below_succ]
    have hDj_step : hn_poly.prefix_deg q (j + 1) = hn_poly.prefix_deg q j + (q j).deg := by unfold hn_poly.prefix_deg; rw [sum_below_succ]
    have hq_deg : slope (q j) * (q j).rk = (q j).deg
      unfold slope; exact mul_div_cancel.real (ArakelovBundle.deg (q j)) (ArakelovBundle.rk (q j)) (by linarith [hrk j hjm])
    have hlt := hq_lt_pref j hj hjm
    -- Cross-multiply: D_{j+1} * R_j < D_j * R_{j+1} <=> (q j).deg * R_j < D_j * (q j).rk!
    have hcross : hn_poly.prefix_deg q (j + 1) * hn_poly.prefix_rk q j < hn_poly.prefix_deg q j * hn_poly.prefix_rk q (j + 1)
      have hm := mul_lt_mul_of_pos_right.real (slope (q j) * hn_poly.prefix_rk q j) (hn_poly.prefix_deg q j) (ArakelovBundle.rk (q j)) hlt (hrk j hjm)
      have hre : slope (q j) * hn_poly.prefix_rk q j * (q j).rk = (slope (q j) * (q j).rk) * hn_poly.prefix_rk q j := by ring
      rw [hre, hq_deg] at hm
      rw [hRj_step, hDj_step]; linarith
    -- Divide by R_j * R_{j+1} > 0:
    unfold hn_poly.prefix_slope
    have hinv_pos : 0 < 1 / (hn_poly.prefix_rk q j * hn_poly.prefix_rk q (j + 1)) := one_div_pos.real (hn_poly.prefix_rk q j * hn_poly.prefix_rk q (j + 1)) (mul_pos.real (hn_poly.prefix_rk q j) (hn_poly.prefix_rk q (j + 1)) hRj hRjp1)
    have h1 := mul_lt_mul_of_pos_right.real (hn_poly.prefix_deg q (j + 1) * hn_poly.prefix_rk q j) (hn_poly.prefix_deg q j * hn_poly.prefix_rk q (j + 1)) (1 / (hn_poly.prefix_rk q j * hn_poly.prefix_rk q (j + 1))) hcross hinv_pos
    have hc1 := mul_inv_cancel.real (hn_poly.prefix_rk q j) (by linarith)
    have hc2 := mul_inv_cancel.real (hn_poly.prefix_rk q (j + 1)) (by linarith)
    have hprod_inv : 1 / (hn_poly.prefix_rk q j * hn_poly.prefix_rk q (j + 1)) = (1 / hn_poly.prefix_rk q j) * (1 / hn_poly.prefix_rk q (j + 1))
      have hcp := mul_inv_cancel.real (hn_poly.prefix_rk q j * hn_poly.prefix_rk q (j + 1)) (by nlinarith)
      have h0 : (hn_poly.prefix_rk q j * hn_poly.prefix_rk q (j + 1)) * (1 / (hn_poly.prefix_rk q j * hn_poly.prefix_rk q (j + 1)) - (1 / hn_poly.prefix_rk q j) * (1 / hn_poly.prefix_rk q (j + 1))) = 0
        have ha : (hn_poly.prefix_rk q j * hn_poly.prefix_rk q (j + 1)) * ((1 / hn_poly.prefix_rk q j) * (1 / hn_poly.prefix_rk q (j + 1))) = (hn_poly.prefix_rk q j * (1 / hn_poly.prefix_rk q j)) * (hn_poly.prefix_rk q (j + 1) * (1 / hn_poly.prefix_rk q (j + 1))) := by ring
        rw [mul_sub.real, hcp, ha, hc1, hc2]; ring
      linear_combination (1 / (hn_poly.prefix_rk q j * hn_poly.prefix_rk q (j + 1))) * h0 - (1 / (hn_poly.prefix_rk q j * hn_poly.prefix_rk q (j + 1)) - (1 / hn_poly.prefix_rk q j) * (1 / hn_poly.prefix_rk q (j + 1))) * hcp
    rw [hprod_inv] at h1
    rw [div_def.real (hn_poly.prefix_deg q (j + 1)) (hn_poly.prefix_rk q (j + 1)), div_def.real (hn_poly.prefix_deg q j) (hn_poly.prefix_rk q j)]
    have hL : hn_poly.prefix_deg q (j + 1) * hn_poly.prefix_rk q j * ((1 / hn_poly.prefix_rk q j) * (1 / hn_poly.prefix_rk q (j + 1))) = hn_poly.prefix_deg q (j + 1) * (1 / hn_poly.prefix_rk q (j + 1)) * (hn_poly.prefix_rk q j * (1 / hn_poly.prefix_rk q j)) := by ring
    have hR : hn_poly.prefix_deg q j * hn_poly.prefix_rk q (j + 1) * ((1 / hn_poly.prefix_rk q j) * (1 / hn_poly.prefix_rk q (j + 1))) = hn_poly.prefix_deg q j * (1 / hn_poly.prefix_rk q j) * (hn_poly.prefix_rk q (j + 1) * (1 / hn_poly.prefix_rk q (j + 1))) := by ring
    rw [hL, hR, hc1, hc2] at h1; linarith
  -- Step 2: every proper prefix lies strictly above the global secant!
  constructor; exact hstep_dec
  intro j hj hjm
  have hchain : ∀ d : ℕ, j + d + 1 ≤ m → hn_poly.prefix_slope q (j + d + 1) < hn_poly.prefix_slope q j
    intro d hd; induction d with hd r ihr hd
    · have h0 : j + 0 + 1 = j + 1 := by omega
      rw [h0]; exact hstep_dec j hj hjm
    · rw [succ_eq_add_one.nat] at hd ⊢
      have hst := hstep_dec (j + r + 1) (by omega) (by omega)
      have hpr := ihr (by omega)
      have ha : j + (r + 1) + 1 = (j + r + 1) + 1 := by omega
      rw [ha]; linarith
  have hm_eq : m = j + (m - j - 1) + 1 := by omega
  have hlt_sl : hn_poly.prefix_slope q m < hn_poly.prefix_slope q j := by rw [hm_eq]; exact hchain (m - j - 1) (by omega)
  have hRj := hn_poly.prefix_rk_pos q j hj (by intro k hk; exact hrk k (by omega))
  have hRm := hn_poly.prefix_rk_pos q m (by omega) hrk
  have hm_r := mul_lt_mul_of_pos_right.real (hn_poly.prefix_slope q m) (hn_poly.prefix_slope q j) (hn_poly.prefix_rk q m * hn_poly.prefix_rk q j) hlt_sl (mul_pos.real (hn_poly.prefix_rk q m) (hn_poly.prefix_rk q j) hRm hRj)
  unfold hn_poly.prefix_slope at hm_r
  have hc1 := mul_div_cancel.real (hn_poly.prefix_deg q m) (hn_poly.prefix_rk q m) (by linarith)
  have hc2 := mul_div_cancel.real (hn_poly.prefix_deg q j) (hn_poly.prefix_rk q j) (by linarith)
  have hL : hn_poly.prefix_deg q m / hn_poly.prefix_rk q m * (hn_poly.prefix_rk q m * hn_poly.prefix_rk q j) = (hn_poly.prefix_deg q m / hn_poly.prefix_rk q m * hn_poly.prefix_rk q m) * hn_poly.prefix_rk q j := by ring
  have hR : hn_poly.prefix_deg q j / hn_poly.prefix_rk q j * (hn_poly.prefix_rk q m * hn_poly.prefix_rk q j) = (hn_poly.prefix_deg q j / hn_poly.prefix_rk q j * hn_poly.prefix_rk q j) * hn_poly.prefix_rk q m := by ring
  rw [hL, hR, hc1, hc2] at hm_r; linarith

-- THEOREM 2C: Quantitative Bost-HN Destabilizing Morphism Vanishing (0 CUSTOM AXIOMS!):
-- Bridges M3.40 `bost.orthonormal_slope_ineq` to HN slope bounds:
-- If mu_min(E) > mu_max(F) + log M_op, then NO nonzero Hermitian morphism E -> F with
-- operator norm <= M_op can exist!
+ hn_poly.destabilizing_morphism_vanish (mu_min_E mu_max_F M_op : ℝ)
    (hM_pos : 0 < M_op)
    (hgap : mu_max_F + log M_op < mu_min_E) :
    ¬ ∃ (r : ℕ) (G_E G_phi : ℕ → ℕ → ℂ),
        1 ≤ r ∧ cmat.is_pd r G_E ∧ cmat.is_pd r G_phi ∧
        (∀ i < r, complex.re (G_phi i i) ≤ (M_op * M_op) * complex.re (G_E i i)) ∧
        (∏ i < r, complex.re (G_E i i)) ≤ complex.re (cmat.det r G_E) ∧
        mu_min_E ≤ arakelov_deg r G_E / (r : ℝ) ∧
        arakelov_deg r G_phi / (r : ℝ) ≤ mu_max_F
  intro hex
  obtain ⟨r, G_E, G_phi, hr, hGE, hGP, hop, horth, hlo, hhi⟩ := hex
  have hbost := bost.orthonormal_slope_ineq r hr G_E G_phi M_op hGE hGP hM_pos hop horth
  linarith

-- ====================================================================================
-- 3. Arithmetic Hilbert-Samuel Leading Term & Volume Asymptotics
--    (`Development/AbelianVarietyTheory/Proofs/DivisorProofs/VolGeOfHilbertSamuel`)
-- ====================================================================================

-- Exact bounds on ascending factorial: k^d <= asc_factorial (k + 1) d <= (k + d)^d!
+ asc_factorial.bounds (k d : ℕ) :
    k ^ d ≤ asc_factorial (k + 1) d ∧ asc_factorial (k + 1) d ≤ (k + d) ^ d
  induction d with r ihr
  · simp [asc_factorial, pow_zero.nat]
  · rw [succ_eq_add_one.nat, pow_succ.nat, pow_succ.nat]
    simp only [asc_factorial]
    have hlo : k ^ r * k ≤ asc_factorial (k + 1) r * (k + 1 + r)
      have hm1 := mul_le_mul_of_nonneg_right.nat (k ^ r) (asc_factorial (k + 1) r) k ihr.1 (by omega)
      have hm2 := mul_le_mul_of_nonneg_left.nat k (k + 1 + r) (asc_factorial (k + 1) r) (by omega) (by omega)
      omega
    have hhi : asc_factorial (k + 1) r * (k + 1 + r) ≤ (k + (r + 1)) ^ r * (k + (r + 1))
      have hbase : (k + r) ^ r ≤ (k + (r + 1)) ^ r := nat_pow_mono_base (k + r) (k + (r + 1)) r (by omega)
      have hprev : asc_factorial (k + 1) r ≤ (k + (r + 1)) ^ r := by omega
      have hm1 := mul_le_mul_of_nonneg_right.nat (asc_factorial (k + 1) r) ((k + (r + 1)) ^ r) (k + 1 + r) hprev (by omega)
      have hstep : k + 1 + r = k + (r + 1) := by omega
      rw [hstep]; rw [hstep] at hm1; exact hm1
    exact ⟨hlo, hhi⟩

-- THEOREM 3A: Exact Hilbert-Samuel Binomial Sandwich (0 CUSTOM AXIOMS!):
-- For ALL d >= 1 and k >= 1:
--   k^d / d! <= choose(k + d, d) <= (k + d)^d / d! !
+ hilbert_samuel.binomial_sandwich (k d : ℕ) :
    ((k : ℝ) ^ d) / ((fact d : ℕ) : ℝ) ≤ ((choose (k + d) d : ℕ) : ℝ) ∧
    ((choose (k + d) d : ℕ) : ℝ) ≤ (((k + d : ℕ) : ℝ) ^ d) / ((fact d : ℕ) : ℝ)
  have hmul := choose.mul_factorial k d
  have hbd := asc_factorial.bounds k d
  have hfd_pos : (0 : ℝ) < ((fact d : ℕ) : ℝ) := (cast_pos.real (fact d)).mpr (fact_pos d)
  have hlo_n : k ^ d ≤ fact d * choose (k + d) d := by rw [hmul]; exact hbd.1
  have hhi_n : fact d * choose (k + d) d ≤ (k + d) ^ d := by rw [hmul]; exact hbd.2
  have hlo_r : (k : ℝ) ^ d ≤ ((fact d : ℕ) : ℝ) * ((choose (k + d) d : ℕ) : ℝ)
    rw [← cast_pow.real k d, ← cast_mul.real (fact d) (choose (k + d) d)]
    exact (cast_le.real (k ^ d) (fact d * choose (k + d) d)).mpr hlo_n
  have hhi_r : ((fact d : ℕ) : ℝ) * ((choose (k + d) d : ℕ) : ℝ) ≤ ((k + d : ℕ) : ℝ) ^ d
    rw [← cast_pow.real (k + d) d, ← cast_mul.real (fact d) (choose (k + d) d)]
    exact (cast_le.real (fact d * choose (k + d) d) ((k + d) ^ d)).mpr hhi_n
  have hinv_nn : 0 ≤ 1 / ((fact d : ℕ) : ℝ) := by linarith [one_div_pos.real ((fact d : ℕ) : ℝ) hfd_pos]
  have hcf := mul_inv_cancel.real ((fact d : ℕ) : ℝ) (by linarith)
  have h1 := mul_le_mul_of_nonneg_right.real ((k : ℝ) ^ d) (((fact d : ℕ) : ℝ) * ((choose (k + d) d : ℕ) : ℝ)) (1 / ((fact d : ℕ) : ℝ)) hlo_r hinv_nn
  have h2 := mul_le_mul_of_nonneg_right.real (((fact d : ℕ) : ℝ) * ((choose (k + d) d : ℕ) : ℝ)) (((k + d : ℕ) : ℝ) ^ d) (1 / ((fact d : ℕ) : ℝ)) hhi_r hinv_nn
  have hre : ((fact d : ℕ) : ℝ) * ((choose (k + d) d : ℕ) : ℝ) * (1 / ((fact d : ℕ) : ℝ)) = ((choose (k + d) d : ℕ) : ℝ) * (((fact d : ℕ) : ℝ) * (1 / ((fact d : ℕ) : ℝ))) := by ring
  rw [hre, hcf] at h1 h2
  rw [div_def.real ((k : ℝ) ^ d) ((fact d : ℕ) : ℝ), div_def.real (((k + d : ℕ) : ℝ) ^ d) ((fact d : ℕ) : ℝ)]
  exact ⟨by linarith, by linarith⟩

-- Clean quantitative Bernoulli-type upper bound: for 0 <= t and 2 * m * t <= 1,
--   (1 + t)^m <= 1 + 2 * m * t !
+ hilbert_samuel.bernoulli_upper (t : ℝ) (ht : 0 ≤ t) (m : ℕ) (hmt : 2 * (m : ℝ) * t ≤ 1) :
    (1 + t) ^ m ≤ 1 + 2 * (m : ℝ) * t
  have hgen : ∀ n : ℕ, 2 * (n : ℝ) * t ≤ 1 → (1 + t) ^ n ≤ 1 + 2 * (n : ℝ) * t
    intro n hn; induction n with hn r ihr hn
    · rw [pow_zero.real, cast_zero.real]; linarith
    · rw [succ_eq_add_one.nat] at hn ⊢
      rw [pow_succ.real]
      rw [cast_add.real r 1, cast_one.real] at hn ⊢
      have hprev := ihr (by linarith [mul_nonneg.real (2 : ℝ) t (by linarith) ht])
      have hm := mul_le_mul_of_nonneg_right.real ((1 + t) ^ r) (1 + 2 * (r : ℝ) * t) (1 + t) hprev (by linarith)
      have h2rt_le : 2 * (r : ℝ) * t ≤ 1 := by linarith
      have hsq_le : (2 * (r : ℝ) * t) * t ≤ t := by
        have hm2 := mul_le_mul_of_nonneg_right.real (2 * (r : ℝ) * t) 1 t h2rt_le ht
        linarith
      linarith
  exact hgen m hmt

-- THEOREM 3B: Exact Arithmetic Hilbert-Samuel Leading Volume Ratio Limit (0 CUSTOM AXIOMS!):
-- For EVERY dimension d >= 1 and EVERY eps > 0, there exists K0 >= 1 such that for all k >= K0:
--   1 <= (d! * choose(k + d, d)) / k^d <= 1 + eps,
-- hence |d! * choose(k + d, d) / k^d - 1| <= eps!
+ hilbert_samuel.volume_ratio_bounds (d : ℕ) (hd : 1 ≤ d) (eps : ℝ) (heps : 0 < eps) :
    ∃ K0 : ℕ, 1 ≤ K0 ∧ ∀ k : ℕ, K0 ≤ k →
      1 ≤ ((fact d : ℕ) : ℝ) * ((choose (k + d) d : ℕ) : ℝ) / ((k : ℝ) ^ d) ∧
      ((fact d : ℕ) : ℝ) * ((choose (k + d) d : ℕ) : ℝ) / ((k : ℝ) ^ d) ≤ 1 + eps
  set thresh : ℝ := 2 * ((d * d : ℕ) : ℝ) * (1 / eps) + 2 * ((d * d : ℕ) : ℝ) + 1 with hth_def
  set K0 := nat_floor thresh + 1 with hK0_def
  have hth_nn : 0 ≤ thresh
    rw [hth_def]
    have h1 := one_div_pos.real eps heps
    have h2 := cast_nonneg.real (d * d)
    have h3 := mul_nonneg.real (2 * ((d * d : ℕ) : ℝ)) (1 / eps) (by linarith) (by linarith)
    linarith
  have hsp := nat_floor.spec thresh hth_nn
  use K0
  constructor
  · rw [hK0_def]; omega
  · intro k hk
    have hk_pos : (0 : ℝ) < (k : ℝ) := (cast_pos.real k).mpr (by omega)
    have hk_gt : thresh < (k : ℝ)
      have hK0_le : (K0 : ℝ) ≤ (k : ℝ) := (cast_le.real K0 k).mpr hk
      rw [hK0_def] at hK0_le
      linarith [hsp.2]
    have hkd_pos : 0 < (k : ℝ) ^ d := pow_pos.real (k : ℝ) d hk_pos
    have hinv_kd_nn : 0 ≤ 1 / ((k : ℝ) ^ d) := by linarith [one_div_pos.real ((k : ℝ) ^ d) hkd_pos]
    have hckd := mul_inv_cancel.real ((k : ℝ) ^ d) (by linarith)
    -- Sandwich from binomial_sandwich: k^d <= d! * choose(k+d, d) <= (k+d)^d!
    have hfd_pos : (0 : ℝ) < ((fact d : ℕ) : ℝ) := (cast_pos.real (fact d)).mpr (fact_pos d)
    have hsw := hilbert_samuel.binomial_sandwich k d
    have hcf := mul_inv_cancel.real ((fact d : ℕ) : ℝ) (by linarith)
    have hlo_num : (k : ℝ) ^ d ≤ ((fact d : ℕ) : ℝ) * ((choose (k + d) d : ℕ) : ℝ)
      have hm := mul_le_mul_of_nonneg_left.real (((k : ℝ) ^ d) / ((fact d : ℕ) : ℝ)) ((choose (k + d) d : ℕ) : ℝ) ((fact d : ℕ) : ℝ) hsw.1 (by linarith)
      rw [div_def.real ((k : ℝ) ^ d) ((fact d : ℕ) : ℝ)] at hm
      have hre : ((fact d : ℕ) : ℝ) * ((k : ℝ) ^ d * (1 / ((fact d : ℕ) : ℝ))) = (k : ℝ) ^ d * (((fact d : ℕ) : ℝ) * (1 / ((fact d : ℕ) : ℝ))) := by ring
      rw [hre, hcf] at hm; linarith
    have hhi_num : ((fact d : ℕ) : ℝ) * ((choose (k + d) d : ℕ) : ℝ) ≤ ((k + d : ℕ) : ℝ) ^ d
      have hm := mul_le_mul_of_nonneg_left.real ((choose (k + d) d : ℕ) : ℝ) ((((k + d : ℕ) : ℝ) ^ d) / ((fact d : ℕ) : ℝ)) ((fact d : ℕ) : ℝ) hsw.2 (by linarith)
      rw [div_def.real (((k + d : ℕ) : ℝ) ^ d) ((fact d : ℕ) : ℝ)] at hm
      have hre : ((fact d : ℕ) : ℝ) * ((((k + d : ℕ) : ℝ) ^ d) * (1 / ((fact d : ℕ) : ℝ))) = (((k + d : ℕ) : ℝ) ^ d) * (((fact d : ℕ) : ℝ) * (1 / ((fact d : ℕ) : ℝ))) := by ring
      rw [hre, hcf] at hm; linarith
    -- Lower bound: 1 <= (d! * choose(k+d, d)) / k^d!
    have hlo : 1 ≤ ((fact d : ℕ) : ℝ) * ((choose (k + d) d : ℕ) : ℝ) / ((k : ℝ) ^ d)
      have hm := mul_le_mul_of_nonneg_right.real ((k : ℝ) ^ d) (((fact d : ℕ) : ℝ) * ((choose (k + d) d : ℕ) : ℝ)) (1 / ((k : ℝ) ^ d)) hlo_num hinv_kd_nn
      rw [hckd] at hm
      rw [div_def.real (((fact d : ℕ) : ℝ) * ((choose (k + d) d : ℕ) : ℝ)) ((k : ℝ) ^ d)]
      exact hm
    -- Upper bound: ((k+d)/k)^d = (1 + d/k)^d <= 1 + 2 * d^2 / k <= 1 + eps!
    have hck := mul_inv_cancel.real (k : ℝ) (by linarith)
    have hratio_pow : (((k + d : ℕ) : ℝ) ^ d) / ((k : ℝ) ^ d) = (1 + (d : ℝ) / (k : ℝ)) ^ d
      have hbase : ((k + d : ℕ) : ℝ) = (k : ℝ) * (1 + (d : ℝ) / (k : ℝ))
        rw [cast_add.real k d, div_def.real (d : ℝ) (k : ℝ)]
        linear_combination -(d : ℝ) * hck
      have hmul_p : ∀ a b : ℝ, ∀ n : ℕ, (a * b) ^ n = a ^ n * b ^ n
        intro a b n; induction n with r ihr
        · rw [pow_zero.real, pow_zero.real, pow_zero.real]; ring
        · rw [succ_eq_add_one.nat, pow_succ.real, pow_succ.real, pow_succ.real, ihr]; ring
      rw [hbase, hmul_p (k : ℝ) (1 + (d : ℝ) / (k : ℝ)) d, div_def.real ((k : ℝ) ^ d * (1 + (d : ℝ) / (k : ℝ)) ^ d) ((k : ℝ) ^ d)]
      have hre : (k : ℝ) ^ d * (1 + (d : ℝ) / (k : ℝ)) ^ d * (1 / ((k : ℝ) ^ d)) = (1 + (d : ℝ) / (k : ℝ)) ^ d * ((k : ℝ) ^ d * (1 / ((k : ℝ) ^ d))) := by ring
      rw [hre, hckd]; ring
    have hhi_div : ((fact d : ℕ) : ℝ) * ((choose (k + d) d : ℕ) : ℝ) / ((k : ℝ) ^ d) ≤ (1 + (d : ℝ) / (k : ℝ)) ^ d
      rw [← hratio_pow, div_def.real (((fact d : ℕ) : ℝ) * ((choose (k + d) d : ℕ) : ℝ)) ((k : ℝ) ^ d), div_def.real (((k + d : ℕ) : ℝ) ^ d) ((k : ℝ) ^ d)]
      exact mul_le_mul_of_nonneg_right.real (((fact d : ℕ) : ℝ) * ((choose (k + d) d : ℕ) : ℝ)) (((k + d : ℕ) : ℝ) ^ d) (1 / ((k : ℝ) ^ d)) hhi_num hinv_kd_nn
    have hd2_cast : ((d * d : ℕ) : ℝ) = (d : ℝ) * (d : ℝ) := cast_mul.real d d
    have ht_nn : 0 ≤ (d : ℝ) / (k : ℝ)
      rw [div_def.real]; exact mul_nonneg.real (d : ℝ) (1 / (k : ℝ)) (cast_nonneg.real d) (by linarith [one_div_pos.real (k : ℝ) hk_pos])
    have h2dt_le1 : 2 * (d : ℝ) * ((d : ℝ) / (k : ℝ)) ≤ 1
      have h1 : 2 * ((d * d : ℕ) : ℝ) ≤ (k : ℝ)
        rw [hth_def] at hk_gt
        have hpos_term := mul_nonneg.real (2 * ((d * d : ℕ) : ℝ)) (1 / eps) (by linarith [cast_nonneg.real (d * d)]) (by linarith [one_div_pos.real eps heps])
        linarith
      have hm := mul_le_mul_of_nonneg_right.real (2 * ((d * d : ℕ) : ℝ)) (k : ℝ) (1 / (k : ℝ)) h1 (by linarith [one_div_pos.real (k : ℝ) hk_pos])
      rw [hck, hd2_cast] at hm
      rw [div_def.real (d : ℝ) (k : ℝ)]; linarith
    have hbern := hilbert_samuel.bernoulli_upper ((d : ℝ) / (k : ℝ)) ht_nn d h2dt_le1
    have h2dt_le_eps : 2 * (d : ℝ) * ((d : ℝ) / (k : ℝ)) ≤ eps
      have h1 : 2 * ((d * d : ℕ) : ℝ) * (1 / eps) ≤ (k : ℝ)
        rw [hth_def] at hk_gt; linarith [cast_nonneg.real (d * d)]
      have hce := mul_inv_cancel.real eps (by linarith)
      have hm1 := mul_le_mul_of_nonneg_right.real (2 * ((d * d : ℕ) : ℝ) * (1 / eps)) (k : ℝ) eps h1 (by linarith)
      have hre1 : 2 * ((d * d : ℕ) : ℝ) * (1 / eps) * eps = 2 * ((d * d : ℕ) : ℝ) * (eps * (1 / eps)) := by ring
      rw [hre1, hce] at hm1
      have hm2 := mul_le_mul_of_nonneg_right.real (2 * ((d * d : ℕ) : ℝ) * 1) ((k : ℝ) * eps) (1 / (k : ℝ)) hm1 (by linarith [one_div_pos.real (k : ℝ) hk_pos])
      have hre2 : (k : ℝ) * eps * (1 / (k : ℝ)) = eps * ((k : ℝ) * (1 / (k : ℝ))) := by ring
      rw [hre2, hck, hd2_cast] at hm2
      rw [div_def.real (d : ℝ) (k : ℝ)]; linarith
    exact ⟨hlo, by linarith⟩
