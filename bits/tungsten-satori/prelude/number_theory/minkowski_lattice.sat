+ int_cast_le_m44 (a b : ℤ) (h : a ≤ b) : (a : ℝ) ≤ (b : ℝ)
  have h1 := int_cast_nonneg.real (b - a) (by linarith)
  rw [int_cast_sub.real] at h1; linarith

+ int_cast_neg_m44 (z : ℤ) : ((-z : ℤ) : ℝ) = -(z : ℝ)
  have h0 := int_cast_add.real (-z) z
  have hz : -z + z = 0 := by ring
  rw [hz, int_cast_zero.real] at h0; linarith

