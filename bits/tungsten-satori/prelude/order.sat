-- Order facts derived from the core axioms (proved, not assumed).

+ sq_nonneg.int (a : ℤ) : 0 ≤ a ^ 2
  by_cases h : 0 ≤ a
  · have e : a ^ 2 = a * a := by ring
    rw [e]
    exact mul_nonneg.int a a h h
  · have h2 : 0 ≤ 0 - a := by linarith
    have e : a ^ 2 = (0 - a) * (0 - a) := by ring
    rw [e]
    exact mul_nonneg.int (0 - a) (0 - a) h2 h2

+ sq_nonneg.rat (a : ℚ) : 0 ≤ a ^ 2
  by_cases h : 0 ≤ a
  · have e : a ^ 2 = a * a := by ring
    rw [e]
    exact mul_nonneg.rat a a h h
  · have h2 : 0 ≤ 0 - a := by linarith
    have e : a ^ 2 = (0 - a) * (0 - a) := by ring
    rw [e]
    exact mul_nonneg.rat (0 - a) (0 - a) h2 h2

+ sq_nonneg.real (a : ℝ) : 0 ≤ a ^ 2
  by_cases h : 0 ≤ a
  · have e : a ^ 2 = a * a := by ring
    rw [e]
    exact mul_nonneg.real a a h h
  · have h2 : 0 ≤ 0 - a := by linarith
    have e : a ^ 2 = (0 - a) * (0 - a) := by ring
    rw [e]
    exact mul_nonneg.real (0 - a) (0 - a) h2 h2


-- (b − a)(d − c) ≥ 0 without truncated subtraction: nlinarith's product facts over ℕ
+ nl_cross.nat (a b c d : ℕ) (h : a ≤ b) (k : c ≤ d) : a * d + b * c ≤ a * c + b * d
  have e1 := sub_add_cancel.nat b a h
  have e2 := sub_add_cancel.nat d c k
  have p := zero_le.nat ((b - a) * (d - c))
  have q : (b - a + a) * (d - c + c) = (b - a) * (d - c) + (b - a) * c + a * (d - c) + a * c := by ring
  have q2 : a * (d - c + c) = a * (d - c) + a * c := by ring
  have q3 : (b - a + a) * c = (b - a) * c + a * c := by ring
  rw [e1, e2] at q
  rw [e2] at q2
  rw [e1] at q3
  linarith
