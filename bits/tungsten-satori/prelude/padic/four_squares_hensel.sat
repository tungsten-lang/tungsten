-- Hensel Lifting for Four Squares (-2 mod p^M) and Multivariate Power Series Inverses mod p^K (0 custom axioms)

import padic.katz_divisibility
import number_theory.dirichlet_twists

+ sernau.exists_four_squares_cong_neg_two (p M : ℕ) (hp : is_prime_nat p) :
    (∃ j0 j1 j2 j3 q : ℕ, 0 < q ∧ j0 * j0 + j1 * j1 + j2 * j2 + j3 * j3 + 2 = (p ^ M) * q)
  by_cases hM0 : M = 0
  · rw [hM0, pow_zero.nat]; exact ⟨0, 0, 0, 0, 2, by decide, by decide⟩
  have hM1 : 1 ≤ M := by omega
  by_cases hp_eq2 : p = 2
  · rw [hp_eq2]
    have h2_lift : ∀ k : ℕ, ∃ x q : ℕ, x % 2 = 1 ∧ 0 < q ∧ x * x + 7 = (2 ^ (k + 3)) * q
      intro k; induction k with r ihr
      · exact ⟨1, 1, by decide, by decide, by decide⟩
      · rw [succ_eq_add_one.nat]; obtain ⟨x, q, hx_od, hq_pos, hxq⟩ := ihr
        set rq := q % 2 with hrq_def; set sq := q / 2 with hsq_def
        have hdm_q := div_add_mod.nat q 2; rw [← hsq_def, ← hrq_def] at hdm_q
        have hrq_lt := mod_lt.nat q 2 (by decide); rw [← hrq_def] at hrq_lt
        by_cases hrq0 : rq = 0
        · have hsq_pos : 0 < sq := by omega
          have hq_eq : q = 2 * sq := by omega
          have hp_step : 2 ^ (r + 1 + 3) = (2 ^ (r + 3)) * 2 := by have he : r + 1 + 3 = (r + 3) + 1 := (by omega); rw [he, pow_succ.nat]
          exact ⟨x, sq, hx_od, hsq_pos, by rw [hxq, hq_eq, hp_step]; ring⟩
        · have hrq_eq1 : rq = 1 := by omega
          set P2 := 2 ^ (r + 2) with hP2_def
          have hP2_even : P2 % 2 = 0
            rw [hP2_def]; have he : r + 2 = (r + 1) + 1 := by omega
            have h22 : 2 % 2 = 0 := by decide
            rw [he, pow_succ.nat, mul_mod.nat, h22, mul_zero.nat]; decide
          have hx'_od : (x + P2) % 2 = 1 := by rw [add_mod.nat, hx_od, hP2_even]; decide
          have hqx_ev : (q + x) % 2 = 0 := by rw [add_mod.nat, ← hrq_def, hrq_eq1, hx_od]; decide
          set s := (q + x) / 2 with hs_def; have hdm_s := div_add_mod.nat (q + x) 2; rw [← hs_def, hqx_ev] at hdm_s
          have hs2 : 2 * s = q + x := by omega
          have hp3 : 2 ^ (r + 3) = P2 * 2 := by rw [hP2_def]; have he : r + 3 = (r + 2) + 1 := (by omega); rw [he, pow_succ.nat]
          have hp4 : 2 ^ (r + 1 + 3) = P2 * 4 := by rw [hP2_def]; have he : r + 1 + 3 = (r + 2) + 2 := (by omega); rw [he, pow_add.nat]; ring
          have hP2_4 : P2 = (2 ^ r) * 4 := by rw [hP2_def, pow_add.nat]; ring
          have h2r_pos : 0 < 2 ^ r := pow_pos.nat 2 r (by decide)
          have hexp_x : (x + P2) * (x + P2) + 7 = (x * x + 7) + P2 * (2 * x + P2) := by ring
          use (x + P2), (s + 2 ^ r); constructor; exact hx'_od; constructor; omega
          rw [hexp_x, hxq, hp3, hp4]; linear_combination (P2 * 2) * hs2.symm + P2 * hP2_4
    obtain ⟨x, q, _, hq_pos, hxq⟩ := h2_lift M
    have hpM3 : 2 ^ (M + 3) = (2 ^ M) * 8 := by rw [pow_add.nat]; ring
    have hsum7 : x * x + 1 * 1 + 2 * 2 + 0 * 0 + 2 = x * x + 7 := by ring
    exact ⟨x, 1, 2, 0, 8 * q, by omega, by rw [hsum7, hxq, hpM3]; ring⟩
  · have hp2 : 2 ≤ p := hp.1
    have hp3 : 3 ≤ p := by omega
    have hp_pos : 0 < p := by omega
    have hp_od : p % 2 = 1 := odd_of_prime_ne_two p hp hp_eq2
    have hp_pr : prime p := (prime_iff_is_prime_nat p).mpr hp
    have hadd_mod_cancel : ∀ r1 r2 : ℕ, r1 < p → r2 < p → (r1 + r2) % p = r2 → r1 = 0
      intro r1 r2 hr1 hr2 heq
      by_cases hlt : r1 + r2 < p
      · rw [(div_mod_of_lt.nat (r1 + r2) p hlt).2] at heq; omega
      · have hsub : r1 + r2 = (r1 + r2 - p) + p * 1 := by omega
        rw [hsub, add_mul_mod.nat, (div_mod_of_lt.nat (r1 + r2 - p) p (by omega)).2] at heq; omega
    have hpigeon : ∀ (n : ℕ) (h : ℕ → ℕ), (∀ i < n + 1, h i < n) → (∀ i1 < n + 1, ∀ i2 < n + 1, h i1 = h i2 → i1 = i2) → False
      intro n; induction n with h hh _ r ihr h hh hinj
      · have h0 := hh 0 (by decide); omega
      · rw [succ_eq_add_one.nat] at hh hinj
        set h' : ℕ → ℕ := fun i => if h i = r then h (r + 1) else h i with hh'_def
        have hh' : ∀ i < r + 1, h' i < r
          intro i hi; rw [hh'_def]; by_cases heq : h i = r
          · rw [if_pos heq]; have hlast := hh (r + 1) (by omega)
            have hne : h (r + 1) ≠ r := by intro hr1; have hi_eq := hinj i (by omega) (r + 1) (by omega) (by rw [heq, hr1]); omega
            omega
          · rw [if_neg heq]; have hi_bd := hh i (by omega); omega
        have hinj' : ∀ i1 < r + 1, ∀ i2 < r + 1, h' i1 = h' i2 → i1 = i2
          intro i1 hi1 i2 hi2 he12; rw [hh'_def] at he12
          by_cases c1 : h i1 = r
          · rw [if_pos c1] at he12; by_cases c2 : h i2 = r
            · exact hinj i1 (by omega) i2 (by omega) (by rw [c1, c2])
            · rw [if_neg c2] at he12; have hi_eq := hinj (r + 1) (by omega) i2 (by omega) he12; omega
          · rw [if_neg c1] at he12; by_cases c2 : h i2 = r
            · rw [if_pos c2] at he12; have hi_eq := hinj i1 (by omega) (r + 1) (by omega) he12; omega
            · rw [if_neg c2] at he12; exact hinj i1 (by omega) i2 (by omega) he12
        exact ihr h' hh' hinj'
    set K := (p + 1) / 2 with hK_def
    have hmod_p1 : (p + 1) % 2 = 0 := by rw [add_mod.nat, hp_od]; decide
    have hdm_K := div_add_mod.nat (p + 1) 2; rw [← hK_def, hmod_p1] at hdm_K
    have h2K : 2 * K = p + 1 := by omega
    have hsq_lt : ∀ u v : ℕ, u < v → v < K → (u * u) % p ≠ (v * v) % p
      intro u v huv hvK heq; set d1 := v - u with hd1_def; set d2 := v + u with hd2_def
      have hv_u : v = u + d1 := by omega
      have hd_bds : 0 < d1 ∧ d1 < p ∧ 0 < d2 ∧ d2 < p := ⟨by omega, by omega, by omega, by omega⟩
      have hid : d1 * d2 + u * u = v * v := by rw [hd2_def, hv_u]; ring
      have hm_eq : (d1 * d2 + u * u) % p = (u * u) % p := by rw [hid, heq]
      rw [add_mod.nat] at hm_eq
      have hr0 := hadd_mod_cancel ((d1 * d2) % p) ((u * u) % p) (mod_lt.nat (d1 * d2) p hp_pos) (mod_lt.nat (u * u) p hp_pos) hm_eq
      have hdvd_prod : p ∣ (d1 * d2) := by unfold dvd; exact hr0
      obtain hd1_d | hd2_d := prime.dvd_mul_or p d1 d2 hp_pr hdvd_prod
      · have hle := le_of_dvd.nat d1 p hd_bds.1 hd1_d; omega
      · have hle := le_of_dvd.nat d2 p hd_bds.2.2.1 hd2_d; omega
    have hsq_inj : ∀ a b : ℕ, a < K → b < K → (a * a) % p = (b * b) % p → a = b
      intro a b ha hb heq; by_contra hne
      by_cases hab : a < b
      · exact hsq_lt a b hab hb heq
      · exact hsq_lt b a (by omega) ha heq.symm
    have hpp0 : p % p = 0 := ((div_mod_unique.nat p p 1 0 (by ring) hp_pos).2).symm
    have hneg_inj : ∀ r1 r2 : ℕ, r1 < p → r2 < p → (p - r1) % p = (p - r2) % p → r1 = r2
      intro r1 r2 hr1 hr2 heq
      by_cases z1 : r1 = 0
      · have hs1 : p - r1 = p := by omega
        rw [hs1, hpp0] at heq
        by_cases z2 : r2 = 0; omega
        have hlt2 : p - r2 < p := by omega
        rw [(div_mod_of_lt.nat (p - r2) p hlt2).2] at heq; omega
      · have hlt1 : p - r1 < p := by omega
        rw [(div_mod_of_lt.nat (p - r1) p hlt1).2] at heq
        by_cases z2 : r2 = 0
        · have hs2 : p - r2 = p := by omega
          rw [hs2, hpp0] at heq; omega
        · have hlt2 : p - r2 < p := by omega
          rw [(div_mod_of_lt.nat (p - r2) p hlt2).2] at heq; omega
    set f_sq : ℕ → ℕ := fun x => (x * x) % p with hf_def
    set g_sq : ℕ → ℕ := fun y => (p - ((y * y + 2) % p)) % p with hg_def
    have hg_inj : ∀ a b : ℕ, a < K → b < K → g_sq a = g_sq b → a = b
      intro a b ha hb heq; rw [hg_def] at heq
      have h1 := hneg_inj ((a * a + 2) % p) ((b * b + 2) % p) (mod_lt.nat (a * a + 2) p hp_pos) (mod_lt.nat (b * b + 2) p hp_pos) heq
      have hc2 : ∀ z : ℕ, (((z + 2) % p) + (p - 2)) % p = z % p
        intro z; rw [add_mod.nat ((z + 2) % p) (p - 2) p, zmod.mod_mod, ← add_mod.nat (z + 2) (p - 2) p]
        have hs : (z + 2) + (p - 2) = z + p * 1 := by omega
        rw [hs, add_mul_mod.nat]
      have h2 : (((a * a + 2) % p) + (p - 2)) % p = (((b * b + 2) % p) + (p - 2)) % p := by rw [h1]
      rw [hc2 (a * a), hc2 (b * b)] at h2; exact hsq_inj a b ha hb h2
    have hex_xy : ∃ x < K, ∃ y < K, f_sq x = g_sq y
      by_contra hno
      set h_comb : ℕ → ℕ := fun i => if i < K then f_sq i else g_sq (i - K) with hcomb_def
      have hh_bd : ∀ i < p + 1, h_comb i < p
        intro i _; rw [hcomb_def]; by_cases hi : i < K
        · rw [if_pos hi, hf_def]; exact mod_lt.nat (i * i) p hp_pos
        · rw [if_neg hi, hg_def]; exact mod_lt.nat (p - (((i - K) * (i - K) + 2) % p)) p hp_pos
      have hh_inj : ∀ i1 < p + 1, ∀ i2 < p + 1, h_comb i1 = h_comb i2 → i1 = i2
        intro i1 hi1 i2 hi2 heq; rw [hcomb_def] at heq
        by_cases c1 : i1 < K
        · rw [if_pos c1] at heq; by_cases c2 : i2 < K
          · rw [if_pos c2, hf_def] at heq; exact hsq_inj i1 i2 c1 c2 heq
          · rw [if_neg c2] at heq; exfalso; have hk2 : i2 - K < K := (by omega); exact hno ⟨i1, c1, i2 - K, hk2, heq⟩
        · rw [if_neg c1] at heq; by_cases c2 : i2 < K
          · rw [if_pos c2] at heq; exfalso; have hk1 : i1 - K < K := (by omega); exact hno ⟨i2, c2, i1 - K, hk1, heq.symm⟩
          · rw [if_neg c2] at heq; have he := hg_inj (i1 - K) (i2 - K) (by omega) (by omega) heq; omega
      exact hpigeon p h_comb hh_bd hh_inj
    obtain ⟨x0, _, y0, _, hfg⟩ := hex_xy
    have hxy0_mod : (x0 * x0 + y0 * y0 + 2) % p = 0
      rw [hf_def, hg_def] at hfg; set r := (y0 * y0 + 2) % p with hr_def
      have hr_lt : r < p := by rw [hr_def]; exact mod_lt.nat (y0 * y0 + 2) p hp_pos
      have hsum_eq : (x0 * x0 + y0 * y0 + 2) % p = ((x0 * x0) % p + r) % p
        have hs : x0 * x0 + y0 * y0 + 2 = x0 * x0 + (y0 * y0 + 2) := by ring
        rw [hs, add_mod.nat, ← hr_def]
      rw [hsum_eq, hfg]
      by_cases hr0 : r = 0
      · have hpr : p - r = p := by omega
        rw [hpr, hpp0, hr0]; exact (div_mod_of_lt.nat 0 p hp_pos).2
      · have hlt_pr : p - r < p := by omega
        have hpr_sum : (p - r) + r = p := by omega
        rw [(div_mod_of_lt.nat (p - r) p hlt_pr).2, hpr_sum, hpp0]
    have hex_uv : ∃ u0 v0 : ℕ, u0 % p ≠ 0 ∧ (u0 * u0 + v0 * v0 + 2) % p = 0
      by_cases hx_z : x0 % p = 0
      · have hy_nz : y0 % p ≠ 0
          intro hy_z; have h0p : 0 % p = 0 := (div_mod_of_lt.nat 0 p hp_pos).2
          have hsq_z : (x0 * x0 + y0 * y0 + 2) % p = 2 % p
            rw [add_mod.nat (x0 * x0 + y0 * y0) 2 p, add_mod.nat (x0 * x0) (y0 * y0) p, mul_mod.nat x0 x0 p, mul_mod.nat y0 y0 p, hx_z, hy_z, mul_zero.nat, h0p, add_zero.nat, h0p, zero_add.nat, zmod.mod_mod]
          rw [hsq_z, (div_mod_of_lt.nat 2 p (by omega)).2] at hxy0_mod; omega
        have hcomm_xy : y0 * y0 + x0 * x0 + 2 = x0 * x0 + y0 * y0 + 2 := by ring
        exact ⟨y0, x0, hy_nz, by rw [hcomm_xy]; exact hxy0_mod⟩
      · exact ⟨x0, y0, hx_z, hxy0_mod⟩
    obtain ⟨u0, v0, hu0_nz, huv_mod⟩ := hex_uv
    have h2u_nz : (2 * u0) % p ≠ 0
      intro hz; have hdvd : p ∣ (2 * u0) := by unfold dvd; exact hz
      obtain hd2 | hdu := prime.dvd_mul_or p 2 u0 hp_pr hdvd
      · have hle := le_of_dvd.nat 2 p (by decide) hd2; omega
      · unfold dvd at hdu; exact hu0_nz hdu
    have hu_2u : zmod.is_unit p ((2 * u0) % p)
      apply (zmod.is_unit_iff_no_common_prime p ((2 * u0) % p) hp_pos).mpr
      intro l hl hlp hlu
      have hl_eq_p : l = p
        obtain h1 | h2 := sernau.prime_dvd_cases p l hp (by have := hl.1; omega) hlp
        · have := hl.1; omega
        · exact h2
      rw [hl_eq_p] at hlu
      have hr_pos : 0 < (2 * u0) % p := by omega
      have hle := le_of_dvd.nat ((2 * u0) % p) p hr_pos hlu
      have hlt := mod_lt.nat (2 * u0) p hp_pos; omega
    obtain ⟨inv_2u, _, hinv_2u⟩ := hu_2u
    have hhensel : ∀ k : ℕ, ∃ u q : ℕ, u % p = u0 % p ∧ 0 < q ∧ u * u + v0 * v0 + 2 = (p ^ (k + 1)) * q
      intro k; induction k with r ihr
      · set q0 := (u0 * u0 + v0 * v0 + 2) / p with hq0_def
        have hdm0 := div_add_mod.nat (u0 * u0 + v0 * v0 + 2) p; rw [← hq0_def, huv_mod] at hdm0
        have hq0_pos : 0 < q0 := by by_contra hz; have h0 : q0 = 0 := (by omega); rw [h0] at hdm0; omega
        have hp1 : p ^ (0 + 1) = p := by rw [zero_add.nat, pow_one.nat]
        exact ⟨u0, q0, by rfl, hq0_pos, by rw [hp1]; omega⟩
      · rw [succ_eq_add_one.nat]; obtain ⟨u, q, hu_mod, hq_pos, huq⟩ := ihr
        set rq := q % p with hrq_def
        have hrq_lt : rq < p := by rw [hrq_def]; exact mod_lt.nat q p hp_pos
        set t := ((p - rq) * inv_2u) % p with ht_def
        set P_r := p ^ (r + 1) with hPr_def
        set u' := u + t * P_r with hu'_def
        have hPr_mod : P_r % p = 0
          rw [hPr_def, pow_succ.nat, mul_mod.nat (p ^ r) p p, hpp0, mul_zero.nat]; exact (div_mod_of_lt.nat 0 p hp_pos).2
        have hu'_mod : u' % p = u0 % p
          rw [hu'_def, add_mod.nat, mul_mod.nat t P_r p, hPr_mod, mul_zero.nat, (div_mod_of_lt.nat 0 p hp_pos).2, add_zero.nat, zmod.mod_mod, hu_mod]
        set S_q := q + 2 * u * t + (t * t) * P_r with hSq_def
        have h2ut_mod : (2 * u * t) % p = (p - rq) % p
          have h2u_eq : (2 * u) % p = (2 * u0) % p := by rw [mul_mod.nat 2 u p, hu_mod, ← mul_mod.nat 2 u0 p]
          rw [mul_mod.nat (2 * u) t p, h2u_eq, ht_def, zmod.mod_mod, ← zmod.mod_mod (2 * u0) p, ← mul_mod.nat ((2 * u0) % p) ((p - rq) * inv_2u) p]
          have ha : ((2 * u0) % p) * ((p - rq) * inv_2u) = (((2 * u0) % p) * inv_2u) * (p - rq) := by ring
          rw [ha, mul_mod.nat (((2 * u0) % p) * inv_2u) (p - rq) p, hinv_2u, ← mul_mod.nat 1 (p - rq) p, one_mul.nat]
        have hSq_mod : S_q % p = 0
          rw [hSq_def, add_mod.nat (q + 2 * u * t) ((t * t) * P_r) p, mul_mod.nat (t * t) P_r p, hPr_mod, mul_zero.nat, (div_mod_of_lt.nat 0 p hp_pos).2, add_zero.nat, zmod.mod_mod, add_mod.nat q (2 * u * t) p, ← hrq_def, h2ut_mod]
          by_cases hrq0 : rq = 0
          · have hpr : p - rq = p := by omega
            rw [hpr, hpp0, hrq0]; exact (div_mod_of_lt.nat 0 p hp_pos).2
          · have hlt_pr : p - rq < p := by omega
            have hsum_p : rq + (p - rq) = p := by omega
            rw [(div_mod_of_lt.nat (p - rq) p hlt_pr).2, hsum_p, hpp0]
        set q' := S_q / p with hq'_def
        have hdm_Sq := div_add_mod.nat S_q p; rw [← hq'_def, hSq_mod] at hdm_Sq
        have hSq_pos : 0 < S_q := by rw [hSq_def]; omega
        have hq'_pos : 0 < q' := by by_contra hz; have h0 : q' = 0 := (by omega); rw [h0] at hdm_Sq; omega
        have hSq_eq : S_q = p * q' := by omega
        have hexp_u : u' * u' + v0 * v0 + 2 = (u * u + v0 * v0 + 2) + P_r * (2 * u * t + (t * t) * P_r) := by rw [hu'_def]; ring
        have hp_next : p ^ (r + 1 + 1) = P_r * p := by rw [hPr_def, pow_succ.nat]
        use u', q'; constructor; exact hu'_mod; constructor; exact hq'_pos
        rw [hexp_u, huq, hp_next]
        have hlin : P_r * q + P_r * (2 * u * t + (t * t) * P_r) = P_r * S_q := by rw [hSq_def]; ring
        rw [hlin, hSq_eq]; ring
    obtain ⟨u, q, _, hq_pos, huq⟩ := hhensel (M - 1)
    have hM_eq : (M - 1) + 1 = M := by omega
    rw [hM_eq] at huq
    exact ⟨u, v0, 0, 0, q, hq_pos, by have hs : u * u + v0 * v0 + 0 * 0 + 0 * 0 + 2 = u * u + v0 * v0 + 2 := (by ring); rw [hs]; exact huq⟩

+ sernau.mvps_inv_int_and_p_pow_approx (p X_card : ℕ) (v_abs : ℂ → ℝ) (F F_inv : (ℕ → ℕ) → ℂ)
    (hp : is_prime_nat p) (hv : sernau.is_padic_val_on_C p v_abs)
    (hF0 : F sernau.midx_zero = complex.one)
    (hF_int : ∀ d : ℕ → ℕ, sernau.is_midx X_card d → v_abs (F d) ≤ 1)
    (hinv : ∀ d : ℕ → ℕ, sernau.is_midx X_card d → sernau.mvps_mul X_card F F_inv d = sernau.mvps_one X_card d) :
    (F_inv sernau.midx_zero = complex.one ∧
     (∀ d : ℕ → ℕ, sernau.is_midx X_card d → v_abs (F_inv d) ≤ 1) ∧
     (∀ (D_max K q : ℕ), 0 < q → ∀ d : ℕ → ℕ, sernau.is_midx X_card d → sernau.midx_deg X_card d ≤ D_max →
       v_abs (complex.sub (sernau.mvps_pow X_card F ((p ^ (D_max + K)) * q - 1) d) (F_inv d)) ≤ (padic.abs p p) ^ K))
  obtain ⟨hcsum_le, _, _⟩ := sernau.padic_val_on_C_helpers p v_abs hp hv
  have hrh := sernau.mvps_ring_and_deg_helpers 1 X_card; have hzs := sernau.csum_zero_and_single
  have hz_m : sernau.is_midx X_card sernau.midx_zero := by intro _ _; rfl
  have hdeg_z_eq : ∀ d : ℕ → ℕ, sernau.is_midx X_card d → sernau.midx_deg X_card d = 0 → d = sernau.midx_zero
    intro d hd h0; unfold sernau.is_midx at hd; funext x; unfold sernau.midx_zero
    by_cases hx : x < X_card
    · have hle_s : ∀ m : ℕ, x < m → d x ≤ ∑ u < m, d u := by intro m; induction m with _ r ihr hlt; omega; (rw [succ_eq_add_one.nat] at hlt ⊢; rw [sum_below_succ]; by_cases hxr : x < r; (have h := ihr hxr; omega); (have he : r = x := by omega; rw [he]; omega))
      have hdx : d x ≤ 0 := by unfold sernau.midx_deg at h0; rw [← h0]; exact hle_s X_card hx
      omega
    · exact hd x (by omega)
  have hcs1 : ∀ g : ℕ → ℂ, csum 1 g = g 0 := by intro g; change csum (0 + 1) g = g 0; rw [csum.succ, csum.zero, complex.zero_add]
  have hFinv0 : F_inv sernau.midx_zero = complex.one
    have hi0 := hinv sernau.midx_zero hz_m
