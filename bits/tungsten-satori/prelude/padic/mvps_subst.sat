          intro m; induction m with _ q ihq hqX
          · have hn0 : ¬ (i0 < 0) := by omega
            rw [if_neg hn0]; rfl
          · rw [succ_eq_add_one.nat] at hqX ⊢; have hs : sernau.box_card (q + 1) d = sernau.box_card q d * (d q + 1) := by rfl
            rw [hs, ihq (by omega)]
            by_cases hiq : i0 < q
            · have hlt1 : i0 < q + 1 := (by omega); have hne : q ≠ i0 := by omega
              rw [if_pos hiq, if_pos hlt1, hsupp q (by omega) hne]; ring
            · by_cases heq : q = i0
              · have hlt1 : i0 < q + 1 := by omega
                rw [if_neg hiq, if_pos hlt1, heq]; ring
              · have hnlt1 : ¬ (i0 < q + 1) := by omega
                rw [if_neg hiq, if_neg hnlt1, hsupp q (by omega) heq]; ring
        have hbc_d : sernau.box_card X_card d = d i0 + 1 := by rw [hcard_s X_card (by omega), if_pos hi0]
        set emb : ℕ → ℕ := fun j => sernau.box_idx X_card d (sernau.midx_single i0 j) with hemb_def
        have hemb_sp : ∀ j < d i0 + 1, emb j < d i0 + 1 ∧ sernau.box_at X_card d (emb j) = sernau.midx_single i0 j
          intro j hj; have hm_j : ∀ x : ℕ, X_card ≤ x → sernau.midx_single i0 j x = 0 := by intro x hx; unfold sernau.midx_single; have hne : x ≠ i0 := by omega; rw [if_neg hne]
          have hle_j : ∀ x < X_card, sernau.midx_single i0 j x ≤ d x := by intro x hx; unfold sernau.midx_single; by_cases hxi : x = i0; (rw [if_pos hxi, hxi]; omega); (rw [if_neg hxi]; omega)
          have hsp := hbox.2.2 (sernau.midx_single i0 j) hm_j hle_j; rw [hbc_d] at hsp; rw [hemb_def]; exact hsp
        have hemb_bd : ∀ j < d i0 + 1, emb j < sernau.box_card X_card d := by intro j hj; rw [hbc_d]; have hs := hemb_sp j hj; exact hs.1
        have hemb_inj : ∀ j1 < d i0 + 1, ∀ j2 < d i0 + 1, emb j1 = emb j2 → j1 = j2
          intro j1 hj1 j2 hj2 heq; have hs1 := hemb_sp j1 hj1; have hs2 := hemb_sp j2 hj2
          have hat_eq : sernau.midx_single i0 j1 i0 = sernau.midx_single i0 j2 i0 := by rw [← hs1.2, ← hs2.2, heq]
          unfold sernau.midx_single at hat_eq; exact hat_eq
        rw [← hbc_d] at hemb_bd hemb_inj ⊢
        rw [← sernau.csum_bij_lt (sernau.box_card X_card d) emb _ hemb_bd hemb_inj, hbc_d]
        apply csum.congr; intro j hj; have hs := hemb_sp j hj; rw [hs.2]
        have hs1_supp : ∀ x < X_card, x ≠ i0 → sernau.midx_single i0 j x = 0 := by intro x _ hne; unfold sernau.midx_single; rw [if_neg hne]
        have hs2_supp : ∀ x < X_card, x ≠ i0 → sernau.midx_sub d (sernau.midx_single i0 j) x = 0 := by intro x hx hne; unfold sernau.midx_sub sernau.midx_single; rw [hsupp x hx hne, if_neg hne]; omega
        have hv1 : sernau.midx_single i0 j i0 = j := by unfold sernau.midx_single; trivial
        have hv2 : sernau.midx_sub d (sernau.midx_single i0 j) i0 = d i0 - j := by unfold sernau.midx_sub sernau.midx_single; trivial
        rw [if_pos hs1_supp, if_pos hs2_supp, hv1, hv2]
      · rw [if_neg hsupp]
        have hex_x : ∃ x1 < X_card, x1 ≠ i0 ∧ d x1 ≠ 0 := by by_contra hno; apply hsupp; intro x hx hne; by_contra hnz; exact hno ⟨x, hx, hne, hnz⟩
        obtain ⟨x1, hx1, hne1, hnz1⟩ := hex_x
        have hcon0 : ∀ idx < sernau.box_card X_card d, complex.mul (if (∀ x < X_card, x ≠ i0 → sernau.box_at X_card d idx x = 0) then sernau.fps_pow h r (sernau.box_at X_card d idx i0) else complex.zero) (if (∀ x < X_card, x ≠ i0 → sernau.midx_sub d (sernau.box_at X_card d idx) x = 0) then h (sernau.midx_sub d (sernau.box_at X_card d idx) i0) else complex.zero) = complex.zero
          intro idx hidx; have ha := hbox.2.1 idx hidx; have hle1 := ha.2.1 x1 hx1
          by_cases ha0 : sernau.box_at X_card d idx x1 = 0
          · have hnb : ¬ (∀ x < X_card, x ≠ i0 → sernau.midx_sub d (sernau.box_at X_card d idx) x = 0)
              intro hall; have hb0 := hall x1 hx1 hne1; unfold sernau.midx_sub at hb0; omega
            rw [if_neg hnb, complex.mul_zero]
          · have hna : ¬ (∀ x < X_card, x ≠ i0 → sernau.box_at X_card d idx x = 0) := by intro hall; exact ha0 (hall x1 hx1 hne1)
            rw [if_neg hna, complex.zero_mul]
        rw [csum.congr (sernau.box_card X_card d) _ (fun _ => complex.zero) hcon0]; exact hzs.1 (sernau.box_card X_card d)
  exact ⟨hsub_mul, hsub_pow, hvar_pow⟩

