-- Congruence modulo the ideal generated by m in ℤ. Certificates also work at m = 0.
import divmod

-> principal.congruent (m a b : ℤ) : Prop := ∃ k : ℤ, a - b = m * k

@[auto] + principal.of_certificate (m a b k : ℤ) (h : a - b = m * k) : principal.congruent m a b
  unfold principal.congruent
  exact ⟨k, h⟩

@[auto] + principal.refl (m x : ℤ) : principal.congruent m x x
  unfold principal.congruent
  exact ⟨0, by ring⟩

+ principal.symm (m a b : ℤ) (h : principal.congruent m a b) : principal.congruent m b a
  unfold principal.congruent at h ⊢
  obtain ⟨k, hk⟩ := h
  exact ⟨-k, by linear_combination -hk⟩

+ principal.trans (m a b c : ℤ) (h : principal.congruent m a b) (j : principal.congruent m b c) : principal.congruent m a c
  unfold principal.congruent at h j ⊢
  obtain ⟨k, hk⟩ := h
  obtain ⟨l, hl⟩ := j
  exact ⟨k+l, by linear_combination hk + hl⟩

@[auto] + principal.add (m a b c d : ℤ) (h : principal.congruent m a b) (j : principal.congruent m c d) : principal.congruent m (a+c) (b+d)
  unfold principal.congruent at h j ⊢
  obtain ⟨k, hk⟩ := h
  obtain ⟨l, hl⟩ := j
  exact ⟨k+l, by linear_combination hk + hl⟩

@[auto] + principal.sub (m a b c d : ℤ) (h : principal.congruent m a b) (j : principal.congruent m c d) : principal.congruent m (a-c) (b-d)
  unfold principal.congruent at h j ⊢
  obtain ⟨k, hk⟩ := h
  obtain ⟨l, hl⟩ := j
  exact ⟨k-l, by linear_combination hk - hl⟩

@[auto] + principal.mul (m a b c d : ℤ) (h : principal.congruent m a b) (j : principal.congruent m c d) : principal.congruent m (a*c) (b*d)
  unfold principal.congruent at h j ⊢
  obtain ⟨k, hk⟩ := h
  obtain ⟨l, hl⟩ := j
  exact ⟨c*k+b*l, by linear_combination c * hk + b * hl⟩

@[auto] + principal.pow (m a b : ℤ) (n : ℕ) (h : principal.congruent m a b) : principal.congruent m (a^n) (b^n)
  induction n with n ih
  · simp [pow_zero.int]
    apply principal.refl
  · rw [succ_eq_add_one.nat, pow_succ.int, pow_succ.int]
    exact principal.mul m (a^n) (b^n) a b ih h

@[auto] + principal.neg (m a b : ℤ) (h : principal.congruent m a b) : principal.congruent m (-a) (-b)
  unfold principal.congruent at h ⊢
  obtain ⟨k, hk⟩ := h
  exact ⟨-k, by linear_combination -hk⟩

+ principal.zero_iff (a b : ℤ) : principal.congruent 0 a b ↔ a = b
  constructor
  · intro h
    unfold principal.congruent at h
    obtain ⟨k, hk⟩ := h
    linarith
  · intro e
    rw [e]
    apply principal.refl

+ principal.mod_iff (m a b : ℤ) (hm : 0 < m) : principal.congruent m a b ↔ a % m = b % m
  constructor
  · intro h
    unfold principal.congruent at h
    obtain ⟨k, hk⟩ := h
    have e : a = b + m*k := by linarith
    rw [e, add_mul_mod.int b k m hm]
  · intro e
    unfold principal.congruent
    use a/m - b/m
    linear_combination (div_add_mod.int b m) - (div_add_mod.int a m) + e
