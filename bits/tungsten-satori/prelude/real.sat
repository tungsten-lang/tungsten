-- Real analysis vocabulary and foundational laws of the named functions.
-- Monotone convergence follows from the least-upper-bound property.

import real_completeness

-- square root, exponential, logarithm, trigonometry
opaque sqrt : ℝ → ℝ
axiom sqrt_spec (x : ℝ) : 0 ≤ x → 0 ≤ sqrt x ∧ sqrt x * sqrt x = x
axiom sqrt_nonneg (x : ℝ) : 0 ≤ sqrt x
opaque exp : ℝ → ℝ
opaque log : ℝ → ℝ
axiom exp_pos (x : ℝ) : 0 < exp x
axiom exp_add (x y : ℝ) : exp (x + y) = exp x * exp y
axiom exp_zero : exp 0 = 1
axiom log_exp (x : ℝ) : log (exp x) = x
axiom exp_log (x : ℝ) : 0 < x → exp (log x) = x
axiom exp_ge_one_add (x : ℝ) : 1 + x ≤ exp x
opaque pi : ℝ
axiom pi_bounds : 3.1415926 < pi ∧ pi < 3.1415927
opaque sin : ℝ → ℝ
opaque cos : ℝ → ℝ
axiom sin_sq_add_cos_sq (x : ℝ) : sin x * sin x + cos x * cos x = 1
axiom cos_add (x y : ℝ) : cos (x + y) = cos x * cos y - sin x * sin y
axiom sin_add (x y : ℝ) : sin (x + y) = sin x * cos y + cos x * sin y
axiom cos_zero : cos 0 = 1
axiom sin_zero : sin 0 = 0
axiom sin_abs_le (x : ℝ) : |sin x| ≤ |x|
axiom sin_sub_abs_le (x : ℝ) : |sin x - x| ≤ |x| * |x| * |x| / 6
axiom sin_pi_half : sin (pi / 2) = 1

-- sequences, limits, continuity, series
-> tends_to (a : ℕ → ℝ) (L : ℝ) : Prop := ∀ ε : ℝ, 0 < ε → ∃ N : ℕ, ∀ n : ℕ, N ≤ n → abs (a n - L) < ε
-> converges (a : ℕ → ℝ) : Prop := ∃ L, tends_to a L
-> continuous_at (f : ℝ → ℝ) (x : ℝ) : Prop := ∀ ε : ℝ, 0 < ε → ∃ δ : ℝ, 0 < δ ∧ ∀ y : ℝ, abs (y - x) < δ → abs (f y - f x) < ε
-> continuous (f : ℝ → ℝ) : Prop := ∀ x, continuous_at f x
-> partial_sum (a : ℕ → ℝ) (n : ℕ) : ℝ := ∑ i < n, a i
-> summable (a : ℕ → ℝ) : Prop := converges (partial_sum a)
-> bounded_seq (a : ℕ → ℝ) : Prop := ∃ B : ℝ, ∀ n, abs (a n) ≤ B
-> monotone_seq (a : ℕ → ℝ) : Prop := ∀ m n : ℕ, m ≤ n → a m ≤ a n

+ monotone_seq.tends_to_sup (a : ℕ → ℝ) (s : ℝ) (mono : monotone_seq a) (hs : is_sup (set.range a) s) : tends_to a s
  unfold monotone_seq at mono
  unfold tends_to
  intro e pos
  obtain ⟨N, near⟩ := is_sup.exists_range_gt a s (s-e) hs (by linarith)
  use N
  intro n hn
  have lo := mono N n hn
  have hi := is_sup.range_ge a s hs n
  by_cases zero : a n - s = 0
  · rw [zero, abs_of_nonneg.real 0 (by decide)]
    exact pos
  · rw [abs_of_neg.real (a n - s) (by linarith)]
    linarith

@[auto] + monotone_seq.converges_of_upper_bound (a : ℕ → ℝ) (b : ℝ) (mono : monotone_seq a) (bound : ∀ n, a n ≤ b) : converges a
  obtain ⟨s, hs⟩ := is_sup.range_exists a 0 b bound
  unfold converges
  exact ⟨s, monotone_seq.tends_to_sup a s mono hs⟩

+ monotone_bounded_converges (a : ℕ → ℝ) : monotone_seq a → bounded_seq a → converges a
  intro mono bounds
  unfold bounded_seq at bounds
  obtain ⟨b, hb⟩ := bounds
  apply monotone_seq.converges_of_upper_bound a b mono
  intro n
  by_cases h : 0 ≤ a n
  · have upper := hb n
    rw [abs_of_nonneg.real (a n) h] at upper
    exact upper
  · linarith [abs_nonneg.real (a n), hb n]
