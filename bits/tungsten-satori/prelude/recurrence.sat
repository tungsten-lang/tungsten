    linarith [step n]
+ recurrence.geometric_lower.rat (f : ℕ → ℚ) (r A : ℚ) (rate : 0 ≤ r) (base : A ≤ f 0)
    (step : ∀ i, r * f i ≤ f (i + 1)) (n : ℕ) : A * r ^ n ≤ f n
  induction n with n ih
  · linarith
  · rw [succ_eq_add_one.nat, pow_succ.rat]
    have h := mul_le_mul_of_nonneg_left.rat (A * r ^ n) (f n) r ih rate
    linarith [step n]

+ recurrence.linear_lower.int (f : ℕ → ℤ) (d A : ℤ) (base : A ≤ f 0)
    (step : ∀ i, f i + d ≤ f (i + 1)) (n : ℕ) : A + (n : ℤ) * d ≤ f n
  induction n with n ih
  · linarith
  · rw [succ_eq_add_one.nat, cast_succ.int]
    linarith [step n]
+ recurrence.linear_upper.int (f : ℕ → ℤ) (d A : ℤ) (base : f 0 ≤ A)
    (step : ∀ i, f (i + 1) ≤ f i + d) (n : ℕ) : f n ≤ A + (n : ℤ) * d
  induction n with n ih
  · linarith
  · rw [succ_eq_add_one.nat, cast_succ.int]
    linarith [step n]

-- Equality permits negative rates; comparison requires a nonnegative rate.
+ recurrence.geometric_eq.int (f : ℕ → ℤ) (r : ℤ) (step : ∀ i, f (i + 1) = r * f i) (n : ℕ) : f n = f 0 * r ^ n
  induction n with n ih
  · simp
  · rw [succ_eq_add_one.nat, step, pow_succ.int, ih]
    ring
