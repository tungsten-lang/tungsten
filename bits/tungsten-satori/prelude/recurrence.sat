  · rw [base]; ring
  · rw [succ_eq_add_one.nat, step, pow_succ.rat]
    calc
      (1 - r) * (f n + r ^ n) = (1 - r) * f n + (1 - r) * r ^ n := by ring
      _ = 1 - r ^ n * r := by rw [ih]; ring

+ recurrence.geometric_forcing_eq.int (f : ℕ → ℤ) (r q c : ℤ)
    (step : ∀ i, f (i + 1) = r * f i + c * q ^ i) (n : ℕ) :
    (q - r) * f n = (q - r) * f 0 * r ^ n + c * (q ^ n - r ^ n)
  induction n with n ih
  · ring
  · rw [succ_eq_add_one.nat, step, pow_succ.int r n, pow_succ.int q n]
    calc
      (q - r) * (r * f n + c * q ^ n) = r * ((q - r) * f n) + c * (q - r) * q ^ n := by ring
      _ = (q - r) * f 0 * (r ^ n * r) + c * (q ^ n * q - r ^ n * r) := by rw [ih]; ring

+ recurrence.geometric_sum.int (f : ℕ → ℤ) (r : ℤ) (base : f 0 = 0)
    (step : ∀ i, f (i + 1) = f i + r ^ i) (n : ℕ) : (1 - r) * f n = 1 - r ^ n
  induction n with n ih
  · rw [base]; ring
  · rw [succ_eq_add_one.nat, step, pow_succ.int]
    calc
      (1 - r) * (f n + r ^ n) = (1 - r) * f n + (1 - r) * r ^ n := by ring
      _ = 1 - r ^ n * r := by rw [ih]; ring


-- Natural sums retain the constant term instead of subtracting from a power.
+ recurrence.geometric_sum.nat (s : ℕ → ℕ) (r : ℕ) (base : s 0 = 0)
    (step : ∀ i, s (i + 1) = s i + (r + 1) ^ i) (n : ℕ) : r * s n + 1 = (r + 1) ^ n
  induction n with n ih
  · rw [base]; ring
  · rw [succ_eq_add_one.nat, step, pow_succ.nat]
    have e : r * (s n + (r + 1) ^ n) + 1 = (r * s n + 1) + r * (r + 1) ^ n := by ring
    rw [e, ih]
    ring

+ recurrence.geometric_sum_of_pos.nat (s : ℕ → ℕ) (r : ℕ) (positive : 1 ≤ r)
    (base : s 0 = 0) (step : ∀ i, s (i + 1) = s i + r ^ i) (n : ℕ) : (r - 1) * s n + 1 = r ^ n
  have e : r - 1 + 1 = r := by omega
  have h := recurrence.geometric_sum.nat s (r - 1) base (by intro i; rw [e]; exact step i) n
  simpa [e] using h
