-- Linear drift and geometric comparison, with explicit rate signs.
import arith

-- A closed-form sequence identity: check its initial value and one step.
+ recurrence.identity (f g : ℕ → α) (base : f 0 = g 0)
    (step : ∀ i, f i = g i → f (i+1) = g (i+1)) (n : ℕ) : f n = g n
  induction n with i ih
  · exact base
  · exact step i ih

-- Keep the parameter universally quantified when a recursive call changes it.
+ recurrence.family (f g : ℕ → α → β) (base : ∀ a, f 0 a = g 0 a)
    (step : ∀ i, (∀ a, f i a = g i a) → ∀ a, f (i+1) a = g (i+1) a)
    (n : ℕ) : ∀ a, f n a = g n a
  induction n with a i ih a
  · exact base a
  · exact step i ih a

+ recurrence.linear_lower.real (f : ℕ → ℝ) (d A : ℝ) (base : A ≤ f 0)
    (step : ∀ i, f i + d ≤ f (i + 1)) (n : ℕ) : A + (n : ℝ) * d ≤ f n
  induction n with n ih
  · linarith
  · rw [succ_eq_add_one.nat, cast_succ.real]
    linarith [step n]
+ recurrence.linear_upper.real (f : ℕ → ℝ) (d A : ℝ) (base : f 0 ≤ A)
    (step : ∀ i, f (i + 1) ≤ f i + d) (n : ℕ) : f n ≤ A + (n : ℝ) * d
  induction n with n ih
  · linarith
  · rw [succ_eq_add_one.nat, cast_succ.real]
    linarith [step n]

-- Equality permits negative rates; comparison requires a nonnegative rate.
+ recurrence.geometric_eq.real (f : ℕ → ℝ) (r : ℝ) (step : ∀ i, f (i + 1) = r * f i) (n : ℕ) : f n = f 0 * r ^ n
  induction n with n ih
  · simp
  · rw [succ_eq_add_one.nat, step, pow_succ.real, ih]
    ring
+ recurrence.geometric_upper.real (f : ℕ → ℝ) (r A : ℝ) (rate : 0 ≤ r) (base : f 0 ≤ A)
    (step : ∀ i, f (i + 1) ≤ r * f i) (n : ℕ) : f n ≤ A * r ^ n
  induction n with n ih
  · linarith
  · rw [succ_eq_add_one.nat, pow_succ.real]
    have h := mul_le_mul_of_nonneg_left.real (f n) (A * r ^ n) r ih rate
    linarith [step n]
+ recurrence.geometric_lower.real (f : ℕ → ℝ) (r A : ℝ) (rate : 0 ≤ r) (base : A ≤ f 0)
    (step : ∀ i, r * f i ≤ f (i + 1)) (n : ℕ) : A * r ^ n ≤ f n
  induction n with n ih
  · linarith
  · rw [succ_eq_add_one.nat, pow_succ.real]
    have h := mul_le_mul_of_nonneg_left.real (A * r ^ n) (f n) r ih rate
    linarith [step n]

+ recurrence.linear_lower.rat (f : ℕ → ℚ) (d A : ℚ) (base : A ≤ f 0)
    (step : ∀ i, f i + d ≤ f (i + 1)) (n : ℕ) : A + (n : ℚ) * d ≤ f n
  induction n with n ih
  · linarith
  · rw [succ_eq_add_one.nat, cast_succ.rat]
    linarith [step n]
+ recurrence.linear_upper.rat (f : ℕ → ℚ) (d A : ℚ) (base : f 0 ≤ A)
    (step : ∀ i, f (i + 1) ≤ f i + d) (n : ℕ) : f n ≤ A + (n : ℚ) * d
  induction n with n ih
  · linarith
  · rw [succ_eq_add_one.nat, cast_succ.rat]
    linarith [step n]

-- Equality permits negative rates; comparison requires a nonnegative rate.
+ recurrence.geometric_eq.rat (f : ℕ → ℚ) (r : ℚ) (step : ∀ i, f (i + 1) = r * f i) (n : ℕ) : f n = f 0 * r ^ n
  induction n with n ih
  · simp
  · rw [succ_eq_add_one.nat, step, pow_succ.rat, ih]
    ring
