import kubert_torsion

-- ====================================================================================
-- 1. Elementary Helpers: int_dvd Bridges, Coprime Ratio Reduction & 343*B^4 Splitting
-- ====================================================================================

+ shell7.int_mul_eq_zero (a b : ℤ) (h : a * b = 0) : a = 0 ∨ b = 0
  by_cases ha : a = 0
  · left; exact ha
  · right
    by_contra hb
    obtain ha_lt | ha_gt := lt_or_gt_of_ne.int a 0 ha
    · obtain hb_lt | hb_gt := lt_or_gt_of_ne.int b 0 hb
      · have hm := mul_pos.int (-a) (-b) (by linarith) (by linarith); linarith
      · have hm := mul_pos.int (-a) b (by linarith) hb_gt; linarith
    · obtain hb_lt | hb_gt := lt_or_gt_of_ne.int b 0 hb
      · have hm := mul_pos.int a (-b) ha_gt (by linarith); linarith
      · have hm := mul_pos.int a b ha_gt hb_gt; linarith

+ shell7.dvd_mul_l (l : ℕ) (a b : ℤ) (hb : int_dvd l b) : int_dvd l (a * b)
  obtain ⟨q, hq⟩ := hb
  exact ⟨a * q, by rw [hq]; ring⟩

+ shell7.int_dvd_of_nat_dvd (p n : ℕ) (hp : 0 < p) (hd : p ∣ n) : int_dvd p (n : ℤ)
  obtain ⟨q, hq⟩ := (dvd.iff_exists p n hp).mp hd
  exact ⟨(q : ℤ), by rw [hq, cast_mul.int]⟩

+ shell7.nat_dvd_of_int_dvd (p n : ℕ) (hp : 0 < p) (hd : int_dvd p (n : ℤ)) : p ∣ n
  have h1 := (cshell.dvd_iff_nat_abs p hp (n : ℤ)).mp hd
  have habs : nat_of_int (|(n : ℤ)|) = n
    have hnn : (0 : ℤ) ≤ (n : ℤ) := (cast_le.int 0 n).mpr (by omega)
    have ha : |(n : ℤ)| = (n : ℤ) := by obtain ⟨e, _⟩ | ⟨_, h⟩ := abs_cases.int (n : ℤ) <;> linarith
    exact (cast_inj.int (nat_of_int (|(n : ℤ)|)) n).mp (by rw [int_of_nat_of_int (|(n : ℤ)|) (abs_nonneg.int (n : ℤ)), ha])
  rw [habs] at h1; exact h1

+ shell7.nat_dvd_of_mod_zero (p n : ℕ) (hp : 0 < p) (h : n % p = 0) : p ∣ n
  unfold dvd; exact h

+ shell7.nat_mod_zero_of_dvd (p n : ℕ) (h : p ∣ n) : n % p = 0
  unfold dvd at h; exact h

+ shell7.odd_succ_mod2 (k : ℕ) (hk : k % 2 ≠ 0) : (k + 1) % 2 = 0
  have hlt := mod_lt.nat k 2 (by decide)
  have hd := div_add_mod.nat k 2
  have he : k + 1 = 0 + 2 * (k / 2 + 1) := by omega
  rw [he, add_mul_mod.nat]; decide

-> shell7.ratio_denom (a b rd : ℕ) : Prop :=
  0 < rd ∧ ∃ rn k : ℕ, 0 < rn ∧ 0 < k ∧ a = k * rn ∧ b = k * rd

+ shell7.reduce_ratio_coprime (a b : ℕ) (ha : 0 < a) (hb : 0 < b) :
    ∃ rn rd k : ℕ, 0 < rn ∧ 0 < rd ∧ 0 < k ∧ nat.coprime_primes rn rd ∧ a = k * rn ∧ b = k * rd
  have hex : ∃ d : ℕ, shell7.ratio_denom a b d := ⟨b, ⟨hb, ⟨a, 1, ha, by decide, by ring, by ring⟩⟩⟩
  obtain ⟨rd, hrdP, hrd_min⟩ := nat.exists_least (shell7.ratio_denom a b) hex
  unfold shell7.ratio_denom at hrdP
  obtain ⟨hrd_pos, ⟨rn, k, hrn_pos, hk_pos, ha_eq, hb_eq⟩⟩ := hrdP
  have hcop : nat.coprime_primes rn rd
    unfold nat.coprime_primes
    intro p hp ⟨hprn, hprd⟩
    have hp2 : 2 ≤ p := hp.1
    obtain ⟨rn1, hrn1⟩ := (dvd.iff_exists p rn (by omega)).mp hprn
    obtain ⟨rd1, hrd1⟩ := (dvd.iff_exists p rd (by omega)).mp hprd
    have hrn1_pos : 0 < rn1 := by by_contra h0; have hz : rn1 = 0 := by omega; rw [hz] at hrn1; omega
    have hrd1_pos : 0 < rd1 := by by_contra h0; have hz : rd1 = 0 := by omega; rw [hz] at hrd1; omega
    have hrd1_lt : rd1 < rd
      have hm := mul_le_mul_of_nonneg_right.nat 2 p rd1 hp2 (by omega)
      rw [← hrd1] at hm; omega
    apply hrd_min rd1 hrd1_lt
    unfold shell7.ratio_denom
    exact ⟨hrd1_pos, ⟨rn1, k * p, hrn1_pos, mul_pos.nat k p hk_pos (by omega),
      by rw [ha_eq, hrn1]; ring, by rw [hb_eq, hrd1]; ring⟩⟩
  exact ⟨rn, rd, k, hrn_pos, hrd_pos, hk_pos, hcop, ha_eq, hb_eq⟩

+ shell7.split_two_seven (n : ℕ) :
    0 < n → ∃ a b M : ℕ, 0 < M ∧ M % 2 ≠ 0 ∧ M % 7 ≠ 0 ∧ n = 2 ^ a * 7 ^ b * M
  apply nat.strong_induct (fun n => 0 < n → ∃ a b M : ℕ, 0 < M ∧ M % 2 ≠ 0 ∧ M % 7 ≠ 0 ∧ n = 2 ^ a * 7 ^ b * M)
  intro n ih hn
  by_cases h2 : n % 2 = 0
  · obtain ⟨n1, hn1⟩ := (dvd.iff_exists 2 n (by decide)).mp h2
    have hn1_pos : 0 < n1 := by by_contra h0; have hz : n1 = 0 := by omega; rw [hz] at hn1; omega
    obtain ⟨a, b, M, hMp, hM2, hM7, hMeq⟩ := ih n1 (by omega) hn1_pos
    exact ⟨a + 1, b, M, hMp, hM2, hM7, by rw [hn1, hMeq, pow_succ.nat 2 a]; ring⟩
  · by_cases h7 : n % 7 = 0
    · obtain ⟨n1, hn1⟩ := (dvd.iff_exists 7 n (by decide)).mp h7
      have hn1_pos : 0 < n1 := by by_contra h0; have hz : n1 = 0 := by omega; rw [hz] at hn1; omega
      obtain ⟨a, b, M, hMp, hM2, hM7, hMeq⟩ := ih n1 (by omega) hn1_pos
      exact ⟨a, b + 1, M, hMp, hM2, hM7, by rw [hn1, hMeq, pow_succ.nat 7 b]; ring⟩
    · have h20 : 2 ^ 0 = 1 := by decide
      have h70 : 7 ^ 0 = 1 := by decide
      exact ⟨0, 0, n, hn, h2, h7, by rw [h20, h70]; ring⟩

+ shell7.pow_parity_decomp (b k : ℕ) :
    ∃ r q : ℕ, (r = 1 ∨ r = b) ∧ b ^ k = r * q ^ 2
  have hdk := div_add_mod.nat k 2
  set qk := k / 2
  have hpow : b ^ (2 * qk) = (b ^ qk) ^ 2
    have hcomm : 2 * qk = qk * 2 := by ring
    rw [hcomm, nat.pow_mul_swap 2 qk b]
  by_cases hpar : k % 2 = 0
  · have hke : k = 2 * qk := by omega
    exact ⟨1, b ^ qk, by left; rfl, by rw [hke, hpow]; ring⟩
  · have hlt := mod_lt.nat k 2 (by decide)
    have hke : k = (2 * qk) + 1 := by omega
    exact ⟨b, b ^ qk, by right; rfl, by rw [hke, pow_succ.nat b (2 * qk), hpow]; ring⟩

-- Coprime splitting of `U * V = 343 * B ^ 4` into `{U, V} = {343 * R^4, S^4}` with `R * S = B`:
+ shell7.coprime_split_343_pow4 (U V B : ℕ)
    (hU : 0 < U) (hV : 0 < V) (hB : 0 < B)
    (hcop : nat.coprime_primes U V)
    (heq : U * V = 343 * B ^ 4) :
    ∃ R S : ℕ, 0 < R ∧ 0 < S ∧ nat.coprime_primes R S ∧ R * S = B ∧
      ((U = 343 * R ^ 4 ∧ V = S ^ 4) ∨ (U = R ^ 4 ∧ V = 343 * S ^ 4))
  have hd7 : 7 ∣ (U * V) := nat.dvd_of_mul_eq 7 (49 * B ^ 4) (U * V) (by decide) (by rw [heq]; ring)
  obtain h7U | h7V := is_prime_nat_seven.2 U V hd7
  · have hn7V : ¬ (7 ∣ V) := by intro h; unfold nat.coprime_primes at hcop; exact hcop 7 is_prime_nat_seven ⟨h7U, h⟩
    have hd343 : 343 ∣ U
      obtain ⟨U1, hU1⟩ := (dvd.iff_exists 7 U (by decide)).mp h7U
      have he1 : U1 * V = 49 * B ^ 4
        apply nat.mul_cancel_left_pos 7 (U1 * V) (49 * B ^ 4) (by decide)
        calc 7 * (U1 * V) = (7 * U1) * V := by ring
          _ = U * V := by rw [← hU1]
          _ = 7 * (49 * B ^ 4) := by rw [heq]; ring
      have hd7_1 : 7 ∣ (U1 * V) := nat.dvd_of_mul_eq 7 (7 * B ^ 4) (U1 * V) (by decide) (by rw [he1]; ring)
      have h7U1 : 7 ∣ U1 := by obtain h | h := is_prime_nat_seven.2 U1 V hd7_1; exact h; exfalso; exact hn7V h
      obtain ⟨U2, hU2⟩ := (dvd.iff_exists 7 U1 (by decide)).mp h7U1
      have he2 : U2 * V = 7 * B ^ 4
        apply nat.mul_cancel_left_pos 7 (U2 * V) (7 * B ^ 4) (by decide)
        calc 7 * (U2 * V) = (7 * U2) * V := by ring
          _ = U1 * V := by rw [← hU2]
          _ = 7 * (7 * B ^ 4) := by rw [he1]; ring
      have hd7_2 : 7 ∣ (U2 * V) := nat.dvd_of_mul_eq 7 (B ^ 4) (U2 * V) (by decide) he2
      have h7U2 : 7 ∣ U2 := by obtain h | h := is_prime_nat_seven.2 U2 V hd7_2; exact h; exfalso; exact hn7V h
      obtain ⟨U3, hU3⟩ := (dvd.iff_exists 7 U2 (by decide)).mp h7U2
      exact nat.dvd_of_mul_eq 343 U3 U (by decide) (by rw [hU1, hU2, hU3]; ring)
    obtain ⟨U0, hU0⟩ := (dvd.iff_exists 343 U (by decide)).mp hd343
    have hU0_pos : 0 < U0 := by by_contra h0; have hz : U0 = 0 := by omega; rw [hz] at hU0; omega
    have hcop0 : nat.coprime_primes U0 V
      unfold nat.coprime_primes at hcop ⊢
      intro p hp ⟨hp0, hpV⟩
      obtain ⟨q0, hq0⟩ := (dvd.iff_exists p U0 (by linarith [hp.1])).mp hp0
      exact hcop p hp ⟨nat.dvd_of_mul_eq p (343 * q0) U (by linarith [hp.1]) (by rw [hU0, hq0]; ring), hpV⟩
    have heq0 : U0 * V = B ^ 4
      apply nat.mul_cancel_left_pos 343 (U0 * V) (B ^ 4) (by decide)
      calc 343 * (U0 * V) = (343 * U0) * V := by ring
        _ = U * V := by rw [← hU0]
        _ = 343 * B ^ 4 := heq
    obtain ⟨R, S, hR, hS⟩ := nat.coprime_mul_eq_pow 4 (by decide) U0 hU0_pos V B hV hcop0 heq0
    have hR_pos : 0 < R := by by_contra h0; have hz : R = 0 := by omega; rw [hz] at hR; have h04 : 0 ^ 4 = 0 := by decide; rw [h04] at hR; omega
    have hS_pos : 0 < S := by by_contra h0; have hz : S = 0 := by omega; rw [hz] at hS; have h04 : 0 ^ 4 = 0 := by decide; rw [h04] at hS; omega
    have hRS_B : R * S = B
      apply kubert.pow4_inj (R * S) B
      calc (R * S) ^ 4 = R ^ 4 * S ^ 4 := by ring
        _ = U0 * V := by rw [← hR, ← hS]
        _ = B ^ 4 := heq0
    have hcop_RS : nat.coprime_primes R S
      unfold nat.coprime_primes at hcop0 ⊢
      intro p hp ⟨hpR, hpS⟩
      obtain ⟨qR, hqR⟩ := (dvd.iff_exists p R (by linarith [hp.1])).mp hpR
      obtain ⟨qS, hqS⟩ := (dvd.iff_exists p S (by linarith [hp.1])).mp hpS
      exact hcop0 p hp ⟨nat.dvd_of_mul_eq p (p ^ 3 * qR ^ 4) U0 (by linarith [hp.1]) (by rw [hR, hqR]; ring),
                        nat.dvd_of_mul_eq p (p ^ 3 * qS ^ 4) V (by linarith [hp.1]) (by rw [hS, hqS]; ring)⟩
    exact ⟨R, S, hR_pos, hS_pos, hcop_RS, hRS_B, by left; exact ⟨by rw [hU0, hR], hS⟩⟩
  · have hn7U : ¬ (7 ∣ U) := by intro h; unfold nat.coprime_primes at hcop; exact hcop 7 is_prime_nat_seven ⟨h, h7V⟩
    have hd343 : 343 ∣ V
      obtain ⟨V1, hV1⟩ := (dvd.iff_exists 7 V (by decide)).mp h7V
      have he1 : U * V1 = 49 * B ^ 4
        apply nat.mul_cancel_left_pos 7 (U * V1) (49 * B ^ 4) (by decide)
        calc 7 * (U * V1) = U * (7 * V1) := by ring
          _ = U * V := by rw [← hV1]
          _ = 7 * (49 * B ^ 4) := by rw [heq]; ring
      have hd7_1 : 7 ∣ (U * V1) := nat.dvd_of_mul_eq 7 (7 * B ^ 4) (U * V1) (by decide) (by rw [he1]; ring)
      have h7V1 : 7 ∣ V1 := by obtain h | h := is_prime_nat_seven.2 U V1 hd7_1; exfalso; exact hn7U h; exact h
      obtain ⟨V2, hV2⟩ := (dvd.iff_exists 7 V1 (by decide)).mp h7V1
      have he2 : U * V2 = 7 * B ^ 4
        apply nat.mul_cancel_left_pos 7 (U * V2) (7 * B ^ 4) (by decide)
        calc 7 * (U * V2) = U * (7 * V2) := by ring
          _ = U * V1 := by rw [← hV2]
          _ = 7 * (7 * B ^ 4) := by rw [he1]; ring
      have hd7_2 : 7 ∣ (U * V2) := nat.dvd_of_mul_eq 7 (B ^ 4) (U * V2) (by decide) he2
      have h7V2 : 7 ∣ V2 := by obtain h | h := is_prime_nat_seven.2 U V2 hd7_2; exfalso; exact hn7U h; exact h
      obtain ⟨V3, hV3⟩ := (dvd.iff_exists 7 V2 (by decide)).mp h7V2
      exact nat.dvd_of_mul_eq 343 V3 V (by decide) (by rw [hV1, hV2, hV3]; ring)
    obtain ⟨V0, hV0⟩ := (dvd.iff_exists 343 V (by decide)).mp hd343
    have hV0_pos : 0 < V0 := by by_contra h0; have hz : V0 = 0 := by omega; rw [hz] at hV0; omega
    have hcop0 : nat.coprime_primes U V0
      unfold nat.coprime_primes at hcop ⊢
      intro p hp ⟨hpU, hp0⟩
      obtain ⟨q0, hq0⟩ := (dvd.iff_exists p V0 (by linarith [hp.1])).mp hp0
      exact hcop p hp ⟨hpU, nat.dvd_of_mul_eq p (343 * q0) V (by linarith [hp.1]) (by rw [hV0, hq0]; ring)⟩
    have heq0 : U * V0 = B ^ 4
      apply nat.mul_cancel_left_pos 343 (U * V0) (B ^ 4) (by decide)
      calc 343 * (U * V0) = U * (343 * V0) := by ring
        _ = U * V := by rw [← hV0]
        _ = 343 * B ^ 4 := heq
    obtain ⟨R, S, hR, hS⟩ := nat.coprime_mul_eq_pow 4 (by decide) U hU V0 B hV0_pos hcop0 heq0
    have hR_pos : 0 < R := by by_contra h0; have hz : R = 0 := by omega; rw [hz] at hR; have h04 : 0 ^ 4 = 0 := by decide; rw [h04] at hR; omega
    have hS_pos : 0 < S := by by_contra h0; have hz : S = 0 := by omega; rw [hz] at hS; have h04 : 0 ^ 4 = 0 := by decide; rw [h04] at hS; omega
    have hRS_B : R * S = B
      apply kubert.pow4_inj (R * S) B
      calc (R * S) ^ 4 = R ^ 4 * S ^ 4 := by ring
        _ = U * V0 := by rw [← hR, ← hS]
        _ = B ^ 4 := heq0
    have hcop_RS : nat.coprime_primes R S
      unfold nat.coprime_primes at hcop0 ⊢
      intro p hp ⟨hpR, hpS⟩
      obtain ⟨qR, hqR⟩ := (dvd.iff_exists p R (by linarith [hp.1])).mp hpR
      obtain ⟨qS, hqS⟩ := (dvd.iff_exists p S (by linarith [hp.1])).mp hpS
      exact hcop0 p hp ⟨nat.dvd_of_mul_eq p (p ^ 3 * qR ^ 4) U (by linarith [hp.1]) (by rw [hR, hqR]; ring),
                        nat.dvd_of_mul_eq p (p ^ 3 * qS ^ 4) V0 (by linarith [hp.1]) (by rw [hS, hqS]; ring)⟩
    exact ⟨R, S, hR_pos, hS_pos, hcop_RS, hRS_B, by right; exact ⟨hR, by rw [hV0, hS]⟩⟩


-- ====================================================================================
-- 2. Modular Refutations & Pure-Z 2-Step Infinite Descent on S_7 ~= X_0(49) (`49a1`)
-- ====================================================================================

+ shell7.mod7_sum_sq_pow4_zero (a b : ℕ) (h : (a ^ 4 + b ^ 2) % 7 = 0) :
    a % 7 = 0 ∧ b % 7 = 0
  have hcheck : ∀ x < 7, ∀ y < 7, (x ^ 4 + y ^ 2) % 7 = 0 → x = 0 ∧ y = 0 := by decide
  have ha := div_add_mod.nat a 7
  have hb := div_add_mod.nat b 7
  set qa := a / 7; set ra := a % 7
  set qb := b / 7; set rb := b % 7
  have hmod : (ra ^ 4 + rb ^ 2) % 7 = 0
    have hpoly : a ^ 4 + b ^ 2 = (ra ^ 4 + rb ^ 2) + 7 * (
        4 * ra ^ 3 * qa + 42 * ra ^ 2 * qa ^ 2 + 196 * ra * qa ^ 3 + 343 * qa ^ 4 +
        2 * rb * qb + 7 * qb ^ 2)
      rw [← ha, ← hb]; ring
    rw [hpoly, add_mul_mod.nat] at h
    exact h
  have hra_lt : ra < 7 := by rw [ra_def]; exact mod_lt.nat a 7 (by decide)
  have hrb_lt : rb < 7 := by rw [rb_def]; exact mod_lt.nat b 7 (by decide)
  exact hcheck ra hra_lt rb hrb_lt hmod

-- Local mod-16 refutation of `2 * w^4 - 147 * w^2 * z^2 + 2744 * z^4 = v^2` (d = 2 coset on E_49):
+ shell7.no_d2_quartic (w z v : ℕ) (hcop : nat.coprime_primes w z)
    (heq : (2 : ℤ) * (w : ℤ) ^ 4 - 147 * (w : ℤ) ^ 2 * (z : ℤ) ^ 2 + 2744 * (z : ℤ) ^ 4 = (v : ℤ) ^ 2) : False
  have hmod16 : ∀ a < 16, ∀ b < 16, ∀ c < 16, (a % 2 = 1 ∨ b % 2 = 1) →
      (2 * a ^ 4 + 13 * a ^ 2 * b ^ 2 + 8 * b ^ 4) % 16 = (c ^ 2) % 16 → False := by decide
  have hpar : w % 2 = 1 ∨ z % 2 = 1
    by_contra hboth
    have hw0 : w % 2 = 0 := by have hlt := mod_lt.nat w 2 (by decide); by_contra h1; apply hboth; left; omega
    have hz0 : z % 2 = 0 := by have hlt := mod_lt.nat z 2 (by decide); by_contra h1; apply hboth; right; omega
    unfold nat.coprime_primes at hcop
    exact hcop 2 is_prime_nat_two ⟨shell7.nat_dvd_of_mod_zero 2 w (by decide) hw0, shell7.nat_dvd_of_mod_zero 2 z (by decide) hz0⟩
  have hdw := div_add_mod.nat w 16
  have hdz := div_add_mod.nat z 16
  have hdv := div_add_mod.nat v 16
  set rw_ := w % 16; set rz_ := z % 16; set rv_ := v % 16
  have hpar_r : rw_ % 2 = 1 ∨ rz_ % 2 = 1
    obtain hw1 | hz1 := hpar
    · left
      have he : w = rw_ + 2 * (8 * (w / 16)) := by omega
      rw [he, add_mul_mod.nat] at hw1; exact hw1
    · right
      have he : z = rz_ + 2 * (8 * (z / 16)) := by omega
      rw [he, add_mul_mod.nat] at hz1; exact hz1
  have hdiff : int_dvd 16 (((2 * rw_ ^ 4 + 13 * rw_ ^ 2 * rz_ ^ 2 + 8 * rz_ ^ 4 : ℕ) : ℤ) - ((rv_ ^ 2 : ℕ) : ℤ))
    have hw_z : (w : ℤ) = (rw_ : ℤ) + 16 * ((w / 16 : ℕ) : ℤ)
      have hc : ((16 * (w / 16) + rw_ : ℕ) : ℤ) = (w : ℤ) := by rw [hdw]
      rw [cast_add.int, cast_mul.int] at hc; have h16 : ((16 : ℕ) : ℤ) = 16 := by decide; rw [h16] at hc; linarith
    have hz_z : (z : ℤ) = (rz_ : ℤ) + 16 * ((z / 16 : ℕ) : ℤ)
      have hc : ((16 * (z / 16) + rz_ : ℕ) : ℤ) = (z : ℤ) := by rw [hdz]
      rw [cast_add.int, cast_mul.int] at hc; have h16 : ((16 : ℕ) : ℤ) = 16 := by decide; rw [h16] at hc; linarith
    have hv_z : (v : ℤ) = (rv_ : ℤ) + 16 * ((v / 16 : ℕ) : ℤ)
      have hc : ((16 * (v / 16) + rv_ : ℕ) : ℤ) = (v : ℤ) := by rw [hdv]
      rw [cast_add.int, cast_mul.int] at hc; have h16 : ((16 : ℕ) : ℤ) = 16 := by decide; rw [h16] at hc; linarith
    have hlhs_cast : ((2 * rw_ ^ 4 + 13 * rw_ ^ 2 * rz_ ^ 2 + 8 * rz_ ^ 4 : ℕ) : ℤ) =
        2 * (rw_ : ℤ) ^ 4 + 13 * (rw_ : ℤ) ^ 2 * (rz_ : ℤ) ^ 2 + 8 * (rz_ : ℤ) ^ 4
      simp [cast_add.int, cast_mul.int, cast_pow.int]
    have hrhs_cast : ((rv_ ^ 2 : ℕ) : ℤ) = (rv_ : ℤ) ^ 2 := cast_pow.int rv_ 2
    rw [hlhs_cast, hrhs_cast]
    set qw := ((w / 16 : ℕ) : ℤ); set qz := ((z / 16 : ℕ) : ℤ); set qv := ((v / 16 : ℕ) : ℤ)
    unfold int_dvd
    set witness : ℤ := -(8 * (rw_ : ℤ) ^ 3 * qw + 192 * (rw_ : ℤ) ^ 2 * qw ^ 2 + 2048 * (rw_ : ℤ) * qw ^ 3 + 8192 * qw ^ 4) + 10 * (rw_ : ℤ) ^ 2 * (rz_ : ℤ) ^ 2 + 147 * (2 * (rw_ : ℤ) * qw + 16 * qw ^ 2) * ((rz_ : ℤ) + 16 * qz) ^ 2 + 147 * (rw_ : ℤ) ^ 2 * (2 * (rz_ : ℤ) * qz + 16 * qz ^ 2) - 171 * (rz_ : ℤ) ^ 4 - 2744 * (4 * (rz_ : ℤ) ^ 3 * qz + 96 * (rz_ : ℤ) ^ 2 * qz ^ 2 + 1024 * (rz_ : ℤ) * qz ^ 3 + 4096 * qz ^ 4) + (2 * (rv_ : ℤ) * qv + 16 * qv ^ 2)
    use witness
    have hzero : (2 * ((rw_ : ℤ) + 16 * qw) ^ 4 - 147 * ((rw_ : ℤ) + 16 * qw) ^ 2 * ((rz_ : ℤ) + 16 * qz) ^ 2 + 2744 * ((rz_ : ℤ) + 16 * qz) ^ 4) - ((rv_ : ℤ) + 16 * qv) ^ 2 = 0 := by rw [← hw_z, ← hz_z, ← hv_z]; linarith
    have hid : (2 * (rw_ : ℤ) ^ 4 + 13 * (rw_ : ℤ) ^ 2 * (rz_ : ℤ) ^ 2 + 8 * (rz_ : ℤ) ^ 4 - (rv_ : ℤ) ^ 2) - ((2 * ((rw_ : ℤ) + 16 * qw) ^ 4 - 147 * ((rw_ : ℤ) + 16 * qw) ^ 2 * ((rz_ : ℤ) + 16 * qz) ^ 2 + 2744 * ((rz_ : ℤ) + 16 * qz) ^ 4) - ((rv_ : ℤ) + 16 * qv) ^ 2) = 16 * witness := by rw [witness_def]; ring
    rw [hzero] at hid; linarith
  have hmod_nat := cshell.nat_mod_eq_of_int_dvd 16 (2 * rw_ ^ 4 + 13 * rw_ ^ 2 * rz_ ^ 2 + 8 * rz_ ^ 4) (rv_ ^ 2) (by decide) hdiff
  have hrw_lt : rw_ < 16 := by rw [rw__def]; exact mod_lt.nat w 16 (by decide)
  have hrz_lt : rz_ < 16 := by rw [rz__def]; exact mod_lt.nat z 16 (by decide)
  have hrv_lt : rv_ < 16 := by rw [rv__def]; exact mod_lt.nat v 16 (by decide)
  exact hmod16 rw_ hrw_lt rz_ hrz_lt rv_ hrv_lt hpar_r hmod_nat

-- Quartic Q_1 (on E_49): `w^4 - 147 * w^2 * z^2 + 5488 * z^4 = v^2` with `w > 0, z > 0, gcd(w, z) = 1`:
-> shell7.Q1 (w z v : ℕ) : Prop :=
  0 < w ∧ 0 < z ∧ nat.coprime_primes w z ∧
  (w : ℤ) ^ 4 - 147 * (w : ℤ) ^ 2 * (z : ℤ) ^ 2 + 5488 * (z : ℤ) ^ 4 = (v : ℤ) ^ 2

-- Quartic Q_2 (on 2-isogenous E'_49): `p^4 + 294 * p^2 * q^2 - 343 * q^4 = r^2` with `p > 0, q > 0, gcd(p, q) = 1`:
-> shell7.Q2 (p q r : ℕ) : Prop :=
  0 < p ∧ 0 < q ∧ nat.coprime_primes p q ∧
  (p : ℤ) ^ 4 + 294 * (p : ℤ) ^ 2 * (q : ℤ) ^ 2 - 343 * (q : ℤ) ^ 4 = (r : ℤ) ^ 2

+ shell7.Q1_not_dvd7_w (w z v : ℕ) (hQ : shell7.Q1 w z v) : ¬ (7 ∣ w)
  obtain ⟨hw, hz, hcop, heq⟩ := hQ
  intro h7w
  obtain ⟨w1, hw1⟩ := (dvd.iff_exists 7 w (by decide)).mp h7w
  have hw_z : (w : ℤ) = 7 * (w1 : ℤ) := by rw [hw1, cast_mul.int]; simp
  have h7_v2 : 7 ∣ (v ^ 2)
    apply shell7.nat_dvd_of_int_dvd 7 (v ^ 2) (by decide)
    rw [cast_pow.int v 2]
    exact ⟨343 * (w1 : ℤ) ^ 4 - 1029 * (w1 : ℤ) ^ 2 * (z : ℤ) ^ 2 + 784 * (z : ℤ) ^ 4, by rw [← heq, hw_z]; ring⟩
  have h7v : 7 ∣ v := prime_dvd_of_dvd_pow.nat 7 v 2 (is_prime_nat.to_prime 7 is_prime_nat_seven) h7_v2
  obtain ⟨v1, hv1⟩ := (dvd.iff_exists 7 v (by decide)).mp h7v
  have hv_z : (v : ℤ) = 7 * (v1 : ℤ) := by rw [hv1, cast_mul.int]; simp
  have heq1 : 49 * (w1 : ℤ) ^ 4 - 147 * (w1 : ℤ) ^ 2 * (z : ℤ) ^ 2 + 112 * (z : ℤ) ^ 4 = (v1 : ℤ) ^ 2
    rw [hw_z, hv_z] at heq; linarith
  have h7_v12 : 7 ∣ (v1 ^ 2)
    apply shell7.nat_dvd_of_int_dvd 7 (v1 ^ 2) (by decide)
    rw [cast_pow.int v1 2]
    exact ⟨7 * (w1 : ℤ) ^ 4 - 21 * (w1 : ℤ) ^ 2 * (z : ℤ) ^ 2 + 16 * (z : ℤ) ^ 4, by rw [← heq1]; ring⟩
  have h7v1 : 7 ∣ v1 := prime_dvd_of_dvd_pow.nat 7 v1 2 (is_prime_nat.to_prime 7 is_prime_nat_seven) h7_v12
  obtain ⟨v2, hv2⟩ := (dvd.iff_exists 7 v1 (by decide)).mp h7v1
  have hv1_z : (v1 : ℤ) = 7 * (v2 : ℤ) := by rw [hv2, cast_mul.int]; simp
  have h7_16z4 : 7 ∣ (16 * z ^ 4)
    apply shell7.nat_dvd_of_int_dvd 7 (16 * z ^ 4) (by decide)
    have hc : ((16 * z ^ 4 : ℕ) : ℤ) = 16 * (z : ℤ) ^ 4 := by simp [cast_mul.int, cast_pow.int]
    rw [hc]
    exact ⟨(v2 : ℤ) ^ 2 - (w1 : ℤ) ^ 4 + 3 * (w1 : ℤ) ^ 2 * (z : ℤ) ^ 2, by rw [hv1_z] at heq1; linarith⟩
  obtain h716 | h7z4 := is_prime_nat_seven.2 16 (z ^ 4) h7_16z4
  · have hn : ¬ (7 ∣ 16) := by decide; exact hn h716
  · unfold nat.coprime_primes at hcop
    exact hcop 7 is_prime_nat_seven ⟨h7w, prime_dvd_of_dvd_pow.nat 7 z 4 (is_prime_nat.to_prime 7 is_prime_nat_seven) h7z4⟩

+ shell7.Q2_not_dvd7_p (p q r : ℕ) (hQ : shell7.Q2 p q r) : ¬ (7 ∣ p)
  obtain ⟨hp, hq, hcop, heq⟩ := hQ
  intro h7p
  obtain ⟨p1, hp1⟩ := (dvd.iff_exists 7 p (by decide)).mp h7p
  have hp_z : (p : ℤ) = 7 * (p1 : ℤ) := by rw [hp1, cast_mul.int]; simp
  have h7_r2 : 7 ∣ (r ^ 2)
    apply shell7.nat_dvd_of_int_dvd 7 (r ^ 2) (by decide)
    rw [cast_pow.int r 2]
    exact ⟨343 * (p1 : ℤ) ^ 4 + 2058 * (p1 : ℤ) ^ 2 * (q : ℤ) ^ 2 - 49 * (q : ℤ) ^ 4, by rw [← heq, hp_z]; ring⟩
  have h7r : 7 ∣ r := prime_dvd_of_dvd_pow.nat 7 r 2 (is_prime_nat.to_prime 7 is_prime_nat_seven) h7_r2
  obtain ⟨r1, hr1⟩ := (dvd.iff_exists 7 r (by decide)).mp h7r
  have hr_z : (r : ℤ) = 7 * (r1 : ℤ) := by rw [hr1, cast_mul.int]; simp
  have heq1 : 49 * (p1 : ℤ) ^ 4 + 294 * (p1 : ℤ) ^ 2 * (q : ℤ) ^ 2 - 7 * (q : ℤ) ^ 4 = (r1 : ℤ) ^ 2
    rw [hp_z, hr_z] at heq; linarith
  have h7_r12 : 7 ∣ (r1 ^ 2)
    apply shell7.nat_dvd_of_int_dvd 7 (r1 ^ 2) (by decide)
    rw [cast_pow.int r1 2]
    exact ⟨7 * (p1 : ℤ) ^ 4 + 42 * (p1 : ℤ) ^ 2 * (q : ℤ) ^ 2 - (q : ℤ) ^ 4, by rw [← heq1]; ring⟩
  have h7r1 : 7 ∣ r1 := prime_dvd_of_dvd_pow.nat 7 r1 2 (is_prime_nat.to_prime 7 is_prime_nat_seven) h7_r12
  obtain ⟨r2, hr2⟩ := (dvd.iff_exists 7 r1 (by decide)).mp h7r1
  have hr1_z : (r1 : ℤ) = 7 * (r2 : ℤ) := by rw [hr2, cast_mul.int]; simp
  have h7_q4 : 7 ∣ (q ^ 4)
    apply shell7.nat_dvd_of_int_dvd 7 (q ^ 4) (by decide)
    rw [cast_pow.int q 4]
    exact ⟨(p1 : ℤ) ^ 4 + 6 * (p1 : ℤ) ^ 2 * (q : ℤ) ^ 2 - (r2 : ℤ) ^ 2, by rw [hr1_z] at heq1; linarith⟩
  unfold nat.coprime_primes at hcop
  exact hcop 7 is_prime_nat_seven ⟨h7p, prime_dvd_of_dvd_pow.nat 7 q 4 (is_prime_nat.to_prime 7 is_prime_nat_seven) h7_q4⟩

-- STEP 1 OF PURE-Z DESCENT (`Q_1(w, z, v) -> Q_2(a, b, r)` with STRICTLY SMALLER `b < z`!):
+ shell7.Q1_to_Q2 (w z v : ℕ) (hQ : shell7.Q1 w z v) :
    ∃ a b r : ℕ, shell7.Q2 a b r ∧ b < z
  have hn7w := shell7.Q1_not_dvd7_w w z v hQ
  obtain ⟨hw, hz, hcop, heq⟩ := hQ
  have h4sq : (2 * (w : ℤ) ^ 2 - 147 * (z : ℤ) ^ 2) ^ 2 + 343 * (z : ℤ) ^ 4 = (2 * (v : ℤ)) ^ 2
    have h4id : 4 * ((w : ℤ) ^ 4 - 147 * (w : ℤ) ^ 2 * (z : ℤ) ^ 2 + 5488 * (z : ℤ) ^ 4) =
                (2 * (w : ℤ) ^ 2 - 147 * (z : ℤ) ^ 2) ^ 2 + 343 * (z : ℤ) ^ 4 := by ring
    linarith
  have hz_pos_z : (0 : ℤ) < (z : ℤ) := (cast_pos.int z).mpr hz
  have hz4_pos : (0 : ℤ) < (z : ℤ) ^ 4 := by nlinarith [mul_pos.int (z : ℤ) (z : ℤ) hz_pos_z hz_pos_z]
  have hv_nn : (0 : ℤ) ≤ (v : ℤ) := (cast_le.int 0 v).mpr (by omega)
  set Rz : ℤ := 2 * (v : ℤ) + (2 * (w : ℤ) ^ 2 - 147 * (z : ℤ) ^ 2)
  set Sz : ℤ := 2 * (v : ℤ) - (2 * (w : ℤ) ^ 2 - 147 * (z : ℤ) ^ 2)
  have hRS_z : Rz * Sz = 343 * (z : ℤ) ^ 4 := by
    have hre : Rz * Sz = (2 * (v : ℤ)) ^ 2 - (2 * (w : ℤ) ^ 2 - 147 * (z : ℤ) ^ 2) ^ 2 := by rw [Rz_def, Sz_def]; ring
    linarith
  have hR_pos_z : (0 : ℤ) < Rz := by by_contra hle; have hS : 0 ≤ Sz := by linarith; nlinarith
  have hS_pos_z : (0 : ℤ) < Sz := by by_contra hle; nlinarith
  have hdiff_z : Rz - Sz = 4 * (w : ℤ) ^ 2 - 294 * (z : ℤ) ^ 2 := by rw [Rz_def, Sz_def]; ring
  by_cases hz_odd : z % 2 = 1
  · set R := nat_of_int Rz; set S := nat_of_int Sz
    have hR_cast : (R : ℤ) = Rz := by rw [R_def]; exact int_of_nat_of_int Rz (by linarith)
    have hS_cast : (S : ℤ) = Sz := by rw [S_def]; exact int_of_nat_of_int Sz (by linarith)
    have hR_pos : 0 < R := (cast_pos.int R).mp (by rw [hR_cast]; exact hR_pos_z)
    have hS_pos : 0 < S := (cast_pos.int S).mp (by rw [hS_cast]; exact hS_pos_z)
    have hRS_nat : R * S = 343 * z ^ 4
      apply (cast_inj.int (R * S) (343 * z ^ 4)).mp
      have hc1 : ((R * S : ℕ) : ℤ) = Rz * Sz := by rw [cast_mul.int, hR_cast, hS_cast]
      have hc2 : ((343 * z ^ 4 : ℕ) : ℤ) = 343 * (z : ℤ) ^ 4 := by simp [cast_mul.int, cast_pow.int]
      rw [hc1, hc2, hRS_z]
    have hR_odd : R % 2 = 1
      by_contra h0
      have h2R : 2 ∣ R := shell7.nat_dvd_of_mod_zero 2 R (by decide) (by have hlt := mod_lt.nat R 2 (by decide); omega)
      have h2RS : 2 ∣ (343 * z ^ 4) := by rw [← hRS_nat]; exact dvd.mul_right_nat 2 R S (by decide) h2R
      obtain h2_343 | h2_z4 := is_prime_nat_two.2 343 (z ^ 4) h2RS
      · have hn : ¬ (2 ∣ 343) := by decide; exact hn h2_343
      · have h2z := shell7.nat_mod_zero_of_dvd 2 z (prime_dvd_of_dvd_pow.nat 2 z 4 (is_prime_nat.to_prime 2 is_prime_nat_two) h2_z4)
        omega
    have hcop_RS : nat.coprime_primes R S
      unfold nat.coprime_primes
      intro p hp ⟨hpR, hpS⟩
      have hp2 : 2 ≤ p := hp.1
      have hp_dvd_diff : int_dvd p (4 * (w : ℤ) ^ 2 - 294 * (z : ℤ) ^ 2)
        have hdR : int_dvd p Rz := by rw [← hR_cast]; exact shell7.int_dvd_of_nat_dvd p R (by omega) hpR
        have hdS : int_dvd p Sz := by rw [← hS_cast]; exact shell7.int_dvd_of_nat_dvd p S (by omega) hpS
        rw [← hdiff_z]; exact cshell.dvd_sub p Rz Sz hdR hdS
      have hp_RS : p ∣ (343 * z ^ 4) := by rw [← hRS_nat]; exact dvd.mul_right_nat p R S (by omega) hpR
      obtain hp343 | hpz4 := hp.2 343 (z ^ 4) hp_RS
      · have hp7 : p = 7
          have h343 : 343 = 7 ^ 3 := by decide; rw [h343] at hp343
          have h7 := prime_dvd_of_dvd_pow.nat p 7 3 (is_prime_nat.to_prime p hp) hp343
          obtain h1 | h2 := (is_prime_nat.to_full 7 is_prime_nat_seven).2 p h7 <;> omega
        rw [hp7] at hp_dvd_diff
        have h7_4w2 : int_dvd 7 (((4 * w ^ 2 : ℕ) : ℤ))
          have hc : ((4 * w ^ 2 : ℕ) : ℤ) = 4 * (w : ℤ) ^ 2 := by simp [cast_mul.int, cast_pow.int]
          rw [hc]
          have h294 : int_dvd 7 (294 * (z : ℤ) ^ 2) := ⟨42 * (z : ℤ) ^ 2, by ring⟩
          have hs := cshell.dvd_add 7 (4 * (w : ℤ) ^ 2 - 294 * (z : ℤ) ^ 2) (294 * (z : ℤ) ^ 2) hp_dvd_diff h294
          have hre : 4 * (w : ℤ) ^ 2 - 294 * (z : ℤ) ^ 2 + 294 * (z : ℤ) ^ 2 = 4 * (w : ℤ) ^ 2 := by ring
          rw [hre] at hs; exact hs
        obtain h74 | h7w2 := is_prime_nat_seven.2 4 (w ^ 2) (shell7.nat_dvd_of_int_dvd 7 (4 * w ^ 2) (by decide) h7_4w2)
        · have hn : ¬ (7 ∣ 4) := by decide; exact hn h74
        · exact hn7w (prime_dvd_of_dvd_pow.nat 7 w 2 (is_prime_nat.to_prime 7 is_prime_nat_seven) h7w2)
      · have hpz := prime_dvd_of_dvd_pow.nat p z 4 (is_prime_nat.to_prime p hp) hpz4
        have hp_294z2 : int_dvd p (294 * (z : ℤ) ^ 2)
          have hdz := shell7.int_dvd_of_nat_dvd p z (by omega) hpz
          have hdz2 : int_dvd p ((z : ℤ) ^ 2) := by
            have hsq : (z : ℤ) ^ 2 = (z : ℤ) * (z : ℤ) := by ring
            rw [hsq]; exact cshell.dvd_mul_r p (z : ℤ) (z : ℤ) hdz
          exact shell7.dvd_mul_l p 294 ((z : ℤ) ^ 2) hdz2
        have hp_4w2 : int_dvd p (((4 * w ^ 2 : ℕ) : ℤ))
          have hc : ((4 * w ^ 2 : ℕ) : ℤ) = 4 * (w : ℤ) ^ 2 := by simp [cast_mul.int, cast_pow.int]
          rw [hc]
          have hs := cshell.dvd_add p (4 * (w : ℤ) ^ 2 - 294 * (z : ℤ) ^ 2) (294 * (z : ℤ) ^ 2) hp_dvd_diff hp_294z2
          have hre : 4 * (w : ℤ) ^ 2 - 294 * (z : ℤ) ^ 2 + 294 * (z : ℤ) ^ 2 = 4 * (w : ℤ) ^ 2 := by ring
          rw [hre] at hs; exact hs
        obtain hp4 | hpw2 := hp.2 4 (w ^ 2) (shell7.nat_dvd_of_int_dvd p (4 * w ^ 2) (by omega) hp_4w2)
        · have h4 : 4 = 2 ^ 2 := by decide; rw [h4] at hp4
          have hp2d := prime_dvd_of_dvd_pow.nat p 2 2 (is_prime_nat.to_prime p hp) hp4
          obtain h1 | h2 := (is_prime_nat.to_full 2 is_prime_nat_two).2 p hp2d
          · omega
          · rw [h2] at hpR; have hm := shell7.nat_mod_zero_of_dvd 2 R hpR; omega
        · unfold nat.coprime_primes at hcop
          exact hcop p hp ⟨prime_dvd_of_dvd_pow.nat p w 2 (is_prime_nat.to_prime p hp) hpw2, hpz⟩
    obtain ⟨A, B, hAp, hBp, hcop_AB, hAB_z, hsplit⟩ := shell7.coprime_split_343_pow4 R S z hR_pos hS_pos hz hcop_RS hRS_nat
    obtain ⟨hR343, hS4⟩ | ⟨hR4, hS343⟩ := hsplit
    · have hRz_eq : Rz = 343 * (A : ℤ) ^ 4 := by rw [← hR_cast, hR343]; simp [cast_mul.int, cast_pow.int]
      have hSz_eq : Sz = (B : ℤ) ^ 4 := by rw [← hS_cast, hS4]; exact cast_pow.int B 4
      have hzz_eq : (z : ℤ) = (A : ℤ) * (B : ℤ) := by rw [← hAB_z, cast_mul.int]
      have hdm1 : int_dvd 7 (((B ^ 4 + (2 * w) ^ 2 : ℕ) : ℤ))
        have hc : ((B ^ 4 + (2 * w) ^ 2 : ℕ) : ℤ) = (B : ℤ) ^ 4 + (2 * (w : ℤ)) ^ 2 := by simp [cast_add.int, cast_mul.int, cast_pow.int]
        rw [hc]
        exact ⟨42 * (A : ℤ) ^ 2 * (B : ℤ) ^ 2 + 49 * (A : ℤ) ^ 4, by rw [hRz_eq, hSz_eq, hzz_eq] at hdiff_z; linarith⟩
      have hmod7 : (B ^ 4 + (2 * w) ^ 2) % 7 = 0 := shell7.nat_mod_zero_of_dvd 7 _ (shell7.nat_dvd_of_int_dvd 7 _ (by decide) hdm1)
      have h7_2w : 7 ∣ (2 * w) := shell7.nat_dvd_of_mod_zero 7 (2 * w) (by decide) (shell7.mod7_sum_sq_pow4_zero B (2 * w) hmod7).2
      obtain h72 | h7w := is_prime_nat_seven.2 2 w h7_2w
      · exfalso
        have hn : ¬ (7 ∣ 2) := by decide
        exact hn h72
      · exfalso; exact hn7w h7w
    · have hRz_eq : Rz = (A : ℤ) ^ 4 := by rw [← hR_cast, hR4]; exact cast_pow.int A 4
      have hSz_eq : Sz = 343 * (B : ℤ) ^ 4 := by rw [← hS_cast, hS343]; simp [cast_mul.int, cast_pow.int]
      have hzz_eq : (z : ℤ) = (A : ℤ) * (B : ℤ) := by rw [← hAB_z, cast_mul.int]
      have hQ2_eq : (A : ℤ) ^ 4 + 294 * (A : ℤ) ^ 2 * (B : ℤ) ^ 2 - 343 * (B : ℤ) ^ 4 = ((2 * w : ℕ) : ℤ) ^ 2
        have h2w : ((2 * w : ℕ) : ℤ) = 2 * (w : ℤ) := by simp [cast_mul.int]
        rw [h2w]; rw [hRz_eq, hSz_eq, hzz_eq] at hdiff_z; linarith
      have hA_ge2 : 2 ≤ A
        by_contra hlt2
        have hA1 : A = 1 := by omega
        rw [hA1] at hQ2_eq
        have h1c : ((1 : ℕ) : ℤ) = 1 := by decide; rw [h1c] at hQ2_eq
        have hBz : (1 : ℤ) ≤ (B : ℤ) := (cast_le.int 1 B).mpr (by omega)
        have hB2 : (1 : ℤ) ≤ (B : ℤ) ^ 2 := by nlinarith
        have hB4 : (B : ℤ) ^ 2 ≤ (B : ℤ) ^ 4 := by nlinarith
        have hsq_nn : (0 : ℤ) ≤ ((2 * w : ℕ) : ℤ) ^ 2 := by nlinarith
        nlinarith
      have hB_lt : B < z := by have hm := mul_le_mul_of_nonneg_right.nat 2 A B hA_ge2 (by omega); rw [hAB_z] at hm; omega
      exact ⟨A, B, 2 * w, ⟨hAp, hBp, hcop_AB, hQ2_eq⟩, hB_lt⟩
  · have hz2 : 2 ∣ z := shell7.nat_dvd_of_mod_zero 2 z (by decide) (by have hlt := mod_lt.nat z 2 (by decide); omega)
    obtain ⟨z0, hz0⟩ := (dvd.iff_exists 2 z (by decide)).mp hz2
    have hz0_pos : 0 < z0 := by by_contra h0; have hz_ : z0 = 0 := by omega; rw [hz_] at hz0; omega
    have hw_odd : w % 2 = 1
      by_contra h0; unfold nat.coprime_primes at hcop
      exact hcop 2 is_prime_nat_two ⟨shell7.nat_dvd_of_mod_zero 2 w (by decide) (by have hlt := mod_lt.nat w 2 (by decide); omega), hz2⟩
    have hv_odd : v % 2 = 1
      by_contra h0
      have hv2 : 2 ∣ v := shell7.nat_dvd_of_mod_zero 2 v (by decide) (by have hlt := mod_lt.nat v 2 (by decide); omega)
      obtain ⟨v0, hv0⟩ := (dvd.iff_exists 2 v (by decide)).mp hv2
      have hvv : (v : ℤ) = 2 * (v0 : ℤ) := by rw [hv0, cast_mul.int]; simp
      have hzz : (z : ℤ) = 2 * (z0 : ℤ) := by rw [hz0, cast_mul.int]; simp
      have hdw := div_add_mod.nat w 2; rw [hw_odd] at hdw
      have hww : (w : ℤ) = 2 * ((w / 2 : ℕ) : ℤ) + 1 := by
        have hc : ((2 * (w / 2) + 1 : ℕ) : ℤ) = (w : ℤ) := by rw [hdw]
        rw [cast_add.int, cast_mul.int, cast_one.int] at hc; have h2 : ((2 : ℕ) : ℤ) = 2 := by decide; rw [h2] at hc; linarith
      have hd2_1 : int_dvd 2 ((1 : ℕ) : ℤ)
        have h1c : ((1 : ℕ) : ℤ) = 1 := by decide; rw [h1c]
        unfold int_dvd
        use 2 * (v0 : ℤ) ^ 2 - (8 * ((w / 2 : ℕ) : ℤ) ^ 4 + 16 * ((w / 2 : ℕ) : ℤ) ^ 3 + 12 * ((w / 2 : ℕ) : ℤ) ^ 2 + 4 * ((w / 2 : ℕ) : ℤ)) + 294 * (w : ℤ) ^ 2 * (z0 : ℤ) ^ 2 - 43904 * (z0 : ℤ) ^ 4
        have heq' := heq; rw [hvv, hzz] at heq'
        have hlin : (w : ℤ) ^ 4 - 588 * (w : ℤ) ^ 2 * (z0 : ℤ) ^ 2 + 87808 * (z0 : ℤ) ^ 4 = 4 * (v0 : ℤ) ^ 2 := by
          have h1 : (w : ℤ) ^ 4 - 588 * (w : ℤ) ^ 2 * (z0 : ℤ) ^ 2 + 87808 * (z0 : ℤ) ^ 4 - 4 * (v0 : ℤ) ^ 2 = ((w : ℤ) ^ 4 - 147 * (w : ℤ) ^ 2 * (2 * (z0 : ℤ)) ^ 2 + 5488 * (2 * (z0 : ℤ)) ^ 4) - (2 * (v0 : ℤ)) ^ 2 := by ring
          linarith
        have hpoww : (w : ℤ) ^ 4 = 1 + 2 * (8 * ((w / 2 : ℕ) : ℤ) ^ 4 + 16 * ((w / 2 : ℕ) : ℤ) ^ 3 + 12 * ((w / 2 : ℕ) : ℤ) ^ 2 + 4 * ((w / 2 : ℕ) : ℤ)) := by rw [hww]; ring
        linarith
      have h12 := shell7.nat_mod_zero_of_dvd 2 1 (shell7.nat_dvd_of_int_dvd 2 1 (by decide) hd2_1)
      omega
    have hdw := div_add_mod.nat w 2; rw [hw_odd] at hdw
    have hdv := div_add_mod.nat v 2; rw [hv_odd] at hdv
    set qw : ℤ := ((w / 2 : ℕ) : ℤ); set qv : ℤ := ((v / 2 : ℕ) : ℤ)
    have hww : (w : ℤ) = 2 * qw + 1 := by
      have hc : ((2 * (w / 2) + 1 : ℕ) : ℤ) = (w : ℤ) := by rw [hdw]
      rw [cast_add.int, cast_mul.int, cast_one.int] at hc; have h2 : ((2 : ℕ) : ℤ) = 2 := by decide; rw [h2] at hc; linarith
    have hvv : (v : ℤ) = 2 * qv + 1 := by
      have hc : ((2 * (v / 2) + 1 : ℕ) : ℤ) = (v : ℤ) := by rw [hdv]
      rw [cast_add.int, cast_mul.int, cast_one.int] at hc; have h2 : ((2 : ℕ) : ℤ) = 2 := by decide; rw [h2] at hc; linarith
    have hzz : (z : ℤ) = 2 * (z0 : ℤ) := by rw [hz0, cast_mul.int]; simp
    set R1z : ℤ := qv + 2 * qw ^ 2 + 2 * qw + 1 - 147 * (z0 : ℤ) ^ 2
    set S1z : ℤ := qv - 2 * qw ^ 2 - 2 * qw + 147 * (z0 : ℤ) ^ 2
    have hR4e : Rz = 4 * R1z := by rw [Rz_def, R1z_def, hww, hvv, hzz]; ring
    have hS4e : Sz = 4 * S1z := by rw [Sz_def, S1z_def, hww, hvv, hzz]; ring
    have hR1_pos_z : (0 : ℤ) < R1z := by linarith
    have hS1_pos_z : (0 : ℤ) < S1z := by linarith
    have hR1S1_z : R1z * S1z = 343 * (z0 : ℤ) ^ 4 := by
      have h16 : 16 * (R1z * S1z) = Rz * Sz := by rw [hR4e, hS4e]; ring
      rw [hRS_z, hzz] at h16; linarith
    have hdiff1_z : R1z - S1z = (w : ℤ) ^ 2 - 294 * (z0 : ℤ) ^ 2 := by rw [R1z_def, S1z_def, hww]; ring
    set R1 := nat_of_int R1z; set S1 := nat_of_int S1z
    have hR1_cast : (R1 : ℤ) = R1z := by rw [R1_def]; exact int_of_nat_of_int R1z (by linarith)
    have hS1_cast : (S1 : ℤ) = S1z := by rw [S1_def]; exact int_of_nat_of_int S1z (by linarith)
    have hR1_pos : 0 < R1 := (cast_pos.int R1).mp (by rw [hR1_cast]; exact hR1_pos_z)
    have hS1_pos : 0 < S1 := (cast_pos.int S1).mp (by rw [hS1_cast]; exact hS1_pos_z)
    have hR1S1_nat : R1 * S1 = 343 * z0 ^ 4
      apply (cast_inj.int (R1 * S1) (343 * z0 ^ 4)).mp
      have hc1 : ((R1 * S1 : ℕ) : ℤ) = R1z * S1z := by rw [cast_mul.int, hR1_cast, hS1_cast]
      have hc2 : ((343 * z0 ^ 4 : ℕ) : ℤ) = 343 * (z0 : ℤ) ^ 4 := by simp [cast_mul.int, cast_pow.int]
      rw [hc1, hc2, hR1S1_z]
    have hcop_R1S1 : nat.coprime_primes R1 S1
      unfold nat.coprime_primes
      intro p hp ⟨hpR, hpS⟩
      have hp2 : 2 ≤ p := hp.1
      have hp_dvd_diff : int_dvd p ((w : ℤ) ^ 2 - 294 * (z0 : ℤ) ^ 2)
        have hdR : int_dvd p R1z := by rw [← hR1_cast]; exact shell7.int_dvd_of_nat_dvd p R1 (by omega) hpR
        have hdS : int_dvd p S1z := by rw [← hS1_cast]; exact shell7.int_dvd_of_nat_dvd p S1 (by omega) hpS
        rw [← hdiff1_z]; exact cshell.dvd_sub p R1z S1z hdR hdS
      have hp_R1S1 : p ∣ (343 * z0 ^ 4) := by rw [← hR1S1_nat]; exact dvd.mul_right_nat p R1 S1 (by omega) hpR
      obtain hp343 | hpz04 := hp.2 343 (z0 ^ 4) hp_R1S1
      · have hp7 : p = 7
          have h343 : 343 = 7 ^ 3 := by decide; rw [h343] at hp343
          have h7 := prime_dvd_of_dvd_pow.nat p 7 3 (is_prime_nat.to_prime p hp) hp343
          obtain h1 | h2 := (is_prime_nat.to_full 7 is_prime_nat_seven).2 p h7 <;> omega
        rw [hp7] at hp_dvd_diff
        have h7_w2 : int_dvd 7 (((w ^ 2 : ℕ) : ℤ))
          rw [cast_pow.int w 2]
          have h294 : int_dvd 7 (294 * (z0 : ℤ) ^ 2) := ⟨42 * (z0 : ℤ) ^ 2, by ring⟩
          have hs := cshell.dvd_add 7 ((w : ℤ) ^ 2 - 294 * (z0 : ℤ) ^ 2) (294 * (z0 : ℤ) ^ 2) hp_dvd_diff h294
          have hre : (w : ℤ) ^ 2 - 294 * (z0 : ℤ) ^ 2 + 294 * (z0 : ℤ) ^ 2 = (w : ℤ) ^ 2 := by ring
          rw [hre] at hs; exact hs
        exact hn7w (prime_dvd_of_dvd_pow.nat 7 w 2 (is_prime_nat.to_prime 7 is_prime_nat_seven) (shell7.nat_dvd_of_int_dvd 7 (w ^ 2) (by decide) h7_w2))
      · have hpz0 := prime_dvd_of_dvd_pow.nat p z0 4 (is_prime_nat.to_prime p hp) hpz04
        have hpz : p ∣ z := by rw [hz0]; exact dvd.mul_left_nat p 2 z0 (by omega) hpz0
        have hp_294z02 : int_dvd p (294 * (z0 : ℤ) ^ 2)
          have hdz := shell7.int_dvd_of_nat_dvd p z0 (by omega) hpz0
          have hdz2 : int_dvd p ((z0 : ℤ) ^ 2) := by
            have hsq : (z0 : ℤ) ^ 2 = (z0 : ℤ) * (z0 : ℤ) := by ring
            rw [hsq]; exact cshell.dvd_mul_r p (z0 : ℤ) (z0 : ℤ) hdz
          exact shell7.dvd_mul_l p 294 ((z0 : ℤ) ^ 2) hdz2
        have hp_w2 : int_dvd p (((w ^ 2 : ℕ) : ℤ))
          rw [cast_pow.int w 2]
          have hs := cshell.dvd_add p ((w : ℤ) ^ 2 - 294 * (z0 : ℤ) ^ 2) (294 * (z0 : ℤ) ^ 2) hp_dvd_diff hp_294z02
          have hre : (w : ℤ) ^ 2 - 294 * (z0 : ℤ) ^ 2 + 294 * (z0 : ℤ) ^ 2 = (w : ℤ) ^ 2 := by ring
          rw [hre] at hs; exact hs
        unfold nat.coprime_primes at hcop
        exact hcop p hp ⟨prime_dvd_of_dvd_pow.nat p w 2 (is_prime_nat.to_prime p hp) (shell7.nat_dvd_of_int_dvd p (w ^ 2) (by omega) hp_w2), hpz⟩
    obtain ⟨A, B, hAp, hBp, hcop_AB, hAB_z0, hsplit⟩ := shell7.coprime_split_343_pow4 R1 S1 z0 hR1_pos hS1_pos hz0_pos hcop_R1S1 hR1S1_nat
    obtain ⟨hR343, hS4⟩ | ⟨hR4, hS343⟩ := hsplit
    · have hR1z_eq : R1z = 343 * (A : ℤ) ^ 4 := by rw [← hR1_cast, hR343]; simp [cast_mul.int, cast_pow.int]
      have hS1z_eq : S1z = (B : ℤ) ^ 4 := by rw [← hS1_cast, hS4]; exact cast_pow.int B 4
      have hz0z_eq : (z0 : ℤ) = (A : ℤ) * (B : ℤ) := by rw [← hAB_z0, cast_mul.int]
      have hdm1 : int_dvd 7 (((B ^ 4 + w ^ 2 : ℕ) : ℤ))
        have hc : ((B ^ 4 + w ^ 2 : ℕ) : ℤ) = (B : ℤ) ^ 4 + (w : ℤ) ^ 2 := by simp [cast_add.int, cast_pow.int]
        rw [hc]
        exact ⟨42 * (A : ℤ) ^ 2 * (B : ℤ) ^ 2 + 49 * (A : ℤ) ^ 4, by rw [hR1z_eq, hS1z_eq, hz0z_eq] at hdiff1_z; linarith⟩
      have hmod7 : (B ^ 4 + w ^ 2) % 7 = 0 := shell7.nat_mod_zero_of_dvd 7 _ (shell7.nat_dvd_of_int_dvd 7 _ (by decide) hdm1)
      exfalso; exact hn7w (shell7.nat_dvd_of_mod_zero 7 w (by decide) (shell7.mod7_sum_sq_pow4_zero B w hmod7).2)
    · have hR1z_eq : R1z = (A : ℤ) ^ 4 := by rw [← hR1_cast, hR4]; exact cast_pow.int A 4
      have hS1z_eq : S1z = 343 * (B : ℤ) ^ 4 := by rw [← hS1_cast, hS343]; simp [cast_mul.int, cast_pow.int]
      have hz0z_eq : (z0 : ℤ) = (A : ℤ) * (B : ℤ) := by rw [← hAB_z0, cast_mul.int]
      have hQ2_eq : (A : ℤ) ^ 4 + 294 * (A : ℤ) ^ 2 * (B : ℤ) ^ 2 - 343 * (B : ℤ) ^ 4 = (w : ℤ) ^ 2
        rw [hR1z_eq, hS1z_eq, hz0z_eq] at hdiff1_z; linarith
      have hB_lt : B < z := by have hm := mul_le_mul_of_nonneg_right.nat 1 A B (by omega) (by omega); rw [hAB_z0] at hm; omega
      exact ⟨A, B, w, ⟨hAp, hBp, hcop_AB, hQ2_eq⟩, hB_lt⟩

-- Lemma: On Q_2, p and q CANNOT both be odd (mod-64 / mod-128 proof!):
+ shell7.Q2_not_both_odd (p q r : ℕ) (hQ : shell7.Q2 p q r) (hp_odd : p % 2 = 1) (hq_odd : q % 2 = 1) : False
  obtain ⟨hp, hq, hcop, heq⟩ := hQ
  have hodd_sq8 : ∀ n : ℕ, n % 2 = 1 → ∃ t : ℤ, (n : ℤ) ^ 2 = 1 + 8 * t
    intro n hn
    have hd := div_add_mod.nat n 2; rw [hn] at hd
    set k : ℕ := n / 2
    have hne : (n : ℤ) = 2 * (k : ℤ) + 1 := by
      have hc : ((2 * k + 1 : ℕ) : ℤ) = (n : ℤ) := by rw [hd]
      rw [cast_add.int, cast_mul.int, cast_one.int] at hc; have h2 : ((2 : ℕ) : ℤ) = 2 := by decide; rw [h2] at hc; linarith
    have hk_ev : 2 ∣ (k * (k + 1))
      by_cases hke : k % 2 = 0
      · exact dvd.mul_right_nat 2 k (k + 1) (by decide) (shell7.nat_dvd_of_mod_zero 2 k (by decide) hke)
      · exact dvd.mul_left_nat 2 k (k + 1) (by decide) (shell7.nat_dvd_of_mod_zero 2 (k + 1) (by decide) (shell7.odd_succ_mod2 k hke))
    obtain ⟨t, ht⟩ := (dvd.iff_exists 2 (k * (k + 1)) (by decide)).mp hk_ev
    have htz : (k : ℤ) * ((k : ℤ) + 1) = 2 * (t : ℤ) := by
      have hc : ((2 * t : ℕ) : ℤ) = ((k * (k + 1) : ℕ) : ℤ) := by rw [ht]
      rw [cast_mul.int, cast_mul.int, cast_add.int, cast_one.int] at hc
      have h2 : ((2 : ℕ) : ℤ) = 2 := by decide; rw [h2] at hc; linarith
    use (t : ℤ)
    calc (n : ℤ) ^ 2 = 1 + 4 * ((k : ℤ) * ((k : ℤ) + 1)) := by rw [hne]; ring
      _ = 1 + 8 * (t : ℤ) := by rw [htz]; ring
  obtain ⟨tp, htp⟩ := hodd_sq8 p hp_odd
  obtain ⟨tq, htq⟩ := hodd_sq8 q hq_odd
  have hr2_mod64 : (r : ℤ) ^ 2 = 16 + 64 * (tp ^ 2 + 37 * tp - 49 * tq + 294 * tp * tq - 343 * tq ^ 2 - 1)
    have hp4 : (p : ℤ) ^ 4 = (1 + 8 * tp) ^ 2
      calc (p : ℤ) ^ 4 = ((p : ℤ) ^ 2) ^ 2 := by ring
        _ = (1 + 8 * tp) ^ 2 := by rw [htp]
    have hq4 : (q : ℤ) ^ 4 = (1 + 8 * tq) ^ 2
      calc (q : ℤ) ^ 4 = ((q : ℤ) ^ 2) ^ 2 := by ring
        _ = (1 + 8 * tq) ^ 2 := by rw [htq]
    rw [← heq, hp4, hq4, htp, htq]; ring
  have hr_mod8 : r % 8 = 4
    have hcheck : ∀ x < 8, (x ^ 2) % 64 = 16 → x = 4 := by decide
    have hdr := div_add_mod.nat r 8
    set qr := r / 8; set rr := r % 8
    have hr_z : (r : ℤ) = (rr : ℤ) + 8 * (qr : ℤ) := by
      have hc : ((8 * qr + rr : ℕ) : ℤ) = (r : ℤ) := by rw [hdr]
      rw [cast_add.int, cast_mul.int] at hc; have h8 : ((8 : ℕ) : ℤ) = 8 := by decide; rw [h8] at hc; linarith
    -- Prove `r^2 ≡ 16 mod 64` => `rr^2 ≡ 16 mod 64` (wait: `(rr + 8*qr)^2 = rr^2 + 16*rr*qr + 64*qr^2`!
    -- Wait: if `rr` is even (`2 | rr`), `16*rr*qr` is a multiple of 32, and if `4 | rr`, `16*rr*qr` is a multiple of 64!)
    have h2r : 2 ∣ r
      have h2r2 : 2 ∣ (r ^ 2)
        apply shell7.nat_dvd_of_int_dvd 2 (r ^ 2) (by decide)
        rw [cast_pow.int r 2, hr2_mod64]
        exact ⟨8 + 32 * (tp ^ 2 + 37 * tp - 49 * tq + 294 * tp * tq - 343 * tq ^ 2 - 1), by ring⟩
      exact prime_dvd_of_dvd_pow.nat 2 r 2 (is_prime_nat.to_prime 2 is_prime_nat_two) h2r2
    obtain ⟨r0, hr0⟩ := (dvd.iff_exists 2 r (by decide)).mp h2r
    have hr0z : (r : ℤ) = 2 * (r0 : ℤ) := by rw [hr0, cast_mul.int]; simp
    have h2r0 : 2 ∣ r0
      have h2r02 : 2 ∣ (r0 ^ 2)
        apply shell7.nat_dvd_of_int_dvd 2 (r0 ^ 2) (by decide)
        rw [cast_pow.int r0 2]
        exact ⟨2 + 8 * (tp ^ 2 + 37 * tp - 49 * tq + 294 * tp * tq - 343 * tq ^ 2 - 1), by rw [hr0z] at hr2_mod64; linarith⟩
      exact prime_dvd_of_dvd_pow.nat 2 r0 2 (is_prime_nat.to_prime 2 is_prime_nat_two) h2r02
    obtain ⟨r1, hr1⟩ := (dvd.iff_exists 2 r0 (by decide)).mp h2r0
    have hr1z : (r : ℤ) = 4 * (r1 : ℤ) := by rw [hr0, hr1, cast_mul.int, cast_mul.int]; simp; ring
    have hr1_odd : r1 % 2 = 1
      by_contra h0
      have h2r1 : 2 ∣ r1 := shell7.nat_dvd_of_mod_zero 2 r1 (by decide) (by have hlt := mod_lt.nat r1 2 (by decide); omega)
      obtain ⟨r2, hr2⟩ := (dvd.iff_exists 2 r1 (by decide)).mp h2r1
      have hr2z : (r1 : ℤ) = 2 * (r2 : ℤ) := by rw [hr2, cast_mul.int]; simp
      have hd4_1 : int_dvd 4 ((1 : ℕ) : ℤ)
        have h1c : ((1 : ℕ) : ℤ) = 1 := by decide; rw [h1c]
        exact ⟨(r2 : ℤ) ^ 2 - (tp ^ 2 + 37 * tp - 49 * tq + 294 * tp * tq - 343 * tq ^ 2 - 1), by rw [hr1z, hr2z] at hr2_mod64; linarith⟩
      have hm := shell7.nat_mod_zero_of_dvd 4 1 (shell7.nat_dvd_of_int_dvd 4 1 (by decide) hd4_1); omega
    have hdr1 := div_add_mod.nat r1 2; rw [hr1_odd] at hdr1
    have hre : r = 4 + 8 * (r1 / 2) := by omega
    have hrr_lt : rr < 8 := by rw [rr_def]; exact mod_lt.nat r 8 (by decide)
    by_cases hlt : qr < r1 / 2
    · omega
    · by_cases hgt : r1 / 2 < qr
      · omega
      · have heq_q : qr = r1 / 2 := by omega
        omega
  have hdr := div_add_mod.nat r 8; rw [hr_mod8] at hdr
  set m : ℤ := ((r / 8 : ℕ) : ℤ)
  have hr_eq : (r : ℤ) = 4 + 8 * m := by
    have hc : ((8 * (r / 8) + 4 : ℕ) : ℤ) = (r : ℤ) := by rw [hdr]
    rw [cast_add.int, cast_mul.int] at hc
    have h8 : ((8 : ℕ) : ℤ) = 8 := by decide; have h4 : ((4 : ℕ) : ℤ) = 4 := by decide; rw [h8, h4] at hc; linarith
  set K : ℤ := 18 + tp + 147 * tq
  have hpq_eq : (p : ℤ) ^ 2 + 147 * (q : ℤ) ^ 2 = 4 + 8 * K := by rw [htp, htq, K_def]; ring
  have hprod_ev : (K + m + 1) * (K - m) = 343 * (q : ℤ) ^ 4
    have h1 : ((p : ℤ) ^ 2 + 147 * (q : ℤ) ^ 2) ^ 2 - (r : ℤ) ^ 2 = 64 * 343 * (q : ℤ) ^ 4 := by rw [← heq]; ring
    have h64 : 64 * ((K + m + 1) * (K - m)) = ((p : ℤ) ^ 2 + 147 * (q : ℤ) ^ 2) ^ 2 - (r : ℤ) ^ 2 := by rw [hpq_eq, hr_eq]; ring
    linarith
  have hd2_lhs : int_dvd 2 ((K + m + 1) * (K - m))
    have hA := div_add_mod.int (K + m + 1) 2
    have hB := div_add_mod.int (K - m) 2
    have hltA := mod_lt.int (K + m + 1) 2 (by decide); have hnnA := mod_nonneg.int (K + m + 1) 2 (by decide)
    have hltB := mod_lt.int (K - m) 2 (by decide); have hnnB := mod_nonneg.int (K - m) 2 (by decide)
    set qA := (K + m + 1) / 2; set qB := (K - m) / 2
    unfold int_dvd
    by_cases hA0 : (K + m + 1) % 2 = 0
    · use qA * (K - m)
      have hAe : K + m + 1 = 2 * qA := by linarith
      rw [hAe]; ring
    · have hB0 : (K - m) % 2 = 0
        by_contra hBn
        have hA1 : (K + m + 1) % 2 = 1 := by omega
        have hB1 : (K - m) % 2 = 1 := by omega
        have heq_odd : (1 + 2 * m) % 2 = (0 + 2 * (qA - qB)) % 2 := by
          have h1 : 1 + 2 * m = 0 + 2 * (qA - qB) := by linarith
          rw [h1]
        rw [add_mul_mod.int 1 m 2 (by decide), add_mul_mod.int 0 (qA - qB) 2 (by decide)] at heq_odd
        omega
      use (K + m + 1) * qB
      have hBe : K - m = 2 * qB := by linarith
      rw [hBe]; ring
  rw [hprod_ev] at hd2_lhs
  have h2_nat : 2 ∣ (343 * q ^ 4)
    apply shell7.nat_dvd_of_int_dvd 2 (343 * q ^ 4) (by decide)
    have hc : ((343 * q ^ 4 : ℕ) : ℤ) = 343 * (q : ℤ) ^ 4 := by simp [cast_mul.int, cast_pow.int]
    rw [hc]; exact hd2_lhs
  obtain h2_343 | h2_q4 := is_prime_nat_two.2 343 (q ^ 4) h2_nat
  · have hn : ¬ (2 ∣ 343) := by decide; exact hn h2_343
  · have h2q := shell7.nat_mod_zero_of_dvd 2 q (prime_dvd_of_dvd_pow.nat 2 q 4 (is_prime_nat.to_prime 2 is_prime_nat_two) h2_q4)
    omega

-- STEP 2 OF PURE-Z DESCENT (`Q_2(p, q, r) -> Q_1(w', z', v')` with `z' <= q`!):
+ shell7.Q2_to_Q1 (p q r : ℕ) (hQ : shell7.Q2 p q r) :
    ∃ w' z' v' : ℕ, shell7.Q1 w' z' v' ∧ z' ≤ q
  have hn7p := shell7.Q2_not_dvd7_p p q r hQ
  obtain ⟨hp, hq, hcop, heq⟩ := hQ
  have hopp : (p % 2 = 1 ∧ q % 2 = 0) ∨ (p % 2 = 0 ∧ q % 2 = 1)
    by_cases hp1 : p % 2 = 1
    · by_cases hq1 : q % 2 = 1
      · exfalso; exact shell7.Q2_not_both_odd p q r ⟨hp, hq, hcop, heq⟩ hp1 hq1
      · left; exact ⟨hp1, by have hlt := mod_lt.nat q 2 (by decide); omega⟩
    · by_cases hq1 : q % 2 = 1
      · right; exact ⟨by have hlt := mod_lt.nat p 2 (by decide); omega, hq1⟩
      · exfalso; unfold nat.coprime_primes at hcop
