      linarith
    have hb0_le : b0 ≤ q := by have hm := mul_le_mul_of_nonneg_right.nat 1 a b0 (by omega) (by omega); rw [hab0] at hm; omega
    exact ⟨a, b0, p, ⟨hap, hb0_pos, hcop_ab0, hQ1_eq⟩, hb0_le⟩

-> shell7.Q1_at_z (z : ℕ) : Prop :=
  0 < z ∧ ∃ w v : ℕ, shell7.Q1 w z v

+ shell7.no_Q1 (w z v : ℕ) (hQ : shell7.Q1 w z v) : False
  have hz : 0 < z := hQ.2.1
  have hdesc : ∀ k : ℕ, shell7.Q1_at_z k → ∃ m : ℕ, m < k ∧ shell7.Q1_at_z m
    intro k hk
    obtain ⟨_, ⟨w0, v0, hQ0⟩⟩ := hk
    obtain ⟨a, b, r, hQ2, hb_lt⟩ := shell7.Q1_to_Q2 w0 k v0 hQ0
    obtain ⟨w1, z1, v1, hQ1, hz1_le⟩ := shell7.Q2_to_Q1 a b r hQ2
    exact ⟨z1, by omega, ⟨hQ1.2.1, ⟨w1, v1, hQ1⟩⟩⟩
  exact nat.infinite_descent shell7.Q1_at_z hdesc z ⟨hz, ⟨w, v, hQ⟩⟩


-- ====================================================================================
-- 3. Complete Rational-Point Collapse of S_7 ~= X_0(49), ALL-CASE FLT(7), & Reduction to p >= 11
-- ====================================================================================

+ shell7.E49_no_nonzero_rational_point (rn rd Y : ℕ)
    (hrn : 0 < rn) (hrd : 0 < rd) (hcop : nat.coprime_primes rn rd)
    (heq : (rn : ℤ) * (rd : ℤ) * ((rn : ℤ) ^ 2 - 147 * (rn : ℤ) * (rd : ℤ) + 5488 * (rd : ℤ) ^ 2) = (Y : ℤ) ^ 2) : False
  have hquad_pos : (0 : ℤ) < (rn : ℤ) ^ 2 - 147 * (rn : ℤ) * (rd : ℤ) + 5488 * (rd : ℤ) ^ 2
    have h4 : 4 * ((rn : ℤ) ^ 2 - 147 * (rn : ℤ) * (rd : ℤ) + 5488 * (rd : ℤ) ^ 2) =
              (2 * (rn : ℤ) - 147 * (rd : ℤ)) ^ 2 + 343 * (rd : ℤ) ^ 2 := by ring
    have hrd_z : (0 : ℤ) < (rd : ℤ) := (cast_pos.int rd).mpr hrd
    nlinarith [mul_pos.int (rd : ℤ) (rd : ℤ) hrd_z hrd_z]
  set Qz : ℤ := (rn : ℤ) ^ 2 - 147 * (rn : ℤ) * (rd : ℤ) + 5488 * (rd : ℤ) ^ 2
  set Qn : ℕ := nat_of_int Qz
  have hQ_cast : (Qn : ℤ) = Qz := by rw [Qn_def]; exact int_of_nat_of_int Qz (by linarith)
  have hQn_pos : 0 < Qn := (cast_pos.int Qn).mp (by rw [hQ_cast]; exact hquad_pos)
  have heq_nat : rd * (rn * Qn) = Y ^ 2
    apply (cast_inj.int (rd * (rn * Qn)) (Y ^ 2)).mp
    have hc1 : ((rd * (rn * Qn) : ℕ) : ℤ) = (rd : ℤ) * ((rn : ℤ) * Qz) := by rw [cast_mul.int, cast_mul.int, hQ_cast]
    have hc2 : ((Y ^ 2 : ℕ) : ℤ) = (Y : ℤ) ^ 2 := cast_pow.int Y 2
    rw [hc1, hc2]; linarith
  have hcop_rd : nat.coprime_primes rd (rn * Qn)
    unfold nat.coprime_primes
    intro p hp ⟨hprd, hp_rnQ⟩
    have hp2 : 2 ≤ p := hp.1
    obtain hprn | hpQ := hp.2 rn Qn hp_rnQ
