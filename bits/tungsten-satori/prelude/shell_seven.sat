  obtain ⟨R, S, hRp, hSp, hcop_RS, hRS_2q, hsplit⟩ := shell7.coprime_split_343_pow4 U1 V1 (2 * q) hU1_pos hV1_pos (by omega) hcop_U1V1 hU1V1_nat
  have hsym : ∃ a b : ℕ, 0 < a ∧ 0 < b ∧ nat.coprime_primes a b ∧ a * b = 2 * q ∧
