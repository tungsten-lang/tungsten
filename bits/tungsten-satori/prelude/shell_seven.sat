  have hV1_cast : (V1 : ℤ) = V1z := by rw [V1_def]; exact int_of_nat_of_int V1z (by linarith)
  have hU1_pos : 0 < U1 := (cast_pos.int U1).mp (by rw [hU1_cast]; exact hU1_pos_z)
  have hV1_pos : 0 < V1 := (cast_pos.int V1).mp (by rw [hV1_cast]; exact hV1_pos_z)
