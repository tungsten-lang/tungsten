  have hdr := div_add_mod.int (r : ℤ) 2; rw [hr_odd] at hdr
  set kpq := ((p : ℤ) ^ 2 + 147 * (q : ℤ) ^ 2) / 2
  set kr := (r : ℤ) / 2
  set U1z : ℤ := kpq + kr + 1
  set V1z : ℤ := kpq - kr
  have hU1_2 : 2 * U1z = (p : ℤ) ^ 2 + 147 * (q : ℤ) ^ 2 + (r : ℤ) := by linarith
  have hV1_2 : 2 * V1z = (p : ℤ) ^ 2 + 147 * (q : ℤ) ^ 2 - (r : ℤ) := by linarith
  have hsum_z : U1z + V1z = (p : ℤ) ^ 2 + 147 * (q : ℤ) ^ 2 := by linarith
