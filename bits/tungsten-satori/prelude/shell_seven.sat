            have h16 : 16 * ((z : ℤ) ^ 4 - 147 * (z : ℤ) ^ 2 * (w3 : ℤ) ^ 2 + 5488 * (w3 : ℤ) ^ 4 - (v4 : ℤ) ^ 2) = (16 * (z : ℤ) ^ 4 - 147 * (z : ℤ) ^ 2 * (2 * (2 * (w3 : ℤ))) ^ 2 + 343 * (2 * (2 * (w3 : ℤ))) ^ 4) - (2 * (2 * (v4 : ℤ))) ^ 2 := by ring
            rw [hw2z, hw3z, hv3z, hv4z] at hswap; linarith
          exact shell7.no_Q1 z w3 v4 ⟨hz_pos, hw3_pos, hcop_zw3, hQ1_eq⟩
        · have hcop_2z_w2 : nat.coprime_primes (2 * z) w2
            unfold nat.coprime_primes
            intro p hp ⟨hp2z, hpw2⟩
            obtain hp2_ | hpz := hp.2 2 z hp2z
            · obtain h1 | h2 := (is_prime_nat.to_full 2 is_prime_nat_two).2 p hp2_
              · linarith [hp.1]
              · rw [h2] at hpw2; exact hw2_ev (shell7.nat_mod_zero_of_dvd 2 w2 hpw2)
            · unfold nat.coprime_primes at hcop_zw2; exact hcop_zw2 p hp ⟨hpz, hpw2⟩
          have hQ1_eq : ((2 * z : ℕ) : ℤ) ^ 4 - 147 * ((2 * z : ℕ) : ℤ) ^ 2 * (w2 : ℤ) ^ 2 + 5488 * (w2 : ℤ) ^ 4 = (v2 : ℤ) ^ 2
            have h2z : ((2 * z : ℕ) : ℤ) = 2 * (z : ℤ) := by simp [cast_mul.int]
            rw [h2z]; rw [hw2z] at hswap
            have hring : (2 * (z : ℤ)) ^ 4 - 147 * (2 * (z : ℤ)) ^ 2 * (w2 : ℤ) ^ 2 + 5488 * (w2 : ℤ) ^ 4 = 16 * (z : ℤ) ^ 4 - 147 * (z : ℤ) ^ 2 * (2 * (w2 : ℤ)) ^ 2 + 343 * (2 * (w2 : ℤ)) ^ 4 := by ring
            linarith
          exact shell7.no_Q1 (2 * z) w2 v2 ⟨by omega, hw2_pos, hcop_2z_w2, hQ1_eq⟩
      · have hcop_4z_w1 : nat.coprime_primes (4 * z) w1
          unfold nat.coprime_primes
          intro p hp ⟨hp4z, hpw1⟩
          obtain hp4_ | hpz := hp.2 4 z hp4z
          · have h4 : 4 = 2 ^ 2 := by decide; rw [h4] at hp4_
            have hp2_ := prime_dvd_of_dvd_pow.nat p 2 2 (is_prime_nat.to_prime p hp) hp4_
            obtain h1 | h2 := (is_prime_nat.to_full 2 is_prime_nat_two).2 p hp2_
            · linarith [hp.1]
            · rw [h2] at hpw1; exact hw1_ev (shell7.nat_mod_zero_of_dvd 2 w1 hpw1)
          · unfold nat.coprime_primes at hcop_zw1; exact hcop_zw1 p hp ⟨hpz, hpw1⟩
        have hQ1_eq : ((4 * z : ℕ) : ℤ) ^ 4 - 147 * ((4 * z : ℕ) : ℤ) ^ 2 * (w1 : ℤ) ^ 2 + 5488 * (w1 : ℤ) ^ 4 = ((4 * v2 : ℕ) : ℤ) ^ 2
          have h4z : ((4 * z : ℕ) : ℤ) = 4 * (z : ℤ) := by simp [cast_mul.int]
          have h4v : ((4 * v2 : ℕ) : ℤ) = 4 * (v2 : ℤ) := by simp [cast_mul.int]
          rw [h4z, h4v]
          have h16 : (4 * (z : ℤ)) ^ 4 - 147 * (4 * (z : ℤ)) ^ 2 * (w1 : ℤ) ^ 2 + 5488 * (w1 : ℤ) ^ 4 - (4 * (v2 : ℤ)) ^ 2 = 16 * ((16 * (z : ℤ) ^ 4 - 147 * (z : ℤ) ^ 2 * (w1 : ℤ) ^ 2 + 343 * (w1 : ℤ) ^ 4) - (v2 : ℤ) ^ 2) := by ring
          linarith
        exact shell7.no_Q1 (4 * z) w1 (4 * v2) ⟨by omega, hw1_pos, hcop_4z_w1, hQ1_eq⟩
  · obtain hr7_1 | hr7_7 := hr7
    · have hd2 : (d : ℤ) = 2 := by rw [d_def, hr2_2, hr7_1]; decide
      rw [hd2] at hv_main
      have h2v : 2 ∣ v
        apply prime_dvd_of_dvd_pow.nat 2 v 2 (is_prime_nat.to_prime 2 is_prime_nat_two)
        apply shell7.nat_dvd_of_int_dvd 2 (v ^ 2) (by decide)
        rw [cast_pow.int v 2]
        exact ⟨4 * (w : ℤ) ^ 4 - 294 * (w : ℤ) ^ 2 * (z : ℤ) ^ 2 + 5488 * (z : ℤ) ^ 4, by rw [← hv_main]; ring⟩
      obtain ⟨v1, hv1⟩ := (dvd.iff_exists 2 v (by decide)).mp h2v
      have hv1z : (v : ℤ) = 2 * (v1 : ℤ) := by rw [hv1, cast_mul.int]; simp
      have hd2_eq : 2 * (w : ℤ) ^ 4 - 147 * (w : ℤ) ^ 2 * (z : ℤ) ^ 2 + 2744 * (z : ℤ) ^ 4 = (v1 : ℤ) ^ 2
        have h4 : 4 * (2 * (w : ℤ) ^ 4 - 147 * (w : ℤ) ^ 2 * (z : ℤ) ^ 2 + 2744 * (z : ℤ) ^ 4 - (v1 : ℤ) ^ 2) = 2 * (2 ^ 2 * (w : ℤ) ^ 4 - 147 * 2 * (w : ℤ) ^ 2 * (z : ℤ) ^ 2 + 5488 * (z : ℤ) ^ 4) - (2 * (v1 : ℤ)) ^ 2 := by ring
        rw [hv1z] at hv_main; linarith
      exact shell7.no_d2_quartic w z v1 hcop_wz hd2_eq
    · have hd14 : (d : ℤ) = 14 := by rw [d_def, hr2_2, hr7_7]; decide
      rw [hd14] at hv_main
      have h7v : 7 ∣ v
        apply prime_dvd_of_dvd_pow.nat 7 v 2 (is_prime_nat.to_prime 7 is_prime_nat_seven)
        apply shell7.nat_dvd_of_int_dvd 7 (v ^ 2) (by decide)
        rw [cast_pow.int v 2]
        exact ⟨2 * (196 * (w : ℤ) ^ 4 - 2058 * (w : ℤ) ^ 2 * (z : ℤ) ^ 2 + 5488 * (z : ℤ) ^ 4), by rw [← hv_main]; ring⟩
      obtain ⟨v1, hv1⟩ := (dvd.iff_exists 7 v (by decide)).mp h7v
      have hv1z : (v : ℤ) = 7 * (v1 : ℤ) := by rw [hv1, cast_mul.int]; simp
      have heq1 : 14 * (4 * (w : ℤ) ^ 4 - 42 * (w : ℤ) ^ 2 * (z : ℤ) ^ 2 + 112 * (z : ℤ) ^ 4) = (v1 : ℤ) ^ 2
        have h49 : 49 * (14 * (4 * (w : ℤ) ^ 4 - 42 * (w : ℤ) ^ 2 * (z : ℤ) ^ 2 + 112 * (z : ℤ) ^ 4) - (v1 : ℤ) ^ 2) = 14 * (14 ^ 2 * (w : ℤ) ^ 4 - 147 * 14 * (w : ℤ) ^ 2 * (z : ℤ) ^ 2 + 5488 * (z : ℤ) ^ 4) - (7 * (v1 : ℤ)) ^ 2 := by ring
        rw [hv1z] at hv_main; linarith
      have h7v1 : 7 ∣ v1
        apply prime_dvd_of_dvd_pow.nat 7 v1 2 (is_prime_nat.to_prime 7 is_prime_nat_seven)
        apply shell7.nat_dvd_of_int_dvd 7 (v1 ^ 2) (by decide)
        rw [cast_pow.int v1 2]
        exact ⟨2 * (4 * (w : ℤ) ^ 4 - 42 * (w : ℤ) ^ 2 * (z : ℤ) ^ 2 + 112 * (z : ℤ) ^ 4), by rw [← heq1]; ring⟩
      obtain ⟨v2, hv2⟩ := (dvd.iff_exists 7 v1 (by decide)).mp h7v1
      have hv2z : (v1 : ℤ) = 7 * (v2 : ℤ) := by rw [hv2, cast_mul.int]; simp
      have h7w : 7 ∣ w
        have h7_8w4 : 7 ∣ (8 * w ^ 4)
          apply shell7.nat_dvd_of_int_dvd 7 (8 * w ^ 4) (by decide)
          have hc : ((8 * w ^ 4 : ℕ) : ℤ) = 8 * (w : ℤ) ^ 4 := by simp [cast_mul.int, cast_pow.int]
          rw [hc]
          use (v2 : ℤ) ^ 2 + 12 * (w : ℤ) ^ 2 * (z : ℤ) ^ 2 - 32 * (z : ℤ) ^ 4
          have h7r : 7 * (8 * (w : ℤ) ^ 4 - 7 * ((v2 : ℤ) ^ 2 + 12 * (w : ℤ) ^ 2 * (z : ℤ) ^ 2 - 32 * (z : ℤ) ^ 4)) = 14 * (4 * (w : ℤ) ^ 4 - 42 * (w : ℤ) ^ 2 * (z : ℤ) ^ 2 + 112 * (z : ℤ) ^ 4) - (7 * (v2 : ℤ)) ^ 2 := by ring
          rw [hv2z] at heq1; linarith
        obtain h78 | h7w4 := is_prime_nat_seven.2 8 (w ^ 4) h7_8w4
        · exfalso
          have hn : ¬ (7 ∣ 8) := by decide
          exact hn h78
        · exact prime_dvd_of_dvd_pow.nat 7 w 4 (is_prime_nat.to_prime 7 is_prime_nat_seven) h7w4
      obtain ⟨w1, hw1⟩ := (dvd.iff_exists 7 w (by decide)).mp h7w
      have hw1z : (w : ℤ) = 7 * (w1 : ℤ) := by rw [hw1, cast_mul.int]; simp
      have h2v2 : 2 ∣ v2
        apply prime_dvd_of_dvd_pow.nat 2 v2 2 (is_prime_nat.to_prime 2 is_prime_nat_two)
        apply shell7.nat_dvd_of_int_dvd 2 (v2 ^ 2) (by decide)
        rw [cast_pow.int v2 2]
        use 1372 * (w1 : ℤ) ^ 4 - 294 * (w1 : ℤ) ^ 2 * (z : ℤ) ^ 2 + 16 * (z : ℤ) ^ 4
        have h49 : 49 * ((v2 : ℤ) ^ 2 - 2 * (1372 * (w1 : ℤ) ^ 4 - 294 * (w1 : ℤ) ^ 2 * (z : ℤ) ^ 2 + 16 * (z : ℤ) ^ 4)) = (7 * (v2 : ℤ)) ^ 2 - 14 * (4 * (7 * (w1 : ℤ)) ^ 4 - 42 * (7 * (w1 : ℤ)) ^ 2 * (z : ℤ) ^ 2 + 112 * (z : ℤ) ^ 4) := by ring
        rw [hv2z, hw1z] at heq1; linarith
      obtain ⟨v3, hv3⟩ := (dvd.iff_exists 2 v2 (by decide)).mp h2v2
      have hv3z : (v2 : ℤ) = 2 * (v3 : ℤ) := by rw [hv3, cast_mul.int]; simp
      have hcop_zw1 : nat.coprime_primes z w1
        unfold nat.coprime_primes
        intro p hp ⟨hpz, hpw1⟩
        unfold nat.coprime_primes at hcop_wz
        exact hcop_wz p hp ⟨by rw [hw1]; exact dvd.mul_left_nat p 7 w1 (by linarith [hp.1]) hpw1, hpz⟩
      have hmid : 686 * (w1 : ℤ) ^ 4 - 147 * (w1 : ℤ) ^ 2 * (z : ℤ) ^ 2 + 8 * (z : ℤ) ^ 4 = (v3 : ℤ) ^ 2
        have h196 : 196 * (686 * (w1 : ℤ) ^ 4 - 147 * (w1 : ℤ) ^ 2 * (z : ℤ) ^ 2 + 8 * (z : ℤ) ^ 4 - (v3 : ℤ) ^ 2) = 14 * (4 * (7 * (w1 : ℤ)) ^ 4 - 42 * (7 * (w1 : ℤ)) ^ 2 * (z : ℤ) ^ 2 + 112 * (z : ℤ) ^ 4) - (7 * (2 * (v3 : ℤ))) ^ 2 := by ring
        rw [hv2z, hv3z, hw1z] at heq1; linarith
      by_cases hw1_ev : w1 % 2 = 0
      · obtain ⟨w2, hw2⟩ := (dvd.iff_exists 2 w1 (by decide)).mp (shell7.nat_dvd_of_mod_zero 2 w1 (by decide) hw1_ev)
        have hw2z : (w1 : ℤ) = 2 * (w2 : ℤ) := by rw [hw2, cast_mul.int]; simp
        have h2v3 : 2 ∣ v3
          apply prime_dvd_of_dvd_pow.nat 2 v3 2 (is_prime_nat.to_prime 2 is_prime_nat_two)
          apply shell7.nat_dvd_of_int_dvd 2 (v3 ^ 2) (by decide)
          rw [cast_pow.int v3 2]
          use 5488 * (w2 : ℤ) ^ 4 - 294 * (w2 : ℤ) ^ 2 * (z : ℤ) ^ 2 + 4 * (z : ℤ) ^ 4
          rw [← hmid, hw2z]; ring
        obtain ⟨v4, hv4⟩ := (dvd.iff_exists 2 v3 (by decide)).mp h2v3
        have hv4z : (v3 : ℤ) = 2 * (v4 : ℤ) := by rw [hv4, cast_mul.int]; simp
        have hcop_zw2 : nat.coprime_primes z w2
          unfold nat.coprime_primes
          intro p hp ⟨hpz, hpw2⟩
          unfold nat.coprime_primes at hcop_zw1
          exact hcop_zw1 p hp ⟨hpz, by rw [hw2]; exact dvd.mul_left_nat p 2 w2 (by linarith [hp.1]) hpw2⟩
        have hd2_eq : 2 * (z : ℤ) ^ 4 - 147 * (z : ℤ) ^ 2 * (w2 : ℤ) ^ 2 + 2744 * (w2 : ℤ) ^ 4 = (v4 : ℤ) ^ 2
          have h4 : 4 * (2 * (z : ℤ) ^ 4 - 147 * (z : ℤ) ^ 2 * (w2 : ℤ) ^ 2 + 2744 * (w2 : ℤ) ^ 4 - (v4 : ℤ) ^ 2) = (686 * (2 * (w2 : ℤ)) ^ 4 - 147 * (2 * (w2 : ℤ)) ^ 2 * (z : ℤ) ^ 2 + 8 * (z : ℤ) ^ 4) - (2 * (v4 : ℤ)) ^ 2 := by ring
          rw [hw2z, hv4z] at hmid; linarith
        exact shell7.no_d2_quartic z w2 v4 hcop_zw2 hd2_eq
      · have hcop_2z_w1 : nat.coprime_primes (2 * z) w1
          unfold nat.coprime_primes
          intro p hp ⟨hp2z, hpw1⟩
          obtain hp2_ | hpz := hp.2 2 z hp2z
          · obtain h1 | h2 := (is_prime_nat.to_full 2 is_prime_nat_two).2 p hp2_
            · linarith [hp.1]
            · rw [h2] at hpw1; exact hw1_ev (shell7.nat_mod_zero_of_dvd 2 w1 hpw1)
          · unfold nat.coprime_primes at hcop_zw1; exact hcop_zw1 p hp ⟨hpz, hpw1⟩
        have hd2_eq : 2 * ((2 * z : ℕ) : ℤ) ^ 4 - 147 * ((2 * z : ℕ) : ℤ) ^ 2 * (w1 : ℤ) ^ 2 + 2744 * (w1 : ℤ) ^ 4 = ((2 * v3 : ℕ) : ℤ) ^ 2
          have h2z : ((2 * z : ℕ) : ℤ) = 2 * (z : ℤ) := by simp [cast_mul.int]
          have h2v : ((2 * v3 : ℕ) : ℤ) = 2 * (v3 : ℤ) := by simp [cast_mul.int]
          rw [h2z, h2v]
          have h4 : 2 * (2 * (z : ℤ)) ^ 4 - 147 * (2 * (z : ℤ)) ^ 2 * (w1 : ℤ) ^ 2 + 2744 * (w1 : ℤ) ^ 4 - (2 * (v3 : ℤ)) ^ 2 = 4 * ((686 * (w1 : ℤ) ^ 4 - 147 * (w1 : ℤ) ^ 2 * (z : ℤ) ^ 2 + 8 * (z : ℤ) ^ 4) - (v3 : ℤ) ^ 2) := by ring
          linarith
        exact shell7.no_d2_quartic (2 * z) w1 (2 * v3) hcop_2z_w1 hd2_eq

+ shell7.lame_to_E49_identity (A B M : ℤ) :
    (7 * M * (2 * B - A ^ 2)) ^ 2 - 7 * M * A * (28 * M ^ 2 - 21 * A ^ 3 * M + 4 * A ^ 6) =
    28 * M * (7 * M * (B ^ 2 - A ^ 2 * B + A ^ 4 - A * M) - A ^ 7)
  ring

+ shell7.lame_in_ABM (x y z : ℤ) :
    (x + y + z) ^ 7 - (x ^ 7 + y ^ 7 + z ^ 7) =
    7 * ((x + y) * (y + z) * (z + x)) *
      ((x * y + y * z + z * x) ^ 2 - (x + y + z) ^ 2 * (x * y + y * z + z * x) +
       (x + y + z) ^ 4 - (x + y + z) * ((x + y) * (y + z) * (z + x)))
  ring

-- THEOREM 3A (ALL-CASE SIGNED FLT FOR n = 7 DIRECTLY FROM COUPLED 7-SIDED SHELLS — 0 AXIOMS!):
+ shell7.signed_exp_seven (x y z : ℤ) (hx : x ≠ 0) (hy : y ≠ 0) (hz : z ≠ 0)
    (heq : x ^ 7 + y ^ 7 + z ^ 7 = 0) : False
  set A : ℤ := x + y + z
  set B : ℤ := x * y + y * z + z * x
  set M : ℤ := (x + y) * (y + z) * (z + x)
  have hlame : A ^ 7 = 7 * M * (B ^ 2 - A ^ 2 * B + A ^ 4 - A * M)
    have h := shell7.lame_in_ABM x y z
    rw [heq, ← A_def, ← B_def, ← M_def] at h; linarith
  have hM_nz : M ≠ 0
    intro h0
    have hxy0 : x + y = 0 ∨ y + z = 0 ∨ z + x = 0
      obtain h12 | h3 := shell7.int_mul_eq_zero ((x + y) * (y + z)) (z + x) (by rw [← M_def]; exact h0)
      · obtain h1 | h2 := shell7.int_mul_eq_zero (x + y) (y + z) h12
        · left; exact h1
        · right; left; exact h2
      · right; right; exact h3
    have hpow7_zero : ∀ t : ℤ, t ^ 7 = 0 → t = 0
      intro t ht7
      by_contra htnz
      have h2 : (0 : ℤ) < t ^ 2 := int.sq_pos_of_nz t htnz
      have h6 : (0 : ℤ) < t ^ 6
        have hre : t ^ 6 = (t ^ 2) * (t ^ 2) * (t ^ 2) := by ring
        have h4 : (0 : ℤ) < (t ^ 2) * (t ^ 2) := mul_pos.int (t ^ 2) (t ^ 2) h2 h2
        rw [hre]; exact mul_pos.int ((t ^ 2) * (t ^ 2)) (t ^ 2) h4 h2
      have hprod : t * t ^ 6 = 0 := by rw [← ht7]; ring
      obtain h0 | h60 := shell7.int_mul_eq_zero t (t ^ 6) hprod
      · exact htnz h0
      · linarith
    obtain h1 | h2 | h3 := hxy0
    · have hyx : y = -x := by linarith
      rw [hyx] at heq
      have h07 : x ^ 7 + (-x) ^ 7 = 0 := by ring
      have hz7 : z ^ 7 = 0 := by linarith
      exact hz (hpow7_zero z hz7)
    · have hzy : z = -y := by linarith
      rw [hzy] at heq
      have h07 : y ^ 7 + (-y) ^ 7 = 0 := by ring
      have hx7 : x ^ 7 = 0 := by linarith
      exact hx (hpow7_zero x hx7)
    · have hxz : x = -z := by linarith
      rw [hxz] at heq
      have h07 : (-z) ^ 7 + z ^ 7 = 0 := by ring
      have hy7 : y ^ 7 = 0 := by linarith
      exact hy (hpow7_zero y hy7)
  have hA_nz : A ≠ 0
    intro hA0
    have hz_eq : z = -(x + y) := by linarith
    have hB_neg : 2 * B = -(x ^ 2 + y ^ 2 + (x + y) ^ 2) := by rw [B_def, hz_eq]; ring
    have hB_nz : B ≠ 0
      intro hB0
      have hx2 : x ^ 2 = 0 := by nlinarith
      linarith [int.sq_pos_of_nz x hx]
    rw [hA0] at hlame
    have h7MB2 : 7 * M * B ^ 2 = 0 := by linarith
    obtain h7M | hB20 := shell7.int_mul_eq_zero (7 * M) (B ^ 2) h7MB2
    · exact hM_nz (by linarith)
    · linarith [int.sq_pos_of_nz B hB_nz]
  have hE49 : (7 * M * (2 * B - A ^ 2)) ^ 2 = 7 * M * A * (28 * M ^ 2 - 21 * A ^ 3 * M + 4 * A ^ 6)
    have hid := shell7.lame_to_E49_identity A B M
    have hzero : 7 * M * (B ^ 2 - A ^ 2 * B + A ^ 4 - A * M) - A ^ 7 = 0 := by linarith
    rw [hzero] at hid; linarith
  have hA3_nz : A ^ 3 ≠ 0
    intro h0
    have hsq : A ^ 3 = A * (A * A) := by ring
    rw [hsq] at h0
    obtain h1 | h2 := shell7.int_mul_eq_zero A (A * A) h0
    · exact hA_nz h1
    · linarith [int.sq_pos_of_nz A hA_nz]
  have hQ_pos : 0 < 28 * M ^ 2 - 21 * A ^ 3 * M + 4 * A ^ 6
    have h112 : 112 * (28 * M ^ 2 - 21 * A ^ 3 * M + 4 * A ^ 6) = (56 * M - 21 * A ^ 3) ^ 2 + 7 * (A ^ 3) ^ 2 := by ring
    have hA6 : 0 < (A ^ 3) ^ 2 := by have h := int.sq_pos_of_nz (A ^ 3) hA3_nz; linarith
    nlinarith
  have hMA_pos : 0 < M * A
    by_contra hle
    have hMA_nz : M * A ≠ 0 := by intro h0; obtain h1 | h2 := shell7.int_mul_eq_zero M A h0 <;> contradiction
    have h1 : 0 < -(7 * M * A) := by omega
    have hm := mul_pos.int (-(7 * M * A)) (28 * M ^ 2 - 21 * A ^ 3 * M + 4 * A ^ 6) h1 hQ_pos
    have hlhs_nn : 0 ≤ (7 * M * (2 * B - A ^ 2)) ^ 2 := by nlinarith
    linarith
  set num_n : ℕ := nat_of_int (|196 * M|)
  set den_n : ℕ := nat_of_int (|A ^ 3|)
  have hnum_pos : 0 < num_n
    have h196_nz : 196 * M ≠ 0 := by intro h0; exact hM_nz (by linarith)
    have habs_pos : (0 : ℤ) < |196 * M| := by obtain ⟨e, h⟩ | ⟨e, h⟩ := abs_cases.int (196 * M) <;> omega
    exact (cast_pos.int num_n).mp (by rw [num_n_def, int_of_nat_of_int (|196 * M|) (abs_nonneg.int (196 * M))]; exact habs_pos)
  have hden_pos : 0 < den_n
    have habs_pos : (0 : ℤ) < |A ^ 3| := by obtain ⟨e, h⟩ | ⟨e, h⟩ := abs_cases.int (A ^ 3) <;> omega
    exact (cast_pos.int den_n).mp (by rw [den_n_def, int_of_nat_of_int (|A ^ 3|) (abs_nonneg.int (A ^ 3))]; exact habs_pos)
  obtain ⟨rn, rd, k, hrn_p, hrd_p, hk_p, hcop_r, hnum_eq, hden_eq⟩ := shell7.reduce_ratio_coprime num_n den_n hnum_pos hden_pos
  have hMA3_pos : 0 < (196 * M) * (A ^ 3)
    have hA2 : 0 < A * A := int.sq_pos_of_nz A hA_nz
    have hre : (196 * M) * (A ^ 3) = (196 * (M * A)) * (A * A) := by ring
    rw [hre]; exact mul_pos.int (196 * (M * A)) (A * A) (by linarith) hA2
  have hsign_eq : (rn : ℤ) * (A ^ 3) = (rd : ℤ) * (196 * M)
    have hnum_z : ((k : ℤ) * (rn : ℤ)) = |196 * M| := by
      rw [← cast_mul.int k rn, ← hnum_eq, num_n_def, int_of_nat_of_int (|196 * M|) (abs_nonneg.int (196 * M))]
    have hden_z : ((k : ℤ) * (rd : ℤ)) = |A ^ 3| := by
      rw [← cast_mul.int k rd, ← hden_eq, den_n_def, int_of_nat_of_int (|A ^ 3|) (abs_nonneg.int (A ^ 3))]
    have hk_pos_z : (0 : ℤ) < (k : ℤ) := (cast_pos.int k).mpr hk_p
    have hsame : |196 * M| * (A ^ 3) = |A ^ 3| * (196 * M)
      obtain ⟨e1, h1⟩ | ⟨e1, h1⟩ := abs_cases.int (196 * M)
      · obtain ⟨e2, h2⟩ | ⟨e2, h2⟩ := abs_cases.int (A ^ 3)
        · rw [e1, e2]; ring
        · exfalso; have hm := mul_pos.int (196 * M) (-(A ^ 3)) (by omega) (by omega); linarith
      · obtain ⟨e2, h2⟩ | ⟨e2, h2⟩ := abs_cases.int (A ^ 3)
        · exfalso; have hm := mul_pos.int (-(196 * M)) (A ^ 3) (by omega) (by omega); linarith
        · rw [e1, e2]; ring
    rw [← hnum_z, ← hden_z] at hsame
    have hk_diff : (k : ℤ) * ((rn : ℤ) * A ^ 3 - (rd : ℤ) * (196 * M)) = 0 := by linarith
    obtain hk0 | hdiff0 := shell7.int_mul_eq_zero (k : ℤ) ((rn : ℤ) * A ^ 3 - (rd : ℤ) * (196 * M)) hk_diff <;> linarith
  have hE49_scaled : (196 * (rd : ℤ) ^ 2 * (7 * M * (2 * B - A ^ 2))) ^ 2 =
      (A ^ 5) ^ 2 * ((rn : ℤ) * (rd : ℤ) * ((rn : ℤ) ^ 2 - 147 * (rn : ℤ) * (rd : ℤ) + 5488 * (rd : ℤ) ^ 2))
    have hmul : (196 * (rd : ℤ) ^ 2) ^ 2 * (7 * M * (2 * B - A ^ 2)) ^ 2 =
                (196 * (rd : ℤ) ^ 2) ^ 2 * (7 * M * A * (28 * M ^ 2 - 21 * A ^ 3 * M + 4 * A ^ 6)) := by rw [hE49]
    have h1 : (rd : ℤ) * (196 * M) = (rn : ℤ) * A ^ 3 := by linarith
    have hstep : (196 * (rd : ℤ) ^ 2) ^ 2 * (7 * M * A * (28 * M ^ 2 - 21 * A ^ 3 * M + 4 * A ^ 6)) =
        A * ((rd : ℤ) * (196 * M)) * (rd : ℤ) *
          (((rd : ℤ) * (196 * M)) ^ 2 - 147 * ((rd : ℤ) * (196 * M)) * ((rd : ℤ) * A ^ 3) + 5488 * ((rd : ℤ) * A ^ 3) ^ 2) := by ring
    rw [hstep, h1] at hmul
    have hring_f : A * ((rn : ℤ) * A ^ 3) * (rd : ℤ) * (((rn : ℤ) * A ^ 3) ^ 2 - 147 * ((rn : ℤ) * A ^ 3) * ((rd : ℤ) * A ^ 3) + 5488 * ((rd : ℤ) * A ^ 3) ^ 2) =
        (A ^ 5) ^ 2 * ((rn : ℤ) * (rd : ℤ) * ((rn : ℤ) ^ 2 - 147 * (rn : ℤ) * (rd : ℤ) + 5488 * (rd : ℤ) ^ 2)) := by ring
    have hsq_l : (196 * (rd : ℤ) ^ 2 * (7 * M * (2 * B - A ^ 2))) ^ 2 = (196 * (rd : ℤ) ^ 2) ^ 2 * (7 * M * (2 * B - A ^ 2)) ^ 2 := by ring
    linarith
  set Lval : ℤ := 196 * (rd : ℤ) ^ 2 * (7 * M * (2 * B - A ^ 2))
  set Rval : ℤ := (rn : ℤ) * (rd : ℤ) * ((rn : ℤ) ^ 2 - 147 * (rn : ℤ) * (rd : ℤ) + 5488 * (rd : ℤ) ^ 2)
  set Lnat : ℕ := nat_of_int (|Lval|)
  set Anat : ℕ := nat_of_int (|A ^ 5|)
  have hA5_nz : A ^ 5 ≠ 0
    intro h0
    have hre : A ^ 5 = (A * A) * A ^ 3 := by ring; rw [hre] at h0
    obtain h1 | h2 := shell7.int_mul_eq_zero (A * A) (A ^ 3) h0
    · linarith [int.sq_pos_of_nz A hA_nz]
    · exact hA3_nz h2
  have hAnat_pos : 0 < Anat
    have habs_pos : (0 : ℤ) < |A ^ 5| := by obtain ⟨e, h⟩ | ⟨e, h⟩ := abs_cases.int (A ^ 5) <;> omega
    exact (cast_pos.int Anat).mp (by rw [Anat_def, int_of_nat_of_int (|A ^ 5|) (abs_nonneg.int (A ^ 5))]; exact habs_pos)
  have hAnat_sq : (Anat : ℤ) ^ 2 = (A ^ 5) ^ 2
    have h1 : (Anat : ℤ) = |A ^ 5| := by rw [Anat_def]; exact int_of_nat_of_int (|A ^ 5|) (abs_nonneg.int (A ^ 5))
    rw [h1]
    obtain ⟨e, _⟩ | ⟨e, _⟩ := abs_cases.int (A ^ 5)
    · rw [e]
    · rw [e]; ring
  have hLnat_sq : (Lnat : ℤ) ^ 2 = Lval ^ 2
    have h1 : (Lnat : ℤ) = |Lval| := by rw [Lnat_def]; exact int_of_nat_of_int (|Lval|) (abs_nonneg.int Lval)
    rw [h1]
    obtain ⟨e, _⟩ | ⟨e, _⟩ := abs_cases.int Lval
    · rw [e]
    · rw [e]; ring
  have hR_pos : (0 : ℤ) < Rval
    have h4 : 4 * ((rn : ℤ) ^ 2 - 147 * (rn : ℤ) * (rd : ℤ) + 5488 * (rd : ℤ) ^ 2) =
              (2 * (rn : ℤ) - 147 * (rd : ℤ)) ^ 2 + 343 * (rd : ℤ) ^ 2 := by ring
    have hrd_z : (0 : ℤ) < (rd : ℤ) := (cast_pos.int rd).mpr hrd_p
    have hrn_z : (0 : ℤ) < (rn : ℤ) := (cast_pos.int rn).mpr hrn_p
    have hq_p : (0 : ℤ) < (rn : ℤ) ^ 2 - 147 * (rn : ℤ) * (rd : ℤ) + 5488 * (rd : ℤ) ^ 2 := by nlinarith [mul_pos.int (rd : ℤ) (rd : ℤ) hrd_z hrd_z]
    rw [Rval_def]
    exact mul_pos.int ((rn : ℤ) * (rd : ℤ)) _ (mul_pos.int (rn : ℤ) (rd : ℤ) hrn_z hrd_z) hq_p
  set Rnat : ℕ := nat_of_int Rval
  have hRnat_cast : (Rnat : ℤ) = Rval := by rw [Rnat_def]; exact int_of_nat_of_int Rval (by linarith)
  have hLnat_eq : Lnat ^ 2 = Anat ^ 2 * Rnat
    apply (cast_inj.int (Lnat ^ 2) (Anat ^ 2 * Rnat)).mp
    have hc1 : ((Lnat ^ 2 : ℕ) : ℤ) = (Lnat : ℤ) ^ 2 := cast_pow.int Lnat 2
    have hc2 : ((Anat ^ 2 * Rnat : ℕ) : ℤ) = (Anat : ℤ) ^ 2 * (Rnat : ℤ) := by rw [cast_mul.int, cast_pow.int]
    rw [hc1, hc2, hLnat_sq, hAnat_sq, hRnat_cast]; exact hE49_scaled
  have hLnat_pos : 0 < Lnat
    by_contra h0; have hz_ : Lnat = 0 := by omega
    rw [hz_] at hLnat_eq; have h02 : 0 ^ 2 = 0 := by decide; rw [h02] at hLnat_eq
    have hRp : 0 < Rnat := (cast_pos.int Rnat).mp (by rw [hRnat_cast]; exact hR_pos)
    have hpos := mul_pos.nat (Anat ^ 2) Rnat (pow_pos.nat Anat 2 hAnat_pos) hRp
    omega
  obtain ⟨u1, v1, g1, hu1p, hv1p, hg1p, hcop1, hLe, hAe⟩ := shell7.reduce_ratio_coprime Lnat Anat hLnat_pos hAnat_pos
  have hv1_eq1 : v1 = 1
    by_contra hne1
    set p := min_fac v1
    have hp : is_prime_nat p := by rw [p_def]; exact prime.to_is_prime_nat (min_fac v1) (min_fac.prime v1 (by omega))
    have hpv1 : p ∣ v1 := by rw [p_def]; exact (min_fac.spec v1 (by omega)).2.2.1
    have hcancel : u1 ^ 2 = v1 ^ 2 * Rnat
      apply nat.mul_cancel_left_pos (g1 ^ 2) (u1 ^ 2) (v1 ^ 2 * Rnat) (pow_pos.nat g1 2 hg1p)
      calc g1 ^ 2 * u1 ^ 2 = (g1 * u1) ^ 2 := by ring
        _ = Lnat ^ 2 := by rw [← hLe]
        _ = Anat ^ 2 * Rnat := hLnat_eq
        _ = (g1 * v1) ^ 2 * Rnat := by rw [hAe]
        _ = g1 ^ 2 * (v1 ^ 2 * Rnat) := by ring
    have hpu12 : p ∣ (u1 ^ 2)
      obtain ⟨qv, hqv⟩ := (dvd.iff_exists p v1 (by linarith [hp.1])).mp hpv1
      exact nat.dvd_of_mul_eq p (p * qv ^ 2 * Rnat) (u1 ^ 2) (by linarith [hp.1]) (by rw [hcancel, hqv]; ring)
    unfold nat.coprime_primes at hcop1
    exact hcop1 p hp ⟨prime_dvd_of_dvd_pow.nat p u1 2 (is_prime_nat.to_prime p hp) hpu12, hpv1⟩
  have hRnat_sq : Rnat = u1 ^ 2
    apply nat.mul_cancel_left_pos (Anat ^ 2) Rnat (u1 ^ 2) (pow_pos.nat Anat 2 hAnat_pos)
    have hAe1 : Anat = g1 := by rw [hAe, hv1_eq1]; ring
    calc Anat ^ 2 * Rnat = Lnat ^ 2 := by rw [← hLnat_eq]
      _ = (g1 * u1) ^ 2 := by rw [hLe]
      _ = Anat ^ 2 * u1 ^ 2 := by rw [hAe1]; ring
  have hfinal_z : Rval = (u1 : ℤ) ^ 2 := by rw [← hRnat_cast, hRnat_sq, cast_pow.int]
  rw [Rval_def] at hfinal_z
  exact shell7.E49_no_nonzero_rational_point rn rd u1 hrn_p hrd_p hcop_r hfinal_z

-- THEOREM 3B (COMPLETE ALL-CASE FLT FOR n = 7 — 0 CUSTOM AXIOMS!):
+ flt.exp_seven (x y z : ℕ) (hx : 0 < x) (hy : 0 < y) : x ^ 7 + y ^ 7 ≠ z ^ 7
  intro heq
  have hz : 0 < z
    by_contra h0; have hz0 : z = 0 := by omega
    rw [hz0] at heq; have h07 : 0 ^ 7 = 0 := by decide; have hx7 := pow_pos.nat x 7 hx; omega
  have heq_z : (x : ℤ) ^ 7 + (y : ℤ) ^ 7 + (-(z : ℤ)) ^ 7 = 0
    have hc : ((x ^ 7 + y ^ 7 : ℕ) : ℤ) = ((z ^ 7 : ℕ) : ℤ) := by rw [heq]
    rw [cast_add.int, cast_pow.int, cast_pow.int, cast_pow.int] at hc
    have hneg : (-(z : ℤ)) ^ 7 = -((z : ℤ) ^ 7) := by ring
    rw [hneg]; linarith
  have hx_nz : (x : ℤ) ≠ 0 := by linarith [(cast_pos.int x).mpr hx]
  have hy_nz : (y : ℤ) ≠ 0 := by linarith [(cast_pos.int y).mpr hy]
  have hz_nz : -(z : ℤ) ≠ 0 := by linarith [(cast_pos.int z).mpr hz]
  exact shell7.signed_exp_seven (x : ℤ) (y : ℤ) (-(z : ℤ)) hx_nz hy_nz hz_nz heq_z

-- THEOREM 3C (ALL-EXPONENT REDUCTION TO ODD PRIMES p >= 11 — 0 CUSTOM AXIOMS!):
+ flt.reduce_to_primes_ge_11 (hp11 : ∀ p : ℕ, is_prime_nat p → 11 ≤ p → flt_at p) :
    ∀ n : ℕ, 3 ≤ n → flt_at n
  apply flt.reduce_to_primes_ge_7
  intro p hp hp7
  by_cases h7 : p = 7
  · rw [h7]; unfold flt_at; exact flt.exp_seven
  · have hpr := is_prime_nat.to_prime p hp
    unfold prime at hpr
    have hge11 : 11 ≤ p
      by_contra hlt11
      by_cases h8 : p = 8
      · rw [h8] at hpr; exact hpr.2 2 (by decide) (by decide) (by decide)
      · by_cases h9 : p = 9
        · rw [h9] at hpr; exact hpr.2 3 (by decide) (by decide) (by decide)
        · have h10 : p = 10 := by omega
          rw [h10] at hpr; exact hpr.2 2 (by decide) (by decide) (by decide)
    exact hp11 p hp hge11


-- ====================================================================================
-- 4. Coupled-Shell Taxonomy Across Dimensions: p = 3, 5, 7, 11, Single-Shell Gram Curve E^+_{R,L},
--    Uniqueness of Genus 1 at p = 7, & Lower-Stratum Deficit Law (ALL 0 Custom Axioms!)
-- ====================================================================================

+ shell7.coupled_deg3_identity (x y z u v w : ℤ)
    (hu : u = y + z) (hv : v = z + x) (hw : w = x + y) :
    (u + v + w) ^ 3 - 8 * (x ^ 3 + y ^ 3 + z ^ 3) = 24 * u * v * w
  rw [hu, hv, hw]; ring

+ shell7.coupled_deg3_case1 (x y z a0 b0 c0 : ℤ) (ha : a0 ≠ 0) (hb : b0 ≠ 0) (hc : c0 ≠ 0)
    (heq : x ^ 3 + y ^ 3 + z ^ 3 = 0)
    (hu : y + z = a0 ^ 3) (hv : z + x = b0 ^ 3) (hw : x + y = c0 ^ 3) : False
  have hid := shell7.coupled_deg3_identity x y z (y + z) (z + x) (x + y) rfl rfl rfl
  rw [heq, hu, hv, hw] at hid
  set S : ℤ := a0 ^ 3 + b0 ^ 3 + c0 ^ 3
  set P : ℤ := a0 * b0 * c0
  have hP_nz : P ≠ 0
    intro h0
    obtain hab | hc0 := shell7.int_mul_eq_zero (a0 * b0) c0 (by rw [← P_def]; exact h0)
    · obtain ha0 | hb0 := shell7.int_mul_eq_zero a0 b0 hab <;> contradiction
    · exact hc hc0
  have hP3 : 24 * (a0 ^ 3) * (b0 ^ 3) * (c0 ^ 3) = 24 * P ^ 3 := by rw [P_def]; ring
  have hcube : S ^ 3 = 24 * P ^ 3 := by linarith
  set Sn := nat_of_int (|S|); set Pn := nat_of_int (|P|)
  have hPn_pos : 0 < Pn
    have habs : (0 : ℤ) < |P| := by obtain ⟨e, h⟩ | ⟨e, h⟩ := abs_cases.int P <;> omega
    exact (cast_pos.int Pn).mp (by rw [Pn_def, int_of_nat_of_int (|P|) (abs_nonneg.int P)]; exact habs)
  have hcube_nat : Sn ^ 3 = 24 * Pn ^ 3
    have hS_abs : |S| ^ 3 = 24 * |P| ^ 3
      obtain ⟨e1, h1⟩ | ⟨e1, h1⟩ := abs_cases.int S
      · obtain ⟨e2, h2⟩ | ⟨e2, h2⟩ := abs_cases.int P
        · rw [e1, e2]; exact hcube
        · exfalso
          have hSnn : 0 ≤ S ^ 3 := by nlinarith [mul_nonneg.int S S h1 h1]
          have hPneg : P ^ 3 < 0 := by have hp := mul_pos.int (-P) (-P) (by linarith) (by linarith); nlinarith
          linarith
      · obtain ⟨e2, h2⟩ | ⟨e2, h2⟩ := abs_cases.int P
        · exfalso
          have hSneg : S ^ 3 < 0 := by have hp := mul_pos.int (-S) (-S) (by linarith) (by linarith); nlinarith
          have hPnn : 0 ≤ P ^ 3 := by nlinarith [mul_nonneg.int P P h2 h2]
          linarith
        · have hnS : (-S) ^ 3 = -(S ^ 3) := by ring
          have hnP : (-P) ^ 3 = -(P ^ 3) := by ring
          rw [e1, e2]; linarith
    apply (cast_inj.int (Sn ^ 3) (24 * Pn ^ 3)).mp
    have hc1 : ((Sn ^ 3 : ℕ) : ℤ) = |S| ^ 3 := by rw [Sn_def, cast_pow.int, int_of_nat_of_int (|S|) (abs_nonneg.int S)]
    have hc2 : ((24 * Pn ^ 3 : ℕ) : ℤ) = 24 * |P| ^ 3 := by rw [Pn_def, cast_mul.int, cast_pow.int, int_of_nat_of_int (|P|) (abs_nonneg.int P)]; simp
    rw [hc1, hc2, hS_abs]
  have hSn_pos : 0 < Sn
    by_contra h0; have hz_ : Sn = 0 := by omega
    rw [hz_] at hcube_nat; have h03 : 0 ^ 3 = 0 := by decide; rw [h03] at hcube_nat
    have hpos := mul_pos.nat 24 (Pn ^ 3) (by decide) (pow_pos.nat Pn 3 hPn_pos); omega
  have hno_cube24 : ∀ k : ℕ, 0 < k → ∀ m : ℕ, m ^ 3 ≠ 24 * k ^ 3
    intro k_init hk_init
    have hdesc : ∀ k : ℕ, ¬ (0 < k ∧ ∃ m : ℕ, m ^ 3 = 24 * k ^ 3)
      intro k0 hbad
      obtain ⟨k, ⟨hk_pos, ⟨m, hmk⟩⟩, hk_min⟩ := nat.exists_least (fun t => 0 < t ∧ ∃ m : ℕ, m ^ 3 = 24 * t ^ 3) ⟨k0, hbad⟩
      have h3m3 : 3 ∣ (m ^ 3) := (dvd.iff_exists 3 (m ^ 3) (by decide)).mpr ⟨8 * k ^ 3, by linarith⟩
      have h3m : 3 ∣ m := prime_dvd_of_dvd_pow.nat 3 m 3 (is_prime_nat.to_prime 3 is_prime_nat_three) h3m3
      obtain ⟨m1, hm1⟩ := (dvd.iff_exists 3 m (by decide)).mp h3m
      have h9eq : 9 * m1 ^ 3 = 8 * k ^ 3
        have h27 : m ^ 3 = 27 * m1 ^ 3 := by rw [hm1]; ring
        linarith
      have h3_8k3 : 3 ∣ (8 * k ^ 3) := (dvd.iff_exists 3 (8 * k ^ 3) (by decide)).mpr ⟨3 * m1 ^ 3, by linarith⟩
      have h3k3 : 3 ∣ (k ^ 3)
        obtain h38 | h3k3_ := is_prime_nat_three.2 8 (k ^ 3) h3_8k3
        · exfalso; have hn : ¬ (3 ∣ 8) := by decide; exact hn h38
        · exact h3k3_
      have h3k : 3 ∣ k := prime_dvd_of_dvd_pow.nat 3 k 3 (is_prime_nat.to_prime 3 is_prime_nat_three) h3k3
      obtain ⟨k1, hk1⟩ := (dvd.iff_exists 3 k (by decide)).mp h3k
      have hk1_pos : 0 < k1 := by omega
      have hk1_lt : k1 < k := by omega
      have hm1k1 : m1 ^ 3 = 24 * k1 ^ 3
        have h27k : k ^ 3 = 27 * k1 ^ 3 := by rw [hk1]; ring
        linarith
      exact hk_min k1 hk1_lt ⟨hk1_pos, ⟨m1, hm1k1⟩⟩
    intro m hm
    exact hdesc k_init ⟨hk_init, ⟨m, hm⟩⟩
  exact hno_cube24 Pn hPn_pos Sn hcube_nat

+ shell7.coupled_deg5_identity (x y z u v w : ℤ)
    (hu : u = y + z) (hv : v = z + x) (hw : w = x + y) :
    (u + v + w) ^ 5 - 32 * (x ^ 5 + y ^ 5 + z ^ 5) = 80 * u * v * w * (u ^ 2 + v ^ 2 + w ^ 2)
  rw [hu, hv, hw]; ring

-> shell7.Q7 (R L : ℤ) : ℤ :=
  R ^ 6 + R ^ 5 * L + R ^ 4 * L ^ 2 + R ^ 3 * L ^ 3 + R ^ 2 * L ^ 4 + R * L ^ 5 + L ^ 6

-> shell7.gram_f4 (R L : ℤ) : ℤ :=
  R ^ 4 + R ^ 3 * L + 3 * R ^ 2 * L ^ 2 + R * L ^ 3 + L ^ 4

-> shell7.gram_p6 (R L : ℤ) : ℤ :=
  R ^ 6 + 15 * R ^ 5 * L + 15 * R ^ 4 * L ^ 2 + 29 * R ^ 3 * L ^ 3 + 15 * R ^ 2 * L ^ 4 + 15 * R * L ^ 5 + L ^ 6

+ shell7.gram_eigenvalue_mordell_identity (R L : ℤ) :
    28 * (shell7.gram_f4 R L) ^ 3 - (shell7.gram_p6 R L) ^ 2 = 27 * (shell7.Q7 R L) ^ 2 ∧
    (112 * shell7.gram_f4 R L) ^ 3 - (224 * shell7.gram_p6 R L) ^ 2 = 1728 * (784 * (shell7.Q7 R L) ^ 2)
  unfold shell7.gram_f4 shell7.gram_p6 shell7.Q7
  constructor <;> ring

+ shell7.gram_f4_Q7_bezout (R L : ℤ) :
    (8 * L ^ 3 - 9 * R * L ^ 2 - 5 * R ^ 3) * shell7.Q7 R L +
    (-L ^ 5 + 2 * R * L ^ 4 + 2 * R ^ 2 * L ^ 3 - R ^ 3 * L ^ 2 + 5 * R ^ 5) * shell7.gram_f4 R L = 7 * L ^ 9 ∧
    (8 * R ^ 3 - 9 * L * R ^ 2 - 5 * L ^ 3) * shell7.Q7 R L +
    (-R ^ 5 + 2 * L * R ^ 4 + 2 * L ^ 2 * R ^ 3 - L ^ 3 * R ^ 2 + 5 * L ^ 5) * shell7.gram_f4 R L = 7 * R ^ 9
  unfold shell7.gram_f4 shell7.Q7
  constructor <;> ring

+ shell7.gram_f4_coprime_Q7_away_from_7 (ell : ℕ) (hell : is_prime_nat ell) (hne7 : ell ≠ 7)
    (R L : ℤ) (hf4 : int_dvd ell (shell7.gram_f4 R L)) (hQ7 : int_dvd ell (shell7.Q7 R L)) :
    int_dvd ell R ∧ int_dvd ell L
  have hbez := shell7.gram_f4_Q7_bezout R L
  have h7L9 : int_dvd ell (7 * L ^ 9)
    have h1 := shell7.dvd_mul_l ell (8 * L ^ 3 - 9 * R * L ^ 2 - 5 * R ^ 3) (shell7.Q7 R L) hQ7
    have h2 := shell7.dvd_mul_l ell (-L ^ 5 + 2 * R * L ^ 4 + 2 * R ^ 2 * L ^ 3 - R ^ 3 * L ^ 2 + 5 * R ^ 5) (shell7.gram_f4 R L) hf4
    rw [← hbez.1]; exact cshell.dvd_add ell _ _ h1 h2
  have h7R9 : int_dvd ell (7 * R ^ 9)
    have h1 := shell7.dvd_mul_l ell (8 * R ^ 3 - 9 * L * R ^ 2 - 5 * L ^ 3) (shell7.Q7 R L) hQ7
    have h2 := shell7.dvd_mul_l ell (-R ^ 5 + 2 * L * R ^ 4 + 2 * L ^ 2 * R ^ 3 - L ^ 3 * R ^ 2 + 5 * L ^ 5) (shell7.gram_f4 R L) hf4
    rw [← hbez.2]; exact cshell.dvd_add ell _ _ h1 h2
  have h_elim : ∀ X : ℤ, int_dvd ell (7 * X ^ 9) → int_dvd ell X
    intro X h7X9
    have hell_pos : 0 < ell := by linarith [hell.1]
    have hnat : ell ∣ nat_of_int (|7 * X ^ 9|) := (cshell.dvd_iff_nat_abs ell hell_pos (7 * X ^ 9)).mp h7X9
    have habs_mul : nat_of_int (|7 * X ^ 9|) = 7 * nat_of_int (|X|) ^ 9
      apply (cast_inj.int (nat_of_int (|7 * X ^ 9|)) (7 * nat_of_int (|X|) ^ 9)).mp
      have hc1 : (nat_of_int (|7 * X ^ 9|) : ℤ) = |7 * X ^ 9| := int_of_nat_of_int (|7 * X ^ 9|) (abs_nonneg.int (7 * X ^ 9))
      have hc2 : ((7 * nat_of_int (|X|) ^ 9 : ℕ) : ℤ) = 7 * |X| ^ 9 := by
        rw [cast_mul.int, cast_pow.int, int_of_nat_of_int (|X|) (abs_nonneg.int X)]; simp
      rw [hc1, hc2, abs_mul.int 7 (X ^ 9)]
      have h7abs : |(7 : ℤ)| = 7 := by decide
      have hXabs : |X ^ 9| = |X| ^ 9 := by
        obtain ⟨e, h⟩ | ⟨e, h⟩ := abs_cases.int X
        · have hnn : 0 ≤ X ^ 9 := by
            have h2 : 0 ≤ X * X := mul_nonneg.int X X h h
            have h4 : 0 ≤ (X * X) * (X * X) := mul_nonneg.int _ _ h2 h2
            have h8 : 0 ≤ ((X * X) * (X * X)) * ((X * X) * (X * X)) := mul_nonneg.int _ _ h4 h4
            have h9 : X ^ 9 = (((X * X) * (X * X)) * ((X * X) * (X * X))) * X := by ring
            rw [h9]; exact mul_nonneg.int _ _ h8 h
          rw [e]; obtain ⟨e9, _⟩ | ⟨_, h9⟩ := abs_cases.int (X ^ 9)
          · exact e9
          · linarith
        · have hnp : X ^ 9 ≤ 0 := by
            have hm : 0 ≤ -X := by linarith
            have h2 : 0 ≤ (-X) * (-X) := mul_nonneg.int _ _ hm hm
            have h4 : 0 ≤ ((-X) * (-X)) * ((-X) * (-X)) := mul_nonneg.int _ _ h2 h2
            have h8 : 0 ≤ (((-X) * (-X)) * ((-X) * (-X))) * (((-X) * (-X)) * ((-X) * (-X))) := mul_nonneg.int _ _ h4 h4
            have h9 : -(X ^ 9) = ((((-X) * (-X)) * ((-X) * (-X))) * (((-X) * (-X)) * ((-X) * (-X)))) * (-X) := by ring
            have hnn := mul_nonneg.int _ _ h8 hm
            linarith
          rw [e]; obtain ⟨e9, h9⟩ | ⟨e9, _⟩ := abs_cases.int (X ^ 9)
          · have hz : X ^ 9 = 0 := by linarith
            have hneg : (0 - X) ^ 9 = -(X ^ 9) := by ring
            rw [e9, hneg, hz]; ring
          · rw [e9]; ring
      rw [h7abs, hXabs]
    rw [habs_mul] at hnat
    obtain h7 | hX9 := hell.2 7 (nat_of_int (|X|) ^ 9) hnat
    · exfalso
      obtain h1 | h2 := (is_prime_nat.to_full 7 is_prime_nat_seven).2 ell h7
      · linarith [hell.1]
      · exact hne7 h2
    · exact (cshell.dvd_iff_nat_abs ell hell_pos X).mpr (prime_dvd_of_dvd_pow.nat ell (nat_of_int (|X|)) 9 (is_prime_nat.to_prime ell hell) hX9)
  exact ⟨h_elim R h7R9, h_elim L h7L9⟩

+ shell7.coupled_deg11_identity (x y z : ℤ) :
    (x + y + z) ^ 11 - (x ^ 11 + y ^ 11 + z ^ 11) =
    11 * ((x + y) * (y + z) * (z + x)) *
      (((x * y + y * z + z * x) ^ 4 - (x + y + z) ^ 2 * (x * y + y * z + z * x) ^ 3 +
        (x + y + z) ^ 4 * (x * y + y * z + z * x) ^ 2 - (x + y + z) ^ 6 * (x * y + y * z + z * x) +
        (x + y + z) ^ 8) +
       (-3 * (x * y + y * z + z * x) ^ 2 + 4 * (x + y + z) ^ 2 * (x * y + y * z + z * x) - 3 * (x + y + z) ^ 4) *
         (x + y + z) * ((x + y) * (y + z) * (z + x)) +
       (2 * (x + y + z) ^ 2 - (x * y + y * z + z * x)) * ((x + y) * (y + z) * (z + x)) ^ 2)
  ring

+ shell7.genus_Sp_eq_one_iff_seven (p : ℕ) (hp5 : 5 ≤ p) :
    (p - 1) * (p - 5) = 12 ↔ p = 7
  constructor
  · intro heq
    by_contra hne
    by_cases hlt : p < 7
    · have h56 : p = 5 ∨ p = 6 := by omega
      obtain h5 | h6 := h56
      · rw [h5] at heq; omega
      · rw [h6] at heq; omega
    · have h1 := mul_le_mul_of_nonneg_right.nat 7 (p - 1) (p - 5) (by omega) (by omega)
      have h2 := mul_le_mul_of_nonneg_left.nat 3 (p - 5) 7 (by omega) (by decide)
      omega
  · intro hp7; rw [hp7]; decide

+ shell7.lower_power_deficit (n m L B R : ℕ) (hL : 0 < L) (hB : 0 < B)
    (heq : L ^ n + B ^ n = R ^ n) (hmn : m < n) :
    R ^ m < L ^ m + B ^ m
  have hR_gt_L : L < R
    by_contra hle; have hmono := nat.pow_mono_base n R L (by omega); have hBp := pow_pos.nat B n hB; omega
  have hR_gt_B : B < R
    by_contra hle; have hmono := nat.pow_mono_base n R B (by omega); have hLp := pow_pos.nat L n hL; omega
  set d : ℕ := n - m
  have hd_pos : 1 ≤ d := by omega
  have hnm : n = m + d := by omega
  have hpow_strict : ∀ k : ℕ, 1 ≤ k → ∀ a b : ℕ, 0 < a → a < b → a ^ k < b ^ k
    intro k hk
    induction k with r ihr
    · omega
    · intro a b ha hab
      rw [succ_eq_add_one.nat, pow_succ.nat a r, pow_succ.nat b r]
      by_cases hr0 : r = 0
      · rw [hr0, pow_zero.nat, pow_zero.nat]; omega
      · have hih := ihr (by omega) a b ha hab
        have hm1 := mul_lt_mul_of_pos_right.nat (a ^ r) (b ^ r) a hih ha
        have hm2 := mul_lt_mul_of_pos_left.nat a b (b ^ r) hab (pow_pos.nat b r (by omega))
        omega
  have hLd_lt := hpow_strict d hd_pos L R hL hR_gt_L
  have hBd_lt := hpow_strict d hd_pos B R hB hR_gt_B
  have hstrict : R ^ m * R ^ d < (L ^ m + B ^ m) * R ^ d
    have hLn : L ^ n = L ^ m * L ^ d := by rw [hnm, pow_add.nat L m d]
    have hBn : B ^ n = B ^ m * B ^ d := by rw [hnm, pow_add.nat B m d]
    have hRn : R ^ n = R ^ m * R ^ d := by rw [hnm, pow_add.nat R m d]
    have h1 := mul_lt_mul_of_pos_left.nat (L ^ d) (R ^ d) (L ^ m) hLd_lt (pow_pos.nat L m hL)
    have h2 := mul_lt_mul_of_pos_left.nat (B ^ d) (R ^ d) (B ^ m) hBd_lt (pow_pos.nat B m hB)
    have hdist : (L ^ m + B ^ m) * R ^ d = L ^ m * R ^ d + B ^ m * R ^ d := by ring
    omega
  by_contra hge
  have hm := mul_le_mul_of_nonneg_right.nat (L ^ m + B ^ m) (R ^ m) (R ^ d) (by omega) (by omega)
  omega
