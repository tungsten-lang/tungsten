    rw [hc1, hc2, hU1V1_z]
  have hcop_U1V1 : nat.coprime_primes U1 V1
    unfold nat.coprime_primes
    intro ell hell ⟨heU, heV⟩
    have hell2 : 2 ≤ ell := hell.1
    have hd_sum : int_dvd ell ((p : ℤ) ^ 2 + 147 * (q : ℤ) ^ 2)
      have hdU : int_dvd ell U1z := by rw [← hU1_cast]; exact shell7.int_dvd_of_nat_dvd ell U1 (by omega) heU
      have hdV : int_dvd ell V1z := by rw [← hV1_cast]; exact shell7.int_dvd_of_nat_dvd ell V1 (by omega) heV
