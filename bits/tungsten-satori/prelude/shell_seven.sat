      rw [hre, add_mul_mod.int 1 _ 2 (by decide)]; decide
  have hr_odd : (r : ℤ) % 2 = 1
    by_contra hn1
    have hr0 : r % 2 = 0 := by by_contra h1; exact hn1 (kubert.odd_nat_to_int r (by have hlt := mod_lt.nat r 2 (by decide); omega))
    obtain ⟨r0, hr0_eq⟩ := (dvd.iff_exists 2 r (by decide)).mp (shell7.nat_dvd_of_mod_zero 2 r (by decide) hr0)
    have hre_z : (r : ℤ) = 2 * (r0 : ℤ) := by rw [hr0_eq, cast_mul.int]; simp
    have hd := div_add_mod.int ((p : ℤ) ^ 2 + 147 * (q : ℤ) ^ 2) 2; rw [hpq_odd] at hd
    set kpq := ((p : ℤ) ^ 2 + 147 * (q : ℤ) ^ 2) / 2
    have hsq_odd : (((p : ℤ) ^ 2 + 147 * (q : ℤ) ^ 2) ^ 2) % 2 = 1
      have hre : ((p : ℤ) ^ 2 + 147 * (q : ℤ) ^ 2) ^ 2 = 1 + 2 * (2 * kpq ^ 2 + 2 * kpq) := by
