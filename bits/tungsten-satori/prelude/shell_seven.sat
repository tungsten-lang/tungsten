    have hQ1_eq : ((4 * a0 : ℕ) : ℤ) ^ 4 - 147 * ((4 * a0 : ℕ) : ℤ) ^ 2 * (b : ℤ) ^ 2 + 5488 * (b : ℤ) ^ 4 = ((4 * p : ℕ) : ℤ) ^ 2
      have ha_z : (a : ℤ) = 2 * (a0 : ℤ) := by rw [ha0, cast_mul.int]; simp
      have hq_z : (q : ℤ) = (a0 : ℤ) * (b : ℤ) := by rw [← ha0b, cast_mul.int]
