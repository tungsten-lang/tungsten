        rw [cast_add.int, cast_mul.int] at hc; have h2 : ((2 : ℕ) : ℤ) = 2 := by decide; have h0 : ((0 : ℕ) : ℤ) = 0 := by decide; rw [h2, h0] at hc; linarith
      have hre : (p : ℤ) ^ 2 + 147 * (q : ℤ) ^ 2 = 1 + 2 * (2 * kp ^ 2 + 2 * kp + 294 * kq ^ 2) := by rw [hpe, hqe]; ring
      rw [hre, add_mul_mod.int 1 _ 2 (by decide)]; decide
    · have hdp := div_add_mod.nat p 2; rw [hp0] at hdp
      have hdq := div_add_mod.nat q 2; rw [hq1] at hdq
      set kp : ℤ := ((p / 2 : ℕ) : ℤ); set kq : ℤ := ((q / 2 : ℕ) : ℤ)
