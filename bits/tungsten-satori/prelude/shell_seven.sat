                                       shell7.nat_dvd_of_mod_zero 2 q (by decide) (by have hlt := mod_lt.nat q 2 (by decide); omega)⟩
  have hpq_odd : ((p : ℤ) ^ 2 + 147 * (q : ℤ) ^ 2) % 2 = 1
    obtain ⟨hp1, hq0⟩ | ⟨hp0, hq1⟩ := hopp
    · have hdp := div_add_mod.nat p 2; rw [hp1] at hdp
      have hdq := div_add_mod.nat q 2; rw [hq0] at hdq
