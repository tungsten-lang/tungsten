  · obtain ⟨b0, hb0⟩ := (dvd.iff_exists 2 b (by decide)).mp h2b
    have hb0_pos : 0 < b0 := by by_contra h0; have hz : b0 = 0 := by omega; rw [hz] at hb0; omega
    have hab0 : a * b0 = q
      apply nat.mul_cancel_left_pos 2 (a * b0) q (by decide)
      calc 2 * (a * b0) = a * (2 * b0) := by ring
