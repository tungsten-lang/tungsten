-- Nearby Shell Roads (0 Custom Axioms!):
--   1. Universal All-a Cyclic-Shell Identity: u^a*v + v^a*w + w^a*u = (x*y*z)^a * (x^(a^2-a+1) + y^(a^2-a+1) + z^(a^2-a+1))
--      and A_3-Quotient Unification for a = 3 (p = 7, H_3/A_3 ~= X_0(49)) and a = 4 (p = 13, H_4/A_3 = Q_13).
--   2. Complete Zero-Cyclotomic Reduction of All-Case FLT(13) to Affine s != 0 Rational Points on
--      the Minimal Genus-2 Curve Q_13 : w^2 + w = -13*s^5 + 26*s^4 - 26*s^3 + 13*s^2 - 3*s (Delta_min = 13^3),
--      including all 3 edge cases (e_1 = 0 via 13-adic valuation, s = 1 via real positivity, s = 0 via mod 2),
--      mod-3 non-existence of rational Weierstrass points, and mod-2 residue-disk restriction.
--   3. Closed-Form Single-Shell p = 7 Gram-Eigenvalue Rational Frey Curve E^+_{R,L} over Z[R, L]
--      and its D = -4 Twist E^+_{R,L}^{(-4)}, with Exact Invariants and Semistability Outside {2, 7}.
--   4. Exact Frey Split-Reduction Character Law (-c_6 == A*c_4 mod ell | C, etc.) and the
--      Zero-Mazur Mod-8 Irreducibility Theorem (x == +/-3 mod 8 => non-split at ell = 2 for all p >= 5).
--
-- Every theorem in this file is checked on Satori's untouched HOL kernel (0 custom axioms).

import shell_seven

-- ====================================================================================
-- 1. Universal All-a Cyclic-Shell Identity & A_3-Quotient Unification (a = 3, 4, ...)
-- ====================================================================================

+ shell13.int_mul_pow (m : ℕ) (x y : ℤ) : (x * y) ^ m = x ^ m * y ^ m
  induction m with j ihj
  · rw [pow_zero.int, pow_zero.int, pow_zero.int]; ring
  · rw [succ_eq_add_one.nat, pow_succ.int, pow_succ.int, pow_succ.int, ihj]; ring

+ shell13.int_pow_add (x : ℤ) (m n : ℕ) : x ^ (m + n) = x ^ m * x ^ n
  induction n with j ihj
  · have hm0 : m + 0 = m := by omega
    rw [hm0, pow_zero.int]; ring
  · have hstep : m + (j + 1) = (m + j) + 1 := by omega
    rw [succ_eq_add_one.nat, hstep, pow_succ.int, pow_succ.int, ihj]; ring

+ shell13.int_pow_mul (x : ℤ) (m n : ℕ) : (x ^ m) ^ n = x ^ (m * n)
  induction n with j ihj
  · have hm0 : m * 0 = 0 := by omega
    rw [hm0, pow_zero.int, pow_zero.int]
  · have hstep : m * (j + 1) = m * j + m := by ring
    rw [succ_eq_add_one.nat, hstep, pow_succ.int, ihj, shell13.int_pow_add x (m * j) m]

-- THEOREM 1A (UNIVERSAL ALL-a CYCLIC-SHELL IDENTITY — 0 CUSTOM AXIOMS!):
-- For EVERY integer a >= 1 and all x, y, z : Z, with cyclic shells u = x*y^a, v = y*z^a, w = z*x^a:
--     u^a * v + v^a * w + w^a * u = (x * y * z)^a * (x^(a^2 - a + 1) + y^(a^2 - a + 1) + z^(a^2 - a + 1)).
-- Specializing:
--   a = 2 -> n = 3 (Fermat cubic),
--   a = 3 -> n = 7 (Klein quartic H_3, H_3/A_3 ~= X_0(49)),
--   a = 4 -> n = 13 (smooth quintic H_4, H_4/A_3 = Q_13, g = 2, rank 1),
--   a = 6 -> n = 31 (H_6, g = 15, H_6/A_3, g = 5),
--   a = 7 -> n = 43 (H_7, g = 21, H_7/A_3, g = 7).
+ shell13.cyclic_shell_identity (a : ℕ) (ha : 1 ≤ a) (x y z : ℤ) :
    (x * y ^ a) ^ a * (y * z ^ a) + (y * z ^ a) ^ a * (z * x ^ a) + (z * x ^ a) ^ a * (x * y ^ a) =
    (x * y * z) ^ a * (x ^ (a * a - a + 1) + y ^ (a * a - a + 1) + z ^ (a * a - a + 1))
  have ha_le : a ≤ a * a
    have h1 := mul_le_mul_of_nonneg_right.nat 1 a a ha (by omega)
    omega
  have hexp : a * a + 1 = a + (a * a - a + 1) := by omega
  have hterm : ∀ r s t : ℤ, (r * s ^ a) ^ a * (s * t ^ a) = (r * s * t) ^ a * s ^ (a * a - a + 1)
    intro r s t
    calc (r * s ^ a) ^ a * (s * t ^ a)
      = (r ^ a * (s ^ a) ^ a) * (s * t ^ a) := by rw [shell13.int_mul_pow a r (s ^ a)]
      _ = (r ^ a * s ^ (a * a)) * (s * t ^ a) := by rw [shell13.int_pow_mul s a a]
      _ = r ^ a * t ^ a * (s ^ (a * a) * s) := by ring
      _ = r ^ a * t ^ a * s ^ (a * a + 1) := by rw [← pow_succ.int s (a * a)]
      _ = r ^ a * t ^ a * s ^ (a + (a * a - a + 1)) := by rw [hexp]
      _ = r ^ a * t ^ a * (s ^ a * s ^ (a * a - a + 1)) := by rw [shell13.int_pow_add s a (a * a - a + 1)]
      _ = (r ^ a * s ^ a * t ^ a) * s ^ (a * a - a + 1) := by ring
      _ = ((r * s) ^ a * t ^ a) * s ^ (a * a - a + 1) := by rw [shell13.int_mul_pow a r s]
      _ = (r * s * t) ^ a * s ^ (a * a - a + 1) := by rw [shell13.int_mul_pow a (r * s) t]
  have h1 := hterm x y z
  have h2 := hterm y z x
  have h3 := hterm z x y
  have hxyz2 : (y * z * x) ^ a = (x * y * z) ^ a := by
    have he : y * z * x = x * y * z := by ring
    rw [he]
  have hxyz3 : (z * x * y) ^ a = (x * y * z) ^ a := by
    have he : z * x * y = x * y * z := by ring
    rw [he]
  rw [h1, h2, h3, hxyz2, hxyz3]; ring

-- THEOREM 1B (KLEIN QUARTIC H_3 / A_3 UNIFICATION IDENTITY FOR a = 3, p = 7 — 0 CUSTOM AXIOMS!):
-- Eliminating D = (u-v)(v-w)(w-u) from 2*H_3 = (e1^2*e2 - 2*e2^2 - e1*e3) - e1*D yields the
-- quadratic in e3 whose discriminant is the genus-1 quotient X_0(49) (`49a1`).
+ shell13.H3_A3_decomp (u v w : ℤ) :
    2 * (u ^ 3 * v + v ^ 3 * w + w ^ 3 * u) =
      ((u + v + w) ^ 2 * (u * v + v * w + w * u) - 2 * (u * v + v * w + w * u) ^ 2 - (u + v + w) * (u * v * w)) -
      (u + v + w) * ((u - v) * (v - w) * (w - u)) ∧
    ((u + v + w) ^ 2 * (u * v + v * w + w * u) - 2 * (u * v + v * w + w * u) ^ 2 - (u + v + w) * (u * v * w)) ^ 2 -
      (u + v + w) ^ 2 * ((u - v) * (v - w) * (w - u)) ^ 2 =
      4 * ((7 * (u + v + w) ^ 2) * (u * v * w) ^ 2 +
           ((u + v + w) ^ 5 - 5 * (u + v + w) ^ 3 * (u * v + v * w + w * u) + (u + v + w) * (u * v + v * w + w * u) ^ 2) * (u * v * w) +
           (u * v + v * w + w * u) ^ 4) ∧
    (2 * (7 * (u + v + w) ^ 2) * (u * v * w) +
      ((u + v + w) ^ 5 - 5 * (u + v + w) ^ 3 * (u * v + v * w + w * u) + (u + v + w) * (u * v + v * w + w * u) ^ 2)) ^ 2 =
      (u + v + w) ^ 2 * ((u + v + w) ^ 8 - 10 * (u + v + w) ^ 6 * (u * v + v * w + w * u) +
        27 * (u + v + w) ^ 4 * (u * v + v * w + w * u) ^ 2 - 10 * (u + v + w) ^ 2 * (u * v + v * w + w * u) ^ 3 -
        27 * (u * v + v * w + w * u) ^ 4) +
      4 * (7 * (u + v + w) ^ 2) * ((7 * (u + v + w) ^ 2) * (u * v * w) ^ 2 +
        ((u + v + w) ^ 5 - 5 * (u + v + w) ^ 3 * (u * v + v * w + w * u) + (u + v + w) * (u * v + v * w + w * u) ^ 2) * (u * v * w) +
        (u * v + v * w + w * u) ^ 4)
  constructor
  · ring
  · constructor
    · ring
    · ring

-- ====================================================================================
-- 2. Complete 0-Axiom Reduction of All-Case FLT(13) to Affine s != 0 Points on Q_13
-- ====================================================================================

-> shell13.H4 (u v w : ℤ) : ℤ :=
  u ^ 4 * v + v ^ 4 * w + w ^ 4 * u

-- Homogeneous degree-5 quintic of Q_13 : Y^2 = q_s * Q13_poly(p_s, q_s)
-- (affine s = p_s / q_s gives Y^2 = -52*s^5 + 104*s^4 - 104*s^3 + 52*s^2 - 12*s + 1,
--  equivalently minimal model w^2 + w = -13*s^5 + 26*s^4 - 26*s^3 + 13*s^2 - 3*s, Delta_min = 13^3):
-> shell13.Q13_poly (p_s q_s : ℤ) : ℤ :=
  -52 * p_s ^ 5 + 104 * p_s ^ 4 * q_s - 104 * p_s ^ 3 * q_s ^ 2 +
  52 * p_s ^ 2 * q_s ^ 3 - 12 * p_s * q_s ^ 4 + q_s ^ 5

+ shell13.deg13_to_H4 (x y z : ℤ) :
    shell13.H4 (x * y ^ 4) (y * z ^ 4) (z * x ^ 4) = (x * y * z) ^ 4 * (x ^ 13 + y ^ 13 + z ^ 13)
  unfold shell13.H4; ring

+ shell13.H4_A3_identities (u v w : ℤ) :
    2 * shell13.H4 u v w =
      ((u + v + w) ^ 3 * (u * v + v * w + w * u) - 3 * (u + v + w) * (u * v + v * w + w * u) ^ 2 -
       (u + v + w) ^ 2 * (u * v * w) + 5 * (u * v + v * w + w * u) * (u * v * w)) -
      ((u + v + w) ^ 2 - (u * v + v * w + w * u)) * ((u - v) * (v - w) * (w - u)) ∧
    ((u - v) * (v - w) * (w - u)) ^ 2 =
      (u + v + w) ^ 2 * (u * v + v * w + w * u) ^ 2 - 4 * (u * v + v * w + w * u) ^ 3 -
      4 * (u + v + w) ^ 3 * (u * v * w) - 27 * (u * v * w) ^ 2 + 18 * (u + v + w) * (u * v + v * w + w * u) * (u * v * w) ∧
    ((u + v + w) ^ 3 * (u * v + v * w + w * u) - 3 * (u + v + w) * (u * v + v * w + w * u) ^ 2 -
     (u + v + w) ^ 2 * (u * v * w) + 5 * (u * v + v * w + w * u) * (u * v * w)) ^ 2 -
      ((u + v + w) ^ 2 - (u * v + v * w + w * u)) ^ 2 * ((u - v) * (v - w) * (w - u)) ^ 2 =
      4 * ((13 * (u * v + v * w + w * u) ^ 2 - 16 * (u + v + w) ^ 2 * (u * v + v * w + w * u) + 7 * (u + v + w) ^ 4) * (u * v * w) ^ 2 +
           (-12 * (u + v + w) * (u * v + v * w + w * u) ^ 3 + 14 * (u + v + w) ^ 3 * (u * v + v * w + w * u) ^ 2 -
            7 * (u + v + w) ^ 5 * (u * v + v * w + w * u) + (u + v + w) ^ 7) * (u * v * w) +
           (u * v + v * w + w * u) ^ 5) ∧
    (2 * (13 * (u * v + v * w + w * u) ^ 2 - 16 * (u + v + w) ^ 2 * (u * v + v * w + w * u) + 7 * (u + v + w) ^ 4) * (u * v * w) +
      (-12 * (u + v + w) * (u * v + v * w + w * u) ^ 3 + 14 * (u + v + w) ^ 3 * (u * v + v * w + w * u) ^ 2 -
       7 * (u + v + w) ^ 5 * (u * v + v * w + w * u) + (u + v + w) ^ 7)) ^ 2 =
      ((u * v + v * w + w * u) - (u + v + w) ^ 2) ^ 2 * shell13.Q13_poly (u * v + v * w + w * u) ((u + v + w) ^ 2) +
      4 * (13 * (u * v + v * w + w * u) ^ 2 - 16 * (u + v + w) ^ 2 * (u * v + v * w + w * u) + 7 * (u + v + w) ^ 4) *
        ((13 * (u * v + v * w + w * u) ^ 2 - 16 * (u + v + w) ^ 2 * (u * v + v * w + w * u) + 7 * (u + v + w) ^ 4) * (u * v * w) ^ 2 +
         (-12 * (u + v + w) * (u * v + v * w + w * u) ^ 3 + 14 * (u + v + w) ^ 3 * (u * v + v * w + w * u) ^ 2 -
          7 * (u + v + w) ^ 5 * (u * v + v * w + w * u) + (u + v + w) ^ 7) * (u * v * w) +
         (u * v + v * w + w * u) ^ 5)
  unfold shell13.H4 shell13.Q13_poly
  constructor
  · ring
  · constructor
    · ring
    · constructor
      · ring
      · ring

-- Helper: extract exact power of a prime p from any positive natural number
+ shell13.split_prime_pow (p : ℕ) (hp : 2 ≤ p) (n : ℕ) :
    0 < n → ∃ a M : ℕ, 0 < M ∧ M % p ≠ 0 ∧ n = p ^ a * M
  apply nat.strong_induct (fun n => 0 < n → ∃ a M : ℕ, 0 < M ∧ M % p ≠ 0 ∧ n = p ^ a * M)
  intro n ih hn
  by_cases hdiv : n % p = 0
  · obtain ⟨n1, hn1⟩ := (dvd.iff_exists p n (by omega)).mp hdiv
    have hn1_pos : 0 < n1 := by by_contra h0; have hz : n1 = 0 := by omega; rw [hz] at hn1; omega
    have hn1_lt : n1 < n
      have hge := mul_le_mul_of_nonneg_right.nat 2 p n1 hp (by omega)
      omega
    obtain ⟨a, M, hMp, hMnd, hMeq⟩ := ih n1 hn1_lt hn1_pos
    exact ⟨a + 1, M, hMp, hMnd, by rw [hn1, hMeq, pow_succ.nat p a]; ring⟩
  · have hp0 : p ^ 0 = 1 := pow_zero.nat p
    exact ⟨0, n, hn, hdiv, by rw [hp0]; ring⟩

+ is_prime_nat_thirteen : is_prime_nat 13
  exact prime.to_is_prime_nat 13 (by decide)

-- Helper: exact prime-power valuation uniqueness for p^a * M = p^b * N with p nmid M, p nmid N
+ shell13.prime_pow_exp_unique (p : ℕ) (hp : is_prime_nat p) (a b M N : ℕ)
    (hM : M % p ≠ 0) (hN : N % p ≠ 0) (heq : p ^ a * M = p ^ b * N) : a = b
  have hp2 : 2 ≤ p := hp.1
  have hpr := is_prime_nat.to_prime p hp
  by_contra hne
  by_cases hlt : a < b
  · set d := b - a
    have hd1 : 1 ≤ d := by omega
    have hbd : b = a + d := by omega
    rw [hbd, pow_add.nat p a d] at heq
    have hcancel : M = p ^ d * N
      apply nat.mul_cancel_left_pos (p ^ a) M (p ^ d * N) (pow_pos.nat p a (by omega))
      rw [heq]; ring
    have hd_eq : d = (d - 1) + 1 := by omega
    have hpM : p ∣ M
      rw [hcancel, hd_eq, pow_succ.nat p (d - 1)]
      exact (dvd.iff_exists p (p ^ (d - 1) * p * N) (by omega)).mpr ⟨p ^ (d - 1) * N, by ring⟩
    exact hM (shell7.nat_mod_zero_of_dvd p M hpM)
  · set d := a - b
    have hd1 : 1 ≤ d := by omega
    have had : a = b + d := by omega
    rw [had, pow_add.nat p b d] at heq
    have hcancel : p ^ d * M = N
      apply nat.mul_cancel_left_pos (p ^ b) (p ^ d * M) N (pow_pos.nat p b (by omega))
      rw [← heq]; ring
    have hd_eq : d = (d - 1) + 1 := by omega
    have hpN : p ∣ N
      rw [← hcancel, hd_eq, pow_succ.nat p (d - 1)]
      exact (dvd.iff_exists p (p ^ (d - 1) * p * M) (by omega)).mpr ⟨p ^ (d - 1) * M, by ring⟩
    exact hN (shell7.nat_mod_zero_of_dvd p N hpN)

-- Helper: lifting `int_dvd` of prime power from |x| = p^k * M
+ shell13.int_pow_dvd_of_nat (p k : ℕ) (x : ℤ) (hp : 2 ≤ p)
    (hd : p ^ k ∣ nat_of_int (|x|)) : ∃ q : ℤ, x = (p : ℤ) ^ k * q
  obtain ⟨m, hm⟩ := (dvd.iff_exists (p ^ k) (nat_of_int (|x|)) (pow_pos.nat p k (by omega))).mp hd
  have hnx : (nat_of_int (|x|) : ℤ) = |x| := int_of_nat_of_int (|x|) (abs_nonneg.int x)
  have hcast : |x| = (p : ℤ) ^ k * (m : ℤ)
    rw [← hnx, hm, cast_mul.int, cast_pow.int]
  obtain ⟨e, _⟩ | ⟨e, _⟩ := abs_cases.int x
  · exact ⟨(m : ℤ), by rw [← e, hcast]⟩
  · exact ⟨-(m : ℤ), by linarith⟩

-- Helper: if 13^k | x and 13^k | y and x + y = z, then 13^k | |z|
+ shell13.nat_pow_dvd_of_int_mul (p k : ℕ) (x q : ℤ) (hp : 2 ≤ p)
    (heq : x = (p : ℤ) ^ k * q) : p ^ k ∣ nat_of_int (|x|)
  have hpk_pos : 0 < p ^ k := pow_pos.nat p k (by omega)
  have heq' : x = ((p ^ k : ℕ) : ℤ) * q := by rw [cast_pow.int]; exact heq
  exact nat.dvd_abs_of_int_mul (p ^ k) x q hpk_pos heq'

-- Helper: nat_of_int(|x|) > 0 for x != 0
+ shell13.nat_abs_pos (x : ℤ) (hx : x ≠ 0) : 0 < nat_of_int (|x|)
  have hnx : (nat_of_int (|x|) : ℤ) = |x| := int_of_nat_of_int (|x|) (abs_nonneg.int x)
  by_contra h0
  have hz : nat_of_int (|x|) = 0 := by omega
  rw [hz, cast_zero.int] at hnx
  obtain ⟨e, _⟩ | ⟨e, _⟩ := abs_cases.int x <;> (rw [e] at hnx; omega)

+ shell13.val13_unique_min (a b c : ℕ) (hab : 3 * a = 1 + 2 * b) :
    (3 * c < a + c ∧ 3 * c < b) ∨ (a + c < 3 * c ∧ a + c < b) ∨ (b < 3 * c ∧ b < a + c)
  by_cases h1 : 3 * c < a + c
  · by_cases h2 : 3 * c < b
    · left; exact ⟨h1, h2⟩
    · right; right; omega
  · by_cases h2 : a + c < b
    · right; left; omega
    · right; right; omega

-- EDGE CASE 1 (0 CUSTOM AXIOMS!): e_1 = u + v + w = 0 on H_4(u, v, w) = 0 with uvw != 0 is IMPOSSIBLE!
-- Proof: e_1 = 0 forces e_2^3 = -13 * e_3^2 and u^3 + e_2 * u - e_3 = 0.
-- Comparing 13-adic valuations (3*a = 1 + 2*b) forces the three terms u^3, e_2*u, -e_3
-- to have a strictly unique minimum 13-adic valuation (contradicting Eisenstein at 13)!
+ shell13.no_e1_zero (u v w : ℤ) (hu : u ≠ 0) (hv : v ≠ 0) (hw : w ≠ 0)
    (hH : shell13.H4 u v w = 0) (he1 : u + v + w = 0) : False
  set e2 := u * v + v * w + w * u
  set e3 := u * v * w
  set D := (u - v) * (v - w) * (w - u)
  have he3_nz : e3 ≠ 0
    intro h0
    have h0' : u * v * w = 0 := by rw [← e3_def]; exact h0
    obtain h1 | h2 := shell7.int_mul_eq_zero (u * v) w h0'
    · obtain h1a | h1b := shell7.int_mul_eq_zero u v h1
      · exact hu h1a
      · exact hv h1b
    · exact hw h2
  have hdecomp : 5 * e2 * e3 + e2 * D = 0
    have h1 := (shell13.H4_A3_identities u v w).1
    rw [hH, he1, ← e2_def, ← e3_def, ← D_def] at h1
    linarith
  have hDsq : D ^ 2 = -4 * e2 ^ 3 - 27 * e3 ^ 2
    have h2 := (shell13.H4_A3_identities u v w).2.1
    rw [he1, ← e2_def, ← e3_def, ← D_def] at h2
    linarith
  have hfac : e2 * (5 * e3 + D) = 0 := by linarith
  obtain he2_0 | hD_eq := shell7.int_mul_eq_zero e2 (5 * e3 + D) hfac
  · rw [he2_0] at hDsq
    have hle : D ^ 2 + 27 * e3 ^ 2 = 0 := by linarith
    have hsq1 : 0 ≤ D ^ 2 := by nlinarith
    have hsq2 : 0 < e3 ^ 2
      obtain hlt | hgt := lt_or_gt_of_ne.int e3 0 he3_nz <;> nlinarith
    nlinarith
  · have hD : D = -5 * e3 := by linarith
    rw [hD] at hDsq
    have he2_cube : e2 ^ 3 = -13 * e3 ^ 2 := by linarith
    have he2_nz : e2 ≠ 0
      intro h0; rw [h0] at he2_cube
      have hsq : 0 < e3 ^ 2
        obtain hlt | hgt := lt_or_gt_of_ne.int e3 0 he3_nz <;> nlinarith
      nlinarith
    have hcubic : u ^ 3 + e2 * u - e3 = 0
      have hpoly : u ^ 3 - (u + v + w) * u ^ 2 + (u * v + v * w + w * u) * u - u * v * w = 0 := by ring
      rw [he1, ← e2_def, ← e3_def] at hpoly; linarith
    -- Split exact 13-powers of |e2|, |e3|, |u|:
    obtain ⟨a, M2, hM2p, hM2nd, hM2eq⟩ := shell13.split_prime_pow 13 (by decide) (nat_of_int (|e2|)) (shell13.nat_abs_pos e2 he2_nz)
    obtain ⟨b, M3, hM3p, hM3nd, hM3eq⟩ := shell13.split_prime_pow 13 (by decide) (nat_of_int (|e3|)) (shell13.nat_abs_pos e3 he3_nz)
    obtain ⟨c, Mu, hMup, hMund, hMueq⟩ := shell13.split_prime_pow 13 (by decide) (nat_of_int (|u|)) (shell13.nat_abs_pos u hu)
    -- Step 1: 3*a = 1 + 2*b from |e2|^3 = 13 * |e3|^2
    have hab : 3 * a = 1 + 2 * b
      have hnat_eq : nat_of_int (|e2|) ^ 3 = 13 * nat_of_int (|e3|) ^ 2
        have hce : ((nat_of_int (|e2|) ^ 3 : ℕ) : ℤ) = ((13 * nat_of_int (|e3|) ^ 2 : ℕ) : ℤ)
          rw [cast_pow.int, cast_mul.int, cast_pow.int, int_of_nat_of_int (|e2|) (abs_nonneg.int e2), int_of_nat_of_int (|e3|) (abs_nonneg.int e3)]
          have h13c : ((13 : ℕ) : ℤ) = 13 := by decide
          rw [h13c, ← int.abs_pow_eq 3 e2, ← int.abs_pow_eq 2 e3, he2_cube]
          rw [int.abs_mul_eq (-13) (e3 ^ 2)]
          have ha13 : |(-13 : ℤ)| = 13 := by decide
          rw [ha13]
        exact (cast_inj.int (nat_of_int (|e2|) ^ 3) (13 * nat_of_int (|e3|) ^ 2)).mp hce
      rw [hM2eq, hM3eq] at hnat_eq
      have hl : (13 ^ a * M2) ^ 3 = 13 ^ (3 * a) * M2 ^ 3
        rw [nat.mul_pow_eq 3 (13 ^ a) M2]
        have hp3 : (13 ^ a) ^ 3 = 13 ^ (3 * a)
          have hcm : 3 * a = a * 3 := by ring
          rw [hcm, nat.pow_mul_swap 3 a 13]
        rw [hp3]
      have hr : 13 * (13 ^ b * M3) ^ 2 = 13 ^ (1 + 2 * b) * M3 ^ 2
        rw [nat.mul_pow_eq 2 (13 ^ b) M3]
        have hp2 : (13 ^ b) ^ 2 = 13 ^ (2 * b)
          have hcm : 2 * b = b * 2 := by ring
          rw [hcm, nat.pow_mul_swap 2 b 13]
        rw [hp2, pow_add.nat 13 1 (2 * b)]
        have h13_1 : 13 ^ 1 = 13 := by decide
        rw [h13_1]; ring
      rw [hl, hr] at hnat_eq
      have hM2_3nd : (M2 ^ 3) % 13 ≠ 0
        intro h0
        have hd := prime_dvd_of_dvd_pow.nat 13 M2 3 (is_prime_nat.to_prime 13 is_prime_nat_thirteen) (shell7.nat_dvd_of_mod_zero 13 (M2 ^ 3) (by decide) h0)
        exact hM2nd (shell7.nat_mod_zero_of_dvd 13 M2 hd)
      have hM3_2nd : (M3 ^ 2) % 13 ≠ 0
        intro h0
        have hd := prime_dvd_of_dvd_pow.nat 13 M3 2 (is_prime_nat.to_prime 13 is_prime_nat_thirteen) (shell7.nat_dvd_of_mod_zero 13 (M3 ^ 2) (by decide) h0)
        exact hM3nd (shell7.nat_mod_zero_of_dvd 13 M3 hd)
      exact shell13.prime_pow_exp_unique 13 is_prime_nat_thirteen (3 * a) (1 + 2 * b) (M2 ^ 3) (M3 ^ 2) hM2_3nd hM3_2nd hnat_eq
    -- Step 2: helper showing if 13^k divides two of {u^3, e2*u, e3} then it divides the third!
    have hdiv_e2 : ∀ k : ℕ, k ≤ a → ∃ q : ℤ, e2 = (13 : ℤ) ^ k * q
      intro k hka
      have hd : 13 ^ k ∣ nat_of_int (|e2|)
        rw [hM2eq]
        have ha_eq : a = k + (a - k) := by omega
        rw [ha_eq, pow_add.nat 13 k (a - k)]
        exact (dvd.iff_exists (13 ^ k) (13 ^ k * 13 ^ (a - k) * M2) (pow_pos.nat 13 k (by decide))).mpr ⟨13 ^ (a - k) * M2, by ring⟩
      exact shell13.int_pow_dvd_of_nat 13 k e2 (by decide) hd
    have hdiv_e3 : ∀ k : ℕ, k ≤ b → ∃ q : ℤ, e3 = (13 : ℤ) ^ k * q
      intro k hkb
      have hd : 13 ^ k ∣ nat_of_int (|e3|)
        rw [hM3eq]
        have hb_eq : b = k + (b - k) := by omega
        rw [hb_eq, pow_add.nat 13 k (b - k)]
        exact (dvd.iff_exists (13 ^ k) (13 ^ k * 13 ^ (b - k) * M3) (pow_pos.nat 13 k (by decide))).mpr ⟨13 ^ (b - k) * M3, by ring⟩
      exact shell13.int_pow_dvd_of_nat 13 k e3 (by decide) hd
    have hdiv_u : ∀ k : ℕ, k ≤ c → ∃ q : ℤ, u = (13 : ℤ) ^ k * q
      intro k hkc
      have hd : 13 ^ k ∣ nat_of_int (|u|)
        rw [hMueq]
        have hc_eq : c = k + (c - k) := by omega
        rw [hc_eq, pow_add.nat 13 k (c - k)]
        exact (dvd.iff_exists (13 ^ k) (13 ^ k * 13 ^ (c - k) * Mu) (pow_pos.nat 13 k (by decide))).mpr ⟨13 ^ (c - k) * Mu, by ring⟩
      exact shell13.int_pow_dvd_of_nat 13 k u (by decide) hd
    have hnot_u3 : ¬ (13 ^ (3 * c + 1) ∣ nat_of_int (|u ^ 3|))
      intro hd
      rw [int.abs_pow_nat 3 u, hMueq, nat.mul_pow_eq 3 (13 ^ c) Mu] at hd
      have hp3 : (13 ^ c) ^ 3 = 13 ^ (3 * c)
        have hcm : 3 * c = c * 3 := by ring
        rw [hcm, nat.pow_mul_swap 3 c 13]
      rw [hp3] at hd
      obtain ⟨q, hq⟩ := (dvd.iff_exists (13 ^ (3 * c + 1)) (13 ^ (3 * c) * Mu ^ 3) (pow_pos.nat 13 (3 * c + 1) (by decide))).mp hd
      rw [pow_succ.nat 13 (3 * c)] at hq
      have hcancel : Mu ^ 3 = 13 * q
        apply nat.mul_cancel_left_pos (13 ^ (3 * c)) (Mu ^ 3) (13 * q) (pow_pos.nat 13 (3 * c) (by decide))
        rw [hq]; ring
      have hd13 : 13 ∣ Mu ^ 3 := (dvd.iff_exists 13 (Mu ^ 3) (by decide)).mpr ⟨q, hcancel⟩
      have hdMu := prime_dvd_of_dvd_pow.nat 13 Mu 3 (is_prime_nat.to_prime 13 is_prime_nat_thirteen) hd13
      exact hMund (shell7.nat_mod_zero_of_dvd 13 Mu hdMu)
    have hnot_e2u : ¬ (13 ^ (a + c + 1) ∣ nat_of_int (|e2 * u|))
      intro hd
      have habs_m : nat_of_int (|e2 * u|) = nat_of_int (|e2|) * nat_of_int (|u|)
        apply (cast_inj.int (nat_of_int (|e2 * u|)) (nat_of_int (|e2|) * nat_of_int (|u|))).mp
        rw [int_of_nat_of_int (|e2 * u|) (abs_nonneg.int (e2 * u)), cast_mul.int,
            int_of_nat_of_int (|e2|) (abs_nonneg.int e2), int_of_nat_of_int (|u|) (abs_nonneg.int u),
            int.abs_mul_eq e2 u]
      rw [habs_m, hM2eq, hMueq] at hd
      have hre : 13 ^ a * M2 * (13 ^ c * Mu) = 13 ^ (a + c) * (M2 * Mu) := by rw [pow_add.nat 13 a c]; ring
      rw [hre] at hd
      obtain ⟨q, hq⟩ := (dvd.iff_exists (13 ^ (a + c + 1)) (13 ^ (a + c) * (M2 * Mu)) (pow_pos.nat 13 (a + c + 1) (by decide))).mp hd
      rw [pow_succ.nat 13 (a + c)] at hq
      have hcancel : M2 * Mu = 13 * q
        apply nat.mul_cancel_left_pos (13 ^ (a + c)) (M2 * Mu) (13 * q) (pow_pos.nat 13 (a + c) (by decide))
        rw [hq]; ring
      have hd13 : 13 ∣ (M2 * Mu) := (dvd.iff_exists 13 (M2 * Mu) (by decide)).mpr ⟨q, hcancel⟩
      obtain h1 | h2 := is_prime_nat_thirteen.2 M2 Mu hd13
      · exact hM2nd (shell7.nat_mod_zero_of_dvd 13 M2 h1)
      · exact hMund (shell7.nat_mod_zero_of_dvd 13 Mu h2)
    have hnot_e3 : ¬ (13 ^ (b + 1) ∣ nat_of_int (|e3|))
      intro hd
      rw [hM3eq] at hd
      obtain ⟨q, hq⟩ := (dvd.iff_exists (13 ^ (b + 1)) (13 ^ b * M3) (pow_pos.nat 13 (b + 1) (by decide))).mp hd
      rw [pow_succ.nat 13 b] at hq
      have hcancel : M3 = 13 * q
        apply nat.mul_cancel_left_pos (13 ^ b) M3 (13 * q) (pow_pos.nat 13 b (by decide))
        rw [hq]; ring
      exact hM3nd (shell7.nat_mod_zero_of_dvd 13 M3 ((dvd.iff_exists 13 M3 (by decide)).mpr ⟨q, hcancel⟩))
    -- Step 3: Compare the three 13-adic valuations (3*c, a+c, b) using 3*a = 1 + 2*b!
    obtain ⟨h1a, h1b⟩ | ⟨h2a, h2b⟩ | ⟨h3a, h3b⟩ := shell13.val13_unique_min a b c hab
    · -- 13^(3c+1) divides both e2*u and e3, hence divides u^3 = e3 - e2*u!
      obtain ⟨q2, hq2⟩ := hdiv_e2 a (by omega)
      obtain ⟨qu, hqu⟩ := hdiv_u c (by omega)
      obtain ⟨q3, hq3⟩ := hdiv_e3 (3 * c + 1) (by omega)
      have he2u_d : ∃ q : ℤ, e2 * u = (13 : ℤ) ^ (3 * c + 1) * q
        set rem := a + c - (3 * c + 1)
        have hstep : a + c = (3 * c + 1) + rem := by omega
        use (13 : ℤ) ^ rem * (q2 * qu)
        rw [hq2, hqu]
        calc ((13 : ℤ) ^ a * q2) * ((13 : ℤ) ^ c * qu)
          = (13 : ℤ) ^ a * (13 : ℤ) ^ c * (q2 * qu) := by ring
          _ = (13 : ℤ) ^ (a + c) * (q2 * qu) := by rw [← shell13.int_pow_add 13 a c]
          _ = (13 : ℤ) ^ ((3 * c + 1) + rem) * (q2 * qu) := by rw [hstep]
          _ = ((13 : ℤ) ^ (3 * c + 1) * (13 : ℤ) ^ rem) * (q2 * qu) := by rw [shell13.int_pow_add 13 (3 * c + 1) rem]
          _ = (13 : ℤ) ^ (3 * c + 1) * ((13 : ℤ) ^ rem * (q2 * qu)) := by ring
      obtain ⟨q2u, hq2u⟩ := he2u_d
      have hu3_eq : u ^ 3 = (13 : ℤ) ^ (3 * c + 1) * (q3 - q2u)
        have hsub : u ^ 3 = e3 - e2 * u := by linarith
        rw [hsub, hq3, hq2u]; ring
      exact hnot_u3 (shell13.nat_pow_dvd_of_int_mul 13 (3 * c + 1) (u ^ 3) (q3 - q2u) (by decide) hu3_eq)
    · -- 13^(a+c+1) divides both u^3 and e3, hence divides e2*u = e3 - u^3!
      obtain ⟨qu, hqu⟩ := hdiv_u c (by omega)
      obtain ⟨q3, hq3⟩ := hdiv_e3 (a + c + 1) (by omega)
      have hu3_d : ∃ q : ℤ, u ^ 3 = (13 : ℤ) ^ (a + c + 1) * q
        set rem := 3 * c - (a + c + 1)
        have hstep : 3 * c = (a + c + 1) + rem := by omega
        use (13 : ℤ) ^ rem * qu ^ 3
        rw [hqu, shell13.int_mul_pow 3 ((13 : ℤ) ^ c) qu, shell13.int_pow_mul 13 c 3]
        have hcm : c * 3 = 3 * c := by ring
        rw [hcm, hstep, shell13.int_pow_add 13 (a + c + 1) rem]; ring
      obtain ⟨qu3, hqu3⟩ := hu3_d
      have he2u_eq : e2 * u = (13 : ℤ) ^ (a + c + 1) * (q3 - qu3)
        have hsub : e2 * u = e3 - u ^ 3 := by linarith
        rw [hsub, hq3, hqu3]; ring
      exact hnot_e2u (shell13.nat_pow_dvd_of_int_mul 13 (a + c + 1) (e2 * u) (q3 - qu3) (by decide) he2u_eq)
    · -- Remaining case: b < 3*c AND b < a + c!
      obtain ⟨q2, hq2⟩ := hdiv_e2 a (by omega)
      obtain ⟨qu, hqu⟩ := hdiv_u c (by omega)
      have hu3_d : ∃ q : ℤ, u ^ 3 = (13 : ℤ) ^ (b + 1) * q
        set rem := 3 * c - (b + 1)
        have hstep : 3 * c = (b + 1) + rem := by omega
        use (13 : ℤ) ^ rem * qu ^ 3
        rw [hqu, shell13.int_mul_pow 3 ((13 : ℤ) ^ c) qu, shell13.int_pow_mul 13 c 3]
        have hcm : c * 3 = 3 * c := by ring
        rw [hcm, hstep, shell13.int_pow_add 13 (b + 1) rem]; ring
      have he2u_d : ∃ q : ℤ, e2 * u = (13 : ℤ) ^ (b + 1) * q
        set rem := a + c - (b + 1)
        have hstep : a + c = (b + 1) + rem := by omega
        use (13 : ℤ) ^ rem * (q2 * qu)
        rw [hq2, hqu]
        calc ((13 : ℤ) ^ a * q2) * ((13 : ℤ) ^ c * qu)
          = (13 : ℤ) ^ a * (13 : ℤ) ^ c * (q2 * qu) := by ring
          _ = (13 : ℤ) ^ (a + c) * (q2 * qu) := by rw [← shell13.int_pow_add 13 a c]
          _ = (13 : ℤ) ^ ((b + 1) + rem) * (q2 * qu) := by rw [hstep]
          _ = ((13 : ℤ) ^ (b + 1) * (13 : ℤ) ^ rem) * (q2 * qu) := by rw [shell13.int_pow_add 13 (b + 1) rem]
          _ = (13 : ℤ) ^ (b + 1) * ((13 : ℤ) ^ rem * (q2 * qu)) := by ring
      obtain ⟨qu3, hqu3⟩ := hu3_d
      obtain ⟨q2u, hq2u⟩ := he2u_d
      have he3_eq : e3 = (13 : ℤ) ^ (b + 1) * (qu3 + q2u)
        have hadd : e3 = u ^ 3 + e2 * u := by linarith
        rw [hadd, hqu3, hq2u]; ring
      exact hnot_e3 (shell13.nat_pow_dvd_of_int_mul 13 (b + 1) e3 (qu3 + q2u) (by decide) he3_eq)

-- EDGE CASE 2 (0 CUSTOM AXIOMS!): s = e_2 / e_1^2 = 1 is IMPOSSIBLE over R (u^2 + v^2 + w^2 + e_1^2 = 0)!
+ shell13.no_s_eq_one (u v w : ℤ) (hu : u ≠ 0)
    (he2 : u * v + v * w + w * u = (u + v + w) ^ 2) : False
  have hsum_sq : u ^ 2 + v ^ 2 + w ^ 2 + (u + v + w) ^ 2 = 0
    have hid : u ^ 2 + v ^ 2 + w ^ 2 + (u + v + w) ^ 2 = 2 * ((u + v + w) ^ 2 - (u * v + v * w + w * u)) := by ring
    rw [hid, he2]; ring
  have hu2 : 0 < u ^ 2
    obtain hlt | hgt := lt_or_gt_of_ne.int u 0 hu <;> nlinarith
  nlinarith

-- EDGE CASE 3 (0 CUSTOM AXIOMS!): s = 0 (e_2 = 0, e_1 != 0, e_3 != 0) on H_4 = 0 is IMPOSSIBLE!
-- Proof: e_2 = 0 forces 7*e_3 = -e_1^3, so 7*u^3 - 7*e_1*u^2 + e_1^3 = 0, which has NO nontrivial
-- integer solution because X^3 + X^2 + 1 is irreducible mod 2!
+ shell13.no_s_eq_zero (u v w : ℤ) (hu : u ≠ 0) (hv : v ≠ 0) (hw : w ≠ 0)
    (hH : shell13.H4 u v w = 0) (he1 : u + v + w ≠ 0) (he2 : u * v + v * w + w * u = 0) : False
  set e1 := u + v + w
  set e3 := u * v * w
  have he3_nz : e3 ≠ 0
    intro h0
    have h0' : u * v * w = 0 := by rw [← e3_def]; exact h0
    obtain h1 | h2 := shell7.int_mul_eq_zero (u * v) w h0'
    · obtain h1a | h1b := shell7.int_mul_eq_zero u v h1
      · exact hu h1a
      · exact hv h1b
    · exact hw h2
  have hq0 : 7 * e1 ^ 4 * e3 ^ 2 + e1 ^ 7 * e3 = 0
    have h1 := (shell13.H4_A3_identities u v w).1; rw [hH, ← e1_def, ← e3_def] at h1
    have h3 := (shell13.H4_A3_identities u v w).2.2.1; rw [← e1_def, ← e3_def] at h3
    have hl0 : (e1 ^ 3 * (u * v + v * w + w * u) - 3 * e1 * (u * v + v * w + w * u) ^ 2 - e1 ^ 2 * e3 + 5 * (u * v + v * w + w * u) * e3) ^ 2 -
               (e1 ^ 2 - (u * v + v * w + w * u)) ^ 2 * ((u - v) * (v - w) * (w - u)) ^ 2 = 0
      have hlin : (e1 ^ 3 * (u * v + v * w + w * u) - 3 * e1 * (u * v + v * w + w * u) ^ 2 - e1 ^ 2 * e3 + 5 * (u * v + v * w + w * u) * e3) =
                  (e1 ^ 2 - (u * v + v * w + w * u)) * ((u - v) * (v - w) * (w - u)) := by linarith
      rw [hlin]; ring
    rw [hl0, he2] at h3
    linarith
  have hfac : (e1 ^ 4 * e3) * (7 * e3 + e1 ^ 3) = 0 := by linarith
  have he1_4_nz : e1 ^ 4 ≠ 0
    intro h0
    have he1_2 : 0 < e1 ^ 2
      obtain hlt | hgt := lt_or_gt_of_ne.int e1 0 he1 <;> nlinarith
    nlinarith
  obtain hbad | h7e3 := shell7.int_mul_eq_zero (e1 ^ 4 * e3) (7 * e3 + e1 ^ 3) hfac
  · obtain h1 | h2 := shell7.int_mul_eq_zero (e1 ^ 4) e3 hbad
    · exact he1_4_nz h1
    · exact he3_nz h2
  · have hcubic : 7 * u ^ 3 - 7 * e1 * u ^ 2 + e1 ^ 3 = 0
      have hpoly : u ^ 3 - (u + v + w) * u ^ 2 + (u * v + v * w + w * u) * u - u * v * w = 0 := by ring
      rw [← e1_def, ← e3_def, he2] at hpoly; linarith
    -- Reduce (|u|, |e1|) by their gcd using shell7.reduce_ratio_coprime!
    obtain ⟨rn, rd, k, hrnp, hrdp, hkp, hcop, huneq, he1neq⟩ :=
      shell7.reduce_ratio_coprime (nat_of_int (|u|)) (nat_of_int (|e1|)) (shell13.nat_abs_pos u hu) (shell13.nat_abs_pos e1 he1)
    have hnu_eq : (nat_of_int (|u|) : ℤ) = |u| := int_of_nat_of_int (|u|) (abs_nonneg.int u)
    have hne1_eq : (nat_of_int (|e1|) : ℤ) = |e1| := int_of_nat_of_int (|e1|) (abs_nonneg.int e1)
    have hk_pos_z : (0 : ℤ) < (k : ℤ) := (cast_pos.int k).mpr hkp
    have hu_ex : ∃ U : ℤ, u = (k : ℤ) * U ∧ |U| = (rn : ℤ)
      obtain ⟨eu, _⟩ | ⟨eu, _⟩ := abs_cases.int u
      · use (rn : ℤ)
        constructor
        · have h1 : |u| = (k : ℤ) * (rn : ℤ) := by rw [← hnu_eq, huneq, cast_mul.int]
          linarith
        · have hnn : (0 : ℤ) ≤ (rn : ℤ) := (cast_le.int 0 rn).mpr (by omega)
          obtain ⟨e, _⟩ | ⟨_, h⟩ := abs_cases.int (rn : ℤ) <;> linarith
      · use -(rn : ℤ)
        constructor
        · have h1 : |u| = (k : ℤ) * (rn : ℤ) := by rw [← hnu_eq, huneq, cast_mul.int]
          linarith
        · have hnn : (0 : ℤ) ≤ (rn : ℤ) := (cast_le.int 0 rn).mpr (by omega)
          obtain ⟨_, h⟩ | ⟨e, _⟩ := abs_cases.int (-(rn : ℤ)) <;> linarith
    have he1_ex : ∃ E : ℤ, e1 = (k : ℤ) * E ∧ |E| = (rd : ℤ)
      obtain ⟨ee, _⟩ | ⟨ee, _⟩ := abs_cases.int e1
      · use (rd : ℤ)
        constructor
        · have h1 : |e1| = (k : ℤ) * (rd : ℤ) := by rw [← hne1_eq, he1neq, cast_mul.int]
          linarith
        · have hnn : (0 : ℤ) ≤ (rd : ℤ) := (cast_le.int 0 rd).mpr (by omega)
          obtain ⟨e, _⟩ | ⟨_, h⟩ := abs_cases.int (rd : ℤ) <;> linarith
      · use -(rd : ℤ)
        constructor
        · have h1 : |e1| = (k : ℤ) * (rd : ℤ) := by rw [← hne1_eq, he1neq, cast_mul.int]
          linarith
        · have hnn : (0 : ℤ) ≤ (rd : ℤ) := (cast_le.int 0 rd).mpr (by omega)
          obtain ⟨_, h⟩ | ⟨e, _⟩ := abs_cases.int (-(rd : ℤ)) <;> linarith
    obtain ⟨U, hUeq, hUabs⟩ := hu_ex
    obtain ⟨E, hEeq, hEabs⟩ := he1_ex
    have hcop_eq : 7 * U ^ 3 - 7 * E * U ^ 2 + E ^ 3 = 0
      have hfac3 : (k : ℤ) ^ 3 * (7 * U ^ 3 - 7 * E * U ^ 2 + E ^ 3) = 0
        rw [hUeq, hEeq] at hcubic; linarith
      have hk3_nz : (k : ℤ) ^ 3 ≠ 0 := by nlinarith
      obtain hbad | hres := shell7.int_mul_eq_zero ((k : ℤ) ^ 3) (7 * U ^ 3 - 7 * E * U ^ 2 + E ^ 3) hfac3
      · exfalso; exact hk3_nz hbad
      · exact hres
    -- Mod 2 check: both U and E must be even, contradicting coprime(rn, rd)!
    have hU2_lt := mod_lt.int U 2 (by decide)
    have hU2_nn := mod_nonneg.int U 2 (by decide)
    have hE2_lt := mod_lt.int E 2 (by decide)
    have hE2_nn := mod_nonneg.int E 2 (by decide)
    have hUd := div_add_mod.int U 2
    have hEd := div_add_mod.int E 2
    set rU := U % 2
    set rE := E % 2
    have hU_ev : rU = 0
      by_contra h1
      have hrU1 : rU = 1 := by omega
      by_cases hrE0 : rE = 0
      · set A := U / 2; set B := E / 2
        have hUe : U = 1 + 2 * A := by linarith
        have hEe : E = 2 * B := by linarith
        set q := 3 + 21 * A + 42 * A ^ 2 + 28 * A ^ 3 - 7 * B * (1 + 2 * A) ^ 2 + 4 * B ^ 3
        have hmod : 7 * U ^ 3 - 7 * E * U ^ 2 + E ^ 3 = 1 + 2 * q := by rw [hUe, hEe, q_def]; ring
        have hz : (1 + 2 * q) % 2 = (0 : ℤ) % 2 := by rw [← hmod, hcop_eq]
        rw [add_mul_mod.int 1 q 2 (by decide)] at hz
        have hne : (1 : ℤ) % 2 ≠ (0 : ℤ) % 2 := by decide
        exact hne hz
      · have hrE1 : rE = 1 := by omega
        set A := U / 2; set B := E / 2
        have hUe : U = 1 + 2 * A := by linarith
        have hEe : E = 1 + 2 * B := by linarith
        have hmod : (7 * U ^ 3 - 7 * E * U ^ 2 + E ^ 3) % 2 = 1
          set q := 28 * A ^ 3 + 42 * A ^ 2 + 21 * A - 28 * B * A ^ 2 - 28 * B * A - 7 * B - 14 * A ^ 2 - 14 * A + 4 * B ^ 3 + 6 * B ^ 2 + 3 * B
          have hid2 : 7 * U ^ 3 - 7 * E * U ^ 2 + E ^ 3 = 1 + 2 * q := by rw [hUe, hEe, q_def]; ring
          rw [hid2, add_mul_mod.int 1 q 2 (by decide)]; decide
        rw [hcop_eq] at hmod
        have h02 : (0 : ℤ) % 2 = 0 := by decide
        rw [h02] at hmod; omega
    have hE_ev : rE = 0
      by_contra h1
      have hrE1 : rE = 1 := by omega
      set A := U / 2; set B := E / 2
      have hUe : U = 2 * A := by linarith
      have hEe : E = 1 + 2 * B := by linarith
      set q := 28 * A ^ 3 - 14 * (1 + 2 * B) * A ^ 2 + 4 * B ^ 3 + 6 * B ^ 2 + 3 * B
      have hid2 : 7 * U ^ 3 - 7 * E * U ^ 2 + E ^ 3 = 1 + 2 * q := by rw [hUe, hEe, q_def]; ring
      have hz : (1 + 2 * q) % 2 = (0 : ℤ) % 2 := by rw [← hid2, hcop_eq]
      rw [add_mul_mod.int 1 q 2 (by decide)] at hz
      have hne : (1 : ℤ) % 2 ≠ (0 : ℤ) % 2 := by decide
      exact hne hz
    have h2rn : 2 ∣ rn
      have hU2 : int_dvd 2 U := ⟨U / 2, by linarith⟩
      have hd := (cshell.dvd_iff_nat_abs 2 (by decide) U).mp hU2
      have hnat_rn : nat_of_int (|U|) = rn
        apply (cast_inj.int (nat_of_int (|U|)) rn).mp
        rw [int_of_nat_of_int (|U|) (abs_nonneg.int U), hUabs]
      rw [hnat_rn] at hd; exact hd
    have h2rd : 2 ∣ rd
      have hE2 : int_dvd 2 E := ⟨E / 2, by linarith⟩
      have hd := (cshell.dvd_iff_nat_abs 2 (by decide) E).mp hE2
      have hnat_rd : nat_of_int (|E|) = rd
        apply (cast_inj.int (nat_of_int (|E|)) rd).mp
        rw [int_of_nat_of_int (|E|) (abs_nonneg.int E), hEabs]
      rw [hnat_rd] at hd; exact hd
    unfold nat.coprime_primes at hcop
    exact hcop 2 is_prime_nat_two ⟨h2rn, h2rd⟩

-- Helper: exact integer square-root cancellation: L^2 = M^2 * R (M != 0) => M | L and (L/M)^2 = R!
+ shell13.int_sq_div_exact (L M R : ℤ) (hM : M ≠ 0) (heq : L ^ 2 = M ^ 2 * R) :
    ∃ Y : ℤ, L = M * Y ∧ Y ^ 2 = R
  by_cases hL0 : L = 0
  · rw [hL0] at heq
    have hM2_nz : M ^ 2 ≠ 0
      obtain hlt | hgt := lt_or_gt_of_ne.int M 0 hM <;> nlinarith
    have hR0 : R = 0
      obtain h1 | h2 := shell7.int_mul_eq_zero (M ^ 2) R (by linarith)
      · exfalso; exact hM2_nz h1
      · exact h2
    exact ⟨0, by rw [hL0]; ring, by rw [hR0]; ring⟩
  · obtain ⟨rn, rd, k, hrnp, hrdp, hkp, hcop, hLneq, hMneq⟩ :=
      shell7.reduce_ratio_coprime (nat_of_int (|L|)) (nat_of_int (|M|)) (shell13.nat_abs_pos L hL0) (shell13.nat_abs_pos M hM)
    have hR_nn : 0 ≤ R
      have hM2p : 0 < M ^ 2
        obtain hlt | hgt := lt_or_gt_of_ne.int M 0 hM <;> nlinarith
      nlinarith
    have hR_eq_n : ((nat_of_int R : ℕ) : ℤ) = R := int_of_nat_of_int R hR_nn
    set nR := nat_of_int R
    have hnat_eq : rn ^ 2 = rd ^ 2 * nR
      have h1 : nat_of_int (|L|) ^ 2 = nat_of_int (|M|) ^ 2 * nR
        apply (cast_inj.int (nat_of_int (|L|) ^ 2) (nat_of_int (|M|) ^ 2 * nR)).mp
        rw [cast_pow.int, cast_mul.int, cast_pow.int, hR_eq_n,
            int_of_nat_of_int (|L|) (abs_nonneg.int L), int_of_nat_of_int (|M|) (abs_nonneg.int M)]
        have hsq : ∀ z : ℤ, |z| ^ 2 = z ^ 2
          intro z
          obtain ⟨e, _⟩ | ⟨e, _⟩ := abs_cases.int z
          · rw [e]
          · rw [e]; ring
        rw [hsq L, hsq M, heq]
      rw [hLneq, hMneq, nat.mul_pow_eq 2 k rn, nat.mul_pow_eq 2 k rd] at h1
      apply nat.mul_cancel_left_pos (k ^ 2) (rn ^ 2) (rd ^ 2 * nR) (pow_pos.nat k 2 hkp)
      linarith
    -- Show rd = 1 (any prime p | rd divides rn^2 hence rn, contradicting coprime(rn, rd)!)
    have hrd1 : rd = 1
      by_contra hne1
      have hrd2 : 2 ≤ rd := by omega
      have hsp := min_fac.spec rd hrd2
      have hp_raw := prime.to_is_prime_nat (min_fac rd) (min_fac.prime rd hrd2)
      have hp_pr_raw := min_fac.prime rd hrd2
      have hp_rd_raw : min_fac rd ∣ rd := hsp.2.2.1
      have hp_pos_raw : 0 < min_fac rd := by linarith [hsp.1]
      set p0 := min_fac rd
      have hp : is_prime_nat p0 := hp_raw
      have hp_pr : prime p0 := hp_pr_raw
      have hp_rd : p0 ∣ rd := hp_rd_raw
      have hp_pos : 0 < p0 := hp_pos_raw
      obtain ⟨q, hq⟩ := (dvd.iff_exists p0 rd hp_pos).mp hp_rd
      have hp_rn2 : p0 ∣ (rn ^ 2)
        rw [hnat_eq, hq]
        exact (dvd.iff_exists p0 ((p0 * q) ^ 2 * nR) hp_pos).mpr ⟨p0 * q ^ 2 * nR, by ring⟩
      have hp_rn := prime_dvd_of_dvd_pow.nat p0 rn 2 hp_pr hp_rn2
      unfold nat.coprime_primes at hcop
      exact hcop p0 hp ⟨hp_rn, hp_rd⟩
    rw [hrd1] at hMneq hnat_eq
    have hM_abs : |M| = (k : ℤ)
      have h1 : (nat_of_int (|M|) : ℤ) = |M| := int_of_nat_of_int (|M|) (abs_nonneg.int M)
      rw [hMneq] at h1
      have hk1 : k * 1 = k := by ring
      rw [hk1] at h1; exact h1.symm
    have hL_abs : |L| = (k : ℤ) * (rn : ℤ)
      have h1 : (nat_of_int (|L|) : ℤ) = |L| := int_of_nat_of_int (|L|) (abs_nonneg.int L)
      rw [hLneq, cast_mul.int] at h1; exact h1.symm
    have hrn_sq : (rn : ℤ) ^ 2 = R
      have h1 : ((rn ^ 2 : ℕ) : ℤ) = ((1 ^ 2 * nR : ℕ) : ℤ) := by rw [hnat_eq]
      have h1sq : 1 ^ 2 * nR = nR := by ring
      rw [h1sq, cast_pow.int, hR_eq_n] at h1; exact h1
    obtain ⟨eL, _⟩ | ⟨eL, _⟩ := abs_cases.int L
    · obtain ⟨eM, _⟩ | ⟨eM, _⟩ := abs_cases.int M
      · rw [eL] at hL_abs; rw [eM] at hM_abs; rw [← hM_abs] at hL_abs
        exact ⟨(rn : ℤ), hL_abs, hrn_sq⟩
      · rw [eL] at hL_abs; rw [eM] at hM_abs
        have hMneg : (k : ℤ) = -M := by linarith
        rw [hMneg] at hL_abs
        exact ⟨-(rn : ℤ), by linarith, by rw [← hrn_sq]; ring⟩
    · obtain ⟨eM, _⟩ | ⟨eM, _⟩ := abs_cases.int M
      · rw [eL] at hL_abs; rw [eM] at hM_abs; rw [← hM_abs] at hL_abs
        exact ⟨-(rn : ℤ), by linarith, by rw [← hrn_sq]; ring⟩
      · rw [eL] at hL_abs; rw [eM] at hM_abs
        have hMneg : (k : ℤ) = -M := by linarith
        rw [hMneg] at hL_abs
        exact ⟨(rn : ℤ), by linarith, hrn_sq⟩

-- THEOREM 2A (COMPLETE 0-AXIOM REDUCTION H_4 -> Q_13 WITH s != 0):
-- Every integer point (u, v, w) on H_4 : u^4*v + v^4*w + w^4*u = 0 with u*v*w != 0
-- yields coprime integers (p_s, q_s) with p_s != 0, q_s > 0 and an integer Y satisfying:
--     Y^2 = q_s * (-52*p_s^5 + 104*p_s^4*q_s - 104*p_s^3*q_s^2 + 52*p_s^2*q_s^3 - 12*p_s*q_s^4 + q_s^5).
+ shell13.H4_nonzero_implies_Q13_nonzero_s (u v w : ℤ) (hu : u ≠ 0) (hv : v ≠ 0) (hw : w ≠ 0)
    (hH : shell13.H4 u v w = 0) :
    ∃ p_s q_s Y : ℤ,
      p_s ≠ 0 ∧ 0 < q_s ∧
      nat.coprime_primes (nat_of_int (|p_s|)) (nat_of_int q_s) ∧
      Y ^ 2 = q_s * shell13.Q13_poly p_s q_s
  set e1 := u + v + w
  set e2 := u * v + v * w + w * u
  set e3 := u * v * w
  have he1_nz : e1 ≠ 0
    intro h0; rw [e1_def] at h0; exact shell13.no_e1_zero u v w hu hv hw hH h0
  have he2_nz : e2 ≠ 0
    intro h0; rw [e2_def] at h0
    have he1' : u + v + w ≠ 0 := by rw [← e1_def]; exact he1_nz
    exact shell13.no_s_eq_zero u v w hu hv hw hH he1' h0
  have he2_ne_e1sq : e2 ≠ e1 ^ 2
    intro h0; rw [e2_def, e1_def] at h0; exact shell13.no_s_eq_one u v w hu h0
  have he1sq_pos : 0 < e1 ^ 2
    obtain hlt | hgt := lt_or_gt_of_ne.int e1 0 he1_nz <;> nlinarith
  -- Extract L4^2 = (e2 - e1^2)^2 * Q13_poly(e2, e1^2) from H4 = 0!
  set A4 := 13 * e2 ^ 2 - 16 * e1 ^ 2 * e2 + 7 * e1 ^ 4
  set B4 := -12 * e1 * e2 ^ 3 + 14 * e1 ^ 3 * e2 ^ 2 - 7 * e1 ^ 5 * e2 + e1 ^ 7
  set L4 := 2 * A4 * e3 + B4
  have hL4sq : L4 ^ 2 = (e2 - e1 ^ 2) ^ 2 * shell13.Q13_poly e2 (e1 ^ 2)
    have hid := shell13.H4_A3_identities u v w
    have h1 := hid.1; rw [hH, ← e1_def, ← e2_def, ← e3_def] at h1
    have h3 := hid.2.2.1; rw [← e1_def, ← e2_def, ← e3_def, ← A4_def, ← B4_def] at h3
    have h4 := hid.2.2.2; rw [← e1_def, ← e2_def, ← e3_def, ← A4_def, ← B4_def, ← L4_def] at h4
    have hquad0 : A4 * e3 ^ 2 + B4 * e3 + e2 ^ 5 = 0
      have hl0 : (e1 ^ 3 * e2 - 3 * e1 * e2 ^ 2 - e1 ^ 2 * e3 + 5 * e2 * e3) ^ 2 -
                 (e1 ^ 2 - e2) ^ 2 * ((u - v) * (v - w) * (w - u)) ^ 2 = 0
        have hlin : (e1 ^ 3 * e2 - 3 * e1 * e2 ^ 2 - e1 ^ 2 * e3 + 5 * e2 * e3) =
                    (e1 ^ 2 - e2) * ((u - v) * (v - w) * (w - u)) := by linarith
        rw [hlin]; ring
      rw [hl0] at h3; linarith
    rw [hquad0] at h4; linarith
  -- Reduce the ratio |e2| / e1^2 to coprime positive (rn, rd) with common factor k > 0!
  obtain ⟨rn, rd, k, hrnp, hrdp, hkp, hcop, he2neq, he1sq_neq⟩ := shell7.reduce_ratio_coprime (nat_of_int (|e2|)) (nat_of_int (|(e1 ^ 2)|)) (shell13.nat_abs_pos e2 he2_nz) (shell13.nat_abs_pos (e1 ^ 2) (by linarith))
  have hne2_eq : (nat_of_int (|e2|) : ℤ) = |e2| := int_of_nat_of_int (|e2|) (abs_nonneg.int e2)
  have hne1sq_eq : (nat_of_int (|(e1 ^ 2)|) : ℤ) = |e1 ^ 2| := int_of_nat_of_int (|(e1 ^ 2)|) (abs_nonneg.int (e1 ^ 2))
  have he1sq_abs : |e1 ^ 2| = e1 ^ 2
    obtain ⟨e, _⟩ | ⟨_, h⟩ := abs_cases.int (e1 ^ 2) <;> linarith
  have he1sq_k : e1 ^ 2 = (k : ℤ) * (rd : ℤ)
    rw [← he1sq_abs, ← hne1sq_eq, he1sq_neq, cast_mul.int]
  have hp_ex : ∃ p_s : ℤ, e2 = (k : ℤ) * p_s ∧ p_s ≠ 0 ∧ nat_of_int (|p_s|) = rn
    obtain ⟨ee, _⟩ | ⟨ee, _⟩ := abs_cases.int e2
    · use (rn : ℤ)
      constructor
      · rw [← ee, ← hne2_eq, he2neq, cast_mul.int]
      · constructor
        · linarith [(cast_pos.int rn).mpr hrnp]
        · apply (cast_inj.int (nat_of_int (|(rn : ℤ)|)) rn).mp
          rw [int_of_nat_of_int (|(rn : ℤ)|) (abs_nonneg.int (rn : ℤ))]
          have hnn : (0 : ℤ) ≤ (rn : ℤ) := (cast_le.int 0 rn).mpr (by omega)
          obtain ⟨e, _⟩ | ⟨_, h⟩ := abs_cases.int (rn : ℤ) <;> linarith
    · use -(rn : ℤ)
      constructor
      · have h1 : |e2| = (k : ℤ) * (rn : ℤ) := by rw [← hne2_eq, he2neq, cast_mul.int]
        linarith
      · constructor
        · linarith [(cast_pos.int rn).mpr hrnp]
        · apply (cast_inj.int (nat_of_int (|-(rn : ℤ)|)) rn).mp
          rw [int_of_nat_of_int (|-(rn : ℤ)|) (abs_nonneg.int (-(rn : ℤ)))]
          have hnn : (0 : ℤ) ≤ (rn : ℤ) := (cast_le.int 0 rn).mpr (by omega)
          obtain ⟨_, h⟩ | ⟨e, _⟩ := abs_cases.int (-(rn : ℤ)) <;> linarith
  obtain ⟨p_s, he2_k, hp_nz, hp_abs⟩ := hp_ex
  set q_s : ℤ := (rd : ℤ)
  have hq_pos : 0 < q_s := by rw [q_s_def]; exact (cast_pos.int rd).mpr hrdp
  have hq_nat : nat_of_int q_s = rd
    apply (cast_inj.int (nat_of_int q_s) rd).mp
    rw [int_of_nat_of_int q_s (by linarith), q_s_def]
  -- Scale (e1 * L4)^2 = ((k^4) * (p_s - q_s))^2 * (q_s * Q13_poly(p_s, q_s))!
  have hscaled : (e1 * L4) ^ 2 = ((k : ℤ) ^ 4 * (p_s - q_s)) ^ 2 * (q_s * shell13.Q13_poly p_s q_s)
    have h1 : (e1 * L4) ^ 2 = e1 ^ 2 * L4 ^ 2 := by ring
    rw [h1, hL4sq, he2_k, he1sq_k]
    unfold shell13.Q13_poly; ring
  have hM_nz : (k : ℤ) ^ 4 * (p_s - q_s) ≠ 0
    intro h0
    have hk_pos_z : (0 : ℤ) < (k : ℤ) := (cast_pos.int k).mpr hkp
    have hk2 : 0 < (k : ℤ) * (k : ℤ) := mul_pos.int (k : ℤ) (k : ℤ) hk_pos_z hk_pos_z
    have hk4 : 0 < ((k : ℤ) * (k : ℤ)) * ((k : ℤ) * (k : ℤ)) := mul_pos.int _ _ hk2 hk2
    have hk4_nz : (k : ℤ) ^ 4 ≠ 0
      have he4 : (k : ℤ) ^ 4 = ((k : ℤ) * (k : ℤ)) * ((k : ℤ) * (k : ℤ)) := by ring
      rw [he4]; linarith
    obtain h1 | h2 := shell7.int_mul_eq_zero ((k : ℤ) ^ 4) (p_s - q_s) h0
    · exact hk4_nz h1
    · apply he2_ne_e1sq
      have hpe : p_s = q_s := by linarith
      rw [he2_k, he1sq_k, hpe]
  obtain ⟨Y, _, hYsq⟩ := shell13.int_sq_div_exact (e1 * L4) ((k : ℤ) ^ 4 * (p_s - q_s)) (q_s * shell13.Q13_poly p_s q_s) hM_nz hscaled
  have hcop' : nat.coprime_primes (nat_of_int (|p_s|)) (nat_of_int q_s)
    rw [hp_abs, hq_nat]; exact hcop
  exact ⟨p_s, q_s, Y, hp_nz, hq_pos, hcop', hYsq⟩

-- THEOREM 2B (ALL-CASE FLT(13) -> AFFINE s != 0 RATIONAL POINT ON Q_13 — 0 CUSTOM AXIOMS!):
-- Any positive integer solution x^13 + y^13 = z^13 yields a coprime integer solution of
--     Y^2 = q_s * (-52*p_s^5 + 104*p_s^4*q_s - 104*p_s^3*q_s^2 + 52*p_s^2*q_s^3 - 12*p_s*q_s^4 + q_s^5)
-- with p_s != 0 and q_s > 0!
+ shell13.flt13_implies_Q13_nonzero_s (x y z : ℕ) (hx : 0 < x) (hy : 0 < y)
    (heq : x ^ 13 + y ^ 13 = z ^ 13) :
    ∃ p_s q_s Y : ℤ,
      p_s ≠ 0 ∧ 0 < q_s ∧
      nat.coprime_primes (nat_of_int (|p_s|)) (nat_of_int q_s) ∧
      Y ^ 2 = q_s * shell13.Q13_poly p_s q_s
  have hz : 0 < z
    by_contra h0; have hzz : z = 0 := by omega
    have h013 : 0 ^ 13 = 0 := by decide
    have hx13 : 0 < x ^ 13 := pow_pos.nat x 13 hx
    rw [hzz, h013] at heq; omega
  set xz : ℤ := (x : ℤ)
  set yz : ℤ := (y : ℤ)
  set zz : ℤ := -(z : ℤ)
  have hxz_nz : xz ≠ 0 := by linarith [(cast_pos.int x).mpr hx]
  have hyz_nz : yz ≠ 0 := by linarith [(cast_pos.int y).mpr hy]
  have hzz_nz : zz ≠ 0 := by linarith [(cast_pos.int z).mpr hz]
  have hsum13 : xz ^ 13 + yz ^ 13 + zz ^ 13 = 0
    have heq_z : ((x ^ 13 + y ^ 13 : ℕ) : ℤ) = ((z ^ 13 : ℕ) : ℤ) := by rw [heq]
    rw [cast_add.int (x ^ 13) (y ^ 13), cast_pow.int x 13, cast_pow.int y 13, cast_pow.int z 13] at heq_z
    have hneg13 : (-(z : ℤ)) ^ 13 = -((z : ℤ) ^ 13) := by ring
    rw [xz_def, yz_def, zz_def, hneg13]; linarith
  have hH4 : shell13.H4 (xz * yz ^ 4) (yz * zz ^ 4) (zz * xz ^ 4) = 0
    rw [shell13.deg13_to_H4 xz yz zz, hsum13]; ring
  have hpow4_nz : ∀ t : ℤ, t ≠ 0 → t ^ 4 ≠ 0
    intro t ht h0
    have ht2 : 0 < t * t
      obtain hlt | hgt := lt_or_gt_of_ne.int t 0 ht
      · have h1 := mul_pos.int (-t) (-t) (by linarith) (by linarith); linarith
      · exact mul_pos.int t t hgt hgt
    have ht4 := mul_pos.int (t * t) (t * t) ht2 ht2
    have he4 : t ^ 4 = (t * t) * (t * t) := by ring
    rw [he4] at h0; linarith
  have hu_nz : xz * yz ^ 4 ≠ 0
    intro h0
    obtain h1 | h2 := shell7.int_mul_eq_zero xz (yz ^ 4) h0
    · exact hxz_nz h1
    · exact hpow4_nz yz hyz_nz h2
  have hv_nz : yz * zz ^ 4 ≠ 0
    intro h0
    obtain h1 | h2 := shell7.int_mul_eq_zero yz (zz ^ 4) h0
    · exact hyz_nz h1
    · exact hpow4_nz zz hzz_nz h2
  have hw_nz : zz * xz ^ 4 ≠ 0
    intro h0
    obtain h1 | h2 := shell7.int_mul_eq_zero zz (xz ^ 4) h0
    · exact hzz_nz h1
    · exact hpow4_nz xz hxz_nz h2
  exact shell13.H4_nonzero_implies_Q13_nonzero_s (xz * yz ^ 4) (yz * zz ^ 4) (zz * xz ^ 4) hu_nz hv_nz hw_nz hH4

-- THEOREM 2C (Q_13 HAS NO RATIONAL WEIERSTRASS POINTS — 0 CUSTOM AXIOMS!):
-- Modulo 3, Q13_poly(p_s, q_s) == 2*p_s^5 + 2*p_s^4*q_s + p_s^3*q_s^2 + p_s^2*q_s^3 + q_s^5
-- vanishes ONLY when 3 | p_s and 3 | q_s, contradicting coprimality!
-- This directly certifies that the unique 5-adic Chabauty zero W in the Weierstrass disk (4, 2)
-- of Q_13(F_5) is IRRATIONAL!
+ shell13.Q13_no_rational_weierstrass_root (p_s q_s : ℤ) (hq : 0 < q_s)
    (hcop : nat.coprime_primes (nat_of_int (|p_s|)) (nat_of_int q_s)) :
    shell13.Q13_poly p_s q_s ≠ 0
  intro h0
  have hp3_nn := mod_nonneg.int p_s 3 (by decide)
  have hp3_lt := mod_lt.int p_s 3 (by decide)
  have hq3_nn := mod_nonneg.int q_s 3 (by decide)
  have hq3_lt := mod_lt.int q_s 3 (by decide)
  have hpd := div_add_mod.int p_s 3
  have hqd := div_add_mod.int q_s 3
  set rp := p_s % 3
  set rq := q_s % 3
  set qp := p_s / 3
  set qq := q_s / 3
  have hpe : p_s = rp + 3 * qp := by linarith
  have hqe : q_s = rq + 3 * qq := by linarith
  have hmod3_zero : (shell13.Q13_poly rp rq) % 3 = 0
    have hdiff : int_dvd 3 (shell13.Q13_poly p_s q_s - shell13.Q13_poly rp rq)
      rw [hpe, hqe]
      unfold shell13.Q13_poly
      exact ⟨-52 * (5 * rp ^ 4 * qp + 30 * rp ^ 3 * qp ^ 2 + 90 * rp ^ 2 * qp ^ 3 + 135 * rp * qp ^ 4 + 81 * qp ^ 5) +
              104 * (4 * rp ^ 3 * qp * rq + 18 * rp ^ 2 * qp ^ 2 * rq + 36 * rp * qp ^ 3 * rq + 27 * qp ^ 4 * rq +
                     (rp + 3 * qp) ^ 4 * qq) -
              104 * (3 * rp ^ 2 * qp * rq ^ 2 + 9 * rp * qp ^ 2 * rq ^ 2 + 9 * qp ^ 3 * rq ^ 2 +
                     (rp + 3 * qp) ^ 3 * (2 * rq * qq + 3 * qq ^ 2)) +
              52 * (2 * rp * qp * rq ^ 3 + 3 * qp ^ 2 * rq ^ 3 +
                    (rp + 3 * qp) ^ 2 * (3 * rq ^ 2 * qq + 9 * rq * qq ^ 2 + 9 * qq ^ 3)) -
              12 * (qp * rq ^ 4 + (rp + 3 * qp) * (4 * rq ^ 3 * qq + 18 * rq ^ 2 * qq ^ 2 + 36 * rq * qq ^ 3 + 27 * qq ^ 4)) +
              (5 * rq ^ 4 * qq + 30 * rq ^ 3 * qq ^ 2 + 90 * rq ^ 2 * qq ^ 3 + 135 * rq * qq ^ 4 + 81 * qq ^ 5), by ring⟩
    obtain ⟨m, hm⟩ := hdiff
    rw [h0] at hm
    have heq_r : shell13.Q13_poly rp rq = 0 + 3 * (-m) := by linarith
    rw [heq_r, add_mul_mod.int 0 (-m) 3 (by decide)]; decide
  -- Exhaust all 9 cases (rp, rq) in {0, 1, 2}^2: ONLY (0, 0) gives 0 mod 3!
  have hboth0 : rp = 0 ∧ rq = 0
    have hcases : (rp = 0 ∨ rp = 1 ∨ rp = 2) ∧ (rq = 0 ∨ rq = 1 ∨ rq = 2) := by omega
    obtain ⟨hp0 | hp1 | hp2, hq0 | hq1 | hq2⟩ := hcases
    · exact ⟨hp0, hq0⟩
    · rw [hp0, hq1] at hmod3_zero; unfold shell13.Q13_poly at hmod3_zero; exfalso; revert hmod3_zero; decide
    · rw [hp0, hq2] at hmod3_zero; unfold shell13.Q13_poly at hmod3_zero; exfalso; revert hmod3_zero; decide
    · rw [hp1, hq0] at hmod3_zero; unfold shell13.Q13_poly at hmod3_zero; exfalso; revert hmod3_zero; decide
    · rw [hp1, hq1] at hmod3_zero; unfold shell13.Q13_poly at hmod3_zero; exfalso; revert hmod3_zero; decide
    · rw [hp1, hq2] at hmod3_zero; unfold shell13.Q13_poly at hmod3_zero; exfalso; revert hmod3_zero; decide
    · rw [hp2, hq0] at hmod3_zero; unfold shell13.Q13_poly at hmod3_zero; exfalso; revert hmod3_zero; decide
    · rw [hp2, hq1] at hmod3_zero; unfold shell13.Q13_poly at hmod3_zero; exfalso; revert hmod3_zero; decide
    · rw [hp2, hq2] at hmod3_zero; unfold shell13.Q13_poly at hmod3_zero; exfalso; revert hmod3_zero; decide
  have h3p : 3 ∣ nat_of_int (|p_s|)
    exact (cshell.dvd_iff_nat_abs 3 (by decide) p_s).mp ⟨qp, by rw [hpe, hboth0.1]; ring⟩
  have h3q : 3 ∣ nat_of_int q_s
    have h3q_abs := (cshell.dvd_iff_nat_abs 3 (by decide) q_s).mp ⟨qq, by rw [hqe, hboth0.2]; ring⟩
    have habs_q : |q_s| = q_s := by obtain ⟨e, _⟩ | ⟨_, h⟩ := abs_cases.int q_s <;> linarith
    rw [habs_q] at h3q_abs; exact h3q_abs
  unfold nat.coprime_primes at hcop
  exact hcop 3 is_prime_nat_three ⟨h3p, h3q⟩

-- THEOREM 2D (MOD-2 RESIDUE-DISK CLOSURE ON Q_13 — 0 CUSTOM AXIOMS!):
-- Every rational point on Q_13 has either 2 | p_s (disks (0,0)/(0,-1)) or 2 | q_s (disk infty);
-- NEVER both p_s and q_s odd (since RHS == 5 mod 8 while Y^2 in {0, 1, 4} mod 8)!
+ shell13.Q13_mod2_only_even_or_infty (p_s q_s Y : ℤ)
    (hcurve : Y ^ 2 = q_s * shell13.Q13_poly p_s q_s) :
    int_dvd 2 p_s ∨ int_dvd 2 q_s
  by_contra hboth_odd
  have hp_nd : ¬ int_dvd 2 p_s := by intro h; apply hboth_odd; left; exact h
  have hq_nd : ¬ int_dvd 2 q_s := by intro h; apply hboth_odd; right; exact h
  have hp_odd : p_s % 2 = 1
    have hnn := mod_nonneg.int p_s 2 (by decide)
    have hlt := mod_lt.int p_s 2 (by decide)
    by_contra hne1
    have h0 : p_s % 2 = 0 := by omega
    have hd := div_add_mod.int p_s 2
    exact hp_nd ⟨p_s / 2, by linarith⟩
  have hq_odd : q_s % 2 = 1
    have hnn := mod_nonneg.int q_s 2 (by decide)
    have hlt := mod_lt.int q_s 2 (by decide)
    by_contra hne1
    have h0 : q_s % 2 = 0 := by omega
    have hd := div_add_mod.int q_s 2
    exact hq_nd ⟨q_s / 2, by linarith⟩
  have hpd := div_add_mod.int p_s 2; rw [hp_odd] at hpd
  have hqd := div_add_mod.int q_s 2; rw [hq_odd] at hqd
  set a := p_s / 2; set b := q_s / 2
  have hpe : p_s = 1 + 2 * a := by linarith
  have hqe : q_s = 1 + 2 * b := by linarith
  -- Compute Y^2 mod 8 vs RHS mod 8!
  -- Actually mod 4 suffices?! Check RHS at (1, 1): -52+104-104+52-12+1 = -11 == 1 mod 4!
  -- Wait: mod 4 is 1 (a square!), so MOD 8 IS NEEDED (-11 == 5 mod 8, non-square mod 8)!
  have hRHS_mod8 : (q_s * shell13.Q13_poly p_s q_s) % 8 = 5
    have hpa : p_s = 1 + 2 * a := hpe
    have hqb : q_s = 1 + 2 * b := hqe
    -- Reduce a, b mod 4 so p_s, q_s are 1, 3, 5, 7 mod 8!
    have hpm8 := div_add_mod.int p_s 8
    have hqm8 := div_add_mod.int q_s 8
    set rp := p_s % 8; set rq := q_s % 8
    have hrp_nn := mod_nonneg.int p_s 8 (by decide)
    have hrp_lt := mod_lt.int p_s 8 (by decide)
    have hrq_nn := mod_nonneg.int q_s 8 (by decide)
    have hrq_lt := mod_lt.int q_s 8 (by decide)
    rw [← rp_def] at hrp_nn hrp_lt
    rw [← rq_def] at hrq_nn hrq_lt
    have hrp_odd : rp = 1 ∨ rp = 3 ∨ rp = 5 ∨ rp = 7
      have h2p : p_s = rp + 2 * (4 * (p_s / 8)) := by linarith
      have hm2 : rp % 2 = 1 := by rw [← add_mul_mod.int rp (4 * (p_s / 8)) 2 (by decide), ← h2p, hp_odd]
      have hd2 := div_add_mod.int rp 2; rw [hm2] at hd2
      set kp := rp / 2
      have hkp : kp = 0 ∨ kp = 1 ∨ kp = 2 ∨ kp = 3 := by omega
      obtain h0 | h1 | h2 | h3 := hkp <;> omega
    have hrq_odd : rq = 1 ∨ rq = 3 ∨ rq = 5 ∨ rq = 7
      have h2q : q_s = rq + 2 * (4 * (q_s / 8)) := by linarith
      have hm2 : rq % 2 = 1 := by rw [← add_mul_mod.int rq (4 * (q_s / 8)) 2 (by decide), ← h2q, hq_odd]
      have hd2 := div_add_mod.int rq 2; rw [hm2] at hd2
      set kq := rq / 2
      have hkq : kq = 0 ∨ kq = 1 ∨ kq = 2 ∨ kq = 3 := by omega
      obtain h0 | h1 | h2 | h3 := hkq <;> omega
    have hstep : ∃ m : ℤ, q_s * shell13.Q13_poly p_s q_s = rq * shell13.Q13_poly rp rq + 8 * m
      -- Since p_s = rp + 8*qp and q_s = rq + 8*qq, expanding gives a multiple of 8!
      set qp := p_s / 8; set qq := q_s / 8
      have hps8 : p_s = rp + 8 * qp := by linarith
      have hqs8 : q_s = rq + 8 * qq := by linarith
      -- First prove congruence mod 8 for each monomial via 8 | (p_s - rp) and 8 | (q_s - rq)!
      have hcongr : ∀ A1 A2 B1 B2 : ℤ, int_dvd 8 (A1 - A2) → int_dvd 8 (B1 - B2) → int_dvd 8 (A1 * B1 - A2 * B2)
        intro A1 A2 B1 B2 ⟨k1, hk1⟩ ⟨k2, hk2⟩
        have hA1 : A1 = A2 + ((8 : ℕ) : ℤ) * k1 := by linarith
        have hB1 : B1 = B2 + ((8 : ℕ) : ℤ) * k2 := by linarith
        exact ⟨k1 * B1 + A2 * k2, by rw [hA1, hB1]; ring⟩
      have hdp : int_dvd 8 (p_s - rp) := ⟨qp, by linarith⟩
      have hdq : int_dvd 8 (q_s - rq) := ⟨qq, by linarith⟩
      have hdp2 : int_dvd 8 (p_s ^ 2 - rp ^ 2) := by
        have h1 := hcongr p_s rp p_s rp hdp hdp; obtain ⟨k1, hk1⟩ := h1; exact ⟨k1, by linarith⟩
      have hdp3 : int_dvd 8 (p_s ^ 3 - rp ^ 3) := by
        have h1 := hcongr (p_s ^ 2) (rp ^ 2) p_s rp hdp2 hdp; obtain ⟨k1, hk1⟩ := h1; exact ⟨k1, by linarith⟩
      have hdp4 : int_dvd 8 (p_s ^ 4 - rp ^ 4) := by
        have h1 := hcongr (p_s ^ 3) (rp ^ 3) p_s rp hdp3 hdp; obtain ⟨k1, hk1⟩ := h1; exact ⟨k1, by linarith⟩
      have hdp5 : int_dvd 8 (p_s ^ 5 - rp ^ 5) := by
        have h1 := hcongr (p_s ^ 4) (rp ^ 4) p_s rp hdp4 hdp; obtain ⟨k1, hk1⟩ := h1; exact ⟨k1, by linarith⟩
      have hdq2 : int_dvd 8 (q_s ^ 2 - rq ^ 2) := by
        have h1 := hcongr q_s rq q_s rq hdq hdq; obtain ⟨k1, hk1⟩ := h1; exact ⟨k1, by linarith⟩
      have hdq3 : int_dvd 8 (q_s ^ 3 - rq ^ 3) := by
        have h1 := hcongr (q_s ^ 2) (rq ^ 2) q_s rq hdq2 hdq; obtain ⟨k1, hk1⟩ := h1; exact ⟨k1, by linarith⟩
      have hdq4 : int_dvd 8 (q_s ^ 4 - rq ^ 4) := by
        have h1 := hcongr (q_s ^ 3) (rq ^ 3) q_s rq hdq3 hdq; obtain ⟨k1, hk1⟩ := h1; exact ⟨k1, by linarith⟩
      have hdq5 : int_dvd 8 (q_s ^ 5 - rq ^ 5) := by
        have h1 := hcongr (q_s ^ 4) (rq ^ 4) q_s rq hdq4 hdq; obtain ⟨k1, hk1⟩ := h1; exact ⟨k1, by linarith⟩
      obtain ⟨k1, hk1⟩ := hcongr (p_s ^ 4) (rp ^ 4) q_s rq hdp4 hdq
      obtain ⟨k2, hk2⟩ := hcongr (p_s ^ 3) (rp ^ 3) (q_s ^ 2) (rq ^ 2) hdp3 hdq2
      obtain ⟨k3, hk3⟩ := hcongr (p_s ^ 2) (rp ^ 2) (q_s ^ 3) (rq ^ 3) hdp2 hdq3
      obtain ⟨k4, hk4⟩ := hcongr p_s rp (q_s ^ 4) (rq ^ 4) hdp hdq4
      obtain ⟨k5, hk5⟩ := hdp5
      obtain ⟨k6, hk6⟩ := hdq5
      have hd_poly : int_dvd 8 (shell13.Q13_poly p_s q_s - shell13.Q13_poly rp rq)
        unfold shell13.Q13_poly
        exact ⟨-52 * k5 + 104 * k1 - 104 * k2 + 52 * k3 - 12 * k4 + k6, by linarith⟩
      obtain ⟨km, hkm⟩ := hcongr q_s rq (shell13.Q13_poly p_s q_s) (shell13.Q13_poly rp rq) hdq hd_poly
      exact ⟨km, by linarith⟩
    obtain ⟨m, hm⟩ := hstep
    rw [hm, add_mul_mod.int (rq * shell13.Q13_poly rp rq) m 8 (by decide)]
    unfold shell13.Q13_poly
    obtain hpv | hpv | hpv | hpv := hrp_odd <;> (rw [hpv]; obtain hqv | hqv | hqv | hqv := hrq_odd <;> (rw [hqv]; decide))
  -- Meanwhile Y^2 % 8 in {0, 1, 4} != 5!
  have hY8_nn := mod_nonneg.int Y 8 (by decide)
  have hY8_lt := mod_lt.int Y 8 (by decide)
  have hYd := div_add_mod.int Y 8
  set rY := Y % 8; set qY := Y / 8
  have hYe : Y = rY + 8 * qY := by linarith
  have hYsq8 : Y ^ 2 % 8 = (rY ^ 2) % 8
    have hid : Y ^ 2 = rY ^ 2 + 8 * (2 * rY * qY + 8 * qY ^ 2) := by rw [hYe]; ring
    rw [hid, add_mul_mod.int (rY ^ 2) (2 * rY * qY + 8 * qY ^ 2) 8 (by decide)]
  rw [← hcurve, hYsq8] at hRHS_mod8
  have hrc : rY = 0 ∨ rY = 1 ∨ rY = 2 ∨ rY = 3 ∨ rY = 4 ∨ rY = 5 ∨ rY = 6 ∨ rY = 7 := by omega
  obtain h0 | h1 | h2 | h3 | h4 | h5 | h6 | h7 := hrc
  · rw [h0] at hRHS_mod8; revert hRHS_mod8; decide
  · rw [h1] at hRHS_mod8; revert hRHS_mod8; decide
  · rw [h2] at hRHS_mod8; revert hRHS_mod8; decide
  · rw [h3] at hRHS_mod8; revert hRHS_mod8; decide
  · rw [h4] at hRHS_mod8; revert hRHS_mod8; decide
  · rw [h5] at hRHS_mod8; revert hRHS_mod8; decide
  · rw [h6] at hRHS_mod8; revert hRHS_mod8; decide
  · rw [h7] at hRHS_mod8; revert hRHS_mod8; decide

-- ====================================================================================
-- 3. Closed-Form Single-Shell p = 7 Gram-Eigenvalue Rational Frey Curve E^+_{R,L}
--    and its D = -4 Twist E^+_{R,L}^{(-4)} (0 CUSTOM AXIOMS!)
-- ====================================================================================

-- Explicit integral Weierstrass curve over Q whose 2-torsion roots are the three K^+ = Q(cos(2pi/7))
-- eigenvalues x_k = eta_k * (R^2 + L^2) - sigma^2(eta_k) * R * L of the 7-sided shell Gram matrix:
-> shell13.gram_curve_p7 (R L : ℤ) : WeierstrassCurve :=
  WeierstrassCurve.mk
    0
    (R ^ 2 - R * L + L ^ 2)
    0
    (-(2 * R ^ 4 + 3 * R ^ 3 * L + 6 * R ^ 2 * L ^ 2 + 3 * R * L ^ 3 + 2 * L ^ 4))
    (-(R ^ 6 + 4 * R ^ 5 * L + 6 * R ^ 4 * L ^ 2 + 7 * R ^ 3 * L ^ 3 + 6 * R ^ 2 * L ^ 4 + 4 * R * L ^ 5 + L ^ 6))

-- Its D = -4 quadratic twist (drops conductor at ell = 2 to f_2 = 2, Kodaira IV, when 4 | R or 4 | L,
-- e.g. N(E^+_{1,0}^{(-4)}) = 196 = 2^2 * 7^2 vs. N(E^+_{1,0}) = 784 = 2^4 * 7^2!):
-> shell13.gram_curve_p7_twist_m4 (R L : ℤ) : WeierstrassCurve :=
  WeierstrassCurve.mk
    0
    (-(R ^ 2 - R * L + L ^ 2))
    0
    (-(2 * R ^ 4 + 3 * R ^ 3 * L + 6 * R ^ 2 * L ^ 2 + 3 * R * L ^ 3 + 2 * L ^ 4))
    (R ^ 6 + 4 * R ^ 5 * L + 6 * R ^ 4 * L ^ 2 + 7 * R ^ 3 * L ^ 3 + 6 * R ^ 2 * L ^ 4 + 4 * R * L ^ 5 + L ^ 6)

-- THEOREM 3A (EXACT WEIERSTRASS INVARIANTS OF E^+_{R,L} & E^+_{R,L}^{(-4)} — 0 CUSTOM AXIOMS!):
+ shell13.gram_curve_p7_invariants (R L : ℤ) :
    wc.c4 (shell13.gram_curve_p7 R L) = 112 * shell7.gram_f4 R L ∧
    wc.c6 (shell13.gram_curve_p7 R L) = 224 * shell7.gram_p6 R L ∧
    wc.disc (shell13.gram_curve_p7 R L) = 784 * (shell7.Q7 R L) ^ 2 ∧
    wc.c4 (shell13.gram_curve_p7_twist_m4 R L) = 112 * shell7.gram_f4 R L ∧
    wc.c6 (shell13.gram_curve_p7_twist_m4 R L) = -(224 * shell7.gram_p6 R L) ∧
    wc.disc (shell13.gram_curve_p7_twist_m4 R L) = 784 * (shell7.Q7 R L) ^ 2
  constructor
  · unfold shell13.gram_curve_p7 wc.c4 wc.b2 wc.b4 shell7.gram_f4; simp; ring
  · constructor
    · unfold shell13.gram_curve_p7 wc.c6 wc.b2 wc.b4 wc.b6 shell7.gram_p6; simp; ring
    · constructor
      · unfold shell13.gram_curve_p7 wc.disc wc.b2 wc.b4 wc.b6 wc.b8 shell7.Q7; simp; ring
      · constructor
        · unfold shell13.gram_curve_p7_twist_m4 wc.c4 wc.b2 wc.b4 shell7.gram_f4; simp; ring
        · constructor
          · unfold shell13.gram_curve_p7_twist_m4 wc.c6 wc.b2 wc.b4 wc.b6 shell7.gram_p6; simp; ring
          · unfold shell13.gram_curve_p7_twist_m4 wc.disc wc.b2 wc.b4 wc.b6 wc.b8 shell7.Q7; simp; ring

-- THEOREM 3B (SEMISTABILITY OF E^+_{R,L} OUTSIDE {2, 7} FOR ALL COPRIME (R, L) — 0 CUSTOM AXIOMS!):
-- For every prime ell not in {2, 7} and coprime integers (R, L), ell cannot divide both c_4(E^+_{R,L})
-- and Delta(E^+_{R,L}) = 784 * Q_7(R, L)^2. Hence E^+_{R,L} (and E^+_{R,L}^{(-4)}) has multiplicative
-- reduction at EVERY bad odd prime ell != 7 with v_ell(Delta) = 2 * v_ell(Q_7(R, L)), making it an
-- explicit rational Frey curve over Q for Generalized Fermat Equations x^7 + y^7 = d * z^p!
+ shell13.gram_curve_p7_semistable_away_14 (ell : ℕ) (hell : is_prime_nat ell)
    (hne2 : ell ≠ 2) (hne7 : ell ≠ 7) (R L : ℤ)
    (hcop : nat.coprime_primes (nat_of_int (|R|)) (nat_of_int (|L|)))
    (hc4 : int_dvd ell (wc.c4 (shell13.gram_curve_p7 R L)))
    (hdisc : int_dvd ell (wc.disc (shell13.gram_curve_p7 R L))) : False
  have hinv := shell13.gram_curve_p7_invariants R L
  rw [hinv.1] at hc4
  rw [hinv.2.2.1] at hdisc
  have hell_pos : 0 < ell := by linarith [hell.1]
  have hell_pr := is_prime_nat.to_prime ell hell
  -- From ell | 112 * f4 = 2^4 * 7 * f4 and ell != 2, ell != 7, deduce ell | f4!
  have hf4 : int_dvd ell (shell7.gram_f4 R L)
    have hnat := (cshell.dvd_iff_nat_abs ell hell_pos (112 * shell7.gram_f4 R L)).mp hc4
    have habs : nat_of_int (|112 * shell7.gram_f4 R L|) = 112 * nat_of_int (|shell7.gram_f4 R L|)
      apply (cast_inj.int (nat_of_int (|112 * shell7.gram_f4 R L|)) (112 * nat_of_int (|shell7.gram_f4 R L|))).mp
      rw [int_of_nat_of_int (|112 * shell7.gram_f4 R L|) (abs_nonneg.int (112 * shell7.gram_f4 R L)),
          cast_mul.int, int_of_nat_of_int (|shell7.gram_f4 R L|) (abs_nonneg.int (shell7.gram_f4 R L)), int.abs_mul_eq]
      have h112a : |(112 : ℤ)| = 112 := by decide
      have h112c : ((112 : ℕ) : ℤ) = 112 := by decide
      rw [h112a, h112c]
    rw [habs] at hnat
    obtain h112 | hf := hell.2 112 (nat_of_int (|shell7.gram_f4 R L|)) hnat
    · exfalso
      have hfac : 112 = 2 ^ 4 * 7 := by decide
      rw [hfac] at h112
      obtain h2p | h7p := hell.2 (2 ^ 4) 7 h112
      · have h2 := prime_dvd_of_dvd_pow.nat ell 2 4 hell_pr h2p
        obtain h1 | h2e := (is_prime_nat.to_full 2 is_prime_nat_two).2 ell h2
        · linarith [hell.1]
        · exact hne2 h2e
      · obtain h1 | h7e := (is_prime_nat.to_full 7 is_prime_nat_seven).2 ell h7p
        · linarith [hell.1]
        · exact hne7 h7e
    · exact (cshell.dvd_iff_nat_abs ell hell_pos (shell7.gram_f4 R L)).mpr hf
  -- From ell | 784 * Q7^2 = 2^4 * 7^2 * Q7^2 and ell != 2, ell != 7, deduce ell | Q7!
  have hQ7 : int_dvd ell (shell7.Q7 R L)
    have hnat := (cshell.dvd_iff_nat_abs ell hell_pos (784 * (shell7.Q7 R L) ^ 2)).mp hdisc
    have habs : nat_of_int (|784 * (shell7.Q7 R L) ^ 2|) = 784 * nat_of_int (|shell7.Q7 R L|) ^ 2
      apply (cast_inj.int (nat_of_int (|784 * (shell7.Q7 R L) ^ 2|)) (784 * nat_of_int (|shell7.Q7 R L|) ^ 2)).mp
      rw [int_of_nat_of_int (|784 * (shell7.Q7 R L) ^ 2|) (abs_nonneg.int (784 * (shell7.Q7 R L) ^ 2)),
          cast_mul.int, cast_pow.int, int_of_nat_of_int (|shell7.Q7 R L|) (abs_nonneg.int (shell7.Q7 R L)),
          int.abs_mul_eq, int.abs_pow_eq 2 (shell7.Q7 R L)]
      have h784a : |(784 : ℤ)| = 784 := by decide
      have h784c : ((784 : ℕ) : ℤ) = 784 := by decide
      rw [h784a, h784c]
    rw [habs] at hnat
    obtain h784 | hQsq := hell.2 784 (nat_of_int (|shell7.Q7 R L|) ^ 2) hnat
    · exfalso
      have hfac : 784 = 2 ^ 4 * 7 ^ 2 := by decide
      rw [hfac] at h784
      obtain h2p | h7p := hell.2 (2 ^ 4) (7 ^ 2) h784
      · have h2 := prime_dvd_of_dvd_pow.nat ell 2 4 hell_pr h2p
        obtain h1 | h2e := (is_prime_nat.to_full 2 is_prime_nat_two).2 ell h2
        · linarith [hell.1]
        · exact hne2 h2e
      · have h7 := prime_dvd_of_dvd_pow.nat ell 7 2 hell_pr h7p
        obtain h1 | h7e := (is_prime_nat.to_full 7 is_prime_nat_seven).2 ell h7
        · linarith [hell.1]
        · exact hne7 h7e
    · exact (cshell.dvd_iff_nat_abs ell hell_pos (shell7.Q7 R L)).mpr (prime_dvd_of_dvd_pow.nat ell (nat_of_int (|shell7.Q7 R L|)) 2 hell_pr hQsq)
  obtain ⟨hR, hL⟩ := shell7.gram_f4_coprime_Q7_away_from_7 ell hell hne7 R L hf4 hQ7
  unfold nat.coprime_primes at hcop
  exact hcop ell hell ⟨(cshell.dvd_iff_nat_abs ell hell_pos R).mp hR, (cshell.dvd_iff_nat_abs ell hell_pos L).mp hL⟩

-- ====================================================================================
-- 4. Exact Frey Split-Reduction Character Law & Zero-Mazur Mod-8 Irreducibility
-- ====================================================================================

-- THEOREM 4A (EXACT FREY c_6 SPLIT-REDUCTION POLYNOMIAL IDENTITIES — 0 CUSTOM AXIOMS!):
-- For any Hellegouarch-Frey curve `frey.curve u v A` with A + B + C = 0, A = 4u + 1, C = 16v:
--   2 * (-c_6 - A * c_4) = C * (A^2 - 5*A*C - 2*C^2),
--   2 * (-c_6 - B * c_4) = A * (4*A^2 + 7*A*C + C^2),
--   2 * (-c_6 + A * c_4) = -B * (4*A^2 + A*C - 2*C^2).
+ shell13.frey_c6_split_identities (A B C u v : ℤ)
    (hsum : A + B + C = 0) (hA : A = 4 * u + 1) (hC : C = 16 * v) :
    2 * (-wc.c6 (frey.curve u v A) - A * wc.c4 (frey.curve u v A)) = C * (A ^ 2 - 5 * A * C - 2 * C ^ 2) ∧
    2 * (-wc.c6 (frey.curve u v A) - B * wc.c4 (frey.curve u v A)) = A * (4 * A ^ 2 + 7 * A * C + C ^ 2) ∧
    2 * (-wc.c6 (frey.curve u v A) + A * wc.c4 (frey.curve u v A)) = -B * (4 * A ^ 2 + A * C - 2 * C ^ 2)
  have hinv := frey.curve_invariants A B C u v hsum hA hC
  have hB : B = -(A + C) := by linarith
  constructor
  · rw [hinv.1]
    have hc6 := hinv.2.1
    rw [hB] at hc6
    linarith [hc6]
  · constructor
    · rw [hinv.1]
      have hc6 := hinv.2.1
      rw [hB] at hc6 ⊢
      linarith [hc6]
    · rw [hinv.1]
      have hc6 := hinv.2.1
      rw [hB] at hc6 ⊢
      linarith [hc6]

-- Helper: for an odd prime ell, ell | 2*X => ell | X
+ shell13.odd_prime_cancel_two (ell : ℕ) (hell : is_prime_nat ell) (hell3 : 3 ≤ ell) (X : ℤ)
    (hd : int_dvd ell (2 * X)) : int_dvd ell X
  have hell_pos : 0 < ell := by omega
  have hnat := (cshell.dvd_iff_nat_abs ell hell_pos (2 * X)).mp hd
  have habs : nat_of_int (|2 * X|) = 2 * nat_of_int (|X|)
    apply (cast_inj.int (nat_of_int (|2 * X|)) (2 * nat_of_int (|X|))).mp
    rw [int_of_nat_of_int (|2 * X|) (abs_nonneg.int (2 * X)), cast_mul.int,
        int_of_nat_of_int (|X|) (abs_nonneg.int X), int.abs_mul_eq]
    have h2a : |(2 : ℤ)| = 2 := by decide
    have h2c : ((2 : ℕ) : ℤ) = 2 := by decide
    rw [h2a, h2c]
  rw [habs] at hnat
  obtain h2 | hX := hell.2 2 (nat_of_int (|X|)) hnat
  · exfalso
    obtain h1 | h2e := (is_prime_nat.to_full 2 is_prime_nat_two).2 ell h2 <;> omega
  · exact (cshell.dvd_iff_nat_abs ell hell_pos X).mpr hX

-- THEOREM 4B (EXACT SPLIT-REDUCTION CHARACTER CONGRUENCES AT EVERY ODD PRIME ell — 0 CUSTOM AXIOMS!):
-- At every odd prime ell | A*B*C, the Tate split-reduction invariant (-c_6 / c_4) mod ell equals:
--   A (mod ell) when ell | C,
--   B (mod ell) when ell | A,
--  -A (mod ell) when ell | B!
-- Therefore reduction at ell is SPLIT iff the Legendre symbol (A/ell), (B/ell), or (-A/ell) is +1!
+ shell13.frey_split_char_mod_odd_prime (ell : ℕ) (hell : is_prime_nat ell) (hell3 : 3 ≤ ell)
    (A B C u v : ℤ) (hsum : A + B + C = 0) (hA : A = 4 * u + 1) (hC : C = 16 * v) :
    (int_dvd ell C → int_dvd ell (-wc.c6 (frey.curve u v A) - A * wc.c4 (frey.curve u v A))) ∧
    (int_dvd ell A → int_dvd ell (-wc.c6 (frey.curve u v A) - B * wc.c4 (frey.curve u v A))) ∧
    (int_dvd ell B → int_dvd ell (-wc.c6 (frey.curve u v A) + A * wc.c4 (frey.curve u v A)))
  have hid := shell13.frey_c6_split_identities A B C u v hsum hA hC
  constructor
  · intro hC_d
    apply shell13.odd_prime_cancel_two ell hell hell3
    rw [hid.1]
    obtain ⟨q, hq⟩ := hC_d
    exact ⟨q * (A ^ 2 - 5 * A * C - 2 * C ^ 2), by rw [hq]; ring⟩
  · constructor
    · intro hA_d
      apply shell13.odd_prime_cancel_two ell hell hell3
      rw [hid.2.1]
      obtain ⟨q, hq⟩ := hA_d
      exact ⟨q * (4 * A ^ 2 + 7 * A * C + C ^ 2), by rw [hq]; ring⟩
    · intro hB_d
      apply shell13.odd_prime_cancel_two ell hell hell3
      rw [hid.2.2]
      obtain ⟨q, hq⟩ := hB_d
      exact ⟨-q * (4 * A ^ 2 + A * C - 2 * C ^ 2), by rw [hq]; ring⟩

-- Helper: for any odd integer a and any odd natural p, a^p == a (mod 8)!
+ shell13.odd_sq_mod8 (a : ℤ) (ha_odd : a % 2 = 1) : ∃ q : ℤ, a ^ 2 = 1 + 8 * q
  have had := div_add_mod.int a 2; rw [ha_odd] at had
  set k := a / 2
  have hae : a = 1 + 2 * k := by linarith
  have hk_ev_or_odd : k % 2 = 0 ∨ k % 2 = 1
    have hnn := mod_nonneg.int k 2 (by decide)
    have hlt := mod_lt.int k 2 (by decide)
    omega
  have hkd := div_add_mod.int k 2
  obtain h0 | h1 := hk_ev_or_odd
  · set m := k / 2
    have hke : k = 2 * m := by linarith
    exact ⟨m + 2 * m ^ 2, by rw [hae, hke]; ring⟩
  · set m := k / 2
    have hke : k = 1 + 2 * m := by linarith
    exact ⟨1 + 3 * m + 2 * m ^ 2, by rw [hae, hke]; ring⟩

+ shell13.odd_pow_mod8 (m : ℕ) (a : ℤ) (ha_odd : a % 2 = 1) :
    ∃ q : ℤ, a ^ (2 * m + 1) = a + 8 * q
  induction m with j ihj
  · have h1 : 2 * 0 + 1 = 1 := by decide
    rw [h1]; exact ⟨0, by ring⟩
  · obtain ⟨q1, hq1⟩ := ihj
    obtain ⟨q2, hq2⟩ := shell13.odd_sq_mod8 a ha_odd
    have hexp : 2 * (j + 1) + 1 = (2 * j + 1) + 2 := by omega
    rw [succ_eq_add_one.nat, hexp, shell13.int_pow_add a (2 * j + 1) 2, hq1, hq2]
    exact ⟨a * q2 + q1 + 8 * q1 * q2, by ring⟩

-- THEOREM 4C (ZERO-MAZUR MOD-8 NON-SPLIT AT ell = 2 — 0 CUSTOM AXIOMS!):
-- For ANY odd prime p >= 5 and ANY normalized Hellegouarch-Frey curve `frey.curve u v (a^p)`
-- with a^p = 4*u + 1, c^p = 16*v, v % 2 = 0:
--   if a % 8 = 3 or a % 8 = 5 (equivalently a is odd and a % 8 != 1 and a % 8 != 7),
--   then u % 2 = 1, so the Frey curve has NON-SPLIT multiplicative reduction at ell = 2
--   (`frey.mod2_nonsplit_tangent_cone`), where p nmid 2*(2 + 1) = 6 (`frey.nonsplit_odd_or_two_kills_p`)!
+ shell13.frey_pm3_mod8_forces_u_odd (p : ℕ) (hp : is_prime_nat p) (hp5 : 5 ≤ p)
    (a u v : ℤ) (hA : a ^ p = 4 * u + 1) (hv : v % 2 = 0)
    (hpm3 : a % 8 = 3 ∨ a % 8 = 5) :
    u % 2 = 1 ∧
    ((frey.curve u v (a ^ p)).a1 % 2 = 1 ∧
     (frey.curve u v (a ^ p)).a2 % 2 = 1 ∧
     (frey.curve u v (a ^ p)).a4 % 2 = 0 ∧
     (∀ x < 2, ∀ y < 2, (y * y + x * y + x * x) % 2 = 0 → x = 0 ∧ y = 0)) ∧
    ¬ (p ∣ (2 * (2 + 1)))
  have hp_odd : p % 2 = 1
    by_contra hev; have hp0 : p % 2 = 0 := by omega
    obtain ⟨k, hk⟩ := (dvd.iff_exists 2 p (by decide)).mp hp0
    obtain h1 | h2 := (is_prime_nat.to_full p hp).2 2 ((dvd.iff_exists 2 p (by decide)).mpr ⟨k, hk⟩) <;> omega
  have hpe : p = 2 * (p / 2) + 1 := by have hd := div_add_mod.nat p 2; omega
  have ha_odd : a % 2 = 1
    have had := div_add_mod.int a 8
    obtain h3 | h5 := hpm3
    · have hae : a = 1 + 2 * (1 + 4 * (a / 8)) := by linarith
      rw [hae, add_mul_mod.int 1 (1 + 4 * (a / 8)) 2 (by decide)]; decide
    · have hae : a = 1 + 2 * (2 + 4 * (a / 8)) := by linarith
      rw [hae, add_mul_mod.int 1 (2 + 4 * (a / 8)) 2 (by decide)]; decide
  obtain ⟨q, hq⟩ := shell13.odd_pow_mod8 (p / 2) a ha_odd
  rw [← hpe, hA] at hq
  -- From 4*u + 1 = a + 8*q, check a % 8 = 3 is impossible (mod 4) and a % 8 = 5 forces u % 2 = 1!
  have had := div_add_mod.int a 8
  have hu_odd : u % 2 = 1
    obtain h3 | h5 := hpm3
    · exfalso
      set m := u - 2 * (a / 8) - 2 * q
      have hbad : 0 + 4 * m = 2 := by linarith
      have hm : (0 + 4 * m) % 4 = (2 : ℤ) % 4 := by rw [hbad]
      rw [add_mul_mod.int 0 m 4 (by decide)] at hm
      revert hm; decide
    · have hue : u = 1 + 2 * (a / 8 + q) := by linarith
      rw [hue, add_mul_mod.int 1 (a / 8 + q) 2 (by decide)]; decide
  exact ⟨hu_odd, frey.mod2_nonsplit_tangent_cone u v (a ^ p) hu_odd hv,
         frey.nonsplit_odd_or_two_kills_p p 2 hp hp5 (by left; rfl)⟩

-- THEOREM 4D (MOD-8 SPLIT-AT-2 RESIDUAL LOCUS FOR ALL POSITIVE PRIMITIVE TRIPLES — 0 CUSTOM AXIOMS!):
-- For ANY odd prime p >= 5 and ANY pairwise-coprime triple x^p + y^p + z^p = 0,
-- if ANY odd member w in {x, y, z} satisfies w % 8 = 3 or w % 8 = 5, then the Hellegouarch-Frey
-- normalization ALWAYS yields u % 2 = 1 (non-split multiplicative reduction at ell = 2)!
-- Contrapositively: if the normalized Frey curve is SPLIT at ell = 2 (u % 2 = 0), then EVERY
-- odd member w in {x, y, z} MUST satisfy w % 8 = 1 or w % 8 = 7 (eliminating 50% of Case-II)!
+ shell13.split_at_2_forces_odd_pm1_mod8 (p : ℕ) (hp : is_prime_nat p) (hp5 : 5 ≤ p)
    (a b c u v : ℤ) (hsum : a ^ p + b ^ p + c ^ p = 0)
    (hA : a ^ p = 4 * u + 1) (hC : c ^ p = 16 * v) (hu_ev : u % 2 = 0) :
    (a % 8 = 1) ∧ (b % 8 = 7)
  have hp_odd : p % 2 = 1
    by_contra hev; have hp0 : p % 2 = 0 := by omega
    obtain ⟨k, hk⟩ := (dvd.iff_exists 2 p (by decide)).mp hp0
    obtain h1 | h2 := (is_prime_nat.to_full p hp).2 2 ((dvd.iff_exists 2 p (by decide)).mpr ⟨k, hk⟩) <;> omega
  have hpe : p = 2 * (p / 2) + 1 := by have hd := div_add_mod.nat p 2; omega
  have ha_odd : a % 2 = 1
    by_contra hne
    have hnn := mod_nonneg.int a 2 (by decide)
    have hlt := mod_lt.int a 2 (by decide)
    have h0 : a % 2 = 0 := by omega
    have had := div_add_mod.int a 2; rw [h0] at had
    set qa0 := a / 2
    have hae : a = 2 * qa0 := by linarith
    have hpe1 : p = (p - 1) + 1 := by omega
    have hap_ev : a ^ p = 0 + 2 * (qa0 * a ^ (p - 1))
      calc a ^ p = a ^ ((p - 1) + 1) := by rw [← hpe1]
        _ = a ^ (p - 1) * a := pow_succ.int a (p - 1)
        _ = a ^ (p - 1) * (2 * qa0) := by rw [hae]
        _ = 0 + 2 * (qa0 * a ^ (p - 1)) := by ring
    have hm : (0 + 2 * (qa0 * a ^ (p - 1))) % 2 = (1 + 2 * (2 * u)) % 2
      have he : 4 * u + 1 = 1 + 2 * (2 * u) := by ring
      rw [← hap_ev, hA, he]
    rw [add_mul_mod.int 0 (qa0 * a ^ (p - 1)) 2 (by decide),
        add_mul_mod.int 1 (2 * u) 2 (by decide)] at hm
    revert hm; decide
  have hb_odd : b % 2 = 1
    by_contra hne
    have hnn := mod_nonneg.int b 2 (by decide)
    have hlt := mod_lt.int b 2 (by decide)
    have h0 : b % 2 = 0 := by omega
    have hbd := div_add_mod.int b 2; rw [h0] at hbd
    set qb0 := b / 2
    have hbe : b = 2 * qb0 := by linarith
    have hpe1 : p = (p - 1) + 1 := by omega
    have hbp_ev : b ^ p = 2 * (qb0 * b ^ (p - 1))
      calc b ^ p = b ^ ((p - 1) + 1) := by rw [← hpe1]
        _ = b ^ (p - 1) * b := pow_succ.int b (p - 1)
        _ = b ^ (p - 1) * (2 * qb0) := by rw [hbe]
        _ = 2 * (qb0 * b ^ (p - 1)) := by ring
    have hsum2 : (1 + 2 * (2 * u + qb0 * b ^ (p - 1) + 8 * v)) = 0 := by linarith
    have hm : (1 + 2 * (2 * u + qb0 * b ^ (p - 1) + 8 * v)) % 2 = (0 : ℤ) % 2 := by rw [hsum2]
    rw [add_mul_mod.int 1 (2 * u + qb0 * b ^ (p - 1) + 8 * v) 2 (by decide)] at hm
    revert hm; decide
  obtain ⟨qa, hqa⟩ := shell13.odd_pow_mod8 (p / 2) a ha_odd
  obtain ⟨qb, hqb⟩ := shell13.odd_pow_mod8 (p / 2) b hb_odd
  rw [← hpe] at hqa hqb
  have hud := div_add_mod.int u 2; rw [hu_ev] at hud
  have hue : u = 2 * (u / 2) := by linarith
  have ha_mod8 : a % 8 = 1
    have hae : a = 1 + 8 * (u / 2 - qa) := by linarith
    rw [hae, add_mul_mod.int 1 (u / 2 - qa) 8 (by decide)]; decide
  have hb_mod8 : b % 8 = 7
    have hbe : b = 7 + 8 * (-1 - u / 2 - 2 * v - qb) := by linarith
    rw [hbe, add_mul_mod.int 7 (-1 - u / 2 - 2 * v - qb) 8 (by decide)]; decide
  exact ⟨ha_mod8, hb_mod8⟩

-- Audit: verify ZERO custom axioms across all exported theorems in shell_thirteen.sat!
#axioms shell13.cyclic_shell_identity
#axioms shell13.H3_A3_decomp
#axioms shell13.deg13_to_H4
#axioms shell13.H4_A3_identities
#axioms shell13.no_e1_zero
#axioms shell13.no_s_eq_one
#axioms shell13.no_s_eq_zero
#axioms shell13.H4_nonzero_implies_Q13_nonzero_s
#axioms shell13.flt13_implies_Q13_nonzero_s
#axioms shell13.Q13_no_rational_weierstrass_root
#axioms shell13.Q13_mod2_only_even_or_infty
#axioms shell13.gram_curve_p7_invariants
#axioms shell13.gram_curve_p7_semistable_away_14
#axioms shell13.frey_c6_split_identities
#axioms shell13.frey_split_char_mod_odd_prime
#axioms shell13.frey_pm3_mod8_forces_u_odd
#axioms shell13.split_at_2_forces_odd_pm1_mod8
