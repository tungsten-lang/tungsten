-- Finite sums of squares and positive-weight zero detectors.
import sum_support

+ list_sum.squares_nonneg.real (xs : list α) (f : α → ℝ) : 0 ≤ sum_list xs (fun x => f x * f x)
  apply sum_list_nonneg.real
  intro x hx
  nlinarith

+ list_sum.squares_eq_zero_iff.real (xs : list α) (f : α → ℝ) :
    sum_list xs (fun x => f x * f x) = 0 ↔ ∀ x ∈ xs, f x = 0
  constructor
  · intro total
    have zero := (list_sum.eq_zero_iff.real xs (fun x => f x * f x) (by intro x hx; nlinarith)).mp total
    intro x hx
    have h := zero x hx
    nlinarith
  · intro zero
    apply list_sum.eq_zero.real
    intro x hx
    rw [zero x hx]
    simp

+ list_sum.weighted_squares_nonneg.real (xs : list α) (w f : α → ℝ) (nonneg : ∀ x ∈ xs, 0 ≤ w x) :
    0 ≤ sum_list xs (fun x => w x * (f x * f x))
  apply sum_list_nonneg.real
  intro x hx
  exact mul_nonneg.real (w x) (f x * f x) (nonneg x hx) (by nlinarith)

+ list_sum.weighted_squares_eq_zero_iff.real (xs : list α) (w f : α → ℝ) (positive : ∀ x ∈ xs, 0 < w x) :
    sum_list xs (fun x => w x * (f x * f x)) = 0 ↔ ∀ x ∈ xs, f x = 0
  constructor
  · intro total
    have zero := (list_sum.eq_zero_iff.real xs (fun x => w x * (f x * f x)) (by intro x hx; exact mul_nonneg.real (w x) (f x * f x) (by have h := positive x hx; linarith) (by nlinarith))).mp total
    intro x hx
    have hp := positive x hx
    have hz := zero x hx
    have square : f x * f x = 0 := by nlinarith
    nlinarith
  · intro zero
    apply list_sum.eq_zero.real
    intro x hx
    rw [zero x hx]
    simp

