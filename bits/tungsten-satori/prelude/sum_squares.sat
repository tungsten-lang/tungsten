+ list_sum.squares_nonneg.nat (xs : list α) (f : α → ℕ) : 0 ≤ sum_list xs (fun x => f x * f x)
  exact zero_le.nat (sum_list xs (fun x => f x * f x))

+ list_sum.squares_eq_zero_iff.nat (xs : list α) (f : α → ℕ) :
    sum_list xs (fun x => f x * f x) = 0 ↔ ∀ x ∈ xs, f x = 0
  constructor
  · intro total
    have zero := (list_sum.eq_zero_iff.nat xs (fun x => f x * f x)).mp total
    intro x hx
    simpa using (mul_eq_zero.nat (f x) (f x)).mp (zero x hx)
  · intro zero
    apply list_sum.eq_zero.nat
    intro x hx
    rw [zero x hx]
    simp

+ list_sum.weighted_squares_nonneg.nat (xs : list α) (w f : α → ℕ) :
    0 ≤ sum_list xs (fun x => w x * (f x * f x))
  exact zero_le.nat (sum_list xs (fun x => w x * (f x * f x)))

+ list_sum.weighted_squares_eq_zero_iff.nat (xs : list α) (w f : α → ℕ) (positive : ∀ x ∈ xs, 0 < w x) :
    sum_list xs (fun x => w x * (f x * f x)) = 0 ↔ ∀ x ∈ xs, f x = 0
  constructor
  · intro total
    have zero := (list_sum.eq_zero_iff.nat xs (fun x => w x * (f x * f x))).mp total
    intro x hx
    obtain weight | square := (mul_eq_zero.nat (w x) (f x * f x)).mp (zero x hx)
    · have hp := positive x hx
      exfalso
      linarith
    · simpa using (mul_eq_zero.nat (f x) (f x)).mp square
  · intro zero
    apply list_sum.eq_zero.nat
    intro x hx
    rw [zero x hx]
    simp
