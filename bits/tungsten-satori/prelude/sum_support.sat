+ sum_below.eq_zero_iff.nat (f : ℕ → ℕ) (n : ℕ) :
    (∑ i < n, f i) = 0 ↔ ∀ i < n, f i = 0
  constructor
  · intro total i hi
    have bound := single_le_sum.nat f n i (by intro i hi; exact zero_le.nat (f i)) hi
    linarith
  · exact sum_below.eq_zero.nat f n

+ sum_below.pos_iff.nat (f : ℕ → ℕ) (n : ℕ) :
    0 < (∑ i < n, f i) ↔ ∃ i < n, 0 < f i
  constructor
  · intro total
    by_contra missing
    have zero : ∀ i < n, f i = 0
      intro i hi
      have hn : ¬ 0 < f i
        intro hp
        apply missing
        use i
        exact ⟨hi, hp⟩
      linarith
    have hs := sum_below.eq_zero.nat f n zero
    linarith
  · intro positive
    obtain ⟨i, hi, hp⟩ := positive
    have bound := single_le_sum.nat f n i (by intro i hi; exact zero_le.nat (f i)) hi
    linarith

+ sum_below.pos.nat (f : ℕ → ℕ) (n : ℕ) (nonempty : 0 < n) (positive : ∀ i < n, 0 < f i) : 0 < (∑ i < n, f i)
  exact (sum_below.pos_iff.nat f n).mpr ⟨0, nonempty, positive 0 nonempty⟩

