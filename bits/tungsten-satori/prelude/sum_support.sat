-- Vanishing and positivity of finite sums. Sign hypotheses are local to the index set.
import sum_range
import list_sum

+ sum_below.eq_zero_iff.real (f : ℕ → ℝ) (n : ℕ) (nonneg : ∀ i < n, 0 ≤ f i) :
    (∑ i < n, f i) = 0 ↔ ∀ i < n, f i = 0
  constructor
  · intro total i hi
    have bound := single_le_sum.real f n i nonneg hi
    have h0 := nonneg i hi
    linarith
  · exact sum_below.eq_zero.real f n

+ sum_below.pos_iff.real (f : ℕ → ℝ) (n : ℕ) (nonneg : ∀ i < n, 0 ≤ f i) :
    0 < (∑ i < n, f i) ↔ ∃ i < n, 0 < f i
  constructor
  · intro total
    by_contra missing
    have zero : ∀ i < n, f i = 0
      intro i hi
      have hn : ¬ 0 < f i
        intro hp
        apply missing
        use i
        exact ⟨hi, hp⟩
      have h0 := nonneg i hi
      linarith
    have hs := sum_below.eq_zero.real f n zero
    linarith
  · intro positive
    obtain ⟨i, hi, hp⟩ := positive
    have bound := single_le_sum.real f n i nonneg hi
    linarith

+ sum_below.pos.real (f : ℕ → ℝ) (n : ℕ) (nonempty : 0 < n) (positive : ∀ i < n, 0 < f i) : 0 < (∑ i < n, f i)
  exact (sum_below.pos_iff.real f n (by intro i hi; have h0 := positive i hi; linarith)).mpr ⟨0, nonempty, positive 0 nonempty⟩

+ list_sum.eq_zero.real (xs : list α) (f : α → ℝ) (zero : ∀ x ∈ xs, f x = 0) : sum_list xs f = 0
  induction xs with h x xs ih h
  · rfl
  · have head := h x (by simp)
    have tail : ∀ y ∈ xs, f y = 0 := by intro y hy; exact h y (by simp [hy])
    simp [sum_list, head, ih tail]

+ list_sum.eq_zero_iff.real (xs : list α) (f : α → ℝ) (nonneg : ∀ x ∈ xs, 0 ≤ f x) :
    sum_list xs f = 0 ↔ ∀ x ∈ xs, f x = 0
  constructor
  · intro total x hx
    have bound := sum_list_member_le.real xs f x hx nonneg
    have h0 := nonneg x hx
    linarith
  · exact list_sum.eq_zero.real xs f

+ list_sum.pos_iff.real (xs : list α) (f : α → ℝ) (nonneg : ∀ x ∈ xs, 0 ≤ f x) :
    0 < sum_list xs f ↔ ∃ x ∈ xs, 0 < f x
  constructor
  · intro total
    by_contra missing
    have zero : ∀ x ∈ xs, f x = 0
      intro x hx
      have hn : ¬ 0 < f x
        intro hp
        apply missing
        use x
        exact ⟨hx, hp⟩
      have h0 := nonneg x hx
      linarith
    have hs := list_sum.eq_zero.real xs f zero
    linarith
  · intro positive
    obtain ⟨x, hx, hp⟩ := positive
    have bound := sum_list_member_le.real xs f x hx nonneg
    linarith

