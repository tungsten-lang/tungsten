import recurrence

+ real_negative_rate (f : ℕ → ℝ) (n : ℕ) (step : ∀ i, f (i + 1) = (-2) * f i + (-9)) : f n = (f 0 + 3) * (-2) ^ n - 3
  exact recurrence.affine_closed.real f (-2) (-9) 3 (by decide) step n
+ real_zero_rate (f : ℕ → ℝ) (n : ℕ) (step : ∀ i, f (i + 1) = 0 * f i + (-3)) : f n = (f 0 + 3) * 0 ^ n - 3
  exact recurrence.affine_closed.real f 0 (-3) 3 (by decide) step n
+ real_unit_rate (f : ℕ → ℝ) (A : ℝ) (n : ℕ) (step : ∀ i, f (i + 1) = 1 * f i + 0) : f n = (f 0 + A) * 1 ^ n - A
  exact recurrence.affine_closed.real f 1 0 A (by ring) step n
+ real_nonzero_initial (f : ℕ → ℝ) (n : ℕ) (base : f 0 = 7) (step : ∀ i, f (i + 1) = 2 * f i + 3) : f n = 10 * 2 ^ n - 3
  rw [recurrence.affine_closed.real f 2 3 3 (by decide) step n, base]
  ring
+ real_zero_scale (f : ℕ → ℝ) (r c : ℝ) (n : ℕ) (step : ∀ i, f (i + 1) = r * f i + c) : 0 * f n + 0 = (0 * f 0 + 0) * r ^ n
  exact recurrence.affine_transform.real f r c 0 0 (by ring) step n
+ real_zero_initial (f : ℕ → ℝ) (n : ℕ) (base : f 0 = 0) (step : ∀ i, f (i + 1) = (-2) * f i + (-9)) : f n = ((-2) ^ n - 1) * 3
  exact recurrence.affine_zero.real f (-2) (-9) 3 base (by decide) step n

+ rat_negative_rate (f : ℕ → ℚ) (n : ℕ) (step : ∀ i, f (i + 1) = (-2) * f i + (-9)) : f n = (f 0 + 3) * (-2) ^ n - 3
  exact recurrence.affine_closed.rat f (-2) (-9) 3 (by decide) step n
+ rat_zero_rate (f : ℕ → ℚ) (n : ℕ) (step : ∀ i, f (i + 1) = 0 * f i + (-3)) : f n = (f 0 + 3) * 0 ^ n - 3
  exact recurrence.affine_closed.rat f 0 (-3) 3 (by decide) step n
+ rat_unit_rate (f : ℕ → ℚ) (A : ℚ) (n : ℕ) (step : ∀ i, f (i + 1) = 1 * f i + 0) : f n = (f 0 + A) * 1 ^ n - A
  exact recurrence.affine_closed.rat f 1 0 A (by ring) step n
+ rat_nonzero_initial (f : ℕ → ℚ) (n : ℕ) (base : f 0 = 7) (step : ∀ i, f (i + 1) = 2 * f i + 3) : f n = 10 * 2 ^ n - 3
  rw [recurrence.affine_closed.rat f 2 3 3 (by decide) step n, base]
  ring
+ rat_zero_scale (f : ℕ → ℚ) (r c : ℚ) (n : ℕ) (step : ∀ i, f (i + 1) = r * f i + c) : 0 * f n + 0 = (0 * f 0 + 0) * r ^ n
  exact recurrence.affine_transform.rat f r c 0 0 (by ring) step n
+ rat_zero_initial (f : ℕ → ℚ) (n : ℕ) (base : f 0 = 0) (step : ∀ i, f (i + 1) = (-2) * f i + (-9)) : f n = ((-2) ^ n - 1) * 3
  exact recurrence.affine_zero.rat f (-2) (-9) 3 base (by decide) step n

+ int_negative_rate (f : ℕ → ℤ) (n : ℕ) (step : ∀ i, f (i + 1) = (-2) * f i + (-9)) : f n = (f 0 + 3) * (-2) ^ n - 3
  exact recurrence.affine_closed.int f (-2) (-9) 3 (by decide) step n
+ int_zero_rate (f : ℕ → ℤ) (n : ℕ) (step : ∀ i, f (i + 1) = 0 * f i + (-3)) : f n = (f 0 + 3) * 0 ^ n - 3
  exact recurrence.affine_closed.int f 0 (-3) 3 (by decide) step n
+ int_unit_rate (f : ℕ → ℤ) (A : ℤ) (n : ℕ) (step : ∀ i, f (i + 1) = 1 * f i + 0) : f n = (f 0 + A) * 1 ^ n - A
  exact recurrence.affine_closed.int f 1 0 A (by ring) step n
+ int_nonzero_initial (f : ℕ → ℤ) (n : ℕ) (base : f 0 = 7) (step : ∀ i, f (i + 1) = 2 * f i + 3) : f n = 10 * 2 ^ n - 3
  rw [recurrence.affine_closed.int f 2 3 3 (by decide) step n, base]
  ring
+ int_zero_scale (f : ℕ → ℤ) (r c : ℤ) (n : ℕ) (step : ∀ i, f (i + 1) = r * f i + c) : 0 * f n + 0 = (0 * f 0 + 0) * r ^ n
  exact recurrence.affine_transform.int f r c 0 0 (by ring) step n
+ int_zero_initial (f : ℕ → ℤ) (n : ℕ) (base : f 0 = 0) (step : ∀ i, f (i + 1) = (-2) * f i + (-9)) : f n = ((-2) ^ n - 1) * 3
  exact recurrence.affine_zero.int f (-2) (-9) 3 base (by decide) step n

+ nat_zero_rate (f : ℕ → ℕ) (n : ℕ) (step : ∀ i, f (i + 1) = 0 * f i + 0) : 1 * f n + 0 = (1 * f 0 + 0) * 0 ^ n
  exact recurrence.affine_transform.nat f 0 0 1 0 (by decide) step n
+ nat_unit_rate (f : ℕ → ℕ) (n : ℕ) (step : ∀ i, f (i + 1) = 1 * f i + 0) : 2 * f n + 5 = (2 * f 0 + 5) * 1 ^ n
  exact recurrence.affine_transform.nat f 1 0 2 5 (by decide) step n
+ nat_zero_scale (f : ℕ → ℕ) (n : ℕ) (step : ∀ i, f (i + 1) = 1 * f i + 4) : 0 * f n + 7 = (0 * f 0 + 7) * 1 ^ n
  exact recurrence.affine_transform.nat f 1 4 0 7 (by decide) step n

-> dd : ℕ → ℝ
  | 0 => 0
  | k + 1 => 102 / 35 * dd k + 1 / 2
+ dd_closed (k : ℕ) : dd k = ((102 / 35) ^ k - 1) * (35 / 134) := by
  exact recurrence.affine_zero.real dd (102 / 35) (1 / 2) (35 / 134) (by rfl) (by norm_num) (by intro i; rfl) k

-> ep : ℕ → ℕ
  | 0 => 0
  | n + 1 => 9 * ep n + 6
+ ep_closed (j : ℕ) : 4 * ep j + 3 = 3 * 9 ^ j
  exact recurrence.affine_transform.nat ep 9 6 4 3 (by decide) (by intro i; rfl) j

-> chacon : ℕ → ℕ
  | 0 => 1
  | k + 1 => 3 * chacon k + 1
+ chacon_closed (k : ℕ) : 2 * chacon k + 1 = 3 ^ (k + 1) := by
  have h : 2 * chacon k + 1 = 3 * 3 ^ k := recurrence.affine_transform.nat chacon 3 1 2 1 (by decide) (by intro i; rfl) k
  rw [pow_succ.nat, h]
  ring

-> gsum (r : ℚ) : ℕ → ℚ
  | 0 => 0
  | n + 1 => gsum r n * r + 1
+ gsum_closed (r : ℚ) (n : ℕ) : gsum r n * (1 - r) = 1 - r ^ n
  have h := recurrence.affine_transform.rat (gsum r) r 1 (1 - r) (-1) (by ring) (by intro i; simp [gsum]; ring) n
  simp [gsum] at h
  linarith
