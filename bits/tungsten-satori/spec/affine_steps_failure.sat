+ weak_margin (a b : ℝ) (ha : 0 ≤ a) :
    ∃ t, 0 < t ∧ t < 1 ∧ (1 - t) * b < t * a := by auto
+ incompatible (m n : ℚ) : ∃ t : ℚ, 0 < t ∧ m*t < 2 ∧ n*t < 0 := by auto
+ closed_interval (a m u : ℚ) (gap : m*a < u) :
    ∃ x, a < x ∧ x < a ∧ m*x < u := by auto
+ nonlinear (m : ℝ) : ∃ t : ℝ, 0 < t ∧ m*t*t < 0 := by auto
+ integral (m : ℤ) : ∃ t : ℤ, 0 < t ∧ m*t < 1 := by auto
+ missing_hint (i : ℕ) (m : ℚ) : ∃ t, 0 < t ∧ m*t < limit i := by auto
