+ flip_eq (x y : α) : x = y ↔ y = x
  constructor
  · intro h; exact h.symm
  · intro h; exact h.symm
+ flip_forward (x y : α) (h : x = y) : y = x := (flip_eq x y).mp h
+ flip_backward (x y : α) (h : y = x) : x = y := (flip_eq x y).mpr h
+ flip_tactic (x y : α) (h : x = y) : y = x := by exact (flip_eq x y).mp h
+ flip_saved (x y : α) (h : x = y) : y = x
  have e := flip_eq x y
  exact e.mp h
+ predicate_iff (p : α → Prop) (x : α) : p x ↔ p x := by rfl
+ predicate_forward (p : α → Prop) (x : α) (h : p x) : p x := (predicate_iff p x).mp h
+ relation_iff (p : α → β → Prop) (x : α) (y : β) : p x y ↔ p x y := by rfl
+ relation_forward (p : α → β → Prop) (x : α) (y : β) (h : p x y) : p x y := (relation_iff p x y).mp h
+ exists_iff (p : α → Prop) : (∃ x, p x) ↔ (∃ x, p x) := by rfl
+ exists_backward (p : α → Prop) (x : α) (h : p x) : ∃ y, p y := (exists_iff p).mpr ⟨x, h⟩
+ quantified_iff (p : α → Prop) : (∀ x, p x) ↔ (∀ x, p x) := by rfl
+ quantified_forward (p : α → Prop) (h : ∀ x, p x) : ∀ x, p x := (quantified_iff p).mp h
+ closed_then_applied (x y : ℕ) (h : x = y) : y = x := (flip_eq x y).mp h
+ map_forward (F : (α → β) → γ) (f g : α → β) (h : F f = F g) : F g = F f := (flip_eq (F f) (F g)).mp h
+ nested_application (p : α → Prop) (x : α) (h : p x) : p x := (predicate_iff p x).mp ((predicate_iff p x).mpr h)

+ exists_from_witness (P : α → Prop) (x : α) (hx : P x) : ∃ y, P y := ⟨x, hx⟩
+ inferred_witness (P : α → Prop) (x : α) (hx : P x) : ∃ y, P y := by apply exists_from_witness <;> assumption
+ repeated_witness (P : α → Prop) (x : α) (hx hx2 : P x) : ∃ y, P y := by apply exists_from_witness <;> assumption
+ chosen_witness (P : α → Prop) (x y : α) (hx : P x) (hy : P y) : ∃ z, P z := by apply exists_from_witness P y <;> assumption
+ shared_witness (P Q : α → Prop) (x : α) (hp : P x) (hq : Q x) : ∃ y, P y ∧ Q y := ⟨x, hp, hq⟩
+ inferred_shared (P Q : α → Prop) (x : α) (hp : P x) (hq : Q x) : ∃ y, P y ∧ Q y := by apply shared_witness <;> assumption

+ witnesses (P : α → Prop) (Q : β → Prop) (x : α) (y : β) (hx : P x) (hy : Q y) :
    ∃ z w, P z ∧ Q w := ⟨x,y,hx,hy⟩
+ inferred_pair (P : α → Prop) (Q : β → Prop) (x : α) (y : β) (hx : P x) (hy : Q y) :
    ∃ z w, P z ∧ Q w := by apply witnesses <;> assumption

-> paired (P Q : Prop) : Prop := P ∧ Q
-> both_at (P Q : α → Prop) (x : α) : Prop := paired (P x) (Q x)
-> has_pair (P Q : α → Prop) : Prop := ∃ x, both_at P Q x
-> equivalent (P Q : Prop) : Prop := P ↔ Q
+ pair_value (P Q : α → Prop) (x : α) (p : P x) (q : Q x) : both_at P Q x := ⟨p,q⟩
+ pair_field (P Q : α → Prop) (x : α) (h : both_at P Q x) : Q x := h.2
+ pair_witness (P Q : α → Prop) (x : α) (p : P x) (q : Q x) : has_pair P Q := ⟨x,p,q⟩
+ iff_value (P Q : Prop) (f : P → Q) (g : Q → P) : equivalent P Q := ⟨f,g⟩
+ iff_field (P Q : Prop) (e : equivalent P Q) (p : P) : Q := e.mp p
+ pair_constructor (P Q : Prop) (p : P) (q : Q) : paired P Q := by constructor <;> assumption
+ ordinary_iff (P Q : Prop) (f : P → Q) (g : Q → P) : P ↔ Q := ⟨f,g⟩

+ witnesses_at_value (P : α → Prop) (g : β → γ) (b : γ) (x : α) (y : β)
    (hx : P x) (hy : g y = b) : ∃ v w, P v ∧ g w = b := ⟨x,y,hx,hy⟩
+ inferred_value (P : α → Prop) (g : β → γ) (b : γ) (x : α) (y : β)
    (hx : P x) (hy : g y = b) : ∃ v w, P v ∧ g w = b := by apply witnesses_at_value <;> assumption
