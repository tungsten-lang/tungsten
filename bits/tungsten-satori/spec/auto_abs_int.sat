import arith

+ nonnegative (x : ℤ) : 0 ≤ |x|
  auto
+ positive (x : ℤ) (h : x ≠ 0) : 0 < |x|
  auto
+ nonnegative_value (x : ℤ) (h : 0 ≤ x) : |x| = x
  auto
+ nonpositive_value (x : ℤ) (h : x ≤ 0) : |x| = 0-x
  auto
+ interval (x e : ℤ) (lo : 0-e ≤ x) (hi : x ≤ e) : |x| ≤ e
  auto
+ strict_interval (x e : ℤ) (lo : 0-e < x) (hi : x < e) : |x| < e
  auto
+ endpoints (x e : ℤ) (h : |x| ≤ e) : 0-e ≤ x ∧ x ≤ e
  auto
+ strict_endpoints (x e : ℤ) (h : |x| < e) : 0-e < x ∧ x < e
  auto
+ weakened_endpoint (x e d : ℤ) (h : |x| < e) (hd : e ≤ d-1) : x < d
  auto
+ triangle (x y : ℤ) : |x+y| ≤ |x|+|y|
  auto
+ difference (x y : ℤ) : |x-y| ≤ |x|+|y|
  auto
+ metric_triangle (x y z : ℤ) : |x-z| ≤ |x-y|+|y-z|
  auto
+ reverse_triangle (x y : ℤ) : | |x|-|y| | ≤ |x-y|
  auto
+ product (x y : ℤ) : |x*y| = |x|*|y|
  auto
+ nested (x : ℤ) : | |x| | = |x|
  auto
+ squared_bound (x c : ℤ) (h : x*x ≤ c*c) (hc : 0 ≤ c) : |x| ≤ c
  auto
+ strict_squared_order (x y : ℤ) (h : x*x < y*y) : |x| < |y|
  auto
+ zero_bound (x : ℤ) (h : |x| ≤ 0) : x = 0
  auto
+ pointwise (f : ℕ → ℤ) (c : ℤ) (h : ∀ i, |f i| ≤ c) (n : ℕ) : f n ≤ c
  auto
opaque a : ℤ
axiom known_abs : |a| ≤ 1
+ explicit_bound : a ≤ 1
  auto [known_abs]
