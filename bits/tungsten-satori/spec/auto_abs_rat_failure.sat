import auto_abs_rat

+ missing_lower (x e : ℚ) (h : x ≤ e) : |x| ≤ e
  auto
+ missing_upper (x e : ℚ) (h : 0-e ≤ x) : |x| ≤ e
  auto
+ weak_strict (x e : ℚ) (lo : 0-e ≤ x) (hi : x ≤ e) : |x| < e
  auto
+ strict_endpoint (x e : ℚ) (h : |x| ≤ e) : x < e
  auto
+ wrong_endpoint (x e : ℚ) (h : |x| < e) : x < 0-e
  auto
+ negative_squared_bound (x c : ℚ) (h : x*x ≤ c*c) (hc : c ≤ 0) : |x| ≤ c
  auto
+ wrong_value (x : ℚ) : |x| = x
  auto
+ false_monotonicity (x y : ℚ) (h : x ≤ y) : |x| ≤ |y|
  auto
+ branch_leak (x y c : ℚ) (h : |x| ≤ c ∨ |y| ≤ c) : x ≤ c
  auto
+ no_global_bound : a ≤ 1
  auto
