import arith

+ lower (x b c : ℚ) (n : ℕ) (h0 : 0 ≤ b) (hb : b ≤ x) (hc : c+1 ≤ b^n) : c ≤ x^n
  auto

+ strict_lower (x b c : ℚ) (n : ℕ) (h0 : 0 ≤ b) (hb : b ≤ x) (hc : c+1 ≤ b^n) : c < x^n
  auto

+ upper (x b c : ℚ) (n : ℕ) (h0 : 0 ≤ x) (hb : x ≤ b) (hc : b^n ≤ c-1) : x^n ≤ c
  auto

+ strict_upper (x b c : ℚ) (n : ℕ) (h0 : 0 ≤ x) (hb : x ≤ b) (hc : b^n ≤ c-1) : x^n < c
  auto

+ variable_margin (x b c e : ℚ) (n : ℕ) (h0 : 0 ≤ b) (hb : b ≤ x) (he : 0 < e) (hc : c+e ≤ b^n) : c < x^n
  auto

+ weak_margin (x b c e : ℚ) (n : ℕ) (h0 : 0 ≤ b) (hb : b < x) (hn : 0 < n) (he : 0 ≤ e) (hc : c+e ≤ b^n) : c < x^n
  auto

+ strict_fact (x b c e : ℚ) (n : ℕ) (h0 : 0 ≤ b) (hb : b ≤ x) (he : 0 ≤ e) (hc : c+e < b^n) : c < x^n
  auto

+ conjunction (x b c e : ℚ) (n : ℕ) (h : 0 ≤ b ∧ b ≤ x ∧ 0 < e ∧ c+e ≤ b^n) : c < x^n
  auto

+ generic (f : ℚ → ℚ) (mono : ∀ u v, u ≤ v → f u ≤ f v) (x b c : ℚ) (hb : b ≤ x) (hc : c+1 ≤ f b) : c < f x
  auto

+ maximum (a b c d u : ℚ) (ha : a ≤ c) (hb : b ≤ d) (hu : u+1 ≤ max a b) : u < max c d
  auto

+ natural (x b c : ℕ) (n : ℕ) (hb : b ≤ x) (hc : c+1 ≤ b^n) : c < x^n
  auto

+ integer (x b c : ℤ) (n : ℕ) (h0 : 0 ≤ b) (hb : b ≤ x) (hc : c+1 ≤ b^n) : c < x^n
  auto

+ real_value (x b c : ℝ) (n : ℕ) (h0 : 0 ≤ b) (hb : b ≤ x) (hc : c+1 ≤ b^n) : c < x^n
  auto

opaque a : ℚ
opaque b : ℚ
opaque c : ℚ
opaque e : ℚ
opaque n : ℕ
axiom supplied_bound : c+e ≤ b^n
axiom supplied_margin : 0 < e

+ explicit_bound (h0 : 0 ≤ b) (hb : b ≤ a) : c < a^n
  auto [supplied_bound, supplied_margin]
