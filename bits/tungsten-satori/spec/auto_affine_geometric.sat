import recurrence

-> affine.nat : ℕ → ℕ
  | 0 => 0
  | i+1 => 3*affine.nat i+2

+ nat_defined (n : ℕ) : affine.nat n+1 = 3^n
  auto

+ nat_reverse (n : ℕ) : 3^n = affine.nat n+1
  auto

+ nat_symbolic (f : ℕ → ℕ) (r A : ℕ) (n : ℕ) (base : f 0 = A) (step : ∀ i, f (i+1) = r*f i) : f n = A*r^n
  auto

+ nat_zero_rate (f : ℕ → ℕ) (A : ℕ) (n : ℕ) (base : f 0 = A) (step : ∀ i, f (i+1) = 0) : f n = A*0^n
  auto

+ nat_unit_rate (f : ℕ → ℕ) (A : ℕ) (n : ℕ) (base : f 0 = A) (step : ∀ i, f (i+1) = f i) : f n = A*1^n
  auto

+ nat_shifted_left (f : ℕ → ℕ) (r A c : ℕ) (n : ℕ) (base : f 0+c = A) (step : ∀ i, f (i+1)+c = r*(f i+c)) : f n+c = A*r^n
  auto

+ nat_partial (f : ℕ → ℕ → ℕ) (a n : ℕ) (r A : ℕ) (base : f a 0 = A) (step : ∀ i, f a (i+1) = r*f a i) : f a n = A*r^n
  auto

+ nat_zero_coefficient (f : ℕ → ℕ) (r : ℕ) (n : ℕ) (base : f 0 = 0) (step : ∀ i, f (i+1) = r*f i) : f n = 0*r^n
  auto

-> affine.int : ℕ → ℤ
  | 0 => 0
  | i+1 => 3*affine.int i+2

+ int_defined (n : ℕ) : affine.int n = 3^n-1
  auto

+ int_reverse (n : ℕ) : 3^n-1 = affine.int n
  auto

+ int_symbolic (f : ℕ → ℤ) (r A : ℤ) (n : ℕ) (base : f 0 = A) (step : ∀ i, f (i+1) = r*f i) : f n = A*r^n
  auto

+ int_zero_rate (f : ℕ → ℤ) (A : ℤ) (n : ℕ) (base : f 0 = A) (step : ∀ i, f (i+1) = 0) : f n = A*0^n
  auto

+ int_unit_rate (f : ℕ → ℤ) (A : ℤ) (n : ℕ) (base : f 0 = A) (step : ∀ i, f (i+1) = f i) : f n = A*1^n
  auto

+ int_shifted_left (f : ℕ → ℤ) (r A c : ℤ) (n : ℕ) (base : f 0+c = A) (step : ∀ i, f (i+1)+c = r*(f i+c)) : f n+c = A*r^n
  auto

+ int_partial (f : ℕ → ℕ → ℤ) (a n : ℕ) (r A : ℤ) (base : f a 0 = A) (step : ∀ i, f a (i+1) = r*f a i) : f a n = A*r^n
  auto

+ int_zero_coefficient (f : ℕ → ℤ) (r B : ℤ) (n : ℕ) (base : f 0 = B) (step : ∀ i, f (i+1) = r*(f i-B)+B) : f n = 0*r^n+B
  auto

+ int_negative_rate (f : ℕ → ℤ) (n : ℕ) (base : f 0 = 5) (step : ∀ i, f (i+1) = (-2)*f i) : f n = 5*(-2)^n
  auto

+ int_shifted (f : ℕ → ℤ) (r A B : ℤ) (n : ℕ) (base : f 0 = A+B) (step : ∀ i, f (i+1) = r*(f i-B)+B) : f n = A*r^n+B
  auto

-> affine.rat : ℕ → ℚ
  | 0 => 0
  | i+1 => 3*affine.rat i+2

+ rat_defined (n : ℕ) : affine.rat n = 3^n-1
  auto

+ rat_reverse (n : ℕ) : 3^n-1 = affine.rat n
  auto

+ rat_symbolic (f : ℕ → ℚ) (r A : ℚ) (n : ℕ) (base : f 0 = A) (step : ∀ i, f (i+1) = r*f i) : f n = A*r^n
  auto

+ rat_zero_rate (f : ℕ → ℚ) (A : ℚ) (n : ℕ) (base : f 0 = A) (step : ∀ i, f (i+1) = 0) : f n = A*0^n
  auto

+ rat_unit_rate (f : ℕ → ℚ) (A : ℚ) (n : ℕ) (base : f 0 = A) (step : ∀ i, f (i+1) = f i) : f n = A*1^n
  auto

+ rat_shifted_left (f : ℕ → ℚ) (r A c : ℚ) (n : ℕ) (base : f 0+c = A) (step : ∀ i, f (i+1)+c = r*(f i+c)) : f n+c = A*r^n
  auto

+ rat_partial (f : ℕ → ℕ → ℚ) (a n : ℕ) (r A : ℚ) (base : f a 0 = A) (step : ∀ i, f a (i+1) = r*f a i) : f a n = A*r^n
  auto

+ rat_zero_coefficient (f : ℕ → ℚ) (r B : ℚ) (n : ℕ) (base : f 0 = B) (step : ∀ i, f (i+1) = r*(f i-B)+B) : f n = 0*r^n+B
  auto

+ rat_negative_rate (f : ℕ → ℚ) (n : ℕ) (base : f 0 = 5) (step : ∀ i, f (i+1) = (-2)*f i) : f n = 5*(-2)^n
  auto

+ rat_shifted (f : ℕ → ℚ) (r A B : ℚ) (n : ℕ) (base : f 0 = A+B) (step : ∀ i, f (i+1) = r*(f i-B)+B) : f n = A*r^n+B
  auto

-> affine.real : ℕ → ℝ
  | 0 => 0
  | i+1 => 3*affine.real i+2

+ real_defined (n : ℕ) : affine.real n = 3^n-1
  auto

+ real_reverse (n : ℕ) : 3^n-1 = affine.real n
  auto

+ real_symbolic (f : ℕ → ℝ) (r A : ℝ) (n : ℕ) (base : f 0 = A) (step : ∀ i, f (i+1) = r*f i) : f n = A*r^n
  auto

+ real_zero_rate (f : ℕ → ℝ) (A : ℝ) (n : ℕ) (base : f 0 = A) (step : ∀ i, f (i+1) = 0) : f n = A*0^n
  auto

+ real_unit_rate (f : ℕ → ℝ) (A : ℝ) (n : ℕ) (base : f 0 = A) (step : ∀ i, f (i+1) = f i) : f n = A*1^n
  auto

+ real_shifted_left (f : ℕ → ℝ) (r A c : ℝ) (n : ℕ) (base : f 0+c = A) (step : ∀ i, f (i+1)+c = r*(f i+c)) : f n+c = A*r^n
  auto

+ real_partial (f : ℕ → ℕ → ℝ) (a n : ℕ) (r A : ℝ) (base : f a 0 = A) (step : ∀ i, f a (i+1) = r*f a i) : f a n = A*r^n
  auto

+ real_zero_coefficient (f : ℕ → ℝ) (r B : ℝ) (n : ℕ) (base : f 0 = B) (step : ∀ i, f (i+1) = r*(f i-B)+B) : f n = 0*r^n+B
  auto

+ real_negative_rate (f : ℕ → ℝ) (n : ℕ) (base : f 0 = 5) (step : ∀ i, f (i+1) = (-2)*f i) : f n = 5*(-2)^n
  auto

+ real_shifted (f : ℕ → ℝ) (r A B : ℝ) (n : ℕ) (base : f 0 = A+B) (step : ∀ i, f (i+1) = r*(f i-B)+B) : f n = A*r^n+B
  auto

-> ep : ℕ → ℕ
  | 0 => 0
  | n+1 => 9*ep n+6
+ ep_closed (n : ℕ) : 4*ep n+3 = 3*9^n := by auto

-> cc : ℕ → ℝ
  | 0 => 0
  | n+1 => 3/2*cc n+1/2
+ cc_closed (n : ℕ) : cc n = (3/2)^n-1 := by auto
