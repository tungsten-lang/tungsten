+ nat_shifted_exponent (f : ℕ → ℕ) (n : ℕ) (base : f 0 = 1) (step : ∀ i, f (i+1) = 3*f i) : f n = 3^(n+1)
  auto

+ nat_indexed_rate (f : ℕ → ℕ) (n : ℕ) (base : f 0 = 1) (step : ∀ i, f (i+1) = 3*f i) : f n = (n : ℕ)^n
  auto

+ nat_squared_power (f : ℕ → ℕ) (n : ℕ) (base : f 0 = 1) (step : ∀ i, f (i+1) = 3*f i) : f n = (3^n)^2
  auto

+ int_shifted_exponent (f : ℕ → ℤ) (n : ℕ) (base : f 0 = 1) (step : ∀ i, f (i+1) = 3*f i) : f n = 3^(n+1)
  auto

+ int_indexed_rate (f : ℕ → ℤ) (n : ℕ) (base : f 0 = 1) (step : ∀ i, f (i+1) = 3*f i) : f n = (n : ℤ)^n
  auto

+ int_squared_power (f : ℕ → ℤ) (n : ℕ) (base : f 0 = 1) (step : ∀ i, f (i+1) = 3*f i) : f n = (3^n)^2
  auto

+ rat_shifted_exponent (f : ℕ → ℚ) (n : ℕ) (base : f 0 = 1) (step : ∀ i, f (i+1) = 3*f i) : f n = 3^(n+1)
  auto

+ rat_indexed_rate (f : ℕ → ℚ) (n : ℕ) (base : f 0 = 1) (step : ∀ i, f (i+1) = 3*f i) : f n = (n : ℚ)^n
  auto

+ rat_squared_power (f : ℕ → ℚ) (n : ℕ) (base : f 0 = 1) (step : ∀ i, f (i+1) = 3*f i) : f n = (3^n)^2
  auto

