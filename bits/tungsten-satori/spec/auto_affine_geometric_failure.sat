import recurrence

-> affine.nat : ℕ → ℕ
  | 0 => 0
  | i+1 => 3*affine.nat i+2

+ nat_missing_base (f : ℕ → ℕ) (n : ℕ) (step : ∀ i, f (i+1) = 3*f i) : f n = 5*3^n
  auto

+ nat_missing_step (f : ℕ → ℕ) (n : ℕ) (base : f 0 = 5) : f n = 5*3^n
  auto

+ nat_wrong_base (f : ℕ → ℕ) (n : ℕ) (base : f 0 = 4) (step : ∀ i, f (i+1) = 3*f i) : f n = 5*3^n
  auto

+ nat_wrong_rate (f : ℕ → ℕ) (n : ℕ) (base : f 0 = 5) (step : ∀ i, f (i+1) = 2*f i) : f n = 5*3^n
  auto

+ nat_wrong_index (f : ℕ → ℕ) (n m : ℕ) (base : f 0 = 5) (step : ∀ i, f (i+1) = 3*f i) : f m = 5*3^n
  auto

+ nat_point_step (f : ℕ → ℕ) (n : ℕ) (base : f 0 = 5) (step : f (n+1) = 3*f n) : f n = 5*3^n
  auto

+ nat_two_rates (f : ℕ → ℕ) (n : ℕ) (base : f 0 = 1) (step : ∀ i, f (i+1) = 3*f i) : f n = 3^n+2^n
  auto

+ nat_wrong_offset (n : ℕ) : affine.nat n = 3^n-2
  auto

