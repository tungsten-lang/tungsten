  auto

+ int_wrong_index (f : ℕ → ℤ) (n m : ℕ) (base : f 0 = 5) (step : ∀ i, f (i+1) = 3*f i) : f m = 5*3^n
  auto

+ int_point_step (f : ℕ → ℤ) (n : ℕ) (base : f 0 = 5) (step : f (n+1) = 3*f n) : f n = 5*3^n
  auto

+ int_two_rates (f : ℕ → ℤ) (n : ℕ) (base : f 0 = 1) (step : ∀ i, f (i+1) = 3*f i) : f n = 3^n+2^n
  auto

+ int_wrong_offset (n : ℕ) : affine.int n = 3^n-2
  auto

