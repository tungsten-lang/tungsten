+ real_direct (n : ℕ) (c : ℝ) : (∑ i < n, c) = (n : ℝ)*c
  auto

+ real_termwise (f : ℕ → ℝ) (n : ℕ) (c : ℝ) (h : ∀ i < n, f i=c) : (∑ i < n, f i) = (n : ℝ)*c
