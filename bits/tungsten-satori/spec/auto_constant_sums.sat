import arith

-> nat_uniform (c : ℕ) (i : ℕ) : ℕ := c

+ nat_direct (n : ℕ) (c : ℕ) : (∑ i < n, c) = n*c
  auto

+ nat_termwise (f : ℕ → ℕ) (n : ℕ) (c : ℕ) (h : ∀ i < n, f i=c) : (∑ i < n, f i) = n*c
  auto

+ nat_offset (f : ℕ → ℕ) (n : ℕ) (c : ℕ) (h : ∀ i < n, f i+2=c+2) : (∑ i < n, f i) = n*c
  auto

+ nat_larger (f : ℕ → ℕ) (n m : ℕ) (c : ℕ) (hn : n ≤ m) (h : ∀ i < m, f i=c) : (∑ i < n, f i) = n*c
  auto

+ nat_one (f : ℕ → ℕ) (n : ℕ) (h : ∀ i < n, f i=1) : (∑ i < n, f i) = n
  auto

+ nat_alias (n : ℕ) (c : ℕ) : (∑ i < n, nat_uniform c i) = n*c
  auto

+ nat_reverse (f : ℕ → ℕ) (n : ℕ) (c : ℕ) (h : ∀ i < n, f i=c) : n*c = (∑ i < n, f i)
  auto

+ nat_empty (c : ℕ) : (∑ i < 0, c) = 0
  auto

-> int_uniform (c : ℤ) (i : ℕ) : ℤ := c

+ int_direct (n : ℕ) (c : ℤ) : (∑ i < n, c) = (n : ℤ)*c
  auto

+ int_termwise (f : ℕ → ℤ) (n : ℕ) (c : ℤ) (h : ∀ i < n, f i=c) : (∑ i < n, f i) = (n : ℤ)*c
  auto

+ int_offset (f : ℕ → ℤ) (n : ℕ) (c : ℤ) (h : ∀ i < n, f i+2=c+2) : (∑ i < n, f i) = (n : ℤ)*c
  auto

+ int_larger (f : ℕ → ℤ) (n m : ℕ) (c : ℤ) (hn : n ≤ m) (h : ∀ i < m, f i=c) : (∑ i < n, f i) = (n : ℤ)*c
  auto

+ int_one (f : ℕ → ℤ) (n : ℕ) (h : ∀ i < n, f i=1) : (∑ i < n, f i) = (n : ℤ)
  auto

+ int_alias (n : ℕ) (c : ℤ) : (∑ i < n, int_uniform c i) = (n : ℤ)*c
  auto

+ int_reverse (f : ℕ → ℤ) (n : ℕ) (c : ℤ) (h : ∀ i < n, f i=c) : (n : ℤ)*c = (∑ i < n, f i)
  auto

+ int_empty (c : ℤ) : (∑ i < 0, c) = 0
  auto

