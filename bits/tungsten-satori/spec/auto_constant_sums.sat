+ rat_larger (f : ℕ → ℚ) (n m : ℕ) (c : ℚ) (hn : n ≤ m) (h : ∀ i < m, f i=c) : (∑ i < n, f i) = (n : ℚ)*c
  auto

+ rat_one (f : ℕ → ℚ) (n : ℕ) (h : ∀ i < n, f i=1) : (∑ i < n, f i) = (n : ℚ)
  auto

+ rat_alias (n : ℕ) (c : ℚ) : (∑ i < n, rat_uniform c i) = (n : ℚ)*c
  auto

+ rat_reverse (f : ℕ → ℚ) (n : ℕ) (c : ℚ) (h : ∀ i < n, f i=c) : (n : ℚ)*c = (∑ i < n, f i)
  auto

+ rat_empty (c : ℚ) : (∑ i < 0, c) = 0
  auto

