+ rat_four (f a b c d : ℕ → ℚ) (n : ℕ)
    (base : f 0 = a 0+b 0+c 0+d 0) (fs : ∀ i, f (i+1) = f i+4)
    (as : ∀ i, a (i+1) = a i+1) (bs : ∀ i, b (i+1) = b i+1)
    (cs : ∀ i, c (i+1) = c i+1) (ds : ∀ i, d (i+1) = d i+1) : f n = a n+b n+c n+d n
  auto
+ rat_family (f g : ℕ → ℚ → ℚ) (a c : ℚ) (n : ℕ)
    (base : f 0 a = g 0 a) (fs : ∀ i, f (i+1) a = f i a+c) (gs : ∀ i, g (i+1) a = g i a+c) : f n a = g n a
  auto

