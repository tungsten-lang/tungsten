+ real_wrong_base (f g : ℕ → ℝ) (n : ℕ) (base : f 0 = g 0+1) (fs : ∀ i, f (i+1) = f i+1) (gs : ∀ i, g (i+1) = g i+1) : f n = g n
  auto

