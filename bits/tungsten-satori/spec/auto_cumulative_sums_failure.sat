  auto

+ int_wrong_sign (f : ℕ → ℤ) (n : ℕ) : (∑ i < n, f (i+1)-f i) = f 0-f n
  auto

+ int_wrong_endpoint (f : ℕ → ℤ) (n : ℕ) : (∑ i < n, f (i+1)-f i) = f (n+1)-f 0
  auto

+ int_wrong_stride (f : ℕ → ℤ) (n : ℕ) : (∑ i < n, f (i+2)-f i) = f n-f 0
  auto

