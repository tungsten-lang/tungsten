import arith

+ generic_missing_base (f s : ℕ → α) (step : ∀ i, s (i+1)=s i+f i) (n : ℕ) : s n = sum_below n f
  auto

+ generic_missing_step (f s : ℕ → α) (base : s 0=0) (n : ℕ) : s n = sum_below n f
  auto

+ generic_wrong_index (f s : ℕ → α) (base : s 0=0) (step : ∀ i, s (i+1)=s i+f (i+1)) (n : ℕ) : s n = sum_below n f
  auto

