  auto
+ int_positive (v : ℤ × ℤ) (h : positive.int v) : 0 < total.int v
  auto
+ int_equal_totals (v w : ℤ × ℤ) (h : pairwise.int v w) : total.int (shift.int v) = total.int (shift.int w)
  auto
+ int_record (f : α → ℤ) (x : α) (h : 0 ≤ f x) : 1 ≤ total.int (record.int f x)
  auto
