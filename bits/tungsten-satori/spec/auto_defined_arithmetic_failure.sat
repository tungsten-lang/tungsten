
-> shift.nat (v : ℕ × ℕ) : ℕ × ℕ := (fst v+1, snd v+2)
-> total.nat (v : ℕ × ℕ) : ℕ := fst v+snd v
-> ordered.nat (v : ℕ × ℕ) : Prop := fst v ≤ snd v
-> positive.nat (v : ℕ × ℕ) : Prop := 0 < fst v ∧ 0 < snd v
-> pairwise.nat (v w : ℕ × ℕ) : Prop := fst v = fst w ∧ snd v = snd w
-> allowance.nat (x : ℕ) : Prop := 2 ≤ x
-> record.nat (f : α → ℕ) (x : α) : ℕ × ℕ := (f x, f x+1)

-> shift.int (v : ℤ × ℤ) : ℤ × ℤ := (fst v+1, snd v+2)
-> total.int (v : ℤ × ℤ) : ℤ := fst v+snd v
-> ordered.int (v : ℤ × ℤ) : Prop := fst v ≤ snd v
-> positive.int (v : ℤ × ℤ) : Prop := 0 < fst v ∧ 0 < snd v
-> pairwise.int (v w : ℤ × ℤ) : Prop := fst v = fst w ∧ snd v = snd w
-> allowance.int (x : ℤ) : Prop := 2 ≤ x
-> record.int (f : α → ℤ) (x : α) : ℤ × ℤ := (f x, f x+1)

-> shift.rat (v : ℚ × ℚ) : ℚ × ℚ := (fst v+1, snd v+2)
-> total.rat (v : ℚ × ℚ) : ℚ := fst v+snd v
-> ordered.rat (v : ℚ × ℚ) : Prop := fst v ≤ snd v
-> positive.rat (v : ℚ × ℚ) : Prop := 0 < fst v ∧ 0 < snd v
-> pairwise.rat (v w : ℚ × ℚ) : Prop := fst v = fst w ∧ snd v = snd w
-> allowance.rat (x : ℚ) : Prop := 2 ≤ x
-> record.rat (f : α → ℚ) (x : α) : ℚ × ℚ := (f x, f x+1)

-> shift.real (v : ℝ × ℝ) : ℝ × ℝ := (fst v+1, snd v+2)
-> total.real (v : ℝ × ℝ) : ℝ := fst v+snd v
-> ordered.real (v : ℝ × ℝ) : Prop := fst v ≤ snd v
-> positive.real (v : ℝ × ℝ) : Prop := 0 < fst v ∧ 0 < snd v
-> pairwise.real (v w : ℝ × ℝ) : Prop := fst v = fst w ∧ snd v = snd w
-> allowance.real (x : ℝ) : Prop := 2 ≤ x
-> record.real (f : α → ℝ) (x : α) : ℝ × ℝ := (f x, f x+1)
+ nat_wrong_shift (v : ℕ × ℕ) (h : 0 ≤ total.nat v) : 4 ≤ total.nat (shift.nat v)
  auto
