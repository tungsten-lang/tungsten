import arith

+ positive (a b : ℝ) (ha : 0 < a) (hb : 0 < b) : 0 < a/b
  auto

+ nonnegative (a b : ℝ) (ha : 0 ≤ a) (hb : 0 ≤ b) : 0 ≤ a/b
  auto

+ reciprocal_positive (a : ℝ) (ha : 0 < a) : 0 < 1/a
  auto

+ reciprocal_negative (a : ℝ) (ha : a < 0) : 1/a < 0
  auto

+ upper (a b c : ℝ) (hc : 0 < c) (h : a ≤ b*c) : a/c ≤ b
  auto

+ lower (a b c : ℝ) (hc : 0 < c) (h : a*c ≤ b) : a ≤ b/c
  auto

+ strict_upper (a b c : ℝ) (hc : 0 < c) (h : a < b*c) : a/c < b
  auto

+ strict_lower (a b c : ℝ) (hc : 0 < c) (h : a*c < b) : a < b/c
  auto

+ cross (a b c d : ℝ) (hc : 0 < c) (hd : 0 < d) (h : a*d ≤ b*c) : a/c ≤ b/d
  auto

+ cross_strict (a b c d : ℝ) (hc : 0 < c) (hd : 0 < d) (h : a*d < b*c) : a/c < b/d
  auto

+ numerator_order (a b c : ℝ) (hc : 0 ≤ c) (h : a ≤ b) : a/c ≤ b/c
  auto

+ numerator_strict (a b c : ℝ) (hc : 0 < c) (h : a < b) : a/c < b/c
  auto

+ denominator_order (a b c : ℝ) (ha : 0 ≤ a) (hc : 0 < c) (h : c ≤ b) : a/b ≤ a/c
  auto

+ reciprocal_order (a b : ℝ) (ha : 0 < a) (h : a ≤ b) : 1/b ≤ 1/a
  auto

+ reciprocal_strict (a b : ℝ) (ha : 0 < a) (h : a < b) : 1/b < 1/a
  auto

+ unit_bound (x : ℝ) (hx : 0 < x) : x/(x+1) < 1
  auto

+ self (x : ℝ) (hx : x ≠ 0) : x/x = 1
  auto

+ cancel (x y : ℝ) (hy : y ≠ 0) : x/y*y = x
  auto

+ cancel_right (x y : ℝ) (hy : y ≠ 0) : x*y/y = x
  auto

+ cancel_left (x y : ℝ) (hx : x ≠ 0) : x*y/x = y
  auto

+ equality (a b c : ℝ) (hc : c ≠ 0) (h : a = b*c) : a/c = b
  auto

+ equality_right (a b c : ℝ) (hc : c ≠ 0) (h : a*c = b) : a = b/c
  auto

+ guard_arithmetic (x : ℝ) (hx : 2 < x) : 0 < (x-1)/(x+1)
  auto

+ nested (x : ℝ) (hx : 0 < x) : 0 < 1/(1/x)
  auto

+ double_inverse (x : ℝ) : 1/(1/x) = x
  auto

-> ratio (x y : ℝ) : ℝ := x/y

+ alias (x y : ℝ) (hx : 0 < x) (hy : 0 < y) : 0 < ratio x y
  auto

+ cleared_hint (a b c : ℝ) (hc : 0 < c) (h : a/c ≤ b) : a ≤ b*c
  auto [div_le_iff.real]

opaque known_a : ℝ
opaque known_b : ℝ
axiom supplied_cross : known_a ≤ known_b*2

+ explicit_bound : known_a/2 ≤ known_b
  auto [supplied_cross]

+ scaled_bound (a b c t : ℝ) (hc : 0 < c) (hab : a/c ≤ b) (ht : b*c < t) : a < t := by auto

+ nested_slope (z l d : ℝ) (hz : 0 < z) (hl : 0 < l) (hzl : 2+3*l < z) (hd : d < (l/z-1)/(1+l)) : 2 < -d*z := by auto

+ discount_loss (c t : ℝ) (hc : 0 ≤ c) (ht : 0 ≤ t) : c - c/(1+t) ≤ c*t := by auto

axiom supplied_positive : 0 < known_a
+ conditional_scale (x y t : ℝ) (h : x/known_a ≤ y) (ht : y*known_a < t) : x < t
  auto [supplied_positive]

-- The percolation potential permits a vanishing denominator.
+ square_over_bound (a r : ℝ) (ha : 0 ≤ a) (hr : 0 ≤ r) (hra : r ≤ a) : r^2/a ≤ r := by auto
+ zero_denominator (a b : ℝ) (hl : 0 ≤ b) (hu : b ≤ 0) : a/b = 0 := by auto
+ zero_numerator (a : ℝ) : 0/a = 0 := by simp
+ lower_at_zero (a b c : ℝ) (hc : 0 ≤ c) (hz : c = 0 → a ≤ 0) (h : a*c ≤ b) : a ≤ b/c := by auto
+ strict_at_zero (a b c : ℝ) (hc : 0 ≤ c) (hz : c = 0 → 0 < b) (h : a+1 ≤ b*c) : a/c < b := by auto
+ strict_lower_at_zero (a b c : ℝ) (hc : 0 ≤ c) (hz : c = 0 → a < 0) (h : a*c < b) : a < b/c := by auto
