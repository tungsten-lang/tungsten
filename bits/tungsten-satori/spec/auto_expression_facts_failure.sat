import arith

+ nat_missing_guard (f : ℕ → ℕ) (n j : ℕ) (v : ℕ) (h : f j+3 = v+2) : (∑ i < n, f i*(if i=j then 1 else 0))+1 = v
  auto

+ nat_closed_guard (f : ℕ → ℕ) (n j : ℕ) (v : ℕ) (hj : j ≤ n) (h : f j+3 = v+2) : (∑ i < n, f i*(if i=j then 1 else 0))+1 = v
  auto

+ nat_wrong_index (f : ℕ → ℕ) (n j k : ℕ) (v : ℕ) (hj : j < n) (h : f k+3 = v+2) : (∑ i < n, f i*(if i=j then 1 else 0))+1 = v
  auto

+ nat_wrong_scale (f : ℕ → ℕ) (c v : ℕ) (n : ℕ) (h : c*(∑ i < n, f i) = v) : (∑ i < n, (c+1)*f i)+1 = v+1
  auto

+ nat_wrong_sum (f g : ℕ → ℕ) (n : ℕ) (v : ℕ) (h : (∑ i < n, f i)+(∑ i < n, g i) = v) : (∑ i < n, f i+f i)+1 = v+1
  auto

+ nat_weak_strict (f : ℕ → ℕ) (n j : ℕ) (v : ℕ) (hj : j < n) (h : f j ≤ v) : (∑ i < n, f i*(if i=j then 1 else 0))+1 < v+1
  auto

+ nat_reversed_outside (f : ℕ → ℕ) (n j : ℕ) (v : ℕ) (hj : j ≤ n) : (∑ i < n, f i*(if i=j then 1 else 0))+v = v
  auto

+ nat_conditional_leak (f : ℕ → ℕ) (n j : ℕ) (v : ℕ) (p : Prop) (hj : p → j < n) (h : f j+3 = v+2) : (∑ i < n, f i*(if i=j then 1 else 0))+1 = v
  auto

+ nat_branch_leak (f : ℕ → ℕ) (n j : ℕ) (v : ℕ) (p : Prop) (hj : j < n ∨ p) (h : f j+3 = v+2) : (∑ i < n, f i*(if i=j then 1 else 0))+1 = v
  auto

