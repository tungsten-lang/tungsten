+ l_paired_base (step : α → β → β) (p : β → Prop) (xs : list α) (s : β) (q : β → Prop) (hp : p s) (h : ∀ x s, p s → q s → p (step x s) ∧ q (step x s)) : p (list.foldl step xs s) ∧ q (list.foldl step xs s) := by auto

+ l_paired_step (step : α → β → β) (p : β → Prop) (xs : list α) (s : β) (q : β → Prop) (hp : p s) (hq : q s) (h : ∀ x s, p s → q s → p (step x s)) : p (list.foldl step xs s) ∧ q (list.foldl step xs s) := by auto

+ l_conclusion (step : α → β → β) (p : β → Prop) (xs : list α) (s : β) (q : β → Prop) (hp : p s) (h : ∀ x s, p s → p (step x s)) : q (list.foldl step xs s) := by auto

+ l_reversed_step (step : α → β → β) (p : β → Prop) (xs : list α) (s : β) (hs : p s) (h : ∀ x s, p (step x s) → p s) : p (list.foldl step xs s) := by auto

+ l_wrong_field (step : α → β → β) (xs : list α) (s : β × γ) : fst (list.foldl (fun x v => (step x (fst v), snd v)) xs s) = fst s := by auto

+ l_wrong_order (xs : list ℕ) : list.foldl (fun x s => 10*s+x) xs 0 = list.foldr (fun x s => 10*s+x) xs 0 := by auto

+ r_no_base (step : α → β → β) (p : β → Prop) (xs : list α) (s : β) (h : ∀ x s, p s → p (step x s)) : p (list.foldr step xs s) := by auto

