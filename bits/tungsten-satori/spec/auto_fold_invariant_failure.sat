+ l_no_base (step : α → β → β) (p : β → Prop) (xs : list α) (s : β) (h : ∀ x s, p s → p (step x s)) : p (list.foldl step xs s) := by auto

+ l_no_step (step : α → β → β) (p : β → Prop) (xs : list α) (s : β) (hs : p s) : p (list.foldl step xs s) := by auto

+ l_point_step (step : α → β → β) (p : β → Prop) (xs : list α) (s : β) (hs : p s) (h : ∀ x, p s → p (step x s)) : p (list.foldl step xs s) := by auto

+ l_wrong_step (step : α → β → β) (p : β → Prop) (xs : list α) (s : β) (other : α → β → β) (hs : p s) (h : ∀ x s, p s → p (other x s)) : p (list.foldl step xs s) := by auto

+ l_wrong_state (step : α → β → β) (p : β → Prop) (xs : list α) (s : β) (t : β) (ht : p t) (h : ∀ x s, p s → p (step x s)) : p (list.foldl step xs s) := by auto

