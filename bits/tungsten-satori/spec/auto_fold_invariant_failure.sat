+ r_wrong_field (step : α → β → β) (xs : list α) (s : β × γ) : fst (list.foldr (fun x v => (step x (fst v), snd v)) xs s) = fst s := by auto

+ r_wrong_order (xs : list ℕ) : list.foldr (fun x s => 10*s+x) xs 0 = list.foldl (fun x s => 10*s+x) xs 0 := by auto

-> changed_base (step : α → β → β) (bad : β) : list α → β → β
  | [], s => bad
  | x :: xs, s => changed_base step bad xs (step x s)
+ bad_base (step : α → β → β) (p : β → Prop) (bad s : β) (xs : list α) (hs : p s) (h : ∀ x s, p s → p (step x s)) : p (changed_base step bad xs s) := by auto
-> changed_step (step other : α → β → β) : list α → β → β
  | [], s => s
  | x :: xs, s => changed_step step other xs (other x s)
+ bad_step (step other : α → β → β) (p : β → Prop) (s : β) (xs : list α) (hs : p s) (h : ∀ x s, p s → p (step x s)) : p (changed_step step other xs s) := by auto
+ no_nested (outer : list α) (inner : list γ) (f : α → β → β) (g : γ → β → β) (p : β → Prop) (s : β) (hs : p s) (h : ∀ x s, p s → p (f x s)) : p (list.foldl g inner (list.foldl f outer s)) := by auto
