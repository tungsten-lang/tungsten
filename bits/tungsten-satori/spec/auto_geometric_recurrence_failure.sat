  auto

+ real_forcing_missing_base (s : ℕ → ℝ) (b q c : ℝ) (rate : 0 ≤ b) (gap : b ≤ q) (step : ∀ i, s (i+1) ≤ b*s i+c*q^i) (n : ℕ) : (q-b)*s n ≤ c*(q^n-b^n)
