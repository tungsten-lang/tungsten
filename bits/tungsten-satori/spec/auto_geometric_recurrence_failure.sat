  auto

+ rat_forcing_missing_rate (s : ℕ → ℚ) (b q c : ℚ) (gap : b ≤ q) (base : s 0 ≤ 0) (step : ∀ i, s (i+1) ≤ b*s i+c*q^i) (n : ℕ) : (q-b)*s n ≤ c*(q^n-b^n)
  auto

+ rat_forcing_missing_gap (s : ℕ → ℚ) (b q c : ℚ) (rate : 0 ≤ b) (base : s 0 ≤ 0) (step : ∀ i, s (i+1) ≤ b*s i+c*q^i) (n : ℕ) : (q-b)*s n ≤ c*(q^n-b^n)
  auto

+ rat_forcing_missing_base (s : ℕ → ℚ) (b q c : ℚ) (rate : 0 ≤ b) (gap : b ≤ q) (step : ∀ i, s (i+1) ≤ b*s i+c*q^i) (n : ℕ) : (q-b)*s n ≤ c*(q^n-b^n)
  auto

+ real_sum_missing_base (s : ℕ → ℝ) (r : ℝ) (step : ∀ i, s (i+1) = s i+r^i) (n : ℕ) : (1-r)*s n = 1-r^n
  auto

+ real_sum_missing_step (s : ℕ → ℝ) (r : ℝ) (base : s 0 = 0) (n : ℕ) : (1-r)*s n = 1-r^n
  auto

