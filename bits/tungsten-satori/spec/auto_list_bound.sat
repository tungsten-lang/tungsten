
-> subtotal.nat : list ℕ → ℕ
  | [] => 0
  | x :: xs => x+subtotal.nat xs
-> count.nat : list α → ℕ
  | [] => 0
  | x :: xs => 1+count.nat xs
-> nonnegative.nat : list ℕ → Prop
  | [] => True
  | x :: xs => 0 ≤ x ∧ nonnegative.nat xs
-> product.nat : list ℕ → ℕ
  | [] => 1
  | x :: xs => (1+x)*product.nat xs
-> big.nat (K : ℕ) : list ℕ → ℕ
  | [] => 0
  | x :: xs => (if K ≤ x then x else 0)+big.nat K xs
+ nat_nonnegative (xs : list ℕ) (h : nonnegative.nat xs) : 0 ≤ subtotal.nat xs := by auto
+ nat_member_nonnegative (xs : list ℕ) (h : ∀ x ∈ xs, 0 ≤ x) : 0 ≤ subtotal.nat xs := by auto
+ nat_upper (xs : list ℕ) (C : ℕ) (h : ∀ x ∈ xs, x ≤ C) : subtotal.nat xs ≤ count.nat xs*C := by auto
+ nat_lower (xs : list ℕ) (C : ℕ) (h : ∀ x ∈ xs, C ≤ x) : count.nat xs*C ≤ subtotal.nat xs := by auto
+ nat_product (xs : list ℕ) (h : nonnegative.nat xs) : 1+subtotal.nat xs ≤ product.nat xs
  auto [nat_nonnegative]
+ nat_threshold (xs : list ℕ) (K : ℕ) (hK : 0 ≤ K) : subtotal.nat xs ≤ big.nat K xs+count.nat xs*K := by auto
+ nat_strict (xs : list ℕ) (C : ℕ) (hc : 0 < C) (h : ∀ x ∈ xs, x ≤ C) : subtotal.nat xs < count.nat xs*C+C := by auto
+ nat_supplied (f g : list α → ℕ) (u : α → ℕ) (xs : list α)
    (base : f [] ≤ g []) (fs : ∀ x ys, f (x :: ys) ≤ f ys+u x)
    (gs : ∀ x ys, g ys+u x ≤ g (x :: ys)) : f xs ≤ g xs
  auto
+ nat_guarded (f : list α → ℕ) (p : α → Prop) (A c : ℕ) (xs : list α)
    (base : f [] ≤ A) (step : ∀ x ys, p x → f (x :: ys) ≤ f ys+c) (h : ∀ x ∈ xs, p x) : f xs ≤ A+count.nat xs*c
  auto

-> subtotal.int : list ℤ → ℤ
  | [] => 0
  | x :: xs => x+subtotal.int xs
