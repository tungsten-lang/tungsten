  | [] => True
  | x :: xs => 0 ≤ x ∧ nonnegative.int xs
-> product.int : list ℤ → ℤ
  | [] => 1
  | x :: xs => (1+x)*product.int xs
-> big.int (K : ℤ) : list ℤ → ℤ
  | [] => 0
  | x :: xs => (if K ≤ x then x else 0)+big.int K xs
+ int_nonnegative (xs : list ℤ) (h : nonnegative.int xs) : 0 ≤ subtotal.int xs := by auto
+ int_member_nonnegative (xs : list ℤ) (h : ∀ x ∈ xs, 0 ≤ x) : 0 ≤ subtotal.int xs := by auto
+ int_upper (xs : list ℤ) (C : ℤ) (h : ∀ x ∈ xs, x ≤ C) : subtotal.int xs ≤ count.int xs*C := by auto
+ int_lower (xs : list ℤ) (C : ℤ) (h : ∀ x ∈ xs, C ≤ x) : count.int xs*C ≤ subtotal.int xs := by auto
+ int_product (xs : list ℤ) (h : nonnegative.int xs) : 1+subtotal.int xs ≤ product.int xs
  auto [int_nonnegative]
+ int_threshold (xs : list ℤ) (K : ℤ) (hK : 0 ≤ K) : subtotal.int xs ≤ big.int K xs+count.int xs*K := by auto
+ int_strict (xs : list ℤ) (C : ℤ) (hc : 0 < C) (h : ∀ x ∈ xs, x ≤ C) : subtotal.int xs < count.int xs*C+C := by auto
+ int_supplied (f g : list α → ℤ) (u : α → ℤ) (xs : list α)
