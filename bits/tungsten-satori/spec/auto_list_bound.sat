+ int_guarded (f : list α → ℤ) (p : α → Prop) (A c : ℤ) (xs : list α)
    (base : f [] ≤ A) (step : ∀ x ys, p x → f (x :: ys) ≤ f ys+c) (h : ∀ x ∈ xs, p x) : f xs ≤ A+count.int xs*c
  auto

