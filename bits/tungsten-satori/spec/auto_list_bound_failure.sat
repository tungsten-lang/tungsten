-> subtotal.nat : list ℕ → ℕ
  | [] => 0
  | x :: xs => x+subtotal.nat xs
-> count.nat : list α → ℕ
  | [] => 0
  | x :: xs => 1+count.nat xs
-> nonnegative.nat : list ℕ → Prop
  | [] => True
  | x :: xs => 0 ≤ x ∧ nonnegative.nat xs
-> product.nat : list ℕ → ℕ
  | [] => 1
  | x :: xs => (1+x)*product.nat xs
-> big.nat (K : ℕ) : list ℕ → ℕ
  | [] => 0
  | x :: xs => (if K ≤ x then x else 0)+big.nat K xs
-> subtotal.int : list ℤ → ℤ
  | [] => 0
  | x :: xs => x+subtotal.int xs
-> count.int : list α → ℤ
  | [] => 0
  | x :: xs => 1+count.int xs
-> nonnegative.int : list ℤ → Prop
  | [] => True
  | x :: xs => 0 ≤ x ∧ nonnegative.int xs
-> product.int : list ℤ → ℤ
  | [] => 1
  | x :: xs => (1+x)*product.int xs
-> big.int (K : ℤ) : list ℤ → ℤ
  | [] => 0
  | x :: xs => (if K ≤ x then x else 0)+big.int K xs
-> subtotal.rat : list ℚ → ℚ
  | [] => 0
  | x :: xs => x+subtotal.rat xs
-> count.rat : list α → ℚ
  | [] => 0
  | x :: xs => 1+count.rat xs
-> nonnegative.rat : list ℚ → Prop
  | [] => True
  | x :: xs => 0 ≤ x ∧ nonnegative.rat xs
-> product.rat : list ℚ → ℚ
  | [] => 1
  | x :: xs => (1+x)*product.rat xs
-> big.rat (K : ℚ) : list ℚ → ℚ
  | [] => 0
  | x :: xs => (if K ≤ x then x else 0)+big.rat K xs
-> subtotal.real : list ℝ → ℝ
  | [] => 0
  | x :: xs => x+subtotal.real xs
-> count.real : list α → ℝ
  | [] => 0
  | x :: xs => 1+count.real xs
-> nonnegative.real : list ℝ → Prop
  | [] => True
  | x :: xs => 0 ≤ x ∧ nonnegative.real xs
-> product.real : list ℝ → ℝ
  | [] => 1
  | x :: xs => (1+x)*product.real xs
-> big.real (K : ℝ) : list ℝ → ℝ
  | [] => 0
  | x :: xs => (if K ≤ x then x else 0)+big.real K xs

+ nat_empty_strict (xs : list ℕ) (h : nonnegative.nat xs) : 0 < subtotal.nat xs := by auto
+ nat_missing_upper (xs : list ℕ) (C : ℕ) : subtotal.nat xs ≤ count.nat xs*C := by auto
+ nat_wrong_upper (xs : list ℕ) (C : ℕ) (h : ∀ x ∈ xs, C ≤ x) : subtotal.nat xs ≤ count.nat xs*C := by auto
+ nat_point_member (xs : list ℕ) (a C : ℕ) (h : a ∈ xs → a ≤ C) : subtotal.nat xs ≤ count.nat xs*C := by auto
+ nat_wrong_list (xs ys : list ℕ) (C : ℕ) (h : ∀ x ∈ ys, x ≤ C) : subtotal.nat xs ≤ count.nat xs*C := by auto
+ nat_missing_base (f g : list α → ℕ) (xs : list α)
    (fs : ∀ x ys, f (x :: ys) ≤ f ys+1) (gs : ∀ x ys, g ys+1 ≤ g (x :: ys)) : f xs ≤ g xs
  auto
+ nat_missing_step (f g : list α → ℕ) (xs : list α) (base : f [] ≤ g [])
    (gs : ∀ x ys, g ys+1 ≤ g (x :: ys)) : f xs ≤ g xs
  auto
+ nat_wrong_step (f g : list α → ℕ) (xs : list α) (base : f [] ≤ g [])
    (fs : ∀ x ys, f (x :: ys) ≤ f ys+2) (gs : ∀ x ys, g ys+1 ≤ g (x :: ys)) : f xs ≤ g xs
  auto
+ nat_missing_guard (f : list α → ℕ) (p : α → Prop) (A c : ℕ) (xs : list α)
    (base : f [] ≤ A) (step : ∀ x ys, p x → f (x :: ys) ≤ f ys+c) : f xs ≤ A+count.nat xs*c
  auto
+ nat_point_step (f g : list ℕ → ℕ) (a : ℕ) (xs : list ℕ) (base : f [] ≤ g [])
    (fs : ∀ ys, f (a :: ys) ≤ f ys+1) (gs : ∀ x ys, g ys+1 ≤ g (x :: ys)) : f xs ≤ g xs
  auto

