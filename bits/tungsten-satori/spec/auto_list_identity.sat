
-> items.nat : list ℕ → ℕ
  | [] => 0
  | x :: xs => x+items.nat xs
-> twice.nat : list ℕ → ℕ
  | [] => 0
  | x :: xs => 2*x+twice.nat xs
-> weighted.nat (c : ℕ) : list ℕ → ℕ
  | [] => 0
  | x :: xs => c*x+weighted.nat c xs
-> units.nat : list α → ℕ
  | [] => 0
  | x :: xs => 1+units.nat xs
-> twounits.nat : list α → ℕ
  | [] => 0
  | x :: xs => 2+twounits.nat xs
-> rows.nat (ys : list ℕ) : list ℕ → ℕ
  | [] => 0
  | x :: xs => weighted.nat x ys+rows.nat ys xs
+ nat_defined (xs : list ℕ) : twice.nat xs = 2*items.nat xs := by auto
+ nat_reverse (xs : list ℕ) : 2*items.nat xs = twice.nat xs := by auto
+ nat_scaled (xs : list ℕ) (c : ℕ) : weighted.nat c xs = c*items.nat xs := by auto
+ nat_hinted (xs ys : list ℕ) : rows.nat ys xs = items.nat xs*items.nat ys
  auto [nat_scaled]
+ nat_local_hint (xs ys : list ℕ) : rows.nat ys xs = items.nat xs*items.nat ys
  have rule := nat_scaled
  auto
+ nat_generic (xs : list α) : twounits.nat xs = 2*units.nat xs := by auto
+ nat_same_step (f g : list α → ℕ) (w : α → ℕ) (xs : list α)
    (base : f [] = g []) (fs : ∀ x ys, f (x :: ys) = w x+f ys)
    (gs : ∀ x ys, g (x :: ys) = w x+g ys) : f xs = g xs
  auto
+ nat_offset (f g : list α → ℕ) (w : α → ℕ) (c : ℕ) (xs : list α)
    (base : f [] = g []+c) (fs : ∀ x ys, f (x :: ys) = w x+f ys)
    (gs : ∀ x ys, g (x :: ys) = w x+g ys) : f xs = g xs+c
  auto
+ nat_sum (f g h : list α → ℕ) (u v : α → ℕ) (xs : list α)
    (base : h [] = f []+g []) (fs : ∀ x ys, f (x :: ys) = u x+f ys)
    (gs : ∀ x ys, g (x :: ys) = v x+g ys) (hs : ∀ x ys, h (x :: ys) = u x+v x+h ys) : h xs = f xs+g xs
  auto
+ nat_parameter (f g : ℕ → list α → ℕ) (a : ℕ) (xs : list α)
    (base : f a [] = g a []) (fs : ∀ x ys, f a (x :: ys) = a+f a ys)
    (gs : ∀ x ys, g a (x :: ys) = a+g a ys) : f a xs = g a xs
  auto

