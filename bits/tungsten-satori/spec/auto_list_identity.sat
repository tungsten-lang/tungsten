-- The tensor identity needs a polynomial hint after rewriting the tail.
-> data_mass : list (ℚ × ℚ) → ℚ
  | [] => 0
  | x :: xs => fst x+data_mass xs
-> data_moment : list (ℚ × ℚ) → ℚ
  | [] => 0
  | x :: xs => fst x*snd x+data_moment xs
-> data_energy : list (ℚ × ℚ) → ℚ
  | [] => 0
  | x :: xs => fst x*snd x^2+data_energy xs
-> pair_energy (x : ℚ × ℚ) : list (ℚ × ℚ) → ℚ
  | [] => 0
  | y :: ys => fst x*fst y*(snd x+snd y)^2+pair_energy x ys
-> tensor_energy (ys : list (ℚ × ℚ)) : list (ℚ × ℚ) → ℚ
  | [] => 0
  | x :: xs => pair_energy x ys+tensor_energy ys xs
+ rat_pair_energy (x : ℚ × ℚ) (ys : list (ℚ × ℚ)) : pair_energy x ys = fst x*(data_mass ys*snd x^2+2*snd x*data_moment ys+data_energy ys)
  auto
+ rat_tensor_energy (xs ys : list (ℚ × ℚ)) : tensor_energy ys xs = data_mass ys*data_energy xs+2*data_moment xs*data_moment ys+data_mass xs*data_energy ys
  auto [rat_pair_energy]
