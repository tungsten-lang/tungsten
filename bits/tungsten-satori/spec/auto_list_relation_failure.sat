+ l_no_step (step : α → β → β) (update : α → γ → γ) (f : β → γ) (xs : list α) (s : β)  : f (list.foldl step xs s) = list.foldl update xs (f s) := by auto

+ l_point_step (step : α → β → β) (update : α → γ → γ) (f : β → γ) (xs : list α) (s : β) (h : ∀ x, f (step x s) = update x (f s)) : f (list.foldl step xs s) = list.foldl update xs (f s) := by auto

+ l_wrong_update (step : α → β → β) (update : α → γ → γ) (f : β → γ) (xs : list α) (s : β) (other : α → γ → γ) (h : ∀ x s, f (step x s) = other x (f s)) : f (list.foldl step xs s) = list.foldl update xs (f s) := by auto

+ l_missing_guard (step : α → β → β) (update : α → γ → γ) (f : β → γ) (xs : list α) (s : β) (p : α → Prop) (h : ∀ x, p x → ∀ s, f (step x s) = update x (f s)) : f (list.foldl step xs s) = list.foldl update xs (f s) := by auto

+ l_wrong_initial (step : α → β → β) (update : α → γ → γ) (f : β → γ) (xs : list α) (s : β) (t : β) (h : ∀ x s, f (step x s) = update x (f s)) : f (list.foldl step xs s) = list.foldl update xs (f t) := by auto

+ l_missing_second (step : α → β → β) (update : α → γ → γ) (f : β → γ) (xs : list α) (s : β) (g : β → γ) (h : ∀ x s, f (step x s) = update x (f s)) : f (list.foldl step xs s) = list.foldl update xs (f s) ∧ g (list.foldl step xs s) = list.foldl update xs (g s) := by auto

+ r_no_step (step : α → β → β) (update : α → γ → γ) (f : β → γ) (xs : list α) (s : β)  : f (list.foldr step xs s) = list.foldr update xs (f s) := by auto

+ r_point_step (step : α → β → β) (update : α → γ → γ) (f : β → γ) (xs : list α) (s : β) (h : ∀ x, f (step x s) = update x (f s)) : f (list.foldr step xs s) = list.foldr update xs (f s) := by auto

+ r_wrong_update (step : α → β → β) (update : α → γ → γ) (f : β → γ) (xs : list α) (s : β) (other : α → γ → γ) (h : ∀ x s, f (step x s) = other x (f s)) : f (list.foldr step xs s) = list.foldr update xs (f s) := by auto

+ r_missing_guard (step : α → β → β) (update : α → γ → γ) (f : β → γ) (xs : list α) (s : β) (p : α → Prop) (h : ∀ x, p x → ∀ s, f (step x s) = update x (f s)) : f (list.foldr step xs s) = list.foldr update xs (f s) := by auto

+ r_wrong_initial (step : α → β → β) (update : α → γ → γ) (f : β → γ) (xs : list α) (s : β) (t : β) (h : ∀ x s, f (step x s) = update x (f s)) : f (list.foldr step xs s) = list.foldr update xs (f t) := by auto

+ r_missing_second (step : α → β → β) (update : α → γ → γ) (f : β → γ) (xs : list α) (s : β) (g : β → γ) (h : ∀ x s, f (step x s) = update x (f s)) : f (list.foldr step xs s) = list.foldr update xs (f s) ∧ g (list.foldr step xs s) = list.foldr update xs (g s) := by auto

-> accumulate.nat : list ℕ → ℕ → ℕ
  | [], s => s
  | x :: xs, s => accumulate.nat xs (s+x)
-> subtotal.nat : list ℕ → ℕ
  | [] => 0
  | x :: xs => x+subtotal.nat xs
+ nat_missing_initial (xs : list ℕ) (s : ℕ) : accumulate.nat xs s = subtotal.nat xs := by auto
+ nat_wrong_scale (xs : list ℕ) (s : ℕ) : accumulate.nat xs s = s+2*subtotal.nat xs := by auto
+ nat_wrong_coordinate (xs : list ℕ) (s : ℕ) : accumulate.nat xs s = s+subtotal.nat xs ∧ s+subtotal.nat xs+1 = accumulate.nat xs s := by auto
+ nat_wrong_base (xs : list ℕ) (s : ℕ) : accumulate.nat xs s = s+subtotal.nat xs+1 := by auto
+ nat_wrong_state (xs : list ℕ) (s t : ℕ) : accumulate.nat xs s = t+subtotal.nat xs := by auto

