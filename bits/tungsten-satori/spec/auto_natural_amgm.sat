  auto
+ added_bound (x y : ℕ) : 2*x*y ≤ x^2+y^2+3
  auto
+ strict_margin (x y : ℕ) : 2*x*y < x^2+y^2+1
  auto
+ subtraction_inputs (x y : ℕ) : 2*(x-y)*(y-x) ≤ (x-y)^2+(y-x)^2
