import power
+ nat_add (a b : ℕ) (m n : ℕ) : a^(m+n) = a^m*a^n := by auto
+ nat_add_reverse (a b : ℕ) (m n : ℕ) : a^m*a^n = a^(m+n) := by auto
+ nat_multiply (a b : ℕ) (m n : ℕ) : a^(m*n) = (a^m)^n := by auto
+ nat_multiply_reverse (a b : ℕ) (m n : ℕ) : (a^m)^n = a^(m*n) := by auto
+ nat_product (a b : ℕ) (m n : ℕ) : (a*b)^n = a^n*b^n := by auto
+ nat_product_reverse (a b : ℕ) (m n : ℕ) : a^n*b^n = (a*b)^n := by auto
+ nat_expression_base (a b : ℕ) (m n : ℕ) : ((a+b)*(a+1))^n = (a+b)^n*(a+1)^n := by auto
+ nat_expression_exponent (a b : ℕ) (m n : ℕ) : a^((m+1)*(n+2)) = (a^(m+1))^(n+2) := by auto
+ int_add (a b : ℤ) (m n : ℕ) : a^(m+n) = a^m*a^n := by auto
+ int_add_reverse (a b : ℤ) (m n : ℕ) : a^m*a^n = a^(m+n) := by auto
+ int_multiply (a b : ℤ) (m n : ℕ) : a^(m*n) = (a^m)^n := by auto
+ int_multiply_reverse (a b : ℤ) (m n : ℕ) : (a^m)^n = a^(m*n) := by auto
+ int_product (a b : ℤ) (m n : ℕ) : (a*b)^n = a^n*b^n := by auto
+ int_product_reverse (a b : ℤ) (m n : ℕ) : a^n*b^n = (a*b)^n := by auto
+ int_expression_base (a b : ℤ) (m n : ℕ) : ((a+b)*(a+1))^n = (a+b)^n*(a+1)^n := by auto
+ int_expression_exponent (a b : ℤ) (m n : ℕ) : a^((m+1)*(n+2)) = (a^(m+1))^(n+2) := by auto
+ rat_add (a b : ℚ) (m n : ℕ) : a^(m+n) = a^m*a^n := by auto
+ rat_add_reverse (a b : ℚ) (m n : ℕ) : a^m*a^n = a^(m+n) := by auto
+ rat_multiply (a b : ℚ) (m n : ℕ) : a^(m*n) = (a^m)^n := by auto
+ rat_multiply_reverse (a b : ℚ) (m n : ℕ) : (a^m)^n = a^(m*n) := by auto
+ rat_product (a b : ℚ) (m n : ℕ) : (a*b)^n = a^n*b^n := by auto
+ rat_product_reverse (a b : ℚ) (m n : ℕ) : a^n*b^n = (a*b)^n := by auto
+ rat_expression_base (a b : ℚ) (m n : ℕ) : ((a+b)*(a+1))^n = (a+b)^n*(a+1)^n := by auto
+ rat_expression_exponent (a b : ℚ) (m n : ℕ) : a^((m+1)*(n+2)) = (a^(m+1))^(n+2) := by auto
+ real_add (a b : ℝ) (m n : ℕ) : a^(m+n) = a^m*a^n := by auto
+ real_add_reverse (a b : ℝ) (m n : ℕ) : a^m*a^n = a^(m+n) := by auto
+ real_multiply (a b : ℝ) (m n : ℕ) : a^(m*n) = (a^m)^n := by auto
+ real_multiply_reverse (a b : ℝ) (m n : ℕ) : (a^m)^n = a^(m*n) := by auto
+ real_product (a b : ℝ) (m n : ℕ) : (a*b)^n = a^n*b^n := by auto
+ real_product_reverse (a b : ℝ) (m n : ℕ) : a^n*b^n = (a*b)^n := by auto
+ real_expression_base (a b : ℝ) (m n : ℕ) : ((a+b)*(a+1))^n = (a+b)^n*(a+1)^n := by auto
+ real_expression_exponent (a b : ℝ) (m n : ℕ) : a^((m+1)*(n+2)) = (a^(m+1))^(n+2) := by auto
