import power
+ nat_sum_base (a b : ℕ) (m n : ℕ) : (a+b)^n = a^n+b^n := by auto
+ nat_wrong_add (a b : ℕ) (m n : ℕ) : a^(m+n) = a^m+a^n := by auto
+ nat_wrong_multiply (a b : ℕ) (m n : ℕ) : a^(m*n) = a^m*a^n := by auto
+ nat_wrong_index (a b : ℕ) (m n : ℕ) : (a*b)^n = a^n*b^m := by auto
+ nat_wrong_nesting (a b : ℕ) (m n : ℕ) : (a^m)^n = a^(m+n) := by auto
