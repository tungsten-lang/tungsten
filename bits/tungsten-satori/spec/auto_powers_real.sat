import arith

+ nonnegative (a : ℝ) (n : ℕ) (h : 0 ≤ a) : 0 ≤ a^n
  auto

+ positive (a : ℝ) (n : ℕ) (h : 0 < a) : 0 < a^n
  auto

+ unit_lower (a : ℝ) (n : ℕ) (h : 1 ≤ a) : 1 ≤ a^n
  auto

+ unit_upper (a : ℝ) (n : ℕ) (h0 : 0 ≤ a) (h1 : a ≤ 1) : a^n ≤ 1
  auto

+ base_order (a b : ℝ) (n : ℕ) (h0 : 0 ≤ a) (h : a ≤ b) : a^n ≤ b^n
  auto

+ base_strict (a b : ℝ) (n : ℕ) (h0 : 0 ≤ a) (h : a < b) (hn : 0 < n) : a^n < b^n
  auto

+ exponent_order (a : ℝ) (m n : ℕ) (h : 1 ≤ a) (hmn : m ≤ n) : a^m ≤ a^n
  auto

+ exponent_strict (a : ℝ) (m n : ℕ) (h : 1 < a) (hmn : m < n) : a^m < a^n
  auto

+ derived_sign (x : ℝ) (n : ℕ) (hx : 3 ≤ x) : 0 < (x-1)^n
  auto

+ nested (a b : ℝ) (m n : ℕ) (h0 : 0 ≤ a) (h : a ≤ b) : (a^m)^n ≤ (b^m)^n
  auto

+ pointwise (f g : ℕ → ℝ) (h0 : ∀ i, 0 ≤ f i) (h : ∀ i, f i ≤ g i) (i n : ℕ) : f i ^ n ≤ g i ^ n
  auto

+ large_exponent (a : ℝ) (h : 0 < a) : 0 < a^64
  auto

+ decay (a : ℝ) (m n : ℕ) (h0 : 0 ≤ a) (h1 : a ≤ 1) (h : m ≤ n) : a^n ≤ a^m
  auto

opaque a : ℝ
axiom supplied_positive : 0 < a

+ explicit_bound (n : ℕ) : 0 < a^n
  auto [supplied_positive]
