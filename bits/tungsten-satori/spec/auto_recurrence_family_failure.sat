  auto

+ int_wrong_parameter (f : ℕ → ℤ → ℤ) (n : ℕ) (a c : ℤ)
    (base : ∀ b, f 0 b = b) (step : ∀ i b, f (i+1) b = f i (b+1)) : f n a = c+count.int n
  auto

