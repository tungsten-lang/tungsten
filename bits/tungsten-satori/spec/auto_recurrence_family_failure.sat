  auto

+ rat_next_index (f : ℕ → ℚ → ℚ) (n : ℕ) (a : ℚ) (base : ∀ b, f 0 b = b) (step : ∀ i b, f (i+1) b = f (i+1) b) : f n a = a+count.rat n
  auto

+ rat_wrong_parameter (f : ℕ → ℚ → ℚ) (n : ℕ) (a c : ℚ)
    (base : ∀ b, f 0 b = b) (step : ∀ i b, f (i+1) b = f i (b+1)) : f n a = c+count.rat n
  auto

