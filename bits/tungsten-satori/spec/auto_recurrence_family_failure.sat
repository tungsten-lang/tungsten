+ rat_point_step (f : ℕ → ℚ → ℚ) (n : ℕ) (a : ℚ) (base : ∀ b, f 0 b = b) (step : ∀ i, f (i+1) a = f i (a+1)) : f n a = a+count.rat n
  auto

+ rat_missing_base (f : ℕ → ℚ → ℚ) (n : ℕ) (a : ℚ) (step : ∀ i b, f (i+1) b = f i (b+1)) : f n a = a+count.rat n
  auto

+ rat_missing_step (f : ℕ → ℚ → ℚ) (n : ℕ) (a : ℚ) (base : ∀ b, f 0 b = b) : f n a = a+count.rat n
  auto

