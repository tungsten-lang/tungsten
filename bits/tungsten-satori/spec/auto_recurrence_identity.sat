import recurrence

-> butterfly.nat : ℕ → ℕ
  | 0 => 0
  | i+1 => 2*butterfly.nat i+2^i
-> weighted.nat : ℕ → ℕ
  | 0 => 0
  | i+1 => weighted.nat i+(i+1)*2^i

+ nat_defined (n : ℕ) : 2*butterfly.nat n = n*2^n
  auto

+ nat_reverse (n : ℕ) : n*2^n = 2*butterfly.nat n
  auto

+ nat_forcing (f : ℕ → ℕ) (r c A : ℕ) (n : ℕ) (base : f 0 = A) (step : ∀ i, f (i+1) = r*f i+c*r^i) : r*f n = (r*A+c*n)*r^n
  auto

+ nat_first_index (f : ℕ → ℕ → ℕ) (n a : ℕ) (base : f 0 a = 0) (step : ∀ i, f (i+1) a = 2*f i a+2^i) : 2*f n a = n*2^n
  auto

+ nat_product_rates (f : ℕ → ℕ) (r q A : ℕ) (n : ℕ) (base : f 0 = A) (step : ∀ i, f (i+1) = (r*q)*f i) : f n = A*r^n*q^n
  auto

+ nat_two_rates (f : ℕ → ℕ) (n : ℕ) (base : f 0 = 0) (step : ∀ i, f (i+1) = 2*f i+3^i) : f n+2^n = 3^n
  auto

+ nat_weighted (n : ℕ) : weighted.nat n+2^n = 1+n*2^n
  auto

+ nat_shift1 (f : ℕ → ℕ) (r A : ℕ) (n : ℕ) (base : f 0 = A*r^1) (step : ∀ i, f (i+1) = r*f i) : f n = A*r^(n+1)
  auto

+ nat_shift2 (f : ℕ → ℕ) (r A : ℕ) (n : ℕ) (base : f 0 = A*r^2) (step : ∀ i, f (i+1) = r*f i) : f n = A*r^(n+2)
  auto

+ nat_shift3 (f : ℕ → ℕ) (r A : ℕ) (n : ℕ) (base : f 0 = A*r^3) (step : ∀ i, f (i+1) = r*f i) : f n = A*r^(n+3)
  auto

-> butterfly.int : ℕ → ℤ
  | 0 => 0
  | i+1 => 2*butterfly.int i+2^i
-> weighted.int : ℕ → ℤ
  | 0 => 0
  | i+1 => weighted.int i+((i : ℤ)+1)*2^i

+ int_defined (n : ℕ) : 2*butterfly.int n = (n : ℤ)*2^n
  auto

+ int_reverse (n : ℕ) : (n : ℤ)*2^n = 2*butterfly.int n
  auto

+ int_forcing (f : ℕ → ℤ) (r c A : ℤ) (n : ℕ) (base : f 0 = A) (step : ∀ i, f (i+1) = r*f i+c*r^i) : r*f n = (r*A+c*(n : ℤ))*r^n
  auto

+ int_first_index (f : ℕ → ℕ → ℤ) (n a : ℕ) (base : f 0 a = 0) (step : ∀ i, f (i+1) a = 2*f i a+2^i) : 2*f n a = (n : ℤ)*2^n
  auto

+ int_product_rates (f : ℕ → ℤ) (r q A : ℤ) (n : ℕ) (base : f 0 = A) (step : ∀ i, f (i+1) = (r*q)*f i) : f n = A*r^n*q^n
  auto

+ int_two_rates (f : ℕ → ℤ) (n : ℕ) (base : f 0 = 0) (step : ∀ i, f (i+1) = 2*f i+3^i) : f n+2^n = 3^n
  auto

+ int_weighted (n : ℕ) : weighted.int n+2^n = 1+(n : ℤ)*2^n
  auto

+ int_shift1 (f : ℕ → ℤ) (r A : ℤ) (n : ℕ) (base : f 0 = A*r^1) (step : ∀ i, f (i+1) = r*f i) : f n = A*r^(n+1)
  auto

+ int_shift2 (f : ℕ → ℤ) (r A : ℤ) (n : ℕ) (base : f 0 = A*r^2) (step : ∀ i, f (i+1) = r*f i) : f n = A*r^(n+2)
  auto

+ int_shift3 (f : ℕ → ℤ) (r A : ℤ) (n : ℕ) (base : f 0 = A*r^3) (step : ∀ i, f (i+1) = r*f i) : f n = A*r^(n+3)
  auto

-> butterfly.rat : ℕ → ℚ
  | 0 => 0
  | i+1 => 2*butterfly.rat i+2^i
-> weighted.rat : ℕ → ℚ
  | 0 => 0
  | i+1 => weighted.rat i+((i : ℚ)+1)*2^i

+ rat_defined (n : ℕ) : 2*butterfly.rat n = (n : ℚ)*2^n
  auto

+ rat_reverse (n : ℕ) : (n : ℚ)*2^n = 2*butterfly.rat n
  auto

+ rat_forcing (f : ℕ → ℚ) (r c A : ℚ) (n : ℕ) (base : f 0 = A) (step : ∀ i, f (i+1) = r*f i+c*r^i) : r*f n = (r*A+c*(n : ℚ))*r^n
  auto

+ rat_first_index (f : ℕ → ℕ → ℚ) (n a : ℕ) (base : f 0 a = 0) (step : ∀ i, f (i+1) a = 2*f i a+2^i) : 2*f n a = (n : ℚ)*2^n
  auto

+ rat_product_rates (f : ℕ → ℚ) (r q A : ℚ) (n : ℕ) (base : f 0 = A) (step : ∀ i, f (i+1) = (r*q)*f i) : f n = A*r^n*q^n
  auto

+ rat_two_rates (f : ℕ → ℚ) (n : ℕ) (base : f 0 = 0) (step : ∀ i, f (i+1) = 2*f i+3^i) : f n+2^n = 3^n
  auto

+ rat_weighted (n : ℕ) : weighted.rat n+2^n = 1+(n : ℚ)*2^n
  auto

+ rat_shift1 (f : ℕ → ℚ) (r A : ℚ) (n : ℕ) (base : f 0 = A*r^1) (step : ∀ i, f (i+1) = r*f i) : f n = A*r^(n+1)
  auto

+ rat_shift2 (f : ℕ → ℚ) (r A : ℚ) (n : ℕ) (base : f 0 = A*r^2) (step : ∀ i, f (i+1) = r*f i) : f n = A*r^(n+2)
  auto

+ rat_shift3 (f : ℕ → ℚ) (r A : ℚ) (n : ℕ) (base : f 0 = A*r^3) (step : ∀ i, f (i+1) = r*f i) : f n = A*r^(n+3)
  auto

-> butterfly.real : ℕ → ℝ
  | 0 => 0
  | i+1 => 2*butterfly.real i+2^i
-> weighted.real : ℕ → ℝ
  | 0 => 0
  | i+1 => weighted.real i+((i : ℝ)+1)*2^i

+ real_defined (n : ℕ) : 2*butterfly.real n = (n : ℝ)*2^n
  auto

+ real_reverse (n : ℕ) : (n : ℝ)*2^n = 2*butterfly.real n
  auto

+ real_forcing (f : ℕ → ℝ) (r c A : ℝ) (n : ℕ) (base : f 0 = A) (step : ∀ i, f (i+1) = r*f i+c*r^i) : r*f n = (r*A+c*(n : ℝ))*r^n
  auto

+ real_first_index (f : ℕ → ℕ → ℝ) (n a : ℕ) (base : f 0 a = 0) (step : ∀ i, f (i+1) a = 2*f i a+2^i) : 2*f n a = (n : ℝ)*2^n
  auto

+ real_product_rates (f : ℕ → ℝ) (r q A : ℝ) (n : ℕ) (base : f 0 = A) (step : ∀ i, f (i+1) = (r*q)*f i) : f n = A*r^n*q^n
  auto

+ real_two_rates (f : ℕ → ℝ) (n : ℕ) (base : f 0 = 0) (step : ∀ i, f (i+1) = 2*f i+3^i) : f n+2^n = 3^n
  auto

+ real_weighted (n : ℕ) : weighted.real n+2^n = 1+(n : ℝ)*2^n
  auto

+ real_shift1 (f : ℕ → ℝ) (r A : ℝ) (n : ℕ) (base : f 0 = A*r^1) (step : ∀ i, f (i+1) = r*f i) : f n = A*r^(n+1)
  auto

+ real_shift2 (f : ℕ → ℝ) (r A : ℝ) (n : ℕ) (base : f 0 = A*r^2) (step : ∀ i, f (i+1) = r*f i) : f n = A*r^(n+2)
  auto

+ real_shift3 (f : ℕ → ℝ) (r A : ℝ) (n : ℕ) (base : f 0 = A*r^3) (step : ∀ i, f (i+1) = r*f i) : f n = A*r^(n+3)
  auto
-> chacon : ℕ → ℕ
  | 0 => 1
  | k+1 => 3*chacon k+1
-> merge_cost : ℕ → ℕ
  | 0 => 0
  | k+1 => merge_cost k+2*2^k
+ chacon_closed (k : ℕ) : 2*chacon k+1 = 3^(k+1) := by auto
+ merge_cost_closed (k : ℕ) : merge_cost k+2 = 2^(k+1) := by auto
-> quarter (j : ℕ) : ℚ := (1/4)^j
-> weight (j : ℕ) : ℚ := ((j : ℚ)+1)*(1/4)^j
+ mass_closed (n : ℕ) : sum_below n quarter = 4/3-4/3*(1/4)^n := by auto
+ entropy_closed (n : ℕ) : sum_below n weight = 16/9-(1/4)^n*(4/3*(n : ℚ)+16/9) := by auto
