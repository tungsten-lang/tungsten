  auto

+ rat_negative_scale (a b c d : ℚ) (q : ∀ x y : ℚ, 0 ≤ x^2*a-2*x*y*b+y^2*c) (h : a*c ≤ d) : -2*b^2 ≤ -2*d
  auto

+ rat_missing_guard (a b c d : ℚ) (P : Prop) (q : P → ∀ x y : ℚ, 0 ≤ x^2*a-2*x*y*b+y^2*c) (h : a*c ≤ d) : b^2 ≤ d
  auto

