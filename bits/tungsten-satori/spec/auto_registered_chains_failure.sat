import quadratic

+ int_no_form (a b c d : ℤ) (h : a*c ≤ d) : b^2 ≤ d
  auto

+ int_no_upper (a b c d : ℤ) (q : ∀ x y : ℤ, 0 ≤ x^2*a-2*x*y*b+y^2*c) : b^2 ≤ d
  auto

+ int_wrong_upper (a b c d : ℤ) (q : ∀ x y : ℤ, 0 ≤ x^2*a-2*x*y*b+y^2*c) (h : d ≤ a*c) : b^2 ≤ d
  auto

+ int_strict_without_margin (a b c d : ℤ) (q : ∀ x y : ℤ, 0 ≤ x^2*a-2*x*y*b+y^2*c) (h : a*c ≤ d) : b^2 < d
  auto

+ int_negative_scale (a b c d : ℤ) (q : ∀ x y : ℤ, 0 ≤ x^2*a-2*x*y*b+y^2*c) (h : a*c ≤ d) : -2*b^2 ≤ -2*d
  auto

+ int_missing_guard (a b c d : ℤ) (P : Prop) (q : P → ∀ x y : ℤ, 0 ≤ x^2*a-2*x*y*b+y^2*c) (h : a*c ≤ d) : b^2 ≤ d
  auto

