+ wrong_value (n : ℕ) (h : n % 4 = 3) : even n := by auto
+ mixed_branches (n : ℤ) (h : n % 4 = 1 ∨ n % 4 = 2) : odd n := by auto
+ mirrored_branches (n : ℤ) (h : n % 4 = 2 ∨ n % 4 = 3) : odd n := by auto
+ unrelated (n m : ℕ) (h : m % 4 = 3) : odd n := by auto
+ nonfactor (n : ℤ) (h : n % 6 = 5) : n % 4 = 1 := by auto
+ finer (n : ℤ) (h : odd n) : n % 4 = 1 := by auto
+ zero_target (n : ℤ) (h : n % 4 = 3) : n % 0 = 3 := by auto
+ zero_source (n : ℕ) (h : n % 0 = 2) : odd n := by auto
+ variable_source (n k : ℤ) (h : n % k = 1) : odd n := by auto
+ negative_source (n : ℤ) (h : n % (-4) = -2) : odd n := by auto
+ wrong_sum (n : ℤ) (h : n % 5 = 2) : (2*n+1) % 5 = 1 := by auto
+ unknown_factor (a b : ℕ) (h : a % 7 = 2) : a*b % 7 = 4 := by auto
+ missing_branch (n : ℤ) (h : n % 5 = 2 ∨ n % 5 = 4) : n*n % 5 = 4 := by auto
+ wrong_modulus (n : ℕ) (h : n % 3 = 2) : (2*n+1) % 5 = 0 := by auto

+ compatible (n : ℤ) (a : n % 4 = 1) (b : n % 6 = 3) : False := by auto
+ coprime (n : ℕ) (a : n % 3 = 1) (b : n % 5 = 2) : False := by auto
+ different_dividends (n m : ℤ) (a : n % 4 = 1) (b : m % 6 = 2) : False := by auto
+ separate_cases (n : ℕ) (h : n % 4 = 1 ∨ n % 6 = 2) : False := by auto
+ viable_case (n : ℤ) (P : Prop) (a : n % 4 = 1) (b : n % 6 = 3 ∨ P) : P := by auto
+ variable_modulus (n k : ℕ) (a : n % k = 1) (b : n % 6 = 2) : False := by auto
+ zero_modulus (n : ℕ) (a : n % 0 = 1) (b : n % 6 = 1) : False := by auto

+ reachable_offset (q : ℕ) : 2 * (6*q + 1) % 9 ≠ 5 := by auto
+ partially_known (q : ℤ) : (12*q + 2) % 9 = 2 := by auto
+ free_cofactor (x y : ℕ) : (3*x + y) % 6 ≠ 2 := by auto
+ truncated_difference (n : ℕ) : (1 - 3*n) % 3 = 1 := by auto
+ unrelated_case (q : ℤ) (P : Prop) (h : (12*q + 2) % 9 = 5 ∨ P) : P := by auto

+ exponent_may_vanish (a n : ℕ) (base : a % 10 = 6) : a ^ n % 10 = 6 := by auto
+ changing_residue (a : ℤ) (j : ℕ) (base : a % 5 = 2) : a ^ (j + 1) % 5 = 2 := by auto
+ power_of_zero_at_zero (n : ℕ) : (0 : ℕ) ^ n % 3 = 0 := by auto
+ separate_exponents (x : ℤ) (n : ℕ) (h : x % 10 = 6) (P : Prop) (cases : 0 < n ∨ P) : x ^ n % 10 = 6 := by auto

+ wrong_quotient (n : ℕ) (h : n % 5 = 1) : ∃ q, n = 5*q + 2 := by auto
+ wrong_divisor (n : ℤ) (h : n % 4 = 1) : ∃ q, 1 + q*6 = n := by auto
+ dependent_coefficient (n : ℕ) (h : n % 3 = 1) : ∃ q, n = q*q + 1 := by auto
+ dependent_remainder (n : ℕ) (h : n % 3 = 1) : ∃ q, n = 3*q + q := by auto
+ different_branches (n : ℕ) (P : Prop) (h : n % 5 = 1 ∨ P) : ∃ q, n = 5*q + 1 := by auto

+ missing_class (n : ℕ) : ∃ q, n = 3*q ∨ n = 3*q+1 := by auto
+ wrong_offset (n : ℕ) : ∃ q, n = 2*q ∨ n = 2*q+3 := by auto
+ mixed_dividends (n k : ℤ) : (∃ q, n = 2*q) ∨ ∃ q, k = 2*q+1 := by auto
+ simultaneous_parities (n : ℤ) : ∃ q, n = 2*q ∧ n = 2*q+1 := by auto

+ zero_dividend (m : ℕ) (h : m ∣ 0) : m ≤ 0 := by auto [le_of_dvd.nat]
+ negative_dividend (a m : ℤ) (h : a < m) : a % m = a := by auto
+ dividend_at_boundary (a m : ℕ) (h : a ≤ m) : a / m = 0 := by auto
