opaque measure_nat : ℕ → ℕ → ℕ
opaque allowed_nat : ℕ → ℕ → bool
axiom measure_nat_formula : ∀ a b, measure_nat a b = 12*(a*b)^2
axiom measure_nat_guarded : ∀ a b, allowed_nat a b → measure_nat a b = 12*(a*b)^2
+ nat_zero (a b c d : ℕ) (h : measure_nat a b + measure_nat c d = 0) : a*b = 0 ∧ c*d = 0
  auto [measure_nat_formula]

+ nat_upper (a b : ℕ) (h : measure_nat a b ≤ 0) : a*b = 0
  auto [measure_nat_formula]

+ nat_local (a b c d : ℕ) (h : measure_nat a b + measure_nat c d = 0) : a*b = 0
  have formula := measure_nat_formula
  auto [formula]

+ nat_guarded (a b : ℕ) (ha : allowed_nat a b) (h : measure_nat a b = 0) : a*b = 0
  auto [measure_nat_guarded]

+ nat_applied (a b : ℕ) (ha : allowed_nat a b) (h : measure_nat a b = 0) : a*b = 0
  auto [measure_nat_guarded a b ha]

