opaque measure_nat : ℕ → ℕ → ℕ
opaque allowed_nat : ℕ → ℕ → bool
axiom measure_nat_formula : ∀ a b, measure_nat a b = 12*(a*b)^2
axiom measure_nat_guarded : ∀ a b, allowed_nat a b → measure_nat a b = 12*(a*b)^2
+ nat_unsupplied (a b : ℕ) (h : measure_nat a b = 0) : a*b = 0
  auto

+ nat_missing_guard (a b : ℕ) (h : measure_nat a b = 0) : a*b = 0
  auto [measure_nat_guarded]

+ nat_wrong_guard (a b c : ℕ) (ha : allowed_nat a c) (h : measure_nat a b = 0) : a*b = 0
  auto [measure_nat_guarded]

+ nat_wrong_component (a b c : ℕ) (h : measure_nat a b = 0) : a*c = 0
  auto [measure_nat_formula]

+ nat_nonzero_total (a b : ℕ) (h : measure_nat a b = 12) : a*b = 0
  auto [measure_nat_formula]

+ nat_strict (a b : ℕ) (h : measure_nat a b ≤ 0) : a*b < 0
  auto [measure_nat_formula]

