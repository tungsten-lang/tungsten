import sequence_order

+ nat_up (f : ℕ → ℕ) (a b : ℕ) (ab : a ≤ b) (h : ∀ i, a ≤ i → i < b → f i ≤ f (i+1)) : f a ≤ f b
  auto

+ nat_down (f : ℕ → ℕ) (a b : ℕ) (ab : a ≤ b) (h : ∀ i, a ≤ i → i < b → f (i+1) ≤ f i) : f b ≤ f a
  auto

+ nat_global_up (f : ℕ → ℕ) (a b : ℕ) (ab : a ≤ b) (h : ∀ i, f i ≤ f (i+1)) : f a ≤ f b
  auto

+ nat_global_down (f : ℕ → ℕ) (a b : ℕ) (ab : a ≤ b) (h : ∀ i, f (i+1) ≤ f i) : f b ≤ f a
  auto

+ nat_prefix (f : ℕ → ℕ) (a b : ℕ) (ab : a ≤ b) (h : ∀ i < b, f i ≤ f (i+1)) : f a ≤ f b
  auto

+ nat_quantified (f : ℕ → ℕ) (h : ∀ i, f (i+1) ≤ f i) : ∀ a b, a ≤ b → f b ≤ f a
  auto

+ nat_wider (f : ℕ → ℕ) (a b : ℕ) (ab : a ≤ b) (h : ∀ i < b+3, f (i+1) ≤ f i) : f b ≤ f a
  auto

+ nat_strict_step (f : ℕ → ℕ) (a b : ℕ) (ab : a ≤ b) (h : ∀ i, a ≤ i → i < b → f i < f (i+1)) : f a ≤ f b
  auto

+ nat_descent (f : ℕ → ℕ) (n : ℕ) (h : ∀ i < n, f (i+1)+1 ≤ f i) : f n+n ≤ f 0
  auto

+ nat_length (f : ℕ → ℕ) (n : ℕ) (h : ∀ i < n, f (i+1)+1 ≤ f i) : n ≤ f 0
  auto

+ nat_strict_descent (f : ℕ → ℕ) (n : ℕ) (h : ∀ i < n, f (i+1) < f i) : f n+n ≤ f 0
  auto

+ nat_descent_quantified (f : ℕ → ℕ) : ∀ n, (∀ i < n, f (i+1)+1 ≤ f i) → f n+n ≤ f 0
  auto

