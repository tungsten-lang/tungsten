  auto

+ real_value_from_arithmetic (f : ℕ → ℝ) (n j : ℕ) (v : ℝ) (hj : j < n) (h : f j+3 = v+3) : (∑ i < n, f i*(if i=j then 1 else 0)) = v
  auto
