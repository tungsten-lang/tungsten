  auto

+ real_calculated_value (f : ℕ → ℝ) (n j : ℕ) (v : ℝ) (hj : j < n) (h : f j+3 = v+2) : (∑ i < n, f i*(if i=j then 1 else 0))+1 = v
  have e : (∑ i < n, f i*(if i=j then 1 else 0)) = f j := by auto
  linarith

+ nat_value_from_arithmetic (f : ℕ → ℕ) (n j : ℕ) (v : ℕ) (hj : j < n) (h : f j+3 = v+3) : (∑ i < n, f i*(if i=j then 1 else 0)) = v
  auto

+ int_value_from_arithmetic (f : ℕ → ℤ) (n j : ℕ) (v : ℤ) (hj : j < n) (h : f j+3 = v+3) : (∑ i < n, f i*(if i=j then 1 else 0)) = v
