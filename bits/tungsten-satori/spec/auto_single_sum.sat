+ real_nested (f : ℕ → ℕ → ℝ) (n m j k : ℕ) (hj : j < n) (hk : k < m) : (∑ i < n, (∑ l < m, f i l*(if l=k then 1 else 0))*(if i=j then 1 else 0)) = f j k
  auto

+ nat_known_value (f : ℕ → ℕ) (n j : ℕ) (v : ℕ) (hj : j < n) (h : f j = v) : (∑ i < n, f i*(if i=j then 1 else 0)) = v
  auto

+ nat_calculated_value (f : ℕ → ℕ) (n j : ℕ) (v : ℕ) (hj : j < n) (h : f j+3 = v+2) : (∑ i < n, f i*(if i=j then 1 else 0))+1 = v
  have e : (∑ i < n, f i*(if i=j then 1 else 0)) = f j := by auto
  linarith

+ int_known_value (f : ℕ → ℤ) (n j : ℕ) (v : ℤ) (hj : j < n) (h : f j = v) : (∑ i < n, f i*(if i=j then 1 else 0)) = v
  auto

+ int_calculated_value (f : ℕ → ℤ) (n j : ℕ) (v : ℤ) (hj : j < n) (h : f j+3 = v+2) : (∑ i < n, f i*(if i=j then 1 else 0))+1 = v
  have e : (∑ i < n, f i*(if i=j then 1 else 0)) = f j := by auto
  linarith

+ rat_known_value (f : ℕ → ℚ) (n j : ℕ) (v : ℚ) (hj : j < n) (h : f j = v) : (∑ i < n, f i*(if i=j then 1 else 0)) = v
  auto

+ rat_calculated_value (f : ℕ → ℚ) (n j : ℕ) (v : ℚ) (hj : j < n) (h : f j+3 = v+2) : (∑ i < n, f i*(if i=j then 1 else 0))+1 = v
