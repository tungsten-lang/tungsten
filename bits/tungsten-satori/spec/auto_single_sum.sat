+ rat_nested (f : ℕ → ℕ → ℚ) (n m j k : ℕ) (hj : j < n) (hk : k < m) : (∑ i < n, (∑ l < m, f i l*(if l=k then 1 else 0))*(if i=j then 1 else 0)) = f j k
  auto

+ real_inside (f : ℕ → ℝ) (n j : ℕ) (h : j < n) : (∑ i < n, f i*(if i=j then 1 else 0)) = f j
  auto

+ real_outside (f : ℕ → ℝ) (n j : ℕ) (h : n ≤ j) : (∑ i < n, f i*(if i=j then 1 else 0)) = 0
  auto

+ real_boundary (f : ℕ → ℝ) (n : ℕ) : (∑ i < n, f i*(if i=n then 1 else 0)) = 0
  auto

+ real_last (f : ℕ → ℝ) (n : ℕ) : (∑ i < n+1, f i*(if i=n then 1 else 0)) = f n
  auto

+ real_larger (f : ℕ → ℝ) (n m j : ℕ) (h : j < n) (hm : n ≤ m) : (∑ i < m, f i*(if i=j then 1 else 0)) = f j
  auto

+ real_alias (f : ℕ → ℝ) (n j : ℕ) (h : j < n) : (∑ i < n, real_pick f j i) = f j
  auto

+ real_product (f g : ℕ → ℝ) (n j : ℕ) (h : j < n) : (∑ i < n, (f i*g i)*(if i=j then 1 else 0)) = f j*g j
