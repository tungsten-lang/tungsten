+ generic (f : ℕ → α) (n j : ℕ) (h : j < n) : (∑ i < n, f i*(if i=j then 1 else 0)) = f j
  auto

+ nat_wrong_value_index (f : ℕ → ℕ) (n j k : ℕ) (v : ℕ) (hj : j < n) (h : f k = v) : (∑ i < n, f i*(if i=j then 1 else 0)) = v
  auto

+ nat_unproved_value (f : ℕ → ℕ) (n j : ℕ) (v : ℕ) (p : Prop) (hj : j < n) (h : p → f j = v) : (∑ i < n, f i*(if i=j then 1 else 0)) = v
  auto

+ nat_missing_inner (f : ℕ → ℕ → ℕ) (n m j k : ℕ) (hj : j < n) : (∑ i < n, (∑ l < m, f i l*(if l=k then 1 else 0))*(if i=j then 1 else 0)) = f j k
  auto

+ int_wrong_value_index (f : ℕ → ℤ) (n j k : ℕ) (v : ℤ) (hj : j < n) (h : f k = v) : (∑ i < n, f i*(if i=j then 1 else 0)) = v
  auto

