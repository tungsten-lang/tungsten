import arith

+ nat_missing_inside (f : ℕ → ℕ) (n j : ℕ) : (∑ i < n, f i*(if i=j then 1 else 0)) = f j
  auto

+ nat_missing_outside (f : ℕ → ℕ) (n j : ℕ) : (∑ i < n, f i*(if i=j then 1 else 0)) = 0
  auto

+ nat_closed_inside (f : ℕ → ℕ) (n j : ℕ) (h : j ≤ n) : (∑ i < n, f i*(if i=j then 1 else 0)) = f j
  auto

