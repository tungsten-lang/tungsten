  auto

+ nat_wrong_value (f : ℕ → ℕ) (n j : ℕ) (h : j < n) : (∑ i < n, f i*(if i=j then 2 else 0)) = f j
  auto

+ nat_nonzero_else (f : ℕ → ℕ) (n j : ℕ) (h : j < n) : (∑ i < n, f i*(if i=j then 1 else 1)) = f j
