+ unsupplied (x y v w : ℚ) (h : square_ready x v w) : 2*x*y+v*x^2 ≤ (w+1)*x^2+y^2
  auto
+ missing_guard (x y v w : ℚ) : 2*x*y+v*x^2 ≤ (w+1)*x^2+y^2
  auto [supplied_square_bound]
+ wrong_guard (x y v w : ℚ) (h : square_ready y v w) : 2*x*y+v*x^2 ≤ (w+1)*x^2+y^2
  auto [supplied_square_bound]
+ wrong_strict (x y v w : ℚ) (h : square_ready x v w) : 2*x*y+v*x^2 < (w+1)*x^2+y^2
  auto [supplied_square_bound]

+ local_wrong_guard (x y v w : ℚ) (h : square_ready y v w)
    (bound : ∀ a b c : ℚ, square_ready a b c → b*a^2 ≤ c*a^2) :
    2*x*y+v*x^2 ≤ (w+1)*x^2+y^2
  auto
