opaque score : ℤ → ℤ
axiom score_bound (x : ℤ) : score x ≤ x

+ squares (b c d : ℚ) (h : b^2 ≤ c) (k : c ≤ d) : b^2 < d
  auto

+ reversed (x y : ℕ) (h : y ≤ x) : x > y
  auto

+ supplied (x : ℤ) : score x < x
  auto [score_bound]

+ padded (x y : ℤ) (h : x + 0 ≤ y) : x + 0 < y
  auto

@[simp] axiom score_inj (x y : ℤ) : score x = score y ↔ x = y
+ guarded (x y : ℤ) (h : score x ≤ score y) : score x < score y
  auto

+ focused (x y : ℝ) (p : Prop) (hp : p) (h : x ≤ y) : p ∧ x < y
  auto

+ no_bound (x : ℤ) : score x < x
  auto

+ wrong_direction (x y : ℚ) (h : y ≤ x) : x < y
  auto

+ unrelated (p : Prop) : p
  auto

+ alternative (x y : ℚ) (h : x ≤ y) (p : Prop) : x < y ∨ p
  auto

+ strict (a b c : ℚ) (h : a ≤ b) (k : b < c) : a < c
  auto

opaque mirror : ℤ → ℤ
@[simp] axiom mirror_score (x : ℤ) : mirror x = score x
+ implicit_tie (x : ℤ) (h : mirror x ≤ score x) : mirror x < score x := by auto
