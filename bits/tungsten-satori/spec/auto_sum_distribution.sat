+ real_triangle (f : ℕ → ℝ) (n a b c : ℕ) (ha : a < n) (hb : b < n) (hc : c < n) : (∑ i < n, f i*((if i=a then 1 else 0)+(if i=b then 1 else 0)-(if i=c then 1 else 0))) = f a+f b-f c
