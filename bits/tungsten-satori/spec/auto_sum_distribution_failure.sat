+ natural_difference (f : ℕ → ℕ) (n a b : ℕ) (ha : a < n) (hb : b < n) : (∑ i < n, f i*((if i=a then 1 else 0)-(if i=b then 1 else 0))) = f a-f b
  auto

+ generic_pair (f : ℕ → α) (n a b : ℕ) (ha : a < n) (hb : b < n) : (∑ i < n, f i*((if i=a then 1 else 0)+(if i=b then 1 else 0))) = f a+f b
  auto
