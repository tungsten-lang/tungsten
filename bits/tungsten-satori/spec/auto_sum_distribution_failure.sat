import arith

+ nat_missing_range (f : ℕ → ℕ) (n a b : ℕ) (ha : a < n) : (∑ i < n, f i*((if i=a then 1 else 0)+(if i=b then 1 else 0))) = f a+f b
  auto

+ nat_closed_range (f : ℕ → ℕ) (n a b : ℕ) (ha : a ≤ n) (hb : b < n) : (∑ i < n, f i*((if i=a then 1 else 0)+(if i=b then 1 else 0))) = f a+f b
  auto

+ nat_wrong_weight (f : ℕ → ℕ) (n a b : ℕ) (ha : a < n) (hb : b < n) : (∑ i < n, f i*((if i=a then 2 else 0)+(if i=b then 1 else 0))) = f a+f b
  auto

+ nat_wrong_sign (f : ℕ → ℕ) (n a b : ℕ) (ha : a < n) (hb : b < n) : (∑ i < n, f i*((if i=a then 1 else 0)+(if i=b then 1 else 0))) = f a-f b
  auto

+ nat_wrong_bound (f : ℕ → ℕ) (n a b : ℕ) (ha : a < n) (hb : b < n) : (∑ i < n, f i*((if i=a then 1 else 0)+(if i=b then 1 else 0)))+1 ≤ f a+f b
  auto

+ nat_branch_leak (f : ℕ → ℕ) (n a b : ℕ) (p : Prop) (ha : a < n) (hb : b < n ∨ p) : (∑ i < n, f i*((if i=a then 1 else 0)+(if i=b then 1 else 0))) = f a+f b
  auto

+ nat_conditional_guard (f : ℕ → ℕ) (n a b : ℕ) (p : Prop) (ha : a < n) (hb : p → b < n) : (∑ i < n, f i*((if i=a then 1 else 0)+(if i=b then 1 else 0))) = f a+f b
  auto

