+ rat_cycle (f g : ℕ → ℕ → ℚ) (u v : ℕ → ℚ) (n m : ℕ) (h : (∑ i < n, u i * (∑ j < m, f i j)) = (∑ j < m, v j * (∑ i < n, g j i)) → ∀ i < n, ∀ j < m, u i * f i j = v j * g j i) : (∑ i < n, u i * (∑ j < m, f i j)) = (∑ j < m, v j * (∑ i < n, g j i)) := by auto

+ real_missing (f g : ℕ → ℕ → ℝ) (u v : ℕ → ℝ) (n m : ℕ) : (∑ i < n, u i * (∑ j < m, f i j)) = (∑ j < m, v j * (∑ i < n, g j i)) := by auto

+ real_outside_i (f g : ℕ → ℕ → ℝ) (u v : ℕ → ℝ) (n m : ℕ) (h : ∀ i < n, ∀ j < m, u i * f i j = v j * g j i) : (∑ i < n+1, u i * (∑ j < m, f i j)) = (∑ j < m, v j * (∑ i < n+1, g j i)) := by auto

+ real_outside_j (f g : ℕ → ℕ → ℝ) (u v : ℕ → ℝ) (n m : ℕ) (h : ∀ i < n, ∀ j < m, u i * f i j = v j * g j i) : (∑ i < n, u i * (∑ j < m+1, f i j)) = (∑ j < m+1, v j * (∑ i < n, g j i)) := by auto

