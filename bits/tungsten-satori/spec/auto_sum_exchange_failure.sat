+ rat_wrong_entry (f g : ℕ → ℕ → ℚ) (u v : ℕ → ℚ) (n m : ℕ) (k : ℕ → ℕ → ℚ) (h : ∀ i < n, ∀ j < m, u i * f i j = v j * g j i) : (∑ i < n, u i * (∑ j < m, f i j)) = (∑ j < m, v j * (∑ i < n, k j i)) := by auto

