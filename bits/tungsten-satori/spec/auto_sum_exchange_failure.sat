import arith

+ nat_missing (f g : ℕ → ℕ → ℕ) (u v : ℕ → ℕ) (n m : ℕ) : (∑ i < n, u i * (∑ j < m, f i j)) = (∑ j < m, v j * (∑ i < n, g j i)) := by auto

+ nat_outside_i (f g : ℕ → ℕ → ℕ) (u v : ℕ → ℕ) (n m : ℕ) (h : ∀ i < n, ∀ j < m, u i * f i j = v j * g j i) : (∑ i < n+1, u i * (∑ j < m, f i j)) = (∑ j < m, v j * (∑ i < n+1, g j i)) := by auto

+ nat_outside_j (f g : ℕ → ℕ → ℕ) (u v : ℕ → ℕ) (n m : ℕ) (h : ∀ i < n, ∀ j < m, u i * f i j = v j * g j i) : (∑ i < n, u i * (∑ j < m+1, f i j)) = (∑ j < m+1, v j * (∑ i < n, g j i)) := by auto

+ nat_wrong_weight (f g : ℕ → ℕ → ℕ) (u v : ℕ → ℕ) (n m : ℕ) (w : ℕ → ℕ) (h : ∀ i < n, ∀ j < m, u i * f i j = v j * g j i) : (∑ i < n, u i * (∑ j < m, f i j)) = (∑ j < m, w j * (∑ i < n, g j i)) := by auto

+ nat_wrong_entry (f g : ℕ → ℕ → ℕ) (u v : ℕ → ℕ) (n m : ℕ) (k : ℕ → ℕ → ℕ) (h : ∀ i < n, ∀ j < m, u i * f i j = v j * g j i) : (∑ i < n, u i * (∑ j < m, f i j)) = (∑ j < m, v j * (∑ i < n, k j i)) := by auto

+ nat_weak (f g : ℕ → ℕ → ℕ) (u v : ℕ → ℕ) (n m : ℕ) (h : ∀ i < n, ∀ j < m, u i * f i j ≤ v j * g j i) : (∑ i < n, u i * (∑ j < m, f i j)) = (∑ j < m, v j * (∑ i < n, g j i)) := by auto

+ nat_cycle (f g : ℕ → ℕ → ℕ) (u v : ℕ → ℕ) (n m : ℕ) (h : (∑ i < n, u i * (∑ j < m, f i j)) = (∑ j < m, v j * (∑ i < n, g j i)) → ∀ i < n, ∀ j < m, u i * f i j = v j * g j i) : (∑ i < n, u i * (∑ j < m, f i j)) = (∑ j < m, v j * (∑ i < n, g j i)) := by auto

