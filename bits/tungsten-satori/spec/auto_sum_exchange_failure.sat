+ int_wrong_entry (f g : ℕ → ℕ → ℤ) (u v : ℕ → ℤ) (n m : ℕ) (k : ℕ → ℕ → ℤ) (h : ∀ i < n, ∀ j < m, u i * f i j = v j * g j i) : (∑ i < n, u i * (∑ j < m, f i j)) = (∑ j < m, v j * (∑ i < n, k j i)) := by auto

+ int_weak (f g : ℕ → ℕ → ℤ) (u v : ℕ → ℤ) (n m : ℕ) (h : ∀ i < n, ∀ j < m, u i * f i j ≤ v j * g j i) : (∑ i < n, u i * (∑ j < m, f i j)) = (∑ j < m, v j * (∑ i < n, g j i)) := by auto

