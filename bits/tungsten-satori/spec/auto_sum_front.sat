import arith

+ nat_direct (f : ℕ → ℕ) (n : ℕ) : (∑ i < n+1, f i) = f 0 + (∑ i < n, f (i+1)) := by auto

-> nat_tail (f : ℕ → ℕ) (i : ℕ) : ℕ := f (i+1)

+ nat_alias (f : ℕ → ℕ) (n : ℕ) : (∑ i < n+1, f i) = f 0 + (∑ i < n, nat_tail f i) := by auto

+ nat_product (f g : ℕ → ℕ) (n : ℕ) : (∑ i < n+1, f i * g i) = f 0 * g 0 + (∑ i < n, f (i+1) * g (i+1)) := by auto

+ nat_nested (f : ℕ → ℕ → ℕ) (n m : ℕ) : (∑ i < n+1, (∑ j < m, f i j)) = (∑ j < m, f 0 j) + (∑ i < n, (∑ j < m, f (i+1) j)) := by auto

+ int_direct (f : ℕ → ℤ) (n : ℕ) : (∑ i < n+1, f i) = f 0 + (∑ i < n, f (i+1)) := by auto

-> int_tail (f : ℕ → ℤ) (i : ℕ) : ℤ := f (i+1)

+ int_alias (f : ℕ → ℤ) (n : ℕ) : (∑ i < n+1, f i) = f 0 + (∑ i < n, int_tail f i) := by auto

+ int_product (f g : ℕ → ℤ) (n : ℕ) : (∑ i < n+1, f i * g i) = f 0 * g 0 + (∑ i < n, f (i+1) * g (i+1)) := by auto

+ int_nested (f : ℕ → ℕ → ℤ) (n m : ℕ) : (∑ i < n+1, (∑ j < m, f i j)) = (∑ j < m, f 0 j) + (∑ i < n, (∑ j < m, f (i+1) j)) := by auto

+ rat_direct (f : ℕ → ℚ) (n : ℕ) : (∑ i < n+1, f i) = f 0 + (∑ i < n, f (i+1)) := by auto

-> rat_tail (f : ℕ → ℚ) (i : ℕ) : ℚ := f (i+1)

+ rat_alias (f : ℕ → ℚ) (n : ℕ) : (∑ i < n+1, f i) = f 0 + (∑ i < n, rat_tail f i) := by auto

+ rat_product (f g : ℕ → ℚ) (n : ℕ) : (∑ i < n+1, f i * g i) = f 0 * g 0 + (∑ i < n, f (i+1) * g (i+1)) := by auto

+ rat_nested (f : ℕ → ℕ → ℚ) (n m : ℕ) : (∑ i < n+1, (∑ j < m, f i j)) = (∑ j < m, f 0 j) + (∑ i < n, (∑ j < m, f (i+1) j)) := by auto

+ real_direct (f : ℕ → ℝ) (n : ℕ) : (∑ i < n+1, f i) = f 0 + (∑ i < n, f (i+1)) := by auto

-> real_tail (f : ℕ → ℝ) (i : ℕ) : ℝ := f (i+1)

+ real_alias (f : ℕ → ℝ) (n : ℕ) : (∑ i < n+1, f i) = f 0 + (∑ i < n, real_tail f i) := by auto

+ real_product (f g : ℕ → ℝ) (n : ℕ) : (∑ i < n+1, f i * g i) = f 0 * g 0 + (∑ i < n, f (i+1) * g (i+1)) := by auto

+ real_nested (f : ℕ → ℕ → ℝ) (n m : ℕ) : (∑ i < n+1, (∑ j < m, f i j)) = (∑ j < m, f 0 j) + (∑ i < n, (∑ j < m, f (i+1) j)) := by auto
