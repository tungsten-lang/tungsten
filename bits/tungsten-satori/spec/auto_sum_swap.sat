import arith

+ nat_direct (f : ℕ → ℕ → ℕ) (n m : ℕ) : (∑ i < n, (∑ j < m, f i j)) = (∑ j < m, (∑ i < n, f i j)) := by auto

+ nat_reverse (f : ℕ → ℕ → ℕ) (n m : ℕ) : (∑ j < m, (∑ i < n, f i j)) = (∑ i < n, (∑ j < m, f i j)) := by auto

+ nat_weighted (f : ℕ → ℕ → ℕ) (w : ℕ → ℕ) (n m : ℕ) : (∑ i < n, (∑ j < m, w i * f i j)) = (∑ j < m, (∑ i < n, w i * f i j)) := by auto

+ nat_triple (f : ℕ → ℕ → ℕ → ℕ) (n m r : ℕ) : (∑ i < n, (∑ j < m, (∑ k < r, f i j k))) = (∑ j < m, (∑ i < n, (∑ k < r, f i j k))) := by auto

-> nat_rows (f : ℕ → ℕ → ℕ) (m i : ℕ) : ℕ := ∑ j < m, f i j

-> nat_cols (f : ℕ → ℕ → ℕ) (n j : ℕ) : ℕ := ∑ i < n, f i j

+ nat_alias (f : ℕ → ℕ → ℕ) (n m : ℕ) : (∑ i < n, nat_rows f m i) = (∑ j < m, nat_cols f n j) := by auto

+ int_direct (f : ℕ → ℕ → ℤ) (n m : ℕ) : (∑ i < n, (∑ j < m, f i j)) = (∑ j < m, (∑ i < n, f i j)) := by auto

+ int_reverse (f : ℕ → ℕ → ℤ) (n m : ℕ) : (∑ j < m, (∑ i < n, f i j)) = (∑ i < n, (∑ j < m, f i j)) := by auto

+ int_weighted (f : ℕ → ℕ → ℤ) (w : ℕ → ℤ) (n m : ℕ) : (∑ i < n, (∑ j < m, w i * f i j)) = (∑ j < m, (∑ i < n, w i * f i j)) := by auto

+ int_triple (f : ℕ → ℕ → ℕ → ℤ) (n m r : ℕ) : (∑ i < n, (∑ j < m, (∑ k < r, f i j k))) = (∑ j < m, (∑ i < n, (∑ k < r, f i j k))) := by auto

-> int_rows (f : ℕ → ℕ → ℤ) (m i : ℕ) : ℤ := ∑ j < m, f i j

-> int_cols (f : ℕ → ℕ → ℤ) (n j : ℕ) : ℤ := ∑ i < n, f i j

+ int_alias (f : ℕ → ℕ → ℤ) (n m : ℕ) : (∑ i < n, int_rows f m i) = (∑ j < m, int_cols f n j) := by auto

+ rat_direct (f : ℕ → ℕ → ℚ) (n m : ℕ) : (∑ i < n, (∑ j < m, f i j)) = (∑ j < m, (∑ i < n, f i j)) := by auto

+ rat_reverse (f : ℕ → ℕ → ℚ) (n m : ℕ) : (∑ j < m, (∑ i < n, f i j)) = (∑ i < n, (∑ j < m, f i j)) := by auto

+ rat_weighted (f : ℕ → ℕ → ℚ) (w : ℕ → ℚ) (n m : ℕ) : (∑ i < n, (∑ j < m, w i * f i j)) = (∑ j < m, (∑ i < n, w i * f i j)) := by auto

+ rat_triple (f : ℕ → ℕ → ℕ → ℚ) (n m r : ℕ) : (∑ i < n, (∑ j < m, (∑ k < r, f i j k))) = (∑ j < m, (∑ i < n, (∑ k < r, f i j k))) := by auto

-> rat_rows (f : ℕ → ℕ → ℚ) (m i : ℕ) : ℚ := ∑ j < m, f i j

-> rat_cols (f : ℕ → ℕ → ℚ) (n j : ℕ) : ℚ := ∑ i < n, f i j

+ rat_alias (f : ℕ → ℕ → ℚ) (n m : ℕ) : (∑ i < n, rat_rows f m i) = (∑ j < m, rat_cols f n j) := by auto

+ real_direct (f : ℕ → ℕ → ℝ) (n m : ℕ) : (∑ i < n, (∑ j < m, f i j)) = (∑ j < m, (∑ i < n, f i j)) := by auto

+ real_reverse (f : ℕ → ℕ → ℝ) (n m : ℕ) : (∑ j < m, (∑ i < n, f i j)) = (∑ i < n, (∑ j < m, f i j)) := by auto

+ real_weighted (f : ℕ → ℕ → ℝ) (w : ℕ → ℝ) (n m : ℕ) : (∑ i < n, (∑ j < m, w i * f i j)) = (∑ j < m, (∑ i < n, w i * f i j)) := by auto

+ real_triple (f : ℕ → ℕ → ℕ → ℝ) (n m r : ℕ) : (∑ i < n, (∑ j < m, (∑ k < r, f i j k))) = (∑ j < m, (∑ i < n, (∑ k < r, f i j k))) := by auto

-> real_rows (f : ℕ → ℕ → ℝ) (m i : ℕ) : ℝ := ∑ j < m, f i j

-> real_cols (f : ℕ → ℕ → ℝ) (n j : ℕ) : ℝ := ∑ i < n, f i j

+ real_alias (f : ℕ → ℕ → ℝ) (n m : ℕ) : (∑ i < n, real_rows f m i) = (∑ j < m, real_cols f n j) := by auto
