import arith

+ direct (b c d : ℚ) (n : ℕ) (hd : 0 < d) (hc : d*c ≤ d*b^n) : c ≤ b^n
  auto

+ direct_strict (b c d : ℚ) (n : ℕ) (hd : 0 < d) (hc : d*c < d*b^n) : c < b^n
  auto

+ lower (x b c d : ℚ) (n : ℕ) (h0 : 0 ≤ b) (hb : b ≤ x) (hd : 0 < d) (hc : d*c ≤ d*b^n) : c ≤ x^n
  auto

+ upper (x b c d : ℚ) (n : ℕ) (h0 : 0 ≤ x) (hb : x ≤ b) (hd : 0 < d) (hc : d*b^n ≤ d*c) : x^n ≤ c
  auto

+ strict_outer (x b c d : ℚ) (n : ℕ) (h0 : 0 ≤ b) (hb : b ≤ x) (hd : 0 < d) (hc : d*c < d*b^n) : c < x^n
  auto

+ strict_inner (x b c d : ℚ) (n : ℕ) (h0 : 0 ≤ b) (hb : b < x) (hn : 0 < n) (hd : 0 < d) (hc : d*c ≤ d*b^n) : c < x^n
  auto

+ right_factor (x b c d : ℚ) (n : ℕ) (h0 : 0 ≤ b) (hb : b ≤ x) (hd : 0 < d) (hc : c*d ≤ b^n*d) : c ≤ x^n
  auto

+ negative_factor (x b c d : ℚ) (n : ℕ) (h0 : 0 ≤ b) (hb : b ≤ x) (hd : d < 0) (hc : d*b^n ≤ d*c) : c ≤ x^n
  auto

+ balanced_shift (x b c d e : ℚ) (n : ℕ) (h0 : 0 ≤ b) (hb : b ≤ x) (hd : 0 < d) (hc : d*c+e ≤ d*b^n+e) : c ≤ x^n
  auto

+ conjunction (x b c d : ℚ) (n : ℕ) (h : 0 ≤ b ∧ b ≤ x ∧ 0 < d ∧ d*c ≤ d*b^n) : c ≤ x^n
  auto

+ generic (f : ℚ → ℚ) (mono : ∀ u v, u ≤ v → f u ≤ f v) (x b c d : ℚ) (hb : b ≤ x) (hd : 0 < d) (hc : d*c ≤ d*f b) : c ≤ f x
  auto

+ integer (x b c d : ℤ) (n : ℕ) (h0 : 0 ≤ b) (hb : b ≤ x) (hd : 0 < d) (hc : d*c ≤ d*b^n) : c ≤ x^n
  auto

+ real_value (x b c d : ℝ) (n : ℕ) (h0 : 0 ≤ b) (hb : b ≤ x) (hd : 0 < d) (hc : d*c ≤ d*b^n) : c ≤ x^n
  auto

+ natural (x b c d : ℕ) (n : ℕ) (hb : b ≤ x) (hd : 0 < d) (hc : d*c ≤ d*b^n) : c ≤ x^n
  auto

+ natural_direct (b c d : ℕ) (n : ℕ) (hd : 0 < d) (hc : d*c ≤ d*b^n) : c ≤ b^n
  auto

+ product_bound (a b c d : ℚ) (ha : a ≤ b) (hc : c ≤ d) (hc0 : 0 ≤ c) (hb0 : 0 ≤ b) : a*c ≤ b*d
  auto

+ product_margin (a b : ℚ) (ha : 0 < a) (hb : 0 < b) : a*b < (a+1)*(b+1)
  auto

+ square_margin (a b : ℚ) (ha : 0 ≤ a) (hab : a < b) : a*a < b*b
  auto

opaque a : ℚ
opaque b : ℚ
opaque c : ℚ
opaque d : ℚ
opaque n : ℕ
axiom supplied_bound : d*c ≤ d*b^n
axiom supplied_sign : 0 < d

+ explicit_bound (h0 : 0 ≤ b) (hb : b ≤ a) : c ≤ a^n
  auto [supplied_bound, supplied_sign]
