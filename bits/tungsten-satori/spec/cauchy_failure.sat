  nlinarith [sum_below.weighted_cauchy.rat n w f g hw]

+ rat_weak_form (a b c : ℚ) (q : ∀ x : ℚ, 0 ≤ x^2*a-2*x*x*b+x^2*c) : b^2 ≤ a*c
  apply quadratic_form.bound.rat a b c
