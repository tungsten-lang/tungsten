+ int_missing_list_sign (xs : list α) (w f g : α → ℤ) : (sum_list xs (fun i => w i*(f i*g i)))^2 ≤ (sum_list xs (fun i => w i*(f i*f i)))*(sum_list xs (fun i => w i*(g i*g i)))
  apply list_sum.weighted_cauchy.int xs w f g
  intro i hi
  linarith

+ int_strict_list (xs : list α) (w f g : α → ℤ) (hw : ∀ i ∈ xs, 0 ≤ w i) : (sum_list xs (fun i => w i*(f i*g i)))^2 < (sum_list xs (fun i => w i*(f i*f i)))*(sum_list xs (fun i => w i*(g i*g i)))
  nlinarith [list_sum.weighted_cauchy.int xs w f g hw]

