import comparison

+ real_compare (f g a b : ℕ → ℝ) (n : ℕ) (rate : ∀ i < n, 0 ≤ a i) (base : f 0 ≤ g 0) (upper : ∀ i < n, f (i + 1) ≤ a i * f i + b i) (lower : ∀ i < n, a i * g i + b i ≤ g (i + 1)) : f n ≤ g n := recurrence.compare.real f g a b n rate base upper lower
+ real_empty (f g a b : ℕ → ℝ) (h : f 0 ≤ g 0) : f 0 ≤ g 0 := recurrence.compare.real f g a b 0 (by intro i hi; omega) h (by intro i hi; omega) (by intro i hi; omega)
+ real_zero_rate (n : ℕ) : (0 : ℝ) ≤ 1 := recurrence.compare.real (fun i => 0) (fun i => 1) (fun i => 0) (fun i => 0) n (by intro i hi; omega) (by decide) (by intro i hi; simp) (by intro i hi; simp)
+ real_variable_rate : (1 : ℝ) ≤ 2 := recurrence.compare.real (fun i => 1) (fun i => 2) (fun i => if i = 0 then 1 else 0) (fun i => if i = 0 then 0 else 1) 3 (by decide) (by decide) (by decide) (by decide)
+ real_negative_values : (-3 : ℝ) ≤ -2 := recurrence.compare.real (fun i => -3) (fun i => -2) (fun i => 1) (fun i => 0) 4 (by decide) (by decide) (by decide) (by decide)
+ rat_compare (f g a b : ℕ → ℚ) (n : ℕ) (rate : ∀ i < n, 0 ≤ a i) (base : f 0 ≤ g 0) (upper : ∀ i < n, f (i + 1) ≤ a i * f i + b i) (lower : ∀ i < n, a i * g i + b i ≤ g (i + 1)) : f n ≤ g n := recurrence.compare.rat f g a b n rate base upper lower
+ rat_empty (f g a b : ℕ → ℚ) (h : f 0 ≤ g 0) : f 0 ≤ g 0 := recurrence.compare.rat f g a b 0 (by intro i hi; omega) h (by intro i hi; omega) (by intro i hi; omega)
+ rat_zero_rate (n : ℕ) : (0 : ℚ) ≤ 1 := recurrence.compare.rat (fun i => 0) (fun i => 1) (fun i => 0) (fun i => 0) n (by intro i hi; omega) (by decide) (by intro i hi; simp) (by intro i hi; simp)
+ rat_variable_rate : (1 : ℚ) ≤ 2 := recurrence.compare.rat (fun i => 1) (fun i => 2) (fun i => if i = 0 then 1 else 0) (fun i => if i = 0 then 0 else 1) 3 (by decide) (by decide) (by decide) (by decide)
+ rat_negative_values : (-3 : ℚ) ≤ -2 := recurrence.compare.rat (fun i => -3) (fun i => -2) (fun i => 1) (fun i => 0) 4 (by decide) (by decide) (by decide) (by decide)
+ int_compare (f g a b : ℕ → ℤ) (n : ℕ) (rate : ∀ i < n, 0 ≤ a i) (base : f 0 ≤ g 0) (upper : ∀ i < n, f (i + 1) ≤ a i * f i + b i) (lower : ∀ i < n, a i * g i + b i ≤ g (i + 1)) : f n ≤ g n := recurrence.compare.int f g a b n rate base upper lower
+ int_empty (f g a b : ℕ → ℤ) (h : f 0 ≤ g 0) : f 0 ≤ g 0 := recurrence.compare.int f g a b 0 (by intro i hi; omega) h (by intro i hi; omega) (by intro i hi; omega)
+ int_zero_rate (n : ℕ) : (0 : ℤ) ≤ 1 := recurrence.compare.int (fun i => 0) (fun i => 1) (fun i => 0) (fun i => 0) n (by intro i hi; omega) (by decide) (by intro i hi; simp) (by intro i hi; simp)
+ int_variable_rate : (1 : ℤ) ≤ 2 := recurrence.compare.int (fun i => 1) (fun i => 2) (fun i => if i = 0 then 1 else 0) (fun i => if i = 0 then 0 else 1) 3 (by decide) (by decide) (by decide) (by decide)
+ int_negative_values : (-3 : ℤ) ≤ -2 := recurrence.compare.int (fun i => -3) (fun i => -2) (fun i => 1) (fun i => 0) 4 (by decide) (by decide) (by decide) (by decide)
+ nat_compare (f g a b : ℕ → ℕ) (n : ℕ) (base : f 0 ≤ g 0) (upper : ∀ i < n, f (i + 1) ≤ a i * f i + b i) (lower : ∀ i < n, a i * g i + b i ≤ g (i + 1)) : f n ≤ g n := recurrence.compare.nat f g a b n base upper lower
+ nat_empty (f g a b : ℕ → ℕ) (h : f 0 ≤ g 0) : f 0 ≤ g 0 := recurrence.compare.nat f g a b 0 h (by intro i hi; omega) (by intro i hi; omega)
+ nat_zero_rate (n : ℕ) : (0 : ℕ) ≤ 1 := recurrence.compare.nat (fun i => 0) (fun i => 1) (fun i => 0) (fun i => 0) n (by decide) (by intro i hi; simp) (by intro i hi; simp)
+ nat_variable_rate : (1 : ℕ) ≤ 2 := recurrence.compare.nat (fun i => 1) (fun i => 2) (fun i => if i = 0 then 1 else 0) (fun i => if i = 0 then 0 else 1) 3 (by decide) (by decide) (by decide)
