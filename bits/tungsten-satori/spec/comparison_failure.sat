import comparison

+ real_wrong_base (f g a b : ℕ → ℝ) (n : ℕ) (rate : ∀ i < n, 0 ≤ a i) (base : g 0 ≤ f 0) (upper : ∀ i < n, f (i + 1) ≤ a i * f i + b i) (lower : ∀ i < n, a i * g i + b i ≤ g (i + 1)) : f n ≤ g n := recurrence.compare.real f g a b n rate base upper lower
+ real_wrong_upper (f g a b : ℕ → ℝ) (n : ℕ) (rate : ∀ i < n, 0 ≤ a i) (base : f 0 ≤ g 0) (upper : ∀ i < n, a i * f i + b i ≤ f (i + 1)) (lower : ∀ i < n, a i * g i + b i ≤ g (i + 1)) : f n ≤ g n := recurrence.compare.real f g a b n rate base upper lower
+ real_missing_last (f g a b : ℕ → ℝ) (n : ℕ) (rate : ∀ i < n, 0 ≤ a i) (base : f 0 ≤ g 0) (upper : ∀ i < n, f (i + 1) ≤ a i * f i + b i) (lower : ∀ i < n, a i * g i + b i ≤ g (i + 1)) : f (n + 1) ≤ g (n + 1) := recurrence.compare.real f g a b (n + 1) rate base upper lower
+ real_wrong_lower (f g a b : ℕ → ℝ) (n : ℕ) (rate : ∀ i < n, 0 ≤ a i) (base : f 0 ≤ g 0) (upper : ∀ i < n, f (i + 1) ≤ a i * f i + b i) (lower : ∀ i < n, g (i + 1) ≤ a i * g i + b i) : f n ≤ g n := recurrence.compare.real f g a b n rate base upper lower
+ real_negative_rate : (0 : ℝ) ≤ -1 := recurrence.compare.real (fun i => 0) (fun i => if i = 0 then 1 else -1) (fun i => -1) (fun i => 0) 1 (by decide) (by decide) (by decide) (by decide)
+ rat_wrong_base (f g a b : ℕ → ℚ) (n : ℕ) (rate : ∀ i < n, 0 ≤ a i) (base : g 0 ≤ f 0) (upper : ∀ i < n, f (i + 1) ≤ a i * f i + b i) (lower : ∀ i < n, a i * g i + b i ≤ g (i + 1)) : f n ≤ g n := recurrence.compare.rat f g a b n rate base upper lower
+ rat_wrong_upper (f g a b : ℕ → ℚ) (n : ℕ) (rate : ∀ i < n, 0 ≤ a i) (base : f 0 ≤ g 0) (upper : ∀ i < n, a i * f i + b i ≤ f (i + 1)) (lower : ∀ i < n, a i * g i + b i ≤ g (i + 1)) : f n ≤ g n := recurrence.compare.rat f g a b n rate base upper lower
+ rat_missing_last (f g a b : ℕ → ℚ) (n : ℕ) (rate : ∀ i < n, 0 ≤ a i) (base : f 0 ≤ g 0) (upper : ∀ i < n, f (i + 1) ≤ a i * f i + b i) (lower : ∀ i < n, a i * g i + b i ≤ g (i + 1)) : f (n + 1) ≤ g (n + 1) := recurrence.compare.rat f g a b (n + 1) rate base upper lower
+ rat_wrong_lower (f g a b : ℕ → ℚ) (n : ℕ) (rate : ∀ i < n, 0 ≤ a i) (base : f 0 ≤ g 0) (upper : ∀ i < n, f (i + 1) ≤ a i * f i + b i) (lower : ∀ i < n, g (i + 1) ≤ a i * g i + b i) : f n ≤ g n := recurrence.compare.rat f g a b n rate base upper lower
+ rat_negative_rate : (0 : ℚ) ≤ -1 := recurrence.compare.rat (fun i => 0) (fun i => if i = 0 then 1 else -1) (fun i => -1) (fun i => 0) 1 (by decide) (by decide) (by decide) (by decide)
+ int_wrong_base (f g a b : ℕ → ℤ) (n : ℕ) (rate : ∀ i < n, 0 ≤ a i) (base : g 0 ≤ f 0) (upper : ∀ i < n, f (i + 1) ≤ a i * f i + b i) (lower : ∀ i < n, a i * g i + b i ≤ g (i + 1)) : f n ≤ g n := recurrence.compare.int f g a b n rate base upper lower
+ int_wrong_upper (f g a b : ℕ → ℤ) (n : ℕ) (rate : ∀ i < n, 0 ≤ a i) (base : f 0 ≤ g 0) (upper : ∀ i < n, a i * f i + b i ≤ f (i + 1)) (lower : ∀ i < n, a i * g i + b i ≤ g (i + 1)) : f n ≤ g n := recurrence.compare.int f g a b n rate base upper lower
+ int_missing_last (f g a b : ℕ → ℤ) (n : ℕ) (rate : ∀ i < n, 0 ≤ a i) (base : f 0 ≤ g 0) (upper : ∀ i < n, f (i + 1) ≤ a i * f i + b i) (lower : ∀ i < n, a i * g i + b i ≤ g (i + 1)) : f (n + 1) ≤ g (n + 1) := recurrence.compare.int f g a b (n + 1) rate base upper lower
+ int_wrong_lower (f g a b : ℕ → ℤ) (n : ℕ) (rate : ∀ i < n, 0 ≤ a i) (base : f 0 ≤ g 0) (upper : ∀ i < n, f (i + 1) ≤ a i * f i + b i) (lower : ∀ i < n, g (i + 1) ≤ a i * g i + b i) : f n ≤ g n := recurrence.compare.int f g a b n rate base upper lower
+ int_negative_rate : (0 : ℤ) ≤ -1 := recurrence.compare.int (fun i => 0) (fun i => if i = 0 then 1 else -1) (fun i => -1) (fun i => 0) 1 (by decide) (by decide) (by decide) (by decide)
+ nat_wrong_base (f g a b : ℕ → ℕ) (n : ℕ) (base : g 0 ≤ f 0) (upper : ∀ i < n, f (i + 1) ≤ a i * f i + b i) (lower : ∀ i < n, a i * g i + b i ≤ g (i + 1)) : f n ≤ g n := recurrence.compare.nat f g a b n base upper lower
+ nat_wrong_upper (f g a b : ℕ → ℕ) (n : ℕ) (base : f 0 ≤ g 0) (upper : ∀ i < n, a i * f i + b i ≤ f (i + 1)) (lower : ∀ i < n, a i * g i + b i ≤ g (i + 1)) : f n ≤ g n := recurrence.compare.nat f g a b n base upper lower
+ nat_missing_last (f g a b : ℕ → ℕ) (n : ℕ) (base : f 0 ≤ g 0) (upper : ∀ i < n, f (i + 1) ≤ a i * f i + b i) (lower : ∀ i < n, a i * g i + b i ≤ g (i + 1)) : f (n + 1) ≤ g (n + 1) := recurrence.compare.nat f g a b (n + 1) base upper lower
+ nat_wrong_lower (f g a b : ℕ → ℕ) (n : ℕ) (base : f 0 ≤ g 0) (upper : ∀ i < n, f (i + 1) ≤ a i * f i + b i) (lower : ∀ i < n, g (i + 1) ≤ a i * g i + b i) : f n ≤ g n := recurrence.compare.nat f g a b n base upper lower
