import euclidean

+ list_cauchy (xs : list α) (w f g : α → ℝ) (hw : ∀ i ∈ xs, 0 ≤ w i) :
    |sum_list xs (fun i => w i*(f i*g i))| ≤ sqrt (sum_list xs (fun i => w i*(f i*f i))) * sqrt (sum_list xs (fun i => w i*(g i*g i)))
  exact list_sum.weighted_cauchy_sqrt.real xs w f g hw

+ list_triangle (xs : list α) (w f g : α → ℝ) (hw : ∀ i ∈ xs, 0 ≤ w i) : sqrt (sum_list xs (fun i => w i*((f i+g i)*(f i+g i)))) ≤ sqrt (sum_list xs (fun i => w i*(f i*f i))) + sqrt (sum_list xs (fun i => w i*(g i*g i))) := list_sum.weighted_minkowski.real xs w f g hw

+ list_unweighted (xs : list α) (f g : α → ℝ) : sqrt (sum_list xs (fun i => (f i+g i)*(f i+g i))) ≤ sqrt (sum_list xs (fun i => f i*f i)) + sqrt (sum_list xs (fun i => g i*g i)) := list_sum.minkowski.real xs f g

+ list_unweighted_cauchy (xs : list α) (f g : α → ℝ) :
    |sum_list xs (fun i => f i*g i)| ≤ sqrt (sum_list xs (fun i => f i*f i)) * sqrt (sum_list xs (fun i => g i*g i))
  exact list_sum.cauchy_sqrt.real xs f g

+ list_zero_weights (xs : list α) (f g : α → ℝ) : sqrt (sum_list xs (fun i => 0*((f i+g i)*(f i+g i)))) ≤ sqrt (sum_list xs (fun i => 0*(f i*f i))) + sqrt (sum_list xs (fun i => 0*(g i*g i))) := list_sum.weighted_minkowski.real xs (fun i => 0) f g (by intro i hi; linarith)

+ range_cauchy (n : ℕ) (w f g : ℕ → ℝ) (hw : ∀ i < n, 0 ≤ w i) :
    |sum_below n (fun i => w i*(f i*g i))| ≤ sqrt (sum_below n (fun i => w i*(f i*f i))) * sqrt (sum_below n (fun i => w i*(g i*g i)))
  exact sum_below.weighted_cauchy_sqrt.real n w f g hw

+ range_triangle (n : ℕ) (w f g : ℕ → ℝ) (hw : ∀ i < n, 0 ≤ w i) : sqrt (sum_below n (fun i => w i*((f i+g i)*(f i+g i)))) ≤ sqrt (sum_below n (fun i => w i*(f i*f i))) + sqrt (sum_below n (fun i => w i*(g i*g i))) := sum_below.weighted_minkowski.real n w f g hw

+ range_unweighted (n : ℕ) (f g : ℕ → ℝ) : sqrt (sum_below n (fun i => (f i+g i)*(f i+g i))) ≤ sqrt (sum_below n (fun i => f i*f i)) + sqrt (sum_below n (fun i => g i*g i)) := sum_below.minkowski.real n f g

+ range_unweighted_cauchy (n : ℕ) (f g : ℕ → ℝ) :
    |sum_below n (fun i => f i*g i)| ≤ sqrt (sum_below n (fun i => f i*f i)) * sqrt (sum_below n (fun i => g i*g i))
  exact sum_below.cauchy_sqrt.real n f g

+ range_zero_weights (n : ℕ) (f g : ℕ → ℝ) : sqrt (sum_below n (fun i => 0*((f i+g i)*(f i+g i)))) ≤ sqrt (sum_below n (fun i => 0*(f i*f i))) + sqrt (sum_below n (fun i => 0*(g i*g i))) := sum_below.weighted_minkowski.real n (fun i => 0) f g (by intro i hi; linarith)

+ planar_triangle (a b c d : ℝ) : sqrt ((a+c)^2+(b+d)^2) ≤ sqrt (a^2+b^2)+sqrt (c^2+d^2) := norm2.add_le a b c d

+ planar_reverse (a b c d : ℝ) : sqrt (a^2+b^2)-sqrt (c^2+d^2) ≤ sqrt ((a-c)^2+(b-d)^2) := norm2.sub_le a b c d

+ empty_triangle (f g : ℕ → ℝ) : sqrt (sum_list ([] : list ℕ) (fun i => (f i+g i)*(f i+g i))) ≤ sqrt (sum_list ([] : list ℕ) (fun i => f i*f i))+sqrt (sum_list ([] : list ℕ) (fun i => g i*g i)) := list_sum.minkowski.real ([] : list ℕ) f g

+ repeated_triangle (x : α) (f g : α → ℝ) : sqrt (sum_list (x :: x :: []) (fun i => (f i+g i)*(f i+g i))) ≤ sqrt (sum_list (x :: x :: []) (fun i => f i*f i))+sqrt (sum_list (x :: x :: []) (fun i => g i*g i)) := list_sum.minkowski.real (x :: x :: []) f g

+ scalar_bound (x a b : ℝ) (ha : 0 ≤ a) (hb : 0 ≤ b) (h : x^2 ≤ a*b) : |x| ≤ sqrt a * sqrt b := abs_le_sqrt_mul x a b ha hb h
