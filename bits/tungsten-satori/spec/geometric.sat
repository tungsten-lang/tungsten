import geometric

+ real_zero_rate (A : ℝ) (n : ℕ) : (∑ i < n, (0 - 1) * A * (0 : ℝ) ^ i) = A * (0 ^ n - 1)
  exact sum_below.geometric_step.real 0 A n
+ real_unit_rate (n : ℕ) : (∑ i < n, ((i : ℝ) + 1) * (1 : ℝ) ^ i) * (1 - 1) ^ 2 = 1 - 1 ^ n * (1 + (n : ℝ) * (1 - 1))
  exact sum_below.arithmetic_geometric.real 1 n
+ real_signed_weights (n : ℕ) :
    (∑ i < n, (2 : ℝ) ^ i * ((2 * (-2) - 1) * (-3) * (-2) ^ i + (2 - 1) * (-7))) ≤ (-3) * ((2 * (-2)) ^ n - 1) + (-7) * (2 ^ n - 1)
  exact sum_below.weighted_geometric_bound.real (fun i => (2 * (-2) - 1) * (-3) * (-2) ^ i + (2 - 1) * (-7)) 2 (-2) (-3) (-7) n (by decide) (by intro i hi; linarith)
+ real_empty_bound (f : ℕ → ℝ) (r A : ℝ) : sum_below 0 f ≤ A * (r ^ 0 - 1)
  exact sum_below.geometric_bound.real f r A 0 (by intro i hi; omega)
+ real_zero_weight : (∑ i < 1, (0 : ℝ) ^ i * (1 : ℝ)) ≤ (-3) * ((0 * (-2)) ^ 1 - 1) + 2 * (0 ^ 1 - 1)
  apply sum_below.weighted_geometric_bound.real (fun i => (1 : ℝ)) 0 (-2) (-3) 2 1 (by decide)
  intro i hi
  have h : i = 0 := by omega
  rw [h]
  decide

+ rat_zero_rate (A : ℚ) (n : ℕ) : (∑ i < n, (0 - 1) * A * (0 : ℚ) ^ i) = A * (0 ^ n - 1)
  exact sum_below.geometric_step.rat 0 A n
+ rat_unit_rate (n : ℕ) : (∑ i < n, ((i : ℚ) + 1) * (1 : ℚ) ^ i) * (1 - 1) ^ 2 = 1 - 1 ^ n * (1 + (n : ℚ) * (1 - 1))
  exact sum_below.arithmetic_geometric.rat 1 n
+ rat_signed_weights (n : ℕ) :
    (∑ i < n, (2 : ℚ) ^ i * ((2 * (-2) - 1) * (-3) * (-2) ^ i + (2 - 1) * (-7))) ≤ (-3) * ((2 * (-2)) ^ n - 1) + (-7) * (2 ^ n - 1)
  exact sum_below.weighted_geometric_bound.rat (fun i => (2 * (-2) - 1) * (-3) * (-2) ^ i + (2 - 1) * (-7)) 2 (-2) (-3) (-7) n (by decide) (by intro i hi; linarith)
+ rat_empty_bound (f : ℕ → ℚ) (r A : ℚ) : sum_below 0 f ≤ A * (r ^ 0 - 1)
  exact sum_below.geometric_bound.rat f r A 0 (by intro i hi; omega)
+ rat_zero_weight : (∑ i < 1, (0 : ℚ) ^ i * (1 : ℚ)) ≤ (-3) * ((0 * (-2)) ^ 1 - 1) + 2 * (0 ^ 1 - 1)
  apply sum_below.weighted_geometric_bound.rat (fun i => (1 : ℚ)) 0 (-2) (-3) 2 1 (by decide)
  intro i hi
  have h : i = 0 := by omega
  rw [h]
  decide

+ int_zero_rate (A : ℤ) (n : ℕ) : (∑ i < n, (0 - 1) * A * (0 : ℤ) ^ i) = A * (0 ^ n - 1)
  exact sum_below.geometric_step.int 0 A n
+ int_unit_rate (n : ℕ) : (∑ i < n, ((i : ℤ) + 1) * (1 : ℤ) ^ i) * (1 - 1) ^ 2 = 1 - 1 ^ n * (1 + (n : ℤ) * (1 - 1))
  exact sum_below.arithmetic_geometric.int 1 n
+ int_signed_weights (n : ℕ) :
    (∑ i < n, (2 : ℤ) ^ i * ((2 * (-2) - 1) * (-3) * (-2) ^ i + (2 - 1) * (-7))) ≤ (-3) * ((2 * (-2)) ^ n - 1) + (-7) * (2 ^ n - 1)
  exact sum_below.weighted_geometric_bound.int (fun i => (2 * (-2) - 1) * (-3) * (-2) ^ i + (2 - 1) * (-7)) 2 (-2) (-3) (-7) n (by decide) (by intro i hi; linarith)
+ int_empty_bound (f : ℕ → ℤ) (r A : ℤ) : sum_below 0 f ≤ A * (r ^ 0 - 1)
  exact sum_below.geometric_bound.int f r A 0 (by intro i hi; omega)
+ int_zero_weight : (∑ i < 1, (0 : ℤ) ^ i * (1 : ℤ)) ≤ (-3) * ((0 * (-2)) ^ 1 - 1) + 2 * (0 ^ 1 - 1)
  apply sum_below.weighted_geometric_bound.int (fun i => (1 : ℤ)) 0 (-2) (-3) 2 1 (by decide)
  intro i hi
  have h : i = 0 := by omega
  rw [h]
  decide

-> iterm (b : ℕ → ℝ) (s i : ℕ) : ℝ := 2 ^ i * b (s + i)

+ geom_step (b : ℕ → ℝ) (s : ℕ) (G P g θ : ℝ) (r : ℕ)
    (hc : ∀ i < r, b (s + i) ≤ (2 * g - 1) * G * P * g ^ i + θ)
    : ∑ i < r, iterm b s i ≤ G * P * ((2 * g) ^ r - 1) + θ * (2 ^ r - 1)
  apply sum_below.weighted_geometric_bound.real (fun i => b (s + i)) 2 g (G * P) θ r (by norm_num)
  intro i hi
  linarith [hc i hi]

-> quarter (j : ℕ) : ℚ := (1 / 4) ^ j
-> weighted (j : ℕ) : ℚ := ((j : ℚ) + 1) * (1 / 4) ^ j
+ mass_closed (n : ℕ) : sum_below n quarter = 4 / 3 - 4 / 3 * (1 / 4) ^ n
  have h := geom_sum_mul.rat (1 / 4) n
  unfold quarter
  linarith

+ entropy_closed (n : ℕ) : sum_below n weighted = 16 / 9 - (1 / 4) ^ n * (4 / 3 * (n : ℚ) + 16 / 9)
  have h := sum_below.arithmetic_geometric.rat (1 / 4) n
  unfold weighted
  linarith
