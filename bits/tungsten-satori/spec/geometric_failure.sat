import geometric

+ real_negative_weight (f : ℕ → ℝ) (n : ℕ)
    (bound : ∀ i < n, f i ≤ ((-1) * 2 - 1) * 3 * 2 ^ i + ((-1) - 1) * 4) :
    (∑ i < n, (-1 : ℝ) ^ i * f i) ≤ 3 * (((-1) * 2) ^ n - 1) + 4 * ((-1) ^ n - 1)
  exact sum_below.weighted_geometric_bound.real f (-1) 2 3 4 n (by decide) bound
+ real_missing_endpoint (f : ℕ → ℝ) (n : ℕ) (bound : ∀ i < n, f i ≤ 3 * 2 ^ i) : sum_below (n + 1) f ≤ 3 * (2 ^ (n + 1) - 1)
  apply sum_below.geometric_bound.real f 2 3 (n + 1)
  intro i hi
  exact bound i hi
+ real_reversed_bound (f : ℕ → ℝ) (n : ℕ) (bound : ∀ i < n, 3 * 2 ^ i ≤ f i) : sum_below n f ≤ 3 * (2 ^ n - 1)
  apply sum_below.geometric_bound.real f 2 3 n
  intro i hi
  linarith [bound i hi]

+ rat_negative_weight (f : ℕ → ℚ) (n : ℕ)
    (bound : ∀ i < n, f i ≤ ((-1) * 2 - 1) * 3 * 2 ^ i + ((-1) - 1) * 4) :
    (∑ i < n, (-1 : ℚ) ^ i * f i) ≤ 3 * (((-1) * 2) ^ n - 1) + 4 * ((-1) ^ n - 1)
  exact sum_below.weighted_geometric_bound.rat f (-1) 2 3 4 n (by decide) bound
+ rat_missing_endpoint (f : ℕ → ℚ) (n : ℕ) (bound : ∀ i < n, f i ≤ 3 * 2 ^ i) : sum_below (n + 1) f ≤ 3 * (2 ^ (n + 1) - 1)
  apply sum_below.geometric_bound.rat f 2 3 (n + 1)
  intro i hi
  exact bound i hi
+ rat_reversed_bound (f : ℕ → ℚ) (n : ℕ) (bound : ∀ i < n, 3 * 2 ^ i ≤ f i) : sum_below n f ≤ 3 * (2 ^ n - 1)
  apply sum_below.geometric_bound.rat f 2 3 n
  intro i hi
  linarith [bound i hi]

+ int_negative_weight (f : ℕ → ℤ) (n : ℕ)
    (bound : ∀ i < n, f i ≤ ((-1) * 2 - 1) * 3 * 2 ^ i + ((-1) - 1) * 4) :
    (∑ i < n, (-1 : ℤ) ^ i * f i) ≤ 3 * (((-1) * 2) ^ n - 1) + 4 * ((-1) ^ n - 1)
  exact sum_below.weighted_geometric_bound.int f (-1) 2 3 4 n (by decide) bound
+ int_missing_endpoint (f : ℕ → ℤ) (n : ℕ) (bound : ∀ i < n, f i ≤ 3 * 2 ^ i) : sum_below (n + 1) f ≤ 3 * (2 ^ (n + 1) - 1)
  apply sum_below.geometric_bound.int f 2 3 (n + 1)
  intro i hi
  exact bound i hi
+ int_reversed_bound (f : ℕ → ℤ) (n : ℕ) (bound : ∀ i < n, 3 * 2 ^ i ≤ f i) : sum_below n f ≤ 3 * (2 ^ n - 1)
  apply sum_below.geometric_bound.int f 2 3 n
  intro i hi
  linarith [bound i hi]
