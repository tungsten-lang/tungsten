+ range_strict (n : ℕ) (w f g : ℕ → ℝ) (hw : ∀ i < n, 0 ≤ w i) (hf : ∀ i < n, 0 ≤ f i) (hg : ∀ i < n, 0 ≤ g i) : sum_below n (fun i => w i*sqrt (f i*g i)) < sqrt ((sum_below n (fun i => w i*f i))*(sum_below n (fun i => w i*g i))) := sum_below.weighted_sqrt_mul_le.real n w f g hw hf hg

+ range_reverse (n : ℕ) (w f g : ℕ → ℝ) (hw : ∀ i < n, 0 ≤ w i) (hf : ∀ i < n, 0 ≤ f i) (hg : ∀ i < n, 0 ≤ g i) : sqrt ((sum_below n (fun i => w i*f i))*(sum_below n (fun i => w i*g i))) ≤ sum_below n (fun i => w i*sqrt (f i*g i)) := sum_below.weighted_sqrt_mul_le.real n w f g hw hf hg

+ range_wrong_vector (n : ℕ) (w f g : ℕ → ℝ) (hw : ∀ i < n, 0 ≤ w i) (hf : ∀ i < n, 0 ≤ f i) (hg : ∀ i < n, 0 ≤ g i) : sum_below n (fun i => w i*sqrt (f i*g i)) ≤ sqrt ((sum_below n (fun i => w i*f i))*(sum_below n (fun i => w i*f i))) := sum_below.weighted_sqrt_mul_le.real n w f g hw hf hg

+ scalar_missing_sign (a b c d : ℝ) : sqrt (a*b)+sqrt (c*d) ≤ sqrt ((a+c)*(b+d))
  apply sqrt_mul.add_le a b c d <;> linarith

+ scalar_strict_equality : sqrt (1*1)+sqrt (1*1) < sqrt ((1+1)*(1+1))
  exact sqrt_mul.add_le 1 1 1 1 (by linarith) (by linarith) (by linarith) (by linarith)
