import heat_interval

+ dropped_left :
    darboux.integral 1 3 (fun x => x*0) + darboux.integral 1 3 (fun x => (1:ℝ)^2) = 3
  have h := heat_interval.balance (fun x => x) (fun x => 1) (fun x => 0) 1 3 (by norm_num) (by intro x lo hi; auto) (by intro x lo hi; auto) (by intro x lo hi; auto)
  linarith

+ unchecked_boundary (u q r : ℝ → ℝ) (a b : ℝ) (ab : a ≤ b)
    (smooth : ∀ x, a ≤ x → x ≤ b → continuous_at u x ∧ continuous_at q x ∧ continuous_at r x)
    (du : ∀ x, a ≤ x → x ≤ b → has_deriv_within u (fun z => a ≤ z ∧ z ≤ b) x (q x))
    (dq : ∀ x, a ≤ x → x ≤ b → has_deriv_within q (fun z => a ≤ z ∧ z ≤ b) x (r x)) :
    darboux.integral a b (fun x => u x*r x) ≤ 0
  apply heat_interval.dissipative u q r a b ab smooth du dq
  auto

+ uninsulated (u q r : ℝ → ℝ → ℝ)
    (flow : heat_interval.solution u q r (fun z => 0 ≤ z ∧ z ≤ 1) (fun z => 0 ≤ z ∧ z ≤ 1)) :
    heat_interval.energy u 0 1 1 ≤ heat_interval.energy u 0 1 0
  apply heat_interval.insulated u q r 0 1 0 1 (by decide) (by decide) flow
  auto

+ missing_flux (u q r v p s : ℝ → ℝ → ℝ)
    (hu : heat_interval.solution u q r (fun z => 0 ≤ z ∧ z ≤ 1) (fun z => 0 ≤ z ∧ z ≤ 1))
    (hv : heat_interval.solution v p s (fun z => 0 ≤ z ∧ z ≤ 1) (fun z => 0 ≤ z ∧ z ≤ 1))
    (initial : ∀ z, 0 ≤ z → z ≤ 1 → u 0 z = v 0 z)
    (left : ∀ k, 0 ≤ k → k ≤ 1 → q k 0 = p k 0) : u 1 0 = v 1 0 := by apply heat_interval.unique <;> auto

+ point_domain (f : ℝ → ℝ) (pos : 0 < f 1) (cont : continuous_at f 1) :
    0 < darboux.integral 1 1 f
  apply darboux.pos_of_pos_at f 1 1 (darboux.integral 1 1 f) 1 <;> auto

+ missing_initial (u q r v p s : ℝ → ℝ → ℝ)
    (hu : heat_interval.solution u q r (fun z => 0 ≤ z ∧ z ≤ 1) (fun z => 0 ≤ z ∧ z ≤ 1))
    (hv : heat_interval.solution v p s (fun z => 0 ≤ z ∧ z ≤ 1) (fun z => 0 ≤ z ∧ z ≤ 1))
    (ends : ∀ k, 0 ≤ k → k ≤ 1 → q k 0 = p k 0 ∧ q k 1 = p k 1) : u 1 0 = v 1 0 := by auto
