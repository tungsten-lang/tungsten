import heat_path

+ product (f g : ℝ → ℝ) (S : set ℝ) (t u v : ℝ) (hf : has_deriv_within f S t u) (hg : has_deriv_within g S t v) :
    has_deriv_within (fun s => f s*g s) S t (u*g t+f t*v) := by auto

+ squares (f g : ℝ → ℝ) (S : set ℝ) (t u v : ℝ) (hf : has_deriv_within f S t u) (hg : has_deriv_within g S t v) :
    has_deriv_within (fun s => (f s)^2+(g s)^2) S t (2*f t*u+2*g t*v) := by auto

+ insulated (u : ℕ → ℝ → ℝ) (n : ℕ) (a b : ℝ) (ab : a ≤ b)
    (h : ∀ t, a ≤ t → t ≤ b → ∀ i < n+1, has_deriv_within (u i) (fun z => a ≤ z ∧ z ≤ b) t
      (heat_path.flux u n t (i+1)-heat_path.flux u n t i)) : heat_path.energy u n b ≤ heat_path.energy u n a := by auto

-- Initial temperatures [1,0,-1] on the three-vertex path.
-> initial (i : ℕ) : ℝ := if i=0 then 1 else if i=1 then 0 else -1
+ edge_sign : heat_path.flux (fun i t => initial i) 2 0 1 = -1 ∧ heat_path.flux (fun i t => initial i) 2 0 0 = 0 := by decide
+ loss : heat_path.dissipation (fun i t => initial i) 2 0 = 2 := by decide

-- One vertex with unit incoming net flux has u(t)=t and gains energy.
+ driven (S : set ℝ) (t : ℝ) : has_deriv_within (heat_path.energy (fun i y => y) 0) S t (2*t)
  have flow : ∀ i < 0+1, has_deriv_within (fun y => y) S t (((i+1:ℕ):ℝ)-(i:ℝ))
    intro i hi
    have z : i = 0 := by omega
    rw [z]; exact has_deriv_within.id S t
  have edges : ∀ i < 0, ((i+1:ℕ):ℝ) = t-t := by intro i hi; omega
  have balance := heat_path.balance (fun i y => y) (fun (j : ℕ) => (j:ℝ)) 0 S t flow edges
  simp [heat_path.dissipation, sum_below] at balance
  auto
+ energy_increases : heat_path.energy (fun i t => t) 0 0 < heat_path.energy (fun i t => t) 0 1 := by decide

+ exchange (P : ℝ → ℝ → Prop) (a b : ℝ) (h : P (a+b) (a*b)) : P (b+a) (b*a) := by auto
opaque reading : ℝ → Prop
axiom calibration (x : ℝ) : reading (x*x+2*x+1)
+ calibrated (x : ℝ) : reading ((x+1)^2) := by auto [calibration x]
#axioms calibrated
