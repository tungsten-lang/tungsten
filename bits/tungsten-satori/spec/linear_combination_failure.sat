+ wrong_coefficient (a b : ℤ) (h : a = b) : 2 * a = 2 * b := by linear_combination 3 * h
+ wrong_sign (a b : ℤ) (h : a = b) : b = a := by linear_combination h
+ wrong_goal (a b : ℤ) (h : a = b) : a = b + 1 := by linear_combination h
+ not_equation (a b : ℤ) (h : a = b) : a ≤ b := by linear_combination h
+ inequality_input (a b : ℤ) (h : a ≤ b) : a = b := by linear_combination h
+ proposition_input (p : Prop) (h : p) : (0 : ℤ) = 0 := by linear_combination h
+ boolean_equation (p q : Prop) (h : p = q) : p = q := by linear_combination h
+ mixed_types (a b : ℤ) (h : a = b) : (0 : ℚ) = 0 := by linear_combination h
+ coefficient_type (a b : ℤ) (c : ℚ) (h : a = b) : a = b := by linear_combination c * h
+ unknown_proof : (0 : ℤ) = 0 := by linear_combination missing_equality
+ unknown_zero_proof : (0 : ℤ) = 0 := by linear_combination 0 * missing_equality
+ unknown_coefficient (a b : ℤ) (h : a = b) : a = b := by linear_combination missing_coefficient * h
+ missing_proof (a : ℤ) : a = a := by linear_combination 2
+ proof_product (a b c d : ℤ) (h : a = b) (k : c = d) : a * c = b * d := by linear_combination h * k
+ unspecialized (f g : ℕ → ℤ) (h : ∀ n, f n = g n) : f 0 = g 0 := by linear_combination h
+ wrong_argument (f g : ℕ → ℤ) (h : ∀ n, f n = g n) : f 1 = g 1 := by linear_combination h 0
+ captured_argument (f : ℕ → ℕ → ℤ) (n : ℕ) (h : ∀ i, f n i = 0) : ∀ n, f n n = 0 := by intro j; linear_combination h j
+ bad_projection (a b : ℤ) (h : a = b ∧ True) : a = b := by linear_combination h.2
+ bad_identity (a b : ℤ) : (a + b) ^ 2 = a ^ 2 + b ^ 2 := by linear_combination
+ natural_subtraction (a b : ℕ) (h : a - b = 0) : a = b := by linear_combination h
+ natural_negative (a b : ℕ) (h : a = b) : a + 1 = b := by linear_combination -h
+ natural_wrong_balance (a b c : ℕ) (h : a + c = b + c) : a = b + 1 := by linear_combination h
+ wrong_centered_squares (r s1 s2 : ℤ) (h1 : 2 * s1 = r * (r - 1)) (h2 : 6 * s2 = r * (r - 1) * (2 * r - 1)) :
    3 * (4 * s2 - 4 * (r - 1) * s1 + r * (r - 1) * (r - 1)) = r * (r * r + 1)
  linear_combination 2 * h2 - 6 * (r - 1) * h1
+ zero_denominator (a b : ℚ) (h : a = b) : (1 : ℚ) = 0 := by linear_combination (1 / 0) * h
+ variable_denominator (x a b : ℚ) (h : x * a = x * b) : a = b := by linear_combination (1 / x) * h
+ natural_unknown_zero : (0 : ℕ) = 0 := by linear_combination 0 * missing_equality
