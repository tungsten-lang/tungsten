+ typed_number (P : ℚ → Prop) (h : P (1/3)) : ∃ x, P x ∧ x = 1/3
  set q : ℚ := 1/3 with value
  exact ⟨q,h,rfl⟩

+ nested_values (f : α → α) (x : α) (p : α → Prop) (h : p (f (f x))) : ∃ y, p y
  set a := f x
  set b := f a
  exact ⟨b,h⟩

+ symbolic (a : ℤ) : ∃ x : ℤ, x+x = 2*(a+1)
  set step := a+1
  use step; ring

+ unfold_value (x : ℤ) : ∃ y : ℤ, y*y = x^2+2*x+1
  set y := x+1
  use y; rw [y_def]; ring

+ beneath_binder (f : α → α) (x : α) (P : α → α → Prop)
    (h : ∀ x, P (f x) x) : ∃ y, P y x
  set y := f x with hy
  exact ⟨y,by rw [hy]; exact h x⟩

+ quantified_value (Q : ℕ → Prop) (h : ∀ x, Q x) : (∀ y, Q y) ∧ Q 0
  set P := ∀ n, Q n with hP
  constructor
  · exact h
  · rw [hP] at h; exact h 0

+ branch_scope (P : α → Prop) (a b : α) (ha : P a) (hb : P b) : (∃ x, P x) ∧ ∃ x, P x
  constructor
  · set t := a; exact ⟨t,ha⟩
  · set t := b; exact ⟨t,hb⟩

+ let_keeps_outer (x : ℕ) : (let y := x in fun (x : ℕ) => y) = (fun (n : ℕ) => x) := by rfl
+ set_keeps_outer (x : ℕ) (m : ℕ) : (let y := x in m ∈ {x : ℕ | x = y}) ↔ m = x := by rfl
+ unique_keeps_outer (x' : ℕ) : ∃! x : ℕ, x = x'
  exact ⟨x',rfl,by intro t ht; exact ht⟩
+ function_value (p : ℤ × ℕ) : ∃ f : (ℤ × ℕ) → ℤ, f p = fst p
  set first : (ℤ × ℕ) → ℤ := fun t => t.1
  exact ⟨first,by rw [first_def]⟩

+ under_substitution (f : α → α) (a b : α) (h : a = b) : ∃ y, y = f b
  set t := f a with ht
  subst h; exact ⟨t,ht⟩

+ named_term (f : α → α) (x : α) : ∃ y, y = f x := by exact ⟨f x,rfl⟩
+ identity_term (x : α) : x = x := by rfl
+ term_argument (x : ℕ) : x+1 = x+1
  set named_term := x+1
  exact identity_term named_term

+ statement_let (n : ℕ) : let s := n+1 in let t := s+1 in t = (n+1)+1 := by rfl
+ block_let (a : α) : let x : α := a in x = a
  have h : let y := a in y = a := by rfl
  exact h
