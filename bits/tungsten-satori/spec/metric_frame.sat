import algebra.metric_frame

-- The diagonal line in ℂ² with ambient metric diag(1,3).
-> frame_spec.line : MetricFrame :=
  MetricFrame.mk 2 1 (fun i j => if i = j then (if i = 0 then complex.one else complex.of_real 3) else complex.zero)
    (fun i _ => if i < 2 then complex.one else complex.zero)

+ frame_spec.weighted_projection :
    frame_spec.line.project (fun i => if i = 0 then complex.one else complex.zero) 1 = complex.of_real (1 / 4)
  decide

+ frame_spec.empty_projection (x : ℕ → ℂ) (i : ℕ) :
    (MetricFrame.mk 2 0 cmat.id cmat.id).project x i = complex.zero
  exact csum.zero _
