-- Every theorem in this file is FALSE; a sound checker must reject each one.
+ f1 : (1 : ℕ) = 2 := by decide
+ f2 (x y : ℚ) : (x + y) * (x + y) = x * x + y * y := by ring
+ f3 (x : ℚ) (h : 0 < x) : x < 0 := by linarith
+ f4 : ∀ n < 10, n * n < 50 := by decide
+ f5 (p : ℕ → ℕ → Prop) (h1 : ∀ i < 2, ∃ j < 2, p i j) : False := by sat
+ f6 (a b : ℚ) (h : a ≤ b) : b ≤ a := by linarith
+ f7 : (7 : ℕ) ∣ 50 := by decide
+ f8 (x : ℚ) : x * x ≥ x := by
  have s0 : 0 ≤ x ^ 2 := sq_nonneg.rat x
  have s1 : x ^ 2 = x * x := by ring
  linarith
axiom a_false : (1 : ℕ) = 0
+ f9 : (2 : ℕ) = 3 := by
  have h : (1 : ℕ) = 0 := a_false
  linarith

-- Parser traps that drop proof text (TUNGSTEN_ISSUES #98, #100, #105): they must fail closed, never pass a false goal.
+ t105 (x : ℚ) (h : 0 < x) : x < 0 :=
  sorry_free_term_on_next_line
+ t100 (x : ℚ) (h : 0 < x) : x < 0 := by
  calc x < 0 := by
      linarith
+ t_have_only (x : ℚ) (h : 0 < x) : x < 0 := by
  have k : x < 0
  exact k
+ t98b (x : ℚ) (h : 0 < x) : x < 0 := by
  by_cases c : x = 1
  · have k : x < 0 := by
      linarith
    exact k
  · have k : x < 0 := by
      linarith
    exact k

-- `obtain ⟨a, b⟩ | ⟨c, d⟩` once put the second branch's `d` into the first branch's context (fixed 2026-10-12 in
-- lib/tactics.w, destruct_rest). Even with the bug, the kernel refused both: "proof leaves assumptions: 1 < 0 ∧ 1 < 0"
-- and "x is free in hypothesis". x = 1 satisfies each hypothesis and refutes each goal.
+ leak4 (x : ℝ) (h : (0 ≤ x ∧ 0 ≤ x) ∨ (x < 0 ∧ x < 0)) : x < 0
  obtain ⟨a, b⟩ | ⟨c, d⟩ := h
  · linarith
  · linarith
+ leak5 : (1 : ℝ) < 0
  have h : ((0 : ℝ) ≤ 1 ∧ (0 : ℝ) ≤ 1) ∨ ((1 : ℝ) < 0 ∧ (1 : ℝ) < 0) := by
    left
    constructor
    · norm_num
    · norm_num
  obtain ⟨a, b⟩ | ⟨c, d⟩ := h
  · linarith
  · linarith

-- the 2026-10-12 tactics (nlinarith, positivity, omega, the simplex fallback): each statement is false
+ nl1 (x : ℝ) (h : 0 ≤ x) : x * x ≤ x := by nlinarith
+ pos1 (x : ℝ) : 0 < x ^ 2 := by positivity
+ om1 (a b : ℕ) : a - b + b = a := by omega
+ lp1 (a b c d e f g h k m n p : ℝ) (q1 : a ≤ b) (q2 : b ≤ c) (q3 : c ≤ d) (q4 : d ≤ e) (q5 : e ≤ f) (q6 : f ≤ g)
    (q7 : g ≤ h) (q8 : h ≤ k) (q9 : k ≤ m) (q10 : m ≤ n) (q11 : n ≤ p) : p ≤ a := by linarith

-- round 3 (nlinarith over ℕ via nl_cross.nat, monomials of expanded ℕ powers): each statement is false
+ nlnat1 (n : ℕ) (hn : 5 ≤ n) : 36 ≤ n * n := by nlinarith
+ pownat1 (k : ℕ) : 2 ≤ (k + 1) ^ 2 := by linarith
