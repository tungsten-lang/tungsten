+ real_unit (x : ℝ) : 2*x ≤ 1+x^2 := by nlinarith
+ real_negative (x : ℝ) : -2*x ≤ 1+x*x := by nlinarith
+ real_shift (x : ℝ) : 12*x ≤ 4*x*x+9 := by nlinarith
+ real_strict (x : ℝ) : 19-10*x+94*x^2 > 0 := by nlinarith
+ real_reordered (x : ℝ) : 9*x*x-12*x ≥ -4 := by nlinarith
+ rat_unit (x : ℚ) : 2*x ≤ 1+x^2 := by nlinarith
+ rat_negative (x : ℚ) : -2*x ≤ 1+x*x := by nlinarith
+ rat_shift (x : ℚ) : 12*x ≤ 4*x*x+9 := by nlinarith
+ rat_strict (x : ℚ) : 19-10*x+94*x^2 > 0 := by nlinarith
+ rat_reordered (x : ℚ) : 9*x*x-12*x ≥ -4 := by nlinarith
+ int_unit (x : ℤ) : 2*x ≤ 1+x^2 := by nlinarith
+ int_negative (x : ℤ) : -2*x ≤ 1+x*x := by nlinarith
+ int_shift (x : ℤ) : 12*x ≤ 4*x*x+9 := by nlinarith
+ int_strict (x : ℤ) : 19-10*x+94*x^2 > 0 := by nlinarith
+ int_reordered (x : ℤ) : 9*x*x-12*x ≥ -4 := by nlinarith
+ real_fraction (x : ℝ) : x ≤ x*x/3+3/4 := by nlinarith
+ rat_fraction (x : ℚ) : x ≤ x*x/3+3/4 := by nlinarith
+ functions (f : ℕ → ℚ) (n : ℕ) : 12*f n ≤ 4*(f n)^2+9 := by nlinarith
+ siegel (c x u v : ℝ) (hv : c*x < v) : 4*c*x < u^2+(v+1)^2 := by nlinarith
