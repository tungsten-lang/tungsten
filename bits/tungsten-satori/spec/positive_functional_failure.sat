import positive_functional

+ missing_unit (S : set α) (E : (α → ℝ) → ℝ) (pos : functional.positive S E) (add : functional.additive S E) :
    E (fun x => 1) = 1 := by auto
+ missing_add (S : set α) (E : (α → ℝ) → ℝ) (pos : functional.positive S E) (f : α → ℝ) (b : bounded_on S f) :
    E (fun x => (-1)*f x) = (-1)*E f := by auto
+ missing_support (S : set ℝ) (p : ℕ → ℝ) : functional.positive S (functional.atomic p (fun i => 1) 1) := by auto
+ negative_weight (p : ℕ → ℝ) : functional.positive (fun x => True) (functional.atomic p (fun i => -1) 1) := by auto
+ empty_mass (p : ℕ → ℝ) : functional.atomic p (fun i => 1) 0 (fun x => 1) = 1 := by auto
