import power_tangent

+ shifted (a h : ℝ) (n : ℕ) (ha : 0 < a) (hx : 0 ≤ a+h) :
    a^(n+1)+(n:ℝ)*a^n*h ≤ a*(a+h)^n := by auto
+ tangent (a x : ℚ) (k : ℕ) (ha : 0 ≤ a) (hx : 0 ≤ x) :
    a^(k+1)+((k:ℚ)+1)*a^k*(x-a) ≤ x^(k+1) := by auto
+ repeated (a b : ℝ) (n : ℕ) (ha : 0 ≤ a) (hb : 0 ≤ b) :
    ((n:ℝ)+1)^(n+1)*a^n*b ≤ ((n:ℝ)*a+b)^(n+1) := by auto
+ clipped (t : ℚ) (n : ℕ) (hn : 1 ≤ n) :
    1+(n:ℚ)*t ≤ (if 0 ≤ 1+t then (1+t)^n else 0) := by auto
+ loss (q : ℚ) (n : ℕ) (h : q ≤ 1) : 1-(n:ℚ)*q ≤ (1-q)^n := by auto
+ complement (t : ℝ) (n : ℕ) (ht : 0 < t) : 1-t^n ≤ (n:ℝ)*(1-t) := by auto

+ geometric_bound (f : ℕ → ℝ) (k : ℕ) (z : ℝ) (pos : ∀ j < k, 0 ≤ f j)
    (avg : (k:ℝ)*z = (∑ j < k, f j)) : (∏ j < k, f j) ≤ z^k := by auto
+ rational_bound (f : ℕ → ℚ) (k : ℕ) (z : ℚ) (pos : ∀ j < k, 0 ≤ f j)
    (avg : (k:ℚ)*z = (∑ j < k, f j)) : (∏ j < k, f j) ≤ z^k := by auto
+ two_weights (x y z : ℚ) (m n : ℕ) (hx : 0 ≤ x) (hy : 0 ≤ y)
    (avg : ((m:ℚ)+(n:ℚ))*z = (m:ℚ)*x+(n:ℚ)*y) : x^m*y^n ≤ z^(m+n) := by auto
+ empty_mean (f : ℕ → ℝ) (z : ℝ) : (∏ i < 0, f i) ≤ z^0 := by auto

opaque score : ℕ → ℝ
axiom weights (j : ℕ) : 0 ≤ (score j : ℝ)
+ marked (k : ℕ) (z : ℝ) (avg : (k:ℝ)*z = (∑ j < k, score j)) :
    (∏ j < k, score j) ≤ z^k := by auto [weights]
#axioms geometric_bound
#axioms marked
