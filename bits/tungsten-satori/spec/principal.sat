import principal

+ mixed_polynomial (m a b x y s t : ℤ) (h : principal.congruent m x y) (j : principal.congruent m s t) :
    principal.congruent m (-(a + s * (b*x + 1) + a*x^3)) (-(a + t * (b*y + 1) + a*y^3)) := by auto

+ symbolic_power (m a b c d : ℤ) (n : ℕ) (h : principal.congruent m a b) (j : principal.congruent m c d) :
    principal.congruent m ((a-c)^n) ((b-d)^n) := by auto

+ use_factor (m a b k : ℤ) (h : a-b = m*k) : principal.congruent m a b := by auto
+ negative_generator : principal.congruent (-3) 5 2 := by apply principal.of_certificate (-3) 5 2 (-1); decide
+ zero_generator (a b : ℤ) (h : principal.congruent 0 a b) : a = b := (principal.zero_iff a b).mp h
+ from_residues (a b : ℤ) (h : a % 6 = b % 6) : principal.congruent 6 a b := (principal.mod_iff 6 a b (by decide)).mpr h
