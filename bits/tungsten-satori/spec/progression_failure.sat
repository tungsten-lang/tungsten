import progression

+ real_wrong_length (n : ℕ) : (∑ i < n + 1, 3 + 2 * (i : ℝ)) = (n : ℝ) * 3 + 2 * (n : ℝ) * ((n : ℝ) - 1) / 2
  exact sum_below.arithmetic.real 3 2 n

+ real_wrong_shift (s : ℕ → ℝ → ℝ) (a : ℝ) (n : ℕ) (base : ∀ a, s 0 a = 0)
    (step : ∀ i a, s (i + 1) a = a + s i (a + 2)) : s n a = (n : ℝ) * a + 1 * (n : ℝ) * ((n : ℝ) - 1) / 2
  exact recurrence.arithmetic_shift.real s 1 base step n a

+ real_missing_base (s : ℕ → ℝ → ℝ) (a : ℝ) (n : ℕ)
    (step : ∀ i a, s (i + 1) a = a + s i (a + 1)) : s n a = (n : ℝ) * a + 1 * (n : ℝ) * ((n : ℝ) - 1) / 2
  exact recurrence.arithmetic_shift.real s 1 (by assumption) step n a

+ real_wrong_base (s : ℕ → ℝ → ℝ) (a : ℝ) (n : ℕ) (base : ∀ a, s 0 a = 1)
    (step : ∀ i a, s (i + 1) a = a + s i (a + 1)) : s n a = (n : ℝ) * a + 1 * (n : ℝ) * ((n : ℝ) - 1) / 2
  exact recurrence.arithmetic_shift.real s 1 base step n a

+ real_wrong_square (s : ℕ → ℝ → ℝ) (a : ℝ) (n : ℕ) (base : ∀ a, s 0 a = 0)
    (step : ∀ i a, s (i + 1) a = a + s i (a + 1)) : s n a = (n : ℝ) * a ^ 2 + a * 1 * (n : ℝ) * ((n : ℝ) - 1) + 1 ^ 2 * (n : ℝ) * ((n : ℝ) - 1) * (2 * (n : ℝ) - 1) / 6
  exact recurrence.square_shift.real s 1 base step n a

+ real_local_step (s : ℕ → ℝ → ℝ) (a : ℝ) (n : ℕ) (base : ∀ a, s 0 a = 0)
    (step : ∀ i, s (i + 1) a = a + s i (a + 1)) : s n a = (n : ℝ) * a + 1 * (n : ℝ) * ((n : ℝ) - 1) / 2
  exact recurrence.arithmetic_shift.real s 1 base step n a

+ rat_wrong_length (n : ℕ) : (∑ i < n + 1, 3 + 2 * (i : ℚ)) = (n : ℚ) * 3 + 2 * (n : ℚ) * ((n : ℚ) - 1) / 2
  exact sum_below.arithmetic.rat 3 2 n

+ rat_wrong_shift (s : ℕ → ℚ → ℚ) (a : ℚ) (n : ℕ) (base : ∀ a, s 0 a = 0)
    (step : ∀ i a, s (i + 1) a = a + s i (a + 2)) : s n a = (n : ℚ) * a + 1 * (n : ℚ) * ((n : ℚ) - 1) / 2
  exact recurrence.arithmetic_shift.rat s 1 base step n a

+ rat_missing_base (s : ℕ → ℚ → ℚ) (a : ℚ) (n : ℕ)
    (step : ∀ i a, s (i + 1) a = a + s i (a + 1)) : s n a = (n : ℚ) * a + 1 * (n : ℚ) * ((n : ℚ) - 1) / 2
  exact recurrence.arithmetic_shift.rat s 1 (by assumption) step n a

+ rat_wrong_base (s : ℕ → ℚ → ℚ) (a : ℚ) (n : ℕ) (base : ∀ a, s 0 a = 1)
    (step : ∀ i a, s (i + 1) a = a + s i (a + 1)) : s n a = (n : ℚ) * a + 1 * (n : ℚ) * ((n : ℚ) - 1) / 2
  exact recurrence.arithmetic_shift.rat s 1 base step n a

+ rat_wrong_square (s : ℕ → ℚ → ℚ) (a : ℚ) (n : ℕ) (base : ∀ a, s 0 a = 0)
    (step : ∀ i a, s (i + 1) a = a + s i (a + 1)) : s n a = (n : ℚ) * a ^ 2 + a * 1 * (n : ℚ) * ((n : ℚ) - 1) + 1 ^ 2 * (n : ℚ) * ((n : ℚ) - 1) * (2 * (n : ℚ) - 1) / 6
  exact recurrence.square_shift.rat s 1 base step n a

+ rat_local_step (s : ℕ → ℚ → ℚ) (a : ℚ) (n : ℕ) (base : ∀ a, s 0 a = 0)
    (step : ∀ i, s (i + 1) a = a + s i (a + 1)) : s n a = (n : ℚ) * a + 1 * (n : ℚ) * ((n : ℚ) - 1) / 2
  exact recurrence.arithmetic_shift.rat s 1 base step n a

+ int_wrong_length (n : ℕ) : 2 * (∑ i < n + 1, 3 + 2 * (i : ℤ)) = (n : ℤ) * (2 * 3 + 2 * ((n : ℤ) - 1))
  exact sum_below.arithmetic.int 3 2 n

+ int_wrong_shift (s : ℕ → ℤ → ℤ) (a : ℤ) (n : ℕ) (base : ∀ a, s 0 a = 0)
    (step : ∀ i a, s (i + 1) a = a + s i (a + 2)) : 2 * s n a = (n : ℤ) * (2 * a + 1 * ((n : ℤ) - 1))
  exact recurrence.arithmetic_shift.int s 1 base step n a

+ int_missing_base (s : ℕ → ℤ → ℤ) (a : ℤ) (n : ℕ)
    (step : ∀ i a, s (i + 1) a = a + s i (a + 1)) : 2 * s n a = (n : ℤ) * (2 * a + 1 * ((n : ℤ) - 1))
  exact recurrence.arithmetic_shift.int s 1 (by assumption) step n a

+ int_wrong_base (s : ℕ → ℤ → ℤ) (a : ℤ) (n : ℕ) (base : ∀ a, s 0 a = 1)
    (step : ∀ i a, s (i + 1) a = a + s i (a + 1)) : 2 * s n a = (n : ℤ) * (2 * a + 1 * ((n : ℤ) - 1))
  exact recurrence.arithmetic_shift.int s 1 base step n a

+ int_wrong_square (s : ℕ → ℤ → ℤ) (a : ℤ) (n : ℕ) (base : ∀ a, s 0 a = 0)
    (step : ∀ i a, s (i + 1) a = a + s i (a + 1)) : 6 * s n a = 6 * (n : ℤ) * a ^ 2 + 6 * a * 1 * (n : ℤ) * ((n : ℤ) - 1) + 1 ^ 2 * (n : ℤ) * ((n : ℤ) - 1) * (2 * (n : ℤ) - 1)
  exact recurrence.square_shift.int s 1 base step n a

+ int_local_step (s : ℕ → ℤ → ℤ) (a : ℤ) (n : ℕ) (base : ∀ a, s 0 a = 0)
    (step : ∀ i, s (i + 1) a = a + s i (a + 1)) : 2 * s n a = (n : ℤ) * (2 * a + 1 * ((n : ℤ) - 1))
  exact recurrence.arithmetic_shift.int s 1 base step n a

+ nat_wrong_length (n : ℕ) : 2 * (∑ i < n + 1, 3 + 2 * i) + 2 * n = n * (2 * 3 + 2 * n)
  exact sum_below.arithmetic.nat 3 2 n

+ nat_wrong_shift (s : ℕ → ℕ → ℕ) (a : ℕ) (n : ℕ) (base : ∀ a, s 0 a = 0)
    (step : ∀ i a, s (i + 1) a = a + s i (a + 2)) : 2 * s n a + 1 * n = n * (2 * a + 1 * n)
  exact recurrence.arithmetic_shift.nat s 1 base step n a

+ nat_missing_base (s : ℕ → ℕ → ℕ) (a : ℕ) (n : ℕ)
    (step : ∀ i a, s (i + 1) a = a + s i (a + 1)) : 2 * s n a + 1 * n = n * (2 * a + 1 * n)
  exact recurrence.arithmetic_shift.nat s 1 (by assumption) step n a

+ nat_wrong_base (s : ℕ → ℕ → ℕ) (a : ℕ) (n : ℕ) (base : ∀ a, s 0 a = 1)
    (step : ∀ i a, s (i + 1) a = a + s i (a + 1)) : 2 * s n a + 1 * n = n * (2 * a + 1 * n)
  exact recurrence.arithmetic_shift.nat s 1 base step n a

+ nat_wrong_square (s : ℕ → ℕ → ℕ) (a : ℕ) (n : ℕ) (base : ∀ a, s 0 a = 0)
    (step : ∀ i a, s (i + 1) a = a + s i (a + 1)) : 6 * s n a + 6 * a * 1 * n + 3 * 1 ^ 2 * n ^ 2 = 6 * n * a ^ 2 + 6 * a * 1 * n ^ 2 + 2 * 1 ^ 2 * n ^ 3 + 1 ^ 2 * n
  exact recurrence.square_shift.nat s 1 base step n a

+ nat_local_step (s : ℕ → ℕ → ℕ) (a : ℕ) (n : ℕ) (base : ∀ a, s 0 a = 0)
    (step : ∀ i, s (i + 1) a = a + s i (a + 1)) : 2 * s n a + 1 * n = n * (2 * a + 1 * n)
  exact recurrence.arithmetic_shift.nat s 1 base step n a
