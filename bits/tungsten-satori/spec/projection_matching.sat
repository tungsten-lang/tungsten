import euclidean

structure complex_pair := (re : ℝ) (im : ℝ)
-> add_pair (z w : complex_pair) : complex_pair := complex_pair.mk (z.re+w.re) (z.im+w.im)
-> sub_pair (z w : complex_pair) : complex_pair := complex_pair.mk (z.re-w.re) (z.im-w.im)
-> magnitude (z : complex_pair) : ℝ := sqrt (z.re^2+z.im^2)
structure box α := (value : α)
structure transform := (run : ℝ → ℝ)
-> translation (a : ℝ) : transform := transform.mk (fun x => x+a)

+ triangle (z w : complex_pair) : magnitude (add_pair z w) ≤ magnitude z + magnitude w
  auto

+ reverse_triangle (z w : complex_pair) : magnitude z - magnitude w ≤ magnitude (sub_pair z w)
  auto

+ boxed_triangle (z w : complex_pair) : magnitude (box.value (box.mk (add_pair z w))) ≤ magnitude z + magnitude w
  auto

+ function_field (a b c d : ℝ) : sqrt ((transform.run (translation c) a)^2+(b+d)^2) ≤ sqrt (a^2+b^2) + sqrt (c^2+d^2)
  auto

+ applied_triangle (z w : complex_pair) : magnitude (add_pair z w) ≤ magnitude z + magnitude w
  apply norm2.add_le

+ exact_triangle (z w : complex_pair) : magnitude (add_pair z w) ≤ magnitude z + magnitude w
  exact norm2.add_le

+ bare_triangle (z w : complex_pair) : magnitude (add_pair z w) ≤ magnitude z + magnitude w
  norm2.add_le

+ partially_applied (z w : complex_pair) : magnitude (add_pair z w) ≤ magnitude z + magnitude w
  exact norm2.add_le z.re z.im
