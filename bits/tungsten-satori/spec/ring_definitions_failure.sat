  ring
+ int_wrong_tail (x y : ℤ) (xs ys : list ℤ) : total.int (x :: y :: xs) = x+y+total.int ys
  ring
+ int_wrong_argument (f : α → ℤ) (a b : α) : nested.int (f a) (f b) = f a+4*f a
  ring
+ int_missing_condition (p : Prop) (x y : ℤ) : pick.int p x y = x
  ring
+ rat_wrong_nested (x y : ℚ) : nested.rat x y = x+3*y
  ring
+ rat_wrong_fourth (x y : ℚ) : fourth.rat x y = x^4+4*x^3*y+5*x^2*y^2+4*x*y^3+y^4
  ring
+ rat_wrong_projection (x y : ℚ) : fst (pair.rat x y)^2 = x*x+snd (pair.rat x y)+y*y
  ring
+ rat_wrong_tail (x y : ℚ) (xs ys : list ℚ) : total.rat (x :: y :: xs) = x+y+total.rat ys
  ring
+ rat_wrong_argument (f : α → ℚ) (a b : α) : nested.rat (f a) (f b) = f a+4*f a
  ring
+ rat_missing_condition (p : Prop) (x y : ℚ) : pick.rat p x y = x
  ring
+ real_wrong_nested (x y : ℝ) : nested.real x y = x+3*y
  ring
+ real_wrong_fourth (x y : ℝ) : fourth.real x y = x^4+4*x^3*y+5*x^2*y^2+4*x*y^3+y^4
