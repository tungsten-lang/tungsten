+ real_wrong_tail (x y : ℝ) (xs ys : list ℝ) : total.real (x :: y :: xs) = x+y+total.real ys
  ring
+ real_wrong_argument (f : α → ℝ) (a b : α) : nested.real (f a) (f b) = f a+4*f a
  ring
