import sequence

+ orbit_property (f : α → α) (P : α → Prop) (step : ∀ x, P x → P (f x)) (x : α) (hx : P x) (n : ℕ) : P (function.iterate f n x)
  exact function.iterate_invariant f P step n x hx

+ recurrence_origin (f : α → α) (s : ℕ → α) (rec : ∀ n, s (n + 1) = f (s n)) : s 0 = function.iterate f 0 (s 0)
  exact sequence.eq_iterate f s rec 0

+ natural_progress (s : ℕ → ℕ) (rec : ∀ n, s (n + 1) = s n + 1) (h : 0 < s 0) (n : ℕ) : 0 < s n
  exact sequence.invariant (fun x => x + 1) s rec (fun x => 0 < x) (by intro x hx; omega) h n

-> countdown : ℕ → ℕ
  | 0 => 2
  | n + 1 => countdown n - 1
+ countdown_step (n : ℕ) : countdown (n + 1) = countdown n - 1 := by rfl
+ countdown_settled (n : ℕ) (hn : 2 ≤ n) : countdown n = 0
  exact sequence.stable (fun x => x - 1) countdown countdown_step 2 n (by decide) hn
+ countdown_small : ∀ n, countdown n ≤ 2
  exact sequence.forall_of_stable (fun x => x - 1) countdown countdown_step 2 (fun x => x ≤ 2) (by decide) (by decide)
+ countdown_unreachable : ¬ (∃ n, countdown n = 3)
  exact sequence.not_reachable_of_stable (fun x => x - 1) countdown countdown_step 2 (fun x => x = 3) (by decide) (by decide)

-> toggle (n : ℕ) : ℕ := function.iterate (fun x => if x = 0 then 1 else 0) n 0
+ toggle_step (n : ℕ) : toggle (n + 1) = (if toggle n = 0 then 1 else 0) := by rfl
+ toggle_period (n : ℕ) : toggle (n + 2) = toggle n
  have h := sequence.repeat_after_equal (fun x => if x = 0 then 1 else 0) toggle toggle_step 2 0 (by decide) n
  simp at h
  exact h
+ toggle_far : ∃ n, 100 ≤ n ∧ toggle n = 1
  exact sequence.periodic_repeats toggle 2 (by decide) toggle_period 1 100
+ toggle_tail (n : ℕ) (hn : 7 ≤ n) : toggle n = 0 ∨ toggle n = 1
  exact sequence.periodic_tail toggle 2 7 (fun x => x = 0 ∨ x = 1) (by decide) toggle_period (by decide) n hn
+ toggle_run (k i : ℕ) (block : ∀ x < k, toggle (i + x) = 0) : k < 2
  exact sequence.periodic_run_bound toggle 2 k i 0 (by decide) toggle_period block ⟨1, by decide⟩
+ empty_run : 0 < (2 : ℕ)
  exact sequence.periodic_run_bound toggle 2 0 7 0 (by decide) toggle_period (by intro x hx; omega) ⟨1, by decide⟩

-- The periodicity rules also work on sequences whose values are not numbers.
+ periodic_lists (s : ℕ → list α) (p : ℕ) (hp : 0 < p) (h : ∀ n, s (n + p) = s n) (j : ℕ) : ∃ n, 50 ≤ n ∧ s n = s j
  exact sequence.periodic_repeats s p hp h j 50

#axioms orbit_property
#axioms recurrence_origin
#axioms natural_progress
#axioms countdown_settled
#axioms countdown_small
#axioms countdown_unreachable
#axioms toggle_period
#axioms toggle_far
#axioms toggle_tail
#axioms toggle_run
#axioms empty_run
#axioms periodic_lists
