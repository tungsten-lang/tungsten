import sequence

+ missing_recurrence (f : α → α) (s : ℕ → α) (k j : ℕ) (fixed : f (s k) = s k) (after : k ≤ j) : s j = s k
  exact sequence.stable f s k j fixed after

+ missing_initial (f : α → α) (s : ℕ → α) (rec : ∀ n, s (n + 1) = f (s n))
    (P : α → Prop) (step : ∀ x, P x → P (f x)) (n : ℕ) : P (s n)
  exact sequence.invariant f s rec P step n

+ backward_invariant (f : α → α) (P : α → Prop) (step : ∀ x, P (f x) → P x) (x : α) (hx : P x) (n : ℕ) : P (function.iterate f n x)
  exact function.iterate_invariant f P step n x hx

+ before_fixed (f : α → α) (s : ℕ → α) (rec : ∀ n, s (n + 1) = f (s n)) (fixed : f (s 2) = s 2) : s 0 = s 2
  exact sequence.stable f s rec 2 0 fixed (by omega)

+ wrong_fixed_point (f : α → α) (s : ℕ → α) (rec : ∀ n, s (n + 1) = f (s n)) (fixed : f (s 3) = s 3) : s 2 = s 1
  exact sequence.stable f s rec 1 2 fixed (by decide)

+ omitted_endpoint (f : α → α) (s : ℕ → α) (rec : ∀ n, s (n + 1) = f (s n))
    (k : ℕ) (P : α → Prop) (fixed : f (s k) = s k) (prefix : ∀ j < k, ¬ P (s j)) : ¬ (∃ j, P (s j))
  exact sequence.not_reachable_of_stable f s rec k P fixed prefix

+ unequal_states (f : α → α) (s : ℕ → α) (rec : ∀ n, s (n + 1) = f (s n)) (i j k : ℕ) (h : s i ≠ s j) : s (k + i) = s (k + j)
  exact sequence.repeat_after_equal f s rec i j h k

+ zero_period (s : ℕ → α) (h : ∀ n, s (n + 0) = s n) : ∃ n, 1 ≤ n ∧ s n = s 0
  exact sequence.periodic_repeats s 0 (by omega) h 0 1

+ incomplete_block (s : ℕ → α) (p : ℕ) (P : α → Prop) (hp : 0 < p) (period : ∀ n, s (n + p) = s n)
    (block : ∀ x < p - 1, P (s (7 + x))) (n : ℕ) (hn : 7 ≤ n) : P (s n)
  exact sequence.periodic_tail s p 7 P hp period block n hn

+ constant_run (s : ℕ → α) (p k i : ℕ) (a : α) (hp : 0 < p) (period : ∀ n, s (n + p) = s n) (block : ∀ x < k, s (i + x) = a) : k < p
  exact sequence.periodic_run_bound s p k i a hp period block
