import sobolev

+ reversed (volume : set α → ℝ → Prop) (r : α → ℝ) (f : α → ℝ × ℝ)
    (hf : sobolev.finite volume r f 0) : sobolev.finite volume r f 1 := by auto

+ different_profile (volume : set α → ℝ → Prop) (r : α → ℝ) (f g : α → ℝ × ℝ)
    (hf : sobolev.finite volume r f 1) : sobolev.finite volume r g 0 := by auto

+ different_volume (v w : set α → ℝ → Prop) (r : α → ℝ) (f : α → ℝ × ℝ)
    (hf : sobolev.finite v r f 1) : sobolev.finite w r f 0 := by auto

+ strict_at_origin : sobolev.weight 0 0 < sobolev.weight 1 0 := by auto
