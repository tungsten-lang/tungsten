+ nat_weighted_nonneg (xs : list α) (w f : α → ℕ) : 0 ≤ sum_list xs (fun x => w x * (f x * f x)) := list_sum.weighted_squares_nonneg.nat xs w f
+ nat_weighted_terms (xs : list α) (w f : α → ℕ) (p : ∀ x ∈ xs, 0 < w x) (h : sum_list xs (fun x => w x * (f x * f x)) = 0) : ∀ x ∈ xs, f x = 0 := (list_sum.weighted_squares_eq_zero_iff.nat xs w f p).mp h
