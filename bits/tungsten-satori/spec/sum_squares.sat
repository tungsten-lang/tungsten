+ nat_powers (xs : list α) (f : α → ℕ) : sum_list xs (fun x => f x ^ 2) = 0 ↔ ∀ x ∈ xs, f x = 0
  simpa [pow_two.nat] using list_sum.squares_eq_zero_iff.nat xs f
+ nat_empty (f : ℕ → ℕ) : sum_list [] (fun x => f x * f x) = 0 := by rfl
