import sum_squares

+ real_nonneg (xs : list α) (f : α → ℝ) : 0 ≤ sum_list xs (fun x => f x * f x) := list_sum.squares_nonneg.real xs f
+ real_terms (xs : list α) (f : α → ℝ) (h : sum_list xs (fun x => f x * f x) = 0) : ∀ x ∈ xs, f x = 0 := (list_sum.squares_eq_zero_iff.real xs f).mp h
+ real_zero (xs : list α) (f : α → ℝ) (h : ∀ x ∈ xs, f x = 0) : sum_list xs (fun x => f x * f x) = 0 := (list_sum.squares_eq_zero_iff.real xs f).mpr h
+ real_weighted_nonneg (xs : list α) (w f : α → ℝ) (h : ∀ x ∈ xs, 0 ≤ w x) : 0 ≤ sum_list xs (fun x => w x * (f x * f x)) := list_sum.weighted_squares_nonneg.real xs w f h
+ real_weighted_terms (xs : list α) (w f : α → ℝ) (p : ∀ x ∈ xs, 0 < w x) (h : sum_list xs (fun x => w x * (f x * f x)) = 0) : ∀ x ∈ xs, f x = 0 := (list_sum.weighted_squares_eq_zero_iff.real xs w f p).mp h
+ real_weighted_zero (xs : list α) (w f : α → ℝ) (p : ∀ x ∈ xs, 0 < w x) (h : ∀ x ∈ xs, f x = 0) : sum_list xs (fun x => w x * (f x * f x)) = 0 := (list_sum.weighted_squares_eq_zero_iff.real xs w f p).mpr h
+ real_powers (xs : list α) (f : α → ℝ) : sum_list xs (fun x => f x ^ 2) = 0 ↔ ∀ x ∈ xs, f x = 0
  simpa [pow_two.real] using list_sum.squares_eq_zero_iff.real xs f
+ real_empty (f : ℕ → ℝ) : sum_list [] (fun x => f x * f x) = 0 := by rfl
+ real_repeated (x : ℝ) (h : sum_list [x, x] (fun y => y * y) = 0) : x = 0 := (list_sum.squares_eq_zero_iff.real [x, x] (fun y => y)).mp h x (by simp)
+ real_zero_weights : sum_list [1] (fun (x : ℝ) => 0 * (x * x)) = 0 ∧ ¬ (∀ x ∈ [1], (x : ℝ) = 0) := by decide
+ real_signed_cancellation : sum_list [-1, 1] (fun (x : ℝ) => x * (1 * 1)) = 0 ∧ ¬ (∀ x ∈ [-1, 1], (1 : ℝ) = 0) := by decide

+ rat_nonneg (xs : list α) (f : α → ℚ) : 0 ≤ sum_list xs (fun x => f x * f x) := list_sum.squares_nonneg.rat xs f
+ rat_terms (xs : list α) (f : α → ℚ) (h : sum_list xs (fun x => f x * f x) = 0) : ∀ x ∈ xs, f x = 0 := (list_sum.squares_eq_zero_iff.rat xs f).mp h
+ rat_zero (xs : list α) (f : α → ℚ) (h : ∀ x ∈ xs, f x = 0) : sum_list xs (fun x => f x * f x) = 0 := (list_sum.squares_eq_zero_iff.rat xs f).mpr h
