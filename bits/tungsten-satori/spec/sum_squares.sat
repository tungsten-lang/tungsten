+ rat_weighted_zero (xs : list α) (w f : α → ℚ) (p : ∀ x ∈ xs, 0 < w x) (h : ∀ x ∈ xs, f x = 0) : sum_list xs (fun x => w x * (f x * f x)) = 0 := (list_sum.weighted_squares_eq_zero_iff.rat xs w f p).mpr h
+ rat_powers (xs : list α) (f : α → ℚ) : sum_list xs (fun x => f x ^ 2) = 0 ↔ ∀ x ∈ xs, f x = 0
  simpa [pow_two.rat] using list_sum.squares_eq_zero_iff.rat xs f
+ rat_empty (f : ℕ → ℚ) : sum_list [] (fun x => f x * f x) = 0 := by rfl
+ rat_repeated (x : ℚ) (h : sum_list [x, x] (fun y => y * y) = 0) : x = 0 := (list_sum.squares_eq_zero_iff.rat [x, x] (fun y => y)).mp h x (by simp)
+ rat_zero_weights : sum_list [1] (fun (x : ℚ) => 0 * (x * x)) = 0 ∧ ¬ (∀ x ∈ [1], (x : ℚ) = 0) := by decide
+ rat_signed_cancellation : sum_list [-1, 1] (fun (x : ℚ) => x * (1 * 1)) = 0 ∧ ¬ (∀ x ∈ [-1, 1], (1 : ℚ) = 0) := by decide

