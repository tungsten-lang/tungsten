+ int_zero_weights : sum_list [1] (fun (x : ℤ) => 0 * (x * x)) = 0 ∧ ¬ (∀ x ∈ [1], (x : ℤ) = 0) := by decide
+ int_signed_cancellation : sum_list [-1, 1] (fun (x : ℤ) => x * (1 * 1)) = 0 ∧ ¬ (∀ x ∈ [-1, 1], (1 : ℤ) = 0) := by decide

+ nat_nonneg (xs : list α) (f : α → ℕ) : 0 ≤ sum_list xs (fun x => f x * f x) := list_sum.squares_nonneg.nat xs f
+ nat_terms (xs : list α) (f : α → ℕ) (h : sum_list xs (fun x => f x * f x) = 0) : ∀ x ∈ xs, f x = 0 := (list_sum.squares_eq_zero_iff.nat xs f).mp h
