+ rat_missing_sign (xs : list α) (w f : α → ℚ) : 0 ≤ sum_list xs (fun x => w x * (f x * f x)) := list_sum.weighted_squares_nonneg.rat xs w f (by auto)
+ rat_negative_weight : 0 ≤ sum_list [-1] (fun (x : ℚ) => x * (1 * 1)) := list_sum.weighted_squares_nonneg.rat [(-1 : ℚ)] (fun x => x) (fun x => 1) (by intro x hx; simp at hx; rw [hx]; decide)

+ int_weak_weights (xs : list α) (w f : α → ℤ) (p : ∀ x ∈ xs, 0 ≤ w x) (h : sum_list xs (fun x => w x * (f x * f x)) = 0) : ∀ x ∈ xs, f x = 0 := (list_sum.weighted_squares_eq_zero_iff.int xs w f p).mp h
