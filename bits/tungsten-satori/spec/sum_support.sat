+ nat_bounded_zero (f : ℕ → ℕ) (n : ℕ) (h : ∀ i < n, f i = 0) : (∑ i < n, f i) = 0 := sum_below.eq_zero.nat f n h
+ nat_bounded_terms (f : ℕ → ℕ) (n : ℕ) (hz : (∑ i < n, f i) = 0) : ∀ i < n, f i = 0 := (sum_below.eq_zero_iff.nat f n).mp hz
