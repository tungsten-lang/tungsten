+ int_empty (f : ℕ → ℤ) : (∑ i < 0, f i) = 0 := by apply sum_below.eq_zero.int; intro i hi; omega
+ int_repeated (f : ℕ → ℤ) (h : f 1 = 0 ∧ f 2 = 0) : sum_list [1, 1, 2] f = 0
