import sum_support

+ real_constant (n : ℕ) : (∑ i < n, (0 : ℝ)) = 0 := sum_below.zero.real n
+ real_bounded_zero (f : ℕ → ℝ) (n : ℕ) (h : ∀ i < n, f i = 0) : (∑ i < n, f i) = 0 := sum_below.eq_zero.real f n h
+ real_bounded_terms (f : ℕ → ℝ) (n : ℕ) (hn : ∀ i < n, 0 ≤ f i) (hz : (∑ i < n, f i) = 0) : ∀ i < n, f i = 0 := (sum_below.eq_zero_iff.real f n hn).mp hz
+ real_bounded_positive (f : ℕ → ℝ) (n : ℕ) (hn : 0 < n) (hp : ∀ i < n, 0 < f i) : 0 < (∑ i < n, f i) := sum_below.pos.real f n hn hp
+ real_bounded_witness (f : ℕ → ℝ) (n k : ℕ) (hn : ∀ i < n, 0 ≤ f i) (hk : k < n) (hp : 0 < f k) : 0 < (∑ i < n, f i) := (sum_below.pos_iff.real f n hn).mpr ⟨k, hk, hp⟩
+ real_bounded_find (f : ℕ → ℝ) (n : ℕ) (hn : ∀ i < n, 0 ≤ f i) (hp : 0 < (∑ i < n, f i)) : ∃ i < n, 0 < f i := (sum_below.pos_iff.real f n hn).mp hp
+ real_list_zero (xs : list α) (f : α → ℝ) (h : ∀ x ∈ xs, f x = 0) : sum_list xs f = 0 := list_sum.eq_zero.real xs f h
+ real_list_terms (xs : list α) (f : α → ℝ) (hn : ∀ x ∈ xs, 0 ≤ f x) (hz : sum_list xs f = 0) : ∀ x ∈ xs, f x = 0 := (list_sum.eq_zero_iff.real xs f hn).mp hz
+ real_list_witness (xs : list α) (f : α → ℝ) (x : α) (hn : ∀ x ∈ xs, 0 ≤ f x) (hx : x ∈ xs) (hp : 0 < f x) : 0 < sum_list xs f := (list_sum.pos_iff.real xs f hn).mpr ⟨x, hx, hp⟩
+ real_list_find (xs : list α) (f : α → ℝ) (hn : ∀ x ∈ xs, 0 ≤ f x) (hp : 0 < sum_list xs f) : ∃ x ∈ xs, 0 < f x := (list_sum.pos_iff.real xs f hn).mp hp
+ real_empty (f : ℕ → ℝ) : (∑ i < 0, f i) = 0 := by apply sum_below.eq_zero.real; intro i hi; omega
+ real_repeated (f : ℕ → ℝ) (h : f 1 = 0 ∧ f 2 = 0) : sum_list [1, 1, 2] f = 0
  apply list_sum.eq_zero.real
  intro x hx
  simp at hx
  obtain a | b | c := hx
  · rw [a]; exact h.1
  · rw [b]; exact h.1
  · rw [c]; exact h.2
+ real_signed_cancellation : (∑ i < 2, (if i = 0 then 1 else -1 : ℝ)) = 0 ∧ ¬ (∀ i < 2, (if i = 0 then 1 else -1 : ℝ) = 0) := by decide

+ rat_constant (n : ℕ) : (∑ i < n, (0 : ℚ)) = 0 := sum_below.zero.rat n
+ rat_bounded_zero (f : ℕ → ℚ) (n : ℕ) (h : ∀ i < n, f i = 0) : (∑ i < n, f i) = 0 := sum_below.eq_zero.rat f n h
