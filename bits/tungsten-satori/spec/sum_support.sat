+ rat_bounded_witness (f : ℕ → ℚ) (n k : ℕ) (hn : ∀ i < n, 0 ≤ f i) (hk : k < n) (hp : 0 < f k) : 0 < (∑ i < n, f i) := (sum_below.pos_iff.rat f n hn).mpr ⟨k, hk, hp⟩
+ rat_bounded_find (f : ℕ → ℚ) (n : ℕ) (hn : ∀ i < n, 0 ≤ f i) (hp : 0 < (∑ i < n, f i)) : ∃ i < n, 0 < f i := (sum_below.pos_iff.rat f n hn).mp hp
+ rat_list_zero (xs : list α) (f : α → ℚ) (h : ∀ x ∈ xs, f x = 0) : sum_list xs f = 0 := list_sum.eq_zero.rat xs f h
+ rat_list_terms (xs : list α) (f : α → ℚ) (hn : ∀ x ∈ xs, 0 ≤ f x) (hz : sum_list xs f = 0) : ∀ x ∈ xs, f x = 0 := (list_sum.eq_zero_iff.rat xs f hn).mp hz
+ rat_list_witness (xs : list α) (f : α → ℚ) (x : α) (hn : ∀ x ∈ xs, 0 ≤ f x) (hx : x ∈ xs) (hp : 0 < f x) : 0 < sum_list xs f := (list_sum.pos_iff.rat xs f hn).mpr ⟨x, hx, hp⟩
+ rat_list_find (xs : list α) (f : α → ℚ) (hn : ∀ x ∈ xs, 0 ≤ f x) (hp : 0 < sum_list xs f) : ∃ x ∈ xs, 0 < f x := (list_sum.pos_iff.rat xs f hn).mp hp
+ rat_empty (f : ℕ → ℚ) : (∑ i < 0, f i) = 0 := by apply sum_below.eq_zero.rat; intro i hi; omega
+ rat_repeated (f : ℕ → ℚ) (h : f 1 = 0 ∧ f 2 = 0) : sum_list [1, 1, 2] f = 0
  apply list_sum.eq_zero.rat
  intro x hx
  simp at hx
  obtain a | b | c := hx
  · rw [a]; exact h.1
  · rw [b]; exact h.1
  · rw [c]; exact h.2
+ rat_signed_cancellation : (∑ i < 2, (if i = 0 then 1 else -1 : ℚ)) = 0 ∧ ¬ (∀ i < 2, (if i = 0 then 1 else -1 : ℚ) = 0) := by decide

