+ nat_empty (f : ℕ → ℕ) : (∑ i < 0, f i) = 0 := by apply sum_below.eq_zero.nat; intro i hi; omega
+ nat_repeated (f : ℕ → ℕ) (h : f 1 = 0 ∧ f 2 = 0) : sum_list [1, 1, 2] f = 0
