+ int_list_zero (xs : list α) (f : α → ℤ) (h : ∀ x ∈ xs, f x = 0) : sum_list xs f = 0 := list_sum.eq_zero.int xs f h
+ int_list_terms (xs : list α) (f : α → ℤ) (hn : ∀ x ∈ xs, 0 ≤ f x) (hz : sum_list xs f = 0) : ∀ x ∈ xs, f x = 0 := (list_sum.eq_zero_iff.int xs f hn).mp hz
