+ int_outside_bound (f : ℕ → ℤ) (n : ℕ) (hn : ∀ i < n, 0 ≤ f i) (hz : (∑ i < n, f i) = 0) : f n = 0 := by exact (sum_below.eq_zero_iff.int f n hn).mp hz n (by omega)
