+ rat_missing_sign (f : ℕ → ℚ) (n : ℕ) (hz : (∑ i < n, f i) = 0) : ∀ i < n, f i = 0 := by exact (sum_below.eq_zero_iff.rat f n (by intro i hi; linarith)).mp hz
