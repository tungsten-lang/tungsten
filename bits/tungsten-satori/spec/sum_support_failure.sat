+ int_missing_sign (f : ℕ → ℤ) (n : ℕ) (hz : (∑ i < n, f i) = 0) : ∀ i < n, f i = 0 := by exact (sum_below.eq_zero_iff.int f n (by intro i hi; linarith)).mp hz
