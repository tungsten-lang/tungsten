import sum_support

+ real_outside_bound (f : ℕ → ℝ) (n : ℕ) (hn : ∀ i < n, 0 ≤ f i) (hz : (∑ i < n, f i) = 0) : f n = 0 := by exact (sum_below.eq_zero_iff.real f n hn).mp hz n (by omega)
+ real_wrong_total (f : ℕ → ℝ) (n : ℕ) (hn : ∀ i < n, 0 ≤ f i) (hz : (∑ i < n, f i) = 1) : ∀ i < n, f i = 0 := by exact (sum_below.eq_zero_iff.real f n hn).mp hz
+ real_weak_positive (f : ℕ → ℝ) (n : ℕ) (hn : ∀ i < n, 0 ≤ f i) (h : ∃ i < n, 0 ≤ f i) : 0 < (∑ i < n, f i) := by exact (sum_below.pos_iff.real f n hn).mpr h
+ real_empty_positive (f : ℕ → ℝ) : 0 < (∑ i < 0, f i) := by exact sum_below.pos.real f 0 (by decide) (by intro i hi; omega)
+ real_outside_member (xs : list α) (f : α → ℝ) (x : α) (hn : ∀ x ∈ xs, 0 ≤ f x) (hz : sum_list xs f = 0) : f x = 0 := by exact (list_sum.eq_zero_iff.real xs f hn).mp hz x (by auto)
+ real_wrong_list_total (xs : list α) (f : α → ℝ) (hn : ∀ x ∈ xs, 0 ≤ f x) (hz : sum_list xs f = 1) : ∀ x ∈ xs, f x = 0 := by exact (list_sum.eq_zero_iff.real xs f hn).mp hz
+ real_missing_sign (f : ℕ → ℝ) (n : ℕ) (hz : (∑ i < n, f i) = 0) : ∀ i < n, f i = 0 := by exact (sum_below.eq_zero_iff.real f n (by intro i hi; linarith)).mp hz
+ real_missing_list_sign (xs : list α) (f : α → ℝ) (hz : sum_list xs f = 0) : ∀ x ∈ xs, f x = 0 := by exact (list_sum.eq_zero_iff.real xs f (by intro x hx; linarith)).mp hz

