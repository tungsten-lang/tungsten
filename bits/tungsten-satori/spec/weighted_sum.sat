import list_sum

+ weighted_comparison (xs : list α) (w f g : α → ℝ) (hw : ∀ x ∈ xs, 0 ≤ w x) (h : ∀ x ∈ xs, f x ≤ g x) : (∑ x ∈ xs, w x * f x) ≤ ∑ x ∈ xs, w x * g x := sum_list_weighted_le.real xs w f g hw h
+ integer_lower (xs : list α) (w f : α → ℤ) (c : ℤ) (hw : ∀ x ∈ xs, 0 ≤ w x) (h : ∀ x ∈ xs, c ≤ f x) : c * (∑ x ∈ xs, w x) ≤ ∑ x ∈ xs, w x * f x := sum_list_weighted_lower.int xs w f c hw h
+ rational_upper (xs : list α) (w f : α → ℚ) (c : ℚ) (hw : ∀ x ∈ xs, 0 ≤ w x) (h : ∀ x ∈ xs, f x ≤ c) : (∑ x ∈ xs, w x * f x) ≤ c * ∑ x ∈ xs, w x := sum_list_weighted_upper.rat xs w f c hw h
+ natural_comparison (xs : list α) (w f g : α → ℕ) (h : ∀ x ∈ xs, f x ≤ g x) : (∑ x ∈ xs, w x * f x) ≤ ∑ x ∈ xs, w x * g x := sum_list_weighted_le.nat xs w f g h
+ different_index_types (xs : list α) (ys : list β) (w : α → ℚ) (v : β → ℚ) (f : α → β → ℚ) (c : ℚ) (hw : ∀ x ∈ xs, 0 ≤ w x) (hv : ∀ y ∈ ys, 0 ≤ v y) (h : ∀ x ∈ xs, ∀ y ∈ ys, c ≤ f x y) : c * (sum_list xs w * sum_list ys v) ≤ sum_list xs (fun x => w x * sum_list ys (fun y => v y * f x y)) := sum_list_double_lower.rat xs ys w v f c hw hv h
+ natural_double (xs : list α) (ys : list β) (w : α → ℕ) (v : β → ℕ) (f : α → β → ℕ) (c : ℕ) (h : ∀ x ∈ xs, ∀ y ∈ ys, f x y ≤ c) : sum_list xs (fun x => w x * sum_list ys (fun y => v y * f x y)) ≤ c * (sum_list xs w * sum_list ys v) := sum_list_double_upper.nat xs ys w v f c h

-- Negative values outside the list do not constrain a weight function.
-> local_weight (x : ℕ) : ℤ := if x = 1 then 2 else -7
+ duplicate_members (f : ℕ → ℤ) (hf : -3 ≤ f 1) : -3 * sum_list [1, 1] local_weight ≤ sum_list [1, 1] (fun x => local_weight x * f x)
  apply sum_list_weighted_lower.int
  · intro x hx; simp at hx; rw [hx]; decide
  · intro x hx; simp at hx; rw [hx]; exact hf
+ negative_upper : sum_list [1, 1] (fun x => (2 : ℤ) * -3) ≤ -1 * sum_list [1, 1] (fun x => (2 : ℤ))
  apply sum_list_weighted_upper.int
  · intro x hx; decide
  · intro x hx; decide
+ zero_bound (xs : list α) (w f : α → ℝ) (hw : ∀ x ∈ xs, 0 ≤ w x) (hf : ∀ x ∈ xs, 0 ≤ f x) : 0 * sum_list xs w ≤ sum_list xs (fun x => w x * f x) := sum_list_weighted_lower.real xs w f 0 hw hf
+ empty_outer (v : β → ℝ) (f : α → β → ℝ) (c : ℝ) (ys : list β) (hv : ∀ y ∈ ys, 0 ≤ v y) : c * (sum_list ([] : list α) (fun x => -1) * sum_list ys v) ≤ sum_list ([] : list α) (fun x => -1 * sum_list ys (fun y => v y * f x y))
  apply sum_list_double_lower.real
  · intro x hx; simp at hx
  · exact hv
  · intro x hx; simp at hx
+ empty_inner (w : α → ℚ) (f : α → β → ℚ) (c : ℚ) (xs : list α) (hw : ∀ x ∈ xs, 0 ≤ w x) : sum_list xs (fun x => w x * sum_list ([] : list β) (fun y => -1 * f x y)) ≤ c * (sum_list xs w * sum_list ([] : list β) (fun y => -1))
  apply sum_list_double_upper.rat
  · exact hw
  · intro y hy; simp at hy
  · intro x hx y hy; simp at hy

-- Exact definitions and bound statements from the Borsuk convexity argument.
-> ix : list ℝ → ℕ → ℝ
  | [], n => 0
  | x :: xs, 0 => x
  | x :: xs, n + 1 => ix xs n
-> dot (u v : list ℝ) : ℝ := ix u 0 * ix v 0 + ix u 1 * ix v 1 + ix u 2 * ix v 2 + ix u 3 * ix v 3
+ comb_lower (G : list (list ℝ)) (lam mu : list ℝ → ℝ) (m : ℝ) (hl : ∀ g, 0 ≤ lam g) (hm : ∀ g, 0 ≤ mu g)
    (hb : ∀ x ∈ G, ∀ y ∈ G, m ≤ dot x y)
    : m * (sum_list G lam * sum_list G mu) ≤ sum_list G (fun g => lam g * sum_list G (fun h => mu h * dot g h))
  apply sum_list_double_lower.real <;> auto
+ comb_upper (G : list (list ℝ)) (lam mu : list ℝ → ℝ) (B : ℝ) (hl : ∀ g, 0 ≤ lam g) (hm : ∀ g, 0 ≤ mu g)
    (hb : ∀ x ∈ G, ∀ y ∈ G, dot x y ≤ B)
    : sum_list G (fun g => lam g * sum_list G (fun h => mu h * dot g h)) ≤ B * (sum_list G lam * sum_list G mu)
  apply sum_list_double_upper.real <;> auto
+ angle_algebra (m B l1 l2 x : ℝ) (hm : 0 < m) (hB : 0 < B) (h1 : 0 ≤ l1) (h2 : 0 ≤ l2)
    (hu : 1 ≤ B * (l1 * l1)) (hv : 1 ≤ B * (l2 * l2)) (hx : m * (l1 * l2) ≤ x) : m * (1 / B) ≤ x
  have h := le_mul_of_le_mul_self.real 1 B l1 l2 (by linarith) (by nlinarith) hu hv
  rw [← div_def.real, div_le_iff.real m x B hB]
  nlinarith

#axioms weighted_comparison
#axioms natural_comparison
#axioms integer_lower
#axioms rational_upper
#axioms different_index_types
#axioms natural_double
#axioms duplicate_members
#axioms empty_outer
#axioms empty_inner
#axioms comb_lower
#axioms comb_upper
#axioms angle_algebra
