# Per-instance SAT backdoor tables and their finisher, split out of mdp.w.
# Soundness: a table entry only seeds the lucky-phase propagator; the
# completed assignment must satisfy the original CNF before publication.
# Provenance and the case for replacing hand-pasted tables with a finder:
# docs/backdoor-tables-audit-2026-10-27.md.

-> wassat_sparse_pos_check(fla, fcs, fcl, ncl, nv, trues, sign) (i64[] i64[] i64[] i64 i64 i64[] i8[]) bool
  v = 1
  while v <= nv
    sign[v] = -1
    v += 1
  i = 0
  while i < trues.size
    tv = trues[i]
    if tv >= 1 && tv <= nv
      sign[tv] = 1
    i += 1
  ci = 0
  while ci < ncl
    off = fcs[ci]
    len = fcl[ci]
    sat = false
    j = 0
    while j < len
      l = fla[off + j]
      if l > 0
        if sign[l] > 0
          sat = true
          break
      elsif l < 0
        if sign[0 - l] < 0
          sat = true
          break
      j += 1
    return false unless sat
    ci += 1
  true

