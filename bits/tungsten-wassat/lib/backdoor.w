-> wassat_unpack_pos10(words)
  res = []
  v = 0
  wi = 0
  while wi < words.size
    w = words[wi]
    j = 0
    while j < 6
      s = (w >> (10 * j)) & 1023
      if s == 0
        break
      elsif s <= 1000
        v += s
        res.push(v)
      else
        v += (s - 1000) * 1000
      j += 1
    wi += 1
  res

-> wassat_pos_backdoor_finish(formula, result, trues, neg_cap)
  fla = formula["flat_lits"] ## i64[]
  fcs = formula["flat_offs"] ## i64[]
  fcl = formula["flat_lens"] ## i64[]
  nv = formula["nvars"]
  ncl = formula["flat_ncl"]
  slits = i64[fla.size]
  i = 0
  while i < fla.size
    slits[i] = fla[i]
    i += 1
  sign = i8[nv + 1]
  trail = i32[nv + 2]
  whead = i32[2 * nv + 4]
  wnext = i32[2 * ncl]
  st = i64[8]
  rc = wassat_flat_lucky_init(slits, fcs, fcl, whead, wnext, sign, trail, st, ncl, nv)
  return result if rc != 0
  tsize = st[1]
  if neg_cap > 0
    target = i8[neg_cap + 1]
    v = 1
    while v <= neg_cap
      target[v] = -1
      v += 1
    ti = 0
    while ti < trues.size
      tv = trues[ti]
      target[tv] = 1
      ti += 1
    v = 1
    while v <= neg_cap
      want = target[v]
      sv = sign[v]
      if sv == 0
        sign[v] = want
        trail[tsize] = want > 0 ? v : 0 - v
        tsize += 1
      elsif sv != want
        return result
      v += 1
  else
    ti = 0
    while ti < trues.size
      tv = trues[ti]
      sv = sign[tv]
      if sv == 0
        sign[tv] = 1
        trail[tsize] = tv
        tsize += 1
      elsif sv < 0
        return result
      ti += 1
  st[1] = tsize
  rc = wassat_flat_lucky_prop(slits, fcs, fcl, whead, wnext, sign, trail, st)
  return result if rc < 0
  st[2] = st[1]
  rc = wassat_flat_lucky_dive(slits, fcs, fcl, whead, wnext, sign, trail, st, nv, 0 - 1, 0)
  return result if rc != 1
  model = i64[nv]
  v = 1
  while v <= nv
    model[v - 1] = sign[v] >= 0 ? v : 0 - v
    v += 1
  return result unless wassat_model_satisfies?(formula, model)
  result["recognized"] = true
  result["bits"] = trues.size
  result["samples"] = nv
  result["trials"] = 1
  result["status"] = 1
  result["model"] = model
  result

-> wassat_pos_backdoor_multi(formula, result, cands)
  fla = formula["flat_lits"] ## i64[]
  fcs = formula["flat_offs"] ## i64[]
  fcl = formula["flat_lens"] ## i64[]
  nv = formula["nvars"]
  ncl = formula["flat_ncl"]
  slits = i64[fla.size]
  i = 0
  while i < fla.size
    slits[i] = fla[i]
    i += 1
  sign = i8[nv + 1]
  trail = i32[nv + 2]
  whead = i32[2 * nv + 4]
  wnext = i32[2 * ncl]
  st = i64[8]
  rc = wassat_flat_lucky_init(slits, fcs, fcl, whead, wnext, sign, trail, st, ncl, nv)
  return result if rc != 0
  init_tsize = st[1]
  ci = 0
  while ci < cands.size
    trues = cands[ci]
    cur_t = st[1]
    while cur_t > init_tsize
      cur_t -= 1
      u = trail[cur_t] ## i64
      uav = u < 0 ? 0 - u : u
      sign[uav] = 0
    tsize = init_tsize
    st[0] = init_tsize
    ok = true
    ti = 0
    while ti < trues.size
      tv = trues[ti]
      sv = sign[tv]
      if sv == 0
        sign[tv] = 1
        trail[tsize] = tv
        tsize += 1
      elsif sv < 0
        ok = false
        break
      ti += 1
    st[1] = tsize
    if ok
      rc2 = wassat_flat_lucky_prop(slits, fcs, fcl, whead, wnext, sign, trail, st)
      if rc2 >= 0
        st[2] = st[1]
        rc3 = wassat_flat_lucky_dive(slits, fcs, fcl, whead, wnext, sign, trail, st, nv, 0 - 1, 0)
        if rc3 == 1
          model = i64[nv]
          v = 1
          while v <= nv
            model[v - 1] = sign[v] >= 0 ? v : 0 - v
            v += 1
          if wassat_model_satisfies?(formula, model)
            result["recognized"] = true
            result["bits"] = trues.size
            result["samples"] = nv
            result["trials"] = ci + 1
            result["status"] = 1
            result["model"] = model
            return result
    ci += 1
  result

