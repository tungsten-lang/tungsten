tungsten "tungsten-0.0.1"

name        "tungsten-wrat"
version     "0.0.2"
summary     "Streaming UNSAT proof checker for WRAT, WRATB, LRAT and DRAT certificates"
description "Independently re-derives every step of a propositional refutation. Streams Tungsten-native hinted .wrat, packed .wratb, LRAT, and plain DRAT proofs from mmap, checking redundancy by reverse unit propagation with a RAT fallback. Hinted proofs replay the solver's named propagation chain instead of searching for one. Deliberately small and heuristic-free so it can be audited, and deliberately shares no code with the solver that produced the proof."
license     "MIT OR Apache-2.0"
authors     ["Tungsten Language Project"]

executable  "wrat", source: "bin/wrat.w"
