wire_kind_ids = {}

-> wire_schema_kind_id(op)
  if wire_kind_ids.size() == 0
    i = 1
    while i < wire_kind_symbols.size()
      wire_kind_ids[wire_kind_symbols[i]] = i
      i += 1
  id = wire_kind_ids[op]
  if id == nil
    raise "WIRE opcode is missing from wire_schema.w: " + op.to_s()
  id

-> wire_schema_kind_symbol(id)
  if id <= 0 || id >= wire_kind_symbols.size()
    return nil
  wire_kind_symbols[id]
