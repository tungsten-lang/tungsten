-> hv_put(t, off, list)
  i = 0
  while i < list.size
    t[off + i] = list[i]
    i += 1
  nil

HV_TABLES = [nil]

-> hv_tables
  return HV_TABLES[0] if HV_TABLES[0] != nil
  t = i32[HT_SIZE]
  hv_put(t, HT_LPS, HV_LPS)
  s = 0
  while s < 128
    st = s >> 1
    m = s & 1
    t[HT_MPS + s] = (HV_NEXT_MPS[st] << 1) | m
    if st == 0
      t[HT_LPST + s] = (HV_NEXT_LPS[st] << 1) | (1 - m)
    else
      t[HT_LPST + s] = (HV_NEXT_LPS[st] << 1) | m
    s += 1
  hv_put(t, HT_RENORM, HV_RENORM)
  hv_put(t, HT_DCT, HV_DCT)
  # scans: HT_SCAN + (log2blk * 3 + scanIdx) * 128, pairs (x, y)
  l = 0
  while l < 4
    hv_gen_scans(t, l)
    l += 1
  hv_put(t, HT_CTXMAP, HV_CTXIDXMAP)
  hv_put(t, HT_ANGLE, HV_ANGLE)
  hv_put(t, HT_INVANGLE, HV_INVANGLE)
  hv_put(t, HT_LEVELSCALE, HV_LEVELSCALE)
  # chroma QP mapping for ChromaArrayType 1, qPi 0..69 (negative handled by caller)
  q = 0
  while q < 70
    v = q
    if q >= 30 && q <= 42
      v = HV_QPC[q - 30]
    elsif q > 42
      v = q - 6
    t[HT_QPC + q] = v
    q += 1
  hv_put(t, HT_BETA, HV_BETA)
  hv_put(t, HT_TC, HV_TC)
  hv_put(t, HT_CTXINIT, HV_CTX_INIT)
  hv_put(t, HT_MODE422, HV_MODE422)
  hv_put(t, HT_SL_INTRA, HV_SL_INTRA)
  hv_put(t, HT_SL_INTER, HV_SL_INTER)
  hv_put(t, HT_LFILT, HV_LUMA_FILTER)
  hv_put(t, HT_CFILT, HV_CHROMA_FILTER)
  HV_TABLES[0] = t
  t

-> hv_gen_scans(t, l)
  n = 1 << l
  # diagonal (up-right)
  o = HT_SCAN + (l * 3) * 128
  i = 0
  x = 0
  y = 0
  stop = false
  while !stop
    while y >= 0
      if x < n && y < n
        t[o + 2 * i] = x
        t[o + 2 * i + 1] = y
        i += 1
      y -= 1
      x += 1
    y = x
    x = 0
    stop = true if i >= n * n
  # horizontal
  o = HT_SCAN + (l * 3 + 1) * 128
  i = 0
  y = 0
  while y < n
    x = 0
    while x < n
      t[o + 2 * i] = x
      t[o + 2 * i + 1] = y
      i += 1
      x += 1
    y += 1
  # vertical
  o = HT_SCAN + (l * 3 + 2) * 128
  i = 0
  x = 0
  while x < n
    y = 0
    while y < n
      t[o + 2 * i] = x
      t[o + 2 * i + 1] = y
      i += 1
      y += 1
    x += 1
  nil
