# Forward difference

-> forward_diff(arr)
  out = []
  i = 0
  while i < arr.size - 1
    out.push(arr[i + 1] - arr[i])
    i += 1
  out

seq = [90, 47, 58, 29, 22, 32, 55, 5, 55, 73]
(0..9).each -> (order)
  << "[order]: [seq]"
  seq = forward_diff(seq)

