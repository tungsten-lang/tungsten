          emit_slot_load(R_X10, R_X9, venc)
          dr = next_d
          next_d += 1
          emit_unbox_f64(dr, R_X10, l_slow)
          regs.push(dr)
          q += 1
        this_vs_env[fnm] = [:fregs, regs, vkeys, vkeys.size, vsh]
      else
