          if uiv[0] == :reg_x
            @a.mov_imm64(uiv[1], wvalue_bits(c1.to_f) ## i64)
          else
            @a.mov_imm64(R_X9, wvalue_bits(c1.to_f) ## i64)
            @a.str_x(R_X9, R_SP, uiv[1])
