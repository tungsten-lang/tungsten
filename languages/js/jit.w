    # We reconstruct a call to a helper that runs wk_call directly.
    @a.ldp_x(R_X21, R_X22, R_SP, 32)
    @a.ldp_x(R_X19, R_X20, R_SP, 16)
    @a.ldp_post(R_FP, R_LR, R_SP, 48)
