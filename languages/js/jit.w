        @a.ldr_x(r_ep, R_SP, JF_SLOT_ENV)
        h = ref != nil ? wk_hops(ref) : @jf.analysis.env_hops(@jf.scope, b.scope)
        while h > 0
          @a.sub_i(r_ep, r_ep, 4)
          @a.ldr_x(r_ep, r_ep, 8)
          h -= 1
