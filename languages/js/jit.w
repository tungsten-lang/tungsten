    first = true
    i = 0
    while i < e.list.size
      q = e.list[i].str
      if q != nil && q.size > 0
        jit_keep(q)
        if first
          @a.mov_imm64(R_X0, wvalue_bits(q) ## i64)
          first = false
        else
          @a.mov_r(R_X1, R_X0)
          @a.mov_imm64(R_X2, wvalue_bits(q) ## i64)
          call_rt(RT_STR_CAT)
      if i < e.a.size
        push_x(R_X0) if !first
        gen_expr_any(e.a[i])
        @a.mov_r(R_X1, R_X0)
        call_rt(RT_TO_STRING)
        if first
          first = false
        else
