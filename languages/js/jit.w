      rt_c = op == "<" ? RT_LT : (op == "<=" ? RT_LE : (op == ">" ? RT_GT : RT_GE))
      cb_cc = ->()
        @a.bind(l_slow)
        sv_sh_cc = @known_shapes; sv_ep_cc = @epoch_verified_now
        @known_shapes = {}; @epoch_verified_now = false
        call_rt(rt_c)
        l_cc_el = @a.new_label
        @a.cmp_i(R_X0, 2)
        @a.b_cond(CC_NE, l_cc_el)
        gen_expr_any(e.b)
        @a.b(l_done)
        @a.bind(l_cc_el)
        gen_expr_any(e.c)
        @known_shapes = sv_sh_cc; @epoch_verified_now = sv_ep_cc
        @a.b(l_done)
