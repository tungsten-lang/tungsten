          @a.b(l_brk)
        add_cold_stub(cb)
        if old_bound == nil
          @bounded_idx.delete(li)
        else
          @bounded_idx[li] = old_bound
        @free_gprs.push(borrowed_gpr) if borrowed_gpr != nil
