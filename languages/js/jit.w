      l_slow_o0 = @a.new_label
      l_done_o0 = @a.new_label
      @a.sub_r(R_X9, R_X0, R_X20)
      @a.cmp_r(R_X9, R_X21)
      @a.b_cond(CC_HS, l_slow_o0)
      @a.fmov_d_x(R_D0, R_X9)
      emit_f64_to_i32(R_X9, R_D0)
      emit_box_i32(R_X0, R_X9)
