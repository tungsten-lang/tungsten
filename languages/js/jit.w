  # Assign a value-struct expression directly into SRA_VS virtual f64 slots (`var oc = ro.sub(this.c)` -> ZERO allocs!)
  -> gen_sra_vs_assign(li, rhs)
    vs = @info.sra_vs[li]
    ci = vs.ctor_info
    keys = vs.keys
    m = keys.size
    l_slow = @a.new_label
    l_done = @a.new_label
    if !@hoisted_epoch
      ep_now = JS_EPOCH[0]
      @a.ldr_x(R_X9, R_X19, RT_K_EPOCH_PTR * 8)
      @a.ldr_x(R_X10, R_X9, 0)
