        emit_pure_cond_arm(R_X15, is_eq ? ib : ia, R_X12)
        @a.mov_imm64(R_X9, kv_b)
        @a.cmp_r(R_X0, R_X9)
        @a.csel_x(R_X0, R_X14, R_X15, CC_EQ)
