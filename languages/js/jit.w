            call_rt(RT_EQ)
            l_ck_el = @a.new_label
            @a.cmp_i(R_X0, 2)
            @a.b_cond(is_eq ? CC_NE : CC_EQ, l_ck_el)
            gen_expr_any(e.b)
            @a.b(l_done)
            @a.bind(l_ck_el)
            gen_expr_any(e.c)
            @known_shapes = sv_sh_ck; @epoch_verified_now = sv_ep_ck
            @a.b(l_done)
