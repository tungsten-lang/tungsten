    return nil if !n.is_a?(JsNode) || out.size >= 4
    if n.kind == :num && !jit_int32_lit?(n)
      bits = jit_f64_bits(wvalue_bits(n.a) ## i64)
      out.push(bits) if !out.include?(bits)
    collect_fp_consts(n.a, out)
    collect_fp_consts(n.b, out)
    collect_fp_consts(n.c, out)
    collect_fp_consts(n.d, out)
    if n.list.is_a?(Array)
      n.list.each ->(x) collect_fp_consts(x, out)
    nil

  -> collect_ta_bce_cands(n, idx_li, lim_li, out)
    return nil if !n.is_a?(JsNode)
    if n.kind == :member && n.has?(F_COMPUTED)
      tli = local_idx(n.a)
      if tli >= 0 && @hoisted_tas[tli] != nil
        if local_idx(n.b) == idx_li || (lim_li >= 0 && n.b.is_a?(JsNode) && n.b.kind == :binary && n.b.str == "%" && local_idx(n.b.b) == lim_li)
          out.push(tli) if !out.include?(tli)
    collect_ta_bce_cands(n.a, idx_li, lim_li, out)
    collect_ta_bce_cands(n.b, idx_li, lim_li, out)
    collect_ta_bce_cands(n.c, idx_li, lim_li, out)
    collect_ta_bce_cands(n.d, idx_li, lim_li, out)
    if n.list.is_a?(Array)
      n.list.each ->(x) collect_ta_bce_cands(x, idx_li, lim_li, out)
    nil

  -> find_promoted_outer_obj(body, loop_li)
    return nil if @known_shapes.size == 0
    all_wprops = {}
    reads_by_li = {}
    rw_by_li = {}
    bad_li = {}
    other_wlis = {}
    unknown_wprop = {}
    has_bad = [false]
    @known_shapes.keys.each ->(k)
      reads_by_li[k] = {}
      rw_by_li[k] = {}
    promo_scan_node(body, all_wprops, reads_by_li, rw_by_li, bad_li, other_wlis, unknown_wprop, has_bad)
    return nil if has_bad[0]
    avail = (R_D31 - @next_prop_fp) + 1
    return nil if avail < 2
    best = nil
    best_cnt = 1
    @known_shapes.keys.each ->(ali)
      if !bad_li[ali] && ali != loop_li
        ro = []
        rw = []
        reads_by_li[ali].keys.each ->(pk)
          if !all_wprops[pk] && rw_by_li[ali][pk] == nil
            ro.push([pk, reads_by_li[ali][pk]])
        rw_by_li[ali].keys.each ->(pk)
          if !unknown_wprop[pk]
            rw.push([pk, rw_by_li[ali][pk]])
        tot = ro.size + rw.size
        if tot > best_cnt && tot <= avail
          # Check all other written locals for aliasing safety
          ow = {}
          other_wlis.keys.each ->(oli) ow[oli] = true if oli != ali
          best_cnt = tot
          best = [ali, ro, rw, ow]
    best

  -> promo_scan_node(n, all_wprops, reads_by_li, rw_by_li, bad_li, other_wlis, unknown_wprop, has_bad)
    return nil if !n.is_a?(JsNode) || has_bad[0]
    k = n.kind
    if k == :assign
      if n.a.is_a?(JsNode) && n.a.kind == :member
        if n.a.has?(F_COMPUTED)
          has_bad[0] = true
          return nil
        pk = n.a.b.str
        all_wprops[pk] = true
        li = local_idx(n.a.a)
        if li >= 0 && @known_shapes[li] != nil
          op = n.str
          ic = n.a.x
          if (op == "+=" || op == "-=" || op == "*=" || op == "/=") && ic != nil && ic[0] == @known_shapes[li] && ic[2] == 0 && ic[1] != 0 && can_f64?(n.b)
            rw_by_li[li][pk] = ic[1]
          else
            bad_li[li] = true
        elsif li >= 0
          other_wlis[li] = true
        else
          unknown_wprop[pk] = true
        promo_scan_node(n.b, all_wprops, reads_by_li, rw_by_li, bad_li, other_wlis, unknown_wprop, has_bad)
        return nil
      elsif n.a.is_a?(JsNode) && n.a.kind == :ident
        li = local_idx(n.a)
        bad_li[li] = true if li >= 0
    elsif k == :update
      if n.a.is_a?(JsNode) && n.a.kind == :member
        has_bad[0] = true
        return nil
      elsif n.a.is_a?(JsNode) && n.a.kind == :ident
        li = local_idx(n.a)
        bad_li[li] = true if li >= 0
    elsif k == :var_decl && n.list.is_a?(Array)
      n.list.each ->(d)
        if d.is_a?(JsNode)
          li = local_idx(d.a)
          bad_li[li] = true if li >= 0
          promo_scan_node(d.b, all_wprops, reads_by_li, rw_by_li, bad_li, other_wlis, unknown_wprop, has_bad)
      return nil
    elsif k == :member && !n.has?(F_COMPUTED)
      li = local_idx(n.a)
      if li >= 0 && @known_shapes[li] != nil
        ic = n.x
        if ic != nil && ic[0] == @known_shapes[li] && ic[2] == 0 && ic[1] != 0
          reads_by_li[li][n.b.str] = ic[1]
        else
          bad_li[li] = true
      return nil
    promo_scan_node(n.a, all_wprops, reads_by_li, rw_by_li, bad_li, other_wlis, unknown_wprop, has_bad)
    promo_scan_node(n.b, all_wprops, reads_by_li, rw_by_li, bad_li, other_wlis, unknown_wprop, has_bad)
    promo_scan_node(n.c, all_wprops, reads_by_li, rw_by_li, bad_li, other_wlis, unknown_wprop, has_bad)
    promo_scan_node(n.d, all_wprops, reads_by_li, rw_by_li, bad_li, other_wlis, unknown_wprop, has_bad)
    if n.list.is_a?(Array)
      n.list.each ->(x) promo_scan_node(x, all_wprops, reads_by_li, rw_by_li, bad_li, other_wlis, unknown_wprop, has_bad)
    nil

  -> stmt_has_cf_or_loop?(n)
    return false if !n.is_a?(JsNode)
    k = n.kind
    return true if k == :break || k == :continue || k == :return || k == :throw || k == :for || k == :while || k == :do_while || k == :switch || k == :try
    return true if stmt_has_cf_or_loop?(n.a) || stmt_has_cf_or_loop?(n.b) || stmt_has_cf_or_loop?(n.c) || stmt_has_cf_or_loop?(n.d)
    if n.list.is_a?(Array)
      i = 0
      while i < n.list.size
        return true if stmt_has_cf_or_loop?(n.list[i])
        i += 1
    false

  -> stmt_size_count(n)
    return 0 if !n.is_a?(JsNode)
    c = 1 + stmt_size_count(n.a) + stmt_size_count(n.b) + stmt_size_count(n.c) + stmt_size_count(n.d)
    if n.list.is_a?(Array)
      i = 0
      while i < n.list.size
        c += stmt_size_count(n.list[i])
        i += 1
    c

  -> marr_loop_safe?(n, prop_s, push_tgts)
    return true if n == nil
    if n.is_a?(Array)
      i = 0
      while i < n.size
        return false if !marr_loop_safe?(n[i], prop_s, push_tgts)
        i += 1
      return true
    return true if !n.is_a?(JsNode)
    k = n.kind
    return false if k == :new || k == :throw || k == :try || k == :for_in || k == :for_of || k == :function || k == :arrow || k == :class
    return false if k == :unary && n.str == "delete"
    if k == :assign || k == :update
      if n.a != nil && n.a.kind == :member
        return false if n.a.has?(F_COMPUTED) || n.a.b.str == prop_s
    if k == :call
      if n.a != nil && n.a.kind == :member && !n.a.has?(F_COMPUTED)
        mn = n.a.b.str
        if mn == "push" && n.list.size == 1 && !(n.x.is_a?(Array) && n.x.size >= 2)
          pli = local_idx(n.a.a)
          return false if pli < 0 || @info.types[pli] != JT_ANY
          push_tgts.push(pli) if !push_tgts.include?(pli)
          return marr_loop_safe?(n.list[0], prop_s, push_tgts)
        # Allow pure 0-arg read-only polymorphic predicates (`c.isSatisfied()`, `c.isInput()`)!
        if n.list.size == 0 && n.x.is_a?(Array) && n.x.size >= 2 && n.x.size <= 8
          np = n.x.size / 2
          qi = 0
          ok_p = true
          while qi < np && ok_p
            sh_q = n.x[qi * 2]
            fn_q = n.x[qi * 2 + 1]
            if sh_q.is_a?(JS:Shape) && !sh_q.dict && sh_q.slot_of(mn) < 0 && fn_q.is_a?(JS:Function) && fn_q.code != nil && fn_q.code.node.is_a?(JaFunc) && js_shape_proto_method_eq?(sh_q, mn, fn_q)
              pl_q = poly_classify_method(fn_q.code.node, sh_q, 0)
              ok_p = pl_q != nil && (pl_q[0] == :ret_held_or_susp || pl_q[0] == :ret_cmp || (pl_q[0] == :ret_expr && (pl_q[1].kind == :true || pl_q[1].kind == :false || (pl_q[1].kind == :member && !pl_q[1].has?(F_COMPUTED) && pl_q[1].a.kind == :this))))
              if !ok_p && fn_q.code.node.free.size == 0 && fn_q.code.node.node.b.is_a?(Array) && fn_q.code.node.node.b.size == 1 && fn_q.code.node.node.b[0].kind == :return
                re_q = fn_q.code.node.node.b[0].a
                if re_q != nil && re_q.kind == :member && !re_q.has?(F_COMPUTED) && re_q.a != nil && re_q.a.kind == :this && sh_q.slot_of(re_q.b.str) >= 0 && (sh_q.attrs_of(re_q.b.str) & ATTR_ACCESSOR) == 0
                  ok_p = true
            else
              ok_p = false
            qi += 1
          return marr_loop_safe?(n.a.a, prop_s, push_tgts) if ok_p
      return false
    marr_loop_safe?(n.a, prop_s, push_tgts) && marr_loop_safe?(n.b, prop_s, push_tgts) && marr_loop_safe?(n.c, prop_s, push_tgts) && marr_loop_safe?(n.d, prop_s, push_tgts) && marr_loop_safe?(n.list, prop_s, push_tgts)

  # Compare (ri + 1) against LIMIT for 2x unrolled loop guard!
  -> emit_counted_cmp_p1_branch(ri, lim_kind, lim_val, lim_reg, lim_container, cc, target)
    if lim_kind == 1
      lm1 = lim_val - 1
      if lm1 <= 0
        @a.b(target) if cc == CC_GE
        return nil
      if lm1 <= 4095
        @a.cmp_wi(ri, lm1)
      else
        @a.mov_imm32(R_X9, lm1)
        @a.cmp_w(ri, R_X9)
    elsif lim_kind == 2
      @a.sub_wi(R_X9, lim_reg, 1)
      @a.cmp_w(ri, R_X9)
    elsif lim_kind == 3
      ar = @hoisted_arr_regs[lim_container]
      if ar != nil && ar[1] != nil
        @a.sub_wi(R_X9, ar[1], 1)
      else
        @a.ldr_x(R_X9, R_SP, @hoisted_arrs[lim_container][1])
        @a.sub_wi(R_X9, R_X9, 1)
      @a.cmp_w(ri, R_X9)
    elsif lim_kind == 5
      if @hoisted_marr[4]
        @a.sub_wi(R_X9, @hoisted_marr[3], 1)
      else
        @a.ldr_x(R_X9, R_SP, @hoisted_marr[3])
        @a.sub_wi(R_X9, R_X9, 1)
      @a.cmp_w(ri, R_X9)
    else
      tr = @hoisted_ta_regs[lim_container]
      if tr != nil && tr[1] != nil
        @a.sub_wi(R_X9, tr[1], 1)
      else
        @a.ldr_x(R_X9, R_SP, @hoisted_tas[lim_container][1])
        @a.sub_wi(R_X9, R_X9, 1)
      @a.cmp_w(ri, R_X9)
    @a.b_cond(cc, target)
    nil

  -> emit_counted_cmp_branch(ri, lim_kind, lim_val, lim_reg, lim_container, cc, target)
    if lim_kind == 1
      if lim_reg != nil
        @a.cmp_w(ri, lim_reg)
      elsif lim_val <= 4095
        @a.cmp_wi(ri, lim_val)
      else
        @a.mov_imm32(R_X9, lim_val)
        @a.cmp_w(ri, R_X9)
    elsif lim_kind == 2
      @a.cmp_w(ri, lim_reg)
    elsif lim_kind == 3
      ar = @hoisted_arr_regs[lim_container]
      if ar != nil && ar[1] != nil
        @a.cmp_w(ri, ar[1])
      else
        @a.ldr_x(R_X9, R_SP, @hoisted_arrs[lim_container][1])
        @a.cmp_w(ri, R_X9)
    elsif lim_kind == 5
      if @hoisted_marr[4]
        @a.cmp_w(ri, @hoisted_marr[3])
      else
        @a.ldr_x(R_X9, R_SP, @hoisted_marr[3])
        @a.cmp_w(ri, R_X9)
    else
      tr = @hoisted_ta_regs[lim_container]
      if tr != nil && tr[1] != nil
        @a.cmp_w(ri, tr[1])
      else
        @a.ldr_x(R_X9, R_SP, @hoisted_tas[lim_container][1])
        @a.cmp_w(ri, R_X9)
    @a.b_cond(cc, target)
    nil

  # Loop-body Monomorphic Shape Versioning (100% sound dual-path fast/slow specialization!):
  # When a loop body `:block` reads/writes >= 2 warm monomorphic own-property ICs on local(s)
  # (e.g. `a` and `b` in n-body `step`, or `c` in position update), verify each local's shape
  # ONCE right after leading non-property var declarations, then execute the rest of the block
  # with `@known_shapes` populated (eliminating ~20 repeated tag+shape checks per iteration!).
  # If any guard misses, executes the exact same statements with `@known_shapes = {}`.
  -> gen_loop_body_stmt(body)
    if body == nil || body.kind != :block || body.list == nil || body.list.size == 0
      gen_stmt(body)
      return nil
    list = body.list
    # Count warm monomorphic own-property accesses per local in `list`
    counts = {}   # lidx -> [shape_bits, count, ok]
    collect_warm_shape_uses(list, counts)
    # Keep locals with >= 2 warm own-property accesses sharing one exact shape AND no shape-changing writes
    cands = {}
    counts.keys.each ->(li)
      e = counts[li]
      if e[2] && e[1] >= 2 && e[0] != 0
        cands[li] = e[0]
    if cands.size == 0
      gen_stmt(body)
      return nil
    # Split leading simple `var x = expr` initializers (that don't themselves depend on guarded properties)
    # from the body tail so `var b = bodies[j], dx = a.x - b.x` splits cleanly!
    # Handle `var b = bodies[j], dx = a.x - b.x` inside a single var_decl too!
    first_stmt = list[0]
    lead_stmts = 0
    lead_decls = 0
    if first_stmt.kind == :var_decl && first_stmt.list.size >= 1
      # Advance through leading declarators whose RHS has no member reads on `cands`
      q = 0
      while q < first_stmt.list.size
        d = first_stmt.list[q]
        break if expr_uses_cand_prop?(d.b, cands)
        q += 1
      lead_decls = q
      if lead_decls == first_stmt.list.size
        lead_stmts = 1
        lead_decls = 0
    # Emit leading declarations once (unconditionally)
    i = 0
    while i < lead_stmts
      gen_stmt(list[i])
      i += 1
    if lead_decls > 0
      q = 0
      while q < lead_decls
        d = first_stmt.list[q]
        b = d.a.x.binding
        if d.b != nil
          emit_assign_to_binding(b, d.b, first_stmt.str != "var")
        elsif first_stmt.str != "var"
          @a.movz_x(R_X0, 0)
          emit_write_binding(b, R_X0, true)
        q += 1
    # Check each candidate's shape ONCE; on any mismatch jump to l_slow_blk!
    l_slow_blk = @a.new_label
    l_done_blk = @a.new_label
    guard_lis = cands.keys
    # Do not guard a local that is reassigned later in the tail!
    reassigned = {}
    collect_tail_reassigned(list, lead_stmts, lead_decls, reassigned)
    active = []
    guard_lis.each ->(li) active.push(li) if !reassigned[li] && @info.types[li] == JT_ANY
    if active.size == 0
      # Emit remaining decls & stmts normally
      emit_block_tail(list, lead_stmts, lead_decls)
      return nil
    old_shapes = @known_shapes.dup
    use_promo_bail = @promoted_owner >= 0 && @promoted_bail_lbl != nil
    l_guard_fail = use_promo_bail ? @promoted_bail_lbl : l_slow_blk
    active.each ->(li)
      sh = cands[li]
      if old_shapes[li] != sh && !(@info.mono_arr_num_locals[li] && sh == @info.mono_arr_num_sh && @mono_arr_num[sh] == true)
        load_slot_any(R_X13, li)
        @a.sub_i(R_X9, R_X13, 4)
        @a.tst_wobj_bad(R_X9)
        @a.b_cond(CC_NE, l_guard_fail)
        @a.cbz_x(R_X9, l_guard_fail)
        @a.ldr_x(R_X10, R_X9, 8)
        hr = @hoisted_shapes[sh]
        if hr != nil
          @a.cmp_r(R_X10, hr)
        elsif @sh_spill_slots[sh] != nil
          @a.ldr_x(R_X11, R_SP, @sh_spill_slots[sh])
          @a.cmp_r(R_X10, R_X11)
        else
          @a.mov_imm64(R_X11, sh)
          @a.cmp_r(R_X10, R_X11)
        @a.b_cond(CC_NE, l_guard_fail)
      # Aliasing guard when outer object's writable fields are scalar-promoted!
      if use_promo_bail && li != @promoted_owner && @promoted_other_lis != nil && @promoted_other_lis[li]
        r_a = @info.reg_gpr[@promoted_owner]
        r_b = @info.reg_gpr[li]
        if r_a != nil && r_b != nil
          @a.cmp_r(r_b, r_a)
        else
          load_slot_any(R_X13, li)
          load_slot_any(R_X14, @promoted_owner)
          @a.cmp_r(R_X13, R_X14)
        @a.b_cond(CC_EQ, @promoted_bail_lbl)
      @known_shapes[li] = sh
    # Fast specialized tail (ZERO shape checks on active locals, plus read-only property FP CSE!)
    old_pfp = @block_prop_fp
    old_wprops = @block_written_props
    old_pcounts = @block_prop_counts
    old_npfp = @next_prop_fp
    wprops = {}
    pcounts = {}
    collect_tail_written_props(list, lead_stmts, lead_decls, wprops)
    collect_tail_prop_reads(list, lead_stmts, lead_decls, pcounts)
    @block_prop_fp = old_pfp.dup
    @block_written_props = wprops
    @block_prop_counts = pcounts
    # Keep outer loop's cached properties live if not written in this inner block (or if promoted rw!)
    wprops.keys.each ->(wk)
      @block_prop_fp.keys.each ->(pk)
        @block_prop_fp.delete(pk) if pk.ends_with?(":" + wk) && @promoted_rw[pk] == nil
    emit_block_tail(list, lead_stmts, lead_decls)
    @block_prop_fp = old_pfp
    @block_written_props = old_wprops
    @block_prop_counts = old_pcounts
    @next_prop_fp = old_npfp
    @a.bind(l_done_blk)
    @known_shapes = old_shapes
    # Emit slow fallback tail OUT OF LINE in @cold_stubs (0 taken branches + 0 cold bytes in hot loop!)
    if !use_promo_bail
      cb = ->()
        @a.bind(l_slow_blk)
        sv_sh = @known_shapes
        sv_pfp = @block_prop_fp
        sv_wp = @block_written_props
        sv_pc = @block_prop_counts
        sv_np = @next_prop_fp
        @known_shapes = {}
        @block_prop_fp = {}
        @block_written_props = nil
        @block_prop_counts = nil
        @next_prop_fp = R_D18
        emit_block_tail(list, lead_stmts, lead_decls)
        @known_shapes = sv_sh
        @block_prop_fp = sv_pfp
        @block_written_props = sv_wp
        @block_prop_counts = sv_pc
        @next_prop_fp = sv_np
        @a.b(l_done_blk)
      add_cold_stub(cb)
    nil

  -> collect_tail_prop_reads(list, lead_stmts, lead_decls, out)
    if lead_decls > 0
      fs = list[0]
      q = lead_decls
      while q < fs.list.size
        collect_stmt_preads(fs.list[q].b, out)
        q += 1
      i = 1
    else
      i = lead_stmts
    while i < list.size
      collect_stmt_preads(list[i], out)
      i += 1
    nil

  -> collect_stmt_preads(n, out)
    return nil if !n.is_a?(JsNode)
    if n.kind == :member && !n.has?(F_COMPUTED)
      li = local_idx(n.a)
      if li >= 0
        pk = li.to_s + ":" + n.b.str
        out[pk] = (out[pk] == nil ? 0 : out[pk]) + 1
    collect_stmt_preads(n.a, out)
    collect_stmt_preads(n.b, out)
    collect_stmt_preads(n.c, out)
    collect_stmt_preads(n.d, out)
    if n.list.is_a?(Array)
      n.list.each ->(x) collect_stmt_preads(x, out)
    nil

  -> collect_tail_written_props(list, lead_stmts, lead_decls, out)
    i = lead_decls > 0 ? 1 : lead_stmts
    while i < list.size
      collect_stmt_wprops(list[i], out)
      i += 1
    nil

  -> collect_stmt_wprops(n, out)
    return nil if !n.is_a?(JsNode)
    if n.kind == :assign && n.a.is_a?(JsNode) && n.a.kind == :member && !n.a.has?(F_COMPUTED)
      out[n.a.b.str] = true
    elsif n.kind == :update && n.a.is_a?(JsNode) && n.a.kind == :member && !n.a.has?(F_COMPUTED)
      out[n.a.b.str] = true
    collect_stmt_wprops(n.a, out)
    collect_stmt_wprops(n.b, out)
    collect_stmt_wprops(n.c, out)
    collect_stmt_wprops(n.d, out)
    if n.list.is_a?(Array)
      n.list.each ->(x) collect_stmt_wprops(x, out)
    nil

  -> emit_block_tail(list, lead_stmts, lead_decls)
    if lead_decls > 0
      fs = list[0]
      q = lead_decls
      while q < fs.list.size
        d = fs.list[q]
        b = d.a.x.binding
        if d.b != nil
          emit_assign_to_binding(b, d.b, fs.str != "var")
        elsif fs.str != "var"
          @a.movz_x(R_X0, 0)
          emit_write_binding(b, R_X0, true)
        q += 1
      i = 1
    else
      i = lead_stmts
    while i < list.size
      gen_stmt(list[i])
      i += 1
    nil

  -> expr_uses_cand_prop?(e, cands)
    return false if !e.is_a?(JsNode)
    k = e.kind
    if k == :member && !e.has?(F_COMPUTED)
      li = local_idx(e.a)
      return true if li >= 0 && cands[li] != nil
    return true if expr_uses_cand_prop?(e.a, cands) || expr_uses_cand_prop?(e.b, cands) || expr_uses_cand_prop?(e.c, cands)
    if e.list.is_a?(Array)
      i = 0
      while i < e.list.size
        return true if expr_uses_cand_prop?(e.list[i], cands)
        i += 1
    false

  -> collect_tail_reassigned(list, lead_stmts, lead_decls, out)
    # Also mark locals reassigned inside nested blocks/statements (except the leading declarators)
    if lead_decls > 0
      fs = list[0]
      q = lead_decls
      while q < fs.list.size
        li = local_idx(fs.list[q].a)
        out[li] = true if li >= 0
        collect_expr_reassigned(fs.list[q].b, out)
        q += 1
      i = 1
    else
      i = lead_stmts
    while i < list.size
      collect_stmt_reassigned(list[i], out)
      i += 1
    nil

  -> collect_stmt_reassigned(s, out)
    return nil if s == nil
    k = s.kind
    if k == :var_decl
      s.list.each ->(d)
        li = local_idx(d.a)
        out[li] = true if li >= 0
        collect_expr_reassigned(d.b, out)
    elsif k == :expr_stmt || k == :return || k == :throw
      collect_expr_reassigned(s.a, out)
    elsif k == :block
      s.list.each ->(x) collect_stmt_reassigned(x, out)
    elsif k == :if
      collect_expr_reassigned(s.a, out)
      collect_stmt_reassigned(s.b, out)
      collect_stmt_reassigned(s.c, out)
    elsif k == :for
      collect_stmt_reassigned(s.a, out) if s.a != nil && s.a.kind == :var_decl
      collect_expr_reassigned(s.a, out) if s.a != nil && s.a.kind != :var_decl
      collect_expr_reassigned(s.b, out)
      collect_expr_reassigned(s.c, out)
      collect_stmt_reassigned(s.d, out)
    elsif k == :while || k == :do_while
      collect_expr_reassigned(s.a, out)
      collect_stmt_reassigned(s.b, out)
    nil

  -> collect_expr_reassigned(e, out)
    return nil if !e.is_a?(JsNode)
    k = e.kind
    if k == :assign && e.a.kind == :ident
      li = local_idx(e.a)
      out[li] = true if li >= 0
    elsif k == :update && e.a.kind == :ident
      li = local_idx(e.a)
      out[li] = true if li >= 0
    elsif k == :call
      # Any non-Math call inside the tail could mutate arbitrary objects' shapes!
      if !(e.a.kind == :member && !e.a.has?(F_COMPUTED) && e.a.a.kind == :ident && e.a.a.str == "Math")
        # Conservative: invalidate all locals on general calls inside the body
        i = 0
        while i < @jf.nlocals
          out[i] = true
          i += 1
        return nil
    collect_expr_reassigned(e.a, out)
    collect_expr_reassigned(e.b, out)
    collect_expr_reassigned(e.c, out)
    if e.list.is_a?(Array)
      e.list.each ->(x) collect_expr_reassigned(x, out)
    nil

  -> collect_warm_shape_uses(list, counts)
    i = 0
    while i < list.size
      collect_stmt_shapes(list[i], counts)
      i += 1
    nil

  -> collect_stmt_shapes(s, counts)
    return nil if s == nil
    k = s.kind
    if k == :var_decl
      s.list.each ->(d) collect_expr_shapes(d.b, counts)
    elsif k == :expr_stmt || k == :return || k == :throw
      collect_expr_shapes(s.a, counts)
    elsif k == :block
      s.list.each ->(x) collect_stmt_shapes(x, counts)
    elsif k == :if
      collect_expr_shapes(s.a, counts)
      collect_stmt_shapes(s.b, counts)
      collect_stmt_shapes(s.c, counts)
    elsif k == :for
      # Descend into inner loops so outer-loop locals (like `a` in n-body) get guarded ONCE in the outer loop!
      collect_stmt_shapes(s.d, counts)
    nil

  -> collect_expr_shapes(e, counts)
    return nil if !e.is_a?(JsNode)
    k = e.kind
    if k == :member && !e.has?(F_COMPUTED)
      li = local_idx(e.a)
      if li >= 0 && @info.types[li] == JT_ANY && e.x != nil
        ic = e.x
        sh = ic[0]
        sl = ic[1]
        h  = ic[2]
        if sh != 0 && h == 0 && sl != 0
          cur = counts[li]
          if cur == nil
            counts[li] = [sh, 1, true]
          elsif cur[0] == sh
            cur[1] = cur[1] + 1
          else
            cur[2] = false
    if k == :assign && e.a.kind == :member && !e.a.has?(F_COMPUTED)
      li = local_idx(e.a.a)
      if li >= 0 && e.a.x != nil
        ic = e.a.x
        # If property write transitions shape (ic[2] != 0), disqualify!
        if ic[2] != 0
          counts[li] = [0, 0, false]
    collect_expr_shapes(e.a, counts)
    collect_expr_shapes(e.b, counts)
    collect_expr_shapes(e.c, counts)
    if e.list.is_a?(Array)
      e.list.each ->(x) collect_expr_shapes(x, counts)
    nil

  # Fast zero-BCE Uint8Array byte-match loop: `while (l < maxL && ta[a + l] === ta[b + l]) l++;` (hot in LZ77/string search!)
  -> try_gen_u8_match_while(s)
    c = s.a
    return false if c == nil || c.kind != :logical || c.str != "&&"
    return false if c.a == nil || c.a.kind != :binary || c.a.str != "<"
    l_li = local_idx(c.a.a)
    max_li = local_idx(c.a.b)
    return false if l_li < 0 || max_li < 0 || @info.types[l_li] != JT_I32 || @info.types[max_li] != JT_I32
    # Body must be `l++` or `{ l++; }`
    b = s.b
    b = b.list[0] if b.is_a?(JsNode) && b.kind == :block && b.list.size == 1
    return false if b == nil || b.kind != :expr_stmt || b.a == nil || b.a.kind != :update || b.a.str != "++" || local_idx(b.a.a) != l_li
    # RHS of `&&`: `ta[a + l] === ta[b + l]`
    eq = c.b
    return false if eq == nil || eq.kind != :binary || (eq.str != "===" && eq.str != "==")
    return false if eq.a.kind != :member || !eq.a.has?(F_COMPUTED) || eq.b.kind != :member || !eq.b.has?(F_COMPUTED)
    ta_li = local_idx(eq.a.a)
    return false if ta_li < 0 || ta_li != local_idx(eq.b.a) || @hoisted_tas[ta_li] == nil || @hoisted_tas[ta_li][2] != 1
    return false if eq.a.b.kind != :binary || eq.a.b.str != "+" || eq.b.b.kind != :binary || eq.b.b.str != "+"
    a_li = local_idx(eq.a.b.a)
    b_li = local_idx(eq.b.b.a)
    return false if a_li < 0 || b_li < 0 || local_idx(eq.a.b.b) != l_li || local_idx(eq.b.b.b) != l_li
    return false if @info.types[a_li] != JT_I32 || @info.types[b_li] != JT_I32
    h = @hoisted_tas[ta_li]
    tr = @hoisted_ta_regs[ta_li]
    l_slow = @a.new_label
    l_done = @a.new_label
    l_head = @a.new_label
    # Load l -> w11, maxL -> w12, ta_len -> x10
    load_slot_i32(R_X11, l_li)
    load_slot_i32(R_X12, max_li)
    @a.cmp_w(R_X11, R_X12)
    @a.b_cond(CC_GE, l_done)
    if tr != nil && tr[1] != nil
      @a.mov_r(R_X10, tr[1])
    else
      @a.ldr_x(R_X10, R_SP, h[1])
    # Combine `l < 0 || a < 0 || b < 0` into ONE sign-bit check + verify `a + maxL <= ta_len && b + maxL <= ta_len`!
    load_slot_i32(R_X13, a_li)
    load_slot_i32(R_X15, b_li)
    @a.orr_w(R_X9, R_X11, R_X13)
    @a.orr_w(R_X9, R_X9, R_X15)
    @a.tbnz(R_X9, 31, l_slow)
    @a.sxtw(R_X14, R_X12)
    @a.add_r(R_X9, R_X13, R_X14)
    @a.cmp_r(R_X9, R_X10)
    @a.b_cond(CC_GT, l_slow)
    @a.add_r(R_X14, R_X15, R_X14)
    @a.cmp_r(R_X14, R_X10)
    @a.b_cond(CC_GT, l_slow)
    # Compute base pointers: x13 = ta_ptr + a, x15 = ta_ptr + b!
    if tr != nil && tr[0] != nil
      @a.add_r(R_X13, tr[0], R_X13)
      @a.add_r(R_X15, tr[0], R_X15)
    else
      @a.ldr_x(R_X9, R_SP, h[0])
      @a.add_r(R_X13, R_X9, R_X13)
      @a.add_r(R_X15, R_X9, R_X15)
    # Tight 8-byte word-compare loop with fall-through mismatch (ZERO taken branches on 95% of hash hits!) + 4B/1B tail!
    l_head4 = @a.new_label
    l_byte = @a.new_label
    l_xcont = @a.new_label
    @a.bind(l_head)
    @a.add_wi(R_X9, R_X11, 8)
    @a.cmp_w(R_X9, R_X12)
    @a.b_cond(CC_GT, l_head4)
    @a.ldr_x_byte(R_X9, R_X13, R_X11)
    @a.ldr_x_byte(R_X10, R_X15, R_X11)
    @a.eor_r(R_X9, R_X9, R_X10)
    @a.cbz_x(R_X9, l_xcont)
    @a.rbit_x(R_X9, R_X9)
    @a.clz_x(R_X9, R_X9)
    @a.lsr_xi(R_X9, R_X9, 3)
    @a.add_w(R_X11, R_X11, R_X9)
    @a.bind(l_done)
    store_slot_i32(l_li, R_X11)
    l_exit = @a.new_label
    @a.bind(l_exit)
    cb_u8m = ->()
      @a.bind(l_xcont)
      @a.add_wi(R_X11, R_X11, 8)
      @a.b(l_head)
      @a.bind(l_head4)
      @a.add_wi(R_X9, R_X11, 4)
      @a.cmp_w(R_X9, R_X12)
      @a.b_cond(CC_GT, l_byte)
      @a.ldr_w_byte(R_X9, R_X13, R_X11)
      @a.ldr_w_byte(R_X10, R_X15, R_X11)
      @a.eor_w(R_X9, R_X9, R_X10)
      l_wmiss = @a.new_label
      @a.cbnz_w(R_X9, l_wmiss)
      @a.add_wi(R_X11, R_X11, 4)
      @a.b(l_head4)
      @a.bind(l_wmiss)
      @a.rbit_w(R_X9, R_X9)
      @a.clz_w(R_X9, R_X9)
      @a.lsr_wi(R_X9, R_X9, 3)
      @a.add_w(R_X11, R_X11, R_X9)
      @a.b(l_done)
      @a.bind(l_byte)
      @a.cmp_w(R_X11, R_X12)
      @a.b_cond(CC_GE, l_done)
      @a.ldrb_idx(R_X9, R_X13, R_X11)
      @a.ldrb_idx(R_X10, R_X15, R_X11)
      @a.cmp_w(R_X9, R_X10)
      @a.b_cond(CC_NE, l_done)
      @a.add_wi(R_X11, R_X11, 1)
      @a.b(l_byte)
      @a.bind(l_slow)
      l_shead = @a.new_label
      @a.bind(l_shead)
      gen_cond_branch(s.a, l_exit, false)
      gen_stmt(s.b)
      @a.b(l_shead)
    add_cold_stub(cb_u8m)
    true

  -> stmt_has_break_or_label?(n)
    return false if n == nil
    if n.is_a?(Array)
      i = 0
      while i < n.size
        return true if stmt_has_break_or_label?(n[i])
        i += 1
      return false
    return false if !n.is_a?(JsNode)
    k = n.kind
    return true if k == :break || (k == :continue && n.str != nil)
    return false if k == :for || k == :while || k == :do_while || k == :switch || k == :function || k == :arrow
    stmt_has_break_or_label?(n.a) || stmt_has_break_or_label?(n.b) || stmt_has_break_or_label?(n.c) || stmt_has_break_or_label?(n.d) || stmt_has_break_or_label?(n.list)

  # Collect minimum constant length of all hoisted TAs indexed in `n` (or -1 if none / variable-length).
  -> collect_const_ta_min_len(n, min_box)
    return nil if n == nil || min_box[0] == -2
    if n.is_a?(Array)
      n.each ->(x) collect_const_ta_min_len(x, min_box)
      return nil
    return nil if !n.is_a?(JsNode)
    if n.kind == :member && n.has?(F_COMPUTED)
      bli = local_idx(n.a)
      if bli >= 0 && @hoisted_tas[bli] != nil
        cl = @info.local_ta_lens[bli]
        if cl != nil && cl > 0
          min_box[0] = cl if min_box[0] < 0 || cl < min_box[0]
        else
          min_box[0] = -2
    collect_const_ta_min_len(n.a, min_box)
    collect_const_ta_min_len(n.b, min_box)
    collect_const_ta_min_len(n.c, min_box)
    collect_const_ta_min_len(n.d, min_box)
    collect_const_ta_min_len(n.list, min_box) if n.list.is_a?(Array)
    nil

  # Guarded zero-BCE compilation for pure constant-length TA `while` loops (binary heap sift-up / sift-down!):
  #   A) `while (i > 0) { var p = (i - 1) >> 1; ... i = p; }` -> guards `0 <= i < min_len` once!
  #   B) `while (true) { var l = i*2+1, r = l+1, sm = i; if (l < hsz && ...) sm = l; if (r < hsz && ...) sm = r; if (sm === i) break; ... i = sm; }`
  #      -> guards `0 <= i < min_len && 0 <= hsz <= min_len` once!
  -> try_gen_guarded_ta_bce_while(s)
    return false if @is_osr || s.b == nil || s.b.kind != :block || !s.b.list.is_a?(Array) || s.b.list.size < 3
    return false if !expr_pure_cond_no_rt?(s.a) || !stmt_pure_no_rt_calls?(s.b)
    min_box = [-1]
    collect_const_ta_min_len(s.b, min_box)
    mlen = min_box[0]
    return false if mlen <= 0 || mlen > 1073741823
    stmts = s.b.list
    # Pattern A: `while (i > 0)` where stmt 0 is `var p = (i - 1) >> 1` and only write to `i` is `i = p`!
    if s.a.kind == :binary && s.a.str == ">" && s.a.a.kind == :ident && jit_int32_lit?(s.a.b) && s.a.b.a.to_i == 0
      i_li = local_idx(s.a.a)
      if i_li >= 0 && @info.types[i_li] == JT_I32
        st0 = stmts[0]
        if st0.kind == :var_decl && st0.list.size == 1 && st0.list[0].b != nil
          p_li = local_idx(st0.list[0].a)
          pb = st0.list[0].b
          if p_li >= 0 && p_li != i_li && @info.types[p_li] == JT_I32 && pb.kind == :binary && pb.str == ">>" && jit_int32_lit?(pb.b) && pb.b.a.to_i == 1 && pb.a.kind == :binary && pb.a.str == "-" && local_idx(pb.a.a) == i_li && jit_int32_lit?(pb.a.b) && pb.a.b.a.to_i == 1
            # Verify `i` is ONLY written via `i = p` and `p` is never written after st0!
            ok_a = true
            qi = 1
            while qi < stmts.size && ok_a
              st = stmts[qi]
              if stmt_writes_local?(st, p_li)
                ok_a = false
              elsif stmt_writes_local?(st, i_li)
                if !(st.kind == :expr_stmt && st.a != nil && st.a.kind == :assign && st.a.str == "=" && local_idx(st.a.a) == i_li && local_idx(st.a.b) == p_li)
                  ok_a = false
              qi += 1
            if ok_a
              l_slow = @a.new_label
              l_exit = @a.new_label
              load_slot_i32(R_X9, i_li)
              @a.cmp_wi(R_X9, 0)
              @a.b_cond(CC_LE, l_exit)
              if mlen <= 4095
                @a.cmp_wi(R_X9, mlen)
              elsif (mlen & 4095) == 0 && (mlen >> 12) <= 4095
                @a.cmp_i(R_X9, mlen >> 12, 1)
              else
                @a.mov_imm32(R_X10, mlen)
                @a.cmp_w(R_X9, R_X10)
              @a.b_cond(CC_GE, l_slow)
              old_i = @scoped_ta_ub[i_li]
              old_p = @scoped_ta_ub[p_li]
              @scoped_ta_ub[i_li] = [-1, 0, mlen]
              @scoped_ta_ub[p_li] = [-1, 0, mlen]
              l_head = @a.new_label
              @loops.push(JS:JitLoopCtx.new(l_exit, l_head, nil))
              @in_loop_depth += 1
              @a.bind(l_head)
              gen_cond_branch(s.a, l_exit, false)
              gen_stmt(s.b)
              @a.b(l_head)
              @in_loop_depth -= 1
              @loops.pop
              old_i == nil ? @scoped_ta_ub.delete(i_li) : (@scoped_ta_ub[i_li] = old_i)
              old_p == nil ? @scoped_ta_ub.delete(p_li) : (@scoped_ta_ub[p_li] = old_p)
              @a.bind(l_slow)
              l_sh = @a.new_label
              @loops.push(JS:JitLoopCtx.new(l_exit, l_sh, nil))
              @in_loop_depth += 1
              @a.bind(l_sh)
              gen_cond_branch(s.a, l_exit, false)
              gen_stmt(s.b)
              @a.b(l_sh)
              @in_loop_depth -= 1
              @loops.pop
              @a.bind(l_exit)
              return true
    # Pattern B: `while (true)` sift-down (`var l = i*2+1, r = l+1, sm = i; if (l < hsz && ...) sm = l; if (r < hsz && ...) sm = r; ... i = sm;`)!
    if s.a.kind == :true && stmts.size >= 5
      st0 = stmts[0]
      if st0.kind == :var_decl && st0.list.size == 3
        l_li = local_idx(st0.list[0].a)
        r_li = local_idx(st0.list[1].a)
        sm_li = local_idx(st0.list[2].a)
        lb = st0.list[0].b
        rb = st0.list[1].b
        smb = st0.list[2].b
        i_li = local_idx(smb)
        if i_li >= 0 && l_li >= 0 && r_li >= 0 && sm_li >= 0 && @info.types[i_li] == JT_I32 && @info.types[l_li] == JT_I32 && @info.types[r_li] == JT_I32 && @info.types[sm_li] == JT_I32
          l_ok = lb != nil && lb.kind == :binary && lb.str == "+" && jit_int32_lit?(lb.b) && lb.b.a.to_i == 1 && lb.a.kind == :binary && lb.a.str == "*" && local_idx(lb.a.a) == i_li && jit_int32_lit?(lb.a.b) && lb.a.b.a.to_i == 2
          r_ok = rb != nil && rb.kind == :binary && rb.str == "+" && local_idx(rb.a) == l_li && jit_int32_lit?(rb.b) && rb.b.a.to_i == 1
          if l_ok && r_ok
            # Check stmts[1] is `if (l < hsz && ...) sm = l;` and stmts[2] is `if (r < hsz && ...) sm = r;`
            s1 = stmts[1]
            s2 = stmts[2]
            hsz_li = -1
            if s1.kind == :if && s1.c == nil && s1.a.kind == :logical && s1.a.str == "&&" && s1.a.a.kind == :binary && s1.a.a.str == "<" && local_idx(s1.a.a.a) == l_li && s1.a.a.b.kind == :ident
              hsz_li = local_idx(s1.a.a.b)
            s1_ok = hsz_li >= 0 && @info.types[hsz_li] == JT_I32 && s1.b.kind == :expr_stmt && s1.b.a != nil && s1.b.a.kind == :assign && s1.b.a.str == "=" && local_idx(s1.b.a.a) == sm_li && local_idx(s1.b.a.b) == l_li
            s2_ok = s1_ok && s2.kind == :if && s2.c == nil && s2.a.kind == :logical && s2.a.str == "&&" && s2.a.a.kind == :binary && s2.a.a.str == "<" && local_idx(s2.a.a.a) == r_li && local_idx(s2.a.a.b) == hsz_li && s2.b.kind == :expr_stmt && s2.b.a != nil && s2.b.a.kind == :assign && s2.b.a.str == "=" && local_idx(s2.b.a.a) == sm_li && local_idx(s2.b.a.b) == r_li
            if s2_ok && !stmt_writes_local?(s.b, hsz_li)
              ok_b = true
              qi = 3
              while qi < stmts.size && ok_b
                st = stmts[qi]
                if stmt_writes_local?(st, l_li) || stmt_writes_local?(st, r_li) || stmt_writes_local?(st, sm_li)
                  ok_b = false
                elsif stmt_writes_local?(st, i_li)
                  if !(st.kind == :expr_stmt && st.a != nil && st.a.kind == :assign && st.a.str == "=" && local_idx(st.a.a) == i_li && local_idx(st.a.b) == sm_li)
                    ok_b = false
                qi += 1
              if ok_b
                l_slow = @a.new_label
                l_exit = @a.new_label
                # Guard: 0 <= i < mlen && 0 <= hsz <= mlen!
                load_slot_i32(R_X9, i_li)
                @a.cmp_wi(R_X9, 0)
                @a.b_cond(CC_LT, l_slow)
                if mlen <= 4095
                  @a.cmp_wi(R_X9, mlen)
                elsif (mlen & 4095) == 0 && (mlen >> 12) <= 4095
