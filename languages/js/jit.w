      if iv[0] == :const_i32
        @a.mov_imm64(R_X0, wvalue_bits(iv[1].to_f) ## i64)
      elsif iv[0] == :slot
        load_slot_any(R_X0, iv[1])
      elsif iv[0] == :spill_w
        @a.ldr_w(R_X9, R_SP, iv[1])
        emit_box_i32(R_X0, R_X9)
      elsif iv[0] == :spill_x
        @a.ldr_x(R_X0, R_SP, iv[1])
      elsif iv[0] == :reg_x
