      if @info.global_i32s[b] != nil
        @a.mov_imm64(dst, wvalue_bits(@info.global_i32s[b][2]) ## i64)
        return nil
      if @info.global_objs[b] != nil
        @a.mov_imm64(dst, wvalue_bits(@info.global_objs[b][1]) ## i64)
        return nil
