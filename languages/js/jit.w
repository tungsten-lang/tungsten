    rep = gen_vstruct_to_rep(rhs, ci, l_slow)
    q = 0
    while q < m
      emit_vs_field_load(R_D0, rep, keys[q])
      store_slot_f64(vs.field_slots[keys[q]], R_D0)
      q += 1
    @tmp_depth = saved_td
    @a.bind(l_done)
    cb = ->()
      @a.bind(l_slow)
      @tmp_depth = saved_td
      # Dynamic fallback: evaluate rhs normally and unbox each field into vs.field_slots!
      gen_expr_any(rhs)
      obj_off = push_x(R_X0)
      q2 = 0
      while q2 < m
        kn = keys[q2]
        jit_keep(kn)
