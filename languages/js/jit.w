              @a.and_w_lowmask(r, ra, nb)
              return nil
            if @unroll_i_li >= 0 && @unroll_i_off > 0 && local_idx(rhs.a) == @unroll_i_li && @info.reg_gpr[@unroll_i_li] != nil
