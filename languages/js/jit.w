            emit_vs_m_f64_expr(rhs, sh, v_env, f_env, this_f_env, dr)
            f_env[lb] = [:freg, dr]
          else
            emit_vs_m_f64_expr(rhs, sh, v_env, f_env, this_f_env, R_D0)
            f_env[lb] = [:spill, push_d(R_D0)]
      elsif st.kind == :if
        c = st.a
        l_skip = @a.new_label
        ra = try_vs_m_leaf_reg(R_D0, c.a, v_env, f_env, this_f_env)
