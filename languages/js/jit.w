        db = peek_f64_reg(rhs.b)
        if da != nil && db != nil
          emit_f64_op(rhs.str, dr, da, db)
          return nil
        if db != nil
          gen_expr_f64(rhs.a)
          emit_f64_op(rhs.str, dr, R_D0, db)
          return nil
        if da != nil
          gen_expr_f64(rhs.b)
          emit_f64_op(rhs.str, dr, da, R_D0)
          return nil
      gen_expr_f64(rhs)
      store_slot_f64(slot, R_D0)
      return nil
    rhs_ksh_s = rhs_pure_known_shape(rhs)
    gen_expr_any(rhs)
    @known_shapes.delete(slot)
    store_slot_any(slot, R_X0)
    @known_shapes[slot] = rhs_ksh_s if rhs_ksh_s != nil
