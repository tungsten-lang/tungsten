    return -1 if b == nil
    if @inline_env != nil && @inline_env[b] != nil
      iv = @inline_env[b]
      return (-1000 - iv[1]) if iv[0] == :spill_x
      return (-2000 - iv[1]) if iv[0] == :reg_x
      return iv[1] if iv[0] == :slot
