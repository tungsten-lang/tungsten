        @a.sub_i(R_X1, R_X1, 4)
        @a.ldr_x(R_X1, R_X1, 8)
        h -= 1
      if b.slot < 7
        @a.sub_i(R_X1, R_X1, 4)
        @a.ldr_x(dst, R_X1, (b.slot + 1) * 8 + 8)
