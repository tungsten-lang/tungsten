# jsn/jit — Pure-Tungsten Speculative Optimizing ARM64 JIT Compiler for Blade JS.
#
# Compiles both:
#   1. Hot JS functions (standard 8-arg entry + optional unboxed fast recursive entry)
#   2. Hot `for` / `while` loops via On-Stack Replacement (OSR) with runtime type/shape feedback
#
# Optimizations (all general-purpose, guarded, 100% spec-exact with fallback/deopt):
#   - Unboxed int32 (W registers) and IEEE-754 f64 (D registers) arithmetic & loop counters
#   - Fused ARM64 `madd`, `fmadd`, `fmsub`, `fsqrt`, `fabs`, `frintm/p/z`
#   - Intra-procedural Escape Analysis + Scalar Replacement for object literals & closures
#   - Guarded monomorphic & 4-way polymorphic method/function inlining (PIC -> inline)
#   - Loop-invariant TypedArray, Array, GlobalCell, and Shape guard hoisting
#   - Redundant Shape Guard Elimination within basic blocks
#   - Direct dense Array `push`, `[]`, `.length`, and inlined `map`/`filter`/`reduce`/`forEach`
#   - Unboxed fast self-recursion entry with overflow fallback

in JS

# Keep all IC arrays, shapes, strings, cells referenced by JITted code alive (per-realm when a realm is active).
JIT_CODE_KEEP = []
-> jit_keep(v)
  r = JS_REALM[0]
  if r != nil && r.jit_keep != nil
    r.jit_keep.push(v)
  else
    JIT_CODE_KEEP.push(v)
  v
JIT_OSR_CACHE = {}   # loop JsNode 47-bit ptr key -> osr_fp or false
JIT_ENABLED = [Env.get("BLADE_JS_JIT", "1") != "0"]
JIT_DEBUG = [Env.get("BLADE_JS_JIT_DEBUG", "") == "1"]

# Thresholds
JIT_FN_THRESHOLD = 4
JIT_OSR_THRESHOLD = 16

# Fixed stack frame slots (above saved callee-saved regs 0..159)
JF_SLOT_ARG0  = 160   # OSR: locals_ptr | Fn: f_bits
JF_SLOT_THIS  = 168   # this_bits
JF_SLOT_ENV   = 176   # env_bits (fe)
JF_SLOT_EXTRA = 184   # OSR: fobj_bits  | Fn: argc_raw

# OSR return codes
OSR_DONE   = 0
OSR_DEOPT  = 1
OSR_RETURN = 2

+ JitLoopCtx
  rw :l_break, :l_cont, :label
  -> new(@l_break, @l_cont, @label)
    nil

+ JitCompiler
  rw :a, :info, :jf, :is_osr, :tmp_base, :tmp_depth, :max_tmp, :l_deopt, :l_ret
  rw :loops, :inline_env, :known_shapes, :hoisted_tas, :hoisted_arrs, :hoisted_cells
  rw :ta_info_slot, :osr_deopt_lbl, :in_loop_depth
  rw :free_gprs, :hoisted_arr_regs, :hoisted_ta_regs, :hoisted_epoch, :bounded_idx, :hoisted_shapes
  rw :block_prop_fp, :block_written_props, :block_prop_counts, :block_const_fp, :next_prop_fp, :cold_stubs
  rw :fast_entry_off, :repeat_entry_off, :is_slim_epilogue, :bounded_ta_set, :bounded_mod_ta, :sh_spill_slots
  rw :promoted_rw, :promoted_rw_list, :promoted_owner, :promoted_other_lis, :promoted_bail_lbl
  rw :slim_g_hi, :slim_f_hi, :mono_arr_shape, :mono_arr_num, :d_bias_reg, :prom_cached_fns
  rw :hoisted_global_tas, :hoisted_gta_regs, :known_vs_sh
  rw :inline_ret_mode, :const_loop_bounds, :in_cs_promo, :const_i_vals, :scoped_ta_ub, :guarded_ub_locals, :vs_entry_off, :in_vs_entry, :l_vs_entry_lbl
  rw :mono_inline_depth, :inline_this_sh, :inlining_jfs, :this_mono_sh, :hoisted_garrs, :this_prop_shapes, :epoch_verified_now, :l_fast_entry, :for_in_ctx, :hoisted_gobj_shapes, :in_cold_stub

  -> new(@info)
    @a = JS:A64.new(512)
    @jf = @info.jf
    @is_osr = @info.is_osr
    @tmp_depth = 0
    @max_tmp = 0
    @loops = []
    @inline_env = nil      # nil, or Hash: JaBinding -> [:reg_x, r] | [:reg_w, r] | [:reg_d, r] | [:slot, vslot] | [:this_reg, r]
    @inline_ret_mode = nil # nil (function), or :void | :i32 | :u32 | :f64 | :any for inlined local helper!
    @const_loop_bounds = {} # lidx -> [c0, c1] for constant-range counted loops!
    @in_cs_promo = false   # true while R_X1..R_X8 hold loop-promoted locals/TA-ptrs!
    @const_i_vals = {}     # lidx -> constant int32 value during tiny full-unrolled counted loops!
    @scoped_ta_ub = {}     # idx_lidx -> [ta_lidx_or_m1, max_off, ta_len_ub] for branch/while-guarded TA BCE!
    @guarded_ub_locals = {} # lim_lidx -> ta_len_ub (proven 0 <= lim <= ta_len_ub in current while loop!)
    @vs_entry_off = -1     # byte offset of unboxed value-struct entry (`jit_vs_fp`)
    @in_vs_entry = false   # true while compiling `l_vs_entry` body
    @l_vs_entry_lbl = nil  # label of `l_vs_entry` for direct self-recursion!
    @mono_inline_depth = 0 # current nesting depth of multi-stmt monomorphic method inlining
    @in_cold_stub = false  # true while emitting out-of-line cold stubs (disables recursive versioning/inlining!)
    @inline_this_sh = nil  # active JS:Shape of `this` inside an inlined monomorphic method
    @inlining_jfs = []     # active JaFunc stack to prevent recursive inlining
    @this_mono_sh = 0      # entry-verified monomorphic `this` shape_bits (for while-loop shape check hoisting)
    @hoisted_garrs = {}    # JaBinding -> [r_slots, r_len, bounded_idx_li] for loop-hoisted global dense WArrays!
    @this_prop_shapes = {} # prop_name -> JS:Shape (or :conflict) inferred from warm `this.prop.m(...)` sites!
    @epoch_verified_now = false # true after verifying JS_EPOCH[0] until an opaque JS call could mutate a prototype!
    @hoisted_marr = nil    # [obj_lidx, prop_name, slots_r_or_off, len_r_or_off, is_gpr, bounded_idx_li]
    @live_cur_reg = nil    # [cur_name, reg] when `this.<cur_name>` is live in a scratch GPR across fused skip->run!
    @live_cur_prop = nil   # [slot_enc, reg] when `this.<state>` from l_skip_loop is live in R_X10 at entry to TCB.run!
    @while_dirty_off = -1  # stack slot set non-zero by any cold stub call/shape-trans inside specialized while body
    @while_fast_clean = false # true while fast path of specialized while body has ZERO calls/shape-transitions
    @while_this_arr = nil  # [prop_name, sl_off, ln_off, dirty_off, enc_arr] for read-only `this.<arr>` hoisted across while!
    @in_tail_call_e = nil  # active tail-return call JsNode inside an inlined method (enables dead parent GPR reuse!)
    @tail_ret_emitted = false # set true when a tail-return call jumped directly to parent `@l_ret`!
    @cur_arm_owned_gprs = nil # callee-saved GPRs owned by current inlined arm (reclaimable on tail-return calls!)
    @l_fast_entry = nil
    @for_in_ctx = nil      # nil, or [k_binding, sh_off, idx_off, dir_off] for direct-slot `for..in`!
    @known_shapes = {}     # lidx -> [shape_bits, ptr_known]
    @known_null = {}       # shape_key -> true (proven nullish read-only param/local)
    @known_nonnull = {}    # shape_key -> true (proven non-nullish read-only param/local)
    @top_tail_loop_ret = nil # direct backedge label for top-level fused while tail-call!
    @top_tail_loop_call = nil # AST call node eligible for @top_tail_loop_ret!
    @inline_this_is_outer = false # true inside inlined callee whose `this === outer_this` & `dirty == 0`!
    @while_outer_cur = nil # [cur_name, sh_nd_b] when outer_this.<cur_name> is guaranteed sh_nd_b while dirty == 0!
    @while_cnt_props = nil # Hash: prop_name -> [pname, cnt_off, enc_p] for unboxed write-only `this.<p>++`!
    @while_cnt_list = nil  # Array of [pname, cnt_off, enc_p] for flushing on dirty/exit!
    @while_loop_back_lbl = nil # l_loop_back label for active fused while loop!
    @while_skip_loop_lbl = nil # l_skip_loop label for direct zero-dirty jump from hold/suspend!
    @while_skip_run_lbl = nil  # l_skip_run label for direct fast-run return on proven runnable nodes!
    @while_skip_run_s3 = nil   # split entry stub for direct fast-run with state == cmp_bits!
    @while_skip_run_s01 = nil  # split entry stub for direct fast-run with state != cmp_bits!
    @while_sr_hdr = nil        # [enc_cur, enc_s0_s, enc_d0_s] for inline fall-through l_sr_s3/l_sr_s01 binding!
    @while_s3_bound = false    # true once l_sr_s3 was bound inline right before got_ts3!
    @while_s01_bound = false   # true once l_sr_s01 was bound inline right before got_ts01!
    @while_tcb_s3_lbl = nil    # target label inside TCB.run after `state == cmp_bits` true!
    @while_tcb_s01_lbl = nil   # target label inside TCB.run after `state == cmp_bits` false!
    @while_tcb_cmp_bits = 0    # boxed f64 bits of `state == C` in TCB.run!
    @while_tcb_this_reg = nil  # GPR holding TCB.run's `:this`!
    @while_skip_tail = nil # [sh_nd_b, enc_state, enc_nxt, iv1, iv2] when R_X6/R_X7/R_X8 hold live CCMP skip constants!
    @last_stmt_exited = false  # set true when a statically-folded stmt unconditionally exited!
    @hoisted_tas = {}      # lidx -> [off_ptr, off_len, kind]
    @hoisted_arrs = {}     # lidx -> [off_slots, off_len]
    @hoisted_cells = {}    # cell_bits -> expected_val_bits
    @hoisted_gobj_shapes = {} # cell_bits -> [gv, gsh] (both cell==gv AND gv.@shape==gsh verified in prologue!)
    @hoisted_gprops = {}   # "cell_bits:enc" -> [obs_b, reg_or_nil] (guarded before pure loop!)
    @loop_cs_reloads = nil # nil, or [[:imm, reg, val] | [:gprop, reg, gv_ptr, enc, obs_b], ...] reloaded after cold calls!
    @hoisted_arr_regs = {} # lidx -> [slots_reg_or_nil, len_reg_or_nil]
    @hoisted_ta_regs = {}  # lidx -> [ptr_reg_or_nil, len_reg_or_nil]
    @hoisted_global_tas = {} # JaBinding -> [off_ptr, off_len, kind, cell, gv]
    @hoisted_gta_regs = {}   # JaBinding -> [ptr_reg_or_nil, len_reg_or_nil]
    @known_vs_sh = {}        # lidx -> JS:Shape (from param_shapes / sra_vs)
    @info.param_shapes.each ->(pli, sh) @known_vs_sh[pli] = sh
    @info.sra_vs.each ->(vli, vs) @known_vs_sh[vli] = vs.ctor_info[4]
    @hoisted_shapes = {}   # shape_bits -> callee-saved GPR holding shape_bits
    @sh_spill_slots = {}   # shape_bits -> positive SP offset (1 LDR instead of 3 movz/movk!)
    @block_prop_fp = {}    # "bli:sl" -> caller-saved FP reg (d18..d31) for read-only properties in pure blocks!
    @block_written_props = nil
    @block_prop_counts = nil
    @block_const_fp = {}   # f64_bits -> caller-saved FP reg (d18..d31) for hoisted loop FP literals!
    @next_prop_fp = R_D18
    @cold_stubs = []       # Out-of-line slow-path stubs emitted AFTER epilogue (ZERO taken branches in hot loops!)
    @fast_entry_off = -1
    @repeat_entry_off = -1
    @is_slim_epilogue = false
    @bounded_ta_set = {}   # "idx_lidx:ta_lidx" -> true (0 <= idx < ta.len guaranteed)
    @bounded_mod_ta = {}   # "div_lidx:ta_lidx" -> true (0 < div <= ta.len guaranteed)
    @promoted_rw = {}      # "ali:prop" -> dreg
    @promoted_rw_list = nil
    @promoted_owner = -1
    @promoted_other_lis = nil
    @promoted_bail_lbl = nil
    @slim_g_hi = R_X28
    @slim_f_hi = R_D15
    @mono_arr_shape = {}   # arr_li -> shape_bits (all elements 0..len-1 verified to have exact shape!)
    @mono_arr_num = {}     # shape_bits -> true (all inline slots of every instance in fn verified numeric!)
    @d_bias_reg = nil      # R_D15 when pinned to W_DOUBLE_BIAS (2^48) for zero-FMOV SIMD unboxing/boxing!
    @prom_cached_fns = {}  # JaFunc -> shared cached JS:Function across unrolled copies!
    @hoisted_epoch = false
    @bounded_idx = {}      # idx_lidx -> container_lidx (guaranteed 0 <= idx < container.len)
    @in_loop_depth = 0
    @i53_acc_li = -1       # active loop-promoted 64-bit integer accumulator local idx (or -1)
    @i53_acc_reg = nil     # callee-saved GPR holding @i53_acc_li during loop
    @i53_acc_bail = nil    # bail label (e.g. if charCodeAt OOB / non-int array elem)
    @inv_indexof = {}      # "sli:needle" -> GPR holding hoisted indexOf result inside loop
    @inv_str_ascii = {}    # sli -> [r_ptr, r_len_or_nil, bounded_mask_or_m1] for hoisted ASCII charCodeAt!
    @no_ovf_p1_li = -1     # loop induction local proven <= 2147483645 so `i + 1` cannot overflow i32!
    @unroll_i_li = -1      # induction local with deferred increment during 4x unrolling
    @unroll_i_off = 0      # constant offset (0..3) added on reads of @unroll_i_li!
    @unroll_fp_i_reg = nil # R_D7 holding exact double(i + off) during pure-FP defer_i4 loop!
    @i53_defer_const = nil # [accumulated_const_i64] deferred across 4x unrolled i53 loop!
    @i53_defer_regs = nil  # [[r_cap_gpr, count], ...] loop-invariant int32 regs deferred across 4x i53 loop!
    @i53_cur_body = nil    # current loop body AST inside can_2lane_4x!
    @str_cc_ics = {}       # JsNode -> i64[3] IC [str_bits, ascii_ptr, byte_len]
    @str_io_ics = {}       # JsNode -> i64[3] IC [str_bits, needle_bits, res_i64]
    # Compute unused callee-saved GPRs from R_X22..R_X28 for hoisting pointers/limits!
    used_gprs = {}
    @info.reg_gpr.values.each ->(r) used_gprs[r] = true
    @free_gprs = []
    rg = R_X22
    while rg <= R_X28
      @free_gprs.push(rg) if !used_gprs[rg]
      rg += 1
    ccall("w_value_free_w", used_gprs)
    # Layout after local spills
    sp = @info.frame_size - 128
    # Reserve 16 bytes per hoisted TypedArray + 16 bytes per hoisted Array / read-only param Array.
    # Allocate base pointers FIRST (prioritizing data pointers over lengths, skipping len reg when constant!).
    @info.ta_invariants.keys.each ->(li)
      @hoisted_tas[li] = [sp, sp + 8, @info.ta_invariants[li]]
      @hoisted_ta_regs[li] = [@free_gprs.size > 0 ? @free_gprs.pop : nil, nil]
      sp += 16
    @info.arr_invariants.keys.each ->(li)
      @hoisted_arrs[li] = [sp, sp + 8]
      @hoisted_arr_regs[li] = [@free_gprs.size > 0 ? @free_gprs.pop : nil, nil]
      sp += 16
    @info.param_arrs.keys.each ->(li)
      if @hoisted_arrs[li] == nil
        @hoisted_arrs[li] = [sp, sp + 8]
        @hoisted_arr_regs[li] = [@free_gprs.size > 0 ? @free_gprs.pop : nil, nil]
        sp += 16
    @info.global_tas.each ->(gb, ginfo)
      @hoisted_global_tas[gb] = [sp, sp + 8, ginfo[0], ginfo[1], ginfo[2]]
      @hoisted_gta_regs[gb] = [@free_gprs.size > 0 ? @free_gprs.pop : nil, nil]
      sp += 16
    @info.ta_invariants.keys.each ->(li)
      @hoisted_ta_regs[li][1] = @free_gprs.pop if @free_gprs.size > 0 && @info.local_ta_lens[li] == nil
    @info.arr_invariants.keys.each ->(li)
      @hoisted_arr_regs[li][1] = @free_gprs.pop if @free_gprs.size > 0
    @info.param_arrs.keys.each ->(li)
      @hoisted_arr_regs[li][1] = @free_gprs.pop if @free_gprs.size > 0 && @hoisted_arr_regs[li][1] == nil
    @ta_info_slot = sp
    sp += 32
    @tmp_base = sp
    @info.frame_size = ((sp + 512 + 15) / 16) * 16
    @l_deopt = @a.new_label
    @l_ret = @a.new_label

  # ---- Temp stack helpers (fixed SP-relative slots, never mutates SP!) ----

  -> push_x(reg)
    off = @tmp_base + @tmp_depth * 8
    @tmp_depth += 1
    @max_tmp = @tmp_depth if @tmp_depth > @max_tmp
    @a.str_x(reg, R_SP, off)
    off

  -> pop_x(reg)
    @tmp_depth -= 1
    off = @tmp_base + @tmp_depth * 8
    @a.ldr_x(reg, R_SP, off)
    nil

  -> push_w(reg)
    off = @tmp_base + @tmp_depth * 8
    @tmp_depth += 1
    @max_tmp = @tmp_depth if @tmp_depth > @max_tmp
    @a.str_w(reg, R_SP, off)
    off

  -> pop_w(reg)
    @tmp_depth -= 1
    off = @tmp_base + @tmp_depth * 8
    @a.ldr_w(reg, R_SP, off)
    nil

  -> push_d(dreg)
    off = @tmp_base + @tmp_depth * 8
    @tmp_depth += 1
    @max_tmp = @tmp_depth if @tmp_depth > @max_tmp
    @a.str_d(dreg, R_SP, off)
    off

  -> pop_d(dreg)
    @tmp_depth -= 1
    off = @tmp_base + @tmp_depth * 8
    @a.ldr_d(dreg, R_SP, off)
    nil

  # ---- Runtime call helpers ----
  -> emit_flush_while_cnts(cnt_list)
    return nil if cnt_list == nil || cnt_list.size == 0
    @a.ldr_x(R_X9, R_SP, JF_SLOT_THIS)
    @a.sub_i(R_X9, R_X9, 4)
    fi_wc = 0
    while fi_wc < cnt_list.size
      ci_wc = cnt_list[fi_wc]
      @a.ldr_x(R_X10, R_SP, ci_wc[1])
      @a.scvtf_d_x(R_D0, R_X10)
      @a.fmov_x_d(R_X10, R_D0)
      @a.add_r(R_X10, R_X10, R_X20)
      emit_slot_store(R_X9, ci_wc[2], R_X10)
      fi_wc += 1
    nil

  -> mark_while_dirty
    if @while_dirty_off >= 0
      if @while_cnt_list != nil && @while_cnt_list.size > 0
        l_mwd_skip = @a.new_label
        @a.ldr_x(R_X10, R_SP, @while_dirty_off)
        @a.cbnz_x(R_X10, l_mwd_skip)
        emit_flush_while_cnts(@while_cnt_list)
        @a.str_x(R_X19, R_SP, @while_dirty_off)
        @a.bind(l_mwd_skip)
      else
        @a.str_x(R_X19, R_SP, @while_dirty_off)
      @while_fast_clean = false if !@in_cold_stub
    nil

  -> emit_blr_x16
    mark_while_dirty()
    @a.blr(R_X16)
    if @loop_cs_reloads != nil
      ri_cs = 0
      while ri_cs < @loop_cs_reloads.size
        rc_it = @loop_cs_reloads[ri_cs]
        if rc_it[0] == :imm
          @a.mov_imm64(rc_it[1], rc_it[2])
        elsif rc_it[0] == :gprop
          # Reload global object property; if mutated away from obs_b during call, poison reg with 6 (JSR_SLOW)!
          @a.mov_imm64(R_X9, rc_it[2])
          emit_slot_load(R_X9, R_X9, rc_it[3])
          @a.mov_imm64(rc_it[1], rc_it[4])
          @a.movz_x(R_X14, 6)
          @a.cmp_r(R_X9, rc_it[1])
          @a.csel_x(rc_it[1], rc_it[1], R_X14, CC_EQ)
        ri_cs += 1
    nil

  # Calls JIT_RT_TBL[rt_idx] with captures=0 in x0, args already in x1..xN. Result in x0.
  -> call_rt(rt_idx)
    @a.movz_x(R_X0, 0)
    @a.ldr_x(R_X16, R_X19, rt_idx * 8)
    emit_blr_x16()
    nil

  # ---- Prologue & Epilogue ----

  -> emit_prologue
    fs = @info.frame_size
    if fs <= 4095
      @a.sub_i(R_SP, R_SP, fs)
    else
      @a.mov_imm64(R_X16, fs)
      @a.sub_r(R_SP, R_SP, R_X16)
    @a.stp_x(R_FP, R_LR, R_SP, 0)
    @a.mov_sp(R_FP, R_SP)
    @a.stp_x(R_X19, R_X20, R_SP, 16)
    @a.stp_x(R_X21, R_X22, R_SP, 32)
    @a.stp_x(R_X23, R_X24, R_SP, 48)
    @a.stp_x(R_X25, R_X26, R_SP, 64)
    @a.stp_x(R_X27, R_X28, R_SP, 80)
    @a.stp_d(R_D8,  R_D9,  R_SP, 96)
    @a.stp_d(R_D10, R_D11, R_SP, 112)
    @a.stp_d(R_D12, R_D13, R_SP, 128)
    @a.stp_d(R_D14, R_D15, R_SP, 144)
    # Pin x19 = JIT_RT_TBL, x20 = 2^48, x21 = 0xFFF0000000000001
    rt_ptr = jit_rt_init()
    @a.mov_imm64(R_X19, rt_ptr)
    @a.mov_imm64(R_X20, 281474976710656)
    @a.mov_imm64(R_X21, -4503599627370495)   # 0xFFF0000000000001 signed
    nil

  -> emit_slim_prologue
    fs = @info.frame_size
    if fs <= 4095
      @a.sub_i(R_SP, R_SP, fs)
    else
      @a.mov_imm64(R_X16, fs)
      @a.sub_r(R_SP, R_SP, R_X16)
    @a.stp_x(R_FP, R_LR, R_SP, 0)
    @a.mov_sp(R_FP, R_SP)
    if @slim_g_hi >= R_X22
      @a.stp_x(R_X22, R_X23, R_SP, 32)
      @a.stp_x(R_X24, R_X25, R_SP, 48) if @slim_g_hi >= R_X24
      @a.stp_x(R_X26, R_X27, R_SP, 64) if @slim_g_hi >= R_X26
      @a.str_x(R_X28, R_SP, 80) if @slim_g_hi >= R_X28
    if @slim_f_hi >= R_D8
      @a.stp_d(R_D8,  R_D9,  R_SP, 96)
      @a.stp_d(R_D10, R_D11, R_SP, 112) if @slim_f_hi >= R_D10
      @a.stp_d(R_D12, R_D13, R_SP, 128) if @slim_f_hi >= R_D12
      @a.stp_d(R_D14, R_D15, R_SP, 144) if @slim_f_hi >= R_D14
    nil

  -> emit_epilogue
    if @is_slim_epilogue
      if @slim_f_hi >= R_D8
        @a.ldp_d(R_D14, R_D15, R_SP, 144) if @slim_f_hi >= R_D14
        @a.ldp_d(R_D12, R_D13, R_SP, 128) if @slim_f_hi >= R_D12
        @a.ldp_d(R_D10, R_D11, R_SP, 112) if @slim_f_hi >= R_D10
        @a.ldp_d(R_D8,  R_D9,  R_SP, 96)
      if @slim_g_hi >= R_X22
        @a.ldr_x(R_X28, R_SP, 80) if @slim_g_hi >= R_X28
        @a.ldp_x(R_X26, R_X27, R_SP, 64) if @slim_g_hi >= R_X26
        @a.ldp_x(R_X24, R_X25, R_SP, 48) if @slim_g_hi >= R_X24
        @a.ldp_x(R_X22, R_X23, R_SP, 32)
    else
      @a.ldp_d(R_D14, R_D15, R_SP, 144)
      @a.ldp_d(R_D12, R_D13, R_SP, 128)
      @a.ldp_d(R_D10, R_D11, R_SP, 112)
      @a.ldp_d(R_D8,  R_D9,  R_SP, 96)
      @a.ldp_x(R_X27, R_X28, R_SP, 80)
      @a.ldp_x(R_X25, R_X26, R_SP, 64)
      @a.ldp_x(R_X23, R_X24, R_SP, 48)
      @a.ldp_x(R_X21, R_X22, R_SP, 32)
      @a.ldp_x(R_X19, R_X20, R_SP, 16)
    @a.ldp_x(R_FP, R_LR, R_SP, 0)
    fs = @info.frame_size
    if fs <= 4095
      @a.add_i(R_SP, R_SP, fs)
    else
      @a.mov_imm64(R_X16, fs)
      @a.add_r(R_SP, R_SP, R_X16)
    @a.ret
    nil

  # ---- WValue Boxing / Unboxing Primitives ----

  # Unbox WValue double in `xr` -> `dr`. Branches to `l_slow` if not a number.
  -> emit_unbox_f64(dr, xr, l_slow)
    @a.sub_r(R_X15, xr, R_X20)
    @a.cmp_r(R_X15, R_X21)
    @a.b_cond(CC_HS, l_slow)
    @a.fmov_d_x(dr, R_X15)
    nil

  # Unbox WValue -> exact int32 in `wr` (rejecting NaN, non-int, -0.0, out-of-i32).
  -> emit_unbox_exact_i32(wr, xr, l_slow)
    @a.sub_r(R_X15, xr, R_X20)
    @a.cmp_r(R_X15, R_X21)
    @a.b_cond(CC_HS, l_slow)
    # Reject -0.0 (0x8000000000000000)
    @a.mov_imm64(R_X14, -9223372036854775807 - 1)
    @a.cmp_r(R_X15, R_X14)
    @a.b_cond(CC_EQ, l_slow)
    @a.fmov_d_x(R_D16, R_X15)
    @a.fcvtzs_w_d(wr, R_D16)
    @a.scvtf_d_w(R_D17, wr)
    @a.fcmp_d(R_D16, R_D17)
    @a.b_cond(CC_NE, l_slow)
    nil

  # Box int32 in `wr` -> WValue double in `xr` (never NaN, 3 instructions!)
  -> emit_box_i32(xr, wr)
    @a.scvtf_d_w(R_D16, wr)
    @a.fmov_x_d(xr, R_D16)
    @a.add_r(xr, xr, R_X20)
    nil

  # Box unsigned uint32 in `wr` -> WValue double in `xr` (never NaN, 3 instructions!)
  -> emit_box_u32(xr, wr)
    @a.ucvtf_d_w(R_D16, wr)
    @a.fmov_x_d(xr, R_D16)
    @a.add_r(xr, xr, R_X20)
    nil

  # Queue a cold slow-path stub to be emitted after the function epilogue (preserving @tmp_depth, @inline_env, @l_ret, & while dirty/cnt state!).
  -> add_cold_stub(fn_body)
    td = @tmp_depth
    ie = @inline_env
    ish = @inline_this_sh
    lcr = @loop_cs_reloads
    lr = @l_ret
    irm = @inline_ret_mode
    wdo = @while_dirty_off
    wcl = @while_cnt_list
    @cold_stubs.push([td, fn_body, ie, ish, lcr, lr, irm, wdo, wcl])
    nil

  -> emit_cold_stubs
    saved_cs = @in_cold_stub
    @in_cold_stub = true
    i = 0
    while i < @cold_stubs.size
      st = @cold_stubs[i]
      saved_td = @tmp_depth
      saved_ie = @inline_env
      saved_ish = @inline_this_sh
      saved_lcr = @loop_cs_reloads
      saved_lr = @l_ret
      saved_irm = @inline_ret_mode
      saved_wdo = @while_dirty_off
      saved_wcl = @while_cnt_list
      @tmp_depth = st[0]
      @inline_env = st[2]
      @inline_this_sh = st[3]
      @loop_cs_reloads = st[4]
      @l_ret = st[5]
      @inline_ret_mode = st[6]
      @while_dirty_off = st[7]
      @while_cnt_list = st[8]
      st[1].call()
      @tmp_depth = saved_td
      @inline_env = saved_ie
      @inline_this_sh = saved_ish
      @loop_cs_reloads = saved_lcr
      @l_ret = saved_lr
      @inline_ret_mode = saved_irm
      @while_dirty_off = saved_wdo
      @while_cnt_list = saved_wcl
      i += 1
    @in_cold_stub = saved_cs
    nil

  # Box f64 in `dr` -> WValue double in `xr` (4 straight-line insns, 0 taken branches; NaN stub out-of-line!).
  -> emit_box_f64(xr, dr)
    l_nan = @a.new_label
    l_done = @a.new_label
    @a.fmov_x_d(xr, dr)
    @a.add_r(xr, xr, R_X20)
    @a.fcmp_d(dr, dr)
    @a.b_cond(CC_VS, l_nan)
    @a.bind(l_done)
    cb = ->()
      @a.bind(l_nan)
      @a.ldr_x(xr, R_X19, RT_K_NAN_BITS * 8)
      @a.b(l_done)
    add_cold_stub(cb)
    nil

  # Box f64 in `dr` known not-NaN -> WValue double in `xr`.
  -> emit_box_f64_nonan(xr, dr)
    @a.fmov_x_d(xr, dr)
    @a.add_r(xr, xr, R_X20)
    nil

  # Convert double in `dr` -> JS ToInt32 in `wr` via ARMv8.3-A hardware `FJCVTZS Wd, Dn`!
  # Single instruction, 0 branches, 100.000% exact ECMAScript ToInt32 for ALL 2^64 doubles!
  -> emit_f64_to_i32(wr, dr)
    @a.fjcvtzs_w_d(wr, dr)
    nil

  # ---- Local Slot Load / Store ----

  -> load_slot_i32(dst_w, slot)
    r = @info.reg_gpr[slot]
    if r != nil
      if slot == @unroll_i_li && @unroll_i_off > 0
        @a.add_wi(dst_w, r, @unroll_i_off)
      else
        @a.mov_w(dst_w, r)
    else
      @a.ldr_w(dst_w, R_SP, @info.spill_off[slot])
    nil

  -> store_slot_i32(slot, src_w)
    r = @info.reg_gpr[slot]
    if r != nil
      @a.mov_w(r, src_w)
    else
      @a.str_w(src_w, R_SP, @info.spill_off[slot])
    nil

  -> load_slot_f64(dst_d, slot)
    r = @info.reg_fpr[slot]
    if r != nil
      @a.fmov_d(dst_d, r)
    else
      @a.ldr_d(dst_d, R_SP, @info.spill_off[slot])
    nil

  -> store_slot_f64(slot, src_d)
    r = @info.reg_fpr[slot]
    if r != nil
      @a.fmov_d(r, src_d)
    else
      @a.str_d(src_d, R_SP, @info.spill_off[slot])
    nil

  -> load_slot_any(dst_x, slot)
    ty = @info.types[slot]
    if ty == JT_I32
      load_slot_i32(R_X14, slot)
      emit_box_i32(dst_x, R_X14)
      return nil
    if ty == JT_U32
      load_slot_i32(R_X14, slot)
      emit_box_u32(dst_x, R_X14)
      return nil
    if ty == JT_F64
      load_slot_f64(R_D16, slot)
      emit_box_f64(dst_x, R_D16)
      return nil
    r = @info.reg_gpr[slot]
    if r != nil
      @a.mov_r(dst_x, r)
    else
      @a.ldr_x(dst_x, R_SP, @info.spill_off[slot])
    nil

  -> store_slot_any(slot, src_x)
    ty = @info.types[slot]
    if ty == JT_I32
      emit_unbox_exact_i32(R_X14, src_x, @l_deopt)
      store_slot_i32(slot, R_X14)
      return nil
    if ty == JT_U32
      emit_unbox_f64(R_D16, src_x, @l_deopt)
      emit_f64_to_i32(R_X14, R_D16)
      store_slot_i32(slot, R_X14)
      return nil
    if ty == JT_F64
      emit_unbox_f64(R_D16, src_x, @l_deopt)
      store_slot_f64(slot, R_D16)
      return nil
    r = @info.reg_gpr[slot]
    if r != nil
      @a.mov_r(r, src_x)
    else
      @a.str_x(src_x, R_SP, @info.spill_off[slot])
    @known_shapes.delete(slot)
    nil

  # Store all live locals back into `[locals_ptr + i*8]` (for OSR exit / deopt).
  -> emit_osr_writeback(skip_sra = true)
    @a.ldr_x(R_X13, R_SP, JF_SLOT_ARG0)
    i = 0
    while i < @jf.nlocals
      ty = @info.types[i]
      if ty == JT_I32
        load_slot_i32(R_X14, i)
        emit_box_i32(R_X12, R_X14)
        @a.str_x(R_X12, R_X13, i * 8)
      elsif ty == JT_U32
        load_slot_i32(R_X14, i)
        emit_box_u32(R_X12, R_X14)
        @a.str_x(R_X12, R_X13, i * 8)
      elsif ty == JT_F64
        load_slot_f64(R_D16, i)
        emit_box_f64(R_X12, R_D16)
        @a.str_x(R_X12, R_X13, i * 8)
      elsif ty == JT_ANY
        load_slot_any(R_X12, i)
        @a.str_x(R_X12, R_X13, i * 8)
      elsif ty == JT_SRA_RX
        # When last exec missed (caps[31] < 0), materialize JS_NULL into locals[i]!
        caps_p = jit_arr_slots_ptr(wvalue_bits(@info.sra_rxs[i]) ## i64)
        l_skip_rx = @a.new_label
        @a.mov_imm64(R_X9, caps_p)
        @a.ldr_x(R_X10, R_X9, 248)
        @a.cmp_wi(R_X10, 0)
        @a.b_cond(CC_GE, l_skip_rx)
        @a.ldr_x(R_X12, R_X19, RT_K_NULL_BITS * 8)
        @a.str_x(R_X12, R_X13, i * 8)
        @a.bind(l_skip_rx)
      i += 1
    nil

  # ---- Compile Value-Struct Unboxed Function (`jit_vs_fp`: zero-allocation vstruct params & return!) ----
  -> compile_vs_fn
    sig = @info.vs_fn_sig
    pspecs = sig[0]
    ret_ci = sig[1]
    ret_sh = ret_ci[4]
    ret_keys = ret_ci[2]
    ret_m = ret_keys.size
    jit_keep(ret_sh)
    l_fast_entry = @a.new_label
    @l_fast_entry = l_fast_entry
    l_vs_entry = @a.new_label
    # 1. Standard Tungsten entry (offset 0 = jit_fp): pin x19..x21, call l_fast_entry
    @a.stp_pre(R_FP, R_LR, R_SP, -48)
    @a.stp_x(R_X19, R_X20, R_SP, 16)
    @a.str_x(R_X21, R_SP, 32)
    rt_ptr = jit_rt_init()
    @a.mov_imm64(R_X19, rt_ptr)
    @a.mov_imm64(R_X20, 281474976710656)
    @a.mov_imm64(R_X21, -4503599627370495)
    @a.bl(l_fast_entry)
    @a.ldr_x(R_X21, R_SP, 32)
    @a.ldp_x(R_X19, R_X20, R_SP, 16)
    @a.ldp_post(R_FP, R_LR, R_SP, 48)
    @a.ret

    # 2. Boxed JIT-to-JIT wrapper (`jit_fast_fp`): unbox params -> bl l_vs_entry -> box return via RT_LIT!
    @a.bind(l_fast_entry)
    @fast_entry_off = @a.pos * 4
    l_fast_slow = @a.new_label
    @a.sub_i(R_SP, R_SP, 80)
    @a.stp_x(R_FP, R_LR, R_SP, 0)
    @a.mov_sp(R_FP, R_SP)
    @a.str_x(R_X3, R_SP, 16)
    @a.str_x(R_X4, R_SP, 24)
    @a.str_x(R_X5, R_SP, 32)
    @a.str_x(R_X6, R_SP, 40)
    @a.cmp_i(R_X2, pspecs.size)
    @a.b_cond(CC_LT, l_fast_slow)
    fp_i = 0
    int_i = 0
    pi = 0
    while pi < pspecs.size
      ps = pspecs[pi]
      @a.ldr_x(R_X10, R_SP, 16 + pi * 8)
      if ps[0] == :vs
        pci = ps[1]
        psh = pci[4]
        pkeys = pci[2]
        jit_keep(psh)
        @a.sub_i(R_X9, R_X10, 4)
        @a.tst_wobj_bad(R_X9)
        @a.b_cond(CC_NE, l_fast_slow)
        @a.cbz_x(R_X9, l_fast_slow)
        @a.ldr_x(R_X11, R_X9, 8)
        @a.mov_imm64(R_X12, wvalue_bits(psh) ## i64)
        @a.cmp_r(R_X11, R_X12)
        @a.b_cond(CC_NE, l_fast_slow)
        q = 0
        while q < pkeys.size
          sl = psh.slot_of(pkeys[q])
          enc = sl < psh.inline ? (psh.ibase + sl) : (0 - (sl - psh.inline) - 1)
          emit_slot_load(R_X11, R_X9, enc)
          emit_unbox_f64(R_D0 + fp_i, R_X11, l_fast_slow)
          fp_i += 1
          q += 1
      elsif ps[0] == :i32
        emit_unbox_exact_i32(R_X1 + int_i, R_X10, l_fast_slow)
        int_i += 1
      else
        emit_unbox_f64(R_D0 + fp_i, R_X10, l_fast_slow)
        fp_i += 1
      pi += 1
    @a.bl(l_vs_entry)
    @a.cbnz_w(R_X0, l_fast_slow)
    @a.mov_imm64(R_X1, wvalue_bits(ret_sh) ## i64)
    @a.movz_x(R_X2, 0)
    @a.movz_x(R_X3, 0)
    @a.movz_x(R_X4, 0)
    @a.movz_x(R_X5, 0)
    @a.movz_x(R_X6, 0)
    @a.movz_x(R_X7, 0)
    q = 0
    while q < ret_m
      emit_box_f64(R_X2 + q, R_D0 + q)
      q += 1
    call_rt(RT_LIT)
    @a.ldp_x(R_FP, R_LR, R_SP, 0)
    @a.add_i(R_SP, R_SP, 80)
    @a.ret
    @a.bind(l_fast_slow)
    @a.movz_x(R_X0, 6)
    @a.ldp_x(R_FP, R_LR, R_SP, 0)
    @a.add_i(R_SP, R_SP, 80)
    @a.ret

    # 3. Unboxed Value-Struct Entry (`jit_vs_fp`): D0..D(nf-1) + W1.. -> D0..D(ret_m-1), W0=0 (ok) or 1 (bail)!
    @a.bind(l_vs_entry)
    @vs_entry_off = @a.pos * 4
    l_sp_ok = @a.new_label
    @a.ldr_x(R_X9, R_X19, RT_K_SP_LIMIT * 8)
    @a.mov_sp(R_X10, R_SP)
    @a.cmp_r(R_X10, R_X9)
    @a.b_cond(CC_HS, l_sp_ok)
    @a.movz_x(R_X0, 1)
    @a.ret
    @a.bind(l_sp_ok)
    @is_slim_epilogue = true
    @slim_g_hi = R_X28
    @slim_f_hi = R_D15
    emit_slim_prologue()
    l_vs_bail = @a.new_label
    l_vs_ret = @a.new_label
    @l_deopt = l_vs_bail
    @l_ret = l_vs_ret
    @in_vs_entry = true
    @l_vs_entry_lbl = l_vs_entry
    # Store incoming unboxed params into their slots FIRST!
    param_set = {}
    fp_i = 0
    int_i = 0
    pi = 0
    while pi < pspecs.size
      ps = pspecs[pi]
      pli = binding_slot(@jf.params[pi])
      param_set[pli] = true if pli >= 0
      if ps[0] == :vs
        vs_p = @info.sra_vs[pli]
        pkeys = ps[1][2]
        q = 0
        while q < pkeys.size
          store_slot_f64(vs_p.field_slots[pkeys[q]], R_D0 + fp_i)
          fp_i += 1
          q += 1
      elsif ps[0] == :i32
        store_slot_i32(pli, R_X1 + int_i)
        int_i += 1
      else
        store_slot_f64(pli, R_D0 + fp_i)
        fp_i += 1
      pi += 1
    # Guard read-only globals & JS_EPOCH ONCE at entry!
    @info.global_i32s.each ->(gb, gi)
      gcell = gi[1]
      gwv = gi[2]
      jit_keep(gcell)
      @a.mov_imm64(R_X9, (wvalue_bits(gcell) ## i64) - 4)
      @a.ldr_x(R_X10, R_X9, 8)
      @a.mov_imm64(R_X11, wvalue_bits(gwv) ## i64)
      @a.cmp_r(R_X10, R_X11)
      @a.b_cond(CC_NE, l_vs_bail)
    @info.global_objs.each ->(gb, go)
      gcell = go[0]
      gwv = go[1]
      jit_keep(gcell)
      jit_keep(gwv)
      @a.mov_imm64(R_X9, (wvalue_bits(gcell) ## i64) - 4)
      @a.ldr_x(R_X10, R_X9, 8)
      @a.mov_imm64(R_X11, wvalue_bits(gwv) ## i64)
      @a.cmp_r(R_X10, R_X11)
      @a.b_cond(CC_NE, l_vs_bail)
    ep_now = JS_EPOCH[0]
    @a.ldr_x(R_X9, R_X19, RT_K_EPOCH_PTR * 8)
    @a.ldr_x(R_X10, R_X9, 0)
    @a.mov_imm64(R_X11, ep_now)
    @a.cmp_r(R_X10, R_X11)
    @a.b_cond(CC_NE, l_vs_bail)
    @hoisted_epoch = true if vs_stmts_pure_epoch?(@jf.node.b)
    # Zero-init non-parameter base slots
    i = 0
    while i < @info.nbase_slots
      if !param_set[i]
        ty = @info.types[i]
        if ty == JT_ANY || ty == JT_I32 || ty == JT_U32
          r = @info.reg_gpr[i]
          if r != nil
            @a.movz_x(r, 0)
          elsif ty == JT_ANY
            @a.str_x(R_XZR, R_SP, @info.spill_off[i])
          else
            @a.str_w(R_XZR, R_SP, @info.spill_off[i])
        elsif ty == JT_F64
          r = @info.reg_fpr[i]
          if r != nil
            @a.fmov_d_x(r, R_XZR)
          else
            @a.str_x(R_XZR, R_SP, @info.spill_off[i])
      i += 1
    gen_stmts(@jf.node.b)
    @a.b(l_vs_bail)
    @a.bind(l_vs_ret)
    emit_epilogue()
    @a.ret
    @a.bind(l_vs_bail)
    @a.movz_x(R_X0, 1)
    emit_epilogue()
    @a.ret
    emit_cold_stubs()
    @a.finalize

  # ---- Compile Full Function ----
  -> compile_fn
    # Special fast path: self-recursive numeric function (e.g. fib(n))
    if @info.fast_rec
      return compile_fast_rec_fn()
    if @info.vs_fn_sig != nil
      return compile_vs_fn()
    # Dual entry:
    #   offset 0 (code.jit_fp): standard entry called from Tungsten (sets x19..x21, calls l_fast_entry)
    #   @fast_entry_off (code.jit_fast_fp): JIT-to-JIT entry assuming x19..x21 are ALREADY pinned!
    l_fast_entry = @a.new_label
    @l_fast_entry = l_fast_entry
    @a.stp_pre(R_FP, R_LR, R_SP, -48)
    @a.stp_x(R_X19, R_X20, R_SP, 16)
    @a.str_x(R_X21, R_SP, 32)
    rt_ptr = jit_rt_init()
    @a.mov_imm64(R_X19, rt_ptr)
    @a.mov_imm64(R_X20, 281474976710656)
    @a.mov_imm64(R_X21, -4503599627370495)   # 0xFFF0000000000001 signed
    if @jf.params.size == 5
      l_m0 = @a.new_label
      @a.cmp_i(R_X2, 5)
      @a.b_cond(CC_LT, l_m0)
      @a.cbz_x(R_X7, l_m0)
      @a.and_x_ptr47(R_X9, R_X7)
      @a.ldr_x(R_X10, R_X9, 16)
      @a.ldrsw(R_X11, R_X9, 4)
      @a.add_i(R_X11, R_X11, 4)
      @a.ldr_x_idx(R_X7, R_X10, R_X11)
      @a.bind(l_m0)
    @a.bl(l_fast_entry)
    @a.ldr_x(R_X21, R_SP, 32)
    @a.ldp_x(R_X19, R_X20, R_SP, 16)
    @a.ldp_post(R_FP, R_LR, R_SP, 48)
    @a.ret

    @a.bind(l_fast_entry)
    @fast_entry_off = @a.pos * 4
    # 3-instruction native stack-overflow guard (prevents SIGBUS on deep/infinite JIT recursion!)
    l_sp_ok = @a.new_label
    @a.ldr_x(R_X9, R_X19, RT_K_SP_LIMIT * 8)
    @a.mov_sp(R_X10, R_SP)
    @a.cmp_r(R_X10, R_X9)
    @a.b_cond(CC_HS, l_sp_ok)
    @a.movz_x(R_X0, 6)    # JSR_SLOW -> bounces to Tier 0 which throws RangeError
    @a.ret
    @a.bind(l_sp_ok)
    # Candidate for counted-loop call-hoisting (`jit_repeat_fp`, x7 = repeat count >= 1):
