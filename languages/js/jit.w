    @a.fmov_d_x(R_D0, R_X9)
    @a.fcvtzs_w_d(R_X11, R_D0)
    @a.scvtf_d_w(R_D1, R_X11)
    @a.fcmp_d(R_D0, R_D1)
    @a.b_cond(CC_NE, l_f64)
