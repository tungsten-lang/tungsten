      op = e.str
      return (op == "+" || op == "-" || op == "*" || op == "/") && poly_inline_expr_ok?(e.a, sh) && poly_inline_expr_ok?(e.b, sh)
    if k == :unary
      return e.str == "-" && poly_inline_expr_ok?(e.a, sh)
    false

