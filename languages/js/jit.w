    emit_vs_scalar_f64(mi[2], sh, rec_rep, p_env, nil)
    @tmp_depth = saved_td
    @a.bind(l_done)
    cb = ->()
      @a.bind(l_slow)
      @tmp_depth = saved_td
      emit_vstruct_call_fallback(e)
      l_tn = @a.new_label
      emit_unbox_f64(R_D0, R_X0, l_tn)
      @a.b(l_done)
