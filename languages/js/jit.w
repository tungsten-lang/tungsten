      @a.ldr_x(R_X1, R_SP, JF_SLOT_ENV)
      h = ref != nil ? wk_hops(ref) : @jf.analysis.env_hops(@jf.scope, b.scope)
      while h > 0
        @a.sub_i(R_X1, R_X1, 4)
        @a.ldr_x(R_X1, R_X1, 8)
        h -= 1
      @a.mov_imm64(R_X2, wvalue_bits(b.slot) ## i64)
      call_rt(RT_ENV_SET)
      return nil
    store_slot_any(b.lidx, val_reg)
    nil

  # ---- Condition Branching (zero materialization of true/false!) ----

  -> gen_cond_branch(e, target, branch_if_true)
    k = e.kind
    if k == :true
      @a.b(target) if branch_if_true
      return nil
    if k == :false || k == :null
      @a.b(target) if !branch_if_true
      return nil
    if k == :unary && e.str == "!"
      gen_cond_branch(e.a, target, !branch_if_true)
      return nil
    if k == :logical && e.str == "&&"
      # Propagate `l < hsz` / `r < hsz` into RHS when `hsz` is guarded `<= mlen` (eliminates heapF[l]/heapF[r] BCs!)
      sc_pushes = nil
      if @guarded_ub_locals.size > 0 && e.a != nil && e.a.kind == :binary && e.a.str == "<" && e.a.a.kind == :ident && e.a.b.kind == :ident
        xli = local_idx(e.a.a)
        lli = local_idx(e.a.b)
        gu = lli >= 0 ? @guarded_ub_locals[lli] : nil
        if gu != nil && xli >= 0 && (xli == gu[1] || xli == gu[2])
