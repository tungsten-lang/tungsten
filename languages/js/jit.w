          mi = lk[2]
          vsh = vci[4]
          vkeys = vci[2]
          rec_rep = v_env[rhs.a.a.x.binding]
          sub_tjf = mi[1]
          sub_penv = {}
          ai = 0
          while ai < sub_tjf.params.size
