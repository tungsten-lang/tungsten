        @a.mov_r(R_X1, R_X0)
        gen_expr_any(ca.b)
        @a.mov_r(R_X2, R_X0)
      else
        gen_expr_any(ca.a)
        a_off_c = push_x(R_X0)
        gen_expr_any(ca.b)
        @a.mov_r(R_X2, R_X0)
        @a.ldr_x(R_X1, R_SP, a_off_c)
        @tmp_depth -= 1
      l_slow = @a.new_label
      l_done = @a.new_label
      @a.sub_r(R_X9, R_X1, R_X20)
      @a.sub_r(R_X10, R_X2, R_X20)
      @a.movz_x(R_X14, 0x7FF0, 3)
      @a.cmp_r(R_X9, R_X14)
      @a.b_cond(CC_HS, l_slow)
      @a.cmp_r(R_X10, R_X14)
      @a.b_cond(CC_HS, l_slow)
      emit_pure_cond_arm(R_X14, ia, R_X12)
      emit_pure_cond_arm(R_X15, ib, R_X12)
