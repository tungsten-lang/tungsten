  -> gen_expr_any(e)
    if e == nil
      @a.movz_x(R_X0, 0)
      return nil
    k = e.kind
    if k == :num
      @a.mov_imm64(R_X0, wvalue_bits(e.a) ## i64)
      return nil
    if k == :true
      @a.movz_x(R_X0, 2)
      return nil
    if k == :false
      @a.movz_x(R_X0, 1)
      return nil
    if k == :null
      @a.ldr_x(R_X0, R_X19, RT_K_NULL_BITS * 8)
      return nil
    if k == :string
      jit_keep(e.str)
      @a.mov_imm64(R_X0, wvalue_bits(e.str) ## i64)
      return nil
    if k == :bigint
      bv = e.x
      if bv == nil
        bv = js_bigint_literal(e.str)
        e.x = bv
      jit_keep(bv)
      @a.mov_imm64(R_X0, wvalue_bits(bv) ## i64)
      return nil
