      @a.ldr_x(dst, R_SP, JF_SLOT_THIS)
      return nil
    load_slot_any(dst, b.lidx)
    nil

  # ---- Binary Operators (fast i32 -> fast f64 -> inline WValue number -> slow call) ----

  -> gen_binary_any(e)
    op = e.str
