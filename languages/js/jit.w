      l_fb_call = @a.new_label
      l_fb_chk = @a.new_label
      @a.mov_imm64(R_X14, fb_pic_p)
      @a.ldr_x(R_X9, R_X19, RT_K_EPOCH_PTR * 8)
      @a.ldr_x(R_X10, R_X9, 0)
      @a.ldr_x(R_X11, R_X14, 96)
      @a.cmp_r(R_X10, R_X11)
