      call_rt(RT_CALL_0 + n)
      @a.b(l_done)
    add_cold_stub(cb)
    @tmp_depth -= (1 + n)
    nil

  -> gen_template_any(e)
    # Fast fused 1-expr template (`pre${expr}suf` -> single RT_TPL1 call!)
    if e.a.size == 1 && e.list.size == 2
      pre_s = e.list[0].str
      suf_s = e.list[1].str
