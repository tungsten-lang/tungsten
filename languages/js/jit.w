          call_rt(RT_SM_FAST2)
          @a.bind(l_f2_done)
          cb_f2 = ->()
            @a.bind(l_f2_slow)
            @a.mov_imm64(R_X1, wvalue_bits(cell) ## i64)
            call_rt(RT_GGET)
            @a.mov_r(R_X1, R_X0)
            @a.movz_x(R_X2, 0)
            @a.ldr_x(R_X3, R_SP, a0_f2_off)
            call_rt(RT_CALL_1)
            @a.b(l_f2_done)
          add_cold_stub(cb_f2)
          @tmp_depth -= 1
          @known_shapes = {}
          @epoch_verified_now = false
          return nil
        # Ensure callee is compiled too (wait for warm_args if it takes params and hasn't run yet!)
        if fv.code.jit_fp == 0 && fv.code.jit_state == 0 && target_jf != @jf && jit_eligible_fn?(target_jf) && (target_jf.params.size == 0 || fv.code.warm_args != nil)
          jit_compile_and_install(fv.code, fv.code.warm_args)
        if fv.code.jit_fp != 0 && fv.code.region_info == nil
          gen_direct_jit_call(c, fv, e.list)
          return nil

    # 4. General call `f(args)`
    gen_expr_any(c)
    push_x(R_X0)        # callee f
    @a.movz_x(R_X0, 0)
    push_x(R_X0)        # this = undefined (order: push this first? Let's match gen_call_with_saved_f_this!)
    # Swap so top is f, below is this:
    pop_x(R_X9)         # 0
    pop_x(R_X10)        # f
    push_x(R_X9)        # this = nil
    push_x(R_X10)       # f
    gen_call_with_saved_f_this(e.list)
    nil

  -> gen_sra_closure_call_any(sc, arg_nodes)
    inner = sc.inner_jf
    re = jit_inline_return_expr(inner)
    old_env = @inline_env
    env = {}
    fvals = inner.free.values
    i = 0
    while i < fvals.size
      fb = fvals[i]
      pi = fb.scope.func.params.index(fb)
      env[fb] = [:slot, sc.cap_slots[pi]] if pi != nil && pi < sc.cap_slots.size
      i += 1
    pushed = 0
    i = 0
    while i < inner.params.size
      pb = inner.params[i]
      ae = i < arg_nodes.size ? arg_nodes[i] : nil
      if ae != nil && can_i32?(ae)
        gen_expr_i32(ae)
        off = push_w(R_X0)
        pushed += 1
        env[pb] = [:spill_w, off]
      else
        gen_expr_any(ae)
        off = push_x(R_X0)
        pushed += 1
        env[pb] = [:spill_x, off]
      i += 1
    @inline_env = env
    gen_expr_any(re)
    @inline_env = old_env
    @tmp_depth -= pushed
    nil

  -> simple_call_leaf?(e)
    return false if !e.is_a?(JsNode)
    k = e.kind
    return true if k == :num || k == :true || k == :false || k == :null || k == :string || k == :bigint
    if k == :ident
      li = local_idx(e)
      return li >= 0 && (@info.types[li] == JT_ANY || @info.types[li] == JT_I32 || @info.types[li] == JT_F64)
    false

  -> emit_load_leaf_any(dst, e)
    k = e.kind
    if k == :num
      @a.mov_imm64(dst, wvalue_bits(e.a) ## i64)
    elsif k == :true
      @a.movz_x(dst, 2)
    elsif k == :false
      @a.movz_x(dst, 1)
    elsif k == :null
      @a.ldr_x(dst, R_X19, RT_K_NULL_BITS * 8)
    elsif k == :string
      jit_keep(e.str)
      @a.mov_imm64(dst, wvalue_bits(e.str) ## i64)
    elsif k == :bigint
      bv = e.x
      if bv == nil
        bv = js_bigint_literal(e.str)
        e.x = bv
      jit_keep(bv)
      @a.mov_imm64(dst, wvalue_bits(bv) ## i64)
    else
      load_slot_any(dst, local_idx(e))
    nil

  # Direct call to a known compiled JS:Function `fv` (e.g. `step(bodies, 0.001)` or `fib(30)`!)
  -> gen_direct_jit_call(c_node, fv, arg_nodes)
    @epoch_verified_now = false
    cell = wk_cell(c_node.x.binding)
    jit_keep(cell)
    jit_keep(fv)
    n = arg_nodes.size
    target_fp = fv.code.jit_fast_fp != 0 ? fv.code.jit_fast_fp : fv.code.jit_fp
    # Zero-spill fast path when all args are pure side-effect-free leaves (e.g. `step(bodies, 0.001)`!)
    all_leaf = n <= 4
    li = 0
    while li < n && all_leaf
      all_leaf = false if !simple_call_leaf?(arg_nodes[li])
      li += 1
    if all_leaf
      l_slow = @a.new_label
      l_done = @a.new_label
      @a.mov_imm64(R_X9, (wvalue_bits(cell) ## i64) - 4)
      @a.ldr_x(R_X0, R_X9, 8)
      @a.mov_imm64(R_X10, wvalue_bits(fv) ## i64)
      @a.cmp_r(R_X0, R_X10)
      @a.b_cond(CC_NE, l_slow)
      @a.movz_x(R_X1, 0)
      @a.movz_x(R_X2, n)
      ai = 0
      while ai < n
        emit_load_leaf_any(R_X3 + ai, arg_nodes[ai])
        ai += 1
      @a.call_abs(R_X16, target_fp)
      @a.cmp_i(R_X0, 6)
      @a.b_cond(CC_EQ, l_slow)
      @a.bind(l_done)
      cb = ->()
        @a.bind(l_slow)
        @a.mov_imm64(R_X1, wvalue_bits(cell) ## i64)
        call_rt(RT_GGET)
        @a.mov_r(R_X1, R_X0)
        @a.movz_x(R_X2, 0)
        ai = 0
        while ai < n
          emit_load_leaf_any(R_X3 + ai, arg_nodes[ai])
          ai += 1
        call_rt(RT_CALL_0 + n)
        @a.b(l_done)
      add_cold_stub(cb)
      @known_shapes = {}
      @epoch_verified_now = false
      return nil
    # Evaluate non-leaf prefix onto tmp stack (skip spilling trailing simple_call_leaf? args like `patches`!)
    n_eval = n
    while n_eval > 0 && simple_call_leaf?(arg_nodes[n_eval - 1])
      n_eval -= 1
    i = 0
    while i < n_eval
      gen_expr_any(arg_nodes[i])
      push_x(R_X0)
      i += 1
    # Check global cell still holds `fv`
    l_slow = @a.new_label
    l_done = @a.new_label
    @a.mov_imm64(R_X9, (wvalue_bits(cell) ## i64) - 4)
    @a.ldr_x(R_X0, R_X9, 8)
    @a.mov_imm64(R_X10, wvalue_bits(fv) ## i64)
    @a.cmp_r(R_X0, R_X10)
    @a.b_cond(CC_NE, l_slow)
    # Fast direct ARM64 call into target_fp(f, this=0, argc=n, a0..a3)!
    @a.movz_x(R_X1, 0)
    @a.movz_x(R_X2, n)
    base_off = @tmp_base + (@tmp_depth - n_eval) * 8
    ai2 = 0
    while ai2 < n
      if ai2 < n_eval
        @a.ldr_x(R_X3 + ai2, R_SP, base_off + ai2 * 8)
      else
        emit_load_leaf_any(R_X3 + ai2, arg_nodes[ai2])
      ai2 += 1
    @a.call_abs(R_X16, target_fp)
    # Check if fast_rec returned JSR_SLOW (6)
    @a.cmp_i(R_X0, 6)
    @a.b_cond(CC_EQ, l_slow)
    @a.bind(l_done)
    cb = ->()
      @a.bind(l_slow)
      @a.mov_imm64(R_X1, wvalue_bits(cell) ## i64)
      call_rt(RT_GGET)
      @a.mov_r(R_X1, R_X0)
      @a.movz_x(R_X2, 0)
      ai3 = 0
      while ai3 < n
        if ai3 < n_eval
          @a.ldr_x(R_X3 + ai3, R_SP, base_off + ai3 * 8)
        else
          emit_load_leaf_any(R_X3 + ai3, arg_nodes[ai3])
        ai3 += 1
      call_rt(RT_CALL_0 + n)
      @a.b(l_done)
    add_cold_stub(cb)
    @tmp_depth -= n_eval
    @known_shapes = {}
    @epoch_verified_now = false
    nil

  # Verify that `sh.proto` chain STILL resolves `mname` to `fn` at compile time (guards against stale AST profiles after prototype mutation!).
  -> js_shape_proto_method_eq?(sh, mname, fn)
    return false if !sh.is_a?(JS:Shape) || sh.dict || sh.slot_of(mname) >= 0
    p = sh.proto
    hops = 0
    while p.is_a?(JS:Base) && hops < 16
      ps = p.shape
      sl = ps.slot_of(mname)
      if sl >= 0
        return false if ps.dict || (ps.attrs_of(mname) & ATTR_ACCESSOR) != 0
        return p.slot_get(sl) == fn
      p = ps.proto
      hops += 1
    false

  # Zero-boxing, zero-spill polymorphic method inliner returning unboxed f64 in R_D0!
  # Used directly by `gen_expr_to_i32` / `gen_expr_f64` (e.g. `(t + shapes[j].area()) | 0`!).
  -> gen_poly_method_inline_f64(call_e, mem_e, prof)
    npairs = prof.size / 2
    return false if npairs == 0 || npairs > 4 || call_e.list.size != 0
    mname_s = mem_e.b.str
    targets = []
    i = 0
    while i < npairs
      sh = prof[i * 2]
      fn = prof[i * 2 + 1]
      return false if !sh.is_a?(JS:Shape) || !fn.is_a?(JS:Function) || fn.code == nil || !fn.code.node.is_a?(JaFunc) || !js_shape_proto_method_eq?(sh, mname_s, fn)
      tjf = fn.code.node
      re = jit_inline_return_expr(tjf)
      return false if re == nil || tjf.free.size > 0 || tjf.params.size != 0
      return false if !poly_inline_expr_ok?(re, sh)
      targets.push([sh, fn, tjf, re])
      i += 1
    # Evaluate receiver into x13 (ZERO stack spill!)
    gen_expr_any(mem_e.a)
    @a.mov_r(R_X13, R_X0)
    l_slow = @a.new_label
    l_done = @a.new_label
    # Guard prototype epoch unchanged (SKIP if already hoisted once at OSR loop entry!)
    if !@hoisted_epoch
      ep_now = JS_EPOCH[0]
      @a.ldr_x(R_X9, R_X19, RT_K_EPOCH_PTR * 8)
      @a.ldr_x(R_X10, R_X9, 0)
      @a.mov_imm64(R_X11, ep_now)
      @a.cmp_r(R_X10, R_X11)
      @a.b_cond(CC_NE, l_slow)
    # Check receiver is a WObject instance and load its @shape into x12 (ptr stays in x9!)
    @a.sub_i(R_X9, R_X13, 4)
    @a.tst_wobj_bad(R_X9)
    @a.b_cond(CC_NE, l_slow)
    @a.cbz_x(R_X9, l_slow)
    @a.ldr_x(R_X12, R_X9, 8)
    # Dispatch across 1..4 observed shapes with register-resident CSE of `this.prop`!
    i = 0
    while i < targets.size
      t = targets[i]
      sh = t[0]
      re = t[3]
      jit_keep(sh)
      l_next = i + 1 < targets.size ? @a.new_label : l_slow
      sb = wvalue_bits(sh) ## i64
      hr = @hoisted_shapes[sb]
      if hr != nil
        @a.cmp_r(R_X12, hr)
      else
        @a.mov_imm64(R_X11, sb)
        @a.cmp_r(R_X12, R_X11)
      @a.b_cond(CC_NE, l_next)
      # Collect distinct `this.prop` keys used in `re` and preload into d2..d5 ONCE (CSE!)
      pkeys = []
      poly_collect_this_props(re, pkeys)
      pmap = {}
      q = 0
      while q < pkeys.size && q < 4
        pk = pkeys[q]
        sl = sh.slot_of(pk)
        enc = sl < sh.inline ? (sh.ibase + sl) : (0 - (sl - sh.inline) - 1)
        emit_slot_load(R_X10, R_X9, enc)
        emit_unbox_f64(R_D2 + q, R_X10, l_slow)
        pmap[pk] = R_D2 + q
        q += 1
      emit_poly_f64_reg(re, pmap, R_D0)
      @a.b(l_done) if i + 1 < targets.size
      @a.bind(l_next) if i + 1 < targets.size
      i += 1
    @a.bind(l_done)
    mname_s = mem_e.b.str
    jit_keep(mname_s)
    snap_harrs = @hoisted_arrs.keys.dup
    cb = ->()
      @a.bind(l_slow)
      rec_off = push_x(R_X13)
      @a.mov_r(R_X1, R_X13)
      @a.mov_imm64(R_X2, wvalue_bits(mname_s) ## i64)
      call_rt(RT_GETV)
      @a.mov_r(R_X1, R_X0)
      @a.ldr_x(R_X2, R_SP, rec_off)
      call_rt(RT_CALL_0)
      @tmp_depth -= 1
      # Soundness: slow-path JS call could have mutated/reallocated a hoisted array; refresh (slots, len)!
      snap_harrs.each ->(hli)
        hh = @hoisted_arrs[hli]
        har = @hoisted_arr_regs[hli]
        if hh != nil
          load_slot_any(R_X9, hli)
          @a.and_x_ptr47(R_X9, R_X9)
          @a.ldr_x(R_X10, R_X9, 16)
          @a.str_x(R_X10, R_SP, hh[0]) if hh[0] > 0
          @a.mov_r(har[0], R_X10) if har != nil && har[0] != nil
          @a.ldrsw(R_X10, R_X9, 8)
          @a.str_x(R_X10, R_SP, hh[1]) if hh[1] > 0
          @a.mov_r(har[1], R_X10) if har != nil && har[1] != nil
      l_tn = @a.new_label
      emit_unbox_f64(R_D0, R_X0, l_tn)
      @a.b(l_done)
      @a.bind(l_tn)
      @a.mov_r(R_X1, R_X0)
      call_rt(RT_TO_NUMBER)
      @a.sub_r(R_X15, R_X0, R_X20)
      @a.fmov_d_x(R_D0, R_X15)
      @a.b(l_done)
    add_cold_stub(cb)
    true

  -> poly_collect_this_props(e, out)
    return nil if e == nil
    if e.kind == :member && !e.has?(F_COMPUTED) && e.a.kind == :this
      out.push(e.b.str) if !out.include?(e.b.str)
      return nil
    if e.kind == :binary
      poly_collect_this_props(e.a, out)
      poly_collect_this_props(e.b, out)
    elsif e.kind == :unary
      poly_collect_this_props(e.a, out)
    nil

  -> poly_leaf_reg(e, pmap)
    return pmap[e.b.str] if e != nil && e.kind == :member && !e.has?(F_COMPUTED) && e.a.kind == :this && pmap[e.b.str] != nil
    nil

  -> emit_poly_f64_reg(e, pmap, dst)
    k = e.kind
    if k == :num
      @a.mov_imm64(R_X10, jit_f64_bits(wvalue_bits(e.a) ## i64))
      @a.fmov_d_x(dst, R_X10)
      return nil
    if k == :true
      @a.mov_imm64(R_X10, jit_f64_bits(wvalue_bits(~1.0) ## i64))
      @a.fmov_d_x(dst, R_X10)
      return nil
    if k == :false || k == :null
      @a.fmov_d_x(dst, R_XZR)
      return nil
    lr = poly_leaf_reg(e, pmap)
    if lr != nil
      @a.fmov_d(dst, lr) if dst != lr
      return nil
    if k == :unary && e.str == "-"
      emit_poly_f64_reg(e.a, pmap, dst)
      @a.fneg_d(dst, dst)
      return nil
    if k == :binary
      op = e.str
      ra = poly_leaf_reg(e.a, pmap)
      rb = poly_leaf_reg(e.b, pmap)
      if ra != nil && rb != nil
        emit_f64_op(op, dst, ra, rb)
        return nil
      if rb != nil
        if op == "*" && e.a.kind == :num && e.a.a == ~2.0
          @a.fadd_d(dst, rb, rb)
          return nil
        if op == "*" && e.a.kind == :num && e.a.a == ~3.0
          @a.fadd_d(R_D1, rb, rb)
          @a.fadd_d(dst, R_D1, rb)
          return nil
        emit_poly_f64_reg(e.a, pmap, dst)
        emit_f64_op(op, dst, dst, rb)
        return nil
      if ra != nil
        if op == "*" && e.b.kind == :num && e.b.a == ~2.0
          @a.fadd_d(dst, ra, ra)
          return nil
        if op == "*" && e.b.kind == :num && e.b.a == ~3.0
          @a.fadd_d(R_D1, ra, ra)
          @a.fadd_d(dst, R_D1, ra)
          return nil
        emit_poly_f64_reg(e.b, pmap, dst)
        emit_f64_op(op, dst, ra, dst)
        return nil
      if e.b.kind == :num
        emit_poly_f64_reg(e.a, pmap, dst)
        if op == "*" && e.b.a == ~2.0
          @a.fadd_d(dst, dst, dst)
          return nil
        if op == "*" && e.b.a == ~3.0
          @a.fadd_d(R_D1, dst, dst)
          @a.fadd_d(dst, R_D1, dst)
          return nil
        cb = jit_f64_bits(wvalue_bits(e.b.a) ## i64)
        cr = @block_const_fp[cb]
        if cr != nil
          emit_f64_op(op, dst, dst, cr)
          return nil
        @a.mov_imm64(R_X10, cb)
        @a.fmov_d_x(R_D1, R_X10)
        emit_f64_op(op, dst, dst, R_D1)
        return nil
      if e.a.kind == :num
        emit_poly_f64_reg(e.b, pmap, dst)
        if op == "*" && e.a.a == ~2.0
          @a.fadd_d(dst, dst, dst)
          return nil
        if op == "*" && e.a.a == ~3.0
          @a.fadd_d(R_D1, dst, dst)
          @a.fadd_d(dst, R_D1, dst)
          return nil
        cb = jit_f64_bits(wvalue_bits(e.a.a) ## i64)
        cr = @block_const_fp[cb]
        if cr != nil
          emit_f64_op(op, dst, cr, dst)
          return nil
        @a.mov_imm64(R_X10, cb)
        @a.fmov_d_x(R_D1, R_X10)
        emit_f64_op(op, dst, R_D1, dst)
        return nil
      emit_poly_f64_reg(e.a, pmap, R_D0)
      push_d(R_D0)
      emit_poly_f64_reg(e.b, pmap, R_D0)
      pop_d(R_D1)
      emit_f64_op(op, dst, R_D1, R_D0)
    nil

  -> emit_f64_op(op, dst, da, db)
    if op == "+"
      @a.fadd_d(dst, da, db)
    elsif op == "-"
      @a.fsub_d(dst, da, db)
    elsif op == "*"
      @a.fmul_d(dst, da, db)
    else
      @a.fdiv_d(dst, da, db)
    nil

  # Pre-scan warmed polymorphic callees for read-only global int32 & object constants so the caller hoists them ONCE in prologue!
  -> scan_ast_global_i32s(n)
    return nil if n == nil || (@info.global_i32s.size >= 32 && @info.global_objs.size >= 16)
    if n.is_a?(Array)
      i = 0
      while i < n.size && (@info.global_i32s.size < 32 || @info.global_objs.size < 16)
        scan_ast_global_i32s(n[i])
        i += 1
      return nil
    return nil if !n.is_a?(JsNode)
    k = n.kind
    return nil if k == :function || k == :arrow || k == :class
    if k == :ident && n.x != nil && n.x.binding != nil
      gb = n.x.binding
      if gb.global? && gb.writes <= 1 && @info.global_i32s[gb] == nil && @info.global_tas[gb] == nil && @info.global_objs[gb] == nil && n.str != "undefined" && n.str != "NaN" && n.str != "Infinity"
        gc = wk_cell(gb)
        gv = gc.value
        if js_number?(gv) && @info.global_i32s.size < 32
          bi = jsr_i32(wvalue_bits(gv) ## i64)
          if bi != (1099511627776 ## i64) && bi.to_f == gv && !(gv == ~0.0 && (~1.0 / gv) < ~0.0)
            @info.global_i32s[gb] = [bi, gc, gv]
        elsif gv.is_a?(JS:Base) && !gv.shape.dict && !gv.exotic? && @info.global_objs.size < 16
          @info.global_objs[gb] = [gc, gv]
      return nil
    scan_ast_global_i32s(n.a)
    scan_ast_global_i32s(n.b)
    scan_ast_global_i32s(n.c)
    scan_ast_global_i32s(n.d)
    scan_ast_global_i32s(n.list)
    nil

  -> collect_callee_global_i32s(n, visited, depth, max_depth)
    return nil if n == nil || depth >= max_depth || (@info.global_i32s.size >= 32 && @info.global_objs.size >= 16)
    if n.is_a?(Array)
      i = 0
      while i < n.size && (@info.global_i32s.size < 32 || @info.global_objs.size < 16)
        collect_callee_global_i32s(n[i], visited, depth, max_depth)
        i += 1
      return nil
    return nil if !n.is_a?(JsNode)
    k = n.kind
    return nil if k == :function || k == :arrow || k == :class
    if k == :call && n.a != nil && n.a.kind == :member && !n.a.has?(F_COMPUTED) && n.x.is_a?(Array) && n.x.size >= 2 && n.x.size <= 8
      pi = 0
      np = n.x.size / 2
      while pi < np && (@info.global_i32s.size < 32 || @info.global_objs.size < 16)
        fn = n.x[pi * 2 + 1]
        if fn.is_a?(JS:Function) && fn.code != nil && fn.code.node.is_a?(JaFunc)
          tjf = fn.code.node
          if tjf != @jf && visited[tjf] == nil && tjf.node.b.is_a?(Array)
            visited[tjf] = true
            scan_ast_global_i32s(tjf.node.b)
            collect_callee_global_i32s(tjf.node.b, visited, depth + 1, max_depth) if depth + 1 < max_depth
        pi += 1
    collect_callee_global_i32s(n.a, visited, depth, max_depth)
    collect_callee_global_i32s(n.b, visited, depth, max_depth)
    collect_callee_global_i32s(n.c, visited, depth, max_depth)
