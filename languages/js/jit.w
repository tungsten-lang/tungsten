    ib = pure_cond_arm_info(e.c)
    return false if ib == nil
    # Case 1: `x == null` / `x != null` / `x === null` / `x !== null` (e.g. `this.queue == null ? 0 : 1`)
    if (op == "==" || op == "!=" || op == "===" || op == "!==") && ca.b != nil && ca.b.kind == :null
