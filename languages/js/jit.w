      r_ptr = val_reg == R_X9 ? R_X11 : R_X9
      r_chk = val_reg == R_X10 ? R_X12 : R_X10
      @a.mov_imm64(r_ptr, cb - 4)
      @a.ldr_x(r_chk, r_ptr, 8)
      @a.cmp_i(r_chk, 3)
      l_slow = @a.new_label
      l_done = @a.new_label
      @a.b_cond(CC_EQ, l_slow)
      @a.str_x(val_reg, r_ptr, 8)
      @a.bind(l_done)
      vr_gs = val_reg
      cb_gs = ->()
        @a.bind(l_slow)
        @a.mov_r(R_X2, vr_gs)
        @a.mov_imm64(R_X1, cb)
        @a.movz_x(R_X3, @jf.strict ? 2 : 1)
        call_rt(RT_GSET)
        @a.b(l_done)
