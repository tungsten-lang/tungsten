      jit_keep(mname_s)
      snap_harrs_p = @hoisted_arrs.keys.dup
      cb = ->()
        @a.bind(l_slow)
        rec_off_s = rec_off >= 0 ? rec_off : push_x(R_X13)
        l_fb_miss = @a.new_label
        l_fb_call = @a.new_label
