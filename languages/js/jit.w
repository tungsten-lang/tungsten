    # record its exact proven shape immediately (ZERO shape checks inside nested loops!)
    if rhs.is_a?(JsNode) && rhs.kind == :member && rhs.has?(F_COMPUTED) && @mono_arr_shape.size > 0
      ali = local_idx(rhs.a)
      idx_li = local_idx(rhs.b)
      if ali >= 0 && @mono_arr_shape[ali] != nil && idx_li >= 0 && @bounded_idx[idx_li] == ali
        @known_shapes[slot] = @mono_arr_shape[ali]
    nil

  -> emit_write_binding(b, val_reg, init, ref = nil)
    if @inline_env != nil && @inline_env[b] != nil
      iv = @inline_env[b]
      if iv[0] == :spill_x
        @known_shapes.delete(-1000 - iv[1])
        @a.str_x(val_reg, R_SP, iv[1])
      elsif iv[0] == :reg_x
        @known_shapes.delete(-2000 - iv[1])
        @a.mov_r(iv[1], val_reg) if iv[1] != val_reg
      elsif iv[0] == :slot
        @known_shapes.delete(iv[1])
        store_slot_any(iv[1], val_reg)
      return nil
    bsl = binding_slot(b)
    if bsl >= 0
      @known_shapes.delete(bsl)
      store_slot_any(bsl, val_reg)
      return nil
    if b.global?
      c = wk_cell(b)
      jit_keep(c)
      cb = wvalue_bits(c) ## i64
      if b.kind == :lexical
        @a.mov_r(R_X2, val_reg)
        @a.mov_imm64(R_X1, cb)
        if init
          @a.movz_x(R_X3, b.decl_const ? 2 : 1)
          call_rt(RT_LINIT)
        else
          call_rt(RT_LSET)
