      return nil
    if k == :binary
      gen_binary_any(e)
      return nil
    if k == :unary
      gen_unary_any(e)
      return nil
    if k == :update
      gen_update_any(e)
      return nil
    if k == :assign
      gen_assign_any(e)
      return nil
    if k == :logical
      gen_logical_any(e)
      return nil
    if k == :cond
