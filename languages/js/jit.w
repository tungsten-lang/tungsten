    this_f_env = {}
    this_num.keys.each ->(fnm)
      sl = sh.slot_of(fnm)
      enc = sl < sh.inline ? (sh.ibase + sl) : (0 - (sl - sh.inline) - 1)
      emit_slot_load(R_X10, R_X13, enc)
