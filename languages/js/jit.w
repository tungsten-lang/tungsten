      gen_expr_any(e.a)
      push_x(R_X0)
      gen_expr_any(e.b)
      @a.mov_r(R_X2, R_X0)
      pop_x(R_X1)
      l_slow = @a.new_label
      l_done = @a.new_label
      @a.sub_r(R_X9, R_X1, R_X20)
      @a.cmp_r(R_X9, R_X21)
      @a.b_cond(CC_HS, l_slow)
      @a.sub_r(R_X10, R_X2, R_X20)
      @a.cmp_r(R_X10, R_X21)
      @a.b_cond(CC_HS, l_slow)
      @a.fmov_d_x(R_D0, R_X9)
      @a.fmov_d_x(R_D1, R_X10)
      emit_f64_to_i32(R_X9, R_D0)
      emit_f64_to_i32(R_X10, R_D1)
