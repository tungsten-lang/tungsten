# ---- VLQ decoder (5 bits/byte; continuation A..Za..f, terminal 0..9g..z-_) ----

-> rx_vlq_next(s, st)
  v = 0
  i = st[0]
  while true
    b = s.byte_at(i)
    i += 1
    if b >= 65 && b <= 90
      v = (v << 5) | (b - 65)
    elsif b >= 97 && b <= 102
      v = (v << 5) | (b - 71)
    else
      d = (b >= 48 && b <= 57) ? (b - 48) : (b >= 103 ? (b - 93) : (b == 45 ? 30 : 31))
      st[0] = i
      return (v << 5) | d

-> rx_rtab_get(idx)
  r = JS_RX_RTAB_CACHE[idx]
  return r if r != nil
  s = JS_RX_RTAB_ENC[idx]
  n = s.size
  out = []
  st = [0]
  prev = 0
  while st[0] < n
    gap = rx_vlq_next(s, st)
    span = rx_vlq_next(s, st)
    lo = prev + gap
    hi = lo + span
    out.push(lo)
    out.push(hi)
    prev = hi
  JS_RX_RTAB_CACHE[idx] = out
  out

-> rx_str_prop_decode(name)
  c = JS_RX_STR_PROP_CACHE[name]
  return c if c != nil
  if name == "RGI_Emoji"
    all_r = rx_rtab_get(JS_RX_STR_PROP_R["Basic_Emoji"])
    all_s = []
    ["Basic_Emoji", "Emoji_Keycap_Sequence", "RGI_Emoji_Modifier_Sequence", "RGI_Emoji_Flag_Sequence", "RGI_Emoji_Tag_Sequence", "RGI_Emoji_ZWJ_Sequence"].each ->(nm)
      sub = rx_str_prop_decode(nm)
      sub[1].each ->(seq) all_s.push(seq)
    res = [all_r, all_s]
    JS_RX_STR_PROP_CACHE[name] = res
    return res
  ri = JS_RX_STR_PROP_R[name]
  rs = ri >= 0 ? rx_rtab_get(ri) : []
  s = JS_RX_STR_PROP_S[name]
  n = s.size
  st = [0]
  strs = []
  while st[0] < n
    len = rx_vlq_next(s, st)
    seq = []
    k = 0
    while k < len
      seq.push(rx_vlq_next(s, st))
      k += 1
    strs.push(seq)
  res = [rs, strs]
  JS_RX_STR_PROP_CACHE[name] = res
  res

-> js_rx_is_str_prop?(name)
  name == "RGI_Emoji" || JS_RX_STR_PROP_S.has_key?(name)

# Lookup a \p{spec} property.
# Returns [:ranges, flat_ranges] or [:strings, flat_ranges, strings_arr] or nil if invalid.
-> js_rx_lookup_prop(spec, vmode)
  eq = spec.index("=")
  if eq != nil
    k = spec.slice(0, eq)
    v = spec.slice(eq + 1, spec.size - eq - 1)
    if k == "General_Category" || k == "gc"
      idx = JS_RX_GC_PROPS[v]
      return idx == nil ? nil : [:ranges, rx_rtab_get(idx)]
    if k == "Script" || k == "sc"
      idx = JS_RX_SC_PROPS[v]
      return idx == nil ? nil : [:ranges, rx_rtab_get(idx)]
    if k == "Script_Extensions" || k == "scx"
      idx = JS_RX_SCX_PROPS[v]
      return idx == nil ? nil : [:ranges, rx_rtab_get(idx)]
    return nil
  idx = JS_RX_BIN_PROPS[spec]
  return [:ranges, rx_rtab_get(idx)] if idx != nil
  idx = JS_RX_GC_PROPS[spec]
  return [:ranges, rx_rtab_get(idx)] if idx != nil
  if js_rx_is_str_prop?(spec)
    return nil if !vmode
    sp = rx_str_prop_decode(spec)
    return [:strings, sp[0], sp[1]]
  nil

# ---- Flat sorted range algebra ([lo0, hi0, lo1, hi1, ...]) ----

-> rx_r_has?(a, c)
  n = a.size
  return false if n == 0
  lo = 0
  hi = (n >> 1) - 1
  while lo <= hi
    mid = (lo + hi) >> 1
    idx = mid << 1
    if c < a[idx]
      hi = mid - 1
    elsif c > a[idx + 1]
      lo = mid + 1
    else
      return true
  false

-> js_rx_is_id_start?(c)
  rx_r_has?(rx_rtab_get(JS_RX_ID_START_IDX), c)

-> js_rx_is_id_continue?(c)
  rx_r_has?(rx_rtab_get(JS_RX_ID_CONT_IDX), c)

# Sort and merge raw pairs (Array of [lo, hi] or flat pairs [lo0, hi0, ...]).
-> rx_r_normalize_flat(flat)
  n = flat.size
  return [] if n == 0
  return flat if n == 2
  # Check if already strictly sorted and non-adjacent
  sorted = true
  i = 2
  while i < n
    if flat[i] <= flat[i - 1] + 1
      sorted = false
      break
    i += 2
  return flat if sorted
  # Sort pairs via insertion/quicksort on pairs array
  pairs = []
  i = 0
  while i < n
    pairs.push([flat[i], flat[i + 1]])
    i += 2
  rx_pairs_qsort(pairs, 0, pairs.size - 1)
  out = [pairs[0][0], pairs[0][1]]
  i = 1
  while i < pairs.size
    lo = pairs[i][0]
    hi = pairs[i][1]
    prev_hi = out[out.size - 1]
    if lo <= prev_hi + 1
      out[out.size - 1] = hi if hi > prev_hi
    else
      out.push(lo)
      out.push(hi)
    i += 1
  out

-> rx_pairs_qsort(a, lo, hi)
  while lo < hi
    if hi - lo < 16
      i = lo + 1
      while i <= hi
        key = a[i]
        kv = key[0]
        j = i - 1
        while j >= lo && a[j][0] > kv
          a[j + 1] = a[j]
          j -= 1
        a[j + 1] = key
        i += 1
      return nil
    mid = (lo + hi) >> 1
    piv = a[mid][0]
    i = lo
    j = hi
    while i <= j
      while a[i][0] < piv
        i += 1
      while a[j][0] > piv
        j -= 1
      if i <= j
        t = a[i]
        a[i] = a[j]
        a[j] = t
        i += 1
        j -= 1
    if j - lo < hi - i
      rx_pairs_qsort(a, lo, j) if lo < j
      lo = i
    else
      rx_pairs_qsort(a, i, hi) if i < hi
      hi = j
  nil

-> rx_r_union(a, b)
  return b if a.size == 0
  return a if b.size == 0
  out = []
  i = 0
  j = 0
  na = a.size
  nb = b.size
  while i < na || j < nb
    if j >= nb || (i < na && a[i] <= b[j])
      lo = a[i]
      hi = a[i + 1]
      i += 2
    else
      lo = b[j]
      hi = b[j + 1]
      j += 2
    if out.size > 0 && lo <= out[out.size - 1] + 1
      out[out.size - 1] = hi if hi > out[out.size - 1]
    else
      out.push(lo)
      out.push(hi)
  out

-> rx_r_intersect(a, b)
  return [] if a.size == 0 || b.size == 0
  out = []
  i = 0
  j = 0
  na = a.size
  nb = b.size
  while i < na && j < nb
    alo = a[i]
    ahi = a[i + 1]
    blo = b[j]
    bhi = b[j + 1]
    lo = alo > blo ? alo : blo
    hi = ahi < bhi ? ahi : bhi
    if lo <= hi
      out.push(lo)
      out.push(hi)
    if ahi < bhi
      i += 2
    else
      j += 2
  out

-> rx_r_subtract(a, b)
  return [] if a.size == 0
  return a if b.size == 0
  out = []
  i = 0
  j = 0
  na = a.size
  nb = b.size
  while i < na
    alo = a[i]
    ahi = a[i + 1]
    i += 2
    while j < nb && b[j + 1] < alo
      j += 2
    cur = alo
    k = j
    while k < nb && b[k] <= ahi
      blo = b[k]
      bhi = b[k + 1]
      if blo > cur
        out.push(cur)
        out.push(blo - 1)
      cur = bhi + 1 if bhi + 1 > cur
      break if cur > ahi
      k += 2
    if cur <= ahi
      out.push(cur)
      out.push(ahi)
  out

-> rx_r_complement(a, max_cp)
  return [0, max_cp] if a.size == 0
  out = []
  cur = 0
  i = 0
  n = a.size
  while i < n
    lo = a[i]
    hi = a[i + 1]
    if lo > cur
      out.push(cur)
      out.push(lo - 1)
    cur = hi + 1
    i += 2
  if cur <= max_cp
    out.push(cur)
    out.push(max_cp)
  out

# ---- Unicode 17.0.0 Simple Case Folding & Non-Unicode Canonicalize ----

JS_RX_CF_INIT = [false, false]
JS_RX_U_CF = {}       # cp -> folded_cp (only entries where folded != cp)
JS_RX_U_EQ = {}       # folded_cp -> [all cps in equivalence class]
JS_RX_U_PAIRS = []    # flat [src0, dst0, ...]
JS_RX_NU_CF = {}      # cu -> upper_cu (only entries where upper != cu)
JS_RX_NU_EQ = {}      # upper_cu -> [all cus in equivalence class]
JS_RX_NU_PAIRS = []   # flat [src0, dst0, ...]

-> rx_cf_ensure(uni)
  slot = uni ? 0 : 1
  return nil if JS_RX_CF_INIT[slot]
  JS_RX_CF_INIT[slot] = true
  enc = uni ? JS_RX_U_CF_ENC : JS_RX_NU_CF_ENC
  cf = uni ? JS_RX_U_CF : JS_RX_NU_CF
  eq = uni ? JS_RX_U_EQ : JS_RX_NU_EQ
  pairs = uni ? JS_RX_U_PAIRS : JS_RX_NU_PAIRS
  n = enc.size
  st = [0]
  prev = 0
  while st[0] < n
    src = prev + rx_vlq_next(enc, st)
    zz = rx_vlq_next(enc, st)
    d = (zz & 1) == 0 ? (zz >> 1) : (0 - ((zz + 1) >> 1))
    dst = src + d
    prev = src
    cf[src] = dst
    pairs.push(src)
    pairs.push(dst)
    lst = eq[dst]
    if lst == nil
      eq[dst] = [dst, src]
    else
      lst.push(src)
  nil

-> js_rx_canon(c, uni)
  if c < 128
    if uni
      return (c >= 65 && c <= 90) ? c + 32 : c
    else
      return (c >= 97 && c <= 122) ? c - 32 : c
  rx_cf_ensure(uni)
  cf = uni ? JS_RX_U_CF : JS_RX_NU_CF
  v = cf[c]
  v == nil ? c : v

-> js_rx_case_equiv(c, uni)
  rx_cf_ensure(uni)
  f = js_rx_canon(c, uni)
  eq = uni ? JS_RX_U_EQ : JS_RX_NU_EQ
  eq[f]

# Close flat sorted ranges `a` under ECMAScript SimpleCaseFolding / Canonicalize!
-> rx_r_case_fold(a, uni)
  return a if a.size == 0
  rx_cf_ensure(uni)
  pairs = uni ? JS_RX_U_PAIRS : JS_RX_NU_PAIRS
  eq = uni ? JS_RX_U_EQ : JS_RX_NU_EQ
  extra = []
  i = 0
  n = pairs.size
  while i < n
    src = pairs[i]
    dst = pairs[i + 1]
    if rx_r_has?(a, src)
      lst = eq[dst]
      k = 0
      while k < lst.size
        x = lst[k]
        if !rx_r_has?(a, x)
          extra.push(x)
          extra.push(x)
        k += 1
    elsif rx_r_has?(a, dst)
      if !rx_r_has?(a, src)
        extra.push(src)
        extra.push(src)
    i += 2
  return a if extra.size == 0
  rx_r_union(a, rx_r_normalize_flat(extra))

