# wasm/interp — the interpreter loop (GENERATED from interp.wt by tools/gen_interp.w;
# edit interp.wt, then run `bin/tungsten tools/gen_interp.w`).
#
# One typed function runs a module's register code at machine speed: raw i64 slots, raw
# typed-array access, a dense switch. It returns to the driver (runtime.w) for anything
# that needs objects or the outside world, with the reason as the result:
#   0 done (the entry frame returned)   1 trap (st[4] = trap code)   2 OP_EXT at st[0]
#   3 import call at st[0]              4 call_indirect slow path     5 call_ref
#   6 call stack exhausted
# st: [0] pc  [1] fp  [2] csp  [3] memory size in bytes  [4] trap code  [5] instance id
#     [6] stack limit (slots)  [7] control stack limit  [9] table 0 size
# glob holds numeric globals at 2*index (v128 high word at 2*index+1); gref ref globals.
# tab: table 0's function ids (0 = null); sx: store function info, 4 words per id:
#     [entry pc, instance id, canonical type, module function index].

-> wexec(code, stk, ostk, mem, glob, gref, tab, sx, cstk, st) (i64[] i64[] Array u8[] i64[] Array i64[] i64[] i64[] i64[]) i64
  pc = st[0]
  fp = st[1]
  csp = st[2]
  msize = st[3]
  inst = st[5]
  slimit = st[6]
  climit = st[7]
  tsize = st[9]
  m32 = 4294967295 ## i64
  minv = (0 - 9223372036854775807 - 1) ## i64
  while true
    op = code[pc]
    case op
    when OP_MOV
      stk[fp + code[pc + 1]] = stk[fp + code[pc + 2]]
      pc += 3
    when OP_CONST
      stk[fp + code[pc + 1]] = code[pc + 2]
      pc += 3
    when OP_ADD32
      stk[fp + code[pc + 1]] = (stk[fp + code[pc + 2]] + stk[fp + code[pc + 3]]) & m32
      pc += 4
    when OP_ADDI32
      stk[fp + code[pc + 1]] = (stk[fp + code[pc + 2]] + code[pc + 3]) & m32
      pc += 4
    when OP_ADD64
      stk[fp + code[pc + 1]] = stk[fp + code[pc + 2]] + stk[fp + code[pc + 3]]
      pc += 4
    when OP_ADDI64
      stk[fp + code[pc + 1]] = stk[fp + code[pc + 2]] + code[pc + 3]
      pc += 4
    when OP_LD32
      ea = stk[fp + code[pc + 2]] + code[pc + 3]
      if ea + 4 > msize
        st[4] = 5
        st[0] = pc
        st[1] = fp
        st[2] = csp
        return 1
      stk[fp + code[pc + 1]] = wk_ld32u(mem, ea)
      pc += 4
    when OP_ST32
      ea = stk[fp + code[pc + 1]] + code[pc + 3]
      if ea + 4 > msize
        st[4] = 5
        st[0] = pc
        st[1] = fp
        st[2] = csp
        return 1
      wk_st32(mem, ea, stk[fp + code[pc + 2]])
      pc += 4
    when OP_JMP
      pc = code[pc + 1]
    when OP_JZ
      if stk[fp + code[pc + 1]] == 0
        pc = code[pc + 2]
      else
        pc += 3
    when OP_JNZ
      if stk[fp + code[pc + 1]] != 0
        pc = code[pc + 2]
      else
        pc += 3
    when OP_JEQ
      if stk[fp + code[pc + 1]] == stk[fp + code[pc + 2]]
        pc = code[pc + 3]
      else
        pc += 4
    when OP_JNE
      if stk[fp + code[pc + 1]] != stk[fp + code[pc + 2]]
        pc = code[pc + 3]
      else
        pc += 4
    when OP_JLTU
      if wk_ult(stk[fp + code[pc + 1]], stk[fp + code[pc + 2]]) != 0
        pc = code[pc + 3]
      else
        pc += 4
    when OP_JGTU
      if wk_ugt(stk[fp + code[pc + 1]], stk[fp + code[pc + 2]]) != 0
        pc = code[pc + 3]
      else
        pc += 4
    when OP_JLEU
      if wk_ule(stk[fp + code[pc + 1]], stk[fp + code[pc + 2]]) != 0
        pc = code[pc + 3]
      else
        pc += 4
    when OP_JGEU
      if wk_uge(stk[fp + code[pc + 1]], stk[fp + code[pc + 2]]) != 0
        pc = code[pc + 3]
      else
        pc += 4
    when OP_JLTS32
      if ((stk[fp + code[pc + 1]] << 32) >> 32) < ((stk[fp + code[pc + 2]] << 32) >> 32)
        pc = code[pc + 3]
      else
        pc += 4
    when OP_JGTS32
      if ((stk[fp + code[pc + 1]] << 32) >> 32) > ((stk[fp + code[pc + 2]] << 32) >> 32)
        pc = code[pc + 3]
      else
        pc += 4
    when OP_JLES32
      if ((stk[fp + code[pc + 1]] << 32) >> 32) <= ((stk[fp + code[pc + 2]] << 32) >> 32)
        pc = code[pc + 3]
      else
        pc += 4
    when OP_JGES32
      if ((stk[fp + code[pc + 1]] << 32) >> 32) >= ((stk[fp + code[pc + 2]] << 32) >> 32)
        pc = code[pc + 3]
      else
        pc += 4
    when OP_JLTS64
      if stk[fp + code[pc + 1]] < stk[fp + code[pc + 2]]
        pc = code[pc + 3]
      else
        pc += 4
    when OP_JGTS64
      if stk[fp + code[pc + 1]] > stk[fp + code[pc + 2]]
        pc = code[pc + 3]
      else
        pc += 4
    when OP_JLES64
      if stk[fp + code[pc + 1]] <= stk[fp + code[pc + 2]]
        pc = code[pc + 3]
      else
        pc += 4
    when OP_JGES64
      if stk[fp + code[pc + 1]] >= stk[fp + code[pc + 2]]
        pc = code[pc + 3]
      else
        pc += 4
    when OP_JEQI
      if stk[fp + code[pc + 1]] == code[pc + 2]
        pc = code[pc + 3]
      else
        pc += 4
    when OP_JNEI
      if stk[fp + code[pc + 1]] != code[pc + 2]
        pc = code[pc + 3]
      else
        pc += 4
    when OP_JLTUI
      if wk_ult(stk[fp + code[pc + 1]], code[pc + 2]) != 0
        pc = code[pc + 3]
      else
        pc += 4
    when OP_JGTUI
      if wk_ugt(stk[fp + code[pc + 1]], code[pc + 2]) != 0
        pc = code[pc + 3]
      else
        pc += 4
    when OP_JLEUI
      if wk_ule(stk[fp + code[pc + 1]], code[pc + 2]) != 0
        pc = code[pc + 3]
      else
        pc += 4
    when OP_JGEUI
      if wk_uge(stk[fp + code[pc + 1]], code[pc + 2]) != 0
        pc = code[pc + 3]
      else
        pc += 4
    when OP_JLTSI32
      if ((stk[fp + code[pc + 1]] << 32) >> 32) < ((code[pc + 2] << 32) >> 32)
        pc = code[pc + 3]
      else
        pc += 4
    when OP_JGTSI32
      if ((stk[fp + code[pc + 1]] << 32) >> 32) > ((code[pc + 2] << 32) >> 32)
        pc = code[pc + 3]
      else
        pc += 4
    when OP_JLESI32
      if ((stk[fp + code[pc + 1]] << 32) >> 32) <= ((code[pc + 2] << 32) >> 32)
        pc = code[pc + 3]
      else
        pc += 4
    when OP_JGESI32
      if ((stk[fp + code[pc + 1]] << 32) >> 32) >= ((code[pc + 2] << 32) >> 32)
        pc = code[pc + 3]
      else
        pc += 4
    when OP_JLTSI64
      if stk[fp + code[pc + 1]] < code[pc + 2]
        pc = code[pc + 3]
      else
        pc += 4
    when OP_JGTSI64
      if stk[fp + code[pc + 1]] > code[pc + 2]
        pc = code[pc + 3]
      else
        pc += 4
    when OP_JLESI64
      if stk[fp + code[pc + 1]] <= code[pc + 2]
        pc = code[pc + 3]
      else
        pc += 4
    when OP_JGESI64
      if stk[fp + code[pc + 1]] >= code[pc + 2]
        pc = code[pc + 3]
      else
        pc += 4
    when OP_CALL
      if csp >= climit
        st[0] = pc
        st[1] = fp
        st[2] = csp
        return 6
      cstk[csp] = pc + 3
      cstk[csp + 1] = fp
      csp += 2
      fp += code[pc + 2]
      pc = code[pc + 1]
    when OP_ENTER
      if fp + code[pc + 1] > slimit
        st[0] = pc
        st[1] = fp
        st[2] = csp
        return 6
      z = fp + code[pc + 2]
      ze = fp + code[pc + 3]
      while z < ze
        stk[z] = 0
        z += 1
      if code[pc + 4] != 0
        z = fp + code[pc + 2]
        ze = fp + code[pc + 1]
        while z < ze
          ostk[z] = nil
          z += 1
      pc += 5
    when OP_RET
      csp -= 2
      pc = cstk[csp]
      fp = cstk[csp + 1]
      if pc < 0
        st[0] = pc
        st[1] = fp
        st[2] = csp
        return 0
    when OP_RET_CALL
      n = code[pc + 2]
      src = fp + code[pc + 3]
      k = 0
      while k < n
        stk[fp + k] = stk[src + k]
        ostk[fp + k] = ostk[src + k]
        k += 1
      pc = code[pc + 1]
    when OP_CALL_IND
      idx = stk[fp + code[pc + 4]]
      if code[pc + 1] != 0
        st[0] = pc
        st[1] = fp
        st[2] = csp
        return 4
      if idx < 0 || idx >= tsize
        st[4] = 6
        st[0] = pc
        st[1] = fp
        st[2] = csp
        return 1
      fid = tab[idx]
      if fid == 0
        st[4] = 7
        st[0] = pc
        st[1] = fp
        st[2] = csp
        return 1
      if sx[fid * 4 + 2] != code[pc + 2] || sx[fid * 4 + 1] != inst
        st[0] = pc
        st[1] = fp
        st[2] = csp
        return 4
      if csp >= climit
        st[0] = pc
        st[1] = fp
        st[2] = csp
        return 6
      cstk[csp] = pc + 6
      cstk[csp + 1] = fp
      csp += 2
      fp += code[pc + 3]
      pc = sx[fid * 4]
    when OP_CALL_IMPORT
      st[0] = pc
      st[1] = fp
      st[2] = csp
      return 3
    when OP_CALL_REF
      st[0] = pc
      st[1] = fp
      st[2] = csp
      return 5
    when OP_EXT
      st[0] = pc
      st[1] = fp
      st[2] = csp
      return 2
    when OP_TRAP
      st[4] = code[pc + 1]
      st[0] = pc
      st[1] = fp
      st[2] = csp
      return 1
    when OP_BR_TABLE
      i = stk[fp + code[pc + 1]]
      n = code[pc + 2]
      if i < 0 || i > n
        i = n
      pc = code[pc + 3 + i]
    when OP_NOP
      pc += 1
    when OP_MOV2
      d = fp + code[pc + 1]
      a = fp + code[pc + 2]
      stk[d] = stk[a]
      stk[d + 1] = stk[a + 1]
      pc += 3
    when OP_MOVR
      ostk[fp + code[pc + 1]] = ostk[fp + code[pc + 2]]
      pc += 3
    when OP_CONST2
      d = fp + code[pc + 1]
      stk[d] = code[pc + 2]
      stk[d + 1] = code[pc + 3]
      pc += 4
    when OP_REFNULL
      ostk[fp + code[pc + 1]] = nil
      pc += 2
    when OP_SELECT
      if stk[fp + code[pc + 4]] != 0
        stk[fp + code[pc + 1]] = stk[fp + code[pc + 2]]
      else
        stk[fp + code[pc + 1]] = stk[fp + code[pc + 3]]
      pc += 5
    when OP_SELECT2
      d = fp + code[pc + 1]
      a = fp + code[pc + 3]
      if stk[fp + code[pc + 4]] != 0
        a = fp + code[pc + 2]
      x0 = stk[a]
      x1 = stk[a + 1]
      stk[d] = x0
      stk[d + 1] = x1
      pc += 5
    when OP_SELECTR
      if stk[fp + code[pc + 4]] != 0
        ostk[fp + code[pc + 1]] = ostk[fp + code[pc + 2]]
      else
        ostk[fp + code[pc + 1]] = ostk[fp + code[pc + 3]]
      pc += 5
    when OP_GGET
      stk[fp + code[pc + 1]] = glob[code[pc + 2] * 2]
      pc += 3
    when OP_GSET
      glob[code[pc + 1] * 2] = stk[fp + code[pc + 2]]
      pc += 3
    when OP_GGET2
      d = fp + code[pc + 1]
      g = code[pc + 2] * 2
      stk[d] = glob[g]
      stk[d + 1] = glob[g + 1]
      pc += 3
    when OP_GSET2
      a = fp + code[pc + 2]
      g = code[pc + 1] * 2
      glob[g] = stk[a]
      glob[g + 1] = stk[a + 1]
      pc += 3
    when OP_GGETR
      ostk[fp + code[pc + 1]] = gref[code[pc + 2]]
      pc += 3
    when OP_GSETR
      gref[code[pc + 1]] = ostk[fp + code[pc + 2]]
      pc += 3
    when OP_SUB32
      stk[fp + code[pc + 1]] = (stk[fp + code[pc + 2]] - stk[fp + code[pc + 3]]) & m32
      pc += 4
    when OP_MUL32
      stk[fp + code[pc + 1]] = (stk[fp + code[pc + 2]] * stk[fp + code[pc + 3]]) & m32
      pc += 4
    when OP_DIVS32
      a = (stk[fp + code[pc + 2]] << 32) >> 32
      b = (stk[fp + code[pc + 3]] << 32) >> 32
      if b == 0
        st[4] = 2
        st[0] = pc
        st[1] = fp
        st[2] = csp
        return 1
      if b == -1 && a == -2147483648
        st[4] = 3
        st[0] = pc
        st[1] = fp
        st[2] = csp
        return 1
      stk[fp + code[pc + 1]] = (a / b) & m32
      pc += 4
    when OP_DIVU32
      b = stk[fp + code[pc + 3]]
      if b == 0
        st[4] = 2
        st[0] = pc
        st[1] = fp
        st[2] = csp
        return 1
      stk[fp + code[pc + 1]] = stk[fp + code[pc + 2]] / b
      pc += 4
    when OP_REMS32
      a = (stk[fp + code[pc + 2]] << 32) >> 32
      b = (stk[fp + code[pc + 3]] << 32) >> 32
      if b == 0
        st[4] = 2
        st[0] = pc
        st[1] = fp
        st[2] = csp
        return 1
      if b == -1
        stk[fp + code[pc + 1]] = 0
      else
        stk[fp + code[pc + 1]] = (a % b) & m32
      pc += 4
    when OP_REMU32
      b = stk[fp + code[pc + 3]]
      if b == 0
        st[4] = 2
        st[0] = pc
        st[1] = fp
        st[2] = csp
        return 1
      stk[fp + code[pc + 1]] = stk[fp + code[pc + 2]] % b
      pc += 4
    when OP_SHL32
      stk[fp + code[pc + 1]] = (stk[fp + code[pc + 2]] << (stk[fp + code[pc + 3]] & 31)) & m32
      pc += 4
    when OP_SHRS32
      stk[fp + code[pc + 1]] = (((stk[fp + code[pc + 2]] << 32) >> 32) >> (stk[fp + code[pc + 3]] & 31)) & m32
      pc += 4
    when OP_SHRU32
      stk[fp + code[pc + 1]] = stk[fp + code[pc + 2]] >> (stk[fp + code[pc + 3]] & 31)
      pc += 4
    when OP_ROTL32
      stk[fp + code[pc + 1]] = wk_rotl32(stk[fp + code[pc + 2]], stk[fp + code[pc + 3]])
      pc += 4
    when OP_ROTR32
      stk[fp + code[pc + 1]] = wk_rotr32(stk[fp + code[pc + 2]], stk[fp + code[pc + 3]])
      pc += 4
    when OP_CLZ32
      stk[fp + code[pc + 1]] = wk_clz32(stk[fp + code[pc + 2]])
      pc += 3
    when OP_CTZ32
      stk[fp + code[pc + 1]] = wk_ctz32(stk[fp + code[pc + 2]])
      pc += 3
    when OP_SUB64
      stk[fp + code[pc + 1]] = stk[fp + code[pc + 2]] - stk[fp + code[pc + 3]]
      pc += 4
    when OP_MUL64
      stk[fp + code[pc + 1]] = stk[fp + code[pc + 2]] * stk[fp + code[pc + 3]]
      pc += 4
    when OP_DIVS64
      a = stk[fp + code[pc + 2]]
      b = stk[fp + code[pc + 3]]
      if b == 0
        st[4] = 2
        st[0] = pc
        st[1] = fp
        st[2] = csp
        return 1
      if b == -1 && a == minv
        st[4] = 3
        st[0] = pc
        st[1] = fp
        st[2] = csp
        return 1
      stk[fp + code[pc + 1]] = a / b
      pc += 4
    when OP_DIVU64
      b = stk[fp + code[pc + 3]]
      if b == 0
        st[4] = 2
        st[0] = pc
        st[1] = fp
        st[2] = csp
        return 1
      stk[fp + code[pc + 1]] = wk_udiv64(stk[fp + code[pc + 2]], b)
      pc += 4
    when OP_REMS64
      a = stk[fp + code[pc + 2]]
      b = stk[fp + code[pc + 3]]
      if b == 0
        st[4] = 2
        st[0] = pc
        st[1] = fp
        st[2] = csp
        return 1
      if b == -1
        stk[fp + code[pc + 1]] = 0
      else
        stk[fp + code[pc + 1]] = a % b
      pc += 4
    when OP_REMU64
      b = stk[fp + code[pc + 3]]
      if b == 0
        st[4] = 2
        st[0] = pc
        st[1] = fp
        st[2] = csp
        return 1
      stk[fp + code[pc + 1]] = wk_urem64(stk[fp + code[pc + 2]], b)
      pc += 4
    when OP_SHL64
      stk[fp + code[pc + 1]] = stk[fp + code[pc + 2]] << (stk[fp + code[pc + 3]] & 63)
      pc += 4
    when OP_SHRS64
      stk[fp + code[pc + 1]] = stk[fp + code[pc + 2]] >> (stk[fp + code[pc + 3]] & 63)
      pc += 4
    when OP_SHRU64
      stk[fp + code[pc + 1]] = wk_lshr64(stk[fp + code[pc + 2]], stk[fp + code[pc + 3]])
      pc += 4
    when OP_ROTL64
      stk[fp + code[pc + 1]] = wk_rotl64(stk[fp + code[pc + 2]], stk[fp + code[pc + 3]])
      pc += 4
    when OP_ROTR64
      stk[fp + code[pc + 1]] = wk_rotr64(stk[fp + code[pc + 2]], stk[fp + code[pc + 3]])
      pc += 4
    when OP_CLZ64
      stk[fp + code[pc + 1]] = wk_clz64(stk[fp + code[pc + 2]])
      pc += 3
    when OP_CTZ64
      stk[fp + code[pc + 1]] = wk_ctz64(stk[fp + code[pc + 2]])
      pc += 3
    when OP_AND
      stk[fp + code[pc + 1]] = stk[fp + code[pc + 2]] & stk[fp + code[pc + 3]]
      pc += 4
    when OP_OR
      stk[fp + code[pc + 1]] = stk[fp + code[pc + 2]] | stk[fp + code[pc + 3]]
      pc += 4
    when OP_XOR
      stk[fp + code[pc + 1]] = stk[fp + code[pc + 2]] ^ stk[fp + code[pc + 3]]
      pc += 4
    when OP_POPCNT
      stk[fp + code[pc + 1]] = wk_popcnt(stk[fp + code[pc + 2]])
      pc += 3
    when OP_EQZ
      stk[fp + code[pc + 1]] = stk[fp + code[pc + 2]] == 0 ? 1 : 0
      pc += 3
    when OP_EQ
      stk[fp + code[pc + 1]] = stk[fp + code[pc + 2]] == stk[fp + code[pc + 3]] ? 1 : 0
      pc += 4
    when OP_NE
      stk[fp + code[pc + 1]] = stk[fp + code[pc + 2]] != stk[fp + code[pc + 3]] ? 1 : 0
      pc += 4
    when OP_LTU
      stk[fp + code[pc + 1]] = wk_ult(stk[fp + code[pc + 2]], stk[fp + code[pc + 3]])
      pc += 4
    when OP_GTU
      stk[fp + code[pc + 1]] = wk_ugt(stk[fp + code[pc + 2]], stk[fp + code[pc + 3]])
      pc += 4
    when OP_LEU
      stk[fp + code[pc + 1]] = wk_ule(stk[fp + code[pc + 2]], stk[fp + code[pc + 3]])
      pc += 4
    when OP_GEU
      stk[fp + code[pc + 1]] = wk_uge(stk[fp + code[pc + 2]], stk[fp + code[pc + 3]])
      pc += 4
    when OP_LTS32
      stk[fp + code[pc + 1]] = ((stk[fp + code[pc + 2]] << 32) >> 32) < ((stk[fp + code[pc + 3]] << 32) >> 32) ? 1 : 0
      pc += 4
    when OP_GTS32
      stk[fp + code[pc + 1]] = ((stk[fp + code[pc + 2]] << 32) >> 32) > ((stk[fp + code[pc + 3]] << 32) >> 32) ? 1 : 0
      pc += 4
    when OP_LES32
      stk[fp + code[pc + 1]] = ((stk[fp + code[pc + 2]] << 32) >> 32) <= ((stk[fp + code[pc + 3]] << 32) >> 32) ? 1 : 0
      pc += 4
    when OP_GES32
      stk[fp + code[pc + 1]] = ((stk[fp + code[pc + 2]] << 32) >> 32) >= ((stk[fp + code[pc + 3]] << 32) >> 32) ? 1 : 0
      pc += 4
    when OP_LTS64
      stk[fp + code[pc + 1]] = stk[fp + code[pc + 2]] < stk[fp + code[pc + 3]] ? 1 : 0
      pc += 4
    when OP_GTS64
      stk[fp + code[pc + 1]] = stk[fp + code[pc + 2]] > stk[fp + code[pc + 3]] ? 1 : 0
      pc += 4
    when OP_LES64
      stk[fp + code[pc + 1]] = stk[fp + code[pc + 2]] <= stk[fp + code[pc + 3]] ? 1 : 0
      pc += 4
    when OP_GES64
      stk[fp + code[pc + 1]] = stk[fp + code[pc + 2]] >= stk[fp + code[pc + 3]] ? 1 : 0
      pc += 4
    when OP_WRAP
      stk[fp + code[pc + 1]] = stk[fp + code[pc + 2]] & m32
      pc += 3
    when OP_EXTS32
      stk[fp + code[pc + 1]] = (stk[fp + code[pc + 2]] << 32) >> 32
      pc += 3
    when OP_EXT8S32
      stk[fp + code[pc + 1]] = ((stk[fp + code[pc + 2]] << 56) >> 56) & m32
      pc += 3
    when OP_EXT16S32
      stk[fp + code[pc + 1]] = ((stk[fp + code[pc + 2]] << 48) >> 48) & m32
      pc += 3
    when OP_EXT8S64
      stk[fp + code[pc + 1]] = (stk[fp + code[pc + 2]] << 56) >> 56
