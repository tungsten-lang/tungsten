# name → [prefix (0 for none), code, immediate kind]
WASM_OPS = {}

-> wasm_ops_init
  return WASM_OPS if WASM_OPS.size > 0
  WASM_OPCODE_TABLE.split("\n").each ->(line)
    parts = line.split(" ")
    if parts.size == 3
      c = parts[1]
      ci = c.index(":")
      if ci == nil
        WASM_OPS[parts[0]] = [0, c.to_i(16), parts[2]]
      else
        WASM_OPS[parts[0]] = [c.slice(0, ci).to_i(16), c.slice(ci + 1, c.size - ci - 1).to_i, parts[2]]
  WASM_OPS
