# Long-token lexing — pins the packed-token length mask. The packed token
# format holds a 12-bit length (bits 26-37); pack sites that wrote the
# length unmasked let `len >> 12` OR into the type-id field (bits 38-45),
# reclassifying any >=4096-char token: 20001-digit ints became TYPE_HINT
# (silent empty-output death), 10500-char strings became TYPE_HINT,
# 79001-digit ints became codepoint literals (E_LEX_CHAR_HEX_LENGTH at a
# random position), 4200-digit floats became "unterminated" strings. Each
# width below exercises a distinct overflow bit pattern; int values are
# checked `% 97`-exact so a truncated re-scan cannot pass.

-> check(name, got, want)
  if got == want
    << "PASS " + name
  else
    << "FAIL " + name + " got " + got.to_s() + " want " + want.to_s()
    exit 1

# 4097 digits: len>>12 == 1 (boundary row)
check("d4097", (10 ** 4096 + 7) % 97, 42)

# 8193 digits: len>>12 == 2
check("d8193", (10 ** 8192 + 7) % 97, 68)

# 20001 digits: len>>12 == 4 (the silent-death case)
check("d20001", (10 ** 20000 + 7) % 97, 68)

# 79001 digits: len>>12 == 19 (the E_LEX_CHAR_HEX_LENGTH case)
check("d79001", (10 ** 79000 + 7) % 97, 13)

# A 10500-char string literal (was misclassified as TYPE_HINT)
big_s = ""
check("s10500_size", big_s.size(), 10500)
check("s10500_ends", big_s.slice(10496, 4), "ab74")

<< "lexer_long_token_spec: all checks passed"
