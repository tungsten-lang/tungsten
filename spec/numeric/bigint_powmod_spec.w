# BigInt modular-exponentiation regressions.  The 8- and 16-limb vectors hit
# the fixed pairs-REDC schedules; expected values were generated independently
# with Python's three-argument pow (which uses arbitrary-precision integers).

-> check(name, got, want)
  if got.to_s() == want
    << "PASS " + name
  else
    << "FAIL " + name + " got " + got.to_s() + " want " + want
    exit 1

exponent = 170141183460469231731687303715884118073

base8 = 3351951982485649274893506249551461531869841455148098344430890360930441007518386744200468574541725856922507964546621512713438476336989310167627905739614089
modulus8 = 6703903964971298549787012499102923063739682910296196688861780721860882015036773488400937149083451713845015929093243025426876941405973284973216824503041861
check(
  "powmod.8_limbs",
  base8.modpow(exponent, modulus8),
  "6329690125448711266771493431391971207030465955873743973285390156492025833597222331686567137851787587940011979142716935896004464777585316286191554319366481")
check(
  "powmod.8_limbs_negative_base",
  (0 - base8).modpow(exponent, modulus8),
  "374213839522587283015519067710951856709216954422452715576390565368856181439551156714370011231664125905003949950526089530872476628387968687025270183675380")

base16 = 
modulus16 = 
check(
